// A documentation page
// ====================
// What the three files beside this one build, and the one thing they agree on.
// `agents.hive` writes them out.
//
// A page is written as a **backtick string**, dedented at compile time. Two
// characters cannot appear in one — the backtick itself, and so the three of
// them that open a fence — so a page writes `~BT~` where it means one and
// `~CODE~` where it means three, and `backticked` puts them back. That is the
// same trick the embedded Go runtime and `container.hive` use.

/// One page, and where it goes under `.hivedocs/`.
type Page {
	/// Its path relative to `.hivedocs/`, `/` separated.
	path: Str
	/// The whole file, ending in a newline.
	body: Str
}

/// A page as it was written, turned into the text it stands for. The fence goes
/// first; nothing it leaves behind holds the other marker.
func backticked(source: Str): Str {
	fenced := join(split(source, "~CODE~"), "```")
	return join(split(fenced, "~BT~"), "`") + "
"
}
