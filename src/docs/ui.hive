// The `hive.ui` pages
// ===================
// A file of its own because the module is: a window, a page, a canvas and a scene,
// each with a vocabulary somebody reaches for on its own. Fourteen pages, so laying
// out a form costs nobody the shape table and the sound rules.
import ./page

// Every page about `hive.ui`.
func pages(): page.Page[dyn] {
    return [
        page.Page("stdlib/ui.md", ui()),
        page.Page("stdlib/ui-widgets.md", widgets()),
        page.Page("stdlib/ui-attributes.md", attributes()),
        page.Page("stdlib/ui-events.md", events()),
        page.Page("stdlib/ui-enums.md", enums()),
        page.Page("stdlib/ui-icons.md", icons()),
        page.Page("stdlib/ui-colour.md", colour()),
        page.Page("stdlib/ui-canvas.md", canvas()),
        page.Page("stdlib/ui-code.md", code()),
        page.Page("stdlib/ui-scene.md", scene()),
        page.Page("stdlib/ui-scene-shapes.md", sceneShapes()),
        page.Page("stdlib/ui-scene-surfaces.md", sceneSurfaces()),
        page.Page("stdlib/ui-scene-sound.md", sceneSound()),
        page.Page("stdlib/ui-scene-camera.md", sceneCamera()),
        page.Page("stdlib/ui-scene-input.md", sceneInput())
    ]
}

// --- The module --------------------------------------------------------------

func ui(): Str {
    return page.backticked(`
        # ~BT~hive.ui~BT~

        A view is a value: a tree of widgets.

        | call | what it does |
        | --- | --- |
        | ~BT~window(title, view, update)~BT~ | a window, as a handler for ~BT~spawn~BT~, which opens it |
        | ~BT~webview(title, view, update)~BT~ | the same window, always drawn as a page |
        | ~BT~html(view)~BT~ | renders the tree as an HTML **fragment** → ~BT~Str~BT~ |
        | ~BT~page(title, view)~BT~ | renders it as a whole **document** → ~BT~Str~BT~ |

        ~BT~view~BT~ is a ~BT~func(State): hive.ui.View~BT~; ~BT~update~BT~ a ~BT~proc(mut State, Msg): Msg~BT~,
        or ~BT~proc(mut State, Msg, Address<Msg>): Msg~BT~ to be handed the window's address.
        ~BT~window~BT~ answers with a handler of that shape, starting from the state it is
        spawned with: ~BT~spawn(ui.window("Notes", view, update), fresh())~BT~.

        | page | what is on it |
        | --- | --- |
        | [ui-widgets](ui-widgets.md) | every widget and its payload |
        | [ui-attributes](ui-attributes.md) | layout, text, state — what an attribute carries |
        | [ui-events](ui-events.md) | ~BT~on~BT~, ~BT~onInput~BT~, ~BT~onChoose~BT~ and the rest |
        | [ui-enums](ui-enums.md) | ~BT~Align~BT~ ~BT~Justify~BT~ ~BT~TextSize~BT~ ~BT~Axis~BT~ ~BT~Anchor~BT~ ~BT~InputKind~BT~ ~BT~Fit~BT~ |
        | [ui-icons](ui-icons.md) | the 320 ~BT~Icon~BT~s, by name |
        | [ui-colour](ui-colour.md) | ~BT~Tone~BT~ |
        | [ui-canvas](ui-canvas.md) | two dimensions, in the program's own units |
        | [ui-code](ui-code.md) | a code editor: text in colours, a caret its program can move |
        | [ui-scene](ui-scene.md) | three dimensions — **five pages**, start there |

        ## The window is a service

        ~BT~update~BT~ is a [service's](syslink.md) handler, checked as one: a window has an
        address, may be spawned under a name, and can be posted to by a background task
        or another machine. There is no *command*. **~BT~view~BT~ is a ~BT~func~BT~, so it cannot
        take a ~BT~mut~BT~ parameter or write the model**; it runs on every change.

        ~CODE~hive
        type Msg \{
        	Typed \{ text: Str }
        	Send
        }

        type State \{
        	draft: Str
        	lines: Str[dyn]
        }

        func view(state: State): hive.ui.View \{
        	return ui.column([ui.gap(8), ui.pad(16)], [
        		ui.text([ui.size(ui.TextSize.Title())], "Notes"),
        		ui.input([ui.onInput(Msg.Typed(_)), ui.placeholder("a line")], state.draft),
        		ui.button([ui.on(Msg.Send())], "Add")
        	])
        }

        proc update(state: mut State, message: Msg): Msg \{
        	if message is Msg.Typed(text) \{
        		state.draft = text
        	} else if message is Msg.Send \{
        		append(state.lines, state.draft)
        		state.draft = ""
        	}
        	return message
        }

        proc main(): void \{
        	Str[dyn] empty = []
        	spawn(ui.window("Notes", view, update), State("", empty))
        }
        ~CODE~

        **~BT~page~BT~ renders the same tree**, so an ~BT~httpServe~BT~ handler can answer with a
        window's view unchanged:

        ~CODE~hive
        proc handle(req: hive.net.HttpRequest): hive.net.HttpResponse \{
        	return hive.net.HttpResponse(200, [], ui.page("Notes", view(state)))
        }
        ~CODE~

        ~BT~link~BT~ is the one widget that works without an event: a window follows its
        **message**, a served page its **href**.

        ## What a window is

        - **Windows and Linux:** drawn by the program, no browser. Each widget has its
          own version, laid out by the stylesheet's rules (modelled on
          [Clay](https://github.com/nicbarker/clay), by Nic Barker), light or dark as
          the desktop is. Linux: X11 (XWayland on Wayland), the system's sans-serif. A
          ~BT~scene~BT~ is drawn by its engine, started beside the program. It **behaves as a
          page**: text selects and copies, right click opens a menu, fields undo, scroll
          bars drag, screen readers read it (UI Automation on Windows, AT-SPI on Linux),
          and IBus or Fcitx5 types into it on Linux. ~BT~image~BT~ takes PNG, JPEG, GIF, WebP
          or SVG.
        - **A page instead** for ~BT~webview~BT~, a program shipping its own typeface, Linux
          with no display or no usable font, macOS and Android. Off Windows and Linux
          that is an **application-mode browser window** (no address bar or tabs) on its
          own profile — its own process, with none of the user's session, extensions or
          history, not closed by quitting the browser — or, with no Chromium-family
          browser, an ordinary tab.
        - **Opening a window does not wait**; open any number. Closing one kills its
          service; **closing the last ends the program**. A ~BT~main~BT~ returning while a
          window is open waits for them all; [~BT~hive.task.sleepForever~BT~](task.md) says the
          same for one with nothing left to do.
        - A **built** windowed program on Windows has no console; ~BT~hive run~BT~ keeps one.

        ## Icon and typeface

        ~BT~assets/icon.png~BT~ (PNG, at most 256×256) and ~BT~assets/font.woff2~BT~ go beside the
        entrypoint; **nothing in the source names them**. The icon is the program's, not
        the window's, and any program may ship one: the build **embeds it in the
        executable**, a window shows it, and on Windows the file carries it as a resource
        (seen by a file manager and a pinned shortcut) whether a window opens or not.
        With none, a window shows Hive's mark. The font sets every widget; with none, the
        system's is used.

        ## Touch

        With a coarse pointer, buttons, fields and checkboxes are **at least 44px tall**
        and field text **16px** (smaller makes a phone zoom on focus for good). **Layout
        never changes with width**: a ~BT~row~BT~ is a row on every device.

        ## Environment variables

        | variable | does |
        | --- | --- |
        | ~BT~HIVE_WINDOW=print~BT~ | prints ~BT~hive-window <url>~BT~ instead of opening a browser |
        | ~BT~HIVE_FOLDS=1~BT~ | prints, once a second, turns taken and drawn, the median, 90th-percentile and worst time in ~BT~update~BT~, ~BT~view~BT~ and sending the page, and the collections since |

        A ~BT~hive export~BT~ app takes ~BT~HIVE_FOLDS~BT~ as an intent extra ([cli](../cli.md)).
        **A crash's output is also appended to ~BT~<temp>/<program>-crash.log~BT~**, as a
        self-drawn window usually has no console.

        ## No card, toast or divider

        Compose them: a card is a ~BT~column~BT~ with padding, a toast an ~BT~overlay~BT~ and a
        message, a divider a ~BT~row~BT~ with a border.
    `)
}

func widgets(): Str {
    return page.backticked(`
        # ~BT~hive.ui~BT~ — the widgets

        **Every widget takes its attributes, then its payload.** Hive has no optional
        parameters, so an optional setting is an attribute.

        | widget | payload |
        | --- | --- |
        | ~BT~row(attrs, children)~BT~ / ~BT~column(attrs, children)~BT~ | ~BT~View[]~BT~ |
        | ~BT~grid(attrs, children)~BT~ | ~BT~View[]~BT~ — [columns that line up](#a-grid-and-a-stack) |
        | ~BT~stack(attrs, children)~BT~ | ~BT~View[]~BT~ — laid one over another |
        | ~BT~paragraph(attrs, children)~BT~ | ~BT~View[]~BT~ — [words that wrap as one](#a-paragraph) |
        | ~BT~spacer()~BT~ | — takes **nothing at all**, not even attributes |
        | ~BT~none()~BT~ | — the same; draws nothing |
        | ~BT~spinner(attrs)~BT~ | — attributes only |
        | ~BT~progress(attrs, done)~BT~ | ~BT~Float~BT~ — how much is done, ~BT~0.0~BT~ to ~BT~1.0~BT~ |
        | ~BT~overlay(attrs, child)~BT~ | ~BT~View~BT~ |
        | ~BT~text(attrs, content)~BT~ | ~BT~Str~BT~ |
        | ~BT~image(attrs, src, alt)~BT~ | ~BT~Str, Str~BT~ |
        | ~BT~link(attrs, href, label)~BT~ | ~BT~Str, Str~BT~ |
        | ~BT~icon(attrs, name)~BT~ | ~BT~Icon~BT~ — [the icons](ui-icons.md) |
        | ~BT~button(attrs, label)~BT~ | ~BT~Str~BT~ |
        | ~BT~input(attrs, value)~BT~ / ~BT~textarea(attrs, value)~BT~ | ~BT~Str~BT~ |
        | ~BT~checkbox(attrs, label, checked)~BT~ | ~BT~Str, Bool~BT~ |
        | ~BT~select(attrs, options, chosen)~BT~ | ~BT~Str[], Str~BT~ |
        | ~BT~radio(attrs, options, chosen)~BT~ | ~BT~Str[], Str~BT~ — one of several, all in view |
        | ~BT~choices(attrs, options, chosen)~BT~ | ~BT~Str[], Str[]~BT~ — any number of several |
        | ~BT~tabs(attrs, labels, chosen)~BT~ | ~BT~Str[], Str~BT~ — a strip of tabs |
        | ~BT~tree(attrs, branches)~BT~ | ~BT~View[]~BT~ — [a tree of ~BT~branch~BT~es](#a-tree) |
        | ~BT~branch(attrs, label, open, children)~BT~ | ~BT~Str, Bool, View[]~BT~ |
        | ~BT~table(attrs, rows)~BT~ | ~BT~Table~BT~ |
        | ~BT~canvas(attrs, marks)~BT~ | ~BT~Mark[]~BT~ — [ui-canvas](ui-canvas.md) |
        | ~BT~code(attrs, text, runs)~BT~ | ~BT~Str, Run[]~BT~ — [ui-code](ui-code.md) |
        | ~BT~scene(attrs, shapes)~BT~ | ~BT~Shape[]~BT~ — [ui-scene](ui-scene.md) |
        | ~BT~inset(attrs, views)~BT~ | ~BT~View[]~BT~ — a second look at that scene |

        ~CODE~hive
        ui.row([ui.gap(12), ui.align(ui.Align.Center())], [
        	ui.icon([], ui.Icon.Star()),
        	ui.text([ui.tone(ui.Tone.Muted())], "starred"),
        	ui.spacer(),
        	ui.button([ui.on(Msg.Clear()), ui.disabled(len(items) == 0)], "Clear")
        ])
        ~CODE~

        - A widget is an **opaque** ~BT~hive.ui.View~BT~.
        - ~BT~spacer()~BT~ takes the leftover room in a ~BT~row~BT~ or ~BT~column~BT~, pushing what follows
          to the far end; [~BT~grow(n)~BT~](ui-attributes.md) gives a **child** a share of it.
        - ~BT~none()~BT~ is what to return where there is nothing to show — Hive has no
          optional view.
        - **Widgets keep no state.** ~BT~select~BT~, ~BT~checkbox~BT~, ~BT~radio~BT~, ~BT~choices~BT~, ~BT~tabs~BT~ and
          ~BT~branch~BT~ take **what is chosen or open now**; an [event](ui-events.md) changes
          the state and they redraw from it.

        ## A grid and a stack

        A ~BT~grid~BT~ fills columns left to right, then down; **a child is as wide as its
        column**. ~BT~columns(Int[])~BT~ sets them: **~BT~0~BT~ is as wide as its content, any other
        number that many shares of what is left** — ~BT~columns([0, 1])~BT~ is labels as wide
        as the longest and fields taking the rest. Default: one column. ~BT~span(n)~BT~ on a
        child takes ~BT~n~BT~ columns; ~BT~gap~BT~ spaces columns and rows.

        ~CODE~hive
        ui.grid([ui.columns([0, 1]), ui.gap(8), ui.align(ui.Align.Center())], [
        	ui.text([], "Name"), ui.input([ui.onInput(Msg.Name(_))], state.name),
        	ui.text([], "Email"), ui.input([ui.kind(ui.InputKind.Email())], state.email),
        	ui.button([ui.span(2), ui.on(Msg.Save())], "Save")
        ])
        ~CODE~

        A ~BT~stack~BT~ lays children **one over another**, each the stack's size unless
        ~BT~place(across, down)~BT~ (two ~BT~Align~BT~s) puts it at an edge or the middle; ~BT~Stretch~BT~
        runs it the whole way. A caption over a picture, a badge on a card's corner:

        ~CODE~hive
        ui.stack([ui.aspect(16, 9)], [
        	ui.image([ui.fit(ui.Fit.Cover())], "/_hive/asset/beach.jpg", "a beach"),
        	ui.text([ui.place(ui.Align.End(), ui.Align.Start()), ui.background(ui.Tone.Danger())], "new")
        ])
        ~CODE~

        **~BT~place~BT~ and ~BT~span~BT~ work only in a grid or a stack**; a row's children follow
        the row's ~BT~align~BT~ and ~BT~justify~BT~.

        ## A paragraph

        Its ~BT~text~BT~s and ~BT~link~BT~s **wrap as one run of words**, each with its own weight,
        style, colour and background; an ~BT~icon~BT~ sits in the line like a letter, any other
        widget as one block. A ~BT~text~BT~ in a paragraph is never a heading.

        ~CODE~hive
        ui.paragraph([], [
        	ui.text([], "Read "),
        	ui.link([ui.on(Msg.Terms())], "/terms", "the terms"),
        	ui.text([ui.weight(700)], " before you sign.")
        ])
        ~CODE~

        ## Choosing

        ~BT~select~BT~, ~BT~radio~BT~ and ~BT~tabs~BT~ hold **one** choice; ~BT~onChoose~BT~ reports the new one.
        ~BT~choices~BT~ holds **any number**; ~BT~onChoose~BT~ reports the option clicked, chosen or
        not, for the program to add or remove.

        ~CODE~hive
        ui.radio([ui.onChoose(Msg.Size(_))], ["Small", "Medium", "Large"], state.size)
        ui.choices([ui.onChoose(Msg.Flip(_))], ["red", "green", "blue"], state.colours)
        ui.tabs([ui.onChoose(Msg.Page(_))], ["Profile", "Billing", "Team"], state.page)
        ~CODE~

        A radio group is a column, or wrapping lines with ~BT~wrap(true)~BT~. ~BT~tabs~BT~ is only
        the strip; the program draws what is under it from the same state. ~BT~progress~BT~ is
        a bar as wide as it is given, filled ~BT~done~BT~ of the way; ~BT~spinner~BT~ is for waiting
        with no measure.

        ## A tree

        A ~BT~branch~BT~'s children show only when ~BT~open~BT~ is true. **~BT~on~BT~ hears its row
        clicked, ~BT~onToggle~BT~ its arrow** (handed what the branch would become);
        ~BT~selected(true)~BT~ marks the program's pick. On the focused branch **Right** opens,
        **Left** closes, **Enter** picks.

        ~CODE~hive
        func folderView(f: Folder): ui.View \{
        	mut ui.View[dyn] kids = []
        	for each child in f.children \{
        		append(kids, folderView(child))
        	}
        	return ui.branch([ui.on(Msg.Pick(f.id)), ui.onToggle(Msg.Fold(f.id, _)),
        		ui.selected(f.id == picked)], f.name, f.open, kids)
        }
        ~CODE~

        ## ~BT~overlay~BT~

        - **No ~BT~align~BT~ or ~BT~justify~BT~**: a dialog, centred over a dimmed page.
        - **Either**: pinned to that edge — a heads-up display, a toast, a legend over a
          picture. Nothing is dimmed, **clicks pass through wherever the panel is not**,
          and with no rounded corner, shadow or height cap, ~BT~grow~BT~ and ~BT~align(Stretch)~BT~
          run it the window's full width or height.
        - **~BT~anchor~BT~**: at the last pointer press (~BT~Anchor.Pointer~BT~) or under the caret
          of the code editor being typed in (~BT~Anchor.Caret~BT~), above it if there is no
          room below — a context menu, a list of completions. Nothing is dimmed; **a
          press anywhere else is its ~BT~onDismiss~BT~**.

        Over part of the window rather than all of it, use a ~BT~stack~BT~.

        ## A button or field in its own colour

        A ~BT~button~BT~, ~BT~input~BT~, ~BT~textarea~BT~, ~BT~select~BT~ or ~BT~code~BT~ with a ~BT~background~BT~ draws **no
        edge** unless given ~BT~border~BT~ or ~BT~borderTone~BT~; such a button lights up under the
        pointer instead of taking the accent. ~BT~radius(n)~BT~ rounds it (a button is a pill
        by default); ~BT~ring(false)~BT~ hides the accent ring while it has focus.

        ## ~BT~link~BT~

        Works without an event: a window follows the **message**, a served page the
        **href**. **A link may point only to** a path within the page, a relative path,
        or ~BT~http~BT~, ~BT~https~BT~, ~BT~mailto~BT~; anything else renders with no destination.
    `)
}

func attributes(): Str {
    return page.backticked(`
        # ~BT~hive.ui~BT~ — the attributes

        Each attribute is a call answering a ~BT~hive.ui.Attr~BT~ — a semantic token, not a CSS
        value — in the vector every widget takes first. Events: [ui-events](ui-events.md).

        | attribute | carries |
        | --- | --- |
        | ~BT~gap(n)~BT~ ~BT~pad(n)~BT~ ~BT~width(n)~BT~ ~BT~height(n)~BT~ ~BT~grow(n)~BT~ | ~BT~Int~BT~ |
        | ~BT~minWidth(n)~BT~ ~BT~maxWidth(n)~BT~ ~BT~minHeight(n)~BT~ ~BT~maxHeight(n)~BT~ | ~BT~Int~BT~ — [the limits of a size](#limits-and-a-shape) |
        | ~BT~aspect(wide, tall)~BT~ | ~BT~Int, Int~BT~ — a box ~BT~wide~BT~ to ~BT~tall~BT~ in proportion |
        | ~BT~align(Align)~BT~ ~BT~justify(Justify)~BT~ | an [enumeration](ui-enums.md) |
        | ~BT~wrap(b)~BT~ | ~BT~Bool~BT~ — a row's children, or a text's words, run on to another line |
        | ~BT~columns(widths)~BT~ ~BT~span(n)~BT~ | ~BT~Int[]~BT~, ~BT~Int~BT~ — a [grid](ui-widgets.md#a-grid-and-a-stack)'s columns, and how many a child takes |
        | ~BT~place(across, down)~BT~ | ~BT~Align, Align~BT~ — where a child of a grid or a stack stands in its room |
        | ~BT~scroll(Axis)~BT~ | ~BT~Axis~BT~ — which way a box scrolls when its contents do not fit |
        | ~BT~scrollTo(x, y, serial)~BT~ | ~BT~Int~BT~ — scroll a box to a place, in pixels, when first seen and whenever the number changes |
        | ~BT~anchor(Anchor)~BT~ | ~BT~Anchor~BT~ — an overlay that opens at the pointer or the caret |
        | ~BT~size(TextSize)~BT~ | ~BT~TextSize~BT~ |
        | ~BT~heading(n)~BT~ | ~BT~Int~BT~ — the heading level |
        | ~BT~weight(n)~BT~ ~BT~italic(b)~BT~ ~BT~mono(b)~BT~ ~BT~lines(n)~BT~ | ~BT~Int~BT~, ~BT~Bool~BT~, ~BT~Bool~BT~, ~BT~Int~BT~ — [a text's face and length](#text) |
        | ~BT~tone(Tone)~BT~ ~BT~background(Tone)~BT~ ~BT~paint(Tone)~BT~ | [~BT~Tone~BT~](ui-colour.md) — text's colour; a box's fill; a canvas mark's or scene shape's colour |
        | ~BT~gradient(from, to, angle)~BT~ | ~BT~Tone, Tone, Float~BT~ — a fill that runs from one tone to another |
        | ~BT~opacity(f)~BT~ ~BT~shadow(n)~BT~ ~BT~ease(ms)~BT~ | ~BT~Float~BT~, ~BT~Int~BT~, ~BT~Int~BT~ — [how a box looks, and how it changes](#how-a-box-looks) |
        | ~BT~kind(InputKind)~BT~ | ~BT~InputKind~BT~ — what an ~BT~input~BT~ is for |
        | ~BT~limits(low, high, step)~BT~ | ~BT~Float~BT~ — what a slider or a number runs between, and its step |
        | ~BT~fit(Fit)~BT~ | ~BT~Fit~BT~ — how a picture fills its box |
        | ~BT~placeholder(text)~BT~ ~BT~hint(text)~BT~ ~BT~title(text)~BT~ | ~BT~Str~BT~ — ghost text in an empty ~BT~input~BT~; a **tooltip** on any widget; [the window's title](#state) |
        | ~BT~touch(name)~BT~ | ~BT~Str~BT~ — a thumb control, heard as pad -1 by a scene's ~BT~onPad~BT~ |
        | ~BT~keys(names)~BT~ | ~BT~Str[dyn]~BT~ — the keys its [~BT~onKey~BT~](ui-events.md) takes |
        | ~BT~carry(word)~BT~ | ~BT~Str~BT~ — what a widget carries when it is dragged onto an [~BT~onDrop~BT~](ui-events.md) |
        | ~BT~selected(b)~BT~ | ~BT~Bool~BT~ — a [branch](ui-widgets.md#a-tree) the program has picked |
        | ~BT~caret(anchor, head, serial)~BT~ ~BT~tabSize(n)~BT~ ~BT~fontSize(n)~BT~ | ~BT~Int~BT~ — a [code editor](ui-code.md)'s |
        | ~BT~border(n)~BT~ ~BT~radius(n)~BT~ ~BT~borderTone(Tone)~BT~ | ~BT~Int~BT~, ~BT~Tone~BT~ — a box's edge: how thick (0: none), how round, in what |
        | ~BT~ring(b)~BT~ | ~BT~Bool~BT~ — ~BT~false~BT~ hides the accent ring a button or a field shows while it has the focus |
        | ~BT~hover(Tone)~BT~ | ~BT~Tone~BT~ — the colour behind any widget while the pointer is over it; a link with one is not underlined |
        | ~BT~numbers(b)~BT~ ~BT~readOnly(b)~BT~ | ~BT~Bool~BT~ — a code editor's line numbers, and whether it can be typed in |
        | ~BT~perform(command, serial)~BT~ | ~BT~Str, Int~BT~ — a code editor does undo, copy, paste… once per serial |
        | ~BT~focus(serial)~BT~ | ~BT~Int~BT~ — focus this widget (or the first field in it) whenever the number changes |
        | ~BT~clip(text, serial)~BT~ | ~BT~Str, Int~BT~ — put ~BT~text~BT~ on the clipboard whenever the number changes |
        | ~BT~disabled(b)~BT~ ~BT~busy(b)~BT~ | ~BT~Bool~BT~ — ~BT~busy~BT~: the widget is waiting |
        | ~BT~region(x, y, width, height)~BT~ ~BT~thick(w)~BT~ | ~BT~Float~BT~ — a [canvas](ui-canvas.md) |
        | ~BT~edge(Tone)~BT~ ~BT~dash(on, off)~BT~ ~BT~crop(x, y, width, height)~BT~ | a [canvas mark](ui-canvas.md)'s |
        | ~BT~at(x, y, z)~BT~ ~BT~turn(x, y, z)~BT~ ~BT~scale(x, y, z)~BT~ | ~BT~Float~BT~ — a [shape](ui-scene-shapes.md) |
        | ~BT~surface(Surface)~BT~ | a [finish](ui-scene-surfaces.md) |
        | ~BT~voice(Voice)~BT~ ~BT~pitch(f)~BT~ ~BT~volume(f)~BT~ ~BT~track(path)~BT~ | a [sound](ui-scene-sound.md) |
        | ~BT~eye(x, y, z)~BT~ ~BT~aim(yaw, pitch)~BT~ ~BT~lens(deg)~BT~ ~BT~fog(m)~BT~ | a [camera](ui-scene-camera.md) |
        | ~BT~sun(yaw, pitch)~BT~ ~BT~cast(m)~BT~ | [the sun](ui-scene-camera.md): where it stands, how far it casts |
        | ~BT~shadows(b)~BT~ ~BT~grab(b)~BT~ ~BT~crosshair(b)~BT~ | ~BT~Bool~BT~ — a scene |
        | ~BT~grain(px)~BT~ ~BT~bits(n)~BT~ | ~BT~Int~BT~ — a scene [drawn coarsely](ui-scene-camera.md) |

        **No number is widened.** ~BT~Int~BT~: ~BT~gap~BT~, ~BT~pad~BT~, ~BT~width~BT~, ~BT~height~BT~, ~BT~grow~BT~, the four
        limits, ~BT~aspect~BT~, ~BT~columns~BT~, ~BT~span~BT~, ~BT~weight~BT~, ~BT~lines~BT~, ~BT~shadow~BT~, ~BT~ease~BT~,
        ~BT~heading~BT~, ~BT~lens~BT~, ~BT~fog~BT~, ~BT~cast~BT~, ~BT~grain~BT~, ~BT~bits~BT~. ~BT~Float~BT~: everything geometric —
        ~BT~at~BT~, ~BT~turn~BT~, ~BT~eye~BT~, ~BT~aim~BT~, ~BT~region~BT~, ~BT~thick~BT~, ~BT~pitch~BT~, ~BT~volume~BT~, ~BT~opacity~BT~,
        ~BT~limits~BT~, ~BT~gradient~BT~'s angle. ~BT~ui.at(0, 1, 0)~BT~ is a compile error;
        ~BT~ui.at(0.0, 1.0, 0.0)~BT~ is not.

        ~CODE~hive
        ui.column([ui.gap(8), ui.pad(16), ui.scroll(ui.Axis.Vertical())], [
        	ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "Colonies"),
        	ui.text([ui.tone(ui.Tone.Muted())], "\{len(rows)} of \{total}"),
        	ui.table([ui.grow(1)], rows)
        ])
        ~CODE~

        ## Layout

        - ~BT~gap~BT~: space **between** a ~BT~row~BT~'s or ~BT~column~BT~'s children; ~BT~pad~BT~: space
          **inside** its edge. ~BT~align~BT~ places children across the axis, ~BT~justify~BT~ along it.
        - ~BT~grow(n)~BT~: a **share** of the leftover room; two at ~BT~grow(1)~BT~ take half each.
        - ~BT~width~BT~, ~BT~height~BT~: a fixed size; ~BT~align(ui.Align.Stretch())~BT~ fills the cross
          axis instead. **On a ~BT~row~BT~ or ~BT~column~BT~, ~BT~width~BT~ is not a floor**: the box is
          never wider than its space, so ~BT~width(460)~BT~ is the screen's width where 460
          does not fit. A ~BT~canvas~BT~, ~BT~scene~BT~ and ~BT~image~BT~ keep their width; one wider than
          its box needs ~BT~scroll(Horizontal)~BT~.
        - **~BT~wrap(true)~BT~ on a row** starts a new line wherever the next child would not
          fit; lines pack to the start, each as tall as its tallest child, with ~BT~gap~BT~
          between lines too.
        - In a [grid](ui-widgets.md#a-grid-and-a-stack), ~BT~align~BT~ places a child up and
          down in its row, ~BT~justify~BT~ across its column; a child fills its cell by default.

        ## Limits and a shape

        The limits hold a box in range however it was sized (content, ~BT~width~BT~, ~BT~grow~BT~,
        stretch); **a minimum wins over a maximum**. ~BT~aspect(16, 9)~BT~: height follows
        width; content can still make it taller unless it scrolls. ~BT~fit~BT~ on an ~BT~image~BT~:
        ~BT~Fill~BT~ stretches to the box (what an image with a ~BT~width~BT~ and a ~BT~height~BT~ always
        did), ~BT~Contain~BT~ shows all of it, ~BT~Cover~BT~ fills the box and loses the overhang.

        ## Text

        ~BT~size~BT~ picks a role, ~BT~heading~BT~ a level. ~BT~weight(n)~BT~: ~BT~100~BT~–~BT~900~BT~, ~BT~700~BT~ is bold.
        ~BT~italic(true)~BT~ slants; ~BT~mono(true)~BT~ uses the window's monospaced face. On a
        container they reach everything in it.

        ~BT~justify~BT~ on a ~BT~text~BT~ or ~BT~paragraph~BT~: ~BT~Start~BT~, ~BT~Center~BT~, ~BT~End~BT~, or ~BT~Between~BT~,
        which **justifies** — every line but a paragraph's last spread to both edges.
        ~BT~lines(n)~BT~: at most ~BT~n~BT~ lines, **the last ending in an ellipsis** where text was
        cut. ~BT~wrap(false)~BT~: lines break only at the text's own line breaks.

        ## How a box looks

        - ~BT~gradient~BT~'s angle: **radians, ~BT~0.0~BT~ left to right, positive clockwise** —
          ~BT~gradient(a, b, 1.5708)~BT~ runs top to bottom.
        - ~BT~border~BT~, ~BT~borderTone~BT~ and ~BT~radius~BT~ work on **any** box; a border with no tone
          takes the colour of the box's text.
        - ~BT~shadow(n)~BT~ lifts the box ~BT~n~BT~ pixels; ~BT~opacity(f)~BT~, ~BT~0.0~BT~ to ~BT~1.0~BT~, makes it
          and its contents see-through.
        - **~BT~ease(ms)~BT~ makes a change take ~BT~ms~BT~ milliseconds**: colours, opacity, shadow
          and a given ~BT~width~BT~ or ~BT~height~BT~ move toward the newest view on CSS's ~BT~ease~BT~
          curve. A box appearing for the first time just appears.

        ## State

        - ~BT~disabled~BT~ takes a ~BT~Bool~BT~, written off the state: ~BT~ui.disabled(len(items) == 0)~BT~.
        - ~BT~kind~BT~ gives an ~BT~input~BT~ a date picker, colour picker, file chooser, hidden
          password, or a phone's keyboard for an email, telephone number or address.
        - **~BT~title~BT~ on the outermost widget** sets the window's title bar, following the
          state — ~BT~ui.title("count \{n}")~BT~; anywhere else it does nothing. With none, the
          window keeps the title it opened with.
        - ~BT~kind(ui.InputKind.Range())~BT~ is a **slider**: its value and ~BT~onInput~BT~ text are
          a number, 0 to 100 in whole steps unless **~BT~limits(low, high, step)~BT~** says
          otherwise; step ~BT~0.0~BT~ allows any value. The same limits bound a ~BT~Number~BT~ field
          and its arrows' step. A focused slider keeps only the keys that move it, so a
          scene beside it still hears ~BT~escape~BT~.
        - ~BT~scrollTo~BT~ keeps a log at its newest line, or returns a list to where it was.
    `)
}

func events(): Str {
    return page.backticked(`
        # ~BT~hive.ui~BT~ — the events

        An event is an attribute carrying **either the message itself or a function of
        what the user did**.

        | attribute | hands your function |
        | --- | --- |
        | ~BT~on(Msg)~BT~ | — the message itself: a ~BT~button~BT~ pressed, a ~BT~link~BT~ followed, a ~BT~branch~BT~'s row clicked |
        | ~BT~onDismiss(Msg)~BT~ | — the message itself: an ~BT~overlay~BT~ closed |
        | ~BT~onInput(f)~BT~ ~BT~onSubmit(f)~BT~ ~BT~onChoose(f)~BT~ | ~BT~Str~BT~ — an ~BT~input~BT~ or ~BT~textarea~BT~ changing; one entered; a ~BT~select~BT~, ~BT~radio~BT~ group or ~BT~tabs~BT~ moving to an option, or a ~BT~choices~BT~ option clicked |
        | ~BT~onKey(f)~BT~ | ~BT~Str~BT~ — a key a widget took with ~BT~keys~BT~ |
        | ~BT~onEdit(f)~BT~ | ~BT~Int, Int, Str~BT~ — a [code editor](ui-code.md)'s edit |
        | ~BT~onCaret(f)~BT~ ~BT~onView(f)~BT~ | ~BT~Int, Int~BT~ — its selection, and the lines in view |
        | ~BT~onHover(f)~BT~ ~BT~onJump(f)~BT~ | ~BT~Int~BT~ — the character under the pointer, and under a Ctrl+click |
        | ~BT~onFit(f)~BT~ | ~BT~Int, Int~BT~ — the columns and rows that fit in a code editor |
        | ~BT~onProbe(f)~BT~ | ~BT~Int~BT~ — the character of a code editor under the pointer while Ctrl is held, -1 when it is let go |
        | ~BT~onPaste(f)~BT~ | ~BT~Str~BT~ — the clipboard's text, on Ctrl+V in a widget that takes it |
        | ~BT~onMenu(Msg)~BT~ ~BT~onMiddle(Msg)~BT~ ~BT~onDouble(Msg)~BT~ | — a right click, a middle click, a double click |
        | ~BT~onEnter(Msg)~BT~ ~BT~onLeave(Msg)~BT~ | — the pointer coming over a widget, and going off it |
        | ~BT~onFocus(Msg)~BT~ ~BT~onBlur(Msg)~BT~ | — the focus arriving in a widget or anything in it, and leaving |
        | ~BT~onPress(f)~BT~ ~BT~onPoint(f)~BT~ ~BT~onRelease(f)~BT~ | ~BT~Float, Float~BT~ — [where the pointer is](#where-the-pointer-is) when pressed, as it moves, when let go |
        | ~BT~onWheel(f)~BT~ | ~BT~Float, Float~BT~ — how far the wheel turned, across and down, in pixels |
        | ~BT~onDrag(f)~BT~ | ~BT~Int, Int, Bool~BT~ — how far since the press, and whether it was let go |
        | ~BT~onScroll(f)~BT~ | ~BT~Int, Int~BT~ — how far a box that scrolls is scrolled, across and down, in whole pixels |
        | ~BT~onSize(f)~BT~ | ~BT~Int, Int~BT~ — how wide and how tall a widget landed, in pixels |
        | ~BT~onDrop(f)~BT~ | ~BT~Str~BT~ — what was [carried](#carrying-and-dropping) onto it |
        | ~BT~onFile(f)~BT~ | ~BT~Str, Str~BT~ — [a file's name and its bytes](#a-file) |
        | ~BT~onToggle(f)~BT~ | ~BT~Bool~BT~ — a ~BT~checkbox~BT~, or a ~BT~branch~BT~ opening (~BT~true~BT~) or closing |
        | ~BT~onPick(f)~BT~ ~BT~onSort(f)~BT~ | ~BT~Int~BT~ — a ~BT~table~BT~ row chosen, a column asked to sort by, each **by index** |
        | ~BT~onKeyDown(f)~BT~ ~BT~onKeyUp(f)~BT~ | ~BT~Str~BT~ — a [scene](ui-scene-input.md) |
        | ~BT~onFrame(f)~BT~ | ~BT~Int~BT~ — a scene |
        | ~BT~onLook(f)~BT~ | ~BT~Float, Float~BT~ — a scene |
        | ~BT~onGrab(f)~BT~ | ~BT~Bool~BT~ — a scene |
        | ~BT~onPad(f)~BT~ | ~BT~Int, Str, Float~BT~ — a scene |
        | ~BT~onRate(f)~BT~ | ~BT~Int~BT~ — a scene |

        ~BT~on~BT~, ~BT~onDismiss~BT~, ~BT~onInput~BT~, ~BT~onSubmit~BT~, ~BT~onChoose~BT~, ~BT~onToggle~BT~, ~BT~onPick~BT~ and
        ~BT~onSort~BT~ are on the widgets named; **the rest are on any widget.**

        ## A constructor with a hole is the function

        By [partial application](../expressions.md), ~BT~Msg.Typed(_)~BT~ is already a
        ~BT~func(Str): Msg~BT~:

        ~CODE~hive
        type Msg \{
        	Typed   \{ text: Str }
        	Toggled \{ done: Bool }
        	Chose   \{ option: Str }
        	Send
        }

        ui.input([ui.onInput(Msg.Typed(_))], state.draft)
        ui.checkbox([ui.onToggle(Msg.Toggled(_))], "done", state.done)
        ui.select([ui.onChoose(Msg.Chose(_))], options, state.chosen)
        ui.button([ui.on(Msg.Send())], "Send")
        ~CODE~

        - **The shape must match** or it does not compile: ~BT~onToggle~BT~ hands a ~BT~Bool~BT~, so
          its function takes one. Two values take a **two-hole** constructor —
          ~BT~ui.onLook(Msg.Looked(_, _))~BT~ — three take three.
        - Fill in what the event does not report at the call site:
          ~BT~ui.onToggle(Msg.Set(item.id, _))~BT~.

        ## Keys a widget takes for itself

        ~BT~keys([...])~BT~ names the keys a widget takes; ~BT~onKey(f)~BT~ hears them. **The
        innermost widget around the focus naming a key gets it**, and nothing else
        happens: the field does not type it, Tab does not move focus, the window does not
        close. Unnamed keys go on as usual. With nothing focused the outermost widget is
        around the focus, so window shortcuts go there:

        ~CODE~hive
        ui.column([ui.keys(["Ctrl+S", "Ctrl+Shift+P", "F5"]), ui.onKey(Msg.Shortcut(_))], [
        	ui.input([ui.keys(["ArrowUp", "ArrowDown"]), ui.onKey(Msg.History(_))], state.line),
        	ui.textarea([ui.keys(state.mode.claimed), ui.onKey(Msg.Normal(_))], state.text)
        ])
        ~CODE~

        - **With nothing but Shift held**, a key is named by what it types: ~BT~"a"~BT~, ~BT~"A"~BT~, ~BT~":"~BT~.
        - **With Ctrl or Alt held**, by the key, modifiers first: ~BT~"Ctrl+S"~BT~,
          ~BT~"Ctrl+Shift+P"~BT~, ~BT~"Ctrl+Alt+O"~BT~, ~BT~"Ctrl+,"~BT~.
        - Keys that type nothing: ~BT~Enter~BT~ ~BT~Escape~BT~ ~BT~Tab~BT~ ~BT~Backspace~BT~ ~BT~Delete~BT~ ~BT~Insert~BT~
          ~BT~Space~BT~ ~BT~ArrowUp~BT~ ~BT~ArrowDown~BT~ ~BT~ArrowLeft~BT~ ~BT~ArrowRight~BT~ ~BT~Home~BT~ ~BT~End~BT~ ~BT~PageUp~BT~
          ~BT~PageDown~BT~ ~BT~F1~BT~…~BT~F12~BT~, with Shift in front where held: ~BT~"Shift+Tab"~BT~.
        - ~BT~"Any"~BT~ takes every key, typing included. The list is state: a mode can take
          ~BT~"Any"~BT~ and the next mode nothing.

        ## The pointer's own events

        ~BT~onMenu~BT~, ~BT~onMiddle~BT~, ~BT~onDouble~BT~, ~BT~onPress~BT~, ~BT~onRelease~BT~, ~BT~onWheel~BT~ and ~BT~onDrop~BT~
        go to **the innermost widget under the pointer that hears them**: a right click
        on a list row opens that row's menu, and an overlay anchored at the pointer opens
        at the click.

        - ~BT~onDrag(f)~BT~: the distance since the press, across and down, while moving and
          once more on release; a divider adds it to the size it started from:
          ~BT~ui.column([ui.height(5), ui.onDrag(Msg.Resize(_, _, _))], [])~BT~.
        - **~BT~onEnter~BT~ and ~BT~onLeave~BT~ come in pairs** for each widget crossed that hears
          them, innermost first; a widget removed under the pointer gets no ~BT~onLeave~BT~.
        - **~BT~onFocus~BT~ and ~BT~onBlur~BT~ fire as focus enters or leaves a widget and everything
          in it**: moving between two fields of a form tells the form nothing. The window
          losing focus to another program is not a widget losing it.
        - A widget hearing ~BT~onWheel~BT~ keeps the wheel; its container does not scroll.

        ## Where the pointer is

        ~BT~onPress~BT~, ~BT~onPoint~BT~, ~BT~onRelease~BT~: **pixels from the widget's top left corner —
        on a [canvas](ui-canvas.md), the canvas's own units**. ~BT~onPoint~BT~ fires at most
        once a frame while the pointer moves over the widget, and, while a press begun on
        it is held, wherever the pointer goes. ~BT~onRelease~BT~ goes to the widget the press
        began on.

        ~CODE~hive
        ui.canvas([ui.region(0.0, 0.0, 100.0, 100.0), ui.onPress(Msg.PlaceAt(_, _))], marks)
        ~CODE~

        ## Carrying and dropping

        ~BT~carry(word)~BT~ makes a widget **draggable**; the widget hearing ~BT~onDrop~BT~ where it
        is let go is handed the word — an id, a name, a position, as the program likes.

        ~CODE~hive
        ui.text([ui.carry(card.id)], card.title)
        ui.column([ui.onDrop(Msg.MoveTo(column.id, _))], cards)
        ~CODE~

        ## A file

        ~BT~onFile(f)~BT~: a file's **name**, without its folder, and **its bytes as a ~BT~Str~BT~**,
        as [~BT~hive.file~BT~](file.md) reads one, so binary survives. It fires when an input of
        ~BT~kind(InputKind.File)~BT~ chooses a file, and on **any widget a file is dropped on**
        from the desktop — one event per file.

        ~CODE~hive
        ui.input([ui.kind(ui.InputKind.File()), ui.onFile(Msg.Uploaded(_, _))], "")
        ~CODE~

        ## ~BT~onSize~BT~

        Fires **only when a widget first lands and when its size changes**. Keep it in
        the model: it is not sent again until the widget moves.

        ## There is no command

        The message goes to ~BT~update~BT~, [a service's handler](syslink.md): it writes the
        state; its return is read only by a request from another node. **Work goes to a
        service**, which posts a message back to the window's address (handed to an
        ~BT~update~BT~ taking a third parameter).
    `)
}

func enums(): Str {
    return page.backticked(`
        # ~BT~hive.ui~BT~ — the enumerations

        Ordinary closed types, **called with ~BT~()~BT~ like any variant**: ~BT~ui.Align.Center()~BT~,
        not ~BT~ui.Align.Center~BT~. None is an atom.

        | type | variants |
        | --- | --- |
        | ~BT~Align~BT~ | ~BT~Start~BT~ ~BT~Center~BT~ ~BT~End~BT~ ~BT~Stretch~BT~ |
        | ~BT~Justify~BT~ | ~BT~Start~BT~ ~BT~Center~BT~ ~BT~End~BT~ ~BT~Between~BT~ |
        | ~BT~TextSize~BT~ | ~BT~Title~BT~ ~BT~Subtitle~BT~ ~BT~Body~BT~ ~BT~Caption~BT~ |
        | ~BT~Axis~BT~ | ~BT~Horizontal~BT~ ~BT~Vertical~BT~ ~BT~Both~BT~ |
        | ~BT~Anchor~BT~ | ~BT~Pointer~BT~ ~BT~Caret~BT~ — where an [overlay](ui-widgets.md) opens |
        | ~BT~InputKind~BT~ | ~BT~Text~BT~ ~BT~Number~BT~ ~BT~Date~BT~ ~BT~Password~BT~ ~BT~Search~BT~ ~BT~Range~BT~ ~BT~Time~BT~ ~BT~DateTime~BT~ ~BT~Email~BT~ ~BT~Tel~BT~ ~BT~Url~BT~ ~BT~Color~BT~ ~BT~File~BT~ |
        | ~BT~Fit~BT~ | ~BT~Fill~BT~ ~BT~Contain~BT~ ~BT~Cover~BT~ — how a picture fills its box |
        | [~BT~Icon~BT~](ui-icons.md) | 320 of them, from ~BT~Search~BT~ to ~BT~Fish~BT~ |
        | [~BT~Tone~BT~](ui-colour.md) | ~BT~Normal~BT~ ~BT~Muted~BT~ ~BT~Good~BT~ ~BT~Warn~BT~ ~BT~Danger~BT~ ~BT~HEX(Str)~BT~ ~BT~RGBA(Int, Int, Int, Int)~BT~ |
        | [~BT~Surface~BT~](ui-scene-surfaces.md) | nineteen finishes |
        | [~BT~Voice~BT~](ui-scene-sound.md) | ~BT~Engine~BT~ ~BT~Tyres~BT~ ~BT~Brakes~BT~ ~BT~Wind~BT~ ~BT~Crowd~BT~ ~BT~Music~BT~ ~BT~Impact~BT~ ~BT~Chime~BT~ ~BT~Talk~BT~ |

        ~CODE~hive
        ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], "TURN 7")
        ui.input([ui.kind(ui.InputKind.Password())], state.secret)
        ui.icon([], ui.Icon.Trash())
        ui.column([ui.scroll(ui.Axis.Both())], rows)
        ~CODE~

        - Variants are listed in **declaration order**: the order ~BT~sort~BT~ puts them in and
          a ~BT~==~BT~ comparison rests on.
        - They are matched like any type — ~BT~if chosen is ui.Align.End~BT~ — and a program
          storing one stores a ~BT~hive.ui.Align~BT~.
        - **The icon list is closed**: no name to pass, no file to point at. An icon not
          on [the list](ui-icons.md) is a ~BT~text~BT~ or an ~BT~image~BT~.
        - **~BT~InputKind~BT~**: ~BT~Time~BT~ and ~BT~DateTime~BT~ get a picker, as ~BT~Date~BT~ does; ~BT~Email~BT~,
          ~BT~Tel~BT~ and ~BT~Url~BT~ get a phone's keyboard for them and are otherwise text; ~BT~Color~BT~
          is a swatch whose value is ~BT~#rrggbb~BT~; ~BT~File~BT~ is a button opening a chooser,
          heard through [~BT~onFile~BT~](ui-events.md#a-file), not ~BT~onInput~BT~.
    `)
}

func icons(): Str {
    return page.backticked(`
        # ~BT~hive.ui~BT~ — the icons

        ~BT~icon(attrs, name)~BT~ draws one of these as ~BT~ui.Icon.<Name>()~BT~, **in the colour and
        at the size of the text around it**: ~BT~tone~BT~ colours it, ~BT~size~BT~ sizes it, and in a
        [paragraph](ui-widgets.md#a-paragraph) it stands in the line as a letter would.

        ~CODE~hive
        ui.row([ui.gap(6), ui.align(ui.Align.Center())], [
        	ui.icon([ui.tone(ui.Tone.Good())], ui.Icon.CircleCheck()),
        	ui.text([], "saved")
        ])
        ~CODE~

        They are drawn from [Lucide](https://lucide.dev), the same on a page and in a
        window. **The list is closed**: what is not here is a ~BT~text~BT~ or an ~BT~image~BT~. ~BT~Up~BT~,
        ~BT~Down~BT~, ~BT~Left~BT~ and ~BT~Right~BT~ are arrows; the ~BT~Chevron~BT~s are the narrower marks.

        ~CODE~
        Search Close Check Plus Minus Up Down Left Right Warning
        Info Star Heart Reply Repeat Trash User Menu ChevronUp ChevronDown
        ChevronLeft ChevronRight ChevronsUp ChevronsDown ChevronsLeft ChevronsRight UpRight UpLeft DownRight DownLeft
        CornerDownLeft CornerUpRight Expand Shrink Maximize Minimize ExternalLink Undo Redo Refresh
        RotateLeft RotateRight Home More MoreVertical Grip Move LogIn LogOut Sidebar
        Columns Edit Copy Clipboard ClipboardCheck Cut Save Download Upload Share
        Send Print Filter Sort SortUp SortDown ZoomIn ZoomOut Settings Sliders
        Wrench Lock Unlock Key Shield ShieldCheck Eye EyeOff Pin Unpin
        Bookmark Tag Flag Link Unlink Paperclip Archive Inbox Bell BellOff
        Mail Message Messages Phone Video VideoOff Mic MicOff Camera Image
        Film Music Headphones Volume VolumeLow Mute Play Pause Stop SkipForward
        SkipBack FastForward Rewind Shuffle File FileText FilePlus Files Folder FolderOpen
        FolderPlus Code Terminal Database Server Cloud CloudUpload CloudDownload HardDrive Package
        Layers Dashboard Grid List ListOrdered ListChecks Kanban Calendar Clock Timer
        Hourglass Alarm History Users UserPlus UserMinus UserCheck Contact Smile Frown
        Meh Laugh ThumbsUp ThumbsDown Award Trophy Crown Gift Cake Hand
        Handshake Accessibility Baby CircleAlert CircleX CircleCheck CircleHelp Ban Loader Activity
        Zap Flame Battery BatteryLow BatteryCharging Wifi WifiOff Bluetooth Signal Power
        Plug Cpu Monitor Laptop Smartphone Tablet Keyboard Mouse Gamepad Tv
        Watch Speaker Usb Router Network Satellite Radio Rss Scan QrCode
        Barcode Fingerprint Bot Brain Bug Branch Commit Merge PullRequest Command
        Cart Bag CreditCard Wallet Dollar Euro Percent Receipt Store Truck
        Coins Banknote Calculator ChartBar ChartLine ChartPie TrendingUp TrendingDown Gauge Target
        Map MapPin Navigation Compass Globe Building Factory School Hospital Car
        Bus Train Plane Ship Bike Rocket Fuel Footprints Sun Moon
        Sunrise Sunset CloudRain Snowflake Wind Umbrella Thermometer Droplet Leaf Flower
        Tree Mountain Waves Bold Italic Underline Strikethrough Heading Quote AlignLeft
        AlignCenter AlignRight AlignJustify Hash At Asterisk Circle Triangle Hexagon Diamond
        Sparkles Wand Palette Brush PenTool Crop Ruler Pipette Eraser Shapes
        Puzzle Lightbulb Book BookOpen Newspaper GraduationCap Briefcase CheckSquare ToggleLeft ToggleRight
        Infinity Sigma Crosshair Focus Aperture Feather Ghost Dice Megaphone Coffee
        Pizza Utensils Wine Apple Shirt Glasses Dog Cat Bird Fish
        ~CODE~

        Lucide is ISC-licensed, and parts of it come from Feather, which is MIT; the
        notices travel in ~BT~runtime/NOTICE.md~BT~.
    `)
