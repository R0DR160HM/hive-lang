// The standard library
// ====================
// What `hive.<module>.<name>` means. A module says what Hive sees of it in its
// stub, beside its Go under `runtime/hive`; this file holds what a signature
// cannot say: the names the Go goes by and the unions a module declares in Hive.
import ./ast
import ./runtime
import ./text
import ./types

func modules(): Str[dyn] {
    stubs := runtime.stubs()
    mut Str[dyn] out = []
    for each stub in stubs {
        if runtime.moduleOf(stubs, stub) == stub {
            append(out, stub)
        }
    }
    return out
}

// Whether `module` is one this compiler carries.
func isKnownModule(module: Str): Bool {
    return indexOf(modules(), module) is Result.Ok(_)
}

// The name a library call carries on the runtime package: `hive.conv.its` becomes
// `hive.ConvIts`. One rule, so a module added tomorrow needs no entry. One
// exception: capitalising `hive.net.httpRequest` spells the value it takes, so the
// call is `NetHttpSend`.
func goNameOf(t: types.Table, module: Str, name: Str): Str {
    if module == "net" && name == "httpRequest" {
        return "NetHttpSend"
    }
    if module == "ui" {
        // An attribute and an enumeration can be the same word — `align` sets one
        // and `Align` is the set it comes from — so the attribute says so in its
        // runtime name and the enumeration keeps the plain one.
        if isUiAttr(t, name) {
            return "UiAttr" + text.capitalise(name)
        }
        // And one widget is the same word as an enumeration, for the same reason
        // and with the same fix.
        if name == "icon" {
            return "UiIconOf"
        }
    }
    return text.capitalise(module) + text.capitalise(name)
}

// Refused here because nothing downstream can: the Go toolchain finding it
// missing is far too late to name the thing at fault.
func hasName(t: types.Table, module: Str, name: Str): Bool {
    return types.libraryAt(t, module, name) >= 0
}

// One that names a type variable reads it off what it was handed, as the global builtins do.
func resultOf(t: types.Table, module: Str, name: Str, args: types.Ty[]): types.Ty {
    // A name that opens with a capital is one of the library's own types being
    // built, and what it answers with is itself.
    if isLibType(t, module, name) {
        return types.Ty.TLib(module, name)
    }
    // `hive.math` answers with a `Float32` when handed only those.
    if module == "math" && len(args) > 0 && allFloat32(args) && len(types.callNames(t, module, name)) > 0 {
        return types.Ty.TFloat32()
    }
    answer := types.callAnswer(t, module, name, args)
    // A statement declared no rows, and answers with how many it touched.
    if module == "sql" && name == "run" {
        if answer is types.Ty.TResult(rows, bad) && rows is types.Ty.TVoid {
            return types.Ty.TResult(types.Ty.TInt(), bad)
        }
    }
    return answer
}

func allFloat32(args: types.Ty[]): Bool {
    for each a in args {
        if (a is types.Ty.TFloat32) == false {
            return false
        }
    }
    return true
}

// The whole list, so its length is the call's arity. A position that is the
// program's own business is `TUnknown`, which `accepts` waves through. `Error`
// is for one of the library's own types, which has no signature to be held to.
func signatureOf(t: types.Table, module: Str, name: Str): Result<types.Ty[dyn], Bool> {
    if isLibType(t, module, name) {
        return Result.Error(false)
    }
    return Result.Ok(paramsOf(t, module, name))
}

func paramsOf(t: types.Table, module: Str, name: Str): types.Ty[dyn] {
    return types.callParams(t, module, name)
}

func paramNamesOf(t: types.Table, module: Str, name: Str): Str[dyn] {
    return types.callNames(t, module, name)
}

// In parameter order, however they were written; a record of the library's own stays as it is.
func libraryArgs(t: types.Table, module: Str, name: Str, args: ast.Arg[]): ast.Arg[dyn] {
    if len(fieldsOf(t, module, name)) > 0 {
        mut ast.Arg[dyn] out = []
        for each a in args {
            append(out, a)
        }
        return out
    }
    return ast.positional(args, paramNamesOf(t, module, name))
}

// --- The types the library owns ----------------------------------------------

func isLibType(t: types.Table, module: Str, name: Str): Bool {
    return types.owns(t, module, name)
}

func variantsOf(t: types.Table, module: Str, name: Str): Str[dyn] {
    return types.ownedVariants(t, module, name)
}

func fieldsOf(t: types.Table, module: Str, name: Str): ast.Field[dyn] {
    return types.ownedFields(t, module, name)
}

func fieldTypeOf(t: types.Table, module: Str, typeName: Str, field: Str): types.Ty {
    for each f in fieldsOf(t, module, typeName) {
        if f.name == field {
            return types.resolve(types.emptyTable(), f.declared)
        }
    }
    return types.Ty.TUnknown()
}

// --- hive.ui ------------------------------------------------------------------
// What a `hive.ui` call answers with says what it is; an event is an `Attr` named `on...`.

func isUiAttr(t: types.Table, name: Str): Bool {
    if types.callAnswer(t, "ui", name, []) is types.Ty.TLib(_, answer) {
        return answer == "Attr"
    }
    return false
}

func isUiEvent(t: types.Table, name: Str): Bool {
    return text.startsWith(name, "on") && isUiAttr(t, name)
}

// One that takes the message itself reports nothing.
func uiEventArgs(t: types.Table, name: Str): types.Ty[dyn] {
    if isUiEvent(t, name) {
        takes := types.callTakes(t, "ui", name)
        if takes bounds 0 {
            if takes[0] is types.Ty.TFn(_, reports, _, _) {
                return reports
            }
        }
    }
    return []
}

// The scene's names are a stub and a Go file of their own because that file carries
// a download, so what brings it into a build has to be exactly what needs it.
func isUiScene(t: types.Table, name: Str): Bool {
    return types.isCall(t, "ui", name) && types.callPart(t, "ui", name) != "ui"
}

// Types a module declares in Hive, flattened in by the loader when a program
// names one, so they get everything a declared type gets. `""` is the core's
// own, which belong to no module.
func declaringModules(): Str[dyn] {
    return ["json", "file", "net", "sql", "crypto", "syslink", ""]
}

func declarationsOf(module: Str): Str {
    if module == "json" {
        return `
            type JsonValue \{
            	String \{ value: Str }
            	Boolean \{ value: Bool }
            	Int \{ value: Int }
            	Float \{ value: Float }
            	Array \{ values: JsonValue[dyn] }
            	Object \{ properties: hive.map.Map<Str, JsonValue> }
            	Null
            }
        `
    }
    if module == "file" {
        return `
            type FileError \{
            	NotFound
            	Permission
            	Exists
            	Io
            	path: Str
            	message: Str
            }
        `
    }
    if module == "net" {
        return `
            type WsError \{
            	Handshake
            	Protocol
            	Closed
            	Send
            	Receive
            	message: Str
            }

            type SocketError \{
            	Connect
            	Closed
            	Send
            	Receive
            	message: Str
            }

            type NetError \{
            	NotFound
            	Lookup
            	NoAddress
            	message: Str
            }
        `
    }
    if module == "sql" {
        return `
            type SqlError \{
            	Connection
            	Statement
            	Shape
            	Convert
            	message: Str
            }
        `
    }
    if module == "crypto" {
        return `
            type CryptoError \{
            	Malformed
            	BadSignature
            	LimitExceeded
            	Unsupported
            	message: Str
            }
        `
    }
    if module == "syslink" {
        return `
            type SyslinkError \{
            	Taken
            	Down
            	NoProc
            	Timeout
            	Unreachable
            	Decode
            	NoPeer
            	NoListener
            	NoKey
            	message: Str
            }
        `
    }
    if module == "" {
        return `
            type SecretError \{
            	LimitExceeded
            	Unsupported
            	message: Str
            }
        `
    }
    return ""
}

// The declaring modules a program using `module` needs whether or not it names
// their types: a call that can fail answers with its module's error, and one
// that makes a `Secret` with the core's.
func errorModulesFor(module: Str): Str[dyn] {
    if module == "file" || module == "net" || module == "sql" || module == "syslink" || module == "" {
        return [module]
    }
    if module == "crypto" {
        return ["crypto", ""]
    }
    if module == "term" {
        return [""]
    }
    return []
}

// Whether a flattened name is one of the error unions above, which the runtime
// reports as a struct with a `Reason` and the program reads as a union.
func isErrorUnion(name: Str): Bool {
    parts := split(name, "_")
    if len(parts) != 3 || text.charAt(parts, 0) != "hive" {
        return false
    }
    module := text.charAt(parts, 1)
    return module != "json" && indexOf(declaringModules(), module) is Result.Ok(_)
}

// The runtime's struct for one of those, which the union is lifted from.
func runtimeErrorType(name: Str): Str {
    parts := split(name, "_")
    return "hive." + text.capitalise(text.charAt(parts, 1)) + text.charAt(parts, 2)
}

// A type name holds no `_`, so no program can declare one of these.
func flatName(module: Str, name: Str): Str {
    return "hive_" + module + "_" + name
}

func isJsonValue(name: Str): Bool {
    return name == flatName("json", "JsonValue")
}

func tableHasNoJson(): Str {
    return "a `Table` — `Str[dyn][dyn]` — has no JSON of its own. A document with no declared shape is a `hive.json.JsonValue`, and rows that mean something are a vector of a type declared for them"
}

func secretHasNoJson(): Str {
    return "a `Secret` is never written out, because only `reveal` opens one"
}

func mapHasNoJson(): Str {
    return "a map does not encode: its keys are whatever was put in it, while everything else here is read from a declaration. Send its pairs as a vector of a type declared for them"
}

func tableHasNoDecoder(): Str {
    return "`Table` is not a declared type, so it has no decoder. A document with no declared shape is read with `hive.json.JsonValue.decode(text, hive.json.codec())`"
}

// What decoding in a format fails with: each module that carries a codec owns it.
func codecErrorOf(format: Str): types.Ty {
    if format == "jwt" { return types.Ty.TLib("crypto", "JwtError") }
    if format == "query" { return types.Ty.TLib("net", "QueryParamsError") }
    if format == "term" { return types.Ty.TLib("term", "FlagError") }
    return types.Ty.TLib("json", "JsonError")
}

// The format a codec's type names, read off the error its decoding fails with,
// or `""` where it names none.
func formatOfCodec(ty: types.Ty): Str {
    if ty is types.Ty.TCodec(error) {
        for each format in codecFormats() {
            if types.same(codecErrorOf(format), error) {
                return format
            }
        }
    }
    return ""
}

// The format a codec expression names when it is the library call itself, or
// `""`. Such a codec needs no value evaluated at the call it is written in.
func codecFormat(e: ast.Expr): Str {
    if e is ast.Expr.Call(callee, _, _) {
        if callee is ast.Expr.Member(subject, name, _) {
            if subject is ast.Expr.Member(root, module, _) {
                if root is ast.Expr.Ident(head, _) {
                    if head == "hive" && isKnownModule(module) {
                        // A module's own format is `codec()`; a module carrying a
                        // second one names it, which is what `jwtCodec` is.
                        if name == "codec" {
                            return module
                        }
                        if module == "crypto" && name == "jwtCodec" {
                            return "jwt"
                        }
                        if module == "net" && name == "queryParamsCodec" {
                            return "query"
                        }
                    }
                }
            }
        }
    }
    return ""
}

// The secret a codec was handed, or `Absent` where it takes none.
func codecSecret(e: ast.Expr): ast.Expr {
    if e is ast.Expr.Call(_, args, _) {
        if args bounds 0 {
            return args[0].value
        }
    }
    return ast.absent()
}

// Every format that can be written down, for a message that has to list them.
func codecFormats(): Str[dyn] {
    return ["json", "jwt", "query", "term"]
}

// The formats that carry one flat record: a query string and a command line.
func isFlatFormat(format: Str): Bool {
    return format == "query" || format == "term"
}

// What a flat format is called in a message, and what one of its keys is.
func flatCarrier(format: Str): Str {
    if format == "term" { return "a command line" }
    return "a query string"
}

func flatUnit(format: Str): Str {
    if format == "term" { return "flag" }
    return "query parameter"
}

// What one key of a flat format can hold. A vector of one is that key repeated.
func isFlatValue(ty: types.Ty): Bool {
    return ty is types.Ty.TStr || types.isNumber(ty)
        || ty is types.Ty.TBool || ty is types.Ty.TAtom
}
