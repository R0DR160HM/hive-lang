// Paths
// =====
// Enough filesystem path handling for an `import` to name a file. Paths here are
// always written with `/`, which is what an import writes and what the Go
// toolchain accepts on every platform Hive targets.
//
// Nothing here touches the disk: a path is text until somebody opens it.
import ./text

/// Everything before the last `/`, or `"."` when there is none.
func dirOf(path: Str): Str {
	segments := split(path, "/")
	if len(segments) <= 1 {
		return "."
	}
	mut Str[dyn] out = []
	for i := 0; i < len(segments) - 1; i++ {
		append(out, text.charAt(segments, i))
	}
	joined := join(out, "/")
	if joined == "" {
		return "/"
	}
	return joined
}

/// Everything after the last `/`.
func baseOf(path: Str): Str {
	segments := split(path, "/")
	return text.charAt(segments, len(segments) - 1)
}

/// The base name without its extension: `main.hive` is `main`.
func stem(path: Str): Str {
	base := baseOf(path)
	segments := split(base, ".")
	if len(segments) <= 1 {
		return base
	}
	mut Str[dyn] out = []
	for i := 0; i < len(segments) - 1; i++ {
		append(out, text.charAt(segments, i))
	}
	return join(out, ".")
}

/// The extension including its dot, or `""`.
func extensionOf(path: Str): Str {
	base := baseOf(path)
	if indexOf(base, ".") is Result.Ok(_) {
		segments := split(base, ".")
		return "." + text.charAt(segments, len(segments) - 1)
	}
	return ""
}

/// `a` and `b`, one after the other. An absolute `b` replaces `a` outright,
/// which is what makes this safe to reach for without asking first.
func joinPath(a: Str, b: Str): Str {
	if b == "" {
		return a
	}
	if text.startsWith(b, "/") || a == "" || a == "." {
		return b
	}
	if text.endsWith(a, "/") {
		return a + b
	}
	return a + "/" + b
}

/// A path with its `.` and `..` segments resolved away, so two spellings of one
/// file are one string. A module's identity is its path, so `./lib/../lib/text`
/// has to be the same module as `./lib/text` or it is loaded twice, with types
/// of its own.
func normalise(path: Str): Str {
	rooted := text.startsWith(path, "/")
	mut Str[dyn] out = []
	for each segment in split(path, "/") {
		if segment == "" || segment == "." {
			// A `//` and a `.` say nothing about where the path goes.
			continue
		}
		last := len(out) - 1
		if segment == ".." && out bounds last && text.charAt(out, last) != ".." {
			drop(out, last, last)
			continue
		}
		append(out, segment)
	}
	joined := join(out, "/")
	if rooted {
		return "/" + joined
	}
	if joined == "" {
		return "."
	}
	return joined
}

func lastOf(segments: Str[]): Str {
	return text.charAt(segments, len(segments) - 1)
}
