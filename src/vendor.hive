// Vendoring
// =========
// What a Hive build places for itself, and only for a program that draws a
// `hive.ui.scene`: the engine in `scene/`, as the program a window of the
// program's own starts beside itself and as the WebAssembly a page runs. Both
// are embedded, so the executable runs offline.
//
// A released compiler pins each file by SHA-256 and fetches it once from its own
// release; one that does not hash to its pin fails the build — not used, not
// cached. A compiler built from source pins nothing and takes what `scene/build`
// left on this machine.
import ./fetch
import ./paths
import ./progress
import ./version
import hive.crypto
import hive.env
import hive.file
import hive.net

// The engine a scene is drawn by in a window the program draws itself, for a
// platform. `""` where there is none, and the window stays a page there.
func engineFile(os: Str, arch: Str): Str {
    if os == "windows" && arch == "amd64" {
        return "hive-scene-windows-amd64.exe"
    }
    if os == "linux" && arch == "amd64" {
        return "hive-scene-linux-amd64"
    }
    return ""
}

// The engine as a page runs it: the module that loads it, and the engine. The
// first finds the second beside itself.
func pageFiles(): Str[dyn] {
    return ["hive-scene.js", "hive-scene.wasm"]
}

// The SHA-256 of each file this release was published with. Empty in a compiler
// built from source: the workflow writes them in for a release.
func engineDigest(file: Str): Str {
    if file == "hive-scene-windows-amd64.exe" {
        return ""
    }
    if file == "hive-scene-linux-amd64" {
        return ""
    }
    if file == "hive-scene.js" {
        return ""
    }
    if file == "hive-scene.wasm" {
        return ""
    }
    return ""
}

// A file of the engine on this machine: where it is and what it hashes to. An
// empty path is none, which is for the caller to mind.
type Engine {
    path: Str
    digest: Str
}

proc engineCache(release: Str, file: Str): Str {
    return paths.joinPath(paths.joinPath(fetch.hiveHome(), "vendor/scene@" + release), file)
}

proc engineFor(os: Str, arch: Str): Result<Engine, Str> {
    file := engineFile(os, arch)
    if file == "" {
        return Result.Ok(Engine("", ""))
    }
    found := held(file)
    if found is Result.Ok(engine) {
        if engine.path == "" {
            progress.note("no scene engine on this machine ({file}), so the window will be a page — `scene/build` makes one")
        }
    }
    return found
}

// Make sure the engine a page runs is in `directory`. A scene cannot be compiled
// without it: every window can fall back to being a page, and a page has nothing
// to fall back to.
proc placePage(directory: Str): Result<Bool, Str> {
    for each file in pageFiles() {
        found := held(file)
        if found is Result.Error(why) {
            return Result.Error(why)
        }
        if found is Result.Ok(engine) {
            if engine.path == "" {
                return Result.Error("there is no scene engine on this machine for a page to run ({file}). A compiler built from source takes the one `scene/build web` leaves, or the directory `HIVE_SCENE_DIST` names.")
            }
            if hive.file.copy(engine.path, paths.joinPath(directory, file)) is Result.Error(why) {
                return Result.Error("could not copy {file} into the build: {why.message}")
            }
        }
    }
    return Result.Ok(true)
}

// Remove it again, for a program that no longer draws a scene: what is in the
// directory is what was compiled.
proc clearPage(directory: Str): void {
    for each file in pageFiles() {
        hive.file.delete(paths.joinPath(directory, file))
    }
}

// A cached file is trusted only as far as its digest goes. A half-written file
// from an interrupted build counts as not being there, and is fetched again.
proc verified(path: Str, digest: Str): Result<Str, Bool> {
    if hive.file.read(path) is Result.Ok(bytes) {
        if hive.crypto.sha256(bytes) == digest {
            return Result.Ok(bytes)
        }
    }
    return Result.Error(false)
}

// `HIVE_SCENE_DIST` names a directory of engines to use instead, which is how one
// being worked on is tried.
proc held(file: Str): Result<Engine, Str> {
    if hive.env.get("HIVE_SCENE_DIST") is Result.Ok(directory) {
        given := paths.joinPath(directory, file)
        if hive.file.read(given) is Result.Ok(bytes) {
            return Result.Ok(Engine(given, hive.crypto.sha256(bytes)))
        }
    }
    want := engineDigest(file)
    if want == "" {
        built := engineCache("dev", file)
        if hive.file.read(built) is Result.Ok(bytes) {
            return Result.Ok(Engine(built, hive.crypto.sha256(bytes)))
        }
        return Result.Ok(Engine("", ""))
    }
    cached := engineCache(version.current(), file)
    if verified(cached, want) is Result.Ok(_) {
        return Result.Ok(Engine(cached, want))
    }
    url := "https://github.com/R0DR160HM/hive-lang/releases/download/" + version.current() + "/" + file
    // A silent download of megabytes is worse than a noisy one: the first build of
    // a scene takes as long as the network does.
    progress.note("fetching the scene engine ({file})")
    asked := hive.net.httpRequest(hive.net.HttpRequest("GET", url, [], ""))
    if asked is Result.Error(why) {
        return Result.Error(unreachable(url, why.message))
    }
    if asked is Result.Ok(response) {
        if response.status != 200 {
            return Result.Error(unreachable(url, "GitHub answered {response.status}"))
        }
        got := hive.crypto.sha256(response.body)
        if got != want {
            return Result.Error(mismatch(url, want, got))
        }
        // Cached only once verified, so a bad download is never written down as a
        // good one.
        if hive.file.makeDir(paths.dirOf(cached)) is Result.Ok(_) {
            if hive.file.write(cached, response.body) is Result.Ok(_) {
                return Result.Ok(Engine(cached, want))
            }
        }
        return Result.Error("could not keep the scene engine at " + cached)
    }
    return Result.Error(unreachable(url, "nothing came back"))
}

func unreachable(url: Str, why: Str): Str {
    return "could not fetch the engine a `hive.ui.scene` is drawn by. This needs network access on the first build; after that it is cached and every build is offline:\n\n    " + url + "\n    " + why
}

func mismatch(url: Str, want: Str, got: Str): Str {
    return "the scene engine downloaded from\n\n    " + url + "\n\nis not the file this compiler pins. Expected SHA-256\n\n    " + want + "\n\nand got\n\n    " + got + "\n\nNothing was cached and nothing was compiled against it. Either the download was corrupted — try again — or those bytes are not the ones this release published, which is not something to build a program on."
}
