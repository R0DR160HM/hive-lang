// The window hive.ui draws itself
// ================================
// On Windows and Linux a window is drawn by the program rather than by a browser.
// The layout is modelled on Clay (https://github.com/nicbarker/clay) by Nic Barker:
// widths, then the text wrapped to them, then heights, then places. A scene in one
// is drawn by the engine in `scene/`, started beside the program.

import ./runtime

type Source {
    file: Str
    text: Str
}

// Every file a window drawn this way is written as. The platform files carry build
// tags, so everywhere else the program keeps the page.
func sources(): Source[dyn] {
    return [
        Source("uinative.go", runtime.file("uinative.go")),
        Source("uinative_paint.go", runtime.file("uinative_paint.go")),
        Source("uinative_input.go", runtime.file("uinative_input.go")),
        Source("uinative_select.go", runtime.file("uinative_select.go")),
        Source("uinative_media.go", runtime.file("uinative_media.go")),
        Source("uinative_frames.go", runtime.file("uinative_frames.go")),
        Source("uinative_webp.go", runtime.file("uinative_webp.go")),
        Source("uinative_webp_vp8.go", runtime.file("uinative_webp_vp8.go")),
        Source("uinative_webp_vp8l.go", runtime.file("uinative_webp_vp8l.go")),
        Source("uinative_webp_tables.go", runtime.file("uinative_webp_tables.go")),
        Source("uinative_svg.go", runtime.file("uinative_svg.go")),
        Source("uinative_svg_paint.go", runtime.file("uinative_svg_paint.go")),
        Source("uinative_svg_colors.go", runtime.file("uinative_svg_colors.go")),
        Source("uinative_access.go", runtime.file("uinative_access.go")),
        Source("uinative_windows.go", runtime.file("uinative_windows.go")),
        Source("uinative_uia_windows.go", runtime.file("uinative_uia_windows.go")),
        Source("uinative_linux.go", runtime.file("uinative_linux.go")),
        Source("uinative_dbus_linux.go", runtime.file("uinative_dbus_linux.go")),
        Source("uinative_ime_linux.go", runtime.file("uinative_ime_linux.go")),
        Source("uinative_atspi_linux.go", runtime.file("uinative_atspi_linux.go")),
        Source("uinative_font_linux.go", runtime.file("uinative_font_linux.go")),
        Source("uinative_font_cff_linux.go", runtime.file("uinative_font_cff_linux.go")),
        Source("uinative_font_var_linux.go", runtime.file("uinative_font_var_linux.go"))
    ]
}

// What a window holding a scene is written as besides.
func sceneSources(): Source[dyn] {
    return [
        Source("uinative_scene.go", runtime.file("uinative_scene.go")),
        Source("uiengine.go", runtime.file("uiengine.go")),
        Source("uiengine_windows.go", runtime.file("uiengine_windows.go")),
        Source("uiengine_linux.go", runtime.file("uiengine_linux.go"))
    ]
}

// The engine itself, carried in the executable. The file's name ends in its
// platform, which is what keeps the toolchain from linking it into any other.
func carried(file: Str, digest: Str, os: Str, arch: Str): Source {
    return Source("uiengine_carried_" + os + "_" + arch + ".go", `
        package hive

        import _ "embed"

        //go:embed {file}
        var uiEngineCarried []byte

        func init() \{ uiEngineData, uiEngineSum = uiEngineCarried, "{digest}" }
    `)
}
