// SVG, drawn at whatever size it is shown: the document, its styles and its units.
func svgSource(): Str {
	return `
		package hive

		import (
			"bytes"
			"encoding/xml"
			"io"
			"math"
			"sort"
			"strconv"
			"strings"
		)

		type uiSvgNode struct \{
			tag    string
			attrs  map[string]string
			kids   []*uiSvgNode
			parent *uiSvgNode
			text   strings.Builder
			decl   map[string]string
		}

		type uiSvgDoc struct \{
			root *uiSvgNode
			ids  map[string]*uiSvgNode
		}

		// Past this many elements the rest of a document is left out.
		const uiSvgMostNodes = 200000

		func uiSvgSniff(b []byte) bool \{
			b = bytes.TrimPrefix(b, []byte("\xef\xbb\xbf"))
			for \{
				b = bytes.TrimLeft(b, " \t\r\n")
				switch \{
				case bytes.HasPrefix(b, []byte("<?")):
					end := bytes.Index(b, []byte("?>"))
					if end < 0 \{
						return false
					}
					b = b[end+2:]
				case bytes.HasPrefix(b, []byte("<!--")):
					end := bytes.Index(b, []byte("-->"))
					if end < 0 \{
						return false
					}
					b = b[end+3:]
				case bytes.HasPrefix(b, []byte("<!")):
					depth, i := 0, 2
					for ; i < len(b); i++ \{
						if b[i] == '[' \{
							depth++
						} else if b[i] == ']' \{
							depth--
						} else if b[i] == '>' && depth <= 0 \{
							break
						}
					}
					if i >= len(b) \{
						return false
					}
					b = b[i+1:]
				default:
					if !bytes.HasPrefix(b, []byte("<")) \{
						return false
					}
					name := b[1:]
					end := bytes.IndexAny(name, " \t\r\n/>")
					if end < 0 \{
						return false
					}
					name = name[:end]
					if colon := bytes.IndexByte(name, ':'); colon >= 0 \{
						name = name[colon+1:]
					}
					return string(name) == "svg"
				}
			}
		}

		func uiParseSVG(body []byte) (uiVector, bool) \{
			if !uiSvgSniff(body) \{
				return nil, false
			}
			d := xml.NewDecoder(bytes.NewReader(body))
			d.Strict = false
			d.AutoClose = xml.HTMLAutoClose
			d.Entity = xml.HTMLEntity
			d.CharsetReader = func(_ string, in io.Reader) (io.Reader, error) \{ return in, nil }
			doc := &uiSvgDoc\{ids: map[string]*uiSvgNode\{}}
			var at *uiSvgNode
			count := 0
			for count < uiSvgMostNodes \{
				tok, err := d.Token()
				if err != nil \{
					break
				}
				switch t := tok.(type) \{
				case xml.StartElement:
					count++
					n := &uiSvgNode\{tag: t.Name.Local, attrs: map[string]string\{}, parent: at}
					for _, a := range t.Attr \{
						key := a.Name.Local
						if a.Name.Space != "" && key != "href" && a.Name.Space != "xmlns" && a.Name.Space != "http://www.w3.org/2000/svg" \{
							continue
						}
						if _, has := n.attrs[key]; key == "href" && has && a.Name.Space != "" \{
							continue
						}
						n.attrs[key] = a.Value
					}
					if at == nil \{
						if doc.root != nil \{
							continue
						}
						doc.root = n
					} else \{
						at.kids = append(at.kids, n)
					}
					if id := n.attrs["id"]; id != "" \{
						if _, taken := doc.ids[id]; !taken \{
							doc.ids[id] = n
						}
					}
					at = n
				case xml.EndElement:
					if at != nil \{
						at = at.parent
					}
				case xml.CharData:
					if at != nil && at.tag == "style" && at.text.Len() < 1<<20 \{
						at.text.Write(t)
					}
				}
			}
			if doc.root == nil || doc.root.tag != "svg" \{
				return nil, false
			}
			doc.cascade()
			return doc, true
		}

		// --- CSS: the properties an attribute, a stylesheet or a style="" may set ---------

		var uiSvgProperties = map[string]bool\{
			"fill": true, "fill-opacity": true, "fill-rule": true, "stroke": true, "stroke-width": true,
			"stroke-opacity": true, "stroke-linecap": true, "stroke-linejoin": true, "stroke-miterlimit": true,
			"stroke-dasharray": true, "stroke-dashoffset": true, "opacity": true, "display": true, "visibility": true,
			"color": true, "stop-color": true, "stop-opacity": true, "clip-path": true, "clip-rule": true, "transform": true,
		}

		type uiSvgRule struct \{
			chain [][]string
			kinds []byte
			spec  int
			order int
			decl  [][2]string
			force bool
		}

		func uiSvgDecls(s string) (normal, important [][2]string) \{
			for _, part := range strings.Split(s, ";") \{
				colon := strings.IndexByte(part, ':')
				if colon < 0 \{
					continue
				}
				key := strings.ToLower(strings.TrimSpace(part[:colon]))
				value := strings.TrimSpace(part[colon+1:])
				if i := strings.Index(strings.ToLower(value), "!important"); i >= 0 \{
					important = append(important, [2]string\{key, strings.TrimSpace(value[:i])})
					continue
				}
				normal = append(normal, [2]string\{key, value})
			}
			return
		}

		func uiSvgStripComments(s string) string \{
			for \{
				i := strings.Index(s, "/*")
				if i < 0 \{
					return s
				}
				j := strings.Index(s[i+2:], "*/")
				if j < 0 \{
					return s[:i]
				}
				s = s[:i] + " " + s[i+2+j+2:]
			}
		}

		func uiSvgRules(css string, order *int) []uiSvgRule \{
			css = uiSvgStripComments(css)
			var rules []uiSvgRule
			for len(css) > 0 \{
				open := strings.IndexByte(css, '\{')
				if open < 0 \{
					break
				}
				head := strings.TrimSpace(css[:open])
				depth, end := 1, open+1
				for ; end < len(css) && depth > 0; end++ \{
					switch css[end] \{
					case '\{':
						depth++
					case '}':
						depth--
					}
				}
				body := css[open+1 : max(open+1, end-1)]
				css = css[end:]
				if strings.HasPrefix(head, "@") \{
					continue
				}
				normal, important := uiSvgDecls(body)
				for _, sel := range strings.Split(head, ",") \{
					chain, kinds, spec, ok := uiSvgSelector(strings.TrimSpace(sel))
					if !ok \{
						continue
					}
					*order++
					rules = append(rules, uiSvgRule\{chain: chain, kinds: kinds, spec: spec, order: *order, decl: normal})
					if len(important) > 0 \{
						rules = append(rules, uiSvgRule\{chain: chain, kinds: kinds, spec: spec, order: *order, decl: important, force: true})
					}
				}
			}
			return rules
		}

		// Compound selectors of a tag, an id and classes, joined by descendant and child
		// combinators; anything else makes the whole selector match nothing.
		func uiSvgSelector(s string) ([][]string, []byte, int, bool) \{
			if s == "" \{
				return nil, nil, 0, false
			}
			s = strings.ReplaceAll(s, ">", " > ")
			var chain [][]string
			var kinds []byte
			spec := 0
			next := byte(' ')
			for _, word := range strings.Fields(s) \{
				if word == ">" \{
					next = '>'
					continue
				}
				var parts []string
				for i := 0; i < len(word); \{
					j := i + 1
					for j < len(word) && word[j] != '.' && word[j] != '#' \{
						j++
					}
					part := word[i:j]
					switch \{
					case strings.ContainsAny(part, ":[]()+~*") && part != "*":
						return nil, nil, 0, false
					case part[0] == '#':
						spec += 10000
					case part[0] == '.':
						spec += 100
					case part != "*":
						spec++
					}
					parts = append(parts, part)
					i = j
				}
				chain = append(chain, parts)
				kinds = append(kinds, next)
				next = ' '
			}
			return chain, kinds, spec, len(chain) > 0
		}

		func (n *uiSvgNode) matches(parts []string) bool \{
			classes := strings.Fields(n.attrs["class"])
			for _, p := range parts \{
				switch \{
				case p == "*":
				case p[0] == '#':
					if n.attrs["id"] != p[1:] \{
						return false
					}
				case p[0] == '.':
					found := false
					for _, c := range classes \{
						if c == p[1:] \{
							found = true
						}
					}
					if !found \{
						return false
					}
				default:
					if n.tag != p \{
						return false
					}
				}
			}
			return true
		}

		func (r *uiSvgRule) applies(n *uiSvgNode) bool \{
			last := len(r.chain) - 1
			if !n.matches(r.chain[last]) \{
				return false
			}
			at := n.parent
			for i := last - 1; i >= 0; i-- \{
				child := r.kinds[i+1] == '>'
				for at != nil && !at.matches(r.chain[i]) \{
					if child \{
						return false
					}
					at = at.parent
				}
				if at == nil \{
					return false
				}
				at = at.parent
			}
			return true
		}

		func (doc *uiSvgDoc) cascade() \{
			var rules []uiSvgRule
			order := 0
			var styles func(n *uiSvgNode)
			styles = func(n *uiSvgNode) \{
				if n.tag == "style" \{
					rules = append(rules, uiSvgRules(n.text.String(), &order)...)
				}
				for _, k := range n.kids \{
					styles(k)
				}
			}
			styles(doc.root)
			sort.SliceStable(rules, func(i, j int) bool \{
				if rules[i].force != rules[j].force \{
					return !rules[i].force
				}
				if rules[i].spec != rules[j].spec \{
					return rules[i].spec < rules[j].spec
				}
				return rules[i].order < rules[j].order
			})
			var walk func(n *uiSvgNode)
			walk = func(n *uiSvgNode) \{
				n.decl = map[string]string\{}
				for k, v := range n.attrs \{
					if uiSvgProperties[k] && k != "transform" \{
						n.decl[k] = strings.TrimSpace(v)
					}
				}
				normal, important := uiSvgDecls(n.attrs["style"])
				forced := false
				for _, r := range rules \{
					if r.force && !forced \{
						for _, d := range normal \{
							n.decl[d[0]] = d[1]
						}
						forced = true
					}
					if r.applies(n) \{
						for _, d := range r.decl \{
							n.decl[d[0]] = d[1]
						}
					}
				}
				if !forced \{
					for _, d := range normal \{
						n.decl[d[0]] = d[1]
					}
				}
				for _, d := range important \{
					n.decl[d[0]] = d[1]
				}
				for _, k := range n.kids \{
					walk(k)
				}
			}
			walk(doc.root)
		}

		// --- Values -------------------------------------------------------------------

		type uiSvgColor [4]float64

		func uiSvgHex(v uint32) uiSvgColor \{
			return uiSvgColor\{float64(v>>16&0xff) / 255, float64(v>>8&0xff) / 255, float64(v&0xff) / 255, 1}
		}

		func uiSvgFunctionArgs(s string) []string \{
			s = strings.NewReplacer(",", " ", "/", " / ").Replace(s)
			return strings.Fields(s)
		}

		func uiSvgChannel(s string, scale float64) (float64, bool) \{
			if strings.HasSuffix(s, "%") \{
				v, err := strconv.ParseFloat(s[:len(s)-1], 64)
				return uiClamp(v/100, 0, 1), err == nil
			}
			v, err := strconv.ParseFloat(s, 64)
			return uiClamp(v/scale, 0, 1), err == nil
		}

		// A colour as CSS writes one; currentColor answers with current.
		func uiSvgParseColor(s string, current uiSvgColor) (uiSvgColor, bool) \{
			s = strings.ToLower(strings.TrimSpace(s))
			switch \{
			case s == "currentcolor":
				return current, true
			case s == "transparent":
				return uiSvgColor\{}, true
			case strings.HasPrefix(s, "#"):
				h := s[1:]
				if len(h) == 3 || len(h) == 4 \{
					var b strings.Builder
					for i := 0; i < len(h); i++ \{
						b.WriteByte(h[i])
						b.WriteByte(h[i])
					}
					h = b.String()
				}
				if len(h) == 6 \{
					h += "ff"
				}
				v, err := strconv.ParseUint(h, 16, 32)
				if err != nil || len(h) != 8 \{
					return uiSvgColor\{}, false
				}
				c := uiSvgHex(uint32(v >> 8))
				c[3] = float64(v&0xff) / 255
				return c, true
			case strings.HasPrefix(s, "rgb(") || strings.HasPrefix(s, "rgba("):
				open, close := strings.IndexByte(s, '('), strings.LastIndexByte(s, ')')
				if close < open \{
					return uiSvgColor\{}, false
				}
				args := uiSvgFunctionArgs(s[open+1 : close])
				var c uiSvgColor
				c[3] = 1
				n := 0
				for _, a := range args \{
					if a == "/" \{
						continue
					}
					scale := 255.0
					if n == 3 \{
						scale = 1
					}
					v, ok := uiSvgChannel(a, scale)
					if !ok || n > 3 \{
						return uiSvgColor\{}, false
					}
					c[n] = v
					n++
				}
				return c, n >= 3
			case strings.HasPrefix(s, "hsl(") || strings.HasPrefix(s, "hsla("):
				open, close := strings.IndexByte(s, '('), strings.LastIndexByte(s, ')')
				if close < open \{
					return uiSvgColor\{}, false
				}
				var vals []float64
				alpha := 1.0
				for i, a := range uiSvgFunctionArgs(s[open+1 : close]) \{
					if a == "/" \{
						continue
					}
					if len(vals) == 3 \{
						alpha, _ = uiSvgChannel(a, 1)
						continue
					}
					a = strings.TrimSuffix(strings.TrimSuffix(a, "deg"), "%")
					v, err := strconv.ParseFloat(a, 64)
					if err != nil \{
						return uiSvgColor\{}, false
					}
					if i > 0 \{
						v /= 100
					}
					vals = append(vals, v)
				}
				if len(vals) < 3 \{
					return uiSvgColor\{}, false
				}
				h := math.Mod(math.Mod(vals[0], 360)+360, 360) / 360
				sat, l := uiClamp(vals[1], 0, 1), uiClamp(vals[2], 0, 1)
				q := l + sat - l*sat
				if l < 0.5 \{
					q = l * (1 + sat)
				}
				p := 2*l - q
				hue := func(t float64) float64 \{
					t = t - math.Floor(t)
					switch \{
					case t < 1.0/6:
						return p + (q-p)*6*t
					case t < 0.5:
						return q
					case t < 2.0/3:
						return p + (q-p)*(2.0/3-t)*6
					}
					return p
				}
				return uiSvgColor\{hue(h + 1.0/3), hue(h), hue(h - 1.0/3), alpha}, true
			}
			if v, ok := uiSvgNamed[s]; ok \{
				return uiSvgHex(v), true
			}
			return uiSvgColor\{}, false
		}

		type uiSvgPaint struct \{
			none  bool
			color uiSvgColor
			ref   string
			back  *uiSvgPaint
		}

		func uiSvgParsePaint(s string, current uiSvgColor) (uiSvgPaint, bool) \{
			s = strings.TrimSpace(s)
			if s == "none" \{
				return uiSvgPaint\{none: true}, true
			}
			if strings.HasPrefix(s, "url(") \{
				close := strings.IndexByte(s, ')')
				if close < 0 \{
					return uiSvgPaint\{}, false
				}
				ref := strings.Trim(strings.TrimSpace(s[4:close]), "'\"")
				p := uiSvgPaint\{ref: strings.TrimPrefix(ref, "#")}
				if rest := strings.TrimSpace(s[close+1:]); rest != "" \{
					if back, ok := uiSvgParsePaint(rest, current); ok \{
						p.back = &back
					}
				}
				return p, true
			}
			c, ok := uiSvgParseColor(s, current)
			return uiSvgPaint\{color: c}, ok
		}

		func uiSvgNumbers(s string) []float64 \{
			var out []float64
			p := uiSvgScanner\{s: s}
			for \{
				v, ok := p.number()
				if !ok \{
					return out
				}
				out = append(out, v)
			}
		}

		// Lengths in user units; a percentage is of the size it is measured against.
		func uiSvgLength(s string, of float64) (float64, bool) \{
			s = strings.TrimSpace(s)
			if s == "" \{
				return 0, false
			}
			units := map[string]float64\{"px": 1, "pt": 4.0 / 3, "pc": 16, "mm": 96 / 25.4, "cm": 96 / 2.54, "in": 96, "em": 16, "ex": 8, "rem": 16}
			scale := 1.0
			switch \{
			case strings.HasSuffix(s, "%"):
				scale, s = of/100, s[:len(s)-1]
			case len(s) > 2 && units[s[len(s)-2:]] != 0 && (s[len(s)-3] >= '0' && s[len(s)-3] <= '9' || s[len(s)-3] == '.'):
				scale, s = units[s[len(s)-2:]], s[:len(s)-2]
			case len(s) > 3 && strings.HasSuffix(s, "rem"):
				scale, s = 16, s[:len(s)-3]
			}
			v, err := strconv.ParseFloat(strings.TrimSpace(s), 64)
			if err != nil || math.IsNaN(v) || math.IsInf(v, 0) \{
				return 0, false
			}
			return v * scale, true
		}

		// --- Transforms -----------------------------------------------------------------

		type uiSvgM [6]float64

		var uiSvgIdentity = uiSvgM\{1, 0, 0, 1, 0, 0}

		func (m uiSvgM) mul(n uiSvgM) uiSvgM \{
			return uiSvgM\{
				m[0]*n[0] + m[2]*n[1], m[1]*n[0] + m[3]*n[1],
				m[0]*n[2] + m[2]*n[3], m[1]*n[2] + m[3]*n[3],
				m[0]*n[4] + m[2]*n[5] + m[4], m[1]*n[4] + m[3]*n[5] + m[5],
			}
		}

		func (m uiSvgM) apply(x, y float64) (float64, float64) \{
			return m[0]*x + m[2]*y + m[4], m[1]*x + m[3]*y + m[5]
		}

		func (m uiSvgM) invert() (uiSvgM, bool) \{
			det := m[0]*m[3] - m[1]*m[2]
			if det == 0 || math.IsNaN(det) \{
				return uiSvgM\{}, false
			}
			return uiSvgM\{m[3] / det, -m[1] / det, -m[2] / det, m[0] / det,
				(m[2]*m[5] - m[3]*m[4]) / det, (m[1]*m[4] - m[0]*m[5]) / det}, true
		}

		func (m uiSvgM) scale() float64 \{ return math.Sqrt(math.Abs(m[0]*m[3] - m[1]*m[2])) }

		func uiSvgTransform(s string) uiSvgM \{
			m := uiSvgIdentity
			s = strings.NewReplacer("deg", "", "px", "").Replace(s)
			for \{
				open := strings.IndexByte(s, '(')
				close := strings.IndexByte(s, ')')
				if open < 0 || close < open \{
					return m
				}
				name := strings.TrimSpace(strings.Trim(strings.TrimSpace(s[:open]), ","))
				v := uiSvgNumbers(s[open+1 : close])
				s = s[close+1:]
				var t uiSvgM
				switch \{
				case name == "matrix" && len(v) == 6:
					t = uiSvgM\{v[0], v[1], v[2], v[3], v[4], v[5]}
				case name == "translate" && len(v) == 1:
					t = uiSvgM\{1, 0, 0, 1, v[0], 0}
				case name == "translate" && len(v) == 2:
					t = uiSvgM\{1, 0, 0, 1, v[0], v[1]}
				case name == "scale" && len(v) == 1:
					t = uiSvgM\{v[0], 0, 0, v[0], 0, 0}
				case name == "scale" && len(v) == 2:
					t = uiSvgM\{v[0], 0, 0, v[1], 0, 0}
				case name == "rotate" && (len(v) == 1 || len(v) == 3):
					a := v[0] * math.Pi / 180
					t = uiSvgM\{math.Cos(a), math.Sin(a), -math.Sin(a), math.Cos(a), 0, 0}
					if len(v) == 3 \{
						t = uiSvgM\{1, 0, 0, 1, v[1], v[2]}.mul(t).mul(uiSvgM\{1, 0, 0, 1, -v[1], -v[2]})
					}
				case name == "skewX" && len(v) == 1:
					t = uiSvgM\{1, 0, math.Tan(v[0] * math.Pi / 180), 1, 0, 0}
				case name == "skewY" && len(v) == 1:
					t = uiSvgM\{1, math.Tan(v[0] * math.Pi / 180), 0, 1, 0, 0}
				default:
					return uiSvgIdentity
				}
				m = m.mul(t)
			}
		}

		// preserveAspectRatio, fitting a viewBox into a viewport.
		func uiSvgFit(box []float64, how string, x, y, w, h float64) uiSvgM \{
			sx, sy := w/box[2], h/box[3]
			fields := strings.Fields(how)
			if len(fields) > 0 && fields[0] == "defer" \{
				fields = fields[1:]
			}
			align, slice := "xMidYMid", false
			if len(fields) > 0 \{
				align = fields[0]
			}
			if len(fields) > 1 \{
				slice = fields[1] == "slice"
			}
			if align == "none" \{
				return uiSvgM\{sx, 0, 0, sy, x - box[0]*sx, y - box[1]*sy}
			}
			s := math.Min(sx, sy)
			if slice \{
				s = math.Max(sx, sy)
			}
			ax, ay := 0.5, 0.5
			if strings.HasPrefix(align, "xMin") \{
				ax = 0
			} else if strings.HasPrefix(align, "xMax") \{
				ax = 1
			}
			if strings.HasSuffix(align, "YMin") \{
				ay = 0
			} else if strings.HasSuffix(align, "YMax") \{
				ay = 1
			}
			return uiSvgM\{s, 0, 0, s, x - box[0]*s + ax*(w-box[2]*s), y - box[1]*s + ay*(h-box[3]*s)}
		}

		func uiSvgViewBox(s string) []float64 \{
			v := uiSvgNumbers(s)
			if len(v) != 4 || v[2] <= 0 || v[3] <= 0 \{
				return nil
			}
			return v
		}

		// The size a document says it is, as an <img> takes it.
		func (doc *uiSvgDoc) size() (float64, float64) \{
			box := uiSvgViewBox(doc.root.attrs["viewBox"])
			w, wok := uiSvgAbsolute(doc.root.attrs["width"])
			h, hok := uiSvgAbsolute(doc.root.attrs["height"])
			switch \{
			case wok && hok:
			case wok && box != nil:
				h = w * box[3] / box[2]
			case hok && box != nil:
				w = h * box[2] / box[3]
			case box != nil:
				w, h = box[2], box[3]
			default:
				w, h = 300, 150
			}
			if !(w > 0 && h > 0) || w > 16384 || h > 16384 \{
				return 300, 150
			}
			return w, h
		}

		func uiSvgAbsolute(s string) (float64, bool) \{
			if strings.HasSuffix(strings.TrimSpace(s), "%") \{
				return 0, false
			}
			v, ok := uiSvgLength(s, 0)
			return v, ok && v > 0
		}

		func (doc *uiSvgDoc) render(w, h int) []uint8 \{
			if w <= 0 || h <= 0 || w > 16384 || h > 16384 \{
				return nil
			}
			nw, nh := doc.size()
			r := &uiSvgRender\{doc: doc, w: w, h: h, vp: [][2]float64\{\{nw, nh}}}
			var m uiSvgM
			if box := uiSvgViewBox(doc.root.attrs["viewBox"]); box != nil \{
				m = uiSvgFit(box, doc.root.attrs["preserveAspectRatio"], 0, 0, float64(w), float64(h))
				r.vp[0] = [2]float64\{box[2], box[3]}
			} else \{
				m = uiSvgM\{float64(w) / nw, 0, 0, float64(h) / nh, 0, 0}
			}
			out := make([]uint8, w*h*4)
			st := uiSvgInitial()
			st = r.style(doc.root, st)
			if !st.display || st.opacity <= 0 \{
				return out
			}
			if st.opacity >= 1 \{
				r.children(doc.root, m, st, out, 0)
				return out
			}
			layer := make([]uint8, len(out))
			r.children(doc.root, m, st, layer, 0)
			r.merge(out, layer, st.opacity, nil)
			return out
		}
	`
}

// What an SVG draws: paths, strokes, gradients, clips and groups.
func svgPaintSource(): Str {
	return `
		package hive

		import (
			"math"
			"sort"
			"strconv"
			"strings"
		)

		type uiSvgStyle struct \{
			fill, stroke     uiSvgPaint
			fillOp, strokeOp float64
			opacity          float64
			evenOdd, clipOdd bool
			width            string
			cap, join        string
			miter            float64
			dash, dashOffset string
			color            uiSvgColor
			visible, display bool
			stopColor        uiSvgColor
			stopOp           float64
			clip             string
			transform        string
		}

		func uiSvgInitial() uiSvgStyle \{
			return uiSvgStyle\{fill: uiSvgPaint\{color: uiSvgColor\{0, 0, 0, 1}}, stroke: uiSvgPaint\{none: true},
				fillOp: 1, strokeOp: 1, opacity: 1, width: "1", cap: "butt", join: "miter", miter: 4, dash: "none",
				dashOffset: "0", color: uiSvgColor\{0, 0, 0, 1}, visible: true, display: true, stopColor: uiSvgColor\{0, 0, 0, 1}, stopOp: 1}
		}

		type uiSvgRender struct \{
			doc   *uiSvgDoc
			w, h  int
			vp    [][2]float64
			using map[*uiSvgNode]bool
			deep  int
			ras   uiRaster
			cover []uint8
		}

		func uiSvgUnit(s string) float64 \{
			v, err := strconv.ParseFloat(strings.TrimSpace(strings.TrimSuffix(strings.TrimSpace(s), "%")), 64)
			if err != nil \{
				return math.NaN()
			}
			if strings.HasSuffix(strings.TrimSpace(s), "%") \{
				v /= 100
			}
			return v
		}

		// The node's own declarations over what it inherits; opacity and clip-path are its own.
		func (r *uiSvgRender) style(n *uiSvgNode, parent uiSvgStyle) uiSvgStyle \{
			st := parent
			st.opacity, st.clip, st.display, st.transform = 1, "", true, ""
			st.stopColor, st.stopOp = uiSvgColor\{0, 0, 0, 1}, 1
			if c, ok := n.decl["color"]; ok && c != "inherit" \{
				if v, ok := uiSvgParseColor(c, parent.color); ok \{
					st.color = v
				}
			}
			for k, v := range n.decl \{
				if v == "inherit" \{
					continue
				}
				switch k \{
				case "fill", "stroke":
					p, ok := uiSvgParsePaint(v, st.color)
					if !ok \{
						continue
					}
					if k == "fill" \{
						st.fill = p
					} else \{
						st.stroke = p
					}
				case "fill-opacity", "stroke-opacity", "opacity", "stop-opacity":
					f := uiSvgUnit(v)
					if math.IsNaN(f) \{
						continue
					}
					f = uiClamp(f, 0, 1)
					switch k \{
					case "fill-opacity":
						st.fillOp = f
					case "stroke-opacity":
						st.strokeOp = f
					case "opacity":
						st.opacity = f
					default:
						st.stopOp = f
					}
				case "fill-rule":
					st.evenOdd = v == "evenodd"
				case "clip-rule":
					st.clipOdd = v == "evenodd"
				case "stroke-width":
					st.width = v
				case "stroke-linecap":
					st.cap = v
				case "stroke-linejoin":
					st.join = v
				case "stroke-miterlimit":
					if f, err := strconv.ParseFloat(v, 64); err == nil && f >= 1 \{
						st.miter = f
					}
				case "stroke-dasharray":
					st.dash = v
				case "stroke-dashoffset":
					st.dashOffset = v
				case "display":
					st.display = v != "none"
				case "visibility":
					st.visible = v == "visible"
				case "stop-color":
					if c, ok := uiSvgParseColor(v, st.color); ok \{
						st.stopColor = c
					}
				case "clip-path":
					st.clip = v
				case "transform":
					st.transform = v
				}
			}
			return st
		}

		func (r *uiSvgRender) viewport() [2]float64 \{ return r.vp[len(r.vp)-1] }

		func (r *uiSvgRender) length(n *uiSvgNode, key string, axis int) float64 \{
			vp := r.viewport()
			of := math.Sqrt((vp[0]*vp[0] + vp[1]*vp[1]) / 2)
			if axis < 2 \{
				of = vp[axis]
			}
			v, _ := uiSvgLength(n.attrs[key], of)
			return v
		}

		func (r *uiSvgRender) lengthOr(n *uiSvgNode, key string, axis int, def string) float64 \{
			if _, ok := n.attrs[key]; !ok \{
				vp := r.viewport()
				of := math.Sqrt((vp[0]*vp[0] + vp[1]*vp[1]) / 2)
				if axis < 2 \{
					of = vp[axis]
				}
				v, _ := uiSvgLength(def, of)
				return v
			}
			return r.length(n, key, axis)
		}

		func (r *uiSvgRender) own(n *uiSvgNode, ctm uiSvgM, st uiSvgStyle) uiSvgM \{
			t := n.attrs["transform"]
			if st.transform != "" \{
				t = st.transform
			}
			if t == "" \{
				return ctm
			}
			return ctm.mul(uiSvgTransform(t))
		}

		func (r *uiSvgRender) children(n *uiSvgNode, ctm uiSvgM, st uiSvgStyle, dst []uint8, depth int) \{
			for _, k := range n.kids \{
				r.node(k, ctm, st, dst, depth+1)
				if n.tag == "switch" \{
					return
				}
			}
		}

		func (r *uiSvgRender) node(n *uiSvgNode, ctm uiSvgM, parent uiSvgStyle, dst []uint8, depth int) \{
			if depth > 64 \{
				return
			}
			switch n.tag \{
			case "g", "a", "switch", "svg", "use", "path", "rect", "circle", "ellipse", "line", "polyline", "polygon":
			default:
				return
			}
			st := r.style(n, parent)
			if !st.display \{
				return
			}
			m := r.own(n, ctm, st)
			target := dst
			var layer []uint8
			clip := r.clipMask(st.clip, n, m)
			if st.opacity <= 0 \{
				return
			}
			// Past a few layers deep an opacity is let go, rather than a frame's worth of memory each.
			if (st.opacity < 1 || clip != nil) && r.deep < 8 \{
				layer = make([]uint8, len(dst))
				target = layer
				r.deep++
				defer func() \{ r.deep-- }()
			}
			switch n.tag \{
			case "g", "a", "switch":
				r.children(n, m, st, target, depth)
			case "svg":
				r.inner(n, n, m, st, target, depth, r.length(n, "x", 0), r.length(n, "y", 1),
					r.lengthOr(n, "width", 0, "100%"), r.lengthOr(n, "height", 1, "100%"))
			case "use":
				r.use(n, m, st, target, depth)
			default:
				r.shape(n, m, st, target)
			}
			if layer != nil \{
				r.merge(dst, layer, st.opacity, clip)
			}
		}

		// A nested viewport: an inner svg, or a symbol a use points at, clipped to itself.
		func (r *uiSvgRender) inner(n, content *uiSvgNode, ctm uiSvgM, st uiSvgStyle, dst []uint8, depth int, x, y, w, h float64) \{
			if w <= 0 || h <= 0 \{
				return
			}
			m := ctm.mul(uiSvgM\{1, 0, 0, 1, x, y})
			size := [2]float64\{w, h}
			if box := uiSvgViewBox(content.attrs["viewBox"]); box != nil \{
				m = ctm.mul(uiSvgFit(box, content.attrs["preserveAspectRatio"], x, y, w, h))
				size = [2]float64\{box[2], box[3]}
			}
			layer := make([]uint8, len(dst))
			r.vp = append(r.vp, size)
			r.children(content, m, st, layer, depth)
			r.vp = r.vp[:len(r.vp)-1]
			if strings.Contains(content.decl["overflow"]+content.attrs["overflow"], "visible") \{
				r.merge(dst, layer, 1, nil)
				return
			}
			mask := r.cover[:0]
			r.fillMask(&mask, [][]float64\{r.box(ctm, x, y, w, h)}, false)
			r.merge(dst, layer, 1, mask)
		}

		func (r *uiSvgRender) box(m uiSvgM, x, y, w, h float64) []float64 \{
			var out []float64
			for _, p := range [4][2]float64\{\{x, y}, \{x + w, y}, \{x + w, y + h}, \{x, y + h}} \{
				a, b := m.apply(p[0], p[1])
				out = append(out, a, b)
			}
			return out
		}

		func (r *uiSvgRender) use(n *uiSvgNode, ctm uiSvgM, st uiSvgStyle, dst []uint8, depth int) \{
			ref := strings.TrimPrefix(strings.TrimSpace(n.attrs["href"]), "#")
			target := r.doc.ids[ref]
			if target == nil || r.using[target] || target == n \{
				return
			}
			for a := n.parent; a != nil; a = a.parent \{
				if a == target \{
					return
				}
			}
			if r.using == nil \{
				r.using = map[*uiSvgNode]bool\{}
			}
			r.using[target] = true
			defer delete(r.using, target)
			x, y := r.length(n, "x", 0), r.length(n, "y", 1)
			switch target.tag \{
			case "symbol", "svg":
				ts := r.style(target, st)
				if !ts.display \{
					return
				}
				w := r.lengthOr(n, "width", 0, "100%")
				h := r.lengthOr(n, "height", 1, "100%")
				if _, ok := n.attrs["width"]; !ok && target.tag == "svg" \{
					w = r.lengthOr(target, "width", 0, "100%")
				}
				if _, ok := n.attrs["height"]; !ok && target.tag == "svg" \{
					h = r.lengthOr(target, "height", 1, "100%")
				}
				r.inner(target, target, ctm, ts, dst, depth+1, x, y, w, h)
			default:
				r.node(target, ctm.mul(uiSvgM\{1, 0, 0, 1, x, y}), st, dst, depth+1)
			}
		}

		// --- Geometry -------------------------------------------------------------------

		type uiSvgSub struct \{
			pts    []float64
			closed bool
		}

		type uiSvgPath struct \{
			subs []uiSvgSub
			tol  float64
		}

		func (p *uiSvgPath) moveTo(x, y float64) \{
			p.subs = append(p.subs, uiSvgSub\{pts: []float64\{x, y}})
		}

		func (p *uiSvgPath) cur() (float64, float64) \{
			s := &p.subs[len(p.subs)-1]
			return s.pts[len(s.pts)-2], s.pts[len(s.pts)-1]
		}

		func (p *uiSvgPath) lineTo(x, y float64) \{
			s := &p.subs[len(p.subs)-1]
			s.pts = append(s.pts, x, y)
		}

		func (p *uiSvgPath) cubicTo(c1x, c1y, c2x, c2y, x, y float64) \{
			x0, y0 := p.cur()
			dd := math.Max(math.Hypot(x0-2*c1x+c2x, y0-2*c1y+c2y), math.Hypot(c1x-2*c2x+x, c1y-2*c2y+y))
			n := int(math.Ceil(math.Sqrt(dd * 0.75 / p.tol)))
			n = min(max(n, 1), 500)
			for i := 1; i <= n; i++ \{
				t := float64(i) / float64(n)
				u := 1 - t
				p.lineTo(u*u*u*x0+3*u*u*t*c1x+3*u*t*t*c2x+t*t*t*x, u*u*u*y0+3*u*u*t*c1y+3*u*t*t*c2y+t*t*t*y)
			}
		}

		func (p *uiSvgPath) close() \{
			s := &p.subs[len(p.subs)-1]
			s.closed = true
		}

		// An elliptical arc as cubics, by the endpoint-to-centre conversion of SVG's notes.
		func (p *uiSvgPath) arcTo(rx, ry, phi float64, large, sweep bool, x, y float64) \{
			x0, y0 := p.cur()
			if x0 == x && y0 == y \{
				return
			}
			rx, ry = math.Abs(rx), math.Abs(ry)
			if rx == 0 || ry == 0 \{
				p.lineTo(x, y)
				return
			}
			phi *= math.Pi / 180
			cs, sn := math.Cos(phi), math.Sin(phi)
			dx, dy := (x0-x)/2, (y0-y)/2
			x1 := cs*dx + sn*dy
			y1 := -sn*dx + cs*dy
			if l := x1*x1/(rx*rx) + y1*y1/(ry*ry); l > 1 \{
				rx, ry = rx*math.Sqrt(l), ry*math.Sqrt(l)
			}
			num := rx*rx*ry*ry - rx*rx*y1*y1 - ry*ry*x1*x1
			den := rx*rx*y1*y1 + ry*ry*x1*x1
			f := math.Sqrt(math.Max(0, num/den))
			if large == sweep \{
				f = -f
			}
			cx1, cy1 := f*rx*y1/ry, -f*ry*x1/rx
			cx := cs*cx1 - sn*cy1 + (x0+x)/2
			cy := sn*cx1 + cs*cy1 + (y0+y)/2
			angle := func(ux, uy, vx, vy float64) float64 \{
				a := math.Atan2(ux*vy-uy*vx, ux*vx+uy*vy)
				return a
			}
			t1 := angle(1, 0, (x1-cx1)/rx, (y1-cy1)/ry)
			dt := angle((x1-cx1)/rx, (y1-cy1)/ry, (-x1-cx1)/rx, (-y1-cy1)/ry)
			if !sweep && dt > 0 \{
				dt -= 2 * math.Pi
			} else if sweep && dt < 0 \{
				dt += 2 * math.Pi
			}
			segs := int(math.Ceil(math.Abs(dt) / (math.Pi / 2)))
			step := dt / float64(max(segs, 1))
			k := 4.0 / 3 * math.Tan(step/4)
			at := func(t float64) (float64, float64, float64, float64) \{
				ex, ey := rx*math.Cos(t), ry*math.Sin(t)
				tx, ty := -rx*math.Sin(t), ry*math.Cos(t)
				return cs*ex - sn*ey + cx, sn*ex + cs*ey + cy, cs*tx - sn*ty, sn*tx + cs*ty
			}
			for i := 0; i < segs; i++ \{
				a, b := t1+float64(i)*step, t1+float64(i+1)*step
				ax, ay, adx, ady := at(a)
				bx, by, bdx, bdy := at(b)
				if i == segs-1 \{
					bx, by = x, y
				}
				p.cubicTo(ax+k*adx, ay+k*ady, bx-k*bdx, by-k*bdy, bx, by)
			}
		}

		type uiSvgScanner struct \{
			s  string
			at int
		}

		func (p *uiSvgScanner) skip() \{
			for p.at < len(p.s) && (p.s[p.at] == ' ' || p.s[p.at] == ',' || p.s[p.at] == '\t' || p.s[p.at] == '\n' || p.s[p.at] == '\r') \{
				p.at++
			}
		}

		func (p *uiSvgScanner) number() (float64, bool) \{
			p.skip()
			start := p.at
			i := p.at
			if i < len(p.s) && (p.s[i] == '+' || p.s[i] == '-') \{
				i++
			}
			digits := false
			for i < len(p.s) && p.s[i] >= '0' && p.s[i] <= '9' \{
				i++
				digits = true
			}
			if i < len(p.s) && p.s[i] == '.' \{
				i++
				for i < len(p.s) && p.s[i] >= '0' && p.s[i] <= '9' \{
					i++
					digits = true
				}
			}
			if !digits \{
				return 0, false
			}
			if i < len(p.s) && (p.s[i] == 'e' || p.s[i] == 'E') \{
				j := i + 1
				if j < len(p.s) && (p.s[j] == '+' || p.s[j] == '-') \{
					j++
				}
				if j < len(p.s) && p.s[j] >= '0' && p.s[j] <= '9' \{
					for j < len(p.s) && p.s[j] >= '0' && p.s[j] <= '9' \{
						j++
					}
					i = j
				}
			}
			v, err := strconv.ParseFloat(p.s[start:i], 64)
			if err != nil || math.IsInf(v, 0) \{
				return 0, false
			}
			p.at = i
			return v, true
		}

		func (p *uiSvgScanner) flag() (bool, bool) \{
			p.skip()
			if p.at < len(p.s) && (p.s[p.at] == '0' || p.s[p.at] == '1') \{
				p.at++
				return p.s[p.at-1] == '1', true
			}
			return false, false
		}

		// The d grammar, drawn up to the first thing it cannot read.
		func uiSvgParsePath(d string, tol float64) *uiSvgPath \{
			p := &uiSvgPath\{tol: tol}
			sc := &uiSvgScanner\{s: d}
			var cmd byte
			var sx, sy, cx, cy, lastX, lastY float64
			var last byte
			for \{
				sc.skip()
				if sc.at >= len(sc.s) \{
					break
				}
				c := sc.s[sc.at]
				if strings.IndexByte("MmLlHhVvCcSsQqTtAaZz", c) >= 0 \{
					cmd = c
					sc.at++
				} else if cmd == 0 \{
					break
				}
				if len(p.subs) == 0 && cmd != 'M' && cmd != 'm' \{
					break
				}
				rel := cmd >= 'a'
				ox, oy := 0.0, 0.0
				if rel \{
					ox, oy = cx, cy
				}
				nums := func(n int) ([]float64, bool) \{
					out := make([]float64, n)
					for i := range out \{
						v, ok := sc.number()
						if !ok \{
							return nil, false
						}
						out[i] = v
					}
					return out, true
				}
				upper := cmd &^ 0x20
				ok := true
				switch upper \{
				case 'Z':
					p.close()
					cx, cy = sx, sy
					cmd = 0
					p.moveTo(cx, cy)
					last = 'Z'
					continue
				case 'M':
					var v []float64
					if v, ok = nums(2); ok \{
						cx, cy = ox+v[0], oy+v[1]
						sx, sy = cx, cy
						p.dropLone()
						p.moveTo(cx, cy)
						if cmd == 'm' \{
							cmd = 'l'
						} else \{
							cmd = 'L'
						}
					}
				case 'L':
					var v []float64
					if v, ok = nums(2); ok \{
						cx, cy = ox+v[0], oy+v[1]
						p.lineTo(cx, cy)
					}
				case 'H':
					var v []float64
					if v, ok = nums(1); ok \{
						cx = ox + v[0]
						p.lineTo(cx, cy)
					}
				case 'V':
					var v []float64
					if v, ok = nums(1); ok \{
						cy = oy + v[0]
						p.lineTo(cx, cy)
					}
				case 'C', 'S':
					n := 6
					if upper == 'S' \{
						n = 4
					}
					var v []float64
					if v, ok = nums(n); ok \{
						c1x, c1y := cx, cy
						if upper == 'S' \{
							if last == 'C' || last == 'S' \{
								c1x, c1y = 2*cx-lastX, 2*cy-lastY
							}
							v = append([]float64\{0, 0}, v...)
						} else \{
							c1x, c1y = ox+v[0], oy+v[1]
						}
						c2x, c2y := ox+v[2], oy+v[3]
						x, y := ox+v[4], oy+v[5]
						p.cubicTo(c1x, c1y, c2x, c2y, x, y)
						lastX, lastY, cx, cy = c2x, c2y, x, y
					}
				case 'Q', 'T':
					n := 4
					if upper == 'T' \{
						n = 2
					}
					var v []float64
					if v, ok = nums(n); ok \{
						qx, qy := cx, cy
						if upper == 'T' \{
							if last == 'Q' || last == 'T' \{
								qx, qy = 2*cx-lastX, 2*cy-lastY
							}
							v = append([]float64\{0, 0}, v...)
						} else \{
							qx, qy = ox+v[0], oy+v[1]
						}
						x, y := ox+v[2], oy+v[3]
						p.cubicTo(cx+2.0/3*(qx-cx), cy+2.0/3*(qy-cy), x+2.0/3*(qx-x), y+2.0/3*(qy-y), x, y)
						lastX, lastY, cx, cy = qx, qy, x, y
					}
				case 'A':
					v, okN := nums(3)
					large, ok1 := sc.flag()
					sweep, ok2 := sc.flag()
					end, ok3 := nums(2)
					ok = okN && ok1 && ok2 && ok3
					if ok \{
						x, y := ox+end[0], oy+end[1]
						p.arcTo(v[0], v[1], v[2], large, sweep, x, y)
						cx, cy = x, y
					}
				}
				if !ok \{
					break
				}
				last = upper
			}
			p.dropLone()
			return p
		}

		// A moveto nothing drew from is no subpath at all.
		func (p *uiSvgPath) dropLone() \{
			if k := len(p.subs) - 1; k >= 0 && len(p.subs[k].pts) == 2 && !p.subs[k].closed \{
				p.subs = p.subs[:k]
			}
		}

		func (r *uiSvgRender) geometry(n *uiSvgNode, tol float64) *uiSvgPath \{
			p := &uiSvgPath\{tol: tol}
			num := func(key string, axis int) float64 \{ return r.length(n, key, axis) }
			switch n.tag \{
			case "path":
				return uiSvgParsePath(n.attrs["d"], tol)
			case "rect":
				x, y, w, h := num("x", 0), num("y", 1), num("width", 0), num("height", 1)
				if w <= 0 || h <= 0 \{
					return p
				}
				_, hasRx := n.attrs["rx"]
				_, hasRy := n.attrs["ry"]
				rx, ry := math.Max(num("rx", 0), 0), math.Max(num("ry", 1), 0)
				if hasRx && !hasRy \{
					ry = rx
				} else if hasRy && !hasRx \{
					rx = ry
				}
				rx, ry = math.Min(rx, w/2), math.Min(ry, h/2)
				if rx == 0 || ry == 0 \{
					p.moveTo(x, y)
					p.lineTo(x+w, y)
					p.lineTo(x+w, y+h)
					p.lineTo(x, y+h)
					p.close()
					return p
				}
				p.moveTo(x+rx, y)
				p.lineTo(x+w-rx, y)
				p.arcTo(rx, ry, 0, false, true, x+w, y+ry)
				p.lineTo(x+w, y+h-ry)
				p.arcTo(rx, ry, 0, false, true, x+w-rx, y+h)
				p.lineTo(x+rx, y+h)
				p.arcTo(rx, ry, 0, false, true, x, y+h-ry)
				p.lineTo(x, y+ry)
				p.arcTo(rx, ry, 0, false, true, x+rx, y)
				p.close()
			case "circle", "ellipse":
				cx, cy := num("cx", 0), num("cy", 1)
				rx, ry := num("r", 2), num("r", 2)
				if n.tag == "ellipse" \{
					rx, ry = num("rx", 0), num("ry", 1)
					_, hasRx := n.attrs["rx"]
					_, hasRy := n.attrs["ry"]
					if !hasRx \{
						rx = ry
					} else if !hasRy \{
						ry = rx
					}
				}
				if rx <= 0 || ry <= 0 \{
					return p
				}
				p.moveTo(cx+rx, cy)
				p.arcTo(rx, ry, 0, false, true, cx, cy+ry)
				p.arcTo(rx, ry, 0, false, true, cx-rx, cy)
				p.arcTo(rx, ry, 0, false, true, cx, cy-ry)
				p.arcTo(rx, ry, 0, false, true, cx+rx, cy)
				p.close()
			case "line":
				p.moveTo(num("x1", 0), num("y1", 1))
				p.lineTo(num("x2", 0), num("y2", 1))
			case "polyline", "polygon":
				v := uiSvgNumbers(n.attrs["points"])
				if len(v) < 2 \{
					return p
				}
				p.moveTo(v[0], v[1])
				for i := 2; i+1 < len(v); i += 2 \{
					p.lineTo(v[i], v[i+1])
				}
				if n.tag == "polygon" \{
					p.close()
				}
			}
			return p
		}

		func (p *uiSvgPath) bounds() (float64, float64, float64, float64, bool) \{
			x0, y0, x1, y1 := math.Inf(1), math.Inf(1), math.Inf(-1), math.Inf(-1)
			for _, s := range p.subs \{
				for i := 0; i+1 < len(s.pts); i += 2 \{
					x0, x1 = math.Min(x0, s.pts[i]), math.Max(x1, s.pts[i])
					y0, y1 = math.Min(y0, s.pts[i+1]), math.Max(y1, s.pts[i+1])
				}
			}
			return x0, y0, x1, y1, x0 <= x1
		}

		func (r *uiSvgRender) shape(n *uiSvgNode, m uiSvgM, st uiSvgStyle, dst []uint8) \{
			if !st.visible \{
				return
			}
			scale := math.Max(m.scale(), 1e-6)
			path := r.geometry(n, 0.2/scale)
			bx0, by0, bx1, by1, ok := path.bounds()
			if !ok \{
				return
			}
			bbox := [4]float64\{bx0, by0, bx1 - bx0, by1 - by0}
			if !st.fill.none && n.tag != "line" \{
				var polys [][]float64
				for _, s := range path.subs \{
					if len(s.pts) >= 6 \{
						polys = append(polys, uiSvgMap(m, s.pts))
					}
				}
				r.paint(dst, polys, st.evenOdd, st.fill, st.fillOp, m, bbox)
			}
			if !st.stroke.none \{
				vp := r.viewport()
				width, _ := uiSvgLength(st.width, math.Sqrt((vp[0]*vp[0]+vp[1]*vp[1])/2))
				if width <= 0 \{
					return
				}
				outline := uiSvgStroke(path, width/2, st, r.dashes(st))
				for i := range outline \{
					outline[i] = uiSvgMap(m, outline[i])
				}
				r.paint(dst, outline, false, st.stroke, st.strokeOp, m, bbox)
			}
		}

		func uiSvgMap(m uiSvgM, pts []float64) []float64 \{
			out := make([]float64, len(pts))
			for i := 0; i+1 < len(pts); i += 2 \{
				out[i], out[i+1] = m.apply(pts[i], pts[i+1])
			}
			return out
		}

		func (r *uiSvgRender) dashes(st uiSvgStyle) []float64 \{
			if st.dash == "none" || st.dash == "" \{
				return nil
			}
			vp := r.viewport()
			of := math.Sqrt((vp[0]*vp[0] + vp[1]*vp[1]) / 2)
			var out []float64
			sum := 0.0
			for _, f := range strings.FieldsFunc(st.dash, func(c rune) bool \{ return c == ',' || c == ' ' }) \{
				v, ok := uiSvgLength(f, of)
				if !ok || v < 0 \{
					return nil
				}
				out = append(out, v)
				sum += v
			}
			if sum <= 0 \{
				return nil
			}
			if len(out)%2 == 1 \{
				out = append(out, out...)
			}
			off, _ := uiSvgLength(st.dashOffset, of)
			return append([]float64\{off}, out...)
		}

		// --- The stroker -----------------------------------------------------------------

		func uiSvgArea(p []float64) float64 \{
			a := 0.0
			n := len(p) / 2
			for i := 0; i < n; i++ \{
				j := (i + 1) % n
				a += p[2*i]*p[2*j+1] - p[2*j]*p[2*i+1]
			}
			return a
		}

		// Every polygon wound one way, so their nonzero sum is their union.
		func uiSvgWound(p []float64) []float64 \{
			if uiSvgArea(p) >= 0 \{
				return p
			}
			n := len(p) / 2
			out := make([]float64, len(p))
			for i := 0; i < n; i++ \{
				out[2*i], out[2*i+1] = p[2*(n-1-i)], p[2*(n-1-i)+1]
			}
			return out
		}

		func uiSvgDisc(x, y, r float64) []float64 \{
			n := min(max(int(math.Ceil(r*2.5)), 12), 128)
			out := make([]float64, 0, 2*n)
			for i := 0; i < n; i++ \{
				t := 2 * math.Pi * float64(i) / float64(n)
				out = append(out, x+r*math.Cos(t), y+r*math.Sin(t))
			}
			return out
		}

		func uiSvgDedupe(pts []float64) []float64 \{
			out := pts[:0:0]
			for i := 0; i+1 < len(pts); i += 2 \{
				if len(out) >= 2 && out[len(out)-2] == pts[i] && out[len(out)-1] == pts[i+1] \{
					continue
				}
				out = append(out, pts[i], pts[i+1])
			}
			return out
		}

		// Dash pieces of a polyline, by arc length; dash holds the offset, then the pattern.
		func uiSvgDash(pts []float64, closed bool, dash []float64) [][]float64 \{
			if closed && len(pts) >= 4 \{
				pts = append(append([]float64(nil), pts...), pts[0], pts[1])
			}
			pattern := dash[1:]
			total := 0.0
			for _, v := range pattern \{
				total += v
			}
			off := math.Mod(dash[0], total)
			if off < 0 \{
				off += total
			}
			idx := 0
			for off >= pattern[idx] \{
				off -= pattern[idx]
				idx = (idx + 1) % len(pattern)
			}
			left := pattern[idx] - off
			on := idx%2 == 0
			var pieces [][]float64
			var cur []float64
			if on \{
				cur = []float64\{pts[0], pts[1]}
			}
			for i := 0; i+3 < len(pts); i += 2 \{
				ax, ay, bx, by := pts[i], pts[i+1], pts[i+2], pts[i+3]
				seg := math.Hypot(bx-ax, by-ay)
				at := 0.0
				for seg-at > left \{
					at += left
					x, y := ax+(bx-ax)*at/seg, ay+(by-ay)*at/seg
					if on \{
						cur = append(cur, x, y)
						pieces = append(pieces, cur)
						cur = nil
					} else \{
						cur = []float64\{x, y}
					}
					on = !on
					idx = (idx + 1) % len(pattern)
					left = pattern[idx]
					if len(pieces) > 100000 \{
						return pieces
					}
				}
				left -= seg - at
				if on \{
					cur = append(cur, bx, by)
				}
			}
			if on && len(cur) >= 2 \{
				pieces = append(pieces, cur)
			}
			return pieces
		}

		func uiSvgStroke(path *uiSvgPath, hw float64, st uiSvgStyle, dash []float64) [][]float64 \{
			var out [][]float64
			add := func(p []float64) \{ out = append(out, uiSvgWound(p)) }
			for _, s := range path.subs \{
				pts := uiSvgDedupe(s.pts)
				closed := s.closed
				if closed && len(pts) >= 4 && pts[0] == pts[len(pts)-2] && pts[1] == pts[len(pts)-1] \{
					pts = pts[:len(pts)-2]
				}
				pieces := [][]float64\{pts}
				if dash != nil && len(pts) >= 4 \{
					pieces = uiSvgDash(pts, closed, dash)
					closed = false
				}
				for _, piece := range pieces \{
					piece = uiSvgDedupe(piece)
					n := len(piece) / 2
					if n == 1 \{
						x, y := piece[0], piece[1]
						switch st.cap \{
						case "round":
							add(uiSvgDisc(x, y, hw))
						case "square":
							add([]float64\{x - hw, y - hw, x + hw, y - hw, x + hw, y + hw, x - hw, y + hw})
						}
						continue
					}
					segs := n - 1
					if closed && n > 2 \{
						segs = n
					}
					dir := func(i int) (float64, float64) \{
						j := (i + 1) % n
						dx, dy := piece[2*j]-piece[2*i], piece[2*j+1]-piece[2*i+1]
						l := math.Hypot(dx, dy)
						return dx / l, dy / l
					}
					for i := 0; i < segs; i++ \{
						j := (i + 1) % n
						dx, dy := dir(i)
						nx, ny := -dy*hw, dx*hw
						ax, ay, bx, by := piece[2*i], piece[2*i+1], piece[2*j], piece[2*j+1]
						add([]float64\{ax + nx, ay + ny, bx + nx, by + ny, bx - nx, by - ny, ax - nx, ay - ny})
					}
					joins := func(i int) \{
						p := (i - 1 + n) % n
						ix, iy := dir(p)
						ox, oy := dir(i)
						vx, vy := piece[2*i], piece[2*i+1]
						cross := ix*oy - iy*ox
						if math.Abs(cross) < 1e-9 && ix*ox+iy*oy > 0 \{
							return
						}
						side := 1.0
						if cross > 0 \{
							side = -1
						}
						ax, ay := vx-iy*hw*side, vy+ix*hw*side
						bx, by := vx-oy*hw*side, vy+ox*hw*side
						switch st.join \{
						case "round":
							add(uiSvgDisc(vx, vy, hw))
						case "bevel":
							add([]float64\{vx, vy, ax, ay, bx, by})
						default:
							cosT := -(ix*ox + iy*oy)
							sinHalf := math.Sqrt(math.Max(0, (1-cosT)/2))
							if sinHalf > 1e-9 && 1/sinHalf <= st.miter \{
								mx, my := (ax+bx)/2-vx, (ay+by)/2-vy
								ml := math.Hypot(mx, my)
								reach := hw / sinHalf
								if ml > 1e-12 \{
									px, py := vx+mx/ml*reach, vy+my/ml*reach
									add([]float64\{vx, vy, ax, ay, px, py, bx, by})
									break
								}
							}
							add([]float64\{vx, vy, ax, ay, bx, by})
						}
					}
					if closed && n > 2 \{
						for i := 0; i < n; i++ \{
							joins(i)
						}
						continue
					}
					for i := 1; i < n-1; i++ \{
						joins(i)
					}
					for _, end := range [2]int\{0, n - 1} \{
						x, y := piece[2*end], piece[2*end+1]
						dx, dy := dir(min(end, n-2))
						if end == 0 \{
							dx, dy = -dx, -dy
						}
						switch st.cap \{
						case "round":
							add(uiSvgDisc(x, y, hw))
						case "square":
							nx, ny := -dy*hw, dx*hw
							fx, fy := x+dx*hw, y+dy*hw
							add([]float64\{x + nx, y + ny, fx + nx, fy + ny, fx - nx, fy - ny, x - nx, y - ny})
						}
					}
				}
			}
			return out
		}

		// --- Painting --------------------------------------------------------------------

		func (r *uiRaster) maskEvenOdd(into []uint8) []uint8 \{
			n := r.w * r.h
			if cap(into) < n \{
				into = make([]uint8, n)
			}
			into = into[:n]
			stride := r.w + 2
			for y := 0; y < r.h; y++ \{
				sum := float32(0)
				row := r.acc[y*stride : y*stride+r.w]
				out := into[y*r.w : (y+1)*r.w]
				for x, v := range row \{
					sum += v
					a := sum
					if a < 0 \{
						a = -a
					}
					a -= 2 * float32(math.Floor(float64(a/2)))
					if a > 1 \{
						a = 2 - a
					}
					out[x] = uint8(a*255 + 0.5)
				}
			}
			return into
		}

		// Coverage over the whole output, into *into.
		func (r *uiSvgRender) fillMask(into *[]uint8, polys [][]float64, evenOdd bool) \{
			r.ras.reset(r.w, r.h)
			for _, p := range polys \{
				r.ras.polygon(p)
			}
			if evenOdd \{
				*into = r.ras.maskEvenOdd(*into)
			} else \{
				*into = r.ras.mask(*into)
			}
		}

		type uiSvgStop struct \{
			at    float64
			color [4]float64
		}

		type uiSvgGradient struct \{
			radial     bool
			x1, y1     float64
			x2, y2     float64
			cx, cy, rr float64
			fx, fy, fr float64
			spread     string
			stops      []uiSvgStop
			inverse    uiSvgM
		}

		// A gradient's own attributes, then those of the ones it names, as far as it has none.
		func (r *uiSvgRender) gradient(ref string, m uiSvgM, bbox [4]float64) (*uiSvgGradient, bool) \{
			n := r.doc.ids[ref]
			if n == nil || n.tag != "linearGradient" && n.tag != "radialGradient" \{
				return nil, false
			}
			attrs := map[string]string\{}
			var stops []*uiSvgNode
			seen := map[*uiSvgNode]bool\{}
			for at := n; at != nil && !seen[at]; \{
				seen[at] = true
				for k, v := range at.attrs \{
					if _, has := attrs[k]; !has \{
						attrs[k] = v
					}
				}
				if stops == nil \{
					for _, k := range at.kids \{
						if k.tag == "stop" \{
							stops = append(stops, k)
						}
					}
					if len(stops) == 0 \{
						stops = nil
					}
				}
				next := r.doc.ids[strings.TrimPrefix(strings.TrimSpace(at.attrs["href"]), "#")]
				if next == nil || next.tag != "linearGradient" && next.tag != "radialGradient" \{
					break
				}
				at = next
			}
			g := &uiSvgGradient\{radial: n.tag == "radialGradient", spread: attrs["spreadMethod"]}
			userSpace := attrs["gradientUnits"] == "userSpaceOnUse"
			vp := r.viewport()
			get := func(key, def string, axis int) float64 \{
				s, ok := attrs[key]
				if !ok \{
					s = def
				}
				if !userSpace \{
					v := uiSvgUnit(s)
					if math.IsNaN(v) \{
						v = uiSvgUnit(def)
					}
					return v
				}
				of := math.Sqrt((vp[0]*vp[0] + vp[1]*vp[1]) / 2)
				if axis < 2 \{
					of = vp[axis]
				}
				v, ok2 := uiSvgLength(s, of)
				if !ok2 \{
					v, _ = uiSvgLength(def, of)
				}
				return v
			}
			if g.radial \{
				g.cx, g.cy, g.rr = get("cx", "50%", 0), get("cy", "50%", 1), get("r", "50%", 2)
				g.fx, g.fy, g.fr = get("fx", attrs["cx"], 0), get("fy", attrs["cy"], 1), get("fr", "0%", 2)
				if _, ok := attrs["fx"]; !ok \{
					g.fx = g.cx
				}
				if _, ok := attrs["fy"]; !ok \{
					g.fy = g.cy
				}
			} else \{
				g.x1, g.y1, g.x2, g.y2 = get("x1", "0%", 0), get("y1", "0%", 1), get("x2", "100%", 0), get("y2", "0%", 1)
			}
			space := m
			if !userSpace \{
				if bbox[2] <= 0 || bbox[3] <= 0 \{
					return nil, false
				}
				space = space.mul(uiSvgM\{bbox[2], 0, 0, bbox[3], bbox[0], bbox[1]})
			}
			if t := attrs["gradientTransform"]; t != "" \{
				space = space.mul(uiSvgTransform(t))
			}
			inv, ok := space.invert()
			if !ok \{
				return nil, false
			}
			g.inverse = inv
			prev := 0.0
			for _, s := range stops \{
				st := r.style(s, uiSvgInitial())
				at := uiSvgUnit(s.attrs["offset"])
				if math.IsNaN(at) \{
					at = 0
				}
				at = math.Max(uiClamp(at, 0, 1), prev)
				prev = at
				c := st.stopColor
				c[3] *= st.stopOp
				g.stops = append(g.stops, uiSvgStop\{at, [4]float64\{c[0], c[1], c[2], c[3]}})
			}
			return g, true
		}

		// Premultiplied, from stops interpolated unpremultiplied as Chrome does.
		func (g *uiSvgGradient) at(x, y float64) [4]float64 \{
			c := g.straight(x, y)
			return [4]float64\{c[0] * c[3], c[1] * c[3], c[2] * c[3], c[3]}
		}

		func (g *uiSvgGradient) straight(x, y float64) [4]float64 \{
			if len(g.stops) == 0 \{
				return [4]float64\{}
			}
			if len(g.stops) == 1 \{
				return g.stops[0].color
			}
			ux, uy := g.inverse.apply(x, y)
			var t float64
			if g.radial \{
				cdx, cdy := g.cx-g.fx, g.cy-g.fy
				pdx, pdy := ux-g.fx, uy-g.fy
				dr := g.rr - g.fr
				a := cdx*cdx + cdy*cdy - dr*dr
				b := pdx*cdx + pdy*cdy + g.fr*dr
				c := pdx*pdx + pdy*pdy - g.fr*g.fr
				if math.Abs(a) < 1e-12 \{
					t = c / (2 * b)
				} else \{
					disc := b*b - a*c
					if disc < 0 \{
						return [4]float64\{}
					}
					t = (b + math.Sqrt(disc)) / a
					if a < 0 \{
						t = (b - math.Sqrt(disc)) / a
					}
				}
			} else \{
				dx, dy := g.x2-g.x1, g.y2-g.y1
				l := dx*dx + dy*dy
				if l == 0 \{
					return g.stops[len(g.stops)-1].color
				}
				t = ((ux-g.x1)*dx + (uy-g.y1)*dy) / l
			}
			switch g.spread \{
			case "reflect":
				t = math.Mod(math.Abs(t), 2)
				if t > 1 \{
					t = 2 - t
				}
			case "repeat":
				t -= math.Floor(t)
			default:
				t = uiClamp(t, 0, 1)
			}
			i := sort.Search(len(g.stops), func(i int) bool \{ return g.stops[i].at >= t })
			switch \{
			case i == 0:
				return g.stops[0].color
			case i == len(g.stops):
				return g.stops[len(g.stops)-1].color
			}
			a, b := g.stops[i-1], g.stops[i]
			f := 0.0
			if b.at > a.at \{
				f = (t - a.at) / (b.at - a.at)
			}
			var out [4]float64
			for k := range out \{
				out[k] = a.color[k] + (b.color[k]-a.color[k])*f
			}
			return out
		}

		// Fills polygons in device pixels with a paint: a colour, or a gradient, or its fallback.
		func (r *uiSvgRender) paint(dst []uint8, polys [][]float64, evenOdd bool, paint uiSvgPaint, opacity float64, m uiSvgM, bbox [4]float64) \{
			if len(polys) == 0 || opacity <= 0 \{
				return
			}
			var g *uiSvgGradient
			solid := paint.color
			if paint.ref != "" \{
				var ok bool
				g, ok = r.gradient(paint.ref, m, bbox)
				if !ok \{
					if paint.back == nil || paint.back.none || paint.back.ref != "" \{
						return
					}
					solid = paint.back.color
				}
			}
			x0, y0, x1, y1 := math.Inf(1), math.Inf(1), math.Inf(-1), math.Inf(-1)
			for _, p := range polys \{
				for i := 0; i+1 < len(p); i += 2 \{
					x0, x1 = math.Min(x0, p[i]), math.Max(x1, p[i])
					y0, y1 = math.Min(y0, p[i+1]), math.Max(y1, p[i+1])
				}
			}
			if math.IsNaN(x0 + y0 + x1 + y1) \{
				return
			}
			ax0, ay0 := max(int(math.Floor(x0)), 0), max(int(math.Floor(y0)), 0)
			ax1, ay1 := min(int(math.Ceil(x1))+1, r.w), min(int(math.Ceil(y1))+1, r.h)
			if ax0 >= ax1 || ay0 >= ay1 \{
				return
			}
			bw, bh := ax1-ax0, ay1-ay0
			r.ras.reset(bw, bh)
			ox, oy := float64(ax0), float64(ay0)
			for _, p := range polys \{
				count := len(p) / 2
				for i := 0; i < count; i++ \{
					j := (i + 1) % count
					r.ras.line(p[2*i]-ox, p[2*i+1]-oy, p[2*j]-ox, p[2*j+1]-oy)
				}
			}
			if evenOdd \{
				r.cover = r.ras.maskEvenOdd(r.cover)
			} else \{
				r.cover = r.ras.mask(r.cover)
			}
			pre := [4]float64\{solid[0] * solid[3], solid[1] * solid[3], solid[2] * solid[3], solid[3]}
			for y := 0; y < bh; y++ \{
				for x := 0; x < bw; x++ \{
					c := r.cover[y*bw+x]
					if c == 0 \{
						continue
					}
					col := pre
					if g != nil \{
						col = g.at(float64(ax0+x)+0.5, float64(ay0+y)+0.5)
					}
					k := float64(c) / 255 * opacity
					d := dst[((ay0+y)*r.w+ax0+x)*4:]
					sa := col[3] * k
					keep := 1 - sa
					for ch := 0; ch < 3; ch++ \{
						d[ch] = uint8(uiClamp(col[ch]*k*255+float64(d[ch])*keep+0.5, 0, 255))
					}
					d[3] = uint8(uiClamp(sa*255+float64(d[3])*keep+0.5, 0, 255))
				}
			}
		}

		// A layer onto what is under it, scaled by an opacity and a coverage mask.
		func (r *uiSvgRender) merge(dst, layer []uint8, opacity float64, mask []uint8) \{
			for i := 0; i < len(dst); i += 4 \{
				if layer[i+3] == 0 && layer[i] == 0 && layer[i+1] == 0 && layer[i+2] == 0 \{
					continue
				}
				k := opacity
				if mask != nil \{
					k *= float64(mask[i/4]) / 255
				}
				if k <= 0 \{
					continue
				}
				keep := 1 - float64(layer[i+3])/255*k
				for ch := 0; ch < 4; ch++ \{
					dst[i+ch] = uint8(uiClamp(float64(layer[i+ch])*k+float64(dst[i+ch])*keep+0.5, 0, 255))
				}
			}
		}

		// The coverage of a clip-path's shapes, in the space of the element it clips.
		func (r *uiSvgRender) clipMask(ref string, n *uiSvgNode, m uiSvgM) []uint8 \{
			ref = strings.TrimSpace(ref)
			if !strings.HasPrefix(ref, "url(") \{
				return nil
			}
			close := strings.IndexByte(ref, ')')
			if close < 0 \{
				return nil
			}
			c := r.doc.ids[strings.TrimPrefix(strings.Trim(strings.TrimSpace(ref[4:close]), "'\""), "#")]
			if c == nil || c.tag != "clipPath" \{
				return nil
			}
			space := m
			if t := c.attrs["transform"]; t != "" \{
				space = space.mul(uiSvgTransform(t))
			}
			if c.attrs["clipPathUnits"] == "objectBoundingBox" \{
				p := r.geometry(n, 0.01)
				x0, y0, x1, y1, ok := p.bounds()
				if !ok || x1 <= x0 || y1 <= y0 \{
					return make([]uint8, r.w*r.h)
				}
				space = space.mul(uiSvgM\{x1 - x0, 0, 0, y1 - y0, x0, y0})
			}
			cst := r.style(c, uiSvgInitial())
			var union []uint8
			var walk func(k *uiSvgNode, sm uiSvgM, st uiSvgStyle, depth int)
			walk = func(k *uiSvgNode, sm uiSvgM, st uiSvgStyle, depth int) \{
				if depth > 16 \{
					return
				}
				ks := r.style(k, st)
				if !ks.display || !ks.visible && k.tag != "use" \{
					return
				}
				km := r.own(k, sm, ks)
				switch k.tag \{
				case "use":
					t := r.doc.ids[strings.TrimPrefix(strings.TrimSpace(k.attrs["href"]), "#")]
					if t != nil && t != k && t.tag != "use" \{
						walk(t, km.mul(uiSvgM\{1, 0, 0, 1, r.length(k, "x", 0), r.length(k, "y", 1)}), ks, depth+1)
					}
				case "path", "rect", "circle", "ellipse", "polyline", "polygon":
					p := r.geometry(k, 0.2/math.Max(km.scale(), 1e-6))
					var polys [][]float64
					for _, s := range p.subs \{
						if len(s.pts) >= 6 \{
							polys = append(polys, uiSvgMap(km, s.pts))
						}
					}
					var one []uint8
					r.fillMask(&one, polys, ks.clipOdd)
					if union == nil \{
						union = one
						return
					}
					for i, v := range one \{
						union[i] = max(union[i], v)
					}
				}
			}
			for _, k := range c.kids \{
				walk(k, space, cst, 0)
			}
			if union == nil \{
				return make([]uint8, r.w*r.h)
			}
			return union
		}
	`
}

