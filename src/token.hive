// Tokens
// ======
// What the lexer produces and the parser consumes. A `Kind` says what a token is
// and carries whatever it holds; a `Token` pairs one with the line and column it
// starts at.
//
// `Kind` is a tagged union rather than a tag and a bag of optional fields, so
// `==` compares two kinds structurally and the parser's
// `expect(p, token.RBrace())` is an ordinary comparison.

// A piece of an interpolated string: literal text, or the source of a
// `{expression}` for the parser to finish.
type StrPart {
    Literal { text: Str }
    // `line` and `col` are where the text starts, or 0 in a string whose indentation was removed.
    Code { source: Str, line: Int, col: Int }
    // `\{name is (regex)}` — a string pattern's hole, with the regex the text it
    // binds has to match. Captured raw: a regex's backslashes and braces are its
    // own rather than the string's.
    Hole { name: Str, regex: Str }
}

type Kind {
    // --- Literals and names -------------------------------------------------
    Ident { name: Str }
    IntLit { intValue: Int }
    FloatLit { floatValue: Float }
    // A `"..."` or backtick string holding no interpolation.
    StrLit { text: Str }
    // A `"..."` string holding at least one `{expression}`.
    StrParts { parts: StrPart[dyn] }
    // `#Name`, without the `#`.
    AtomLit { atom: Str }
    // An import path, captured whole: `.`, `..` and `/` would each otherwise
    // lex as an operator.
    PathLit { path: Str }
    // A `query` body, captured whole: it is SQL, not Hive statements.
    SqlBody { sql: Str }

    // --- Keywords -----------------------------------------------------------
    KwImport
    KwProc
    KwFunc
    KwQuery
    KwTest
    KwLaw
    // Reserved: nothing may be written with it yet.
    KwAxiom
    KwType
    KwIf
    KwElse
    KwReturn
    KwIs
    KwWith
    KwVoid
    KwTrue
    KwFalse
    KwEcho
    KwAssert
    KwPanic
    KwDyn
    KwMut
    KwAsync
    KwAwait
    KwFor
    KwIn
    KwEach
    KwBounds
    KwBreak
    KwContinue
    KwSwitch

    // --- Operators, longest first -------------------------------------------
    Ellipsis
    ColonEq
    Ge
    Le
    EqEq
    NotEq
    StarStar
    AmpAmp
    PipePipe
    PlusPlus
    MinusMinus
    PlusEq
    MinusEq
    StarEq
    SlashEq
    ShlEq
    ShrEq
    AmpEq
    PipeEq
    CaretEq
    Shl
    // Also two `>` closing two lists of type arguments, which the type parser
    // takes one half at a time.
    Shr
    BitsOpen
    // Also three `>` closing three lists of type arguments, as `>>` is two.
    BitsClose
    PipeGt

    // --- Punctuation --------------------------------------------------------
    LBrace
    RBrace
    LParen
    RParen
    LBracket
    RBracket
    Colon
    Semicolon
    Comma
    Dot
    Gt
    Lt
    Assign
    Plus
    Minus
    Star
    Slash
    Percent
    // `||`, `|>` and `|=` are looked for first, so this is a lone `|`: bitwise or.
    Pipe
    Amp
    Caret
    Tilde
    // `!=` is looked for first, so this is a `!` with no `=` behind it: the one
    // place the character stands on its own.
    Bang

    Eof
}

type Token {
    kind: Kind
    line: Int
    col: Int
}

// `line` and `col` count from 1; `file` is spelled the way the loader spells it.
type Pos {
    file: Str
    line: Int
    col: Int
}

func nowhere(): Pos {
    return Pos("", 0, 0)
}

// How a token reads in a message. A literal names what it holds rather than what
// it is: `the number 3` beats `an integer literal`.
func describe(k: Kind): Str {
    switch k {
        Kind.Ident(name) { return "`{name}`" }
        Kind.IntLit(v) { return "the number {v}" }
        Kind.FloatLit(v) { return "the number {v}" }
        Kind.StrLit(_) { return "a string" }
        Kind.StrParts(_) { return "an interpolated string" }
        Kind.AtomLit(atom) { return "`#{atom}`" }
        Kind.PathLit(path) { return "the path `{path}`" }
        Kind.SqlBody(_) { return "a query body" }
        Kind.Eof { return "the end of the file" }
        _ { }
    }
    return "`{spelling(k)}`"
}

// The source text a keyword or operator was written as. A literal has none, so
// this answers `""` and a message should reach for `describe` instead.
func spelling(k: Kind): Str {
    switch k {
        Kind.KwImport { return "import" }
        Kind.KwProc { return "proc" }
        Kind.KwFunc { return "func" }
        Kind.KwQuery { return "query" }
        Kind.KwTest { return "test" }
        Kind.KwLaw { return "law" }
        Kind.KwAxiom { return "axiom" }
        Kind.KwType { return "type" }
        Kind.KwIf { return "if" }
        Kind.KwElse { return "else" }
        Kind.KwReturn { return "return" }
        Kind.KwIs { return "is" }
        Kind.KwWith { return "with" }
        Kind.KwVoid { return "void" }
        Kind.KwTrue { return "true" }
        Kind.KwFalse { return "false" }
        Kind.KwEcho { return "echo" }
        Kind.KwAssert { return "assert" }
        Kind.KwPanic { return "panic" }
        Kind.KwDyn { return "dyn" }
        Kind.KwMut { return "mut" }
        Kind.KwAsync { return "async" }
        Kind.KwAwait { return "await" }
        Kind.KwFor { return "for" }
        Kind.KwIn { return "in" }
        Kind.KwEach { return "each" }
        Kind.KwBounds { return "bounds" }
        Kind.KwBreak { return "break" }
        Kind.KwContinue { return "continue" }
        Kind.KwSwitch { return "switch" }
        _ { }
    }
    return operatorSpelling(k)
}

func operatorSpelling(k: Kind): Str {
    switch k {
        Kind.Ellipsis { return "..." }
        Kind.ColonEq { return ":=" }
        Kind.Ge { return ">=" }
        Kind.Le { return "<=" }
        Kind.EqEq { return "==" }
        Kind.NotEq { return "!=" }
        Kind.StarStar { return "**" }
        Kind.AmpAmp { return "&&" }
        Kind.PipePipe { return "||" }
        Kind.PlusPlus { return "++" }
        Kind.MinusMinus { return "--" }
        Kind.PlusEq { return "+=" }
        Kind.MinusEq { return "-=" }
        Kind.StarEq { return "*=" }
        Kind.SlashEq { return "/=" }
        Kind.ShlEq { return "<<=" }
        Kind.ShrEq { return ">>=" }
        Kind.AmpEq { return "&=" }
        Kind.PipeEq { return "|=" }
        Kind.CaretEq { return "^=" }
        Kind.Shl { return "<<" }
        Kind.Shr { return ">>" }
        Kind.BitsOpen { return "<<<" }
        Kind.BitsClose { return ">>>" }
        Kind.PipeGt { return "|>" }
        Kind.LBrace { return "\{" }
        Kind.RBrace { return "}" }
        Kind.LParen { return "(" }
        Kind.RParen { return ")" }
        Kind.LBracket { return "[" }
        Kind.RBracket { return "]" }
        Kind.Colon { return ":" }
        Kind.Semicolon { return ";" }
        Kind.Comma { return "," }
        Kind.Dot { return "." }
        Kind.Gt { return ">" }
        Kind.Lt { return "<" }
        Kind.Assign { return "=" }
        Kind.Plus { return "+" }
        Kind.Minus { return "-" }
        Kind.Star { return "*" }
        Kind.Slash { return "/" }
        Kind.Percent { return "%" }
        Kind.Pipe { return "|" }
        Kind.Amp { return "&" }
        Kind.Caret { return "^" }
        Kind.Tilde { return "~" }
        Kind.Bang { return "!" }
        _ { }
    }
    return ""
}

// The keyword a word spells, if it spells one.
func keywordOf(word: Str): Result<Kind, Bool> {
    if word == "import" { return Result.Ok(Kind.KwImport()) }
    else if word == "proc" { return Result.Ok(Kind.KwProc()) }
    else if word == "func" { return Result.Ok(Kind.KwFunc()) }
    else if word == "query" { return Result.Ok(Kind.KwQuery()) }
    else if word == "test" { return Result.Ok(Kind.KwTest()) }
    else if word == "law" { return Result.Ok(Kind.KwLaw()) }
    else if word == "axiom" { return Result.Ok(Kind.KwAxiom()) }
    else if word == "type" { return Result.Ok(Kind.KwType()) }
    else if word == "if" { return Result.Ok(Kind.KwIf()) }
    else if word == "else" { return Result.Ok(Kind.KwElse()) }
    else if word == "return" { return Result.Ok(Kind.KwReturn()) }
    else if word == "is" { return Result.Ok(Kind.KwIs()) }
    else if word == "with" { return Result.Ok(Kind.KwWith()) }
    else if word == "void" { return Result.Ok(Kind.KwVoid()) }
    else if word == "true" { return Result.Ok(Kind.KwTrue()) }
    else if word == "false" { return Result.Ok(Kind.KwFalse()) }
    else if word == "echo" { return Result.Ok(Kind.KwEcho()) }
    else if word == "assert" { return Result.Ok(Kind.KwAssert()) }
    else if word == "panic" { return Result.Ok(Kind.KwPanic()) }
    else if word == "dyn" { return Result.Ok(Kind.KwDyn()) }
    else if word == "mut" { return Result.Ok(Kind.KwMut()) }
    else if word == "async" { return Result.Ok(Kind.KwAsync()) }
    else if word == "await" { return Result.Ok(Kind.KwAwait()) }
    else if word == "for" { return Result.Ok(Kind.KwFor()) }
    else if word == "in" { return Result.Ok(Kind.KwIn()) }
    else if word == "each" { return Result.Ok(Kind.KwEach()) }
    else if word == "bounds" { return Result.Ok(Kind.KwBounds()) }
    else if word == "break" { return Result.Ok(Kind.KwBreak()) }
    else if word == "continue" { return Result.Ok(Kind.KwContinue()) }
    else if word == "switch" { return Result.Ok(Kind.KwSwitch()) }
    return Result.Error(false)
}
