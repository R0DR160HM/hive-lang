// Emitter
// =======
// One flattened module to one Go file.
//
// Everything the emitter needs to decide, it decides from a **type**: `+` is
// concatenation on strings and a fresh vector on vectors; `==` is a comparison
// on scalars and a structural one on anything that owns storage; `/` is Go's
// operator on a `Float` and a zero-safe call on an `Int`. So the walk carries an
// `infer.Env` beside the output, and every statement hands back the scope it
// leaves behind.
//
// It also carries the **wanted** type down. A `Result.Ok(v)` cannot say what its
// error half is, an empty vector literal cannot say what it holds, and
// `hive.map.new()` says only that it is empty — each takes its type from where it
// lands, and this is the only pass that knows where that is.
//
// Two things about the Go it writes: every local is followed by a `_ = name`,
// because Hive allows a binding nothing reads and Go does not; and every value
// goes through the generated `hive` runtime package, so the file imports exactly
// one thing however much it does.
import ./ast
import ./diag
import ./infer
import ./paths
import ./regex
import ./runtime
import ./show
import ./stdlib
import ./text
import ./token
import ./types
import ./writes

/// A generated Go file, and what could not be generated.
type Emitted {
	source: Str
	/// Where each of the program's own declarations landed, for coverage.
	spans: Str[dyn]
	/// The atom table, in value order. `#Nil` is always first.
	atoms: Str[dyn]
	/// The standard library modules the program referenced, so the build carries
	/// those and no others.
	modules: Str[dyn]
	/// The types a JSON codec was written for. The tests are emitted into their
	/// own file in the same Go package, so this keeps a codec a test needs from
	/// being written twice — or, where only a test needed it, from being missed.
	codecs: Str[dyn]
	errors: diag.Diagnostic[dyn]
}

type Emit {
	table: types.Table
	out: Str[dyn]
	indent: Int
	atoms: Str[dyn]
	modules: Str[dyn]
	/// The declared types that mirror a struct in an imported Go file, by their
	/// flattened names. A value of one of them is converted rather than passed:
	/// the two structs are the same shape, so the converter is a copy.
	mirrors: Str[dyn]
	/// The package each of those came from, in the same order.
	mirrorPackages: Str[dyn]
	/// The handlers whose envelope escapes its turn, so a request they leave
	/// unanswered is one a reply may still be coming for.
	escapers: Str[dyn]
	/// The `func`s a caller may hand its own storage to rather than a copy of
	/// it — see `lentFuncs` for what earns a name a place on it.
	lent: Str[dyn]
	/// The row types a mapper has been asked for: one per declared type a typed
	/// query reads its rows into.
	rows: Str[dyn]
	/// The declared types a codec has been asked for — only those a program
	/// actually encodes or decodes, so it fills as the walk meets them.
	codecs: Str[dyn]
	/// Counts the temporaries a pattern or a copy needs, so two never collide.
	temp: Int
	/// The names bound to an `async` call. There is no handle type in the
	/// language — a name reads as its result — so the wait is put back wherever
	/// one of these is read.
	deferred: Str[dyn]
	/// The names declared `mut`, which is what decides whether a binding off one
	/// of them has to copy.
	mutables: Str[dyn]
	/// The mutex parameters, which lower to pointers and are read through them.
	pointers: Str[dyn]
	/// A second `mut` name for storage a first one already has: it is given no
	/// variable at all, so that one slice header serves both.
	aliasFrom: Str[dyn]
	aliasTo: Str[dyn]
	/// Whether what is being emitted is a `test` body. An `assert` there has
	/// proved the *test* wrong rather than the program, so it is recorded and the
	/// rest of the suite still runs, however deep inside an `if` it was written.
	inTest: Bool
	/// Whether what is being written is a call about to run on a thread of its
	/// own. Its arguments are copied on this side of the fence (`8.6`), which is
	/// a different job from guarding against a later write — so no argument is
	/// lent while this holds.
	spawning: Bool
	/// Which output line holds the atom table, so it can be written again once
	/// the whole program has been walked. `-1` until `main` is emitted.
	atomLine: Int
	/// Where each of the program's own declarations landed, as
	/// `name<tab>firstLine<tab>lastLine`. Coverage is about the program the
	/// author wrote, and this tells it from the clone helpers and atom table
	/// beside it.
	spans: Str[dyn]
	/// What a deep copy still has to copy: `Type.field` for every field a write
	/// path goes through, and the storage shapes that can leave a call inside its
	/// answer. A field in neither owns storage the program never rewrites, so a
	/// copy shares it — see `writes.hive`.
	written: Str[dyn]
	/// The regexes a string pattern's holes asked for, as the Go to compile. Each
	/// becomes one package-level variable, so a pattern is compiled once at
	/// startup and two that read the same share one.
	patterns: Str[dyn]
	/// The line the declaration being emitted was declared on — the only position
	/// a flattened program can offer.
	line: Int
	errors: diag.Diagnostic[dyn]
}

/// Emit a whole program.
proc emitModule(m: ast.Module): Emitted {
	t := types.tableOf(m)
	mut Emit em = Emit(t, [], 0, ["Nil"], [], [], [], [], [], [], [], 0, [], [], [], [], [], false, false, -1, [], writes.writtenShapes(m), [], 0, [])

	line(em, "package main")
	line(em, "")
	// Each imported Go file is a package of its own inside the generated
	// project, imported under the name that is also its directory — so what a
	// wrapper calls reads as the file it came from.
	if len(m.foreign) == 0 {
		line(em, "import \"hiveapp/hive\"")
	} else {
		line(em, "import (")
		line(em, "\t\"hiveapp/hive\"")
		for each f in m.foreign {
			line(em, "\t" + f.packageName + " \"hiveapp/" + f.packageName + "\"")
		}
		line(em, ")")
	}
	line(em, "")

	env := infer.newEnv(t)
	em.escapers = escapingHandlers(t, m.decls)
	em.lent = lentFuncs(t, m.decls)
	for each f in m.foreign {
		for each name in f.types {
			append(em.mirrors, name)
			append(em.mirrorPackages, f.packageName)
		}
	}
	emitMirrors(em, m)
	emitClones(em, m.decls)
	for each d in m.decls {
		em.line = ast.declLine(d)
		emitDecl(em, env, d)
	}
	// A codec is asked for wherever a program encodes or decodes something,
	// which can be anywhere — so they are written after everything that could
	// ask has been walked. A row mapper is the same story.
	emitRows(em)
	emitCodecs(em)
	emitPatterns(em)
	// The table is only complete now: an atom is numbered when the walk reaches
	// it, and a `proc` below `main` is reached long after main's body was
	// written. So the line written there is written again from here.
	patchAtoms(em)
	if hasMain(m) == false {
		blank(em)
		open(em, "func main() \{")
		line(em, "hive.InitAtoms(" + atomTable(em) + ")")
		close(em, "}")
	}
	return Emitted(join(em.out, "\n") + "\n", em.spans, em.atoms, em.modules, em.codecs, em.errors)
}

func hasMain(m: ast.Module): Bool {
	for each d in m.decls {
		if d is ast.Decl.CallableDecl(_, name, params, _, _, _) {
			if name == "main" && len(params) == 0 {
				return true
			}
		}
	}
	return false
}

// --- Output ------------------------------------------------------------------

proc line(em: mut Emit, written: Str): void {
	if written == "" {
		append(em.out, "")
		return
	}
	append(em.out, text.repeat("\t", em.indent) + written)
}

proc blank(em: mut Emit): void {
	append(em.out, "")
}

proc open(em: mut Emit, written: Str): void {
	line(em, written)
	em.indent = em.indent + 1
}

proc close(em: mut Emit, written: Str): void {
	em.indent = em.indent - 1
	line(em, written)
}

proc fail(em: mut Emit, message: Str): void {
	append(em.errors, diag.at(em.line, message))
}

proc fresh(em: mut Emit, tag: Str): Str {
	em.temp = em.temp + 1
	return "_" + tag + "{em.temp}"
}

// The small integer the compiler assigned an atom, which is its identity. `#Nil`
// is always 0; every other lands wherever its first mention put it.
proc atomValue(em: mut Emit, name: Str): Int {
	if indexOf(em.atoms, name) is Result.Ok(at) {
		return at
	}
	append(em.atoms, name)
	return len(em.atoms) - 1
}

func atomTable(em: Emit): Str {
	mut Str[dyn] out = []
	for each name in em.atoms {
		append(out, "\"" + name + "\"")
	}
	return "[]string\{" + join(out, ", ") + "}"
}

proc useModule(em: mut Emit, module: Str): void {
	if indexOf(em.modules, module) is Result.Error(_) {
		append(em.modules, module)
		// A module's Go may be written against another's, so asking for one asks
		// for what it calls into.
		for each needed in runtime.requires(module) {
			useModule(em, needed)
		}
	}
}

// --- Names -------------------------------------------------------------------

// A Hive identifier that happens to be a Go keyword but not a Hive one is
// suffixed with `_`, consistently at its definition and every use, so it never
// collides with Go's own grammar.
func goIdent(name: Str): Str {
	if isGoKeyword(name) {
		return name + "_"
	}
	return name
}

func isGoKeyword(name: Str): Bool {
	return name == "break" || name == "case" || name == "chan" || name == "const"
		|| name == "continue" || name == "default" || name == "defer"
		|| name == "else" || name == "fallthrough" || name == "for"
		|| name == "func" || name == "go" || name == "goto" || name == "if"
		|| name == "import" || name == "interface" || name == "map"
		|| name == "package" || name == "range" || name == "return"
		|| name == "select" || name == "struct" || name == "switch"
		|| name == "type" || name == "var" || name == "len" || name == "cap"
		|| name == "append" || name == "copy" || name == "delete" || name == "new"
		|| name == "make" || name == "panic" || name == "print" || name == "recover"
		|| name == "string" || name == "int" || name == "bool" || name == "any"
		|| name == "byte" || name == "rune" || name == "error" || name == "nil"
		|| name == "true" || name == "false" || name == "iota"
}

// A field is capitalised on the way out. Hive spells a field in camelCase only,
// so the two never collide, and exporting it is what lets the runtime's JSON and
// equality reach it.
func goField(name: Str): Str {
	return text.capitalise(name)
}

func goVariant(typeName: Str, variantName: Str): Str {
	return goIdent(typeName) + variantName
}

// --- Types -------------------------------------------------------------------

func goType(ty: types.Ty): Str {
	if ty is types.Ty.TStr { return "string" }
	else if ty is types.Ty.TInt { return "int" }
	else if ty is types.Ty.TFloat { return "float64" }
	else if ty is types.Ty.TBool { return "bool" }
	else if ty is types.Ty.TAtom { return "hive.Atom" }
	else if ty is types.Ty.TVoid { return "" }
	else if ty is types.Ty.TVec(element, _) { return "[]" + goType(element) }
	else if ty is types.Ty.TNamed(name) { return goIdent(name) }
	else if ty is types.Ty.TResult(ok, bad) {
		return "hive.Result[" + goType(ok) + ", " + goType(bad) + "]"
	}
	else if ty is types.Ty.TMap(key, value) {
		return "hive.Dict[" + goType(key) + ", " + goType(value) + "]"
	}
	else if ty is types.Ty.TLib(module, name) {
		return "hive." + text.capitalise(module) + name
	}
	else if ty is types.Ty.TFn(_, params, result) {
		mut Str[dyn] out = []
		for each p in params {
			append(out, goType(p))
		}
		mut written := "func(" + join(out, ", ") + ")"
		if result is types.Ty.TVoid {
			return written
		}
		return written + " " + goType(result)
	}
	// A type variable that reached the emitter was not substituted, and an
	// unknown was already reported. Neither should get this far.
	return "any"
}

// The zero value of a type, for a `var` with nothing to initialise it.
func goZero(ty: types.Ty): Str {
	if ty is types.Ty.TStr { return "\"\"" }
	else if ty is types.Ty.TInt { return "0" }
	else if ty is types.Ty.TFloat { return "0.0" }
	else if ty is types.Ty.TBool { return "false" }
	else if ty is types.Ty.TAtom { return "hive.Atom(0)" }
	else if ty is types.Ty.TVec(element, _) { return "[]" + goType(element) + "\{}" }
	return goType(ty) + "\{}"
}

// --- Declarations ------------------------------------------------------------

proc emitDecl(em: mut Emit, env: infer.Env, d: ast.Decl): void {
	if d is ast.Decl.TypeDecl(name, fields, variants, _) {
		emitTypeDecl(em, name, fields, variants)
	} else if d is ast.Decl.CallableDecl(_, name, params, result, body, _) {
		emitCallable(em, env, name, params, result, body)
	} else if d is ast.Decl.QueryDecl(name, params, result, sql, _) {
		emitQuery(em, env, name, params, result, sql)
	} else if d is ast.Decl.ForeignDecl(name, params, result, packageName, symbol, goResults, _) {
		emitForeign(em, name, params, result, packageName, symbol, goResults)
	}
	// A `test` is generated into a file of its own, by `emitTests`.
}

proc emitTypeDecl(em: mut Emit, name: Str, fields: ast.Field[], variants: ast.Variant[]): void {
	blank(em)
	if len(variants) == 0 {
		open(em, "type " + goIdent(name) + " struct \{")
		for each f in fields {
			line(em, goField(f.name) + " " + goType(types.resolve(em.table, f.declared)))
		}
		close(em, "}")
		return
	}
	// A tagged union is an interface plus one struct per variant. The marker
	// method is unexported and named after the type, so nothing outside the
	// generated package can widen into it by accident.
	marker := "is" + goIdent(name)
	open(em, "type " + goIdent(name) + " interface \{")
	line(em, marker + "()")
	close(em, "}")
	for each v in variants {
		blank(em)
		open(em, "type " + goVariant(name, v.name) + " struct \{")
		for each f in v.fields {
			line(em, goField(f.name) + " " + goType(types.resolve(em.table, f.declared)))
		}
		// A field declared outside any variant is added to every one of them.
		for each f in fields {
			line(em, goField(f.name) + " " + goType(types.resolve(em.table, f.declared)))
		}
		close(em, "}")
		line(em, "func (" + goVariant(name, v.name) + ") " + marker + "() \{}")
	}
}

// Everything the emitter tracks about names — mut, pointer, alias, in flight —
// belongs to one body, so each body starts from nothing.
proc enterBody(em: mut Emit): void {
	em.deferred = []
	em.mutables = []
	em.pointers = []
	em.aliasFrom = []
	em.aliasTo = []
}

proc emitCallable(em: mut Emit, env: infer.Env, name: Str, params: ast.Param[], result: ast.TypeExpr, body: ast.Block): void {
	blank(em)
	enterBody(em)
	// Lines are 1-based, and the header has not been written yet.
	firstLine := len(em.out) + 1
	mut resultType := types.resolve(env.table, result)
	inner := infer.boundParams(env, params, 0)
	mut Str[dyn] written = []
	for each p in params {
		ty := types.resolve(env.table, p.declared)
		// A mutex parameter lowers to a pointer: a shared backing array would not
		// survive `append`, which produces a new header the caller has to hold.
		if p.mutex {
			append(em.pointers, p.name)
			append(em.mutables, p.name)
			append(written, goIdent(p.name) + " *" + goType(ty))
		} else {
			append(written, goIdent(p.name) + " " + goType(ty))
		}
	}
	isMain := name == "main" && len(params) == 0

	mut header := "func " + goIdent(name) + "(" + join(written, ", ") + ")"
	if resultType is types.Ty.TVoid {
		open(em, header + " \{")
	} else {
		open(em, header + " " + goType(resultType) + " \{")
	}
	if isMain {
		// Written now and again at the end: an atom the body mentions is not on
		// it yet, so only where the line sits is worth remembering.
		em.atomLine = len(em.out)
		line(em, "hive.InitAtoms(" + atomTable(em) + ")")
	}
	emitStmts(em, inner, body, resultType)
	// Unreachable — Hive proved every path returns; the Go compiler cannot see
	// the proof.
	if resultType is types.Ty.TVoid {
	} else {
		line(em, "panic(\"hive: unreachable\")")
	}
	close(em, "}")
	append(em.spans, name + "\t{firstLine}\t{len(em.out)}")
}

// The atom table is written into `main` before the declarations that mention the
// atoms have been walked, so the placeholder is written again once they have.
//
// By line number, not by searching the output for what it said: a program whose
// own text holds the words searched for would have that text rewritten — which
// is what happened the first time this compiler compiled itself.
proc patchAtoms(em: mut Emit): void {
	at := em.atomLine
	if em.out bounds at {
		em.out[at] = text.repeat("\t", 1) + "hive.InitAtoms(" + atomTable(em) + ")"
	}
}

// --- Copying -----------------------------------------------------------------
//
// Vectors, maps and the declared types holding them are values, but they lower
// to Go slices and maps, which share storage. So a binding whose right-hand side
// *names existing storage* has to copy, unless neither end could ever observe
// the other's writes.
//
// The copy is deep and **type-directed** — chosen by the static type, with no
// runtime reflection. A scalar needs nothing, a flat vector copies its backing
// array, a nested one every level, a declared type its own generated clone.

/// The function that copies a value of `ty`, as a Go expression of one argument.
func cloneFn(t: types.Table, ty: types.Ty): Str {
	if types.ownsStorage(t, ty) == false {
		return "hive.Same[" + goType(ty) + "]"
	}
	if ty is types.Ty.TVec(element, _) {
		if types.ownsStorage(t, element) {
			return "func(_v []" + goType(element) + ") []" + goType(element) + " \{ return hive.CloneVecFn(_v, " + cloneFn(t, element) + ") }"
		}
		return "hive.CloneVec[" + goType(element) + "]"
	}
	if ty is types.Ty.TMap(key, value) {
		return "func(_m " + goType(ty) + ") " + goType(ty) + " \{ return _m.Clone(" + cloneFn(t, value) + ") }"
	}
	if ty is types.Ty.TNamed(name) {
		return cloneName(name)
	}
	return "hive.Same[" + goType(ty) + "]"
}

/// `written`, copied — or `written` itself when the type owns no storage.
func cloned(t: types.Table, ty: types.Ty, written: Str): Str {
	if types.ownsStorage(t, ty) == false {
		return written
	}
	if ty is types.Ty.TVec(element, _) {
		if types.ownsStorage(t, element) {
			return "hive.CloneVecFn(" + written + ", " + cloneFn(t, element) + ")"
		}
		return "hive.CloneVec(" + written + ")"
	}
	if ty is types.Ty.TMap(_, value) {
		return "(" + written + ").Clone(" + cloneFn(t, value) + ")"
	}
	if ty is types.Ty.TNamed(name) {
		return cloneName(name) + "(" + written + ")"
	}
	return written
}

func cloneName(typeName: Str): Str {
	return "clone_" + goIdent(typeName)
}

/// Whether an expression names storage something else can still see. A fresh
/// right-hand side — a literal, a concatenation, a call's result — is already
/// independent, and is never copied.
func namesStorage(e: ast.Expr): Bool {
	if e is ast.Expr.Ident(_) { return true }
	if e is ast.Expr.Member(_, _) { return true }
	if e is ast.Expr.Index(_, _) { return true }
	return false
}

// One `clone_T` per declared type that owns storage. A type that reaches back
// into itself is copied by that very function, which is what makes a recursive
// tree a value like anything else.
proc emitClones(em: mut Emit, decls: ast.Decl[]): void {
	for each d in decls {
		if d is ast.Decl.TypeDecl(name, fields, variants, _) {
			if types.ownsStorage(em.table, types.Ty.TNamed(name)) {
				emitClone(em, name, fields, variants)
			}
		}
	}
}

proc emitClone(em: mut Emit, name: Str, fields: ast.Field[], variants: ast.Variant[]): void {
	blank(em)
	open(em, "func " + cloneName(name) + "(v " + goIdent(name) + ") " + goIdent(name) + " \{")
	if len(variants) == 0 {
		line(em, "out := v")
		for each f in fields {
			cloneField(em, name, f, "v.")
		}
		line(em, "return out")
		close(em, "}")
		return
	}
	for each variant in variants {
		open(em, "if inner, ok := v.(" + goVariant(name, variant.name) + "); ok \{")
		line(em, "out := inner")
		for each f in variant.fields {
			cloneField(em, name, f, "inner.")
		}
		for each f in fields {
			cloneField(em, name, f, "inner.")
		}
		line(em, "return out")
		close(em, "}")
	}
	line(em, "return v")
	close(em, "}")
}

// One field of a copy. A field that owns storage is copied — unless nothing in
// the program can write through it, in which case `out` already holds the same
// header `v` does and sharing is indistinguishable from copying.
//
// The saving is the difference between a copy that costs what the value *is* and
// one that costs what the program can *do* to it: a racing game's four-hundred-
// node circuit sits in the same record as the cars that move every frame.
proc cloneField(em: mut Emit, owner: Str, f: ast.Field, from: Str): void {
	ty := types.resolve(em.table, f.declared)
	if types.ownsStorage(em.table, ty) == false {
		return
	}
	if writes.mustCopy(em.table, em.written, owner, f.name, ty) == false {
		return
	}
	line(em, "out." + goField(f.name) + " = " + cloned(em.table, ty, from + goField(f.name)))
}

// --- Statements --------------------------------------------------------------

proc emitStmts(em: mut Emit, env: infer.Env, body: ast.Block, result: types.Ty): infer.Env {
	return emitEach(em, env, body.stmts, 0, result)
}

// Each statement written with the bindings of everything before it in scope.
// Recursion rather than a `mut infer.Env` threaded through a loop: an `Env`
// carries the whole table, and a `mut` binding off an immutable one is copied at
// every use to keep 8.3's invariant.
proc emitEach(em: mut Emit, env: infer.Env, stmts: ast.Stmt[], at: Int, result: types.Ty): infer.Env {
	if stmts bounds at {
		return emitEach(em, emitStmt(em, env, stmts[at], result), stmts, at + 1, result)
	}
	return env
}

proc emitStmt(em: mut Emit, env: infer.Env, s: ast.Stmt, result: types.Ty): infer.Env {
	if s is ast.Stmt.VarDecl(name, value, mutable, deferred) {
		ty := infer.typeOf(env, value)
		// `x := async f(a)` starts the call now; the wait happens wherever `x` is
		// read, and only if the call has not finished — which is why the name is
		// bound to the work rather than to a value.
		if deferred {
			// A named send goes out now: the wait moves to the name, not the
			// sending, so only the answer waits for where the name is read.
			if isSend(env, value) {
				pending := "_pending_" + goIdent(name)
				if value is ast.Expr.Call(address, sent) {
					line(em, pending + " := " + pendingSend(em, env, address, sent))
				}
				line(em, taskName(name) + " := hive.Spawn(func() any \{ return hive.SyslinkAwait(" + pending + ", 0) })")
				append(em.deferred, name)
				return infer.bound(env, name, ty)
			}
			work := onThread(em, env, value, ty)
			line(em, taskName(name) + " := hive.Spawn(func() any \{ return " + work + " })")
			append(em.deferred, name)
			return infer.bound(env, name, ty)
		}
		// Written with the type rather than `:=`: the two do not always agree.
		// `s := Shape.Circle(9)` binds a `Shape` in Hive but the variant's own
		// struct in Go, and a later `is` would assert on a non-interface.
		written := bindingValue(em, env, value, ty, mutable)
		if mutable {
			append(em.mutables, name)
		}
		if written == "" {
			// Two `mut` bindings share completely, so the second is not given a
			// variable at all: it compiles to the first, and there is one slice
			// header for both.
			rememberAlias(em, name, value)
			return infer.bound(env, name, ty)
		}
		if ty is types.Ty.TUnknown {
			line(em, goIdent(name) + " := " + written)
		} else {
			line(em, "var " + goIdent(name) + " " + goType(ty) + " = " + written)
		}
		line(em, "_ = " + goIdent(name))
		return infer.bound(env, name, ty)
	} else if s is ast.Stmt.TypedDecl(declared, name, value, mutable, _) {
		ty := types.resolve(env.table, declared)
		written := bindingValue(em, env, value, ty, mutable)
		if mutable {
			append(em.mutables, name)
		}
		if written == "" {
			rememberAlias(em, name, value)
			return infer.bound(env, name, ty)
		}
		line(em, "var " + goIdent(name) + " " + goType(ty) + " = " + written)
		line(em, "_ = " + goIdent(name))
		return infer.bound(env, name, ty)
	} else if s is ast.Stmt.Assign(target, value) {
		emitAssign(em, env, target, value)
		return env
	} else if s is ast.Stmt.IfChain(branches, otherwise, hasElse) {
		emitIf(em, env, branches, otherwise, hasElse, result)
		return env
	} else if s is ast.Stmt.ReturnStmt(value) {
		if value is ast.Expr.Absent {
			line(em, "return")
		} else {
			line(em, "return " + expr(em, env, value, result))
		}
		return env
	} else if s is ast.Stmt.EchoStmt(value) {
		line(em, "hive.Echo(" + expr(em, env, value, types.Ty.TUnknown()) + ")")
		return env
	} else if s is ast.Stmt.AssertStmt(condition) {
		if em.inTest {
			emitTestAssert(em, env, condition)
		} else {
			line(em, "hive.Assert(" + expr(em, env, condition, types.Ty.TBool()) + ")")
		}
		return env
	} else if s is ast.Stmt.PanicStmt(value) {
		line(em, "panic(hive.Show(" + expr(em, env, value, types.Ty.TUnknown()) + "))")
		return env
	} else if s is ast.Stmt.BreakStmt {
		line(em, "break")
		return env
	} else if s is ast.Stmt.ContinueStmt {
		line(em, "continue")
		return env
	}
	return emitStmtTail(em, env, s, result)
}

proc emitStmtTail(em: mut Emit, env: infer.Env, s: ast.Stmt, result: types.Ty): infer.Env {
	if s is ast.Stmt.ForLoop(init, cond, post, body) {
		emitFor(em, env, init, cond, post, body, result)
		return env
	} else if s is ast.Stmt.ForEach(name, declared, subject, body) {
		emitForEach(em, env, name, declared, subject, body, result)
		return env
	} else if s is ast.Stmt.AsyncStmt(call) {
		// A send nothing waits for is a cast: it never blocks and never fails,
		// which is what keeps a local send and a remote one the same statement.
		if isSend(env, call) {
			line(em, sendOnly(em, env, call))
			return env
		}
		line(em, "go " + expr(em, env, call, types.Ty.TUnknown()))
		return env
	} else if s is ast.Stmt.Expression(value) {
		emitExprStmt(em, env, value)
		return env
	}
	return env
}

// A call standing on its own. Two builtins are special here: `append` writes the
// new header back, and a discarded `sort` on a `mut` vector reorders in place.
proc emitExprStmt(em: mut Emit, env: infer.Env, value: ast.Expr): void {
	// Over `void` calls the barrier has no value either, and is a statement
	// meaning "both of these, then carry on".
	if value is ast.Expr.AwaitAll(calls, _) {
		mut Str[dyn] spawned = []
		for each c in calls {
			spawned = withSpawn(em, env, spawned, c)
		}
		line(em, "hive.AwaitAllVoid([]*hive.Task\{" + join(spawned, ", ") + "})")
		return
	}
	if value is ast.Expr.Call(callee, args) {
		if callee is ast.Expr.Ident(name) {
			if builtinStatement(em, env, name, args) {
				return
			}
		}
		if callee is ast.Expr.Member(head, name) {
			if head is ast.Expr.Ident(hiveName) {
				if hiveName == "hive" && builtinStatement(em, env, name, args) {
					return
				}
			}
		}
	}
	line(em, expr(em, env, value, types.Ty.TUnknown()))
}

proc builtinStatement(em: mut Emit, env: infer.Env, name: Str, args: ast.Arg[]): Bool {
	if infer.isBuiltin(name) == false || infer.isBound(env, name) {
		return false
	}
	if name == "append" && len(args) == 2 {
		target := argExpr(args, 0)
		line(em, expr(em, env, target, types.Ty.TUnknown()) + " = append(" + expr(em, env, target, types.Ty.TUnknown()) + ", " + expr(em, env, argExpr(args, 1), types.elementOf(infer.typeOf(env, target))) + ")")
		return true
	}
	if name == "prepend" && len(args) == 2 {
		target := argExpr(args, 0)
		line(em, "hive.Prepend(&" + expr(em, env, target, types.Ty.TUnknown()) + ", " + expr(em, env, argExpr(args, 1), types.elementOf(infer.typeOf(env, target))) + ")")
		return true
	}
	if name == "drop" && len(args) == 3 {
		target := argExpr(args, 0)
		line(em, "hive.Drop(&" + expr(em, env, target, types.Ty.TUnknown()) + ", " + expr(em, env, argExpr(args, 1), types.Ty.TInt()) + ", " + expr(em, env, argExpr(args, 2), types.Ty.TInt()) + ")")
		return true
	}
	// A `sort` whose value is discarded on a `mut` vector sorts in place, with no
	// copy at either end.
	if name == "sort" && len(args) >= 1 {
		target := argExpr(args, 0)
		if len(args) == 2 {
			line(em, "hive.SortInPlaceBy(" + expr(em, env, target, types.Ty.TUnknown()) + ", " + expr(em, env, argExpr(args, 1), types.Ty.TUnknown()) + ")")
		} else {
			line(em, "hive.SortInPlace(" + expr(em, env, target, types.Ty.TUnknown()) + ")")
		}
		return true
	}
	return false
}

func argExpr(args: ast.Arg[], index: Int): ast.Expr {
	if args bounds index {
		return args[index].value
	}
	return ast.Expr.Absent()
}

proc emitAssign(em: mut Emit, env: infer.Env, target: ast.Expr, value: ast.Expr): void {
	ty := infer.typeOf(env, target)
	line(em, expr(em, env, target, types.Ty.TUnknown()) + " = " + expr(em, env, value, ty))
}

proc emitFor(em: mut Emit, env: infer.Env, init: ast.Stmt, cond: ast.Expr, post: ast.Stmt, body: ast.Block, result: types.Ty): void {
	// The counter is scoped to the loop, so its binding gets a scope of its own,
	// written in Go's own `for` clause.
	if init is ast.Stmt.Nothing {
		emitForRest(em, env, "for ; ", cond, post, body, result)
		return
	}
	inner := bindOnly(em, env, init)
	emitForRest(em, inner, "for " + clause(em, inner, init) + "; ", cond, post, body, result)
}

// The rest of a `for`, with the counter already in scope. Split out so its scope
// is an immutable binding rather than a `mut infer.Env`, which would be copied —
// table and all — at every use.
proc emitForRest(em: mut Emit, env: infer.Env, opening: Str, cond: ast.Expr, post: ast.Stmt, body: ast.Block, result: types.Ty): void {
	mut header := opening
	if cond is ast.Expr.Absent {
		header = header + "; "
	} else {
		header = header + expr(em, env, cond, types.Ty.TBool()) + "; "
	}
	if post is ast.Stmt.Nothing {
		open(em, header + "\{")
	} else {
		open(em, header + clause(em, env, post) + " \{")
	}
	emitStmts(em, env, body, result)
	close(em, "}")
}

// A loop clause written inline rather than as a line of its own.
proc clause(em: mut Emit, env: infer.Env, s: ast.Stmt): Str {
	if s is ast.Stmt.VarDecl(name, value, _, _) {
		return goIdent(name) + " := " + expr(em, env, value, infer.typeOf(env, value))
	}
	if s is ast.Stmt.TypedDecl(declared, name, value, _, _) {
		ty := types.resolve(env.table, declared)
		return "var " + goIdent(name) + " " + goType(ty) + " = " + expr(em, env, value, ty)
	}
	if s is ast.Stmt.Assign(target, value) {
		return expr(em, env, target, types.Ty.TUnknown()) + " = " + expr(em, env, value, infer.typeOf(env, target))
	}
	if s is ast.Stmt.Expression(value) {
		return expr(em, env, value, types.Ty.TUnknown())
	}
	return ""
}

func bindOnly(em: Emit, env: infer.Env, s: ast.Stmt): infer.Env {
	if s is ast.Stmt.VarDecl(name, value, _, _) {
		return infer.bound(env, name, infer.typeOf(env, value))
	}
	if s is ast.Stmt.TypedDecl(declared, name, _, _, _) {
		return infer.bound(env, name, types.resolve(env.table, declared))
	}
	return env
}

proc emitForEach(em: mut Emit, env: infer.Env, name: Str, declared: ast.TypeExpr, subject: ast.Expr, body: ast.Block, result: types.Ty): void {
	mut elementType := types.elementOf(infer.typeOf(env, subject))
	if declared is ast.TypeExpr.VoidType {
	} else {
		elementType = types.resolve(env.table, declared)
	}
	mut inner := infer.bound(env, name, elementType)
	open(em, "for _, " + goIdent(name) + " := range " + expr(em, env, subject, types.Ty.TUnknown()) + " \{")
	line(em, "_ = " + goIdent(name))
	emitStmts(em, inner, body, result)
	close(em, "}")
}

// --- `if`, and the patterns in it --------------------------------------------

proc emitIf(em: mut Emit, env: infer.Env, branches: ast.Branch[], otherwise: ast.Block, hasElse: Bool, result: types.Ty): void {
	if chainBinds(branches) == false {
		emitPlainIf(em, env, branches, otherwise, hasElse, result)
		return
	}
	// A pattern binds names, and Go has no expression that both tests and binds.
	// So the chain becomes a flag and a run of `if`s: one `if` per conjunct per
	// branch, the flag keeping later branches from running once one has.
	flag := fresh(em, "m")
	open(em, "\{")
	line(em, flag + " := false")
	mut first := true
	for each b in branches {
		if first {
			emitBranch(em, env, b, flag, result)
			first = false
		} else {
			open(em, "if !" + flag + " \{")
			emitBranch(em, env, b, flag, result)
			close(em, "}")
		}
	}
	if hasElse {
		open(em, "if !" + flag + " \{")
		emitStmts(em, env, otherwise, result)
		close(em, "}")
	}
	line(em, "_ = " + flag)
	close(em, "}")
}

proc emitPlainIf(em: mut Emit, env: infer.Env, branches: ast.Branch[], otherwise: ast.Block, hasElse: Bool, result: types.Ty): void {
	mut opened := 0
	mut first := true
	for each b in branches {
		if first {
			open(em, "if " + expr(em, env, b.condition, types.Ty.TBool()) + " \{")
			first = false
		} else {
			close(em, "} else if " + expr(em, env, b.condition, types.Ty.TBool()) + " \{")
			em.indent = em.indent + 1
		}
		emitStmts(em, env, b.body, result)
		opened = opened + 1
	}
	if hasElse {
		close(em, "} else \{")
		em.indent = em.indent + 1
		emitStmts(em, env, otherwise, result)
	}
	close(em, "}")
}

proc emitBranch(em: mut Emit, env: infer.Env, b: ast.Branch, flag: Str, result: types.Ty): void {
	emitGuards(em, env, conjuncts(b.condition), 0, b.body, flag, result)
}

// One `if` per conjunct, innermost first, with the body and the flag at the
// bottom. Each `is` opens a scope holding what it bound.
proc emitGuards(em: mut Emit, env: infer.Env, parts: ast.Expr[], index: Int, body: ast.Block, flag: Str, result: types.Ty): void {
	if index >= len(parts) {
		line(em, flag + " = true")
		emitStmts(em, env, body, result)
		return
	}
	mut ast.Expr part = ast.Expr.Absent()
	if parts bounds index {
		part = parts[index]
	}
	if part is ast.Expr.IsMatch(subject, pattern) {
		mut inner := emitPatternGuard(em, env, subject, pattern)
		emitGuards(em, inner, parts, index + 1, body, flag, result)
		close(em, "}")
		return
	}
	open(em, "if " + expr(em, env, part, types.Ty.TBool()) + " \{")
	emitGuards(em, env, parts, index + 1, body, flag, result)
	close(em, "}")
}

// The `&&`-separated tests of a condition, left to right. Only `&&` splits one:
// a binding made on one side of `||` would not exist on the other.
func conjuncts(e: ast.Expr): ast.Expr[dyn] {
	if e is ast.Expr.Binary(op, left, right) {
		if op is ast.BinOp.And {
			mut ast.Expr[dyn] out = []
			for each part in conjuncts(left) {
				append(out, part)
			}
			for each part in conjuncts(right) {
				append(out, part)
			}
			return out
		}
	}
	return [e]
}

func chainBinds(branches: ast.Branch[]): Bool {
	for each b in branches {
		for each part in conjuncts(b.condition) {
			if part is ast.Expr.IsMatch(_, _) {
				return true
			}
		}
	}
	return false
}

/// Open an `if` that tests `pattern` against `subject` and binds what it
/// matched. The caller closes it.
proc emitPatternGuard(em: mut Emit, env: infer.Env, subject: ast.Expr, pattern: ast.Pattern): infer.Env {
	subjectType := infer.typeOf(env, subject)
	mut written := expr(em, env, subject, types.Ty.TUnknown())
	holder := fresh(em, "t")

	if pattern is ast.Pattern.Constructor(path, bindings, _) {
		return constructorGuard(em, env, written, holder, subjectType, path, bindings)
	}
	if pattern is ast.Pattern.VectorPat(elements, rest) {
		return vectorGuard(em, env, written, holder, subjectType, elements, rest)
	}
	if pattern is ast.Pattern.StrTemplate(parts) {
		return templateGuard(em, env, written, holder, parts)
	}
	open(em, "if false \{")
	return env
}

proc constructorGuard(em: mut Emit, env: infer.Env, written: Str, holder: Str, subjectType: types.Ty, path: Str[], bindings: Str[], ): infer.Env {
	head := segment(path, 0)
	variant := segment(path, 1)
	if head == "Result" {
		open(em, "if " + holder + " := " + written + "; " + holder + "." + resultTest(variant) + " \{")
		payload := resultPayload(subjectType, variant)
		for each b in bindings {
			bind(em, b, holder + "." + resultReader(variant) + "()")
		}
		return infer.bindOne(env, bindings, payload)
	}
	// A variant is a struct behind the union's interface, so the test is a type
	// assertion and the bindings are its fields — its own first, then the ones
	// the type declared outside any variant.
	mut ok := fresh(em, "ok")
	open(em, "if " + holder + ", " + ok + " := " + written + ".(" + goVariant(head, variant) + "); " + ok + " \{")
	// A variant that carries nothing binds nothing, and Go insists on a local
	// being read.
	line(em, "_ = " + holder)
	if types.findVariant(env.table, head, variant) is Result.Ok(fields) {
		mut i := 0
		for each b in bindings {
			if fields bounds i {
				bind(em, b, holder + "." + goField(fields[i].name))
			}
			i = i + 1
		}
		return boundVariant(env, bindings, fields, 0)
	}
	return env
}

// The variant's bindings in scope, each taking the declared type of the field in
// the same position. A position the variant does not have binds nothing, which
// is what the guard above emits too.
func boundVariant(env: infer.Env, bindings: Str[], fields: ast.Field[], at: Int): infer.Env {
	if bindings bounds at {
		if fields bounds at {
			return boundVariant(infer.bound(env, bindings[at], types.resolve(env.table, fields[at].declared)), bindings, fields, at + 1)
		}
		return boundVariant(env, bindings, fields, at + 1)
	}
	return env
}

func resultTest(variant: Str): Str {
	if variant == "Ok" {
		return "IsOk()"
	}
	return "IsError()"
}

func resultReader(variant: Str): Str {
	if variant == "Ok" {
		return "Ok"
	}
	return "Err"
}

func resultPayload(subjectType: types.Ty, variant: Str): types.Ty {
	if subjectType is types.Ty.TResult(ok, bad) {
		if variant == "Ok" {
			return ok
		}
		return bad
	}
	return types.Ty.TUnknown()
}

proc vectorGuard(em: mut Emit, env: infer.Env, written: Str, holder: Str, subjectType: types.Ty, elements: ast.VecElem[], rest: Str): infer.Env {
	mut element := types.elementOf(subjectType)
	mut Str[dyn] tests = []
	// A trailing `...rest` relaxes the length from an exact count to a lower
	// bound; without one the pattern matches only a vector of exactly that many.
	if rest == "" {
		append(tests, "len(" + holder + ") == {len(elements)}")
	} else {
		append(tests, "len(" + holder + ") >= {len(elements)}")
	}
	mut i := 0
	for each item in elements {
		if item is ast.VecElem.Match(value) {
			append(tests, equality(em, env, holder + "[{i}]", expr(em, env, value, element), element))
		}
		i = i + 1
	}
	open(em, "if " + holder + " := " + written + "; " + join(tests, " && ") + " \{")

	mut j := 0
	for each item in elements {
		if item is ast.VecElem.Bind(name) {
			bind(em, name, holder + "[{j}]")
		}
		j = j + 1
	}
	inner := infer.boundElements(env, elements, element, 0)
	if rest != "" {
		bind(em, rest, holder + "[{len(elements)}:]")
		return infer.bound(inner, rest, types.Ty.TVec(element, ast.Dim.Dynamic()))
	}
	return inner
}

// A string pattern is a template of literal text and binding holes, matched
// non-greedily by the runtime. The parts travel as two vectors: which piece is a
// literal, and what it says.
proc templateGuard(em: mut Emit, env: infer.Env, written: Str, holder: Str, parts: token.StrPart[]): infer.Env {
	mut ok := fresh(em, "ok")
	open(em, "if " + holder + ", " + ok + " := " + templateMatch(em, written, parts) + "; " + ok + " \{")
	line(em, "_ = " + holder)
	mut i := 0
	holes := holeNames(parts)
	for each hole in holes {
		bind(em, hole, holder + "[{i}]")
		i = i + 1
	}
	return infer.bindOne(env, holes, types.Ty.TStr())
}

/// The call that matches `written` against the template, and hands back what its
/// holes bound.
///
/// **Every** template is one compiled expression, whichever kind of hole it
/// holds — one matcher, so what a template means never depends on which sort of
/// hole is in it.
proc templateMatch(em: mut Emit, written: Str, parts: token.StrPart[]): Str {
	useModule(em, "regex")
	return "hive.MatchPattern(" + written + ", " + patternVar(em, wholePattern(parts)) + ")"
}

/// Every hole's name, in the order the template writes them — which is the order
/// the matcher answers in.
func holeNames(parts: token.StrPart[]): Str[dyn] {
	mut Str[dyn] out = []
	for each part in parts {
		if part is token.StrPart.Code(source) {
			append(out, text.trim(source))
		} else if part is token.StrPart.Hole(name, _) {
			append(out, name)
		}
	}
	return out
}

/// The whole template as one regex: literal text quoted so it means itself, an
/// open hole as the shortest run of anything, and a hole that says what it takes
/// as what it said. Anchored at both ends, because a template covers the whole
/// string.
///
/// `\{name}` and `\{name is (...)}` differ by exactly one thing: what goes
/// between the parentheses.
///
/// `(?s)` leads it so `.` covers a newline too — text with a line break in it is
/// still text.
func wholePattern(parts: token.StrPart[]): Str {
	mut Str[dyn] out = ["(?s)\\A"]
	for each part in parts {
		if part is token.StrPart.Literal(t) {
			append(out, regex.quoteMeta(t))
		} else if part is token.StrPart.Code(_) {
			append(out, "(.*?)")
		} else if part is token.StrPart.Hole(_, pattern) {
			append(out, "(" + pattern + ")")
		}
	}
	append(out, "\\z")
	return join(out, "")
}

/// The package-level variable holding one compiled pattern, named after where it
/// sits. Two templates that come to the same regex share one.
proc patternVar(em: mut Emit, pattern: Str): Str {
	mut prefix := "hivePattern"
	if em.inTest {
		// The tests are a second file in the same package, so they cannot name
		// their variables the way the program named its own.
		prefix = "hiveTestPattern"
	}
	if indexOf(em.patterns, pattern) is Result.Ok(at) {
		return prefix + "{at}"
	}
	append(em.patterns, pattern)
	return prefix + "{len(em.patterns) - 1}"
}

/// The compiled patterns, written out once the whole program has been walked —
/// which is the first moment they are all known.
proc emitPatterns(em: mut Emit): void {
	if len(em.patterns) == 0 {
		return
	}
	blank(em)
	for each pattern in em.patterns {
		line(em, "var " + patternVar(em, pattern) + " = hive.CompilePattern(" + quoted(pattern) + ")")
	}
}

// A binding Hive made and the body may not read. Go insists a local is used, so
// each is followed by the assignment that says so.
proc bind(em: mut Emit, name: Str, value: Str): void {
	if name == "" || name == "_" {
		return
	}
	line(em, goIdent(name) + " := " + value)
	line(em, "_ = " + goIdent(name))
}

func segment(path: Str[], index: Int): Str {
	if path bounds index {
		return path[index]
	}
	return ""
}

// --- Expressions -------------------------------------------------------------

/// One expression, as Go. `want` is the type the value is landing in, which is
/// the only thing that can settle an empty vector, a `Result` constructor and an
/// empty map.
proc expr(em: mut Emit, env: infer.Env, e: ast.Expr, want: types.Ty): Str {
	if e is ast.Expr.IntLit(v) { return "{v}" }
	else if e is ast.Expr.FloatLit(v) { return floatLiteral(v) }
	else if e is ast.Expr.StrLit(t) { return quoted(t) }
	else if e is ast.Expr.BoolLit(v) { return "{v}" }
	else if e is ast.Expr.AtomLit(name) { return "hive.Atom({atomValue(em, name)})" }
	else if e is ast.Expr.Ident(name) { return identExpr(em, env, name) }
	else if e is ast.Expr.Hole { return "_" }
	else if e is ast.Expr.Absent { return "" }
	else if e is ast.Expr.Negate(operand) {
		return "-(" + expr(em, env, operand, infer.typeOf(env, operand)) + ")"
	}
	else if e is ast.Expr.Interp(parts) { return interpolation(em, env, parts) }
	else if e is ast.Expr.VectorLit(items) { return vectorLiteral(em, env, items, want) }
	else if e is ast.Expr.Binary(op, left, right) { return binary(em, env, op, left, right) }
	else if e is ast.Expr.IsMatch(subject, pattern) { return standaloneMatch(em, env, subject, pattern) }
	return exprTail(em, env, e, want)
}

proc exprTail(em: mut Emit, env: infer.Env, e: ast.Expr, want: types.Ty): Str {
	if e is ast.Expr.Call(callee, args) {
		return call(em, env, callee, args, want)
	} else if e is ast.Expr.Member(subject, field) {
		return member(em, env, subject, field)
	} else if e is ast.Expr.Index(subject, index) {
		// A `Str` is addressed by character and Go addresses it by byte, so one
		// position of it is a walk rather than a subscript.
		if infer.typeOf(env, subject) is types.Ty.TStr {
			return "hive.IndexStr(" + expr(em, env, subject, types.Ty.TStr()) + ", " + expr(em, env, index, types.Ty.TInt()) + ")"
		}
		return expr(em, env, subject, types.Ty.TUnknown()) + "[" + expr(em, env, index, types.Ty.TInt()) + "]"
	} else if e is ast.Expr.Slice(subject, low, high) {
		return slice(em, env, subject, low, high)
	} else if e is ast.Expr.Timed(call, ms) {
		// A bounded send is the same send with the patience written down.
		if isSend(env, call) {
			return sendAndWait(em, env, call, expr(em, env, ms, types.Ty.TInt()))
		}
		// The type argument is written out: Go cannot read it off a Task, whose
		// value is an `any` by the time it is waited for.
		return "hive.AwaitTimeout[" + goType(infer.typeOf(env, call)) + "](" + spawned(em, env, call) + ", " + expr(em, env, ms, types.Ty.TInt()) + ")"
	} else if e is ast.Expr.AwaitAll(calls, timeout) {
		// A barrier over sends is syslink's own: every request goes out, one
		// deadline across all of them, each answer on its own connection's
		// reader — so nothing is spawned.
		if allSends(em, env, calls) {
			return awaitAllSends(em, env, calls, timeout)
		}
		// Asked of the inferrer rather than read off `want`: with a deadline the
		// answer is a `Result` around the vector, two wrappers deep.
		return awaitAll(em, env, calls, timeout, infer.typeOf(env, e))
	} else if e is ast.Expr.WithType(value, target) {
		return withType(em, env, value, target, want)
	} else if e is ast.Expr.UsingExpr(source, form) {
		return reading(em, env, source, form)
	}
	fail(em, "this expression has no lowering yet")
	return "nil"
}

func floatLiteral(v: Float): Str {
	mut written := "{v}"
	if text.contains(written, ".") || text.contains(written, "e") {
		return written
	}
	// Go would read `1` as an untyped integer constant where a float is wanted.
	return written + ".0"
}

func quoted(t: Str): Str {
	mut out := text.replace(t, "\\", "\\\\")
	out = text.replace(out, "\"", "\\\"")
	out = text.replace(out, "\n", "\\n")
	out = text.replace(out, "\t", "\\t")
	out = text.replace(out, "\r", "\\r")
	return "\"" + out + "\""
}

func boolLiteral(yes: Bool): Str {
	if yes {
		return "true"
	}
	return "false"
}

func taskName(name: Str): Str {
	return "_task_" + name
}

proc identExpr(em: mut Emit, env: infer.Env, name: Str): Str {
	// Reading a name that stands for work in flight is where the wait goes.
	// Reading it again is free and always answers the same value.
	if indexOf(em.deferred, name) is Result.Ok(_) {
		return taskName(name) + ".Await().(" + goType(infer.lookup(env, name)) + ")"
	}
	// A second `mut` name compiles to the first, which is what makes shared
	// mutable state shared — including through `append`, whose new slice header
	// the other name has to end up holding too.
	resolved := resolveAlias(em, name)
	// A mutex parameter is a pointer, and everything in the callee reads and
	// writes through it.
	if indexOf(em.pointers, resolved) is Result.Ok(_) {
		return "(*" + goIdent(resolved) + ")"
	}
	return goIdent(resolved)
}

proc resolveAlias(em: mut Emit, name: Str): Str {
	if indexOf(em.aliasFrom, name) is Result.Ok(at) {
		if em.aliasTo bounds at {
			return em.aliasTo[at]
		}
	}
	return name
}

proc rememberAlias(em: mut Emit, name: Str, value: ast.Expr): void {
	if value is ast.Expr.Ident(source) {
		to := resolveAlias(em, source)
		append(em.aliasFrom, name)
		append(em.aliasTo, to)
	}
}

/// The right-hand side of a binding, copied if it has to be — or `""` when the
/// binding gets no variable at all because it is a second name for storage a
/// first one already has.
///
/// Classified by the mutability of its two ends: two immutable ends alias, since
/// neither can mutate; two `mut` ends alias, since sharing is the intent; a
/// mixed pair copies, since one end could write where the other can see.
proc bindingValue(em: mut Emit, env: infer.Env, value: ast.Expr, ty: types.Ty, mutable: Bool): Str {
	written := expr(em, env, value, ty)
	// A fresh right-hand side is already independent and is never copied.
	if namesStorage(value) == false || types.ownsStorage(env.table, ty) == false {
		return written
	}
	sourceMut := isMutableSource(em, value)
	if mutable && sourceMut {
		// Not covered: a source that does not name the same storage every read.
		// `mut b = a[i]` is a different element each time `i` moves, so it keeps
		// a header of its own.
		if value is ast.Expr.Ident(_) {
			return ""
		}
		return written
	}
	if mutable == false && sourceMut == false {
		return written
	}
	return cloned(env.table, ty, written)
}

proc isMutableSource(em: mut Emit, value: ast.Expr): Bool {
	root := rootOf(value)
	if root == "" {
		return false
	}
	return indexOf(em.mutables, resolveAlias(em, root)) is Result.Ok(_)
}

// The name an expression is a path into, which is the one whose mutability
// decides.
func rootOf(e: ast.Expr): Str {
	if e is ast.Expr.Ident(name) { return name }
	if e is ast.Expr.Member(subject, _) { return rootOf(subject) }
	if e is ast.Expr.Index(subject, _) { return rootOf(subject) }
	return ""
}

proc interpolation(em: mut Emit, env: infer.Env, parts: ast.InterpPart[]): Str {
	mut Str[dyn] out = []
	for each part in parts {
		if part is ast.InterpPart.Literal(t) {
			append(out, quoted(t))
		} else if part is ast.InterpPart.Expression(value) {
			ty := infer.typeOf(env, value)
			mut written := expr(em, env, value, ty)
			if ty is types.Ty.TStr {
				append(out, written)
			} else {
				append(out, "hive.ToStr(" + written + ")")
			}
		}
	}
	if len(out) == 0 {
		return "\"\""
	}
	return join(out, " + ")
}

proc vectorLiteral(em: mut Emit, env: infer.Env, items: ast.Expr[], want: types.Ty): Str {
	mut element := types.elementOf(want)
	if element is types.Ty.TUnknown {
		element = types.elementOf(infer.typeOf(env, ast.Expr.VectorLit(copiedExprs(items))))
	}
	mut Str[dyn] out = []
	for each item in items {
		append(out, expr(em, env, item, element))
	}
	return "[]" + goType(element) + "\{" + join(out, ", ") + "}"
}

func copiedExprs(items: ast.Expr[]): ast.Expr[dyn] {
	mut ast.Expr[dyn] out = []
	for each i in items {
		append(out, i)
	}
	return out
}

proc slice(em: mut Emit, env: infer.Env, subject: ast.Expr, low: ast.Expr, high: ast.Expr): Str {
	mut written := expr(em, env, subject, types.Ty.TUnknown())
	mut lowText := "0"
	if low is ast.Expr.Absent {
	} else {
		lowText = expr(em, env, low, types.Ty.TInt())
	}
	// A `Str`'s bounds count characters, so both ends are found by walking it.
	// The open-ended form is its own call: writing a length out here would
	// evaluate the subject twice.
	if infer.typeOf(env, subject) is types.Ty.TStr {
		if high is ast.Expr.Absent {
			return "hive.SliceStrFrom(" + written + ", " + lowText + ")"
		}
		return "hive.SliceStr(" + written + ", " + lowText + ", " + expr(em, env, high, types.Ty.TInt()) + ")"
	}
	if high is ast.Expr.Absent {
		return written + "[" + lowText + ":]"
	}
	// Hive's high bound is inclusive, and Go's is not.
	return written + "[" + lowText + ":(" + expr(em, env, high, types.Ty.TInt()) + ")+1]"
}

// `<call> with T` is three calls, all meaning the same thing: decode what came
// back with the codec T's declaration derives. The type is written at the call
// because a token and a Str of JSON carry no shape of their own.
proc withType(em: mut Emit, env: infer.Env, value: ast.Expr, target: ast.TypeExpr, want: types.Ty): Str {
	if value is ast.Expr.Call(callee, args) {
		if callee is ast.Expr.Member(subject, name) {
			if subject is ast.Expr.Member(root, module) {
				if root is ast.Expr.Ident(head) && head == "hive" {
					wanted := types.resolve(env.table, target)
					if module == "json" && name == "parse" {
						useModule(em, "json")
						return "hive.JsonParse(" + expr(em, env, argExpr(args, 0), types.Ty.TStr()) + ", " + decoderRef(em, wanted) + ")"
					}
					if module == "crypto" && name == "jwtVerify" {
						useModule(em, "crypto")
						token := expr(em, env, argExpr(args, 0), types.Ty.TStr())
						secret := expr(em, env, argExpr(args, 1), types.Ty.TStr())
						return "hive.CryptoJwtVerify(" + token + ", " + secret + ", " + decoderRef(em, wanted) + ")"
					}
					if module == "crypto" && name == "jwtDecode" {
						useModule(em, "crypto")
						return "hive.CryptoJwtDecode(" + expr(em, env, argExpr(args, 0), types.Ty.TStr()) + ", " + decoderRef(em, wanted) + ")"
					}
				}
			}
		}
	}
	// Anything else `with` is written on is the value itself: the type was there
	// to say what an empty thing holds, and the walk has it already.
	return expr(em, env, value, want)
}

// Each `using` form lowers to the reader it names. The format is written in the
// source rather than sniffed at runtime, which is why a program that only reads
// CSV carries neither archive/zip nor encoding/xml.
proc reading(em: mut Emit, env: infer.Env, source: ast.Expr, form: ast.UsingForm): Str {
	if form is ast.UsingForm.Csv(separator) {
		useModule(em, "csv")
		mut sep := "\",\""
		if separator is ast.Expr.Absent {
		} else {
			sep = expr(em, env, separator, types.Ty.TStr())
		}
		return "hive.ReadCsv(" + expr(em, env, source, types.Ty.TStr()) + ", " + sep + ")"
	}
	if form is ast.UsingForm.Xlsx {
		useModule(em, "sheets")
		return "hive.ReadXlsx(" + expr(em, env, source, types.Ty.TStr()) + ")"
	}
	if form is ast.UsingForm.Ods {
		useModule(em, "sheets")
		return "hive.ReadOds(" + expr(em, env, source, types.Ty.TStr()) + ")"
	}
	// SQL assembled at runtime has a shape nothing can know, so it comes back as
	// a Table, header row and all.
	if form is ast.UsingForm.Raw(sqlText) {
		useModule(em, "sql")
		return "hive.SqlQuery(" + expr(em, env, source, types.Ty.TUnknown()) + ", " + expr(em, env, sqlText, types.Ty.TStr()) + ")"
	}
	if form is ast.UsingForm.RunQuery(call) {
		useModule(em, "sql")
		connection := expr(em, env, source, types.Ty.TUnknown())
		fragment := expr(em, env, call, types.Ty.TUnknown())
		rows := infer.typeOf(env, call)
		// What the query declared its rows to be decides how it runs: no rows is
		// a statement reporting how many it touched, anything else is read row by
		// row through the mapper its type derives.
		if rows is types.Ty.TVoid {
			return "hive.SqlExec(" + connection + ", " + fragment + ")"
		}
		return "hive.SqlRows(" + connection + ", " + fragment + ", " + rowMapper(em, rows) + ")"
	}
	fail(em, "this `using` has no lowering")
	return "nil"
}

proc awaitAll(em: mut Emit, env: infer.Env, calls: ast.Expr[], timeout: ast.Expr, whole: types.Ty): Str {
	// A bounded barrier answers with a `Result` around the vector, so the
	// element is one wrapper further in.
	mut vector := whole
	if whole is types.Ty.TResult(value, _) {
		vector = value
	}
	element := types.elementOf(vector)
	mut Str[dyn] out = []
	for each c in calls {
		out = withSpawn(em, env, out, c)
	}
	tasks := "[]*hive.Task\{" + join(out, ", ") + "}"
	if timeout is ast.Expr.Absent {
		return "hive.AwaitAll[" + goType(element) + "](" + tasks + ")"
	}
	// One deadline across the whole barrier — "both of them within a second",
	// not a second each.
	return "hive.AwaitAllTimeout[" + goType(element) + "](" + tasks + ", " + expr(em, env, timeout, types.Ty.TInt()) + ")"
}

proc withSpawn(em: mut Emit, env: infer.Env, into: Str[], c: ast.Expr): Str[dyn] {
	mut Str[dyn] out = []
	for each item in into {
		append(out, item)
	}
	append(out, spawned(em, env, c))
	return out
}

// The thread a call is put on. A call that answers with nothing has nothing to
// hand back, so it is run for its effect and the thread answers with `nil`.
proc spawned(em: mut Emit, env: infer.Env, c: ast.Expr): Str {
	written := onThread(em, env, c, types.Ty.TUnknown())
	if infer.typeOf(env, c) is types.Ty.TVoid {
		return "hive.Spawn(func() any \{ " + written + "; return nil })"
	}
	return "hive.Spawn(func() any \{ return " + written + " })"
}

// A call written for a thread of its own. Nothing in it is lent: every argument
// is copied on this side of the fence, because the caller runs on regardless.
proc onThread(em: mut Emit, env: infer.Env, c: ast.Expr, ty: types.Ty): Str {
	was := em.spawning
	em.spawning = true
	written := expr(em, env, c, ty)
	em.spawning = was
	return written
}

// An `is` outside an `if` condition has nowhere to put what it binds, so it
// lowers to the test alone.
proc standaloneMatch(em: mut Emit, env: infer.Env, subject: ast.Expr, pattern: ast.Pattern): Str {
	mut written := expr(em, env, subject, types.Ty.TUnknown())
	if pattern is ast.Pattern.Constructor(path, _, _) {
		head := segment(path, 0)
		variant := segment(path, 1)
		if head == "Result" {
			return "(" + written + ")." + resultTest(variant)
		}
		return "func() bool \{ _, ok := (" + written + ").(" + goVariant(head, variant) + "); return ok }()"
	}
	if pattern is ast.Pattern.StrTemplate(parts) {
		return "func() bool \{ _, ok := " + templateMatch(em, written, parts) + "; return ok }()"
	}
	fail(em, "a vector pattern outside an `if` condition binds nothing, so it has no value to give")
	return "false"
}

// --- Operators ---------------------------------------------------------------

proc binary(em: mut Emit, env: infer.Env, op: ast.BinOp, left: ast.Expr, right: ast.Expr): Str {
	leftType := infer.typeOf(env, left)
	rightType := infer.typeOf(env, right)
	// An atom coerces to `Str` beside one, as its decimal value rather than its
	// name — so `"0" + #Nil` is `"00"` and not `"0Nil"`.
	l := coerced(em, env, left, leftType, rightType)
	r := coerced(em, env, right, rightType, leftType)

	if op is ast.BinOp.And {
		// `v bounds i` desugars into this shape, and two in one condition would
		// repeat the `i >= 0` half — which `go vet` reads as a mistake.
		guard := boundsGuard(em, env, left, right)
		if guard != "" {
			return guard
		}
		return "(" + l + " && " + r + ")"
	}
	if op is ast.BinOp.Or { return "(" + l + " || " + r + ")" }
	if op is ast.BinOp.Eq { return equality(em, env, l, r, leftType) }
	if op is ast.BinOp.Neq {
		return "!(" + equality(em, env, l, r, leftType) + ")"
	}
	if op is ast.BinOp.Lt { return "(" + l + " < " + r + ")" }
	if op is ast.BinOp.Gt { return "(" + l + " > " + r + ")" }
	if op is ast.BinOp.Le { return "(" + l + " <= " + r + ")" }
	if op is ast.BinOp.Ge { return "(" + l + " >= " + r + ")" }
	return arithmetic(em, env, op, l, r, leftType)
}

// The Go for `v bounds i`, or `""` when this `&&` is something else. It matches
// the shape the parser desugars `bounds` into — and a hand-written guard of the
// same shape, which means the same thing and deserves the same lowering.
proc boundsGuard(em: mut Emit, env: infer.Env, left: ast.Expr, right: ast.Expr): Str {
	if left is ast.Expr.Binary(leftOp, index, zero) {
		if right is ast.Expr.Binary(rightOp, again, length) {
			if leftOp is ast.BinOp.Ge && rightOp is ast.BinOp.Lt {
				// A variant pattern binds by position; it does not match a
				// literal, so the zero is bound and then compared.
				if zero is ast.Expr.IntLit(zeroValue) {
					if zeroValue == 0 && sameExpr(index, again) {
						if lengthOf(length) is Result.Ok(vector) {
							// A `Str` is guarded by character, the way it is
							// indexed, so it has its own of these.
							if infer.typeOf(env, vector) is types.Ty.TStr {
								return "hive.InRangeStr(" + expr(em, env, index, types.Ty.TInt()) + ", " + expr(em, env, vector, types.Ty.TStr()) + ")"
							}
							return "hive.InRange(" + expr(em, env, index, types.Ty.TInt()) + ", " + expr(em, env, vector, types.Ty.TUnknown()) + ")"
						}
					}
				}
			}
		}
	}
	return ""
}

// The vector a `len(...)` was taken of.
func lengthOf(e: ast.Expr): Result<ast.Expr, Bool> {
	if e is ast.Expr.Call(callee, args) {
		if args bounds 0 {
			if callee is ast.Expr.Member(head, name) {
				if head is ast.Expr.Ident(hiveName) {
					if hiveName == "hive" && name == "len" {
						return Result.Ok(args[0].value)
					}
				}
			}
			if callee is ast.Expr.Ident(bare) {
				if bare == "len" {
					return Result.Ok(args[0].value)
				}
			}
		}
	}
	return Result.Error(false)
}

// Whether two expressions are the same one written twice. Only the shapes an
// index takes are worth asking about: a name, or a path into one.
func sameExpr(a: ast.Expr, b: ast.Expr): Bool {
	if a is ast.Expr.Ident(left) {
		if b is ast.Expr.Ident(right) {
			return left == right
		}
	}
	if a is ast.Expr.Member(leftSubject, leftField) {
		if b is ast.Expr.Member(rightSubject, rightField) {
			return leftField == rightField && sameExpr(leftSubject, rightSubject)
		}
	}
	if a is ast.Expr.IntLit(left) {
		if b is ast.Expr.IntLit(right) {
			return left == right
		}
	}
	return false
}

// One side of an operator, with the coercion the other side asks for.
proc coerced(em: mut Emit, env: infer.Env, side: ast.Expr, ty: types.Ty, other: types.Ty): Str {
	written := expr(em, env, side, ty)
	if ty is types.Ty.TAtom {
		if other is types.Ty.TStr {
			return "hive.AtomToStr(" + written + ")"
		}
	}
	return written
}

// `+` is three operators told apart by one type: a sum, a concatenation, and a
// fresh vector holding both sides.
proc arithmetic(em: mut Emit, env: infer.Env, op: ast.BinOp, l: Str, r: Str, ty: types.Ty): Str {
	if op is ast.BinOp.Add {
		if ty is types.Ty.TVec(_, _) {
			return "hive.Concat(" + l + ", " + r + ")"
		}
		return "(" + l + " + " + r + ")"
	}

	if op is ast.BinOp.Sub { return "(" + l + " - " + r + ")" }
	if op is ast.BinOp.Mul { return "(" + l + " * " + r + ")" }
	// Dividing — or taking a remainder — by zero is a value rather than a crash,
	// which Go's own operators do not do.
	if op is ast.BinOp.Div {
		if ty is types.Ty.TFloat {
			return "hive.DivFloat(" + l + ", " + r + ")"
		}
		return "hive.DivInt(" + l + ", " + r + ")"
	}
	if op is ast.BinOp.Mod {
		if ty is types.Ty.TFloat {
			return "hive.ModFloat(" + l + ", " + r + ")"
		}
		return "hive.ModInt(" + l + ", " + r + ")"
	}
	if op is ast.BinOp.Pow {
		if ty is types.Ty.TFloat {
			return "hive.PowFloat(" + l + ", " + r + ")"
		}
		return "hive.PowInt(" + l + ", " + r + ")"
	}
	return "(" + l + " + " + r + ")"
}

// A scalar compares with Go's own `==`; anything that owns storage compares
// structurally, which is what `==` means on a vector, a map and a declared type.
proc equality(em: mut Emit, env: infer.Env, l: Str, r: Str, ty: types.Ty): Str {
	if types.ownsStorage(env.table, ty) || isUnion(env.table, ty) {
		return "hive.Eq(" + l + ", " + r + ")"
	}
	if ty is types.Ty.TResult(_, _) {
		return "hive.Eq(" + l + ", " + r + ")"
	}
	if ty is types.Ty.TUnknown {
		return "hive.Eq(" + l + ", " + r + ")"
	}
	return "(" + l + " == " + r + ")"
}

func isUnion(t: types.Table, ty: types.Ty): Bool {
	if ty is types.Ty.TNamed(name) {
		if types.findType(t, name) is Result.Ok(info) {
			return len(info.variants) > 0
		}
	}
	return false
}

// --- Calls -------------------------------------------------------------------

proc member(em: mut Emit, env: infer.Env, subject: ast.Expr, field: Str): Str {
	// `hive.<module>` on its own is not a value; only a call ever reaches
	// through it.
	return expr(em, env, subject, types.Ty.TUnknown()) + "." + goField(field)
}

proc call(em: mut Emit, env: infer.Env, callee: ast.Expr, args: ast.Arg[], want: types.Ty): Str {
	if hasHole(args) {
		return partial(em, env, callee, args, want)
	}
	// Calling an address is a send and a wait for the answer. Nothing bounded
	// this one, so syslink waits its own default.
	if isAddress(env, callee) {
		return "hive.SyslinkAwait(" + pendingSend(em, env, callee, args) + ", 0)"
	}
	if callee is ast.Expr.Ident(name) {
		return namedCall(em, env, name, args, want)
	}
	if callee is ast.Expr.Member(subject, field) {
		return memberCall(em, env, subject, field, args, want)
	}
	return expr(em, env, callee, types.Ty.TUnknown()) + "(" + plainArgs(em, env, args) + ")"
}

proc namedCall(em: mut Emit, env: infer.Env, name: Str, args: ast.Arg[], want: types.Ty): Str {
	// A declaration of your own wins, and a local binding shadows it in turn.
	if infer.isBound(env, name) == false {
		if types.findCallable(env.table, name) is Result.Ok(info) {
			return goIdent(name) + "(" + orderedArgs(em, env, info, args) + ")"
		}
		if types.fieldsOfStruct(env.table, name) is Result.Ok(fields) {
			return structLiteral(em, env, name, fields, args)
		}
		if infer.isBuiltin(name) {
			return builtin(em, env, name, args, want)
		}
	}
	return goIdent(name) + "(" + plainArgs(em, env, args) + ")"
}

proc memberCall(em: mut Emit, env: infer.Env, subject: ast.Expr, field: Str, args: ast.Arg[], want: types.Ty): Str {
	if subject is ast.Expr.Ident(head) {
		if head == "Result" {
			return resultConstructor(em, env, field, args, want)
		}
		if head == "hive" {
			return builtin(em, env, field, args, want)
		}
		// `Shape.Circle(5)` builds a variant.
		if types.findVariant(env.table, head, field) is Result.Ok(fields) {
			return variantLiteral(em, env, head, field, fields, args)
		}
	}
	if subject is ast.Expr.Member(root, module) {
		if root is ast.Expr.Ident(hiveName) {
			if hiveName == "hive" {
				return libraryCall(em, env, module, field, args, want)
			}
		}
		// `hive.sql.DatabaseDriver.SQLite()` — a variant of one of the library's
		// own enumerations, each a closed set the runtime can answer for.
		if root is ast.Expr.Member(head, libModule) {
			if head is ast.Expr.Ident(rootName) && rootName == "hive" {
				if indexOf(stdlib.variantsOf(libModule, module), field) is Result.Ok(_) {
					return libVariant(em, env, libModule, module, field, args)
				}
			}
		}
	}
	return expr(em, env, subject, types.Ty.TUnknown()) + "." + goField(field) + "(" + plainArgs(em, env, args) + ")"
}

// One event attribute. What the user did is reported as one parameter per thing
// the event carries — `_ev0`, `_ev1` — handed straight to whatever the program
// gave: a func, or a constructor with that many holes.
proc uiEvent(em: mut Emit, env: infer.Env, name: Str, args: ast.Arg[]): Str {
	useModule(em, "ui")
	if stdlib.isUiScene(name) {
		useModule(em, "uiscene")
	}
	handler := argExpr(args, 0)
	reports := stdlib.uiEventArgs(name)
	go := "hive." + stdlib.goNameOf("ui", name)
	if len(reports) == 0 {
		// `on` and `onDismiss` report nothing: they take the message itself.
		return go + "(" + expr(em, env, handler, types.Ty.TUnknown()) + ")"
	}
	mut Str[dyn] params = []
	mut Str[dyn] passed = []
	mut i := 0
	for each r in reports {
		append(params, "_ev{i} " + goType(r))
		append(passed, "_ev{i}")
		i = i + 1
	}
	return go + "(func(" + join(params, ", ") + ") any \{ return (" + expr(em, env, handler, types.Ty.TUnknown()) + ")(" + join(passed, ", ") + ") })"
}

// One of the library's own enumerations, built. The value carries what it is
// called, so what it means does not depend on a declaration order.
proc libVariant(em: mut Emit, env: infer.Env, module: Str, typeName: Str, variant: Str, args: ast.Arg[]): Str {
	useModule(em, module)
	// The two tones that carry a colour outright rather than naming a role. The
	// check is the runtime's: a colour is as often computed as written down, and
	// only one of those can be read off the source.
	if module == "ui" && typeName == "Tone" {
		if variant == "HEX" {
			return "hive.UiToneHex(" + expr(em, env, argExpr(args, 0), types.Ty.TStr()) + ")"
		}
		if variant == "RGBA" {
			mut Str[dyn] channels = []
			mut i := 0
			for ; i < 4; {
				append(channels, expr(em, env, argExpr(args, i), types.Ty.TInt()))
				i = i + 1
			}
			return "hive.UiToneRGBA(" + join(channels, ", ") + ")"
		}
	}
	if module == "sql" && typeName == "DatabaseDriver" {
		if variant == "SQLite" {
			return "hive.SqlDatabaseDriver\{Name: \"sqlite\"}"
		}
		if variant == "PostgreSQL" {
			return "hive.SqlDatabaseDriver\{Name: \"postgres\"}"
		}
		return "hive.SqlDatabaseDriver\{Name: " + expr(em, env, argExpr(args, 0), types.Ty.TStr()) + "}"
	}
	return "hive." + text.capitalise(module) + typeName + "(" + quoted(variant) + ")"
}

// `Result.Ok(v)` cannot say what its error half is, so the type it is landing in
// is what says — and where nothing says, `any` is what Go is told.
proc resultConstructor(em: mut Emit, env: infer.Env, variant: Str, args: ast.Arg[], want: types.Ty): Str {
	mut ok := types.Ty.TUnknown()
	mut bad := types.Ty.TUnknown()
	if want is types.Ty.TResult(wantOk, wantBad) {
		ok = wantOk
		bad = wantBad
	}
	payload := argExpr(args, 0)
	if variant == "Ok" {
		if ok is types.Ty.TUnknown {
			ok = infer.typeOf(env, payload)
		}
		return "hive.Ok[" + goType(ok) + ", " + goType(bad) + "](" + expr(em, env, payload, ok) + ")"
	}
	if bad is types.Ty.TUnknown {
		bad = infer.typeOf(env, payload)
	}
	return "hive.Err[" + goType(ok) + ", " + goType(bad) + "](" + expr(em, env, payload, bad) + ")"
}

proc structLiteral(em: mut Emit, env: infer.Env, name: Str, fields: ast.Field[], args: ast.Arg[]): Str {
	return goIdent(name) + "\{" + fieldArgs(em, env, fields, args) + "}"
}

proc variantLiteral(em: mut Emit, env: infer.Env, typeName: Str, variant: Str, fields: ast.Field[], args: ast.Arg[]): Str {
	return goVariant(typeName, variant) + "\{" + fieldArgs(em, env, fields, args) + "}"
}

// Named arguments may appear anywhere; only the unnamed ones need to be in
// order, filling whichever parameters the named ones did not claim.
proc fieldArgs(em: mut Emit, env: infer.Env, fields: ast.Field[], args: ast.Arg[]): Str {
	mut Str[dyn] out = []
	mut i := 0
	for each f in fields {
		mut found := argFor(args, f.name, i)
		ty := types.resolve(env.table, f.declared)
		if found is ast.Expr.Absent {
			append(out, goField(f.name) + ": " + goZero(ty))
		} else {
			append(out, goField(f.name) + ": " + expr(em, env, found, ty))
		}
		i = i + 1
	}
	return join(out, ", ")
}

proc orderedArgs(em: mut Emit, env: infer.Env, info: types.CallableInfo, args: ast.Arg[]): Str {
	mut Str[dyn] out = []
	mut i := 0
	for each p in info.params {
		mut found := argFor(args, p.name, i)
		ty := types.resolve(env.table, p.declared)
		mut written := expr(em, env, found, ty)
		if p.mutex {
			// A mutex parameter takes the caller's own storage, which is its
			// address — and if the caller's name is itself a pointer, the address
			// it already holds.
			written = addressOf(em, found, written)
		} else if isMutableSource(em, found) && types.ownsStorage(env.table, ty) && lends(em, info.name) == false {
			written = cloned(env.table, ty, written)
		}
		append(out, written)
		i = i + 1
	}
	return join(out, ", ")
}

// Whether this callee may be handed the caller's own storage rather than a copy
// of it. Never while a thread is being started: that copy is the fence between
// two threads rather than a defence against a later write.
proc lends(em: mut Emit, name: Str): Bool {
	if em.spawning {
		return false
	}
	return indexOf(em.lent, name) is Result.Ok(_)
}

// The address of storage a mutex parameter is being handed. A name that is
// already a pointer is passed on as it stands.
proc addressOf(em: mut Emit, found: ast.Expr, written: Str): Str {
	if found is ast.Expr.Ident(name) {
		if indexOf(em.pointers, resolveAlias(em, name)) is Result.Ok(_) {
			return goIdent(resolveAlias(em, name))
		}
	}
	return "&" + written
}

// The argument filling `name`, which is the one written with that name if there
// is one, and otherwise the `index`-th of the unnamed ones.
func argFor(args: ast.Arg[], name: Str, index: Int): ast.Expr {
	for each a in args {
		if a.name == name {
			return a.value
		}
	}
	mut seen := 0
	for each a in args {
		if a.name == "" {
			if seen == index {
				return a.value
			}
			seen = seen + 1
		}
	}
	return ast.Expr.Absent()
}

proc plainArgs(em: mut Emit, env: infer.Env, args: ast.Arg[]): Str {
	mut Str[dyn] out = []
	for each a in args {
		append(out, expr(em, env, a.value, types.Ty.TUnknown()))
	}
	return join(out, ", ")
}

func hasHole(args: ast.Arg[]): Bool {
	for each a in args {
		if a.value is ast.Expr.Hole {
			return true
		}
	}
	return false
}

// A partial application is a closure whose parameters are the holes, in the
// order they were written, capturing everything supplied where it was written.
proc partial(em: mut Emit, env: infer.Env, callee: ast.Expr, args: ast.Arg[], want: types.Ty): Str {
	whole := infer.typeOf(env, ast.Expr.Call(callee, copiedArgs(args)))
	mut types.Ty[dyn] holeTypes = []
	mut resultType := types.Ty.TUnknown()
	if whole is types.Ty.TFn(_, holes, r) {
		holeTypes = holes
		resultType = r
	}

	mut Str[dyn] params = []
	mut ast.Arg[dyn] filled = []
	for each a in args {
		if a.value is ast.Expr.Hole {
			holeName := fresh(em, "h")
			at := len(params)
			mut holeType := types.Ty.TUnknown()
			if holeTypes bounds at {
				// A hole's type is the parameter it stands in for.
				holeType = holeTypes[at]
			}
			append(params, holeName + " " + goType(holeType))
			append(filled, ast.Arg(a.name, ast.Expr.Ident(holeName)))
		} else {
			append(filled, a)
		}
	}

	body := call(em, env, callee, filled, resultType)
	if resultType is types.Ty.TVoid {
		return "func(" + join(params, ", ") + ") \{ " + body + " }"
	}
	return "func(" + join(params, ", ") + ") " + goType(resultType) + " \{ return " + body + " }"
}

func copiedArgs(args: ast.Arg[]): ast.Arg[dyn] {
	mut ast.Arg[dyn] out = []
	for each a in args {
		append(out, a)
	}
	return out
}

// --- The global builtins -----------------------------------------------------

proc builtin(em: mut Emit, env: infer.Env, name: Str, args: ast.Arg[], want: types.Ty): Str {
	mut first := argExpr(args, 0)
	firstType := infer.typeOf(env, first)
	a := expr(em, env, first, types.Ty.TUnknown())

	if name == "len" {
		if firstType is types.Ty.TStr { return "hive.LenStr(" + a + ")" }
		if firstType is types.Ty.TMap(_, _) { return "(" + a + ").Len()" }
		return "len(" + a + ")"
	}
	if name == "bytes" {
		if firstType is types.Ty.TStr { return "len(" + a + ")" }
		return "hive.Bytes(" + a + ")"
	}
	if name == "join" {
		return "hive.Join(" + a + ", " + expr(em, env, argExpr(args, 1), types.Ty.TStr()) + ")"
	}
	if name == "split" {
		return "hive.Split(" + a + ", " + expr(em, env, argExpr(args, 1), types.Ty.TStr()) + ")"
	}
	if name == "replaceFirst" || name == "replaceAll" {
		from := expr(em, env, argExpr(args, 1), types.Ty.TStr())
		to := expr(em, env, argExpr(args, 2), types.Ty.TStr())
		return "hive." + text.capitalise(name) + "(" + a + ", " + from + ", " + to + ")"
	}
	if name == "indexOf" {
		if firstType is types.Ty.TStr {
			return "hive.IndexOfStr(" + a + ", " + expr(em, env, argExpr(args, 1), types.Ty.TStr()) + ")"
		}
		return "hive.IndexOfVec(" + a + ", " + expr(em, env, argExpr(args, 1), types.elementOf(firstType)) + ")"
	}
	if name == "row" {
		return "hive.Row(" + a + ", " + expr(em, env, argExpr(args, 1), types.Ty.TStr()) + ")"
	}
	if name == "column" {
		return "hive.Column(" + a + ", " + expr(em, env, argExpr(args, 1), types.Ty.TStr()) + ")"
	}
	return walkBuiltin(em, env, name, args, a, firstType)
}

proc walkBuiltin(em: mut Emit, env: infer.Env, name: Str, args: ast.Arg[], a: Str, firstType: types.Ty): Str {
	second := expr(em, env, argExpr(args, 1), types.Ty.TUnknown())
	if name == "map" {
		return "hive.Map(" + a + ", " + second + ")"
	}
	if name == "filter" {
		return "hive.Filter(" + a + ", " + second + ")"
	}
	if name == "filterMap" {
		return "hive.FilterMap(" + a + ", " + second + ")"
	}
	if name == "sort" {
		if len(args) == 2 {
			return "hive.SortBy(" + a + ", " + second + ")"
		}
		return "hive.Sort(" + a + ")"
	}
	// `drop` is both a value and a write: what it hands back is what it removed,
	// which is the ordinary way to take elements off a vector and keep them.
	if name == "drop" {
		return "hive.Drop(&" + a + ", " + expr(em, env, argExpr(args, 1), types.Ty.TInt()) + ", " + expr(em, env, argExpr(args, 2), types.Ty.TInt()) + ")"
	}
	// `append` and `prepend` hand nothing back — the vector you gave them is the
	// result — so they may only stand as a statement of their own.
	if name == "append" || name == "prepend" {
		fail(em, "`{name}` hands nothing back: the vector you gave it is the result, so it stands as a statement of its own rather than inside an expression")
		return "nil"
	}
	fail(em, "`{name}` is not a builtin this compiler carries")
	return "nil"
}

// --- Calling Go --------------------------------------------------------------
//
// A Go function's wrapper: the copies in, the call, the copy out. Copying in
// both directions keeps a mutation on the far side from being one of a Hive
// value, and is what lets an imported Go function be a `func` here at all.

proc emitForeign(em: mut Emit, name: Str, params: ast.Param[], result: ast.TypeExpr, packageName: Str, symbol: Str, goResults: Int): void {
	firstLine := len(em.out)
	blank(em)
	mut Str[dyn] written = []
	mut Str[dyn] arguments = []
	for each p in params {
		ty := types.resolve(em.table, p.declared)
		append(written, goIdent(p.name) + " " + goType(ty))
		append(arguments, intoGo(em, ty, goIdent(p.name), 0))
	}
	call := packageName + "." + symbol + "(" + join(arguments, ", ") + ")"
	answered := types.resolve(em.table, result)
	if answered is types.Ty.TVoid {
		open(em, "func " + goIdent(name) + "(" + join(written, ", ") + ") \{")
		line(em, call)
		close(em, "}")
		append(em.spans, name + "\t{firstLine}\t{len(em.out)}")
		return
	}
	open(em, "func " + goIdent(name) + "(" + join(written, ", ") + ") " + goType(answered) + " \{")
	// `(T, error)` and a lone `error` are both how a Go function reports failure
	// and a `Result` is how Hive answers, so the values are put back together
	// here. Which shape it is cannot be read off the Hive type, so the Go side's
	// own count decides.
	if answered is types.Ty.TResult(ok, _) {
		if goResults == 1 {
			// Nothing but an `error` is a Go function that either worked or did
			// not, so the `Ok` carries `true`.
			open(em, "if err := " + call + "; err != nil \{")
			line(em, "return hive.Err[" + goType(ok) + ", string](err.Error())")
			close(em, "}")
			line(em, "return hive.Ok[" + goType(ok) + ", string](true)")
		} else {
			line(em, "value, err := " + call)
			open(em, "if err != nil \{")
			line(em, "return hive.Err[" + goType(ok) + ", string](err.Error())")
			close(em, "}")
			line(em, "return hive.Ok[" + goType(ok) + ", string](" + outOfGo(em, ok, "value", 0) + ")")
		}
	} else {
		line(em, "return " + outOfGo(em, answered, call, 0))
	}
	close(em, "}")
	append(em.spans, name + "\t{firstLine}\t{len(em.out)}")
}

// Whether a type is a different Go *type* on the two sides, which decides
// between copying a value and converting it. A map is (`Dict` here, Go map
// there), a mirrored struct is (two named structs), and a vector or a map's
// values are whenever what they hold is.
func shapeDiffers(em: Emit, ty: types.Ty): Bool {
	if ty is types.Ty.TNamed(name) {
		return indexOf(em.mirrors, name) is Result.Ok(_)
	}
	if ty is types.Ty.TMap(_, _) {
		return true
	}
	if ty is types.Ty.TVec(element, _) {
		return shapeDiffers(em, element)
	}
	return false
}

// A value on its way *into* Go. A scalar is copied by being passed; anything
// that owns storage is copied outright; and anything whose Go type differs is
// converted, which for a mirrored struct is a field-by-field copy.
proc intoGo(em: mut Emit, ty: types.Ty, written: Str, depth: Int): Str {
	if shapeDiffers(em, ty) == false {
		return cloned(em.table, ty, written)
	}
	if ty is types.Ty.TNamed(name) {
		return "toFfi_" + goIdent(name) + "(" + written + ")"
	}
	if ty is types.Ty.TVec(element, _) {
		item := "e{depth}"
		return "hive.MapVec(" + written + ", func(" + item + " " + goType(element) + ") " + farType(em, element) + " \{ return " + intoGo(em, element, item, depth + 1) + " })"
	}
	if ty is types.Ty.TMap(_, value) {
		if shapeDiffers(em, value) == false {
			return "hive.DictToGo(" + written + ")"
		}
		item := "v{depth}"
		return "hive.DictToGoFn(" + written + ", func(" + item + " " + goType(value) + ") " + farType(em, value) + " \{ return " + intoGo(em, value, item, depth + 1) + " })"
	}
	return cloned(em.table, ty, written)
}

// And on its way out, the same in reverse — plus one thing only decidable here:
// a Go map has no order of its own, so the pairs are read back in key order,
// which is the only choice giving the same program the same output twice.
proc outOfGo(em: mut Emit, ty: types.Ty, written: Str, depth: Int): Str {
	if shapeDiffers(em, ty) == false {
		return cloned(em.table, ty, written)
	}
	if ty is types.Ty.TNamed(name) {
		return "fromFfi_" + goIdent(name) + "(" + written + ")"
	}
	if ty is types.Ty.TVec(element, _) {
		item := "e{depth}"
		return "hive.MapVec(" + written + ", func(" + item + " " + farType(em, element) + ") " + goType(element) + " \{ return " + outOfGo(em, element, item, depth + 1) + " })"
	}
	if ty is types.Ty.TMap(key, value) {
		if shapeDiffers(em, value) == false {
			return "hive.DictFromGo(" + written + ", " + keyOrder(key) + ")"
		}
		item := "v{depth}"
		return "hive.DictFromGoFn(" + written + ", " + keyOrder(key) + ", func(" + item + " " + farType(em, value) + ") " + goType(value) + " \{ return " + outOfGo(em, value, item, depth + 1) + " })"
	}
	return cloned(em.table, ty, written)
}

// The Go spelling of a type on the *far* side of the boundary: a mirrored struct
// is the file's own, a map is a Go map, and everything else is spelled the same
// on both sides.
func farType(em: Emit, ty: types.Ty): Str {
	if ty is types.Ty.TNamed(name) {
		if indexOf(em.mirrors, name) is Result.Ok(_) {
			return mirrorPackage(em, name) + "." + goSideName(name)
		}
	}
	if ty is types.Ty.TVec(element, _) {
		return "[]" + farType(em, element)
	}
	if ty is types.Ty.TMap(key, value) {
		return "map[" + goType(key) + "]" + farType(em, value)
	}
	return goType(ty)
}

// The package a mirrored type came from, which is the one the wrapper calls.
func mirrorPackage(em: Emit, name: Str): Str {
	mut i := 0
	for each mirrored in em.mirrors {
		if mirrored == name {
			if em.mirrorPackages bounds i {
				return em.mirrorPackages[i]
			}
		}
		i = i + 1
	}
	return ""
}

// `false` before `true`, which is the order they compare in everywhere else;
// everything else in the order it compares in.
func keyOrder(key: types.Ty): Str {
	if key is types.Ty.TBool {
		return "func(a, b bool) bool \{ return !a && b }"
	}
	return "func(a, b " + goType(key) + ") bool \{ return a < b }"
}

/// The two converters for each struct Hive mirrors from a Go file: the same
/// fields, in the same order, copied one way and then the other. A copy rather
/// than a translation, the two structs being the same shape.
proc emitMirrors(em: mut Emit, m: ast.Module): void {
	for each f in m.foreign {
		for each name in f.types {
			flat := name
			if types.findType(em.table, flat) is Result.Ok(info) {
				// The Go side keeps its own spelling, which is the flat name
				// without the prefix the flattener gave it.
				there := f.packageName + "." + goSideName(flat)
				blank(em)
				open(em, "func toFfi_" + goIdent(flat) + "(v " + goIdent(flat) + ") " + there + " \{")
				line(em, "return " + there + "\{" + mirrorFields(em, info.shared, true) + "}")
				close(em, "}")
				blank(em)
				open(em, "func fromFfi_" + goIdent(flat) + "(v " + there + ") " + goIdent(flat) + " \{")
				line(em, "return " + goIdent(flat) + "\{" + mirrorFields(em, info.shared, false) + "}")
				close(em, "}")
			}
		}
	}
}

// A mirrored struct's field list. Both sides spell a field the same way — Go
// exported, Hive camelCase — so the two names are the one name in two cases.
proc mirrorFields(em: mut Emit, fields: ast.Field[], into: Bool): Str {
	mut Str[dyn] out = []
	for each f in fields {
		ty := types.resolve(em.table, f.declared)
		written := "v." + goField(f.name)
		mut piece := ""
		if into {
			piece = intoGo(em, ty, written, 0)
		} else {
			piece = outOfGo(em, ty, written, 0)
		}
		append(out, goField(f.name) + ": " + piece)
	}
	return join(out, ", ")
}

// What the Go file calls a type Hive mirrored. Declarations are prefixed like
// any module's — `measures_1_Weight` — and Go knows it by the last piece.
func goSideName(flat: Str): Str {
	pieces := split(flat, "_")
	if pieces bounds len(pieces) - 1 {
		return lastOf(pieces)
	}
	return flat
}

func lastOf(pieces: Str[]): Str {
	last := len(pieces) - 1
	if pieces bounds last {
		return pieces[last]
	}
	return ""
}

// --- Services ----------------------------------------------------------------
//
// An address is *called*, and what the call site does with it decides what it
// means, exactly as for a func. Each carries three things the Hive source never
// mentions: an encoder for the message, a decoder for the answer, and a
// structural digest of the message type — so a peer built from a different
// declaration fails loudly instead of decoding another type's bytes into this.
//
// The answer needs no annotation: a service replies with one of its own
// messages, so the decoder for a reply is the one its mailbox already uses.

func isAddress(env: infer.Env, e: ast.Expr): Bool {
	ty := infer.typeOf(env, e)
	if ty is types.Ty.TLib(module, name) {
		return module == "syslink" && name == "Address"
	}
	return false
}

/// Whether this expression is a call *of an address*, which is a send rather
/// than a call of a function.
func isSend(env: infer.Env, e: ast.Expr): Bool {
	if e is ast.Expr.Call(callee, _) {
		return isAddress(env, callee)
	}
	return false
}

/// A send with somewhere for the answer to arrive, and the wait for it. `ms` is
/// `0` where nothing bounded the wait, which leaves syslink its own patience.
proc sendAndWait(em: mut Emit, env: infer.Env, call: ast.Expr, ms: Str): Str {
	if call is ast.Expr.Call(callee, args) {
		return "hive.SyslinkAwait(" + pendingSend(em, env, callee, args) + ", " + ms + ")"
	}
	return expr(em, env, call, types.Ty.TUnknown())
}

proc pendingSend(em: mut Emit, env: infer.Env, address: ast.Expr, args: ast.Arg[]): Str {
	useModule(em, "syslink")
	message := argExpr(args, 0)
	ty := infer.typeOf(env, message)
	return "hive.SyslinkSendAwaitable(" + expr(em, env, address, types.Ty.TUnknown()) + ", "
		+ carried(em, env, message, ty) + ", " + syslinkEncoder(em, ty) + ", "
		+ syslinkDigest(em, ty) + ", hive.SyslinkReplyDecoder(" + decoderRef(em, ty) + "))"
}

func allSends(em: Emit, env: infer.Env, calls: ast.Expr[]): Bool {
	if len(calls) == 0 {
		return false
	}
	for each c in calls {
		if isSend(env, c) == false {
			return false
		}
	}
	return true
}

/// Every request out, then one deadline across the whole barrier.
proc awaitAllSends(em: mut Emit, env: infer.Env, calls: ast.Expr[], timeout: ast.Expr): Str {
	useModule(em, "syslink")
	mut Str[dyn] pending = []
	mut element := types.Ty.TUnknown()
	for each c in calls {
		if c is ast.Expr.Call(address, args) {
			append(pending, pendingSend(em, env, address, args))
			element = infer.typeOf(env, argExpr(args, 0))
		}
	}
	mut ms := "0"
	if timeout is ast.Expr.Absent {
	} else {
		ms = expr(em, env, timeout, types.Ty.TInt())
	}
	return "hive.SyslinkAwaitAll[" + goType(element) + "]([]*hive.SyslinkPending[" + goType(element) + "]\{" + join(pending, ", ") + "}, " + ms + ")"
}

/// A cast: a send with nothing to hold the answer, which allocates nothing and
/// cannot fail.
proc sendOnly(em: mut Emit, env: infer.Env, call: ast.Expr): Str {
	if call is ast.Expr.Call(address, args) {
		useModule(em, "syslink")
		message := argExpr(args, 0)
		ty := infer.typeOf(env, message)
		return "hive.SyslinkSend(" + expr(em, env, address, types.Ty.TUnknown()) + ", "
			+ carried(em, env, message, ty) + ", " + syslinkEncoder(em, ty) + ", " + syslinkDigest(em, ty) + ")"
	}
	return expr(em, env, call, types.Ty.TUnknown())
}

// A message crosses into another thread — the service's own, or another machine
// — so it is copied on the way: nothing the sender does afterwards may be
// visible inside.
proc carried(em: mut Emit, env: infer.Env, value: ast.Expr, ty: types.Ty): Str {
	written := cloned(env.table, ty, expr(em, env, value, ty))
	// A message travels as its *mailbox* type rather than the variant it happens
	// to be: what the far side decodes into is the whole protocol.
	if isUnion(env.table, ty) {
		return goType(ty) + "(" + written + ")"
	}
	return written
}

proc syslinkEncoder(em: mut Emit, ty: types.Ty): Str {
	return "hive.SyslinkEncoder(func(_v " + goType(ty) + ") string \{ return " + encodeOf(em, ty, "_v", 0) + " })"
}

/// The digest of a message type. The signature is written here and hashed there
/// — FNV-1a wants exclusive-or and a byte's value, and Hive has neither. What
/// matters is that both ends compute the same number from the same declaration.
proc syslinkDigest(em: mut Emit, ty: types.Ty): Str {
	mut Str[dyn] seen = []
	return "hive.SyslinkDigest(" + quoted(signatureOf(em, ty, seen)) + ")"
}

/// The signature a digest is taken over: a type's own spelling, and every
/// variant and field it declares, recursively. A recursive type stops at its own
/// name — the cycle adds nothing a decoder could differ on.
proc signatureOf(em: mut Emit, ty: types.Ty, seen: Str[]): Str {
	if ty is types.Ty.TStr { return "Str" }
	if ty is types.Ty.TInt { return "Int" }
	if ty is types.Ty.TFloat { return "Float" }
	if ty is types.Ty.TBool { return "Bool" }
	if ty is types.Ty.TAtom { return "Atom" }
	if ty is types.Ty.TVoid { return "void" }
	if ty is types.Ty.TLib(module, name) { return "hive.{module}.{name}" }
	if ty is types.Ty.TVec(element, dim) {
		return signatureOf(em, element, seen) + types.showDim(dim)
	}
	if ty is types.Ty.TResult(ok, bad) {
		return "Result<" + signatureOf(em, ok, seen) + "," + signatureOf(em, bad, seen) + ">"
	}
	if ty is types.Ty.TMap(key, value) {
		return "Map<" + signatureOf(em, key, seen) + "," + signatureOf(em, value, seen) + ">"
	}
	if ty is types.Ty.TFn(_, _, _) { return "func" }
	if ty is types.Ty.TNamed(name) {
		if indexOf(seen, name) is Result.Ok(_) {
			return name
		}
		if types.findType(em.table, name) is Result.Ok(info) {
			inner := seen + [name]
			mut Str[dyn] pieces = []
			for each v in info.variants {
				append(pieces, v.name)
				for each f in v.fields {
					append(pieces, f.name + ":" + signatureOf(em, types.resolve(em.table, f.declared), inner))
				}
			}
			for each f in info.shared {
				append(pieces, f.name + ":" + signatureOf(em, types.resolve(em.table, f.declared), inner))
			}
			return name + "\{" + join(pieces, ",") + "}"
		}
		return name
	}
	return "?"
}

// --- What a handler folds over -----------------------------------------------

/// The message type a handler folds over: its second parameter, which is what
/// makes a mailbox type the whole protocol.
func handlerMessage(em: Emit, handler: ast.Expr): types.Ty {
	params := handlerParams(em, handler)
	if params bounds 1 {
		return types.resolve(em.table, params[1].declared)
	}
	return types.Ty.TUnknown()
}

/// The parameters a handler expression leaves for the runtime to fill: all of
/// them for a bare name, only the `_` holes for a partial application — which
/// lets `inbox(_, _, _, db)` be read the same way.
func handlerParams(em: Emit, handler: ast.Expr): ast.Param[dyn] {
	if handler is ast.Expr.Ident(name) {
		if types.findCallable(em.table, name) is Result.Ok(info) {
			return info.params
		}
		return []
	}
	if handler is ast.Expr.Call(callee, args) {
		if callee is ast.Expr.Ident(name) {
			if types.findCallable(em.table, name) is Result.Ok(info) {
				mut ast.Param[dyn] out = []
				mut i := 0
				for each p in info.params {
					if argFor(args, p.name, i) is ast.Expr.Hole {
						append(out, p)
					}
					i = i + 1
				}
				return out
			}
		}
	}
	return []
}

/// Whether an unanswered request may be failed the instant the turn ends.
///
/// If a handler's envelope only ever reaches `answer`, `self` or `monitor`, it
/// cannot outlive its turn — so once the turn ends no answer can still be coming
/// and whoever is waiting is told at once. If it goes anywhere else a reply may
/// genuinely be on its way, and the runtime keeps waiting. Nobody writes
/// anything either way.
func repliesInTurn(em: Emit, handler: ast.Expr): Bool {
	mut name := ""
	if handler is ast.Expr.Ident(named) {
		name = named
	} else if handler is ast.Expr.Call(callee, _) {
		if callee is ast.Expr.Ident(named) {
			name = named
		}
	}
	if name == "" {
		return false
	}
	return indexOf(em.escapers, name) is Result.Error(_)
}

/// The handlers whose envelope escapes its turn. Worked out once before
/// anything is written, since a `spawn` anywhere has to know it — and it is a
/// property of the handler rather than of the call.
func escapingHandlers(t: types.Table, decls: ast.Decl[]): Str[dyn] {
	mut Str[dyn] out = []
	for each d in decls {
		if d is ast.Decl.CallableDecl(_, name, params, _, body, _) {
			envelope := envelopeParam(t, params)
			if envelope != "" {
				if escapesInBlock(envelope, body) {
					append(out, name)
				}
			}
		}
	}
	return out
}

// The envelope parameter, found by its type rather than its position, so a
// partial application is read the same way as a bare name.
func envelopeParam(t: types.Table, params: ast.Param[]): Str {
	for each p in params {
		ty := types.resolve(t, p.declared)
		if ty is types.Ty.TLib(module, name) {
			if module == "syslink" && name == "Envelope" {
				return p.name
			}
		}
	}
	return ""
}

func escapesInBlock(name: Str, b: ast.Block): Bool {
	for each s in b.stmts {
		if escapesInStmt(name, s) {
			return true
		}
	}
	return false
}

func escapesInStmt(name: Str, s: ast.Stmt): Bool {
	if s is ast.Stmt.VarDecl(_, value, _, _) { return escapesInExpr(name, value) }
	if s is ast.Stmt.TypedDecl(_, _, value, _, _) { return escapesInExpr(name, value) }
	if s is ast.Stmt.Assign(target, value) {
		return escapesInExpr(name, target) || escapesInExpr(name, value)
	}
	if s is ast.Stmt.IfChain(branches, otherwise, _) {
		for each b in branches {
			if escapesInExpr(name, b.condition) || escapesInBlock(name, b.body) {
				return true
			}
		}
		return escapesInBlock(name, otherwise)
	}
	if s is ast.Stmt.ForLoop(init, cond, post, body) {
		return escapesInStmt(name, init) || escapesInExpr(name, cond)
			|| escapesInStmt(name, post) || escapesInBlock(name, body)
	}
	if s is ast.Stmt.ForEach(_, _, subject, body) {
		return escapesInExpr(name, subject) || escapesInBlock(name, body)
	}
	if s is ast.Stmt.ReturnStmt(value) { return escapesInExpr(name, value) }
	if s is ast.Stmt.EchoStmt(value) { return escapesInExpr(name, value) }
	if s is ast.Stmt.AssertStmt(condition) { return escapesInExpr(name, condition) }
	if s is ast.Stmt.PanicStmt(value) { return escapesInExpr(name, value) }
	// The point of the question: an envelope handed to something nobody waits
	// for may well outlive the turn.
	if s is ast.Stmt.AsyncStmt(call) { return escapesInExpr(name, call) }
	if s is ast.Stmt.Expression(value) { return escapesInExpr(name, value) }
	return false
}

func escapesInExpr(name: Str, e: ast.Expr): Bool {
	// The three calls an envelope may reach without escaping. Everything *else*
	// in one of them is still walked.
	if e is ast.Expr.Call(callee, args) {
		if turnCall(callee) {
			mut i := 0
			for each a in args {
				if i > 0 {
					if escapesInExpr(name, a.value) {
						return true
					}
				}
				i = i + 1
			}
			return false
		}
		if escapesInExpr(name, callee) {
			return true
		}
		for each a in args {
			if escapesInExpr(name, a.value) {
				return true
			}
		}
		return false
	}
	if e is ast.Expr.Ident(named) { return named == name }
	if e is ast.Expr.Interp(parts) {
		for each part in parts {
			if part is ast.InterpPart.Expression(inner) {
				if escapesInExpr(name, inner) {
					return true
				}
			}
		}
		return false
	}
	if e is ast.Expr.VectorLit(items) {
		for each item in items {
			if escapesInExpr(name, item) {
				return true
			}
		}
		return false
	}
	if e is ast.Expr.Negate(operand) { return escapesInExpr(name, operand) }
	if e is ast.Expr.Binary(_, left, right) {
		return escapesInExpr(name, left) || escapesInExpr(name, right)
	}
	if e is ast.Expr.Member(subject, _) { return escapesInExpr(name, subject) }
	if e is ast.Expr.Index(subject, index) {
		return escapesInExpr(name, subject) || escapesInExpr(name, index)
	}
	if e is ast.Expr.Slice(subject, low, high) {
		return escapesInExpr(name, subject) || escapesInExpr(name, low) || escapesInExpr(name, high)
	}
	if e is ast.Expr.IsMatch(subject, _) { return escapesInExpr(name, subject) }
	if e is ast.Expr.AwaitAll(calls, timeout) {
		for each c in calls {
			if escapesInExpr(name, c) {
				return true
			}
		}
		return escapesInExpr(name, timeout)
	}
	if e is ast.Expr.Timed(call, ms) {
		return escapesInExpr(name, call) || escapesInExpr(name, ms)
	}
	if e is ast.Expr.WithType(value, _) { return escapesInExpr(name, value) }
	if e is ast.Expr.UsingExpr(source, _) { return escapesInExpr(name, source) }
	return false
}

// --- What a caller may lend rather than copy ---------------------------------
//
// A `mut` value handed to an ordinary parameter is copied on the way in, so the
// callee's immutable view really is one (8.1). Most of those copies cannot be
// observed, and on a program of any size they are most of a compile.
//
// 8.4 takes an alias wherever one is indistinguishable from a copy, and for a
// `func` the language supplies the proof. A `func` differs from a `proc` in
// exactly two ways (4.2): no mutex parameter, and it cannot call a `proc`. So a
// `func` **cannot write to storage its caller can see**, and the only storage
// that leaves one is its result. When the result carries no storage, an argument
// can be neither written by the callee nor outlive the call.
//
// Four things are left out, each because the proof does not reach them:
//
//   * a `proc`, which may write through a mutex parameter of its own;
//   * a `query` and an imported Go `func` — both `func`s in the table, neither a
//     `CallableDecl`: a query keeps its arguments in the fragment it answers
//     with, and the Go boundary copies for reasons of its own;
//   * a result that carries storage, or holding a function value, since one can
//     be a partial application holding the argument it was made from;
//   * anything that can start a thread, directly or through what it calls. A
//     thread outlives the call that started it, so an argument reaching one is
//     storage the caller may still be writing (8.6).

/// The `func`s a caller may hand its own storage to rather than a copy of it.
proc lentFuncs(t: types.Table, decls: ast.Decl[]): Str[dyn] {
	threading := threadStarters(decls)
	mut Str[dyn] out = []
	for each d in decls {
		if d is ast.Decl.CallableDecl(kind, name, _, result, _, _) {
			if kind is ast.CallableKind.FuncKind && carriesStorage(t, types.resolve(t, result)) == false {
				if indexOf(threading, name) is Result.Error(_) {
					append(out, name)
				}
			}
		}
	}
	return out
}

// Whether a value of this type can carry storage out of a call: it owns some, or
// holds a function value, which can be a partial application holding one of the
// arguments it was built from.
func carriesStorage(t: types.Table, ty: types.Ty): Bool {
	return types.ownsStorage(t, ty) || holdsFn(ty)
}

func holdsFn(ty: types.Ty): Bool {
	if ty is types.Ty.TFn(_, _, _) { return true }
	if ty is types.Ty.TVec(element, _) { return holdsFn(element) }
	if ty is types.Ty.TResult(ok, bad) { return holdsFn(ok) || holdsFn(bad) }
	if ty is types.Ty.TMap(_, value) { return holdsFn(value) }
	return false
}

// Every callable that can start a thread, directly or through something it
// calls. The closure runs over the whole program rather than `func`s alone: a
// superset costing nothing, since a `func` may only call `func`s. The graph is
// built only when a program starts a thread at all.
proc threadStarters(decls: ast.Decl[]): Str[dyn] {
	mut Str[dyn] found = []
	for each d in decls {
		if d is ast.Decl.CallableDecl(_, name, _, _, body, _) {
			mut Scan sc = Scan(false, [])
			scanBlock(body, sc)
			if sc.spawns {
				append(found, name)
			}
		} else if d is ast.Decl.QueryDecl(name, _, _, sql, _) {
			mut Scan sc2 = Scan(false, [])
			scanSql(sql, sc2)
			if sc2.spawns {
				append(found, name)
			}
		}
	}
	if len(found) == 0 {
		return found
	}
	g := callGraph(decls)
	mut growing := true
	for ; growing; {
		growing = false
		mut i := 0
		for each caller in g.from {
			if g.to bounds i {
				if indexOf(found, g.to[i]) is Result.Ok(_) && indexOf(found, caller) is Result.Error(_) {
					append(found, caller)
					growing = true
				}
			}
			i = i + 1
		}
	}
	return found
}

/// The call graph as two parallel vectors: `from[i]` names something that calls
/// `to[i]`. A name that is nobody's declaration is harmless — it matches none.
type Graph {
	from: Str[dyn]
	to: Str[dyn]
}

proc callGraph(decls: ast.Decl[]): Graph {
	mut Str[dyn] from = []
	mut Str[dyn] to = []
	for each d in decls {
		if d is ast.Decl.CallableDecl(_, name, _, _, body, _) {
			mut Scan sc = Scan(false, [])
			scanBlock(body, sc)
			for each called in sc.calls {
				append(from, name)
				append(to, called)
			}
		} else if d is ast.Decl.QueryDecl(name, _, _, sql, _) {
			mut Scan sc2 = Scan(false, [])
			scanSql(sql, sc2)
			for each called in sc2.calls {
				append(from, name)
				append(to, called)
			}
		}
	}
	return Graph(from, to)
}

/// What one body does that the lending question turns on: whether it starts a
/// thread, and what it calls. Both come out of one walk.
type Scan {
	spawns: Bool
	calls: Str[dyn]
}

proc scanBlock(b: ast.Block, sc: mut Scan): void {
	for each s in b.stmts {
		scanStmt(s, sc)
	}
}

proc scanStmt(s: ast.Stmt, sc: mut Scan): void {
	if s is ast.Stmt.VarDecl(_, value, _, deferred) {
		// `x := async f(a)` starts the call now and waits wherever `x` is read.
		if deferred { sc.spawns = true }
		scanExpr(value, sc)
	} else if s is ast.Stmt.TypedDecl(_, _, value, _, deferred) {
		if deferred { sc.spawns = true }
		scanExpr(value, sc)
	} else if s is ast.Stmt.Assign(target, value) {
		scanExpr(target, sc)
		scanExpr(value, sc)
	} else if s is ast.Stmt.IfChain(branches, otherwise, _) {
		for each b in branches {
			scanExpr(b.condition, sc)
			scanBlock(b.body, sc)
		}
		scanBlock(otherwise, sc)
	} else if s is ast.Stmt.ForLoop(init, cond, post, body) {
		scanStmt(init, sc)
		scanExpr(cond, sc)
		scanStmt(post, sc)
		scanBlock(body, sc)
	} else if s is ast.Stmt.ForEach(_, _, subject, body) {
		scanExpr(subject, sc)
		scanBlock(body, sc)
	} else if s is ast.Stmt.ReturnStmt(value) {
		scanExpr(value, sc)
	} else if s is ast.Stmt.EchoStmt(value) {
		scanExpr(value, sc)
	} else if s is ast.Stmt.AssertStmt(condition) {
		scanExpr(condition, sc)
	} else if s is ast.Stmt.PanicStmt(value) {
		scanExpr(value, sc)
	} else if s is ast.Stmt.AsyncStmt(call) {
		sc.spawns = true
		scanExpr(call, sc)
	} else if s is ast.Stmt.Expression(value) {
		scanExpr(value, sc)
	}
}

proc scanExpr(e: ast.Expr, sc: mut Scan): void {
	if e is ast.Expr.Call(callee, args) {
		if callee is ast.Expr.Ident(name) {
			append(sc.calls, name)
		} else {
			scanExpr(callee, sc)
		}
		for each a in args {
			scanExpr(a.value, sc)
		}
	} else if e is ast.Expr.Interp(parts) {
		for each part in parts {
			if part is ast.InterpPart.Expression(inner) {
				scanExpr(inner, sc)
			}
		}
	} else if e is ast.Expr.VectorLit(items) {
		for each item in items {
			scanExpr(item, sc)
		}
	} else if e is ast.Expr.Negate(operand) {
		scanExpr(operand, sc)
	} else if e is ast.Expr.Binary(_, left, right) {
		scanExpr(left, sc)
		scanExpr(right, sc)
	} else if e is ast.Expr.Member(subject, _) {
		scanExpr(subject, sc)
	} else if e is ast.Expr.Index(subject, index) {
		scanExpr(subject, sc)
		scanExpr(index, sc)
	} else if e is ast.Expr.Slice(subject, low, high) {
		scanExpr(subject, sc)
		scanExpr(low, sc)
		scanExpr(high, sc)
	} else if e is ast.Expr.IsMatch(subject, _) {
		scanExpr(subject, sc)
	} else if e is ast.Expr.AwaitAll(calls, timeout) {
		// A barrier runs every call in it on a thread of its own.
		sc.spawns = true
		for each c in calls {
			scanExpr(c, sc)
		}
		scanExpr(timeout, sc)
	} else if e is ast.Expr.Timed(call, ms) {
		// `f(x) with timeout ms` waits on a thread, so it starts one.
		sc.spawns = true
		scanExpr(call, sc)
		scanExpr(ms, sc)
	} else if e is ast.Expr.WithType(value, _) {
		scanExpr(value, sc)
	} else if e is ast.Expr.UsingExpr(source, form) {
		scanExpr(source, sc)
		scanUsing(form, sc)
	}
}

proc scanUsing(form: ast.UsingForm, sc: mut Scan): void {
	if form is ast.UsingForm.Csv(separator) {
		scanExpr(separator, sc)
	} else if form is ast.UsingForm.RunQuery(call) {
		scanExpr(call, sc)
	} else if form is ast.UsingForm.Raw(sqlText) {
		scanExpr(sqlText, sc)
	}
}

proc scanSql(parts: ast.SqlPart[], sc: mut Scan): void {
	for each part in parts {
		if part is ast.SqlPart.Param(value) {
			scanExpr(value, sc)
		} else if part is ast.SqlPart.Where(group) {
			scanSqlGroup(group, sc)
		}
	}
}

proc scanSqlGroup(group: ast.SqlGroup, sc: mut Scan): void {
	for each item in group.items {
		if item is ast.SqlItem.Cond(condition, body) {
			scanExpr(condition, sc)
			scanSql(body, sc)
		} else if item is ast.SqlItem.Nested(inner) {
			scanSqlGroup(inner, sc)
		}
	}
}

// `hive.syslink.answer`, `.self` and `.monitor` — the three that take an
// envelope and cannot let it out.
func turnCall(callee: ast.Expr): Bool {
	if callee is ast.Expr.Member(subject, field) {
		if subject is ast.Expr.Member(root, module) {
			if root is ast.Expr.Ident(head) {
				if head == "hive" && module == "syslink" {
					return field == "answer" || field == "self" || field == "monitor"
				}
			}
		}
	}
	return false
}

// --- Queries -----------------------------------------------------------------
//
// A query is a function that builds a *fragment*: the text a database will read,
// and the values bound beside it. Nothing a caller supplies reaches the text —
// an interpolation is a placeholder, the value travels next to it — so a query
// can only ever mean what it says.
//
// A `WHERE { }` block is the one part decided at run time, and only in which of
// its predicates are there: every branch's text is fixed at compile time.

proc emitQuery(em: mut Emit, env: infer.Env, name: Str, params: ast.Param[], result: ast.TypeExpr, sql: ast.SqlPart[]): void {
	useModule(em, "sql")
	firstLine := len(em.out)
	blank(em)
	mut Str[dyn] written = []
	for each p in params {
		append(written, goIdent(p.name) + " " + goType(types.resolve(env.table, p.declared)))
	}
	inner := infer.boundParams(env, params, 0)
	open(em, "func " + goIdent(name) + "(" + join(written, ", ") + ") hive.SqlFragment \{")
	line(em, "_sql := \"\"")
	line(em, "_args := []any\{}")
	emitSqlParts(em, inner, sql)
	line(em, "return hive.SqlFragment\{Text: _sql, Args: _args}")
	close(em, "}")
	append(em.spans, name + "\t{firstLine}\t{len(em.out)}")
}

proc emitSqlParts(em: mut Emit, env: infer.Env, parts: ast.SqlPart[]): void {
	for each part in parts {
		if part is ast.SqlPart.Lit(written) {
			if written != "" {
				line(em, "_sql += " + quoted(written))
			}
		} else if part is ast.SqlPart.Param(value) {
			line(em, "_sql += \"?\"")
			line(em, "_args = append(_args, " + expr(em, env, value, types.Ty.TUnknown()) + ")")
		} else if part is ast.SqlPart.Where(group) {
			into := "_where{em.temp}"
			em.temp = em.temp + 1
			emitSqlGroup(em, env, group, into)
			// A block that gathered nothing leaves no WHERE behind, which is why
			// there is no `WHERE 1 = 1` to write in Hive.
			open(em, "if " + into + ".Text != \"\" \{")
			line(em, "_sql += \" WHERE \" + " + into + ".Text")
			line(em, "_args = append(_args, " + into + ".Args...)")
			close(em, "}")
		}
	}
}

// One group, collected into `into`. A group contributing nothing is empty text,
// so it disappears rather than leaving a dangling connective; one contributing
// more than one predicate is parenthesised, so nesting cannot change how the
// surrounding connective binds.
proc emitSqlGroup(em: mut Emit, env: infer.Env, group: ast.SqlGroup, into: Str): Str {
	gathered := "_parts{em.temp}"
	em.temp = em.temp + 1
	line(em, gathered + " := []hive.SqlFragment\{}")
	for each item in group.items {
		if item is ast.SqlItem.Cond(condition, body) {
			open(em, "if " + expr(em, env, condition, types.Ty.TBool()) + " \{")
			line(em, gathered + " = append(" + gathered + ", hive.SqlFragment\{Text: " + predicateText(em, env, body) + ", Args: []any\{" + predicateArgs(em, env, body) + "}})")
			close(em, "}")
		} else if item is ast.SqlItem.Nested(inner) {
			nested := "_where{em.temp}"
			em.temp = em.temp + 1
			emitSqlGroup(em, env, inner, nested)
			open(em, "if " + nested + ".Text != \"\" \{")
			line(em, gathered + " = append(" + gathered + ", " + nested + ")")
			close(em, "}")
		}
	}
	mut connective := " OR "
	if group.conjunction {
		connective = " AND "
	}
	line(em, into + " := hive.SqlJoin(" + gathered + ", " + quoted(connective) + ", true)")
	return into
}

// A predicate's own text and values. Its text is fixed here: only whether it is
// there at all is decided when the query runs.
proc predicateText(em: mut Emit, env: infer.Env, body: ast.SqlPart[]): Str {
	mut Str[dyn] out = []
	for each part in body {
		if part is ast.SqlPart.Lit(written) {
			append(out, quoted(written))
		} else if part is ast.SqlPart.Param(_) {
			append(out, "\"?\"")
		}
	}
	if len(out) == 0 {
		return "\"\""
	}
	return join(out, " + ")
}

proc predicateArgs(em: mut Emit, env: infer.Env, body: ast.SqlPart[]): Str {
	mut Str[dyn] out = []
	for each part in body {
		if part is ast.SqlPart.Param(value) {
			append(out, expr(em, env, value, types.Ty.TUnknown()))
		}
	}
	return join(out, ", ")
}

// --- Reading rows ------------------------------------------------------------

/// The mapper that turns one row of cells into what a query declared its rows
/// to be: a generated one per row type, or a one-cell reader for a single
/// column.
proc rowMapper(em: mut Emit, rows: types.Ty): Str {
	element := types.elementOf(rows)
	if element is types.Ty.TNamed(name) {
		if types.findType(em.table, name) is Result.Ok(_) {
			needRow(em, name)
			return rowName(name)
		}
	}
	return "func(_r []string) (" + goType(element) + ", error) \{ if len(_r) != 1 \{ var _z " + goType(element) + "; return _z, hive.SqlShapeError(1, len(_r)) }; return " + cellConvert(element, "_r[0]", quoted("1")) + " }"
}

func cellConvert(ty: types.Ty, cell: Str, column: Str): Str {
	if ty is types.Ty.TInt { return "hive.SqlCellInt(" + cell + ", " + column + ")" }
	if ty is types.Ty.TFloat { return "hive.SqlCellFloat(" + cell + ", " + column + ")" }
	if ty is types.Ty.TBool { return "hive.SqlCellBool(" + cell + ", " + column + ")" }
	// Anything else arrives as the text it was: a row holds cells, and a cell is
	// a scalar.
	return "hive.SqlCellStr(" + cell + ", " + column + ")"
}

func rowName(name: Str): Str {
	return "sqlRow_" + goIdent(name)
}

proc needRow(em: mut Emit, name: Str): void {
	if indexOf(em.rows, name) is Result.Error(_) {
		append(em.rows, name)
	}
}

/// One mapper per row type a typed query reads.
proc emitRows(em: mut Emit): void {
	mut done := 0
	for ; done < len(em.rows); {
		at := done
		done = done + 1
		if em.rows bounds at {
			emitRow(em, em.rows[at])
		}
	}
}

proc emitRow(em: mut Emit, name: Str): void {
	if types.findType(em.table, name) is Result.Ok(info) {
		fields := info.shared
		blank(em)
		open(em, "func " + rowName(name) + "(_r []string) (" + goIdent(name) + ", error) \{")
		open(em, "if len(_r) != {len(fields)} \{")
		line(em, "return " + goIdent(name) + "\{}, hive.SqlShapeError({len(fields)}, len(_r))")
		close(em, "}")
		mut i := 0
		mut Str[dyn] inits = []
		for each f in fields {
			ty := types.resolve(em.table, f.declared)
			line(em, "f{i}, err{i} := " + cellConvert(ty, "_r[{i}]", quoted(f.name)))
			open(em, "if err{i} != nil \{")
			line(em, "return " + goIdent(name) + "\{}, err{i}")
			close(em, "}")
			append(inits, goField(f.name) + ": f{i}")
			i = i + 1
		}
		line(em, "return " + goIdent(name) + "\{" + join(inits, ", ") + "}, nil")
		close(em, "}")
	}
}

// --- JSON codecs -------------------------------------------------------------
//
// A type declaration is the schema. A codec is generated from the declaration
// rather than read off a value at runtime, which is what makes the field names
// the ones that were *written*, a variant `\{"Name": \{...}}`, and a missing or
// misshapen field an error carrying the path it failed at.
//
// One codec per type, and only for a type the program really encodes or decodes.
// Writing one asks for the codecs of the types its fields mention, so this is a
// worklist rather than a walk over the declarations.

/// Ask for a codec. A name already asked for is not asked for twice.
proc needCodec(em: mut Emit, name: Str): void {
	if indexOf(em.codecs, name) is Result.Error(_) {
		append(em.codecs, name)
	}
}

/// Write every codec that was asked for, and every one those asked for in turn.
proc emitCodecs(em: mut Emit): void {
	emitCodecsFrom(em, 0)
}

/// The same, skipping the ones already written elsewhere — what a test file does
/// with the codecs `main.go` wrote, the two being one Go package.
proc emitCodecsFrom(em: mut Emit, from: Int): void {
	mut done := from
	for ; done < len(em.codecs); {
		at := done
		done = done + 1
		if em.codecs bounds at {
			emitCodec(em, em.codecs[at])
		}
	}
}

proc emitCodec(em: mut Emit, name: Str): void {
	if types.findType(em.table, name) is Result.Ok(info) {
		emitDecoder(em, name, info)
		emitEncoder(em, name, info)
	}
}

func decoderName(name: Str): Str {
	return "jsonDecode_" + goIdent(name)
}

func encoderName(name: Str): Str {
	return "jsonEncode_" + goIdent(name)
}

// --- Decoding ----------------------------------------------------------------

proc emitDecoder(em: mut Emit, name: Str, info: types.TypeInfo): void {
	whole := types.Ty.TNamed(name)
	blank(em)
	open(em, "func " + decoderName(name) + "(v hive.JsonValue, path string) (" + goType(whole) + ", *hive.JsonJsonError) \{")
	if len(info.variants) == 0 {
		zero := goZero(whole)
		line(em, "obj, jerr := hive.JsonObject(v, path)")
		bailOut(em, zero)
		decodeFields(em, info.shared, "path", zero)
		line(em, "return " + goIdent(name) + "\{" + fieldInits(info.shared) + "}, nil")
		close(em, "}")
		return
	}
	// A union arrives as one object with the variant's name for its only key. A
	// JSON null selects the first field-less variant, which is where the two
	// languages' ways of writing "nothing here" meet.
	fieldless := firstFieldless(info)
	if fieldless != "" && len(info.shared) == 0 {
		open(em, "if v.Kind == 'n' \{")
		line(em, "return " + goVariant(name, fieldless) + "\{}, nil")
		close(em, "}")
	}
	line(em, "key, inner, jerr := hive.JsonVariant(v, path)")
	bailOut(em, "nil")
	mut Str[dyn] names = []
	for each variant in info.variants {
		append(names, variant.name)
		here := "path+" + quoted("." + variant.name)
		open(em, "if key == " + quoted(variant.name) + " \{")
		line(em, "obj, jerr := hive.JsonObject(inner, " + here + ")")
		bailOut(em, "nil")
		fields := withShared(variant.fields, info.shared)
		decodeFields(em, fields, here, "nil")
		line(em, "return " + goVariant(name, variant.name) + "\{" + fieldInits(fields) + "}, nil")
		close(em, "}")
	}
	line(em, "return nil, &hive.JsonJsonError\{Path: path, Expected: " + quoted("one of " + join(names, ", ")) + ", Found: hive.JsonEncodeStr(key)}")
	close(em, "}")
}

// Every field a variant's value has: its own, and the ones declared outside
// every variant.
func withShared(own: ast.Field[], shared: ast.Field[]): ast.Field[dyn] {
	mut ast.Field[dyn] out = []
	for each f in own {
		append(out, f)
	}
	for each f in shared {
		append(out, f)
	}
	return out
}

func firstFieldless(info: types.TypeInfo): Str {
	for each v in info.variants {
		if len(v.fields) == 0 {
			return v.name
		}
	}
	return ""
}

proc bailOut(em: mut Emit, zero: Str): void {
	open(em, "if jerr != nil \{")
	line(em, "return " + zero + ", jerr")
	close(em, "}")
}

// One field at a time: look it up, then decode with the codec its declared type
// asks for. A JSON field the type does not declare is ignored; one the type
// declares and JSON has not got is the error.
proc decodeFields(em: mut Emit, fields: ast.Field[], path: Str, zero: Str): void {
	if len(fields) == 0 {
		// With no field to read, `obj` would be a local nothing uses, which Go
		// rejects.
		line(em, "_ = obj")
		return
	}
	for each f in fields {
		ty := types.resolve(em.table, f.declared)
		raw := "raw_" + goIdent(f.name)
		line(em, raw + ", jerr := hive.JsonField(obj, " + quoted(f.name) + ", " + path + ")")
		bailOut(em, zero)
		line(em, "f_" + goIdent(f.name) + ", jerr := " + decoderRef(em, ty) + "(" + raw + ", " + path + "+" + quoted("." + f.name) + ")")
		bailOut(em, zero)
	}
}

func fieldInits(fields: ast.Field[]): Str {
	mut Str[dyn] out = []
	for each f in fields {
		append(out, goField(f.name) + ": f_" + goIdent(f.name))
	}
	return join(out, ", ")
}

/// The decoder for a type, as a Go expression: a named one for a shape the
/// runtime already reads, the generated one for a declared type, and for a
/// vector a closure carrying its element decoder.
proc decoderRef(em: mut Emit, ty: types.Ty): Str {
	if ty is types.Ty.TStr { return "hive.JsonStr" }
	if ty is types.Ty.TInt { return "hive.JsonInt" }
	if ty is types.Ty.TFloat { return "hive.JsonFloat" }
	if ty is types.Ty.TBool { return "hive.JsonBool" }
	if ty is types.Ty.TAtom { return "hive.JsonAtom" }
	// A Table is a document flattened into `[path, value]` rows — the one shape
	// that reads a whole document without a type to read it into.
	if isTable(ty) { return "hive.JsonFlatten" }
	if ty is types.Ty.TNamed(name) {
		if types.findType(em.table, name) is Result.Ok(_) {
			needCodec(em, name)
			return decoderName(name)
		}
	}
	if ty is types.Ty.TVec(element, dim) {
		inner := decoderRef(em, element)
		mut call := "hive.JsonVec(v, p, " + inner + ")"
		if dim is ast.Dim.Fixed(n) {
			// A declared length is a promise, so a document that does not keep it
			// is an error rather than a shorter vector.
			call = "hive.JsonVecN(v, p, {n}, " + inner + ")"
		}
		return "func(v hive.JsonValue, p string) (" + goType(ty) + ", *hive.JsonJsonError) \{ return " + call + " }"
	}
	return "func(v hive.JsonValue, p string) (" + goType(ty) + ", *hive.JsonJsonError) \{ var zero " + goType(ty) + "; return zero, &hive.JsonJsonError\{Path: p, Expected: " + quoted("a type JSON can carry") + ", Found: " + quoted(types.show(ty)) + "} }"
}

func isTable(ty: types.Ty): Bool {
	if ty is types.Ty.TVec(row, outer) {
		if outer is ast.Dim.Dynamic {
			if row is types.Ty.TVec(cell, inner) {
				if inner is ast.Dim.Dynamic {
					return cell is types.Ty.TStr
				}
			}
		}
	}
	return false
}

// --- Encoding ----------------------------------------------------------------

proc emitEncoder(em: mut Emit, name: Str, info: types.TypeInfo): void {
	whole := types.Ty.TNamed(name)
	blank(em)
	open(em, "func " + encoderName(name) + "(x " + goType(whole) + ") string \{")
	if len(info.variants) == 0 {
		line(em, "return " + objectEncode(em, info.shared, "x"))
		close(em, "}")
		return
	}
	for each variant in info.variants {
		open(em, "if v, ok := x.(" + goVariant(name, variant.name) + "); ok \{")
		line(em, "_ = v")
		fields := withShared(variant.fields, info.shared)
		line(em, "return " + quoted("\{\"" + variant.name + "\":") + " + " + objectEncode(em, fields, "v") + " + " + quoted("}"))
		close(em, "}")
	}
	line(em, "return " + quoted("null"))
	close(em, "}")
}

// One object: every declared field, in declaration order, under the name it was
// declared with.
proc objectEncode(em: mut Emit, fields: ast.Field[], subject: Str): Str {
	if len(fields) == 0 {
		return quoted("\{}")
	}
	mut Str[dyn] out = []
	for each f in fields {
		ty := types.resolve(em.table, f.declared)
		out = appendPiece(out, quoted("\"" + f.name + "\":") + " + " + encodeOf(em, ty, subject + "." + goField(f.name), 0))
	}
	return quoted("\{") + " + " + join(out, " + " + quoted(",") + " + ") + " + " + quoted("}")
}

func appendPiece(out: Str[], piece: Str): Str[dyn] {
	mut Str[dyn] next = []
	for each o in out {
		append(next, o)
	}
	append(next, piece)
	return next
}

/// `value`, encoded as JSON, as a Go expression. `depth` names the closure
/// parameters a nested vector needs, so two levels never collide.
proc encodeOf(em: mut Emit, ty: types.Ty, value: Str, depth: Int): Str {
	if ty is types.Ty.TStr { return "hive.JsonEncodeStr(" + value + ")" }
	if ty is types.Ty.TInt { return "hive.JsonEncodeInt(" + value + ")" }
	if ty is types.Ty.TFloat { return "hive.JsonEncodeFloat(" + value + ")" }
	if ty is types.Ty.TBool { return "hive.JsonEncodeBool(" + value + ")" }
	if ty is types.Ty.TAtom { return "hive.JsonEncodeAtom(" + value + ")" }
	if isTable(ty) { return "hive.JsonEncodeTable(" + value + ")" }
	if ty is types.Ty.TNamed(name) {
		if types.findType(em.table, name) is Result.Ok(_) {
			needCodec(em, name)
			return encoderName(name) + "(" + value + ")"
		}
	}
	if ty is types.Ty.TVec(element, _) {
		item := "e{depth}"
		return "hive.JsonEncodeVec(" + value + ", func(" + item + " " + goType(element) + ") string \{ return " + encodeOf(em, element, item, depth + 1) + " })"
	}
	if ty is types.Ty.TMap(_, _) {
		fail(em, "a map does not encode: its keys are whatever was put in it, while everything else here is read from a declaration. `hive.map.toTable` is what a map travels as")
		return "\"null\""
	}
	// Anything with no static shape is encoded from what it turns out to be.
	return "hive.JsonEncodeDynamic(" + value + ")"
}

// --- The standard library ----------------------------------------------------

proc libraryCall(em: mut Emit, env: infer.Env, module: Str, name: Str, args: ast.Arg[], want: types.Ty): Str {
	if stdlib.isKnownModule(module) == false {
		fail(em, "this compiler does not carry `hive.{module}`")
		return "nil"
	}
	useModule(em, module)
	// Turning the terminal's echo off is a file of its own plus one per platform,
	// so a program that never asks for a secret carries none of them.
	if module == "term" && name == "readSecret" {
		useModule(em, "termsecret")
	}
	// `hive.map.new()` says empty and nothing about what it holds, so what it
	// builds is read off where it is landing.
	if module == "map" && name == "new" {
		if want is types.Ty.TMap(key, value) {
			return "hive.NewDict[" + goType(key) + ", " + goType(value) + "]()"
		}
		fail(em, "`hive.map.new()` has to land somewhere that says what it holds: a declaration, a return, or an argument to a parameter declared as a map")
		return "nil"
	}
	if module == "map" {
		return mapCall(em, env, name, args)
	}
	// A token's claims are a type of the program's own, so they are encoded by
	// the codec that type derives and *then* signed.
	if module == "crypto" && name == "jwtSign" {
		claims := argExpr(args, 0)
		return "hive.CryptoJwtSign(" + encodeOf(em, infer.typeOf(env, claims), expr(em, env, claims, types.Ty.TUnknown()), 0) + ", " + expr(em, env, argExpr(args, 1), types.Ty.TStr()) + ")"
	}
	// An event attribute takes a message, or a function of what the user did to
	// one. The runtime holds a message as an `any` — it never looks inside, only
	// hands it back to the fold — so a handler taking what the user did is
	// wrapped for its own return type to survive that.
	if module == "ui" {
		// A scene is a module of its own, because it is the one that carries a
		// download: what brings it into a build is exactly what needs it.
		if stdlib.isUiScene(name) {
			useModule(em, "uiscene")
		}
		if stdlib.isUiEvent(name) {
			return uiEvent(em, env, name, args)
		}
		// A window is a service with a page in front of it, spawned exactly as
		// `hive.syslink.spawn` spawns one: same handler shape, derived decoder
		// and digest. What the module adds is the render after each turn.
		if name == "window" {
			update := argExpr(args, 2)
			state := argExpr(args, 3)
			message := handlerMessage(em, update)
			return "hive.UiWindow(" + expr(em, env, argExpr(args, 0), types.Ty.TStr()) + ", "
				+ expr(em, env, argExpr(args, 1), types.Ty.TUnknown()) + ", "
				+ expr(em, env, update, types.Ty.TUnknown()) + ", "
				+ carried(em, env, state, infer.typeOf(env, state)) + ", hive.SyslinkDecoder(" + decoderRef(em, message) + "), "
				+ syslinkDigest(em, message) + ", " + boolLiteral(repliesInTurn(em, update)) + ")"
		}
	}
	// `spawn` installs the handler as the fold over the mailbox, and with it the
	// decoder for messages that arrive from another node, the digest that says
	// what they must be, and whether an unanswered request can be failed at once.
	if module == "syslink" {
		if name == "spawn" {
			handler := argExpr(args, 0)
			state := argExpr(args, 1)
			message := handlerMessage(em, handler)
			stateType := infer.typeOf(env, state)
			return "hive.SyslinkSpawn(" + expr(em, env, handler, types.Ty.TUnknown()) + ", "
				+ carried(em, env, state, stateType) + ", hive.SyslinkDecoder(" + decoderRef(em, message) + "), "
				+ syslinkDigest(em, message) + ", " + boolLiteral(repliesInTurn(em, handler)) + ")"
		}
		if name == "answer" {
			value := argExpr(args, 1)
			ty := infer.typeOf(env, value)
			return "hive.SyslinkAnswer(" + expr(em, env, argExpr(args, 0), types.Ty.TUnknown()) + ", "
				+ carried(em, env, value, ty) + ", " + syslinkEncoder(em, ty) + ")"
		}
		if name == "monitor" {
			message := argExpr(args, 2)
			ty := infer.typeOf(env, message)
			return "hive.SyslinkMonitor(" + expr(em, env, argExpr(args, 0), types.Ty.TUnknown()) + ", "
				+ expr(em, env, argExpr(args, 1), types.Ty.TUnknown()) + ", " + carried(em, env, message, ty) + ", "
				+ syslinkEncoder(em, ty) + ", " + syslinkDigest(em, ty) + ")"
		}
	}
	// A name that opens with a capital is one of the library's own types being
	// built rather than a call: `hive.net.HttpResponse(200, [], "ok")` is a
	// value, and the fields it lands in say what its arguments are.
	if len(stdlib.fieldsOf(module, name)) > 0 {
		return "hive." + text.capitalise(module) + name + "\{" + fieldArgs(em, env, stdlib.fieldsOf(module, name), args) + "}"
	}
	// Encoding is derived from the static type, so it cannot fail and needs no
	// reflection.
	if module == "json" && name == "encode" {
		value := argExpr(args, 0)
		return encodeOf(em, infer.typeOf(env, value), expr(em, env, value, types.Ty.TUnknown()), 0)
	}
	return "hive." + stdlib.goNameOf(module, name) + "(" + typedArgs(em, env, args, stdlib.paramsOf(module, name)) + ")"
}

// A library call's arguments, each written for the type its parameter declared.
// Beyond what the table says, an argument stands for itself.
proc typedArgs(em: mut Emit, env: infer.Env, args: ast.Arg[], params: types.Ty[]): Str {
	mut Str[dyn] out = []
	mut i := 0
	for each a in args {
		mut want := types.Ty.TUnknown()
		if params bounds i {
			want = params[i]
		}
		append(out, expr(em, env, a.value, want))
		i = i + 1
	}
	return join(out, ", ")
}

// A map is a value the language hands out rather than a module of functions, so
// most of `hive.map` is a method on it. The two writes take its address, since
// they change which keys it has.
proc mapCall(em: mut Emit, env: infer.Env, name: Str, args: ast.Arg[]): Str {
	subject := expr(em, env, argExpr(args, 0), types.Ty.TUnknown())
	rest := restArgs(em, env, args)
	if name == "set" || name == "delete" {
		return "(&" + subject + ")." + text.capitalise(name) + "(" + rest + ")"
	}
	if name == "get" || name == "has" || name == "keys" || name == "values" {
		return "(" + subject + ")." + text.capitalise(name) + "(" + rest + ")"
	}
	// These two are conversions rather than questions about a map, so they stay
	// ordinary functions.
	return "hive." + stdlib.goNameOf("map", name) + "(" + plainArgs(em, env, args) + ")"
}

// Every argument but the first, which is the subject a method is called on.
proc restArgs(em: mut Emit, env: infer.Env, args: ast.Arg[]): Str {
	mut Str[dyn] out = []
	mut i := 0
	for each a in args {
		if i > 0 {
			append(out, expr(em, env, a.value, types.Ty.TUnknown()))
		}
		i = i + 1
	}
	return join(out, ", ")
}

// --- Tests -------------------------------------------------------------------

/// The `main_test.go` for a program's tests, or `""` when it has none.
proc emitTests(m: ast.Module, atoms: Str[], codecs: Str[]): Str {
	t := types.tableOf(m)
	// The codecs `main.go` already wrote are seeded rather than written again:
	// the two files are one Go package.
	mut Emit em = Emit(t, [], 0, copiedNames(atoms), [], [], [], [], lentFuncs(t, m.decls), [], copiedNames(codecs), 0, [], [], [], [], [], true, false, -1, [], writes.writtenShapes(m), [], 0, [])
	written := len(codecs)
	mut found := false
	for each d in m.decls {
		if d is ast.Decl.TestDecl(_, _, _) {
			found = true
		}
	}
	if found == false {
		return ""
	}

	line(em, "package main")
	line(em, "")
	line(em, "import (")
	line(em, "\t\"testing\"")
	line(em, "")
	line(em, "\t\"hiveapp/hive\"")
	line(em, ")")
	blank(em)
	open(em, "func TestHive(t *testing.T) \{")
	line(em, "hive.InitAtoms(" + atomTable(em) + ")")
	env := infer.newEnv(t)
	for each d in m.decls {
		if d is ast.Decl.TestDecl(title, body, declaredOn) {
			em.line = declaredOn
			enterBody(em)
			open(em, "t.Run(" + quoted(title) + ", func(t *testing.T) \{")
			line(em, "defer hive.TestRecover(t)")
			emitTestStmts(em, env, body)
			close(em, "})")
		}
	}
	close(em, "}")
	// A codec only a test asked for is written here, beside the tests that
	// wanted it. A pattern only a test used is the same story.
	emitCodecsFrom(em, written)
	emitPatterns(em)
	return join(em.out, "\n") + "\n"
}

func copiedNames(names: Str[]): Str[dyn] {
	mut Str[dyn] out = []
	for each n in names {
		append(out, n)
	}
	return out
}

// A test's body is an ordinary proc body. The one difference — a failed
// assertion recorded rather than fatal — is carried by `inTest` rather than a
// walk of its own, so an `assert` means the same however deeply nested.
proc emitTestStmts(em: mut Emit, env: infer.Env, body: ast.Block): infer.Env {
	return emitStmts(em, env, body, types.Ty.TVoid())
}

// A failed comparison shows both sides. Each is bound to a temporary first, so
// the values reported are the ones the check computed and an operand with an
// effect runs exactly once.
proc emitTestAssert(em: mut Emit, env: infer.Env, condition: ast.Expr): void {
	if condition is ast.Expr.Binary(op, left, right) {
		if op is ast.BinOp.Eq || op is ast.BinOp.Neq {
			leftType := infer.typeOf(env, left)
			l := fresh(em, "l")
			r := fresh(em, "r")
			line(em, l + " := " + expr(em, env, left, leftType))
			line(em, r + " := " + expr(em, env, right, leftType))
			mut checked := equality(em, env, l, r, leftType)
			if op is ast.BinOp.Neq {
				checked = "!(" + checked + ")"
			}
			line(em, "hive.TestAssertCmp(t, " + checked + ", " + quoted(sourceOf(condition)) + ", hive.Show(" + l + "), hive.Show(" + r + "))")
			return
		}
	}
	line(em, "hive.TestAssert(t, " + expr(em, env, condition, types.Ty.TBool()) + ", " + quoted(sourceOf(condition)) + ")")
}

// What the assertion looked like, for the report: the condition as the compiler
// understood it rather than character for character what was typed — the more
// useful of the two when they differ.
func sourceOf(e: ast.Expr): Str {
	if e is ast.Expr.Binary(op, left, right) {
		return sourceOf(left) + " " + ast.opSpelling(op) + " " + sourceOf(right)
	}
	if e is ast.Expr.IntLit(v) { return "{v}" }
	if e is ast.Expr.StrLit(t) { return quoted(t) }
	if e is ast.Expr.BoolLit(v) { return "{v}" }
	if e is ast.Expr.Ident(name) { return name }
	if e is ast.Expr.Member(subject, field) { return sourceOf(subject) + "." + field }
	if e is ast.Expr.Index(subject, index) { return sourceOf(subject) + "[" + sourceOf(index) + "]" }
	if e is ast.Expr.Call(callee, args) {
		mut Str[dyn] out = []
		for each a in args {
			append(out, sourceOf(a.value))
		}
		return sourceOf(callee) + "(" + join(out, ", ") + ")"
	}
	if e is ast.Expr.IsMatch(subject, pattern) {
		return sourceOf(subject) + " is " + show.showPattern(pattern)
	}
	if e is ast.Expr.Negate(operand) { return "-" + sourceOf(operand) }
	if e is ast.Expr.FloatLit(v) { return "{v}" }
	if e is ast.Expr.AtomLit(atom) { return "#{atom}" }
	if e is ast.Expr.VectorLit(items) {
		mut Str[dyn] out = []
		for each item in items {
			append(out, sourceOf(item))
		}
		return "[" + join(out, ", ") + "]"
	}
	// A slice's bounds are `Absent` when not written, which is what makes `v[:2]`
	// and `v[2:]` read back as they were typed.
	if e is ast.Expr.Slice(subject, low, high) {
		return sourceOf(subject) + "[" + sourceOf(low) + ":" + sourceOf(high) + "]"
	}
	if e is ast.Expr.Interp(parts) {
		mut Str[dyn] out = []
		for each part in parts {
			if part is ast.InterpPart.Literal(t) {
				append(out, t)
			} else if part is ast.InterpPart.Expression(value) {
				append(out, "\{" + sourceOf(value) + "}")
			}
		}
		return quoted(join(out, ""))
	}
	if e is ast.Expr.Absent { return "" }
	return "..."
}
