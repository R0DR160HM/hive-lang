// Messages
// ========
// Every error the compiler reports about a program, one function per message, in the
// order the passes run: reading the source, checking it, lowering it, then the bounds
// pass and the laws. A message is only its text: the caller renders what it names
// (`types.show(ty)`, a count, a name) and hands it in, so this file imports nothing.
//
// Two of the prover's messages are also read back: `keeps.hive` recognises
// `proveClaimFalse` by its ": it is false" and every unproved claim by its leading
// "cannot prove ". Keep those two pieces of wording, or change `keeps.hive` with them.

// --- src/parser.hive -----------------------------------------------------------

// A token other than the one the grammar wants here; `what` names the one it wants.
func parseExpectedButFound(what: Str, found: Str): Str {
    return "expected {what} but found {found}"
}

// Names an identifier, in an "expected ... but found" message.
func wantedIdentifier(): Str {
    return "an identifier"
}

// Names an `import`'s path, in an "expected ... but found" message.
func wantedModulePathAfterImport(): Str {
    return "a module path after `import`"
}

// An import of the standard library names something inside a module.
func importStdlibNamesMember(path: Str): Str {
    return "`{path}` names more than a module. An import of the standard library is the module and nothing in it: `import hive.ui`, never `import hive.ui.View`"
}

// An import path whose last segment cannot be a module name, with no `as`.
func importNeedsOwnName(path: Str, last: Str): Str {
    return "`import {path}` needs a name of its own: `{last}` cannot be used as one — write `import {path} as <name>`"
}

// Something at the top level that does not start a declaration.
func parseExpectedDeclaration(found: Str): Str {
    return "expected a declaration — `type`, `proc`, `func`, `query`, `test` or `law` — but found {found}"
}

// A `{` in a query body that never closes.
func sqlBraceNeverCloses(): Str {
    return "this `\{` in the query body never closes"
}

// A WHERE block in a query holds something that is not an `if`, `or` or `and` block.
func sqlWhereBlockNotAnItem(): Str {
    return "a WHERE block holds `if`, `or` and `and` blocks, and this is none of them"
}

// An `if` in a query's WHERE block with no `{ ... }` after its condition.
func sqlIfHasNoBlock(): Str {
    return "this `if` in a WHERE block has no `\{ ... }` after its condition"
}

// An `if` in a query's WHERE block that never closes.
func sqlIfNeverCloses(): Str {
    return "this `if` in a WHERE block never closes"
}

// An `or` or `and` in a query's WHERE block with no `{ ... }` after it.
func sqlConnectiveHasNoBlock(word: Str): Str {
    return "this `{word}` in a WHERE block has no `\{ ... }` after it"
}

// A query's WHERE block holds a word other than `if`, `or` or `and`.
func sqlWhereBlockUnknownWord(word: Str): Str {
    return "a WHERE block holds `if`, `or` and `and` blocks, and `{word}` is none of them"
}

// Names the `}` that closes a type, in an "expected ... but found" message.
func wantedCloseType(): Str {
    return "`}` to close this type"
}

// A field annotated `JSON as` twice.
func markJsonTwice(): Str {
    return "this field says `JSON as` twice, and a field has one name on the wire"
}

// Names what a `JSON as` gives, in a field annotation message.
func markWhatJsonKey(): Str {
    return "JSON key"
}

// A field annotated `URL as` twice.
func markUrlTwice(): Str {
    return "this field says `URL as` twice, and a field has one name in a query string"
}

// Names what a `URL as` gives, in a field annotation message.
func markWhatQueryParameter(): Str {
    return "query parameter"
}

// A field annotated `Flag as` twice.
func markFlagTwice(): Str {
    return "this field says `Flag as` twice, and a field has one name on a command line"
}

// Names what a `Flag as` gives, in a field annotation message.
func markWhatFlag(): Str {
    return "flag"
}

// A `Flag as` whose two names are the same length.
func markFlagNamesSameLength(flag: Str, other: Str): Str {
    return "`Flag as {flag} {other};` gives two names of one length, and the shorter of the two is the one read after a single dash"
}

// A `Flag as` with more than two names.
func markFlagTooManyNames(): Str {
    return "`Flag as` takes two names at most: the flag's, and a shorter one read after a single dash"
}

// A `Flag as` name written with its dashes.
func markFlagWithDashes(): Str {
    return "`Flag as` names a flag without its dashes, since they are added wherever it is written"
}

// A field annotated `Default as` twice.
func markDefaultTwice(): Str {
    return "this field says `Default as` twice, and a field has one value to fall back to"
}

// A field annotation's name written as `""`.
func markNameEmpty(clause: Str, what: Str): Str {
    return "`{clause} as \"\"` names no field: a {what} is at least one character"
}

// Names the name an annotation gives, in an "expected ... but found" message.
func wantedMarkName(what: Str): Str {
    return "the {what} this field is written as, as a word or a quoted string"
}

// Names a `Default`, where a literal past `Int`'s largest is refused.
func wideWhereDefault(): Str {
    return "a `Default`"
}

// Names the number after a `Default`'s `-`, in an "expected ... but found" message.
func wantedNumberAfterMinus(): Str {
    return "a number after the `-`"
}

// Names a `Default`'s literal, in an "expected ... but found" message.
func wantedDefaultLiteral(): Str {
    return "a literal for this field to fall back to"
}

// A field annotation that is not `JSON`, `URL`, `Flag` or `Default`.
func markUnknown(found: Str): Str {
    return "a field's annotations are `JSON as <name>;`, `URL as <name>;`, `Flag as <name> <short name>;` — the short name may be left out — and `Default as <literal>;`, in any order, and {found} is none of them"
}

// Names the `}` that closes a variant, in an "expected ... but found" message.
func wantedCloseVariant(): Str {
    return "`}` to close this variant"
}

// A law declares a return type.
func lawHasReturnType(): Str {
    return "a law has no return type: it answers with nothing, and what it claims is the `assert`s in its body"
}

// A law's `for` is not followed by `table`.
func tableLawShape(name: Str): Str {
    return "a law about a table is written `law {name}(...) for table <name> \{ ... }`"
}

// Names the rest of a dotted table name, in an "expected ... but found" message.
func wantedTableNameRest(): Str {
    return "the rest of the table's name after `.`"
}

// Names a table law's table, in an "expected ... but found" message.
func wantedTableName(): Str {
    return "the name of the table after `for table`"
}

// A table law with other than one parameter.
func tableLawOneParam(name: Str, table: Str): Str {
    return "a law about a table is about the one value a query is run for, so it takes exactly one parameter: `law {name}(session: Session) for table {table} \{ ... }`"
}

// Names a table law's filter, in an "expected ... but found" message.
func wantedTableLawFilter(): Str {
    return "a `\{ ... }` filter after the table's name"
}

// A law inside a type that does not take exactly one value of that type.
func typeLawOneParam(typeName: Str, name: Str): Str {
    return "a law inside `{typeName}` is about one value of it, so it takes exactly one parameter, of type `{typeName}`: `law {name}(value: {typeName}) \{ ... }`"
}

// Names a query's SQL body, in an "expected ... but found" message.
func wantedQueryBody(): Str {
    return "a `\{ ... }` SQL body after the query's return type"
}

// A test's name holds an interpolation.
func testNameInterpolated(): Str {
    return "a test's name is prose, not a value: it is written once and read by whoever runs the suite, so there is nothing in scope for an interpolation to reach"
}

// Names a test's quoted name, in an "expected ... but found" message.
func wantedTestName(): Str {
    return "a name in quotes after `test`"
}

// Names what continues a parameter list, in an "expected ... but found" message.
func wantedParamListSeparator(): Str {
    return "`,` or `)` in a parameter list"
}

// A `func` type declares a `mut` parameter.
func funcTypeTakesMut(): Str {
    return "a `func` type cannot take a `mut` parameter: what a `func` promises is that it cannot write to storage its caller can see. Write `proc(mut ...)`"
}

// Names what continues a function type's parameters, in an "expected ... but found" message.
func wantedFnTypeSeparator(): Str {
    return "`,` or `)` in a function type"
}

// Names a type, in an "expected ... but found" message.
func wantedType(): Str {
    return "a type"
}

// Names the name after a `.` in a type, in an "expected ... but found" message.
func wantedTypeMemberName(): Str {
    return "a name after `.` in a type"
}

// Names what continues a type's arguments, in an "expected ... but found" message.
func wantedTypeArgsSeparator(): Str {
    return "`,` or `>` in a type's arguments"
}

// Names a vector's length, where a literal past `Int`'s largest is refused.
func wideWhereVectorLength(): Str {
    return "a vector's length"
}

// Names what goes inside a vector type's `[`, in an "expected ... but found" message.
func wantedVectorDim(): Str {
    return "`]`, `dyn` or a length in a vector type"
}

// Names a statement, in an "expected ... but found" message.
func wantedStatement(): Str {
    return "a statement"
}

// Names the `}` that closes a block, in an "expected ... but found" message.
func wantedCloseBlock(): Str {
    return "`}` to close this block"
}

// Appended when a pattern binding was likely meant as `r.field = value`.
func fieldAssignHint(path: Str): Str {
    return ". To assign to `{path}`, write `=`"
}

// A pattern on the left of `:=` with no `else`; `hint` is empty or the field-assignment hint.
func patternBindingNeedsElse(hint: Str): Str {
    return "a pattern on the left of `:=` binds only the values it takes, so it needs an `else` with an arm for every other one: `Result.Ok(v) := f() else \{ Result.Error(why) \{ return ... } }`{hint}"
}

// A pattern binding's `else` with no arms.
func bindingElseHasNoArms(): Str {
    return "this `else` has no arms, and it needs one for every value the pattern does not take — an arm of `_` takes anything"
}

// Names a pattern binding's `else`, in an arm's pattern-count message.
func armTesterElse(): Str {
    return "the `else`"
}

// Names the `}` that closes an `else`, in an "expected ... but found" message.
func wantedCloseElse(): Str {
    return "`}` to close this `else`"
}

// A `mut` followed by neither `name :=` nor `Type name =`.
func mutExpectsDeclaration(): Str {
    return "expected `name := value` or `Type name = value` after `mut`"
}

// A `mut` binding of an `async` call.
func mutAsyncCombined(): Str {
    return "`mut` and `async` cannot be combined: `x := async f()` names work that is still running, and the wait for it happens wherever the name is read — there is no storage of its own to assign to afterwards. Drop the `mut`, or wait for the call (`mut x := f()`) and reassign that."
}

// An `async` binding with `with timeout`.
func asyncBindingTimeout(): Str {
    return "`with timeout` cannot bound an `async` binding: the wait happens wherever the name is read, so there is no one moment for the bound to run from — two reads would get two different answers. Bound the wait itself instead: `r := f(x) with timeout 500`."
}

// An `async` in front of something that is not a call.
func asyncTakesCall(): Str {
    return "`async` takes a call — `async slowThing(x)` runs it on its own virtual thread and does not wait for it. There is nothing else to fire off: every other expression is already finished by the time it is written."
}

// Names a counting loop's post clause, in a loop clause message.
func loopClausePost(): Str {
    return "post"
}

// Names a counting loop's init clause, in a loop clause message.
func loopClauseInit(): Str {
    return "init"
}

// A counting loop's clause is an `async` statement.
func loopClauseAsync(clause: Str): Str {
    return "a loop's {clause} clause cannot be an `async` statement: it is there to set up and advance the condition, and work running on another thread has nothing to advance it with"
}

// A counting loop's clause binds with a pattern.
func loopClausePattern(clause: Str): Str {
    return "a loop's {clause} clause cannot bind with a pattern: what a pattern binds is for the rest of its block, and a clause has none. Bind it at the top of the loop's body"
}

// A counting loop's init clause is an `async` binding.
func loopInitAsyncBinding(): Str {
    return "an `async` binding cannot be a loop's init clause: the counter that clause sets up is advanced by the loop itself, and work running on another thread is not. Start it before the loop and read the name inside."
}

// A `switch` with `_` as a subject.
func switchOnUnderscore(): Str {
    return "a `switch` tests a value, and `_` is none: it is what an arm writes to take any value"
}

// Names a `switch`, in an arm's pattern-count message.
func armTesterSwitch(): Str {
    return "the `switch`"
}

// Names the `}` that closes a `switch`, in an "expected ... but found" message.
func wantedCloseSwitch(): Str {
    return "`}` to close this `switch`"
}

// An arm with fewer patterns than the `switch` or `else` has subjects.
func armShortOfPatterns(tester: Str, count: Str): Str {
    return "this arm is short of patterns: {tester} tests {count}, and an arm has one for each — `_` takes any value"
}

// An arm with more patterns than the `switch` or `else` has subjects.
func armTooManyPatterns(tester: Str, count: Str): Str {
    return "this arm has too many patterns: {tester} tests {count}, and an arm has one for each"
}

// An arm binds one name in two of its patterns.
func armBindsTwice(twice: Str): Str {
    return "this arm binds `{twice}` twice, and the two would take parts of different values. Give them different names"
}

// Counts a single subject, in an arm's pattern-count message.
func armOneValue(): Str {
    return "one value"
}

// Counts several subjects, in an arm's pattern-count message.
func armNValues(n: Int): Str {
    return "{n} values"
}

// Names what an arm may hold, in an "expected ... but found" message.
func wantedArmPosition(): Str {
    return "a pattern, a literal or `_`"
}

// Two different bitwise operators side by side without parentheses.
func bitwiseOperatorsMixed(first: Str, spelled: Str): Str {
    return "`{first}` and `{spelled}` sit side by side with nothing to say which goes first. Bitwise operators have no order among themselves, so write the parentheses: `(a {first} b) {spelled} c` or `a {first} (b {spelled} c)`"
}

// A bitwise operator beside arithmetic without parentheses.
func bitwiseBesideArithmetic(spelled: Str, arithmetic: Str): Str {
    return "`{spelled}` and `{arithmetic}` sit side by side with nothing to say which goes first. A bitwise operator has no order against arithmetic, so write the parentheses: `(a {arithmetic} b) {spelled} c` or `a {arithmetic} (b {spelled} c)`"
}

// The right of a `|>` is not a callable, a call or a constructor.
func pipeNeedsCall(): Str {
    return "`|>` pipes the value on its left in as the first argument of a call, so what stands on the right has to be one: a callable's name (`x |> f`), a call with the rest of its arguments written out (`x |> f(a)`), or a constructor (`x |> Shout.Loud`). Anything computed goes in parentheses on the left instead — `(a + b) |> f`"
}

// A `!` in front of an `is` match.
func matchNegated(): Str {
    return "a match cannot be negated: `is` narrows the value it matched and binds parts of it, and a `!` in front of that would leave those bindings with nothing to mean. Put the other case in the `else`, or match the variant you actually want"
}

// Names the `timeout` after `with`, in an "expected ... but found" message.
func wantedTimeoutAfterWith(): Str {
    return "`timeout` after `with`"
}

// An await-all given a second `with timeout`.
func awaitTimeoutTwice(): Str {
    return "this `await` already has a `with timeout` clause"
}

// A call given a second `with timeout`.
func callTimeoutTwice(): Str {
    return "this call already has a `with timeout` clause"
}

// A `with timeout` on something that does not wait.
func timeoutNeedsWait(): Str {
    return "`with timeout <ms>` bounds how long a wait may take, so it belongs on something that waits: a call (`f(x) with timeout 500`) or an await-all (`await [f(a), f(b)] with timeout 500`)"
}

// Names the member after a `.`, in an "expected ... but found" message.
func wantedMemberName(): Str {
    return "a name after `.`"
}

// Names what continues an argument list, in an "expected ... but found" message.
func wantedArgListSeparator(): Str {
    return "`,` or `)` in an argument list"
}

// An `async` inside a larger expression.
func asyncInExpression(): Str {
    return "`async` has no value of its own: it says how a call runs, not what it evaluates to, so it cannot sit inside a larger expression. Give it a name and read the name here — `x := async f(a)` starts the call now and waits at the first place `x` is read — or drop the `async` to wait for the result on the spot."
}

// A token that cannot start an expression.
func unexpectedInExpression(found: Str): Str {
    return "unexpected {found} in an expression"
}

// Names what continues a `<<<...>>>` literal, in an "expected ... but found" message.
func wantedBitsSeparator(): Str {
    return "`,` or `>>>` in `<<<...>>>`"
}

// Names what continues a vector literal, in an "expected ... but found" message.
func wantedVectorLitSeparator(): Str {
    return "`,` or `]` in a vector literal"
}

// An `await` not followed by a `[` list of calls.
func awaitNeedsList(found: Str): Str {
    return "`await` takes a list of calls to run all at once — `await [f(a), f(b)]` — but found {found}. One call on its own needs no `await`: calling it already blocks until it answers."
}

// An `await []` with no calls.
func awaitEmpty(): Str {
    return "`await []` waits for nothing at all. List the calls to run together: `await [f(a), f(b)]`."
}

// An entry of an `await` list that is not a call.
func awaitEntryNotCall(): Str {
    return "`await` runs each of its calls on its own virtual thread, so every entry has to be a call — this one is not. A value that is already in hand has nothing to wait for."
}

// Names what continues an `await` list, in an "expected ... but found" message.
func wantedAwaitListSeparator(): Str {
    return "`,` or `]` in an `await` list"
}

// A string being built holds a pattern's regex hole.
func holeInBuiltString(name: Str): Str {
    return "`\{{name} is (...)}` is a pattern's hole, not something a string can hold: it says what the text there has to look like, which only means anything on the right of an `is`. To put a `\{` in a string, write `\\\{`"
}

// Says an interpolated expression fails to lex, in the interpolation message.
func interpDoesNotLex(): Str {
    return "does not lex"
}

// Says an interpolated expression is not a single expression, in the interpolation message.
func interpNotOneExpression(): Str {
    return "is not one expression"
}

// A string's interpolated expression that cannot be read.
func interpolationProblem(source: Str, why: Str): Str {
    return "the interpolated expression `{source}` {why}"
}

// Names a pattern, where a literal past `Int`'s largest is refused.
func wideWherePattern(): Str {
    return "a pattern"
}

// Names the number after a pattern's `-`, in an "expected ... but found" message.
func wantedPatternNumberAfterMinus(): Str {
    return "a number after `-` in a pattern"
}

// A literal past `Int`'s largest where only a literal may go.
func wideLiteralNotAllowed(place: Str): Str {
    return "a literal past `Int`'s largest cannot be written in {place}: it is a `UInt64`, built where it is written, and only an expression has room for that"
}

// A pattern binds one name twice.
func patternBindsTwice(name: Str): Str {
    return "this pattern binds `{name}` twice, and the two would take different parts of the value. Give them different names"
}

// A string pattern holds a hole escaped into literal text.
func holeAsLiteralText(): Str {
    return "this pattern holds `\{name is (...)}` as literal text rather than as a hole, so it would match those characters and never match at all. A hole opens at a bare `\{`, and a `\\\{` asked for the brace itself"
}

// Names what continues a binary pattern, in an "expected ... but found" message.
func wantedBitsPatternSeparator(): Str {
    return "`,` or `>>>` in a binary pattern"
}

// A string pattern's `{...}` holds something other than a plain name.
func stringPatternHoleNotName(source: Str): Str {
    return "a string pattern's `\{{source}}` has to be a plain name to bind the text to — it is a hole, not an expression"
}

// Two holes without a regex sit side by side in a string pattern.
func holesSideBySide(name: Str): Str {
    return "two holes that take any text may not sit side by side in a string pattern: with no literal text between them there is nothing to say where one ends and the next begins. Give one of them a regex — `\{{name} is (...)}` — and it says where it ends itself"
}

// A regex hole's name is not a plain binding name.
func holeNameNotBinding(name: Str): Str {
    return "`\{{name} is (...)}` binds the text it matches to `{name}`, so `{name}` has to be a plain binding name — `camelCase`"
}

// A regex hole's regex is malformed; `why` is what the regex reader found.
func holeRegexProblem(name: Str, why: Str): Str {
    return "in the hole `\{{name} is (...)}`: {why}"
}

// Two holes in one string pattern bind the same name.
func holeBindsTwice(name: Str): Str {
    return "this pattern binds `{name}` twice, and the two holes would take different text. Give them different names"
}

// Names what continues a vector pattern, in an "expected ... but found" message.
func wantedVectorPatternSeparator(): Str {
    return "`,` or `]` in a vector pattern"
}

// Names a pattern, in an "expected ... but found" message.
func wantedPattern(): Str {
    return "a pattern"
}

// Names the name after a `.` in a pattern, in an "expected ... but found" message.
func wantedPatternMemberName(): Str {
    return "a name after `.` in a pattern"
}

// Names what continues a pattern's bindings, in an "expected ... but found" message.
func wantedPatternBindingsSeparator(): Str {
    return "`,` or `)` in a pattern's bindings"
}

// --- src/lexer.hive ------------------------------------------------------------

// The file opens with a byte-order mark or another character source cannot hold.
func lexFileOpensWithBom(one: Str): Str {
    return "the file opens with `{one}`, which Hive source cannot hold. If nothing shows between those quotes it is a byte-order mark: save the file as \"UTF-8\" rather than \"UTF-8 with BOM\""
}

// A character no token starts with.
func lexUnexpectedCharacter(one: Str): Str {
    return "unexpected character `{one}`"
}

// The reserved word `axiom` is written.
func lexAxiomReserved(): Str {
    return "`axiom` is reserved for a later version of Hive: nothing may be written with it yet"
}

// A number literal too large for an `Int` or a `Float`.
func lexNumberTooLarge(written: Str): Str {
    return "`{written}` is not a number this machine can hold"
}

// Names the base of a `0x` literal, in a bad-digit message.
func lexBaseHexadecimal(): Str {
    return "hexadecimal"
}

// Names the base of a `0b` literal, in a bad-digit message.
func lexBaseBinary(): Str {
    return "binary"
}

// A `0x` or `0b` literal holds a digit its base does not have.
func lexDigitNotInBase(written: Str, base: Str, c: Str): Str {
    return "`{written}` is not a {base} number: `{c}` is not one of its digits"
}

// A `0x` or `0b` with no digits after it.
func lexNoDigitsAfterMarker(written: Str, marker: Str): Str {
    return "`{written}` has no digits after its `{marker}`"
}

// A `0x` or `0b` literal wider than 64 bits.
func lexIntegerOver64Bits(written: Str): Str {
    return "`{written}` needs more than 64 bits, and no integer type in Hive has more"
}

// A `#` with no atom name after it.
func lexExpectedAtomName(): Str {
    return "expected an atom name after `#`"
}

// A `"..."` string that never closes.
func lexUnterminatedString(): Str {
    return "unterminated string literal"
}

// A hole's regex in a string pattern runs past the end of its line.
func lexHoleRegexRunsToLineEnd(): Str {
    return "this hole's regex is never closed — it runs to the end of the line"
}

// A hole's regex closes, and something other than `}` follows it.
func lexHoleGoesOnAfterRegex(name: Str): Str {
    return "this hole closes its regex and then goes on: a `\{{name} is (...)}` ends at the `}` right after the `)`"
}

// A hole's regex opens with `is (` and nothing closes it.
func lexHoleRegexNeverClosed(name: Str): Str {
    return "this hole's regex is never closed: `\{{name} is (` opens one and nothing closes it"
}

// A `\{` interpolation in a string that never closes.
func lexUnterminatedInterpolation(): Str {
    return "unterminated `\{` interpolation in a string"
}

// A backtick string that never closes.
func lexBacktickNeverCloses(): Str {
    return "this backtick string never closes"
}

// A `query`'s body that never closes.
func lexQueryBodyNeverCloses(): Str {
    return "this query body never closes"
}

// An `import` with no path after it.
func lexExpectedImportPath(): Str {
    return "expected a module path after `import`"
}

// An `import` path opens with a quote and never closes it.
func lexImportPathUnclosed(): Str {
    return "this `import` path opens with a quote and never closes it — add the closing `\"`"
}

// An `import ""` with nothing between the quotes.
func lexImportPathEmpty(): Str {
    return "`import \"\"` names no module: put the path between the quotes"
}

// --- src/naming.hive -----------------------------------------------------------

// A `proc`, `func` or `query` is not named in camelCase.
func namingCallable(name: Str, camel: Str): Str {
    return "`{name}` is not how a callable is named. A `proc`, a `func` and a `query` are written in camelCase, like the variable a call's result lands in: `{camel}`."
}

// A parameter is not named in camelCase.
func namingParameter(name: Str, camel: Str): Str {
    return "`{name}` is not how a parameter is named. A parameter is written in camelCase: `{camel}`."
}

// A field is not named in camelCase.
func namingField(name: Str, camel: Str): Str {
    return "`{name}` is not how a field is named. A field is written in camelCase: `{camel}`."
}

// A `mut` variable is named in UPPER_CASE, the shape of a constant.
func namingMutWrittenAsConstant(name: Str, camel: Str): Str {
    return "`{name}` is written as a constant, and `mut` says it is not one: UPPER_CASE is for a variable nothing reassigns. Write it in camelCase — `{camel}` — or drop the `mut` if it really does hold still."
}

// A `mut` variable or loop counter is not named in camelCase.
func namingMutVariable(name: Str, camel: Str): Str {
    return "`{name}` is not how a variable is named. A variable is written in camelCase: `{camel}`."
}

// A variable is named in neither camelCase nor UPPER_CASE.
func namingVariable(name: Str, camel: Str, screaming: Str): Str {
    return "`{name}` is not how a variable is named. A variable is written in camelCase — `{camel}` — or, when nothing reassigns it, in UPPER_CASE: `{screaming}`."
}

// A name a pattern or `for each` binds is not camelCase or `_`.
func namingBinding(name: Str, camel: Str): Str {
    return "`{name}` is not how a binding is named. A name a pattern or a `for each` binds is written in camelCase — `{camel}` — or `_` to throw the value away."
}

// A type is not named in PascalCase.
func namingTypeName(name: Str, pascal: Str): Str {
    return "`{name}` is not how a type is named. Every type is written in PascalCase, the ones the language declares (`Str`, `Result`) along with your own: `{pascal}`."
}

// A variant is not named in PascalCase.
func namingVariant(name: Str, pascal: Str): Str {
    return "`{name}` is not how a variant is named. A variant is written in PascalCase, like the type it belongs to: `{pascal}`."
}

// An atom is not written in PascalCase.
func namingAtom(name: Str, pascal: Str): Str {
    return "`#{name}` is not how an atom is written. An atom is written in PascalCase: `#{pascal}`."
}

// An import name or a qualifier segment is not camelCase.
func namingModule(name: Str, camel: Str): Str {
    return "`{name}` is not a name a module can be reached through. It is written in camelCase, like the variable it reads as at every use — `{camel}` — which an `import ... as {camel}` gives it."
}

// A name in a role with no message of its own.
func namingNotAName(name: Str): Str {
    return "`{name}` is not a name."
}

// A keyword written in other than lower case; the caller finishes the sentence.
func namingMiscasedKeyword(word: Str, lower: Str): Str {
    return "`{word}` is a keyword written the wrong way: every keyword in Hive is lower case, and only lower case. Write `{lower}`"
}

// --- src/regex.hive ------------------------------------------------------------

// A string pattern's hole has `is ()` with nothing in the regex.
func regexEmpty(): Str {
    return "this hole's regex is empty, so it matches nothing and binds nothing. A hole that takes any text is written `\{name}`, with no `is`"
}

// A hole's regex has a `)` with no `(` before it.
func regexUnopenedClose(): Str {
    return "this `)` closes a group that was never opened"
}

// A hole's regex has `*`, `+` or `?` with nothing before it to repeat.
func regexNothingToRepeat(c: Str): Str {
    return "this `{c}` has nothing before it to repeat"
}

// A hole's regex opens with a `\{n}` count that has nothing to apply to.
func regexCountNothingToRepeat(): Str {
    return "this `\{...}` has nothing before it to repeat"
}

// A hole's regex opens a group with `(` and never closes it.
func regexGroupNeverClosed(): Str {
    return "this `(` is never closed"
}

// A hole's regex uses lookahead, `(?=` or `(?!`.
func regexLookaround(next: Str): Str {
    return "lookaround (`(?{next}`) is not part of this regex syntax: a match here never backtracks, so how long it takes is a fact about the text's length and not about the pattern. Say it with the literal text around the hole instead"
}

// A hole's regex uses lookbehind, `(?<=` or `(?<!`.
func regexLookbehind(after: Str): Str {
    return "lookbehind (`(?<{after}`) is not part of this regex syntax: a match here never backtracks. Say it with the literal text before the hole instead"
}

// A hole's regex holds a named group, `(?<name>` or `(?P<name>`.
func regexNamedGroup(): Str {
    return "a named group is not written inside a hole — the hole's own name is what the text binds to. Write `(...)` for grouping alone"
}

// A hole's regex has `(?)` or `(?:` read as a flag setting with no flags.
func regexEmptyFlags(c: Str): Str {
    return "`(?{c}` says nothing: a `(?` opens a flag setting, a `(?:` a group that does not capture"
}

// A hole's regex sets a flag RE2 does not have.
func regexUnknownFlag(c: Str): Str {
    return "`{c}` is not one of the flags a regex takes — those are `i` (ignore case), `m` (multi-line), `s` (`.` matches a newline) and `U` (ungreedy)"
}

// A hole's regex opens a character class with `[` and never closes it.
func regexClassNeverClosed(): Str {
    return "this `[` is never closed"
}

// A hole's regex ends in a lone backslash.
func regexTrailingBackslash(): Str {
    return "this `\\` is the last character, so there is nothing for it to escape"
}

// A hole's regex holds a backreference like `\1`.
func regexBackreference(c: Str): Str {
    return "`\\{c}` is a backreference, and this regex syntax has none: a match here never backtracks. Repeat the pattern instead of pointing back at it"
}

// A hole's regex has a count `\{n,m}` whose high bound is below its low one.
func regexCountsDown(low: Str, high: Str): Str {
    return "`\{{low},{high}}` counts down: a repeat's high bound cannot be below its low one"
}

// A hole's regex puts `*` or `+` straight after another quantifier.
func regexRepeatsRepeat(c: Str): Str {
    return "this `{c}` repeats a repeat, which says nothing the first one did not"
}

// --- src/tables.hive -----------------------------------------------------------

// A query names a law's table in a statement of another kind than SELECT, INSERT, UPDATE or DELETE.
func sqlStatementSaysNothing(table: Str, keyword: Str): Str {
    return "it names `{table}` in a `{keyword}` statement, which says nothing about which of its rows it takes"
}

// Names what a query does to a table it reads from, in a missing-filter message.
func sqlVerbReads(): Str {
    return "reads"
}

// A query takes rows from a law's table inside parentheses in a FROM list.
func sqlParenthesesInFrom(table: Str): Str {
    return "it takes rows from `{table}` inside parentheses in a FROM list, which this reader does not follow"
}

// A query updates a law's table with no SET to be found.
func sqlUpdateWithoutSet(table: Str): Str {
    return "it updates `{table}` without a SET this reader can find"
}

// Names what a query does to a table it updates, in a missing-filter message.
func sqlVerbChanges(): Str {
    return "changes"
}

// An UPDATE sets several columns at once; why it cannot be held to a law.
func sqlSetsSeveralColumns(): Str {
    return "it sets several columns at once, `(a, b) = ...`"
}

// Names what a query does to a table it deletes from, in a missing-filter message.
func sqlVerbDeletesFrom(): Str {
    return "deletes from"
}

// An INSERT names no columns; why it cannot be held to a law.
func sqlInsertNamesNoColumns(): Str {
    return "it names no columns, so which value lands in which cannot be read"
}

// Names an INSERT fed by a SELECT, in the message about an unreadable insert.
func sqlInsertsSelect(): Str {
    return "inserts what a SELECT answers with"
}

// Names an INSERT of DEFAULT VALUES, in the message about an unreadable insert.
func sqlInsertsDefaults(): Str {
    return "inserts a row of defaults"
}

// An INSERT whose columns cannot be matched to values; why it cannot be held to a law.
func sqlInsertUnreadable(what: Str): Str {
    return "it {what}, so what lands in each column cannot be read"
}

// A table law's filter holds an `or { }` block.
func lawFilterHoldsOr(): Str {
    return "a law's filter cannot hold an `or \{ }` block, which says nothing about any one row\n    write the alternatives in its SQL: `a = \{x} OR b = \{x}`"
}

// A table law's filter mixes SQL with a `WHERE { }` block.
func lawFilterMixesSqlAndBlock(): Str {
    return "a law's filter is SQL, or one `WHERE \{ }` block's `if`s, and not both"
}

// A query cannot be read well enough to hold it to a table law.
func lawCannotHoldQuery(shownLaw: Str, why: Str): Str {
    return "cannot hold this query to law {shownLaw}: {why}"
}

// A query touches a law's table but takes no parameter of the law's type.
func lawQueryTakesNoLawParam(table: Str, shownLaw: Str, shownType: Str): Str {
    return "this query touches `{table}`, which law {shownLaw} filters by a `{shownType}`, so it has to take one"
}

// Names the filter a query's WHERE must carry, under the law's own `if`s.
func lawFilterUnderConditions(written: Str, conds: Str): Str {
    return "`{written}` wherever `{conds}` holds: `WHERE \{ if {conds} \{ {written} } }`"
}

// A query touches a law's table without the law's filter in its WHERE.
func lawQueryMissesFilter(verb: Str, table: Str, shownLaw: Str, filter: Str): Str {
    return "this query {verb} `{table}` without the filter law {shownLaw} keeps on it\n    its WHERE has to carry {filter}"
}

// An UPDATE sets a law's filtered columns to something outside the filter.
func lawUpdateMovesRow(table: Str, shownLaw: Str, columns: Str, written: Str): Str {
    return "this query moves a row of `{table}` out of law {shownLaw}'s filter: it sets {columns} to something the filter does not keep\n    the row has to stay inside `{written}`"
}

// An INSERT into a table whose law's filter is not `column = value`.
func lawInsertFilterNotEquality(table: Str, shownLaw: Str, written: Str): Str {
    return "this query inserts into `{table}`, and law {shownLaw}'s filter `{written}` is not `column = value`, so no row an insert writes can be held to it"
}

// An INSERT writes a row the law's filter does not keep.
func lawInsertOutsideFilter(table: Str, shownLaw: Str, wanted: Str): Str {
    return "this query inserts a row into `{table}` that law {shownLaw}'s filter does not keep\n    it has to write {wanted}"
}

// Names one column and the value an INSERT has to write to it, in a law message.
func lawColumnAsValue(column: Str, value: Str): Str {
    return "`{column}` as `{value}`"
}

// Offers several column-and-value choices, in a law message.
func lawOneOf(choices: Str): Str {
    return "one of {choices}"
}

// --- src/check.hive ------------------------------------------------------------

// A `hive.map.new()` lands nowhere that says what the map holds.
func mapNewNeedsLanding(): Str {
    return "`hive.map.new()` has to land somewhere that says what it holds: a declaration, a return, or an argument to a parameter declared as a map"
}

// Two tests share one title.
func testTitleTaken(): Str {
    return "another test is already called this. A title is how the report names a test, so two with one title would be reported as one — give each its own"
}

// Two test titles differ only by a space where the other has `_`.
func testTitleUnderscoreClash(other: Str): Str {
    return "the report writes a space in a title as `_`, so this and \"{other}\" would be reported as one test — give each its own title"
}

// A table law declares a `mut` parameter.
func lawTakesMut(name: Str): Str {
    return "a law cannot declare the `mut` parameter `{name}: mut ...`: a law only ever reads what it is given"
}

// A query or callable declares one parameter name twice.
func paramDeclaredTwice(name: Str): Str {
    return "this declares the parameter `{name}` twice"
}

// A query declares a `mut` parameter.
func queryTakesMut(name: Str): Str {
    return "a query cannot declare the `mut` parameter `{name}: mut ...`: its body is SQL, and there is nothing in one that could write through it"
}

// A query's row type is a tagged union.
func queryRowIsUnion(name: Str): Str {
    return "a query's rows are a struct, and `{name}` is a tagged union: a row is a fixed set of columns, and there is nothing in a result set to say which variant one of them is"
}

// A query's row type is not a declared type.
func queryRowNotDeclared(name: Str): Str {
    return "a query answers with rows of a declared type, and `{name}` is not one"
}

// A query answers with nested vectors that are not `Table`.
func queryRowsNestedNotTable(shown: Str): Str {
    return "a query answers with whole rows of text as a `Table`, `Str[dyn][dyn]`, and this is {shown}. A single column is a vector of one scalar: `Int[dyn]`"
}

// A query's declared result is none of the shapes a query can answer with.
func queryResultShape(shown: Str): Str {
    return "a query answers with `T[dyn]` for one row type, `Str[dyn]` (or another scalar) for a single column, `Table` for every column as text, or `void` for a statement — and this is {shown}"
}

// A query declaring a row type selects `*`.
func selectStarIntoRows(): Str {
    return "`SELECT *` cannot fill in rows of a declared type: it says neither how many columns come back nor what they are called, so nothing can line them up against the fields — and what it stands for changes the day somebody adds a column. Name them, with an alias where a column and a field are spelt differently: `SELECT id, u.name AS author`"
}

// A query binds a value that is not one cell.
func boundValueNotCell(shown: Str): Str {
    return "a bound value is one cell, and this is {shown}. A cell is a `Str`, an `Int`, a `Float`, a `Bool` or an `Atom`; anything else would have to be spliced into the text, which is the one thing a query never does"
}

// A type names `hive.<module>.<name>` and the module has no such type.
func libTypeMissing(module: Str, name: Str): Str {
    return "`hive.{module}` has no type `{name}`"
}

// `Address` is written without the type of its messages.
func addressNeedsMessageType(): Str {
    return "an address says what its service takes: `Address<M>`, with `M` the type of its messages"
}

// `Secret` is written without the type it holds.
func secretNeedsHeldType(): Str {
    return "a secret says what it holds: `Secret<T>`, with `T` the type of its value"
}

// Names a `Secret` as what cannot keep a type, in the unkeepable message.
func secretAsKeeper(): Str {
    return "a `Secret`"
}

// Says which part of a type cannot be kept, in the unkeepable message.
func keepWhichHolds(shown: Str): Str {
    return ", which holds {shown}"
}

// A `Secret` would hold a function, address, handle or another `Secret`.
func secretCannotKeep(what: Str, shown: Str, held: Str): Str {
    return "{what} cannot keep {shown}{held}: a `Secret` holds plain data — text, numbers, vectors, maps, results and declared types made of them — and not a function, an address, a library handle or another `Secret`"
}

// A type declares one field name twice.
func typeFieldTwice(name: Str): Str {
    return "this type declares `{name}` twice"
}

// A type declares one variant name twice.
func typeVariantTwice(name: Str): Str {
    return "this type declares the variant `{name}` twice"
}

// A variant declares a field the type already shares across every variant.
func variantFieldShadowsShared(variant: Str, field: Str): Str {
    return "the variant `{variant}` declares `{field}`, which the type already declares outside every variant — a shared field is added to each of them, so this one would be there twice"
}

// A struct holds itself by value with nothing in between that could end it.
func typeHoldsItself(name: Str): Str {
    return "`{name}` holds itself, field by field, with nothing in between that could end it, so a value of it could never be finished. Put the recursion through a vector — `children: {name}[dyn]` — or through a variant of a union, which can stop"
}

// A `decode` call does not pass exactly the text and the codec.
func decodeArgCount(what: Str, count: Str): Str {
    return "{what} reads a `Str` and the codec to read it with, and this call passes {count}"
}

// Names the text a `decode` reads, in a mismatch.
func decodeReadsWhat(what: Str): Str {
    return "what {what} reads"
}

// Names the whole value as what holds a `Table`, in the cannot-carry message.
func carriedThis(): Str {
    return "this"
}

// Names the field holding a `Table`, in the cannot-carry message.
func carriedTableField(typeName: Str, field: Str): Str {
    return "`{typeName}.{field}`"
}

// A codec is asked to carry a `Table`, a `Secret` or a map it has no JSON for.
func codecCannotCarry(what: Str, carried: Str, why: Str): Str {
    return "{what} cannot carry {carried}: {why}"
}

// A query string or command line is asked to carry a type with variants.
func flatHasVariants(carrier: Str, what: Str, name: Str): Str {
    return "{carrier} is one flat set of parameters, so {what} cannot carry `{name}`, which has variants"
}

// A query string or command line is asked to carry something that is not a declared type.
func flatNotDeclaredType(carrier: Str, what: Str, shown: Str): Str {
    return "{carrier} is a declared type's fields, so {what} cannot carry {shown}"
}

// A field of a type carried as a query string or command line is not a flat value.
func flatFieldNotValue(typeName: Str, field: Str, shown: Str, unit: Str): Str {
    return "`{typeName}.{field}` is {shown}, and a {unit} is a `Str`, `Int`, `Float`, `Bool` or `Atom`, or a vector of one repeated under its name"
}

// A codec's error type names no format.
func codecNamesNoFormat(shown: Str, errorTypes: Str): Str {
    return "`{shown}` names no format: a codec's error type is what says which, and it is one of {errorTypes}"
}

// What is passed as a codec is not one.
func codecWrongType(what: Str, shown: Str): Str {
    return "the codec {what} uses wants hive.codec.Codec<E> and this is {shown}"
}

// A field is called `decode`.
func fieldNamedDecode(): Str {
    return "`decode` is the name of the decoder every type derives, so a field cannot also be called that — `T.Variant.decode(text, codec)` would name both this field and the decoder. Any other name is free"
}

// A field's `Default` is a literal of another type.
func fallbackWrongType(name: Str, declared: Str, given: Str): Str {
    return "`{name}` is declared {declared} and falls back to {given}. A `Default` is the value the field takes where JSON has nothing, so it has to be a value the field can hold"
}

// Two fields answer to one JSON key.
func jsonKeyClash(key: Str): Str {
    return "two fields here are `{key}` in JSON, and one key cannot be read into two fields. Give one of them a `-- JSON as ...;` of its own"
}

// Two fields answer to one query-string parameter.
func urlKeyClash(key: Str): Str {
    return "two fields here are `{key}` in a query string, and one parameter cannot be read into two fields. Give one of them a `-- URL as ...;` of its own"
}

// Two fields answer to one long command-line flag.
func flagKeyClash(key: Str): Str {
    return "two fields here are `--{key}` on a command line, and one flag cannot be read into two fields. Give one of them a `-- Flag as ...;` of its own"
}

// Two fields answer to one short command-line flag.
func flagShortClash(short: Str): Str {
    return "two fields here are `-{short}` on a command line, and one flag cannot be read into two fields. Give one of them a short name of its own"
}

// `main` takes parameters or answers with something.
func mainSignature(): Str {
    return "`main` is where the program starts, so nothing calls it with arguments or reads what it answers: it is `proc main(): void`. The command line is `hive.term.args()`, and an exit status is `hive.term.exit(code)`"
}

// A `law` declares a `mut` parameter.
func lawParamTakesMut(name: Str): Str {
    return "a law cannot declare the `mut` parameter `{name}: mut ...`. A law's parameters take every value of their types, and nothing a law does is seen by anyone — take an ordinary `{name}: ...`"
}

// A `func` declares a `mut` parameter.
func funcTakesMut(name: Str): Str {
    return "a `func` cannot declare the `mut` parameter `{name}: mut ...`. What a `func` promises is that it cannot write to storage its caller can see, and a `mut` parameter is exactly that storage — make it a `proc`, or take an ordinary `{name}: ...` and answer with the new value"
}

// A callable ends in an else-less `if` chain that misses a value, so a path does not return.
func returnMissedAtEnd(name: Str, shown: Str, missed: Str): Str {
    return "`{name}` answers with {shown}, so every path through it has to return one, and no branch of the else-less `if` chain it ends with takes {missed}. Give that a branch of its own, or end the chain with an `else`"
}

// A non-`void` callable has a path that does not return.
func notEveryPathReturns(name: Str, shown: Str): Str {
    return "`{name}` answers with {shown}, so every path through it has to return one. A path terminates by ending in `return` or `panic`, in `hive.term.exit`, in an `if`/`else` or a `switch` whose every branch terminates, or in an else-less `if`/`else if` chain that covers its subject's whole type. An `assert` does not: one that holds carries on past it"
}

// One block declares a name twice.
func nameAlreadyDeclared(name: Str): Str {
    return "`{name}` is already declared in this block. Assign to it — `{name} = ...`, declaring it `mut` — or give the new value a name of its own"
}

// `x := hive.map.new()` with nothing later saying what the map holds.
func mapNewBindingNeedsLanding(name: Str): Str {
    return "`hive.map.new()` has to land somewhere that says what it holds: a declaration (`hive.map.Map<Str, Int> m = hive.map.new()`), a `return` whose callable declares a map, an argument to a parameter declared as one, or a later use of `{name}` that says it, such as `hive.map.set({name}, \"a\", 1)`. Nothing after this binding does"
}

// `x := at(...)` with nothing later saying what the service takes.
func atBindingNeedsLanding(name: Str): Str {
    return "`at` has to land somewhere that says what the service takes: a declaration (`Address<Op> counter = at(#Counter)`), a `return` whose callable declares an address, an argument to a parameter or field declared as one, or a later use of `{name}` that says it, such as a send: `{name}(Op.Ping())`. Nothing after this binding does"
}

// Names a typed declaration's value, in a mismatch.
func declarationOfWhat(name: Str): Str {
    return "the declaration of `{name}`"
}

// A binding with a pattern takes its value from a call that answers with nothing.
func bindingFromVoidCall(): Str {
    return "this binding takes its value from a call that answers with nothing, so there is nothing for its pattern to match"
}

// A `switch` tests a call that answers with nothing.
func switchOnVoidCall(): Str {
    return "this `switch` tests a call that answers with nothing, so there is nothing for its arms to match"
}

// An arm of a binding's `else` does not leave.
func elseArmCarriesOn(n: Int): Str {
    return "arm {n} of this `else` can carry on past its end, into the lines that run only once the pattern has matched. End it in `return`, `panic`, `break` or `continue`"
}

// An arm of a binding's `else` takes only values the pattern already takes.
func elseArmDeadByPattern(arm: Int): Str {
    return "arm {arm} of this `else` can never run: the pattern takes every value it would. Take it out"
}

// An arm of a binding's `else` takes only values the arms above it already take.
func elseArmDeadByArms(arm: Int): Str {
    return "arm {arm} of this `else` can never run: the arms above it take every value it would. Take it out, or move it above the arm that takes its values"
}

// A binding's `else` over numbers, atoms or strings does not end with `_`.
func elseCannotCover(): Str {
    return "the arms of this `else` cannot take every value the pattern leaves: no finite set of patterns covers a number, an atom or a string, so this `else` ends with `_`"
}

// A binding's `else` misses a value the pattern leaves.
func elseMissesValue(value: Str): Str {
    return "neither the pattern nor an arm of this `else` takes `{value}`. Give that an arm of its own, or end the `else` with `_`"
}

// A `switch` arm takes only values the arms above it already take.
func switchArmDead(n: Int): Str {
    return "arm {n} of this `switch` can never run: the arms above it take every value it would. Take it out, or move it above the arm that takes its values"
}

// A `switch` has no arms.
func switchNoArms(rest: Str): Str {
    return "this `switch` has no arms, and it has to take every value it tests — an arm of `{rest}` takes anything"
}

// A `switch` over numbers, atoms or strings does not end with a wildcard arm.
func switchCannotCover(rest: Str): Str {
    return "the arms of this `switch` cannot take every value it tests: no finite set of patterns covers a number, an atom or a string, so a `switch` over one ends with `{rest}`"
}

// A `switch` misses a value of what it tests.
func switchMissesValue(value: Str, rest: Str): Str {
    return "no arm of this `switch` takes `{value}`. Give that an arm of its own, or end the `switch` with `{rest}`"
}

// `r := Result.Ok(...)` with nothing later saying the other half.
func resultHalfUnsaid(said: Str, unsaid: Str, name: Str, example: Str): Str {
    return "`Result.{said}` says what an `{said}` holds and nothing about an `{unsaid}`, so `{name}` has to be told the rest: by a declaration that writes the whole type (`{example} {name} = Result.{said}(...)`), or by a later use of `{name}` that says it — handing it to a parameter or field declared as a `Result`, returning it, or comparing it with one. Nothing after this binding does"
}

// An `async` binding keeps a call that answers with nothing.
func asyncBindingOfVoid(name: Str): Str {
    return "an `async` binding keeps what a call answers with, and this call answers with nothing — so there is nothing for `{name}` to hold. Fire it off as a statement of its own, `async f(...)`, or put it in an await-all with the others it should finish beside"
}

// A binding keeps a call that answers with nothing.
func bindingOfVoid(name: Str): Str {
    return "this call answers with nothing, so there is nothing for `{name}` to hold. Make it a statement of its own"
}

// `for each` walks a map.
func forEachOverMap(): Str {
    return "a map is reached by key, never by position, so `for each` over one says nothing about what a turn is handed. Walk `hive.map.keys(m)` and look each one up"
}

// `for each` walks a `Str`.
func forEachOverStr(): Str {
    return "a `Str` is not a vector, so there is nothing for `for each` to walk. `split(s, \"\")` is its characters"
}

// Names the type written for a `for each` element, in a mismatch.
func forEachWrittenType(name: Str): Str {
    return "the type written for `{name}`"
}

// `break` or `continue` outside any loop.
func breakOutsideLoop(): Str {
    return "`break` and `continue` act on the innermost enclosing loop, and there is none here"
}

// Names `echo` as what shows a value, in the cannot-show message.
func echoShows(): Str {
    return "`echo`"
}

// Names `panic` as what shows a value, in the cannot-show message.
func panicShows(): Str {
    return "`panic`"
}

// A bare `return` in a callable that declares a result.
func returnsNothingButDeclared(shown: Str): Str {
    return "this `return` answers with nothing, and the declaration says {shown}"
}

// A test returns a value.
func testReturnsValue(): Str {
    return "a test returns nothing: it is run by the suite and never called, so there is nobody to answer. A bare `return` to leave early is fine"
}

// A `void` callable returns a value.
func returnValueInVoid(): Str {
    return "this `return` answers with a value, and the declaration says `void`"
}

// Names a `return`'s value, in a mismatch.
func returnWhat(): Str {
    return "this `return`"
}

// An assignment writes into a `Str` by position.
func strAssignedByPosition(): Str {
    return "a `Str` cannot be assigned into by position: it is a value rather than storage, and characters are not all the same width, so writing one would move every character after it. Build the new string instead — `s = s[:i - 1] + c + s[i + 1:]`"
}

// The left side of an assignment is not a name or a path into one.
func notAssignable(): Str {
    return "this is not something that can be assigned to: a target is a name, or a path into one through its fields and elements"
}

// An assignment to a name not declared `mut`.
func assignImmutable(root: Str): Str {
    return "cannot assign to `{root}`: it is immutable — declare it with `mut` to allow reassignment"
}

// An assignment to one field of a union value.
func unionFieldAssigned(): Str {
    return "a value of a union is taken apart with `is` and built whole, so one of its fields is not assigned on its own. Build the variant again with the new value"
}

// Names an assignment's value, in a mismatch.
func assignmentToWhat(root: Str): Str {
    return "the assignment to `{root}`"
}

// A condition is an atom.
func atomAsCondition(): Str {
    return "an atom is a label, not a yes or a no, so it cannot be a condition. Compare it with the one you mean — `if flag == #Ready` — or use a `Bool`"
}

// A condition is not a `Bool`.
func conditionNotBool(shown: Str): Str {
    return "a condition is a `Bool`, and this one is {shown}. There is no truthiness in Hive: say what you are comparing it to"
}

// `!` is applied to an atom.
func atomNegated(): Str {
    return "an atom is a label, not a yes or a no, so there is nothing about it for `!` to invert. Compare it with the one you mean — `flag != #Ready` — or use a `Bool`"
}

// `!` is applied to an integer.
func notOnInteger(shown: Str): Str {
    return "`!` inverts a `Bool`, and this is {shown}. To flip an integer's bits, `~`"
}

// `!` is applied to something that is neither a `Bool` nor an integer.
func notOnNonBool(shown: Str): Str {
    return "`!` inverts a `Bool`, and this is {shown}. There is no truthiness in Hive, so there is nothing here to be the opposite of: say what you are comparing it to"
}

// The parts of a `<<<...>>>` do not come to whole bytes.
func bitsNotWholeBytes(offset: Int, missing: Int): Str {
    return "the parts of this `<<<...>>>` come to {offset} bits, which is not a whole number of bytes. Add the {missing} bits that finish the last one"
}

// `little` is written on a run of bytes in `<<<...>>>`.
func littleOnByteRun(shown: Str): Str {
    return "`little` orders a number's bytes, and `{shown}` is a run of bytes, already in the order it is written"
}

// `little` is written on a part that is not whole bytes.
func littleNotWholeBytes(shown: Str, width: Int): Str {
    return "`little` orders a number's bytes, and `{shown}` is {width} bits, which is not a whole number of them"
}

// Names a run of bytes, in the off-a-byte message.
func bitsRunOfBytes(): Str {
    return "a run of bytes"
}

// Names a `little` number, in the off-a-byte message.
func bitsLittleNumber(): Str {
    return "a `little` number"
}

// A run of bytes or a `little` number in `<<<...>>>` does not start on a byte.
func bitsPartOffByte(shown: Str, into: Int, what: Str): Str {
    return "`{shown}` starts {into} bits into a byte, and {what} has to start on one. Fill the bits before it to a whole byte"
}

// A literal in `<<<...>>>` is given a type that is not an integer.
func bitsLiteralTypeNotInteger(n: Int, shown: Str): Str {
    return "`{n}: {shown}` says the literal is a {shown}, which is no integer type"
}

// A literal in `<<<...>>>` does not fit the type written for it.
func bitsLiteralDoesNotFit(n: Int, shown: Str): Str {
    return "`{n}` does not fit {shown}"
}

// A non-literal part of `<<<...>>>` has a width written for it.
func bitsWidthOnlyOnLiteral(shown: Str, path: Str): Str {
    return "only a literal says its width in `<<<...>>>`: a value has a type of its own, and a different width is a conversion — `{shown}({path})`"
}

// An untyped literal in `<<<...>>>` does not fit one byte.
func bitsLiteralNotByte(n: Int): Str {
    return "a literal in `<<<...>>>` is one byte unless it says otherwise, and {n} does not fit one. Say its type — `{n}: Int16`"
}

// A part of `<<<...>>>` is not an integer, bytes or a `Str`.
func bitsPartWrongType(path: Str, shown: Str): Str {
    return "a part of `<<<...>>>` is an integer, a `UInt8[]` or a `Str`, and `{path}` is {shown}"
}

// A vector pattern is used outside an `if` condition.
func vectorPatternOutsideIf(): Str {
    return "a vector pattern outside an `if` condition binds nothing, so it has no value to give"
}

// Unary `-` on an unsigned number.
func negateUnsigned(shown: Str): Str {
    return "unary `-` negates a signed number, and {shown} is unsigned: it has no negative values to answer with"
}

// Unary `-` on something that is not a number.
func negateNotNumber(shown: Str): Str {
    return "unary `-` negates an `Int` or a `Float`, and this is {shown}"
}

// Names the milliseconds of `with timeout`, in a mismatch.
func timeoutMillisWhat(): Str {
    return "the milliseconds `with timeout` waits"
}

// `with timeout` waits on a call that answers with nothing.
func timeoutOnVoidCall(): Str {
    return "`with timeout` answers with a `Result` of what the call answers, and this call answers with nothing, so there is no value to wait for. Fire it off with `async`, or have it answer with something"
}

// Points a `Bool` at `!`, appended to the `~` message.
func bitNotBoolHint(): Str {
    return ". For a `Bool`, `!`"
}

// `~` on something that is not an integer.
func bitNotNotInteger(shown: Str, instead: Str): Str {
    return "`~` flips an integer's bits, and this is {shown}{instead}"
}

// Names an interpolation as what shows a value, in the cannot-show message.
func interpolationShows(): Str {
    return "an interpolation"
}

// `echo`, `panic` or an interpolation shows a `Secret`.
func secretShown(what: Str, shown: Str): Str {
    return "{what} cannot show {shown}: only `reveal` opens a `Secret`"
}

// `echo`, `panic` or an interpolation shows a value holding a `Secret`.
func secretHeldShown(what: Str, shown: Str): Str {
    return "{what} cannot show {shown}, which holds a `Secret`: only `reveal` opens one"
}

// A map is subscripted.
func mapByPosition(): Str {
    return "a map is reached by key, never by position: `hive.map.get(m, key)` is what this wants"
}

// `hive` is used as a value.
func hiveNotValue(): Str {
    return "`hive` is the standard library, and it is not a value: what it has is reached through it, as `hive.<module>.<name>`"
}

// A law is named as a value.
func lawNotValue(name: Str): Str {
    return "`{name}` is a law, and a law is not a value: it is proved while the program compiles, and nothing ever runs it"
}

// A type is named as a value.
func typeNotValue(name: Str): Str {
    return "`{name}` is a type, and a type is not a value"
}

// A builtin is named as a value.
func builtinNotValue(name: Str): Str {
    return "`{name}` is a builtin, so it cannot be used as a value: several builtins are overloaded, and which one a reference means is decided by the argument types a value does not carry. Call it, or wrap it in a `func` of your own — `func lengthOf(s: Str): Int \{ return hive.len(s) }`"
}

// A name nothing declared.
func nameNotDeclared(name: Str): Str {
    return "`{name}` is not a name anything here declared"
}

// `hive.<builtin>` is named as a value.
func hiveBuiltinNotValue(field: Str): Str {
    return "`hive.{field}` is a builtin, so it cannot be used as a value: several builtins are overloaded, and which one a reference means is decided by the argument types a value does not carry. Call it, or wrap it in a `func` of your own"
}

// `hive.<module>` is named as a value.
func hiveModuleNotValue(field: Str): Str {
    return "`hive.{field}` is a module, and a module is not a value: what it has is reached through it, as `hive.{field}.<name>`"
}

// `hive.<module>` names a module this compiler does not have.
func compilerLacksModule(module: Str): Str {
    return "this compiler does not carry `hive.{module}`"
}

// `Result.Ok` or `Result.Error` is named without being built.
func resultVariantNotValue(field: Str): Str {
    return "`Result.{field}` is a variant of `Result`, and a variant is a value only once it is built: `Result.{field}(...)` builds one. Nor is a constructor a bare reference — `Result.{field}(_)` is the spelling that is a function value"
}

// `Result.<name>` names neither `Ok` nor `Error`.
func resultNoSuchVariant(field: Str): Str {
    return "`Result` has two variants, `Ok` and `Error`, and `{field}` is neither"
}

// A library type is named as a value.
func libTypeNotValue(module: Str, field: Str): Str {
    return "`hive.{module}.{field}` is a type, and a type is not a value"
}

// A field is read that the type does not have.
func noSuchField(shown: Str, field: Str, after: Str): Str {
    return "`{shown}` has no field `{field}`{after}"
}

// `hive.<module>.<name>` names nothing the module has.
func libHasNoName(module: Str, name: Str): Str {
    return "`hive.{module}` has no `{name}`"
}

// A library call is named as a value.
func libCallNotValue(module: Str, name: Str): Str {
    return "`hive.{module}.{name}` is a library call, and a library call cannot be used as a value. Wrap it in a `func` of your own, and use that"
}

// A variant that carries nothing is named without being called.
func variantNotBuilt(shown: Str, field: Str): Str {
    return "`{shown}.{field}` is a variant of `{shown}`, and a variant is a value only once it is built: write `{shown}.{field}()`. One that carries nothing is still built by calling it"
}

// A library type's variant that does not exist.
func libNoVariant(shown: Str, field: Str, variants: Str): Str {
    return "`{shown}` has no variant `{field}`. Its variants are {variants}"
}

// A member of a library type that does not exist.
func libNoMember(shown: Str, field: Str): Str {
    return "`{shown}` has no `{field}`"
}

// A program's own name hides a library module, appended to the no-field message.
func moduleShadowed(name: Str): Str {
    return ": this `{name}` is the program's own, and the library module is `hive.{name}`"
}

// A field declared in several variants is read off the union value.
func fieldInSeveralVariants(field: Str, shown: Str): Str {
    return "`{field}` is declared inside the variants of `{shown}` rather than outside them, so a `{shown}` value has it only once `is` says which variant it is. A field every variant carries is declared once, outside any variant, and then read straight off the value"
}

// A field of one variant is read off the union value.
func fieldInOneVariant(field: Str, owner: Str, shown: Str): Str {
    return "`{field}` belongs to the variant `{owner}` rather than to every `{shown}`, so it is read through the pattern that says which variant this is: `if value is {shown}.{owner}(...)`"
}

// A variant that carries fields is named without being built.
func variantConstructorNotValue(shown: Str, field: Str): Str {
    return "`{shown}.{field}` is a variant of `{shown}`, and a variant is a value only once it is built: `{shown}.{field}(...)` builds one. Nor is a constructor a bare reference — `{shown}.{field}(_)` is the spelling that is a function value"
}

// A type is asked for a variant it does not have.
func noSuchVariant(shown: Str, field: Str): Str {
    return "`{shown}` has no variant `{field}`"
}

// `&&` or `||` joins something that is not a `Bool`.
func boolOpNotBools(op: Str, left: Str, right: Str): Str {
    return "`{op}` joins two `Bool`s, and these are {left} and {right}"
}

// An operator's two sides are of different types.
func operandsMixed(op: Str, left: Str, right: Str, why: Str): Str {
    return "`{op}` wants two of one type, and these are {left} and {right}{why}"
}

// Writes an operator or a name in backticks, for a message that names it.
func backticked(name: Str): Str {
    return "`{name}`"
}

// `==` or `!=` compares function values.
func functionsHaveNoEquality(spelled: Str): Str {
    return "{spelled} compares two values, and a function value has no equality to compare — two that do the same thing cannot be told from two that do not. Compare what they answer with instead"
}

// An ordering operator on something that is not a number or a `Str`.
func orderingWrongType(spelled: Str, shown: Str): Str {
    return "{spelled} orders an `Int`, a `Float` or a `Str`, and these are {shown}. `sort` with a comparator of your own is how anything else is put in order"
}

// `+` on something that is not a number, a `Str` or a vector.
func plusWrongType(shown: Str): Str {
    return "`+` adds two numbers, joins two `Str`s or joins two vectors, and these are {shown}"
}

// A bitwise operator on something that is not an integer.
func bitwiseNotInteger(spelled: Str, shown: Str, instead: Str): Str {
    return "{spelled} works on an integer's bits, and these are {shown}{instead}"
}

// An arithmetic operator on something that is not a number.
func arithmeticNotNumber(spelled: Str, shown: Str): Str {
    return "{spelled} is arithmetic, on an `Int` or a `Float`, and these are {shown}"
}

// Points `&` on two `Bool`s at `&&`, appended to the bitwise message.
func boolAndInstead(): Str {
    return ". For two `Bool`s, `&&`"
}

// Points `|` on two `Bool`s at `||`, appended to the bitwise message.
func boolOrInstead(): Str {
    return ". For two `Bool`s, `||`"
}

// Points `^` on two `Bool`s at `!=`, appended to the bitwise message.
func boolXorInstead(): Str {
    return ". For two `Bool`s, `!=` is exclusive or"
}

// A shift on something that is not an integer.
func shiftNotInteger(spelled: Str, shown: Str): Str {
    return "{spelled} shifts an integer's bits, and this is {shown}"
}

// A shift by a negative literal.
func shiftNegative(spelled: Str, n: Int): Str {
    return "{spelled} shifts by a number of bits, and {n} is negative"
}

// A shift by a count that is neither unsigned nor a literal.
func shiftCountSigned(spelled: Str, shown: Str, op: Str): Str {
    return "the count {spelled} shifts by has to be unsigned or a literal, so it can never be negative, and this is {shown}. Convert it — `x {op} UInt8(n)`"
}

// Names a function value being called, in an argument message.
func functionValueShown(): Str {
    return "this function value"
}

// A send passes other than one message.
func sendArgCount(count: Str): Str {
    return "a send carries one message, and this passes {count}"
}

// A message is sent straight to what `at` answers.
func sendToBareAt(): Str {
    return "`at` says where a service is and nothing about what it takes, so a message cannot be sent straight to what it answers with. Land it somewhere that says: `Address<Op> counter = at(#Counter)`"
}

// Names the message of a send, in a mismatch.
func messageSentTo(shown: Str): Str {
    return "the message sent to an `{shown}`"
}

// Names a message to a service, in the cannot-carry message.
func messageToService(): Str {
    return "a message to a service"
}

// Code outside a law calls a law.
func lawCalledOutsideLaw(name: Str): Str {
    return "`{name}` is a law, and only another law may call one. A law is never run: it is proved while the program compiles, so there is nothing for code to call"
}

// A tagged union's name is called like a struct's.
func unionCalled(name: Str): Str {
    return "`{name}` is a tagged union, so a value of it is built by naming the variant: `{name}.SomeVariant(...)`"
}

// A call through a local binding that holds no callable.
func callThroughNonCallable(name: Str, shown: Str): Str {
    return "`{name}` here is {shown}, which is not something a call can reach through. A local binding shadows a declaration of the same name, so the `{name}` this calls is the one bound above it rather than any callable"
}

// `Result.Ok` or `Result.Error` passes other than one payload.
func resultPayloadCount(field: Str, count: Str): Str {
    return "`Result.{field}` carries exactly one payload, and this call passes {count}"
}

// Names a type's decoder, as what a `decode` call is.
func decoderShown(shown: Str): Str {
    return "`{shown}.decode`"
}

// A conversion type is asked for a member other than `checked`.
func conversionMemberNotCall(head: Str, field: Str): Str {
    return "`{head}.{field}` is not a call: an integer type `T` has `T.checked(x)`, which answers `Error(x)` where `x` does not fit, and a float type has only `T(x)`"
}

// A variant of `JsonValue` is decoded on its own.
func jsonValueVariantDecode(shown: Str): Str {
    return "a document says for itself which variant of `{shown}` it is, so it is read whole: `{shown}.decode(text, codec)`"
}

// Names one variant's decoder, as what a `decode` call is.
func variantDecoderShown(shown: Str, variant: Str): Str {
    return "`{shown}.{variant}.decode`"
}

// `T.Variant.decode` names a variant the type does not have.
func noVariantToDecode(shown: Str, variant: Str, variants: Str): Str {
    return "`{shown}` has no variant `{variant}`, so there is no `{variant}.decode` to call. Its variants are {variants}"
}

// A function value is called with a different number of arguments than it takes.
func valueArgCount(shown: Str, takes: Str, passes: Str): Str {
    return "{shown} takes {takes}, and this call passes {passes}"
}

// A function value is called with a named argument.
func functionValueArgNamed(shown: Str, name: Str): Str {
    return "{shown} is a function value, whose parameters have no names, so `{name}` has to be passed by position"
}

// Names a parameter by its position, in a `mut` argument message.
func parameterNumber(n: Int): Str {
    return "parameter {n}"
}

// Names an argument by its position, in a mismatch.
func argumentOf(n: Int, shown: Str): Str {
    return "argument {n} of {shown}"
}

// A partial application fills a `mut` parameter.
func partialLendsMut(shown: Str, param: Str): Str {
    return "{shown} writes through {param}, and a partial application captures what it is given by value, so the writes would land in a copy nobody sees. Leave it a hole, `_`, and hand the storage over where the result is called"
}

// A `mut` parameter is handed something that is not `mut` storage.
func mutArgNotMutable(shown: Str, param: Str): Str {
    return "{shown} writes through {param}, so the argument has to be a `mut` variable or a path into one — this one is not"
}

// One call lends a path and something inside it.
func lentApart(shown: Str, outer: Str, inner: Str): Str {
    return "{shown} is lent `{outer}` and `{inner}`, which is inside it. Through `{outer}` the call may grow or replace the vector `{inner}` is in, and the write to it would land in storage nothing holds any more. Lend `{outer}` alone and reach the element through it"
}

// Names the notice `hive.syslink.monitor` posts, in a mismatch with the watcher's messages.
func monitorNoticeToWatcher(): Str {
    return "the notice `hive.syslink.monitor` posts to the watcher"
}

// Names the notice `hive.syslink.monitor` posts, in the cannot-carry message.
func monitorNotice(): Str {
    return "the notice `hive.syslink.monitor` posts"
}

// A library call that writes into an argument is handed something not `mut`.
func libWritesIntoImmutable(module: Str, name: Str, param: Str): Str {
    return "`hive.{module}.{name}` writes into the `{param}` it is handed, so that has to be `mut` — this one is not"
}

// Names the key a `hive.map` call is handed, in a mismatch.
func mapKeyWhat(name: Str): Str {
    return "the key `hive.map.{name}` is handed"
}

// Names the value a `hive.map` call puts in, in a mismatch.
func mapValueWhat(name: Str): Str {
    return "the value `hive.map.{name}` puts in"
}

// A declared or library callable is called with a different number of arguments than it takes.
func callArgCount(name: Str, takes: Str, passes: Str): Str {
    return "`{name}` takes {takes}, and this call passes {passes}"
}

// Names an argument by its position, in a library-call mismatch.
func nthArgument(nth: Str): Str {
    return "the {nth} argument"
}

// Names an argument by its name, in a library-call mismatch.
func namedArgument(name: Str): Str {
    return "the argument `{name}`"
}

// Names an argument of a library call, in a mismatch.
func argumentOfLibrary(which: Str, module: Str, name: Str): Str {
    return "{which} of `hive.{module}.{name}`"
}

// `spawn` is called with other than two or three arguments.
func spawnArgCount(count: Str): Str {
    return "`spawn` takes a handler, the state it starts with and, optionally, the name to register it under — and this call passes {count}"
}

// Names the state `spawn` starts a service with, in a mismatch.
func spawnStateWhat(): Str {
    return "the state `spawn` starts the service with"
}

// Names the name `spawn` registers a service under, in a mismatch.
func spawnNameWhat(): Str {
    return "the name `spawn` registers the service under"
}

// Names the name `at` reaches, in a mismatch.
func atNameWhat(): Str {
    return "the name `at` reaches"
}

// Names the endpoint `at` reaches, in a mismatch.
func atEndpointWhat(): Str {
    return "the endpoint of the node `at` reaches"
}

// `at` is called with other than one or two arguments.
func atArgCount(count: Str): Str {
    return "`at` takes the name a service is registered under, or the endpoint of the node it is on and that name — and this call passes {count}"
}

// The shapes a handler may have, in the handler messages.
func handlerShape(): Str {
    return "`proc(mut S, M): M`, or `proc(mut S, M, Address<M>): M` to be handed its own address"
}

// A handler takes other than two or three parameters.
func handlerParamCount(starts: Str, shape: Str, n: Int): Str {
    return "{starts} wants a handler of the shape {shape}, and this one has {n} parameters"
}

// A handler's state parameter is not `mut`.
func handlerStateNotMut(shown: Str, starts: Str): Str {
    return "a handler writes its state in place, so its first parameter is `mut`: `state: mut {shown}`, which is what {starts} hands it"
}

// A handler's message parameter is `mut`.
func handlerMessageMut(): Str {
    return "a handler is handed its message, never lent it, so its second parameter cannot be `mut`"
}

// A handler returns something other than its message type.
func handlerReturnsOther(message: Str, result: Str): Str {
    return "a handler answers with one of its own messages, so it returns {message}, and this one returns {result}"
}

// A handler's third parameter is not its own address.
func handlerThirdParam(own: Str, shown: Str): Str {
    return "a handler with a third parameter is handed its own address there, an `{own}`, and this one takes {shown}"
}

// What starts a service is handed something that is not a handler.
func notHandler(starts: Str, shape: Str, shown: Str): Str {
    return "{starts} starts a service from a handler, {shape}, and this is {shown}"
}

// Names the view a window draws its state with, in a mismatch.
func windowViewWhat(name: Str): Str {
    return "the view `hive.ui.{name}` draws the state with"
}

// `hive.sql.run` is called without its query.
func sqlRunNeedsQuery(): Str {
    return "`hive.sql.run` takes a connection and the query to run, and this names only one of the two"
}

// `hive.sql.run` is handed something that is not a query's fragment.
func sqlRunNotFragment(shown: Str): Str {
    return "the second argument of `hive.sql.run` is a `hive.sql.Fragment` — what calling a `query` declaration answers with — and this is {shown}"
}

// Explains an `Int` beside a `Float`, appended to the mixed-operands message.
func mixedIntFloat(): Str {
    return ". Hive never widens a number behind your back — `hive.conv.itf` is how an `Int` becomes a `Float`"
}

// Explains two numbers of different sizes, appended to the mixed-operands message.
func mixedNumbers(shown: Str): Str {
    return ". Hive never widens a number behind your back — convert one side to the other's type: `{shown}(x)`"
}

// Names a `mut` parameter, in a `mut` argument message.
func mutParamShown(name: Str): Str {
    return "`{name}: mut ...`"
}

// Names an argument of a declared callable, in a mismatch.
func namedArgumentOf(param: Str, name: Str): Str {
    return "the argument `{param}` of `{name}`"
}

// A builtin or library call is partially applied.
func holesRefused(shown: Str): Str {
    return "{shown} cannot be partially applied: a `_` makes a function value, and a builtin or a library call cannot become one. Wrap it in a `func` of your own, and partially apply that"
}

// A struct is built with a different number of fields than it has.
func fieldArgCount(name: Str, has: Str, passes: Str): Str {
    return "`{name}` has {has}, and this call passes {passes}"
}

// Names a field of a struct being built, in a mismatch.
func fieldOfWhat(field: Str, name: Str): Str {
    return "the field `{field}` of `{name}`"
}

// A call names an argument the callee has no parameter for.
func noParamCalled(name: Str, arg: Str, list: Str): Str {
    return "`{name}` has no parameter called `{arg}`{list}"
}

// A call names one argument twice.
func argNamedTwice(name: Str): Str {
    return "this call names `{name}` twice"
}

// A call with named arguments does not cover every parameter.
func namedArgsIncomplete(name: Str, count: Str): Str {
    return "once a call uses named arguments it has to cover the full parameter list, and `{name}` has {count}"
}

// Says a callable takes nothing, appended to the no-such-parameter message.
func takesNoArguments(): Str {
    return ": it takes no arguments"
}

// Joins a parameter's alternative names, in the parameter list.
func orBetweenNames(): Str {
    return "` or `"
}

// Lists a callable's parameters, appended to the no-such-parameter message.
func parametersAre(list: Str): Str {
    return ". Its parameters are {list}"
}

// An argument's position counted the way a person counts, in a mismatch.
func ordinal(index: Int): Str {
    if index == 0 { return "first" }
    if index == 1 { return "second" }
    if index == 2 { return "third" }
    if index == 3 { return "fourth" }
    return "argument {index}"
}

// How many arguments a call passes or a callable takes, in a count mismatch.
func argumentCount(n: Int): Str {
    if n == 0 {
        return "no arguments"
    }
    if n == 1 {
        return "1 argument"
    }
    return "{n} arguments"
}

// How many fields a struct has, in a count mismatch.
func fieldsCount(n: Int): Str {
    if n == 1 {
        return "1 field"
    }
    return "{n} fields"
}

// Names what `append` or `prepend` puts in, in a mismatch.
func putsInWhat(name: Str): Str {
    return "what `{name}` puts in"
}

// Names `drop`'s low bound, in a mismatch.
func dropLowWhat(): Str {
    return "the low bound of `drop`"
}

// Names `drop`'s high bound, in a mismatch.
func dropHighWhat(): Str {
    return "the high bound of `drop`"
}

// Names what `join` concatenates, in a mismatch.
func joinWhat(): Str {
    return "what `join` concatenates"
}

// Names `join`'s separator, in a mismatch.
func joinSeparatorWhat(): Str {
    return "the separator `join` puts between elements"
}

// Names what `split` takes apart, in a mismatch.
func splitWhat(): Str {
    return "what `split` takes apart"
}

// Names `split`'s separator, in a mismatch.
func splitSeparatorWhat(): Str {
    return "the separator `split` cuts on"
}

// Names what `replaceFirst`/`replaceAll` rewrite, in a mismatch.
func rewritesWhat(name: Str): Str {
    return "what `{name}` rewrites"
}

// Names what `replaceFirst`/`replaceAll` look for, in a mismatch.
func looksForWhat(name: Str): Str {
    return "what `{name}` looks for"
}

// Names what `replaceFirst`/`replaceAll` put in its place, in a mismatch.
func putsInPlaceWhat(name: Str): Str {
    return "what `{name}` puts in its place"
}

// Names what `kill` stops, in a mismatch.
func killWhat(): Str {
    return "what `kill` stops"
}

// Names what `reveal` reads, in a mismatch.
func revealWhat(): Str {
    return "what `reveal` reads"
}

// Names what `row`/`column` read, in a mismatch.
func readsWhat(name: Str): Str {
    return "what `{name}` reads"
}

// Names the key `row`/`column` look for, in a mismatch.
func keyLooksForWhat(name: Str): Str {
    return "the key `{name}` looks for"
}

// Names what `toTable` cuts into rows, in a mismatch.
func toTableWhat(): Str {
    return "what `toTable` cuts into rows"
}

// Names `toTable`'s row width, in a mismatch.
func toTableWidthWhat(): Str {
    return "the row width `toTable` cuts at"
}

// An integer conversion is handed something that is not an integer.
func conversionNeedsInteger(name: Str, shown: Str): Str {
    return "`{name}(x)` converts an integer, and this is {shown}. `hive.conv.round`, `floor` and `ceil` are how a float becomes an `Int`"
}

// A float conversion is handed something that is not a float.
func conversionNeedsFloat(name: Str, shown: Str): Str {
    return "`{name}(x)` converts a float, and this is {shown}. `hive.conv.itf` and `itf32` are how an integer becomes a float"
}

// `sort` is called with other than one or two arguments.
func sortArgCount(): Str {
    return "`sort` takes a vector, and optionally the `func` that says which of two elements comes first"
}

// `sort` is handed something that is not a vector.
func sortNotVector(shown: Str): Str {
    return "`sort` orders a vector, and this is {shown}"
}

// `sort` without a comparator on elements that have no order.
func sortUnordered(shown: Str): Str {
    return "`sort` puts a vector in its elements' own order, and {shown} has none: a map, an address, a `Secret` and a function value have no order, and nor does a type holding one. Hand `sort` the `func` that says which of two comes first"
}

// Names `sort`'s comparator, in a mismatch.
func sortOrderWhat(): Str {
    return "the order `sort` was given"
}

// `len` or `bytes` on something whose type cannot be told.
func measureUnknown(name: Str, mapToo: Str): Str {
    return "`{name}` measures a vector or a `Str`{mapToo}, and what this is cannot be told from here"
}

// `bytes` on a map.
func bytesOfMap(): Str {
    return "`bytes` measures a vector's storage or a `Str`'s encoding, and a map is neither — a map's storage is not one contiguous thing to measure"
}

// `len` or `bytes` on something it cannot measure.
func measureWrongType(name: Str, mapToo: Str, shown: Str): Str {
    return "`{name}` measures a vector or a `Str`{mapToo}, and this is {shown}"
}

// Adds a map to what `len` measures, in the measure messages.
func orAMap(): Str {
    return " or a map"
}

// Names what `indexOf` looks for in a `Str`, in a mismatch.
func indexOfInStrWhat(): Str {
    return "what `indexOf` looks for in a `Str`"
}

// Names what `indexOf` looks for in a vector, in a mismatch.
func indexOfWhat(): Str {
    return "what `indexOf` looks for"
}

// `indexOf` searches something whose type cannot be told.
func indexOfUnknown(): Str {
    return "`indexOf` searches a vector or a `Str`, and what this is cannot be told from here"
}

// `indexOf` searches something that is not a vector or a `Str`.
func indexOfWrongType(shown: Str): Str {
    return "`indexOf` searches a vector or a `Str`, and this is {shown}"
}

// `toTable` is given a literal row width below one.
func toTableWidthBelowOne(n: Int): Str {
    return "`toTable` cuts a vector into rows of {n} cells, and a row holds at least one — this could only hand back an empty `Table`"
}

// `map`, `filter` or `filterMap` is called with other than two arguments.
func walkArgCount(name: Str, count: Str): Str {
    return "`{name}` takes the vector to walk and the function to walk it with, and this call passes {count}"
}

// The function handed to `map`, `filter` or `filterMap` takes other than one parameter.
func walkFunctionArity(name: Str, count: Str): Str {
    return "`{name}` hands its function one element at a time, and this one takes {count}"
}

// The function handed to `map`, `filter` or `filterMap` takes its parameter `mut`.
func walkTakesMutElement(name: Str): Str {
    return "`{name}` hands its function a copy of each element, never storage to write to, and this one takes its parameter `mut`. Write a `for each` loop over the vector instead"
}

// Names the element `map`/`filter`/`filterMap` hand their function, in a mismatch.
func walkElementWhat(name: Str): Str {
    return "the element `{name}` hands its function"
}

// The second argument of `map`, `filter` or `filterMap` is not a function.
func walkSecondArgumentNotFunction(name: Str, shown: Str): Str {
    return "`{name}` walks a vector with a function over its elements, and this second argument is {shown}"
}

// `filter`'s function answers with something other than a `Bool`.
func filterNeedsBool(shown: Str): Str {
    return "`filter` keeps the elements its function said yes to, so that function has to answer with a `Bool` — this one answers with {shown}"
}

// `filterMap`'s function answers with something other than a `Result`.
func filterMapNeedsResult(shown: Str): Str {
    return "`filterMap` transforms and selects in one pass, so its function has to answer with a `Result` — an `Ok` is kept and an `Error` is dropped. This one answers with {shown}"
}

// `map`'s function answers with nothing.
func mapCollectsVoid(): Str {
    return "`map` collects what its function answered with, and this one answers with nothing. A walk that only acts is a `for each` loop"
}

// `append` or `prepend` is used inside an expression.
func growHandsNothing(name: Str): Str {
    return "`{name}` hands nothing back: the vector you gave it is the result, so it stands as a statement of its own rather than inside an expression"
}

// `append`, `prepend` or `drop` targets a vector that is not `mut`.
func growTargetNotMut(name: Str): Str {
    return "`{name}` grows a vector in place, so its target has to be `mut` — this one is not"
}

// `append`, `prepend` or `drop` targets a vector of fixed length.
func growFixedLength(name: Str, root: Str, size: Int): Str {
    return "`{name}` needs a vector declared `[dyn]`, and `{root}` promises exactly {size}. A `:=` binding reads its length off the value, and a length read off a value is a promise it cannot grow out of — declare it `mut T[dyn]`"
}

// `append`, `prepend` or `drop` targets something that is not a vector.
func growNotVector(name: Str, root: Str, shown: Str): Str {
    return "`{name}` grows a vector, and `{root}` is {shown}"
}

// A statement that opens with `-`, usually a subtraction broken across a line.
func minusOpensStatement(): Str {
    return "a `-` that opens a line starts a new statement rather than continuing the one above, so this negates a value nothing uses. To subtract, end the line above with the `-`"
}

// An expression statement that is not a call.
func valueStatement(): Str {
    return "this computes a value and does nothing with it, so it is not a statement. Keep it — `x := ...` — or, if the value really is not wanted, `_ := ...`"
}

// A `sort` statement over something that is not a name or a path.
func sortStatementNothingInPlace(): Str {
    return "a `sort` written as a statement throws away the vector it answers with, so it only means something when it can sort in place — and there is nothing here to sort in place. Keep the answer instead"
}

// A `sort` statement over a vector that is not `mut`.
func sortStatementNotMut(root: Str): Str {
    return "a `sort` written as a statement sorts in place, which needs a `mut` vector — `{root}` is not one. Declare it `mut` to sort it where it lies, or keep the answer"
}

// An await-all entry is not a call.
func awaitAllEntryNotCall(): Str {
    return "every entry of an await-all is a call, started on a thread of its own — this one is a value already in hand, with nothing to wait for"
}

// An await-all's calls answer with different types.
func awaitAllMixedTypes(first: Str, shown: Str): Str {
    return "an await-all resolves to one vector, so its calls answer with one type — this list has {first} and {shown}. Give calls of different types names of their own: `a := async f()`, `b := async g()`"
}

// `with timeout` on an await-all whose calls answer with nothing.
func awaitAllTimeoutVoid(): Str {
    return "`with timeout` answers with a `Result` of what the calls answer, and these answer with nothing, so there is no value to wait for"
}

// `async` fires off a partial application.
func asyncPartial(): Str {
    return "`async` cannot fire off a partial application: `f(1, _)` makes a function value, and nothing runs until something calls it"
}

// `async` fires off a global builtin.
func asyncBuiltin(name: Str): Str {
    return "`async` cannot fire off the builtin `{name}`: the global builtins exist for the value they hand back, so firing one off would leave nothing of it"
}

// `async` fires off a constructor.
func asyncConstructor(name: Str): Str {
    return "`async` cannot fire off a constructor: `{name}(...)` builds a value and runs no body"
}

// A vector pattern tests something that is not a vector.
func vectorPatternWrongSubject(shown: Str): Str {
    return "a vector pattern matches a vector, and this subject is {shown}"
}

// A string pattern tests something that is not a `Str`.
func strPatternWrongSubject(shown: Str): Str {
    return "a string pattern matches a `Str`, and this subject is {shown}"
}

// A binary pattern tests something that is not bytes, a `Str` or an integer.
func bitsPatternWrongSubject(shown: Str): Str {
    return "a binary pattern matches a `UInt8[]`, a `Str` or an integer, and this subject is {shown}"
}

// A binary pattern over an integer binds a rest.
func bitsPatternNoRest(shown: Str): Str {
    return "a binary pattern over {shown} has no rest to bind: the fields take every one of its bits"
}

// A binary pattern over an integer takes other than all its bits.
func bitsPatternWidthMismatch(offset: Int, shown: Str, whole: Int): Str {
    return "the fields of this pattern take {offset} bits, and {shown} has {whole}: they take every one of them"
}

// A binary pattern's rest does not start on a byte.
func bitsRestOffByte(rest: Str, into: Int, missing: Int): Str {
    return "`...{rest}` starts {into} bits into a byte, and what is left is whole bytes. Take the {missing} bits that finish this one first — `_: UInt{missing}`"
}

// A binary pattern's fields do not come to whole bytes.
func bitsPatternNotWholeBytes(offset: Int, missing: Int): Str {
    return "the fields of this pattern come to {offset} bits, which is not a whole number of bytes. Take the {missing} bits that finish the last one — `_: UInt{missing}`"
}

// A run in a binary pattern is a literal.
func bitsRunIsLiteral(shown: Str): Str {
    return "a run of bytes binds what it reads, and `{shown}` is a literal: match its bytes as a string, `\"...\"`, or each one on its own"
}

// A run in a binary pattern over an integer.
func bitsRunFromInteger(shown: Str): Str {
    return "`{shown}` is a run of bytes, and an integer has none to give: a run reads from a `UInt8[]` or a `Str`"
}

// A run in a binary pattern is not of `UInt8`.
func bitsRunNotBytes(shown: Str, element: Str): Str {
    return "a run in a binary pattern is bytes — `{shown}: UInt8[n]` — and this one is {element}"
}

// A run's length in a binary pattern is not an integer.
func bitsRunLengthNotInteger(shown: Str, counted: Str): Str {
    return "the length of `{shown}` is a number of bytes, an integer, and this is {counted}"
}

// A string literal in a binary pattern over an integer.
func bitsStrFromInteger(shown: Str): Str {
    return "`{shown}` matches bytes, and an integer has none to give"
}

// A string literal in a binary pattern is given a type.
func bitsStrHasType(shown: Str): Str {
    return "`{shown}` matches its own bytes, so it says no type"
}

// A binary pattern field reads as a type that is not an integer.
func bitsFieldNotInteger(shown: Str, ty: Str): Str {
    return "`{shown}: {ty}` reads bits as an integer, and {ty} is not one"
}

// A literal in a binary pattern does not fit its field's type.
func bitsFieldLiteralDoesNotFit(n: Int, ty: Str): Str {
    return "`{n}` does not fit {ty}, which is what this field reads"
}

// A binary pattern field matches something that is not a literal.
func bitsFieldNotLiteral(shown: Str): Str {
    return "a binary pattern matches an integer literal or a string literal, and `{shown}` is neither"
}

// A `Result` pattern binds other than one payload.
func resultPatternPayloadCount(variant: Str, count: Str): Str {
    return "`Result.{variant}` carries one payload, and this pattern binds {count}"
}

// A pattern names a type nothing declared.
func patternTypeNotDeclared(head: Str): Str {
    return "`{head}` is not a type anything here declared"
}

// A variant pattern binds a different number of fields than the variant has.
func patternFieldCount(name: Str, variant: Str, has: Str, binds: Str): Str {
    return "`{name}.{variant}` has {has}, and this pattern binds {binds}. Name every field or none — `_` is how one is skipped"
}

// A variant pattern tests a value of another type.
func patternWrongSubject(shown: Str, variant: Str, subject: Str): Str {
    return "`{shown}.{variant}` matches a `{shown}`, and what it is matched against is {subject}"
}

// An integer literal does not fit the sized type it lands in.
func literalOutOfRange(where: Str, wanted: Str, holds: Str, n: Int): Str {
    return "{where} wants {wanted}, which holds {holds}, and this is {n}"
}

// A float literal is past what a `Float32` reaches.
func float32OutOfRange(where: Str): Str {
    return "{where} wants a `Float32`, which reaches about 3.4e38, and this is past it"
}

// What an integer type holds, in the out-of-range message.
func rangeBetween(low: Int, high: Int): Str {
    return "{low} to {high}"
}

// What a `UInt64` holds, in the out-of-range message.
func uint64Range(): Str {
    return "0 to 18446744073709551615"
}

// What a `UInt63` holds, in the out-of-range message.
func uint63Range(): Str {
    return "0 to 9223372036854775807"
}

// What an `Int` holds, in the out-of-range message.
func everyInt(): Str {
    return "every `Int`"
}

// Explains a function value that does not fit a function slot, appended to the mismatch.
func functionSlotWhy(): Str {
    return ". A function value fills a slot only when it takes everything the slot's calls can hand it — a `Str[3]` parameter cannot take the any-length vector a `Str[]` slot passes — and answers with what they expect"
}

// A value of one type lands where another is wanted.
func typeMismatch(where: Str, wanted: Str, given: Str, why: Str): Str {
    return "{where} wants {wanted} and this is {given}{why}"
}

// A vector of a fixed length is handed to a `mut T[dyn]` parameter, which may grow it.
func fixedIntoMutDynParam(where: Str, wanted: Str, given: Str): Str {
    return "{where} is a `mut {wanted}`, which the call may grow, and this is {given}, whose length is fixed. A vector is only ever `[dyn]` where it is declared that way: declare this one `[dyn]` where it is made"
}

// A vector of a fixed length is handed to a plain `T[dyn]` parameter.
func fixedIntoDynParam(where: Str, wanted: Str, given: Str, element: Str): Str {
    return "{where} wants {wanted} and this is {given}, whose length is fixed. A vector is only ever `[dyn]` where it is declared that way: to take a vector of any length, the parameter is `{element}[]`"
}

// --- src/emit.hive -------------------------------------------------------------

// An expression the emitter has no Go for.
func expressionHasNoLowering(): Str {
    return "this expression has no lowering yet"
}

// `hive.sql.run` given something that is not a `hive.sql.Fragment`.
func emitSqlRunNotFragment(shown: Str): Str {
    return "`hive.sql.run` runs a `hive.sql.Fragment`, and this is {shown}"
}

// `encode` given a codec whose type does not name a format.
func encodeCodecWithoutFormat(): Str {
    return "`encode` needs a codec whose type says its format, so the encoder can be written from the declaration"
}

// `encode` to a query string or command line of something not a declared type.
func encodeFlatNotDeclaredType(carrier: Str, shown: Str): Str {
    return "{carrier} is a declared type's fields, so `encode` cannot write {shown} as one"
}

// `append` or `prepend` used inside an expression.
func appendInsideExpression(name: Str): Str {
    return "`{name}` hands nothing back: the vector you gave it is the result, so it stands as a statement of its own rather than inside an expression"
}

// A builtin name the emitter does not know.
func unknownBuiltin(name: Str): Str {
    return "`{name}` is not a builtin this compiler carries"
}

// A `Secret` holding a type it cannot keep.
func emitSecretCannotKeep(shown: Str): Str {
    return "a `Secret` cannot keep {shown}"
}

// A type with variants sent as a query string or command line.
func flatCodecHasVariants(carrier: Str, typeName: Str): Str {
    return "{carrier} is one flat set of parameters, so `{typeName}`, which has variants, cannot travel as one"
}

// A field a query parameter or flag cannot hold.
func flatFieldCannotHold(typeName: Str, field: Str, shown: Str, unit: Str): Str {
    return "`{typeName}.{field}` is {shown}, which a {unit} cannot hold"
}

// A `hive.<module>` this compiler does not have; also used by src/loader.hive.
func moduleNotCarried(module: Str): Str {
    return "this compiler does not carry `hive.{module}`"
}

// `hive.map.new()` somewhere that does not say the map's type.
func mapNewWithoutTarget(): Str {
    return "`hive.map.new()` has to land somewhere that says what it holds: a declaration, a return, or an argument to a parameter declared as a map"
}

// --- src/mono.hive -------------------------------------------------------------

// Generics that keep instantiating at ever larger types.
func genericsExpandWithoutSettling(limit: Int): Str {
    return "this program's generics expand without settling: more than {limit} copies were asked for. A generic that instantiates itself at a larger type every time round never finishes"
}

// A generic used with the wrong number of type arguments.
func genericArgumentCountMismatch(name: Str, declared: Str, given: Str): Str {
    return "`{name}` is generic in {declared}, and this use gives {given}"
}

// Counts one type, in a generic argument-count mismatch.
func genericTypeCountOne(): Str {
    return "1 type"
}

// Counts several types, in a generic argument-count mismatch.
func genericTypeCount(n: Int): Str {
    return "{n} types"
}

// A generic callable used as a value.
func genericUsedAsValue(name: Str): Str {
    return "`{name}` is generic, so it cannot be used as a value: which copy a call reaches is decided by the argument types, and a value carries none. Call it, or wrap it in a callable of your own that is not generic"
}

// A type variable that no parameter mentions.
func typeVariableNotInParameters(variable: Str): Str {
    return "`{variable}` appears nowhere in the parameters, so there is nothing at a call to read it off. A type variable is pinned down by what is passed, never written at the call site"
}

// A partial application of a generic whose `_` hole is the only source of a type variable.
func partialLeavesTypeVariable(callee: Str, variable: Str): Str {
    return "`_` stands where `{callee}` reads `{variable}` from, so the function value this makes could not say which copy it calls: a partial application of something generic has to fix every type variable with what it does pass. Pass that argument, or wrap the call in a callable of your own that is not generic"
}

// --- src/loader.hive -----------------------------------------------------------

// An imported file that cannot be read.
func importCannotRead(display: Str, why: Str): Str {
    return "cannot read `{display}`: {why}"
}

// An import aliased as `hive`.
func importNamedHive(): Str {
    return "an import cannot be named `hive`: that name belongs to the standard library"
}

// A standard library import naming something inside a module.
func stdlibImportNamesMember(path: Str): Str {
    return "`{path}` names more than a module. An import of the standard library is the module and nothing in it: `import hive.ui`, never `import hive.ui.View`"
}

// A remote import whose repository lacks the named module at that commit.
func remoteImportMissingModule(url: Str, inner: Str, commit: Str): Str {
    return "`{url}` has no `{inner}.hive` at {commit}"
}

// Imports that form a cycle; `chain` is the indented list of files.
func importCycle(chain: Str): Str {
    return "this import forms a cycle:\n\n{chain}"
}

// An import the flattener could not resolve.
func importUnresolved(path: Str): Str {
    return "could not resolve `import {path}`"
}

// A name used through an import alias that the module does not declare.
func importedModuleLacksName(alias: Str, name: Str): Str {
    return "the module imported as `{alias}` has no `{name}`"
}

// A pattern naming an imported type without a variant.
func patternNamesImportedType(written: Str): Str {
    return "`{written}` does not name a pattern: it names a type, so a variant of it has to be named too"
}

// --- src/cover.hive ------------------------------------------------------------

// Names the first value no branch takes, in an incomplete `if`/`is` chain.
func missedSubjectValue(subject: Str, value: Str): Str {
    return "`{subject}` when it is `{value}`"
}

// --- src/stdlib.hive -----------------------------------------------------------

// A `Table` sent where JSON is needed.
func tableHasNoJson(): Str {
    return "a `Table` — `Str[dyn][dyn]` — has no JSON of its own. A document with no declared shape is a `hive.json.JsonValue`, and rows that mean something are a vector of a type declared for them"
}

// A `Secret` sent where JSON is needed.
func secretHasNoJson(): Str {
    return "a `Secret` is never written out, because only `reveal` opens one"
}

// A map sent where JSON is needed.
func mapHasNoJson(): Str {
    return "a map does not encode: its keys are whatever was put in it, while everything else here is read from a declaration. Send its pairs as a vector of a type declared for them"
}

// A `Table` decoded from JSON.
func tableHasNoDecoder(): Str {
    return "`Table` is not a declared type, so it has no decoder. A document with no declared shape is read with `hive.json.JsonValue.decode(text, hive.json.codec())`"
}

// Names the `term` format's carrier, in a flat-codec error.
func flatCarrierCommandLine(): Str {
    return "a command line"
}

// Names the `query` format's carrier, in a flat-codec error.
func flatCarrierQueryString(): Str {
    return "a query string"
}

// Names one key of the `term` format, in a flat-codec error.
func flatUnitFlag(): Str {
    return "flag"
}

// Names one key of the `query` format, in a flat-codec error.
func flatUnitQueryParameter(): Str {
    return "query parameter"
}

// --- src/library.hive ----------------------------------------------------------

// Says when a serving call panics, in a law that cannot prove it never panics.
func panicsWhenCannotListen(): Str {
    return "it does when it cannot listen on its port"
}

// Says when `hive.syslink.setKey` panics, in a law that cannot prove it never panics.
func panicsWhenKeyEmpty(): Str {
    return "it does when the key is empty"
}

// --- src/ranges.hive -----------------------------------------------------------

// An index into `t[r][c]` where the row `r` is a variable, so no guard can be about one row.
func rangeRowMoves(row: Str): Str {
    return "cannot prove this is in range: `{row}[...]` is a different row each time its index moves, so no guard can be about it. Bind the row to a name first — `row := {row}[r]` — and guard that"
}

// A literal index past a vector's known length.
func rangeLiteralPastLength(written: Str, n: Int, at: Int): Str {
    return "`{written}` holds {n}, so `{at}` is not a position it has"
}

// A literal index into a `Str` with no guard.
func rangeLiteralInStr(at: Int, written: Str): Str {
    return "cannot prove `{at}` is in range: `{written}` is a `Str`, whose length is only ever known at runtime. Guard it — `if {written} bounds {at} \{ ... }`"
}

// A literal index into a vector with no known length and no guard.
func rangeLiteralNoLength(at: Int, written: Str): Str {
    return "cannot prove `{at}` is in range: `{written}` has no length the compiler knows. Guard it — `if {written} bounds {at} \{ ... }` — or declare the vector with a length"
}

// A named index into a `Str` with no guard.
func rangeNameInStr(name: Str, written: Str): Str {
    return "cannot prove `{name}` is in range for `{written}`. Guard it — `if {written} bounds {name} \{ ... }` — or take it from `indexOf`, whose `Ok` payload is always a position the string really has"
}

// A named index into a vector with no guard.
func rangeNameInVector(name: Str, written: Str): Str {
    return "cannot prove `{name}` is in range for `{written}`. Guard it — `if {written} bounds {name} \{ ... }` — or take it from `indexOf`, whose `Ok` payload is always a position the vector really has"
}

// An index that is a computed expression, with nothing to guard.
func rangeComputedIndex(): Str {
    return "cannot prove this index is in range: it is a computed expression, and there is nothing to hang a guard on. Bind it to a name first, then guard that"
}

// Names an unnamed `Str` being indexed, in a range refusal.
func rangeThisString(): Str {
    return "this string"
}

// Names an unnamed vector being indexed, in a range refusal.
func rangeThisVector(): Str {
    return "this vector"
}

// --- src/keeps.hive ------------------------------------------------------------

// Names an assignment as the place a type law is checked.
func keepsThisWriteTo(target: Str): Str {
    return "this write to `{target}`"
}

// A write through a name sharing part of a value whose type has a law.
func keepsWriteThroughSharer(lawName: Str, how: Str, root: Str, source: Str): Str {
    return "cannot prove `{lawName}` for {how}: `{root}` shares the storage of `{source}`, so this writes into a value whose law cannot see it\n    write through `{source}` itself"
}

// A write into a value with a type law that the prover cannot follow.
func keepsWriteNotFollowed(lawName: Str, how: Str): Str {
    return "cannot prove `{lawName}` for {how}: what it writes into cannot be followed"
}

// A type law whose body the prover cannot follow, as the reason a value breaks it.
func keepsLawNotFollowed(reason: Str): Str {
    return "the law cannot be followed: {reason}"
}

// A value built or written that breaks its type's law.
func keepsDoesNotKeep(what: Str, lawName: Str, reason: Str): Str {
    return "{what} does not keep `{lawName}`: {reason}"
}

// A value built or written for which a type law's claim is false.
func keepsLawFalse(what: Str, lawName: Str, claim: Str): Str {
    return "{what} does not keep `{lawName}`: {claim} is false"
}

// A value built or written where nothing shows its type's law holds.
func keepsNothingShows(lawName: Str, what: Str, claim: Str): Str {
    return "cannot prove `{lawName}` for {what}: nothing here shows {claim}\n    guard it, so that the law holds here"
}

// Names a construction `T(...)` as the place a type law is checked.
func keepsThisConstruction(callee: Str): Str {
    return "this `{callee}(...)`"
}

// Names a call that writes its argument as the place a type law is checked.
func keepsThisCallOn(callee: Str, arg: Str): Str {
    return "this `{callee}` on `{arg}`"
}

// --- src/laws.hive -------------------------------------------------------------

// Prefixes every problem found in a law with the law's name.
func lawsInLaw(lawName: Str, message: Str): Str {
    return "in law `{lawName}`: {message}"
}

// A law with a path the prover could not follow to its end.
func lawsCannotProve(why: Str): Str {
    return "cannot prove this law: {why}"
}

// Names the counterexample of a law with no parameters.
func lawsEveryValue(): Str {
    return "every value"
}

// A law reaching a callable whose body a law may not reach.
func lawsReachesWhere(callee: Str, line: Int, problem: Str): Str {
    return "it reaches `{callee}` (line {line}), where {problem}"
}

// A law reaching a counting loop nothing shows comes to an end.
func lawsLoopMayNotEnd(line: Int): Str {
    return "it has a loop (line {line}) that nothing shows comes to an end: only `for each`, and a counting loop that starts at a literal, steps by one and stays below a bound, can be reached by a law"
}

// A law reaching a callable that calls itself on nothing smaller.
func lawsReachesSelfCaller(callee: Str, line: Int, problem: Str): Str {
    return "it reaches `{callee}` (line {line}), which calls itself, and {problem}"
}

// A law reaching two callables that call each other.
func lawsReachesCircle(first: Str, second: Str): Str {
    return "it reaches `{first}` and `{second}`, which call each other round in a circle: a law may only reach a callable that calls itself, on something smaller"
}

// A callable a law reaches calls itself on something not smaller than a parameter.
func lawsCallNotSmaller(line: Int, name: Str): Str {
    return "its call to itself (line {line}) is not on something smaller: pass, in a parameter's place, a part a pattern took from that parameter — `if xs is [_, ...rest] \{ {name}(rest, ...) }`"
}

// Two laws that call each other.
func lawsCallEachOther(): Str {
    return "it calls another law that, in turn, calls it: each would be assumed to prove the other. Only a law calling itself, on something smaller, is an induction"
}

// --- src/prove.hive ------------------------------------------------------------

// A law the prover ran out of steps on, as why it could not be followed.
func proveGaveUp(budget: Int): Str {
    return "it gave up after {budget} steps"
}

// A law binding `mut x := y` where `y` is `mut`, so the two share storage.
func proveMutShares(name: Str, value: Str, other: Str): Str {
    return "it cannot follow `mut {name} := {value}`, which shares `{other}`'s storage rather than copying it"
}

// A law writing into a place the prover cannot follow.
func proveWriteInto(subject: Str): Str {
    return "it cannot follow a write into `{subject}`"
}

// A law writing to a vector element at a position the prover cannot place.
func proveWriteUnplaced(): Str {
    return "it cannot follow a write to an element it cannot place"
}

// A law with an assignment the prover cannot follow.
func proveAssignment(): Str {
    return "it cannot follow this assignment"
}

// A law looping over a vector of unknown length that may fail inside.
func proveLoopTooFar(): Str {
    return "it cannot follow this loop over a vector of unknown length far enough to show that nothing in it fails an `assert` or reaches a `panic`"
}

// A law looping over a vector of unknown length that returns or breaks early.
func proveLoopLeavesEarly(): Str {
    return "it cannot follow this loop over a vector of unknown length: it can `return` or `break` part of the way through"
}

// A law looping over a vector of unknown length that passes a non-variable as `mut`.
func proveLoopMutArgument(): Str {
    return "it cannot follow this loop over a vector of unknown length: it hands a `mut` parameter something that is not a plain variable"
}

// A law with a `for` loop that has no condition.
func proveLoopNoCondition(): Str {
    return "it cannot follow a loop with no condition"
}

// A law with a counting loop whose bound is unknown.
func proveCountingBoundUnknown(): Str {
    return "it cannot follow a counting loop whose bound is not known: it learns what one does only by running it"
}

// A law whose claim is false for a concrete counterexample.
func proveFalseFor(witness: Str, claim: Str, cases: Str): Str {
    return "it does not hold for {witness}: `{claim}` is false{cases}"
}

// A law whose claim the prover shows is false. `keeps.hive` looks for ": it is false".
func proveClaimFalse(claim: Str, cases: Str, known: Str): Str {
    return "cannot prove `{claim}`: it is false{cases}{known}"
}

// A law whose claim the prover can neither prove nor refute.
func proveClaimOpen(claim: Str, cases: Str, known: Str): Str {
    return "cannot prove `{claim}`{cases}{known}"
}

// A law reaching a `panic` for a concrete counterexample.
func provePanicReachedFor(witness: Str, cases: Str): Str {
    return "it does not hold for {witness}: this `panic` is reached{cases}"
}

// A law that may reach a `panic`.
func provePanicMayBeReached(cases: Str): Str {
    return "cannot prove this `panic` is never reached{cases}"
}

// Names the `Ok` payload of an unknown, in a law's messages.
func proveLabelOkValue(label: Str): Str {
    return "{label}'s value"
}

// Names the `Error` payload of an unknown, in a law's messages.
func proveLabelErrorValue(label: Str): Str {
    return "{label}'s error"
}

// Names the first element of an unknown vector, in a law's messages.
func proveLabelFirstOf(label: Str): Str {
    return "the first of {label}"
}

// Names the rest of an unknown vector, in a law's messages.
func proveLabelRestOf(label: Str): Str {
    return "the rest of {label}"
}

// A law matching on a value the prover cannot take apart.
func proveCannotLookInside(value: Str): Str {
    return "it cannot look inside `{value}`"
}

// A law using a name the prover knows nothing about.
func proveCannotReasonAbout(name: Str): Str {
    return "it cannot reason about `{name}`"
}

// A law negating something that is not a number the prover handles.
func proveNegation(): Str {
    return "it cannot reason about this negation"
}

// A law using an expression or builtin the prover does not handle yet.
func proveNotYet(what: Str): Str {
    return "it cannot reason about `{what}` yet"
}

// A law applying an operator to a type the prover does not handle yet.
func proveOperatorNotYet(op: Str, shown: Str): Str {
    return "it cannot reason about `{op}` on {shown} yet"
}

// A law slicing something whose length is unknown.
func proveSliceLengthUnknown(): Str {
    return "it cannot reason about a slice of something whose length it does not know"
}

// A law slicing with bounds the prover does not know.
func proveSliceBoundsUnknown(): Str {
    return "it cannot reason about a slice whose bounds it does not know"
}

// A law matching a string pattern with holes.
func proveStringPatternHoles(): Str {
    return "it cannot reason about a string pattern with holes yet"
}

// A law matching a binary pattern.
func proveBinaryPattern(): Str {
    return "it cannot reason about a binary pattern yet"
}

// A law needing the length of a value the prover cannot measure.
func proveLengthUnknown(value: Str): Str {
    return "it cannot tell how long `{value}` is"
}

// Names the reply to a call into a running service, in a law's messages.
func proveLabelReplyTo(callee: Str): Str {
    return "the reply to {callee}(...)"
}

// A law reaching a callable written in Go.
func proveGoFunction(name: Str): Str {
    return "it calls `{name}`, a Go function, and the prover cannot read Go"
}

// A law calling something whose body the prover cannot read.
func proveCalleeUnreadable(callee: Str): Str {
    return "it cannot reason about `{callee}`: only a call the prover can read the body of can be followed"
}

// A law making a call the prover cannot follow.
func proveThisCall(): Str {
    return "it cannot reason about this call"
}

// Names the case where an `await` with a timeout ran out, in a law's messages.
func proveCaseWaitRanOut(line: Int): Str {
    return "the wait at line {line} ran out"
}

// Names the error a timed-out `await` answers, in a law's messages.
func proveLabelTimeout(line: Int): Str {
    return "the timeout at line {line}"
}

// A law calling a named function through a value.
func proveCallThroughValue(name: Str): Str {
    return "it cannot reason about calling `{name}` through a value"
}

// A law calling a function value the prover does not know.
func proveCallThroughUnknown(): Str {
    return "it cannot reason about a call through a value it does not know"
}

// A law reaching a callable nested deeper than the prover follows.
func proveNoDeeper(name: Str): Str {
    return "it cannot follow `{name}` any deeper"
}

// A law reaching a callable too deep to show it never fails.
func proveNotDeepEnough(name: Str): Str {
    return "it cannot follow `{name}` deep enough to show that nothing in it fails an `assert` or reaches a `panic`"
}

// A law passing a `mut` argument that is not a plain variable.
func proveMutArgumentNotVariable(): Str {
    return "it cannot follow a `mut` argument that is not a plain variable"
}

// A law applying `append`/`prepend` to something other than a variable.
func proveOntoVariableOnly(name: Str): Str {
    return "it cannot follow `{name}` onto anything but a variable"
}

// A law calling a string or vector builtin on values the prover does not know.
func proveKnownValuesOnly(name: Str): Str {
    return "it can follow `{name}` only on values it knows"
}

// Names the case where `hide` failed, in a law's messages.
func proveCaseHideFailed(line: Int): Str {
    return "hide at line {line} failed"
}

// Names the error a failed `hide` answers, in a law's messages.
func proveLabelHideError(line: Int): Str {
    return "the error of hide at line {line}"
}

// Names what is left of a vector after `drop`, in a law's messages.
func proveLabelAfterDrop(value: Str): Str {
    return "{value} after drop"
}

// Names what `drop` took from a vector, in a law's messages.
func proveLabelDropTaken(value: Str): Str {
    return "what drop took from {value}"
}

// A law partly applying a library function.
func provePartialApplication(word: Str): Str {
    return "it cannot follow `{word}` applied in part"
}

// A law calling a library function that may panic.
func proveLibraryPanics(word: Str, when: Str, cases: Str): Str {
    return "cannot prove `{word}` never panics: {when}{cases}"
}

// Names the error a library call answers, in a law's messages.
func proveLabelErrorOf(shown: Str): Str {
    return "the error of {shown}"
}

// A law handing a library function a callable that may fail.
func proveHandsMayFail(name: Str, word: Str): Str {
    return "it hands `{name}` to `{word}`, which calls it on values the prover cannot see, and `{name}` may fail an `assert` or reach a `panic`"
}

// A law handing a library function a function value the prover does not know.
func proveHandsUnknownFunction(word: Str): Str {
    return "it hands `{word}` a function it does not know"
}

// Names whether a map has a key, in a law's messages.
func proveLabelHas(base: Str, key: Str): Str {
    return "{base} has {key}"
}

// Names what a map holds at a key, in a law's messages.
func proveLabelHoldsAt(base: Str, key: Str): Str {
    return "what {base} holds at {key}"
}

// Names the negation of a case, in a law's messages.
func proveLabelNot(said: Str): Str {
    return "not {said}"
}

// Names a secret value, in a law's messages.
func proveLabelSecret(value: Str): Str {
    return "a secret holding {value}"
}

// Names a key removed from a map, in a law's messages.
func proveLabelTakenOut(key: Str): Str {
    return "{key} taken out"
}

// Lists what a loop started from, inside the name of what it carried to its end.
func proveLoopStartingFrom(from: Str): Str {
    return ", starting from {from}"
}

// Names what a loop carried to its end, in a law's messages.
func proveLabelAfterLoop(variable: Str, line: Str, over: Str, starting: Str): Str {
    return "({variable} after the loop at line {line} over {over}{starting})"
}

// Lists the cases a law's problem arises in, below the problem.
func proveInTheCase(cases: Str): Str {
    return "\n    in the case {cases}"
}

// Lists what the prover knew where a law's claim stayed open.
func proveKnownFacts(facts: Str): Str {
    return "\n    known: {facts}"
}
