// The runtime
// ===========
// The Go the generated program is compiled against. It is written as Go under
// `runtime/hive`, beside each module's stub, and `./bootstrap` has `embed.hive`
// carry both here as text, so a build writes only the files a program names.
import ./embedded
import ./gosource
import ./text
import hive.env
import hive.file

// The `go.mod` of the generated project, which is `runtime/go.mod`.
//
// The version is the language version the generated Go is written to, not the
// toolchain's: `hive.crypto` derives a key with `crypto/pbkdf2`, which is
// 1.24's, and nothing here is written to an older standard library than that.
func goMod(): Str {
    return file("go.mod")
}

// The one generated file in `hive/` — written only when the program has an
// `assets/` directory beside its entrypoint, and what puts the contents of one
// into the executable.
//
// It is four lines and it has to be generated rather than carried, because
// `//go:embed` names a directory that must exist: a program with no assets
// cannot hold this declaration at all, and a program with assets cannot embed
// them without it. `hive/uiscene.go` is the other half, and knows nothing about
// this file beyond the one call it leaves open for it.
func assetsSource(): Str {
    return `
        package hive

        import "embed"

        //go:embed assets
        var uiAssetDir embed.FS

        func init() \{ uiAssetsAre(uiAssetDir) }
    `
}

// A backtick is the one character `embedded.hive` cannot hold, so it is `~BT~` there.
// `HIVE_RUNTIME` names a `runtime/` to read instead of the one carried.
func file(name: Str): Str {
    if hive.env.get("HIVE_RUNTIME") is Result.Ok(directory) && directory != "" {
        mut path := directory + "/hive/" + name
        if name == "go.mod" {
            path = directory + "/go.mod"
        }
        if hive.file.read(path) is Result.Ok(written) {
            if text.endsWith(name, ".go") {
                return gosource.carried(written)
            }
            return text.trim(text.replace(written, "\r\n", "\n"))
        }
        return ""
    }
    return join(split(embedded.source(name), "~BT~"), "`")
}

func stubs(): Str[dyn] {
    mut Str[dyn] listed = embedded.names()
    if hive.env.get("HIVE_RUNTIME") is Result.Ok(directory) && directory != "" {
        if hive.file.list(directory + "/hive") is Result.Ok(found) {
            listed = sort(found)
        }
    }
    mut Str[dyn] out = []
    for each name in listed {
        if text.endsWith(name, ".hive") {
            append(out, text.span(text.chars(name), 0, len(name) - 6))
        }
    }
    return out
}

// A stub whose name opens with another's is that module's second file: `uiscene` is `ui`'s.
func moduleOf(stubs: Str[], stub: Str): Str {
    mut module := stub
    for each other in stubs {
        if other != stub && text.startsWith(stub, other) && len(other) < len(module) {
            module = other
        }
    }
    return module
}

// The Go for a module of the runtime, or `""` when this compiler does not
// carry it. Most are named by a `hive.<module>` a program referenced; `csv` and
// `sheets` are named by the reader a program called — `hive.file.csv`,
// `hive.file.xlsx`, `hive.file.ods` — which is the same idea: the source says
// which reader it wants, so a program that reads a CSV does not carry a
// spreadsheet's zip and XML.
//
// `hive.map` and `hive.task` are the core: a `Dict` and a `Task` are values the
// language itself hands out, so they are never a separate file.
func moduleSource(module: Str): Str {
    return file(module + ".go")
}

func coreSource(): Str {
    return file("runtime.go")
}

// What a module's own Go is written against. Asking for a module asks for these
// too, so a build never carries one without the definitions it calls into:
// `hive.crypto` decodes a JWT payload through the codec machinery in
// `hive.json`, and checks the dates on one against the clock `hive.time` reads.
func requires(module: Str): Str[dyn] {
    if module == "crypto" {
        return ["json", "time", "secret"]
    }
    // `getSecret` sits beside `get` and hides what it found.
    if module == "env" {
        return ["secret"]
    }
    // Locking memory is a file per platform, and the tag atop each picks one.
    if module == "secret" {
        return ["secretunix", "secretwindows", "secretother"]
    }
    // A format is written against the vocabulary `encode` and `decode` share,
    // which is its own file so that a second format would add one rather than
    // reach into the first.
    if module == "json" || module == "term" {
        return ["codec"]
    }
    // Looking a name up is the platform's business, and on one of them it is not
    // a file the Go resolver can read. The three modules that resolve one ask for
    // the same answer.
    if module == "net" {
        return ["codec", "resolver"]
    }
    if module == "sql" {
        return ["resolver"]
    }
    // Turning a terminal's echo off is two files, one per platform, and the tag
    // at the top of each leaves the other out of the build.
    if module == "termsecret" {
        return ["term", "termsecretunix", "termsecretwindows", "secret"]
    }
    // Writing one is the same shape: a file per platform, over the error
    // `hive.file` already answers with.
    if module == "filewrite" {
        return ["file", "filewriteunix", "filewritewindows"]
    }
    // A message crosses a machine boundary through the same derived codecs
    // `hive.json` builds from a declaration, and the wire that carries it is its
    // own file — one nothing in Hive source ever names.
    if module == "syslink" {
        return ["json", "syslinknet", "resolver", "secret"]
    }
    // A window is a syslink service with a socket in front of it: the fold and
    // the address come from `syslink`, the socket from `net`, and the token that
    // keeps the page private from `crypto`.
    if module == "ui" {
        return ["net", "crypto", "syslink"]
    }
    // A scene is drawn in a window, and a window is the rest of `hive.ui`.
    if module == "uiscene" {
        return ["ui"]
    }
    return []
}
