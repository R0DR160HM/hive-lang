// Checks
// ======
// Everything a program has to be that the grammar cannot say. The parser has held
// every name to its shape and the loader has resolved every import, so what is left
// is about meaning: whether a call has the arguments its declaration asked for,
// whether a `func` stayed a `func`, and whether every path returns.
//
// Every check reports and carries on. A program with six mistakes is one whose
// author would rather hear about six than about the first.
//
// The pass runs on a flattened module whose nodes carry no position, so a message
// names the declaration rather than a line. Spec 17.3 records that limit.
import ./ast
import ./cover
import ./diag
import ./infer
import ./stdlib
import ./text
import ./types
import hive.map

type Check {
	table: types.Table
	errors: diag.Diagnostic[dyn]
	// The declaration being walked, which is what a message names.
	inside: Str
	// The line it was declared on — the best position a flattened tree offers.
	line: Int
	// Whether the body is a `func` — which may not declare a mutex parameter.
	pure: Bool
	// What the body has to return, or `TVoid`.
	result: types.Ty
	// Whether the body is a `test`, where `return value` is refused.
	inTest: Bool
	// How many loops enclose the statement being walked.
	loops: Int
	// The names in scope that are `mut`, as a stack the scopes push and pop.
	mutable: Str[dyn]
	// The names declared so far in the body, as a stack, and where the innermost
	// block's own start in it: one block may not declare a name twice.
	declared: Str[dyn]
	blockStart: Int
}
// Check a whole flattened program.
proc checkModule(m: ast.Module): diag.Diagnostic[dyn] {
	t := types.tableOf(m)
	mut Check c = Check(t, [], "", 0, false, types.Ty.TVoid(), false, 0, [], [], 0)
	env := infer.newEnv(t)
	checkTestTitles(c, m)
	for each d in m.decls {
		checkDecl(c, env, d)
	}
	return c.errors
}

// A test's title is its name in the report, so two tests answering to one name
// would be reported as one. Go's runner turns spaces into underscores, which makes
// `a b` and `a_b` the same name too.
proc checkTestTitles(c: mut Check, m: ast.Module): void {
	mut Str[dyn] seen = []
	mut Str[dyn] titles = []
	for each d in m.decls {
		if d is ast.Decl.TestDecl(title, _, line) {
			key := join(split(title, " "), "_")
			if indexOf(seen, key) is Result.Ok(at) {
				c.inside = "\"{title}\""
				c.line = line
				if titles bounds at {
					if titles[at] == title {
						report(c, "another test is already called this. A title is how the report names a test, so two with one title would be reported as one — give each its own")
					} else {
						report(c, "the report writes a space in a title as `_`, so this and \"" + titles[at] + "\" would be reported as one test — give each its own title")
					}
				}
			}
			append(seen, key)
			append(titles, title)
		}
	}
}

proc report(c: mut Check, message: Str): void {
	reportAt(c, c.line, message)
}

proc reportAt(c: mut Check, line: Int, message: Str): void {
	append(c.errors, diag.at(line, diag.inDecl(c.inside, message)))
}

// --- Declarations ------------------------------------------------------------

proc checkDecl(c: mut Check, env: infer.Env, d: ast.Decl): void {
	if d is ast.Decl.TypeDecl(name, fields, variants, line) {
		c.inside = name
		c.line = line
		checkTypeDecl(c, fields, variants)
		checkHoldsItself(c, env.table, name)
		for each f in fields {
			checkLibTypes(c, types.resolve(env.table, f.declared))
		}
		for each v in variants {
			for each f in v.fields {
				checkLibTypes(c, types.resolve(env.table, f.declared))
			}
		}
	} else if d is ast.Decl.CallableDecl(kind, name, params, result, body, line) {
		c.inside = name
		c.line = line
		c.pure = kind is ast.CallableKind.FuncKind
		c.result = types.resolve(env.table, result)
		checkLibTypes(c, c.result)
		for each p in params {
			checkLibTypes(c, types.resolve(env.table, p.declared))
		}
		c.inTest = false
		c.loops = 0
		c.mutable = []
		checkCallable(c, env, name, params, body)
	} else if d is ast.Decl.QueryDecl(name, params, result, sql, line) {
		c.inside = name
		c.line = line
		// A query is a `func` whose body happens to be SQL: nothing in one could
		// write to storage its caller can see.
		c.pure = true
		c.result = types.resolve(env.table, result)
		c.inTest = false
		c.loops = 0
		c.mutable = []
		checkQuery(c, env, params, result, sql)
	} else if d is ast.Decl.TestDecl(title, body, line) {
		c.inside = "\"{title}\""
		c.line = line
		c.pure = false
		c.result = types.Ty.TVoid()
		c.inTest = true
		c.loops = 0
		c.mutable = []
		c.declared = []
		c.blockStart = 0
		checkBlock(c, env, body)
	}
}

// A query's parameters go into scope, then the two things in its body that are
// not text are checked as the expressions they are: a bound value, and the
// condition on an optional predicate.
proc checkQuery(c: mut Check, env: infer.Env, params: ast.Param[], result: ast.TypeExpr, sql: ast.SqlPart[]): void {
	mut Str[dyn] seen = []
	for each p in params {
		if indexOf(seen, p.name) is Result.Ok(_) {
			report(c, "this declares the parameter `{p.name}` twice")
		}
		append(seen, p.name)
		if p.mutex {
			report(c, "a query cannot declare the mutex parameter `{p.name}: mut ...`: its body is SQL, and there is nothing in one that could write through it")
		}
	}
	inner := infer.boundParams(env, params, 0)
	rows := types.resolve(env.table, result)
	checkRowType(c, rows)
	checkSelectStar(c, rows, sql)
	checkSql(c, inner, sql)
}

// What a query declares its rows to be. Three shapes mean something: one row
// type per row, a single column, and no rows at all.
proc checkRowType(c: mut Check, declared: types.Ty): void {
	if declared is types.Ty.TVoid {
		return
	}
	if declared is types.Ty.TVec(element, _) {
		if element is types.Ty.TNamed(name) {
			if types.findType(c.table, name) is Result.Ok(info) {
				if len(info.variants) > 0 {
					report(c, "a query's rows are a struct, and `{name}` is a tagged union: a row is a fixed set of columns, and there is nothing in a result set to say which variant one of them is")
				}
				return
			}
			report(c, "a query answers with rows of a declared type, and `{name}` is not one")
			return
		}
		if element is types.Ty.TVec(_, _) && types.isTable(declared) == false {
			report(c, "a query answers with whole rows of text as a `Table`, `Str[dyn][dyn]`, and this is " + types.show(declared) + ". A single column is a vector of one scalar: `Int[dyn]`")
		}
		return
	}
	report(c, "a query answers with `T[dyn]` for one row type, `Str[dyn]` (or another scalar) for a single column, `Table` for every column as text, or `void` for a statement — and this is " + types.show(declared))
}

// --- `SELECT *` against a declared row type ----------------------------------

// A query that says what its rows are may not then ask for whatever the table
// happens to have.
//
// `SELECT *` says neither how many columns come back nor what they are called, so
// nothing can line them up against the fields — and what it stands for changes the
// day somebody adds a column, reported at run time in a program nobody edited.
//
// The rule is about the result and only the result: `count(*)`, `a * 2`, a star
// inside a subquery and a `void` statement's select list all still compile.
proc checkSelectStar(c: mut Check, declared: types.Ty, sql: ast.SqlPart[]): void {
	if rowTyped(c.table, declared) == false {
		return
	}
	if selectsEverything(sqlText(sql)) == false {
		return
	}
	report(c, "`SELECT *` cannot fill in rows of a declared type: it says neither how many columns come back nor what they are called, so nothing can line them up against the fields — and what it stands for changes the day somebody adds a column. Name them, with an alias where a column and a field are spelt differently: `SELECT id, u.name AS author`")
}

// Whether the declared result is one row type per row, as against a single
// column, a `Table` (which has no fields to disagree with), or a statement.
func rowTyped(table: types.Table, declared: types.Ty): Bool {
	if declared is types.Ty.TVec(element, _) {
		if element is types.Ty.TNamed(name) {
			return types.findType(table, name) is Result.Ok(_)
		}
	}
	return false
}

// The query's text with its holes filled by something inert. A bound value is a
// placeholder anyway, and an optional predicate only appears after the select
// list, so neither can change what the select list is.
func sqlText(parts: ast.SqlPart[]): Str {
	mut Str out = ""
	for each part in parts {
		if part is ast.SqlPart.Lit(written) {
			out = out + written
		} else {
			out = out + " ? "
		}
	}
	return out
}

// Whether any select list that decides the result asks for a bare star.
//
// It is a scan rather than a parse, and four things make it one:
//
//   * depth. A star inside brackets is `count(*)` or a subquery's.
//   * what came before it. A star beginning an item — after `SELECT`, a comma,
//     `DISTINCT`, `ALL`, or the dot of `t.*` — is every column; one after a name, a
//     number or a closing bracket is multiplication.
//   * where the list ends. At the top-level `FROM`, starting again at the next
//     top-level `SELECT`, so both halves of a `UNION` are looked at.
//   * quotes and comments. A star in `'a * b'` or in `/* ... */` is text.
func selectsEverything(sql: Str): Bool {
	cs := text.chars(sql)
	mut Int depth = 0
	mut Bool listing = false
	// The last thing that mattered — how a star meaning every column is told
	// from a star meaning times.
	mut Str before = ""
	mut Int i = 0
	for ; i < len(cs); {
		ch := text.charAt(cs, i)
		if ch == "'" || ch == "\"" || ch == "`" {
			i = pastQuoted(cs, i, ch)
			before = "value"
		} else if ch == "-" && text.charAt(cs, i + 1) == "-" {
			i = pastLine(cs, i)
		} else if ch == "/" && text.charAt(cs, i + 1) == "*" {
			i = pastBlock(cs, i)
		} else if ch == "(" {
			depth = depth + 1
			before = "("
			i = i + 1
		} else if ch == ")" {
			depth = depth - 1
			before = ")"
			i = i + 1
		} else if ch == "," {
			before = ","
			i = i + 1
		} else if ch == "." {
			before = "."
			i = i + 1
		} else if ch == "*" {
			if listing && depth == 0 && opensAnItem(before) {
				return true
			}
			before = "*"
			i = i + 1
		} else if text.isAlnum(ch) || ch == "_" {
			word := text.lower(wordAt(cs, i))
			i = i + len(word)
			// Only at the top level: a `SELECT` inside brackets belongs to a
			// subquery or a CTE, and neither decides the result.
			if depth == 0 && word == "select" {
				listing = true
				before = "select"
			} else if depth == 0 && word == "from" {
				listing = false
				before = "from"
			} else if word == "distinct" || word == "all" {
				before = ","
			} else {
				before = "word"
			}
		} else {
			// Whitespace and every operator that is not a star leave what came before
			// alone, so `SELECT  *` and `SELECT\n*` read as `SELECT *`.
			if text.isSpace(ch) == false {
				before = "operator"
			}
			i = i + 1
		}
	}
	return false
}

// Whether a star here begins a select item rather than continuing an expression.
func opensAnItem(before: Str): Bool {
	return before == "select" || before == "," || before == "."
}

// Past a quoted run, from its opening mark. A doubled quote — `'it''s'` — needs no
// case of its own: the first run closes on the first of the pair and the second
// immediately opens another.
func pastQuoted(cs: Str[], from: Int, mark: Str): Int {
	mut Int i = from + 1
	for ; i < len(cs); {
		if text.charAt(cs, i) == mark {
			return i + 1
		}
		i = i + 1
	}
	return len(cs)
}

func pastLine(cs: Str[], from: Int): Int {
	mut Int i = from
	for ; i < len(cs); {
		if text.charAt(cs, i) == "\n" {
			return i
		}
		i = i + 1
	}
	return len(cs)
}

func pastBlock(cs: Str[], from: Int): Int {
	mut Int i = from + 2
	for ; i < len(cs); {
		if text.charAt(cs, i) == "*" && text.charAt(cs, i + 1) == "/" {
			return i + 2
		}
		i = i + 1
	}
	return len(cs)
}

// The word starting here: letters, digits and underscores, which a SQL keyword
// and a column name are both made of.
func wordAt(cs: Str[], from: Int): Str {
	mut Str out = ""
	mut Int i = from
	for ; i < len(cs); {
		ch := text.charAt(cs, i)
		if text.isAlnum(ch) == false && ch != "_" {
			return out
		}
		out = out + ch
		i = i + 1
	}
	return out
}

proc checkSql(c: mut Check, env: infer.Env, parts: ast.SqlPart[]): void {
	for each part in parts {
		if part is ast.SqlPart.Param(value) {
			checkExpr(c, env, value)
			checkBoundValue(c, env, value)
		} else if part is ast.SqlPart.Where(group) {
			checkSqlGroup(c, env, group)
		}
	}
}

proc checkSqlGroup(c: mut Check, env: infer.Env, group: ast.SqlGroup): void {
	for each item in group.items {
		if item is ast.SqlItem.Cond(condition, body) {
			checkCondition(c, env, condition)
			checkSql(c, env, body)
		} else if item is ast.SqlItem.Nested(inner) {
			checkSqlGroup(c, env, inner)
		}
	}
}

// A bound value is one cell, so it is one of the four things a cell can be. A
// vector or a record would have to be spliced into the text, which a query never
// does.
proc checkBoundValue(c: mut Check, env: infer.Env, value: ast.Expr): void {
	ty := infer.typeOf(env, value)
	if ty is types.Ty.TStr || ty is types.Ty.TInt || ty is types.Ty.TFloat
		|| ty is types.Ty.TBool || ty is types.Ty.TAtom || ty is types.Ty.TUnknown {
		return
	}
	report(c, "a bound value is one cell, and this is " + types.show(ty) + ". A cell is a `Str`, an `Int`, a `Float`, a `Bool` or an `Atom`; anything else would have to be spliced into the text, which is the one thing a query never does")
}

proc checkLibTypes(c: mut Check, ty: types.Ty): void {
	if ty is types.Ty.TLib(module, name) {
		if stdlib.isLibType(module, name) == false {
			report(c, "`hive.{module}` has no type `{name}`")
		}
	} else if ty is types.Ty.TVec(element, _) {
		checkLibTypes(c, element)
	} else if ty is types.Ty.TResult(ok, bad) {
		checkLibTypes(c, ok)
		checkLibTypes(c, bad)
	} else if ty is types.Ty.TMap(key, value) {
		checkLibTypes(c, key)
		checkLibTypes(c, value)
	} else if ty is types.Ty.TFn(_, params, _, result) {
		for each p in params {
			checkLibTypes(c, p)
		}
		checkLibTypes(c, result)
	} else if ty is types.Ty.TAddress(message) {
		if message is types.Ty.TUnknown {
			report(c, "an address says what its service takes: `Address<M>`, with `M` the type of its messages")
		} else {
			checkLibTypes(c, message)
		}
	} else if ty is types.Ty.TSecret(held) {
		if held is types.Ty.TUnknown {
			report(c, "a secret says what it holds: `Secret<T>`, with `T` the type of its value")
		} else {
			checkLibTypes(c, held)
			checkKeepable(c, "a `Secret`", held)
		}
	}
}

proc checkKeepable(c: mut Check, what: Str, ty: types.Ty): void {
	if types.unkeepable(c.table, ty, []) is Result.Ok(found) {
		mut held := ""
		if types.same(found, ty) == false {
			held = ", which holds " + types.show(found)
		}
		report(c, what + " cannot keep " + types.show(ty) + held + ": a `Secret` holds plain data — text, numbers, vectors, maps, results and declared types made of them — and not a function, an address, a library handle or another `Secret`")
	}
}

proc checkTypeDecl(c: mut Check, fields: ast.Field[], variants: ast.Variant[]): void {
	mut hive.map.Map<Str, Bool> seen = hive.map.new()
	for each f in fields {
		if hive.map.has(seen, f.name) {
			report(c, "this type declares `{f.name}` twice")
		}
		hive.map.set(seen, f.name, true)
		checkReservedField(c, f.name)
		checkMarks(c, f)
	}
	mut hive.map.Map<Str, Bool> variantNames = hive.map.new()
	for each v in variants {
		if hive.map.has(variantNames, v.name) {
			report(c, "this type declares the variant `{v.name}` twice")
		}
		hive.map.set(variantNames, v.name, true)
		// A field declared outside any variant is added to every one of them, so
		// a variant naming one of its own the same way would have two.
		for each f in v.fields {
			if hive.map.has(seen, f.name) {
				report(c, "the variant `{v.name}` declares `{f.name}`, which the type already declares outside every variant — a shared field is added to each of them, so this one would be there twice")
			}
			checkReservedField(c, f.name)
			checkMarks(c, f)
		}
	}
	checkJsonNames(c, fields, variants)
}

// A struct holding itself field by field — directly, through another struct, or
// through a `Result` — would be a value that never finishes. A vector, a map and
// a union's variant can each be empty, so any of them ends it.
proc checkHoldsItself(c: mut Check, t: types.Table, name: Str): void {
	if types.findType(t, name) is Result.Ok(info) {
		if len(info.variants) == 0 && holdsByValue(t, name, info.shared, [name]) {
			report(c, "`" + types.shownName(name) + "` holds itself, field by field, with nothing in between that could end it, so a value of it could never be finished. Put the recursion through a vector — `children: " + types.shownName(name) + "[dyn]` — or through a variant of a union, which can stop")
		}
	}
}

func holdsByValue(t: types.Table, target: Str, fields: ast.Field[], seen: Str[]): Bool {
	for each f in fields {
		if reachesByValue(t, target, types.resolve(t, f.declared), seen) {
			return true
		}
	}
	return false
}

func reachesByValue(t: types.Table, target: Str, ty: types.Ty, seen: Str[]): Bool {
	if ty is types.Ty.TResult(ok, bad) {
		return reachesByValue(t, target, ok, seen) || reachesByValue(t, target, bad, seen)
	}
	if ty is types.Ty.TNamed(name) {
		if name == target {
			return true
		}
		if indexOf(seen, name) is Result.Ok(_) {
			return false
		}
		if types.findType(t, name) is Result.Ok(info) {
			if len(info.variants) == 0 {
				return holdsByValue(t, target, info.shared, seen + [name])
			}
		}
	}
	return false
}

// Every `decode` reads a `Str` in the format its second argument names, and
// answers with a `Result` the caller has to open. Checked here because the
// emitter needs both before it can name a decoder, so nothing downstream could
// report a wrong one.
proc checkDecodes(c: mut Check, env: infer.Env, what: Str, typeName: Str, args: ast.Arg[]): void {
	if len(args) != 2 {
		report(c, what + " reads a `Str` and the codec to read it with, and this call passes " + countOf(len(args)))
		return
	}
	if args bounds 0 {
		fits(c, types.Ty.TStr(), infer.typeOf(env, args[0].value), "what " + what + " reads")
	}
	if args bounds 1 {
		format := stdlib.formatOfCodec(infer.typeOf(env, args[1].value))
		checkNamesCodec(c, env, what, args[1].value)
		checkFlatShape(c, what, types.Ty.TNamed(typeName), format)
		checkJsonShape(c, what, types.Ty.TNamed(typeName), format)
	}
}

proc checkJsonShape(c: mut Check, what: Str, ty: types.Ty, format: Str): void {
	if format != "json" && format != "jwt" {
		return
	}
	if tableIn(c.table, ty, []) is Result.Ok(place) {
		mut carried := "this"
		if place != "" {
			carried = place
		}
		report(c, what + " cannot carry " + carried + ": " + stdlib.tableHasNoJson())
	}
	if types.holdsSecret(c.table, ty) {
		report(c, what + " cannot carry " + types.show(ty) + ": " + stdlib.secretHasNoJson())
	}
}

// Where a `Table` sits in `ty`: `""` for `ty` itself, or the field holding one.
func tableIn(t: types.Table, ty: types.Ty, seen: Str[]): Result<Str, Bool> {
	if types.isTable(ty) {
		return Result.Ok("")
	}
	if ty is types.Ty.TVec(element, _) {
		return tableIn(t, element, seen)
	}
	if ty is types.Ty.TNamed(name) {
		if indexOf(seen, name) is Result.Error(_) {
			if types.findType(t, name) is Result.Ok(info) {
				mut ast.Field[dyn] fields = []
				for each v in info.variants {
					for each f in v.fields {
						append(fields, f)
					}
				}
				for each f in info.shared {
					append(fields, f)
				}
				for each f in fields {
					if tableIn(t, types.resolve(t, f.declared), seen + [name]) is Result.Ok(place) {
						if place == "" {
							return Result.Ok("`" + types.shownName(name) + ".{f.name}`")
						}
						return Result.Ok(place)
					}
				}
			}
		}
	}
	return Result.Error(false)
}

// A query string and a command line are one flat set of parameters, so only a
// type without variants whose fields are values, or vectors of values, travels as one.
proc checkFlatShape(c: mut Check, what: Str, ty: types.Ty, format: Str): void {
	if stdlib.isFlatFormat(format) == false || ty is types.Ty.TUnknown {
		return
	}
	carrier := stdlib.flatCarrier(format)
	if ty is types.Ty.TNamed(name) {
		if types.findType(c.table, name) is Result.Ok(info) {
			if len(info.variants) > 0 {
				report(c, carrier + " is one flat set of parameters, so " + what + " cannot carry `" + types.shownName(name) + "`, which has variants")
				return
			}
			for each f in info.shared {
				checkFlatField(c, name, f, stdlib.flatUnit(format))
			}
			return
		}
	}
	report(c, carrier + " is a declared type's fields, so " + what + " cannot carry " + types.show(ty))
}

proc checkFlatField(c: mut Check, typeName: Str, f: ast.Field, unit: Str): void {
	ty := types.resolve(c.table, f.declared)
	if stdlib.isFlatValue(ty) {
		return
	}
	if ty is types.Ty.TVec(element, _) {
		if stdlib.isFlatValue(element) {
			return
		}
	}
	report(c, "`{typeName}.{f.name}` is " + types.show(ty) + ", and a {unit} is a `Str`, `Int`, `Float`, `Bool` or `Atom`, or a vector of one repeated under its name")
}

// A codec is a value like any other, and its type says which format it is: the
// encoder and decoder are still written from the declaration at the call, off
// that type, which is what keeps this free of reflection.
proc checkNamesCodec(c: mut Check, env: infer.Env, what: Str, given: ast.Expr): void {
	if given is ast.Expr.Hole {
		return
	}
	held := infer.typeOf(env, given)
	if held is types.Ty.TUnknown {
		return
	}
	if held is types.Ty.TCodec(error) {
		// A generic one is settled per copy, where the variable is known.
		if error is types.Ty.TVar(_) || stdlib.formatOfCodec(held) != "" {
			return
		}
		report(c, "`" + types.show(held) + "` names no format: a codec's error type is what says which, and it is one of " + errorTypes())
		return
	}
	report(c, "the codec " + what + " uses wants hive.codec.Codec<E> and this is " + types.show(held))
}

// Every error type that names a format, for a message that has to list them.
func errorTypes(): Str {
	mut Str[dyn] out = []
	for each format in stdlib.codecFormats() {
		append(out, types.show(stdlib.codecErrorOf(format)))
	}
	return join(out, ", ")
}

// A field-less variant is a value, so `T.Variant.decode` would read as that field
// of it as readily as the decoder — and the two mean entirely different things.
// One name is the whole cost of naming the decoder at all.
proc checkReservedField(c: mut Check, name: Str): void {
	if name == "decode" {
		report(c, "`decode` is the name of the decoder every type derives, so a field cannot also be called that — `T.Variant.decode(text, codec)` would name both this field and the decoder. Any other name is free")
	}
}

// What a field's `--` annotations have to be true of. The parser has already
// settled their shape; what is left is the one thing it could not know, which is
// what the field's type is.
proc checkMarks(c: mut Check, f: ast.Field): void {
	if f.marks.fallback is ast.Expr.Absent {
		return
	}
	declared := types.resolve(c.table, f.declared)
	given := literalType(f.marks.fallback)
	if types.same(declared, given) {
		return
	}
	// A literal of the wrong type would be a field decoding into something its
	// own declaration says it cannot hold, so this is the one place the
	// annotation is held to the type beside it.
	report(c, "`{f.name}` is declared " + types.show(declared) + " and falls back to " + types.show(given) + ". A `Default` is the value the field takes where JSON has nothing, so it has to be a value the field can hold")
}

// Two fields of one object cannot answer to one key: the decoder would read the same
// member twice and the encoder would write it twice. Checked over each variant's own
// fields together with the shared ones, since that is the object a variant encodes to.
proc checkJsonNames(c: mut Check, fields: ast.Field[], variants: ast.Variant[]): void {
	if len(variants) == 0 {
		reportClashes(c, fields, [])
		reportUrlClashes(c, fields)
		reportFlagClashes(c, fields)
		return
	}
	for each v in variants {
		reportClashes(c, v.fields, fields)
	}
}

proc reportClashes(c: mut Check, fields: ast.Field[], andShared: ast.Field[]): void {
	mut hive.map.Map<Str, Bool> keys = hive.map.new()
	for each f in fields {
		clashingKey(c, keys, f)
	}
	for each f in andShared {
		clashingKey(c, keys, f)
	}
}

proc clashingKey(c: mut Check, keys: mut hive.map.Map<Str, Bool>, f: ast.Field): void {
	key := ast.jsonKey(f)
	if hive.map.has(keys, key) {
		report(c, "two fields here are `{key}` in JSON, and one key cannot be read into two fields. Give one of them a `-- JSON as ...;` of its own")
	}
	hive.map.set(keys, key, true)
}

// Only a type without variants travels as a query string, so only its
// parameters can clash.
proc reportUrlClashes(c: mut Check, fields: ast.Field[]): void {
	mut hive.map.Map<Str, Bool> keys = hive.map.new()
	for each f in fields {
		key := ast.urlKey(f)
		if hive.map.has(keys, key) {
			report(c, "two fields here are `{key}` in a query string, and one parameter cannot be read into two fields. Give one of them a `-- URL as ...;` of its own")
		}
		hive.map.set(keys, key, true)
	}
}

proc reportFlagClashes(c: mut Check, fields: ast.Field[]): void {
	mut hive.map.Map<Str, Bool> keys = hive.map.new()
	for each f in fields {
		key := ast.flagKey(f)
		if hive.map.has(keys, key) {
			report(c, "two fields here are `--{key}` on a command line, and one flag cannot be read into two fields. Give one of them a `-- Flag as ...;` of its own")
		}
		hive.map.set(keys, key, true)
	}
}

// What a literal is, which is the whole of what a `Default` may be — the parser
// accepts nothing else there, so this needs no scope to answer.
func literalType(e: ast.Expr): types.Ty {
	if e is ast.Expr.IntLit(_) { return types.Ty.TInt() }
	if e is ast.Expr.FloatLit(_) { return types.Ty.TFloat() }
	if e is ast.Expr.StrLit(_) { return types.Ty.TStr() }
	if e is ast.Expr.BoolLit(_) { return types.Ty.TBool() }
	if e is ast.Expr.AtomLit(_) { return types.Ty.TAtom() }
	return types.Ty.TUnknown()
}

proc checkCallable(c: mut Check, env: infer.Env, name: Str, params: ast.Param[], body: ast.Block): void {
	mut Str[dyn] seen = []
	if name == "main" && (len(params) > 0 || (c.result is types.Ty.TVoid) == false) {
		report(c, "`main` is where the program starts, so nothing calls it with arguments or reads what it answers: it is `proc main(): void`. The command line is `hive.term.args()`, and an exit status is `hive.term.exit(code)`")
	}
	c.declared = []
	c.blockStart = 0
	for each p in params {
		append(c.declared, p.name)
		if indexOf(seen, p.name) is Result.Ok(_) {
			report(c, "this declares the parameter `{p.name}` twice")
		}
		append(seen, p.name)
		// Only a `proc` may ask for the mutex itself. A `mut` value handed to a
		// `func` is seen as an ordinary immutable copy instead.
		if p.mutex && c.pure {
			report(c, "a `func` cannot declare the mutex parameter `{p.name}: mut ...`. What a `func` promises is that it cannot write to storage its caller can see, and a mutex is exactly that storage — make it a `proc`, or take an ordinary `{p.name}: ...` and answer with the new value")
		}
		if p.mutex {
			append(c.mutable, p.name)
		}
	}
	// The body's own top level is the parameters' scope too.
	checkStmts(c, infer.boundParams(env, params, 0), body.stmts, 0)

	// Every non-`void` callable must return on every path.
	if c.result is types.Ty.TVoid {
		return
	}
	if terminates(env.table, body) {
		return
	}
	missed := missedAtEnd(env.table, body)
	if missed != "" {
		report(c, "`{name}` answers with " + types.show(c.result) + ", so every path through it has to return one, and no branch of the else-less `if` chain it ends with takes " + missed + ". Give that a branch of its own, or end the chain with an `else`")
	} else {
		report(c, "`{name}` answers with " + types.show(c.result) + ", so every path through it has to return one. A path terminates by ending in `return` or `panic`, in `hive.term.exit`, in an `if`/`else` or a `switch` whose every branch terminates, or in an else-less `if`/`else if` chain that covers its subject's whole type. An `assert` does not: one that holds carries on past it")
	}
}

// --- Statements --------------------------------------------------------------

proc checkBlock(c: mut Check, env: infer.Env, b: ast.Block): infer.Env {
	mark := len(c.mutable)
	declaredMark := len(c.declared)
	outerStart := c.blockStart
	c.blockStart = declaredMark
	after := checkStmts(c, env, b.stmts, 0)
	restore(c, mark)
	c.blockStart = outerStart
	last := len(c.declared) - 1
	if declaredMark <= last && c.declared bounds declaredMark {
		if c.declared bounds last {
			drop(c.declared, declaredMark, last)
		}
	}
	return after
}

// A name one block declares once. An inner block may reuse an outer name, which
// is shadowing; the same block declaring it again would be two variables with no
// way to tell which a later line means.
proc declareName(c: mut Check, name: Str): void {
	if name == "_" {
		return
	}
	mut i := c.blockStart
	for ; i < len(c.declared); i++ {
		if c.declared bounds i && i >= 0 {
			if c.declared[i] == name {
				report(c, "`{name}` is already declared in this block. Assign to it — `{name} = ...`, declaring it `mut` — or give the new value a name of its own")
				return
			}
		}
	}
	append(c.declared, name)
}

// Each statement checked with the bindings of everything before it in scope.
// Recursion rather than a `mut infer.Env` through a loop: an `Env` carries the whole
// table, and a `mut` one is copied at every use to keep `8.3`'s invariant.
proc checkStmts(c: mut Check, env: infer.Env, stmts: ast.Stmt[], at: Int): infer.Env {
	if stmts bounds at {
		return checkStmts(c, checkStmt(c, env, stmts[at]), stmts, at + 1)
	}
	return env
}

proc restore(c: mut Check, mark: Int): void {
	last := len(c.mutable) - 1
	if mark <= last && c.mutable bounds mark {
		if c.mutable bounds last {
			drop(c.mutable, mark, last)
		}
	}
}

proc checkStmt(c: mut Check, env: infer.Env, s: ast.Stmt): infer.Env {
	if s is ast.Stmt.VarDecl(name, value, mutable, deferred) {
		checkExpr(c, env, value)
		ty := infer.typeOf(env, value)
		// `hive.map.new()` says empty and nothing about what it holds, so it has
		// to land somewhere that says.
		if isEmptyMap(value) {
			report(c, "`hive.map.new()` has to land somewhere that says what it holds: a declaration (`hive.map.Map<Str, Int> m = hive.map.new()`), a `return` whose callable declares a map, or an argument to a parameter declared as one. A `:=` binding reads the type off the value, and this one has none to give")
		}
		// A name says where a service is, and nothing about what it takes.
		if isAtCall(value) && ty is types.Ty.TAddress(types.Ty.TUnknown) {
			report(c, "`at` has to land somewhere that says what the service takes: a declaration (`Address<Op> counter = at(#Counter)`), a `return` whose callable declares an address, or an argument to a parameter or field declared as one. A `:=` binding reads the type off the value, and this one has none to give")
		}
		checkHoldsValue(c, name, ty, deferred)
		declareName(c, name)
		if mutable {
			append(c.mutable, name)
		}
		return infer.bound(env, name, ty)
	} else if s is ast.Stmt.TypedDecl(declared, name, value, mutable, deferred) {
		checkExpr(c, env, value)
		ty := types.resolve(env.table, declared)
		checkLibTypes(c, ty)
		checkHoldsValue(c, name, infer.typeOf(env, value), deferred)
		if deferred == false {
			fits(c, ty, infer.typeOf(env, value), "the declaration of `{name}`")
		}
		declareName(c, name)
		if mutable {
			append(c.mutable, name)
		}
		return infer.bound(env, name, ty)
	} else if s is ast.Stmt.Assign(target, value) {
		checkAssign(c, env, target, value)
		return env
	} else if s is ast.Stmt.ReturnStmt(value) {
		checkReturn(c, env, value)
		return env
	} else if s is ast.Stmt.IfChain(branches, otherwise, hasElse) {
		for each b in branches {
			checkCondition(c, env, b.condition)
			checkBlock(c, afterCondition(env, b.condition), b.body)
		}
		if hasElse {
			checkBlock(c, env, otherwise)
		}
		return env
	} else if s is ast.Stmt.SwitchStmt(lets, subjects, arms, line) {
		checkSwitch(c, env, lets, subjects, arms, line)
		return env
	}
	return checkStmtTail(c, env, s)
}

proc checkSwitch(c: mut Check, env: infer.Env, lets: ast.Stmt[], subjects: ast.Expr[], arms: ast.Branch[], line: Int): void {
	before := len(c.errors)
	inner := checkLets(c, env, lets, line, 0)
	for each subject in subjects {
		checkExpr(c, inner, subject)
	}
	for each arm in arms {
		checkCondition(c, inner, arm.condition)
	}
	// Coverage over a pattern already found wrong would only repeat the mistake.
	clean := len(c.errors) == before
	for each arm in arms {
		checkBlock(c, afterCondition(inner, arm.condition), arm.body)
	}
	if clean {
		checkCover(c, subjects, arms, line)
	}
}

proc checkLets(c: mut Check, env: infer.Env, lets: ast.Stmt[], line: Int, at: Int): infer.Env {
	if lets bounds at {
		if lets[at] is ast.Stmt.VarDecl(name, value, _, _) {
			checkExpr(c, env, value)
			ty := infer.typeOf(env, value)
			if ty is types.Ty.TVoid {
				reportAt(c, line, "this `switch` tests a call that answers with nothing, so there is nothing for its arms to match")
			}
			return checkLets(c, infer.bound(env, name, ty), lets, line, at + 1)
		}
		return checkLets(c, env, lets, line, at + 1)
	}
	return env
}

proc checkCover(c: mut Check, subjects: ast.Expr[], arms: ast.Branch[], line: Int): void {
	for each n in cover.deadArms(c.table, subjects, arms) {
		reportAt(c, line, "arm {n} of this `switch` can never run: the arms above it take every value it would. Take it out, or move it above the arm that takes its values")
	}
	rest := wildcards(len(subjects))
	if len(arms) == 0 {
		reportAt(c, line, "this `switch` has no arms, and it has to take every value it tests — an arm of `{rest}` takes anything")
		return
	}
	if cover.unmatched(c.table, subjects, arms) is Result.Ok(value) {
		if value == rest {
			reportAt(c, line, "the arms of this `switch` cannot take every value it tests: no finite set of patterns covers a number, an atom or a string, so a `switch` over one ends with `{rest}`")
		} else {
			reportAt(c, line, "no arm of this `switch` takes `{value}`. Give that an arm of its own, or end the `switch` with `{rest}`")
		}
	}
}

func wildcards(n: Int): Str {
	mut Str[dyn] out = []
	for i := 0; i < n; i++ {
		append(out, "_")
	}
	return join(out, ", ")
}

// A call that answers with nothing leaves a name nothing to hold.
proc checkHoldsValue(c: mut Check, name: Str, ty: types.Ty, deferred: Bool): void {
	if (ty is types.Ty.TVoid) == false {
		return
	}
	if deferred {
		report(c, "an `async` binding keeps what a call answers with, and this call answers with nothing — so there is nothing for `{name}` to hold. Fire it off as a statement of its own, `async f(...)`, or put it in an await-all with the others it should finish beside")
		return
	}
	report(c, "this call answers with nothing, so there is nothing for `{name}` to hold. Make it a statement of its own")
}

proc checkStmtTail(c: mut Check, env: infer.Env, s: ast.Stmt): infer.Env {
	if s is ast.Stmt.ForLoop(init, cond, post, body) {
		mark := len(c.mutable)
		// The counter belongs to the loop, not to the block around it.
		declaredMark := len(c.declared)
		outerStart := c.blockStart
		c.blockStart = declaredMark
		inner := checkStmt(c, env, init)
		if cond is ast.Expr.Absent {
		} else {
			checkCondition(c, inner, cond)
		}
		checkStmt(c, inner, post)
		c.loops = c.loops + 1
		checkBlock(c, inner, body)
		c.loops = c.loops - 1
		restore(c, mark)
		c.blockStart = outerStart
		last := len(c.declared) - 1
		if declaredMark <= last && c.declared bounds declaredMark {
			if c.declared bounds last {
				drop(c.declared, declaredMark, last)
			}
		}
		return env
	} else if s is ast.Stmt.ForEach(name, declared, subject, body) {
		checkExpr(c, env, subject)
		subjectType := infer.typeOf(env, subject)
		// A turn of the loop would have to be handed a map's key or its value,
		// and the syntax never said which.
		if subjectType is types.Ty.TMap(_, _) {
			report(c, "a map is reached by key, never by position, so `for each` over one says nothing about what a turn is handed. Walk `hive.map.keys(m)` and look each one up")
		} else if subjectType is types.Ty.TStr {
			report(c, "a `Str` is not a vector, so there is nothing for `for each` to walk. `split(s, \"\")` is its characters")
		}
		mut elementType := types.elementOf(subjectType)
		if declared is ast.TypeExpr.VoidType {
		} else {
			written := types.resolve(env.table, declared)
			fits(c, written, elementType, "the type written for `{name}`")
			elementType = written
		}
		c.loops = c.loops + 1
		checkBlock(c, infer.bound(env, name, elementType), body)
		c.loops = c.loops - 1
		return env
	} else if s is ast.Stmt.BreakStmt || s is ast.Stmt.ContinueStmt {
		if c.loops == 0 {
			report(c, "`break` and `continue` act on the innermost enclosing loop, and there is none here")
		}
		return env
	} else if s is ast.Stmt.EchoStmt(value) {
		checkExpr(c, env, value)
		checkShown(c, env, value, "`echo`")
		return env
	} else if s is ast.Stmt.AssertStmt(condition) {
		checkCondition(c, env, condition)
		return env
	} else if s is ast.Stmt.PanicStmt(value) {
		checkExpr(c, env, value)
		checkShown(c, env, value, "`panic`")
		return env
	} else if s is ast.Stmt.AsyncStmt(call) {
		checkAsync(c, env, call)
		return env
	} else if s is ast.Stmt.Expression(value) {
		checkStatementExpr(c, env, value)
		return env
	}
	return env
}

proc checkReturn(c: mut Check, env: infer.Env, value: ast.Expr): void {
	if value is ast.Expr.Absent {
		if c.result is types.Ty.TVoid {
			return
		}
		report(c, "this `return` answers with nothing, and the declaration says " + types.show(c.result))
		return
	}
	if c.inTest {
		report(c, "a test returns nothing: it is run by the suite and never called, so there is nobody to answer. A bare `return` to leave early is fine")
		return
	}
	checkExpr(c, env, value)
	if c.result is types.Ty.TVoid {
		report(c, "this `return` answers with a value, and the declaration says `void`")
		return
	}
	fits(c, c.result, infer.typeOf(env, value), "this `return`")
}

proc checkAssign(c: mut Check, env: infer.Env, target: ast.Expr, value: ast.Expr): void {
	checkExpr(c, env, value)
	checkExpr(c, env, target)
	// A `Str` is read by position but never written by one: it is a value rather
	// than storage, so there is nothing behind `s[0]` to assign into — and a
	// character written over one of a different width would move every character
	// after it.
	if writesIntoStr(env, target) {
		report(c, "a `Str` cannot be assigned into by position: it is a value rather than storage, and characters are not all the same width, so writing one would move every character after it. Build the new string instead — `s = s[:i - 1] + c + s[i + 1:]`")
		return
	}
	root := rootName(target)
	if root == "" {
		report(c, "this is not something that can be assigned to: a target is a name, or a path into one through its fields and elements")
		return
	}
	if isMutable(c.mutable, root) == false {
		report(c, "cannot assign to `{root}`: it is immutable — declare it with `mut` to allow reassignment")
		return
	}
	if target is ast.Expr.Member(owner, _) && types.isUnion(env.table, infer.typeOf(env, owner)) {
		report(c, "a value of a union is taken apart with `is` and built whole, so one of its fields is not assigned on its own. Build the variant again with the new value")
		return
	}
	fits(c, infer.typeOf(env, target), infer.typeOf(env, value), "the assignment to `{root}`")
}

// Whether a target writes through a `Str`'s subscript, at any depth: `s[0]` and
// `rows[2][1]` where the row is a `Str` are the same mistake.
func writesIntoStr(env: infer.Env, target: ast.Expr): Bool {
	if target is ast.Expr.Index(subject, _) {
		return infer.typeOf(env, subject) is types.Ty.TStr
	}
	return false
}

// The name a target is a path into: `v`, `v[0]`, `rec.f` and `b.items[2]` all
// answer with the variable at the bottom, whose mutability decides.
func rootName(target: ast.Expr): Str {
	if target is ast.Expr.Ident(name) { return name }
	if target is ast.Expr.Member(subject, _) { return rootName(subject) }
	if target is ast.Expr.Index(subject, _) { return rootName(subject) }
	return ""
}

func isMutable(mutable: Str[], name: Str): Bool {
	return indexOf(mutable, name) is Result.Ok(_)
}

// A condition is a `Bool` and nothing else. There is no truthiness in Hive: an
// atom is a label rather than a yes or a no, and a number is a number.
proc checkCondition(c: mut Check, env: infer.Env, condition: ast.Expr): void {
	checkExpr(c, env, condition)
	ty := infer.typeOf(env, condition)
	if ty is types.Ty.TBool || ty is types.Ty.TUnknown {
		return
	}
	if ty is types.Ty.TAtom {
		report(c, "an atom is a label, not a yes or a no, so it cannot be a condition. Compare it with the one you mean — `if flag == #Ready` — or use a `Bool`")
		return
	}
	report(c, "a condition is a `Bool`, and this one is " + types.show(ty) + ". There is no truthiness in Hive: say what you are comparing it to")
}

// What `!` takes. The same rule a condition is held to — there is no truthiness, so
// there is nothing to invert but a `Bool` — said separately because a `!` may be
// stored, returned or passed as an argument, and each has to refuse the same operand.
proc checkNegated(c: mut Check, env: infer.Env, operand: ast.Expr): void {
	ty := infer.typeOf(env, operand)
	if ty is types.Ty.TBool || ty is types.Ty.TUnknown {
		return
	}
	if ty is types.Ty.TAtom {
		report(c, "an atom is a label, not a yes or a no, so there is nothing about it for `!` to invert. Compare it with the one you mean — `flag != #Ready` — or use a `Bool`")
		return
	}
	report(c, "`!` inverts a `Bool`, and this is " + types.show(ty) + ". There is no truthiness in Hive, so there is nothing here to be the opposite of: say what you are comparing it to")
}

// The scope a condition leaves behind, which is whatever its patterns bound.
func afterCondition(env: infer.Env, condition: ast.Expr): infer.Env {
	return infer.narrowed(env, condition)
}

// --- Expressions -------------------------------------------------------------

proc checkExpr(c: mut Check, env: infer.Env, e: ast.Expr): void {
	if e is ast.Expr.Call(callee, args) {
		checkCall(c, env, callee, args)
	} else if e is ast.Expr.Binary(op, left, right) {
		checkExpr(c, env, left)
		// A binding an `is` made is usable in the rest of the same condition after
		// `&&`, which is why the two are told apart here.
		if op is ast.BinOp.And {
			narrowed := afterCondition(env, left)
			checkExpr(c, narrowed, right)
			checkOperands(c, narrowed, op, left, right)
		} else {
			checkExpr(c, env, right)
			checkOperands(c, env, op, left, right)
		}
	} else if e is ast.Expr.Negate(operand) {
		checkExpr(c, env, operand)
		ty := infer.typeOf(env, operand)
		if (ty is types.Ty.TInt || ty is types.Ty.TFloat || ty is types.Ty.TUnknown) == false {
			report(c, "unary `-` negates an `Int` or a `Float`, and this is " + types.show(ty))
		}
	} else if e is ast.Expr.AwaitAll(calls, timeout) {
		checkAwaitAll(c, env, calls, timeout)
	} else if e is ast.Expr.Timed(call, ms) {
		checkExpr(c, env, call)
		fits(c, types.Ty.TInt(), infer.typeOf(env, ms), "the milliseconds `with timeout` waits")
		if infer.isSendExpr(env, call) == false && infer.typeOf(env, call) is types.Ty.TVoid {
			report(c, "`with timeout` answers with a `Result` of what the call answers, and this call answers with nothing, so there is no value to wait for. Fire it off with `async`, or have it answer with something")
		}
	} else if e is ast.Expr.Not(operand) {
		checkExpr(c, env, operand)
		checkNegated(c, env, operand)
	} else if e is ast.Expr.Index(subject, index) {
		checkExpr(c, env, subject)
		checkExpr(c, env, index)
		checkIndexable(c, env, subject)
	} else if e is ast.Expr.Slice(subject, low, high) {
		checkExpr(c, env, subject)
		checkExpr(c, env, low)
		checkExpr(c, env, high)
		checkIndexable(c, env, subject)
	} else if e is ast.Expr.VectorLit(items) {
		for each item in items {
			checkExpr(c, env, item)
		}
	} else if e is ast.Expr.Interp(parts) {
		for each part in parts {
			if part is ast.InterpPart.Expression(value) {
				checkExpr(c, env, value)
				checkShown(c, env, value, "an interpolation")
			}
		}
	} else if e is ast.Expr.IsMatch(subject, pattern) {
		checkExpr(c, env, subject)
		checkPattern(c, env, subject, pattern)
	} else if e is ast.Expr.Ident(name) {
		checkName(c, env, name)
	} else if e is ast.Expr.Member(subject, field) {
		checkMember(c, env, subject, field)
	}
}

// Only `reveal` opens a `Secret`, so nothing that shows a value shows one.
proc checkShown(c: mut Check, env: infer.Env, value: ast.Expr, what: Str): void {
	ty := infer.typeOf(env, value)
	if ty is types.Ty.TSecret(_) {
		report(c, what + " cannot show " + types.show(ty) + ": only `reveal` opens a `Secret`")
	} else if types.holdsSecret(c.table, ty) {
		report(c, what + " cannot show " + types.show(ty) + ", which holds a `Secret`: only `reveal` opens one")
	}
}

// A vector and a `Str` both have a subscript; a map does not — there is no
// first pair to ask for.
proc checkIndexable(c: mut Check, env: infer.Env, subject: ast.Expr): void {
	ty := infer.typeOf(env, subject)
	if ty is types.Ty.TMap(_, _) {
		report(c, "a map is reached by key, never by position: `hive.map.get(m, key)` is what this wants")
	}
}

proc checkName(c: mut Check, env: infer.Env, name: Str): void {
	if name == "_" || name == "hive" {
		return
	}
	if infer.isBound(env, name) {
		return
	}
	if types.findCallable(env.table, name) is Result.Ok(_) {
		return
	}
	if types.findType(env.table, name) is Result.Ok(_) {
		return
	}
	if name == "Result" {
		return
	}
	// A builtin is a name a *call* reaches, never a value. Several are overloaded
	// — `len` takes a vector, a `Str` or a map — so which one a bare reference
	// meant is decided by the argument types, and a value carries none. The same
	// reason a generic cannot be a value, with the same two ways out.
	if infer.isBuiltin(name) {
		report(c, "`{name}` is a builtin, so it cannot be used as a value: several builtins are overloaded, and which one a reference means is decided by the argument types a value does not carry. Call it, or wrap it in a `func` of your own — `func lengthOf(s: Str): Int \{ return hive.len(s) }`")
		return
	}
	report(c, "`{name}` is not a name anything here declared")
}

proc checkMember(c: mut Check, env: infer.Env, subject: ast.Expr, field: Str): void {
	// A `hive.<module>.<name>` is a library call and is checked where it is
	// called, not where the module is named.
	if subject is ast.Expr.Ident(head) {
		if head == "hive" {
			if infer.isBuiltin(field) {
				report(c, "`hive.{field}` is a builtin, so it cannot be used as a value: several builtins are overloaded, and which one a reference means is decided by the argument types a value does not carry. Call it, or wrap it in a `func` of your own")
			}
			return
		}
		if head == "Result" {
			return
		}
		if types.findType(env.table, head) is Result.Ok(_) {
			checkVariantValue(c, env, head, field)
			return
		}
	}
	if subject is ast.Expr.Member(root, module) {
		if root is ast.Expr.Ident(hiveName) {
			if hiveName == "hive" {
				if stdlib.isKnownModule(module) && stdlib.hasName(module, field) && stdlib.isLibType(module, field) == false {
					report(c, "`hive.{module}.{field}` is a library call, and a library call cannot be used as a value. Wrap it in a `func` of your own, and use that")
				}
				return
			}
		}
	}
	checkExpr(c, env, subject)
	ty := infer.typeOf(env, subject)
	if ty is types.Ty.TNamed(name) {
		if hasField(env.table, name, field) == false {
			report(c, "`" + types.shownName(name) + "` has no field `{field}`")
		} else if variantOnly(env.table, name, field) != "" {
			report(c, unsharedField(env.table, name, field))
		}
	} else if hasNoFields(ty) {
		report(c, "`" + types.show(ty) + "` has no field `{field}`" + shadowedModule(subject))
	}
}

func hasNoFields(ty: types.Ty): Bool {
	return ty is types.Ty.TStr || ty is types.Ty.TInt || ty is types.Ty.TFloat
		|| ty is types.Ty.TBool || ty is types.Ty.TAtom || ty is types.Ty.TAddress(_)
		|| ty is types.Ty.TSecret(_)
		|| ty is types.Ty.TFn(_, _, _, _) || ty is types.Ty.TVec(_, _)
		|| ty is types.Ty.TResult(_, _) || ty is types.Ty.TMap(_, _)
}

func shadowedModule(subject: ast.Expr): Str {
	if subject is ast.Expr.Ident(name) {
		if stdlib.isKnownModule(name) {
			return ": this `{name}` is the program's own, and the library module is `hive.{name}`"
		}
	}
	return ""
}

func unsharedField(t: types.Table, typeName: Str, field: Str): Str {
	shown := types.shownName(typeName)
	owner := variantOnly(t, typeName, field)
	mut holders := 0
	if types.findType(t, typeName) is Result.Ok(info) {
		for each v in info.variants {
			for each f in v.fields {
				if f.name == field {
					holders = holders + 1
				}
			}
		}
	}
	if holders > 1 {
		return "`{field}` is declared inside the variants of `{shown}` rather than outside them, so a `{shown}` value has it only once `is` says which variant it is. A field every variant carries is declared once, outside any variant, and then read straight off the value"
	}
	return "`{field}` belongs to the variant `{owner}` rather than to every `{shown}`, so it is read through the pattern that says which variant this is: `if value is {shown}.{owner}(...)`"
}

// The variant a union's field belongs to, when it is not one every variant has.
func variantOnly(t: types.Table, typeName: Str, field: Str): Str {
	if types.findType(t, typeName) is Result.Ok(info) {
		for each f in info.shared {
			if f.name == field {
				return ""
			}
		}
		for each v in info.variants {
			for each f in v.fields {
				if f.name == field {
					return v.name
				}
			}
		}
	}
	return ""
}

// A variant named where a value is wanted. Building one is a call — the same
// call a variant carrying fields is built by — so the name on its own is the
// variant rather than a value of it, and Go has nothing to make of it.
proc checkVariantValue(c: mut Check, env: infer.Env, head: Str, field: Str): void {
	if types.findVariant(env.table, head, field) is Result.Ok(fields) {
		if len(fields) == 0 {
			report(c, "`{head}.{field}` is a variant of `{head}`, and a variant is a value only once it is built: write `{head}.{field}()`. One that carries nothing is still built by calling it")
			return
		}
		report(c, "`{head}.{field}` is a variant of `{head}`, and a variant is a value only once it is built: `{head}.{field}(...)` builds one. Nor is a constructor a bare reference — `{head}.{field}(_)` is the spelling that is a function value")
	}
}

func hasField(t: types.Table, typeName: Str, field: Str): Bool {
	if types.findType(t, typeName) is Result.Ok(info) {
		for each f in info.shared {
			if f.name == field {
				return true
			}
		}
		for each v in info.variants {
			for each f in v.fields {
				if f.name == field {
					return true
				}
			}
		}
	}
	return false
}

// There is no implicit numeric widening anywhere, so an operator's two sides
// have to be the same type — the rule that makes `hive.math.max(0, health)` a
// compile error rather than a surprise.
proc checkOperands(c: mut Check, env: infer.Env, op: ast.BinOp, left: ast.Expr, right: ast.Expr): void {
	leftType := infer.typeOf(env, left)
	rightType := infer.typeOf(env, right)
	if leftType is types.Ty.TUnknown || rightType is types.Ty.TUnknown {
		return
	}
	if op is ast.BinOp.And || op is ast.BinOp.Or {
		if leftType is types.Ty.TBool && rightType is types.Ty.TBool {
			return
		}
		report(c, "`" + ast.opSpelling(op) + "` joins two `Bool`s, and these are " + types.show(leftType) + " and " + types.show(rightType))
		return
	}
	if types.operandsFit(leftType, rightType) == false {
		report(c, "`" + ast.opSpelling(op) + "` wants two of one type, and these are " + types.show(leftType) + " and " + types.show(rightType) + whyMixed(leftType, rightType))
		return
	}
	checkOperandKind(c, op, leftType)
}

// What each operator is defined on (5.6), once both sides are the same type.
proc checkOperandKind(c: mut Check, op: ast.BinOp, ty: types.Ty): void {
	spelled := "`" + ast.opSpelling(op) + "`"
	number := ty is types.Ty.TInt || ty is types.Ty.TFloat
	if op is ast.BinOp.Eq || op is ast.BinOp.Neq {
		if types.holds(c.table, ty, isFunction, []) {
			report(c, spelled + " compares two values, and a function value has no equality to compare — two that do the same thing cannot be told from two that do not. Compare what they answer with instead")
		}
	} else if op is ast.BinOp.Lt || op is ast.BinOp.Gt || op is ast.BinOp.Le || op is ast.BinOp.Ge {
		if (number || ty is types.Ty.TStr) == false {
			report(c, spelled + " orders an `Int`, a `Float` or a `Str`, and these are " + types.show(ty) + ". `sort` with a comparator of your own is how anything else is put in order")
		}
	} else if op is ast.BinOp.Add {
		if (number || ty is types.Ty.TStr || ty is types.Ty.TVec(_, _)) == false {
			report(c, "`+` adds two numbers, joins two `Str`s or joins two vectors, and these are " + types.show(ty))
		}
	} else if op is ast.BinOp.And || op is ast.BinOp.Or {
	} else if number == false {
		report(c, spelled + " is arithmetic, on an `Int` or a `Float`, and these are " + types.show(ty))
	}
}

func isFunction(ty: types.Ty): Bool {
	return ty is types.Ty.TFn(_, _, _, _)
}

// --- Calls -------------------------------------------------------------------

proc checkCall(c: mut Check, env: infer.Env, callee: ast.Expr, args: ast.Arg[]): void {
	for each a in args {
		if a.value is ast.Expr.Hole {
			continue
		}
		checkExpr(c, env, a.value)
	}
	if infer.typeOf(env, callee) is types.Ty.TAddress(mailbox) {
		checkSend(c, env, callee, mailbox, args)
	}
	if callee is ast.Expr.Ident(name) {
		checkNamedCall(c, env, name, args)
		return
	}
	if callee is ast.Expr.Member(subject, field) {
		checkMemberCall(c, env, subject, field, args)
		return
	}
	checkExpr(c, env, callee)
	if infer.typeOf(env, callee) is types.Ty.TFn(_, params, mutexes, _) {
		checkValueArguments(c, env, "this function value", params, mutexes, args)
	}
}

// A send carries one message, of the type the address says its service takes.
proc checkSend(c: mut Check, env: infer.Env, callee: ast.Expr, mailbox: types.Ty, args: ast.Arg[]): void {
	if len(args) != 1 {
		report(c, "a send carries one message, and this passes " + countOf(len(args)))
		return
	}
	if mailbox is types.Ty.TUnknown {
		if isAtCall(callee) {
			report(c, "`at` says where a service is and nothing about what it takes, so a message cannot be sent straight to what it answers with. Land it somewhere that says: `Address<Op> counter = at(#Counter)`")
		}
		return
	}
	fits(c, mailbox, typeOfArg(c, env, args, 0), "the message sent to an `" + types.show(types.Ty.TAddress(mailbox)) + "`")
}

proc checkNamedCall(c: mut Check, env: infer.Env, name: Str, args: ast.Arg[]): void {
	// A local binding shadows a declaration, which shadows a builtin, so a call
	// through one calls whatever the binding holds. That order is `callTarget`,
	// which inference and the emitter read the same call through.
	target := infer.callTarget(env, name)
	if target is infer.CallTarget.Bound {
		checkCallableValue(c, env, name)
		if infer.typeOf(env, ast.Expr.Ident(name)) is types.Ty.TFn(_, params, mutexes, _) {
			checkValueArguments(c, env, "`{name}`", params, mutexes, args)
		}
	} else if target is infer.CallTarget.Declared(info) {
		checkArguments(c, env, name, info, args)
	} else if target is infer.CallTarget.Struct(fields) {
		checkFieldArguments(c, env, name, fields, args)
	} else if target is infer.CallTarget.Builtin {
		checkBuiltinCall(c, env, name, args)
	} else if target is infer.CallTarget.Union {
		report(c, "`" + types.shownName(name) + "` is a tagged union, so a value of it is built by naming the variant: `" + types.shownName(name) + ".SomeVariant(...)`")
	} else {
		report(c, "`{name}` is not a name anything here declared")
	}
}

// What a name has to hold for a call through it to mean something: a callable value,
// or an address, which a call sends to and waits for the answer of. `TUnknown` and a
// type variable are not complained about, having been complained about already.
proc checkCallableValue(c: mut Check, env: infer.Env, name: Str): void {
	ty := infer.typeOf(env, ast.Expr.Ident(name))
	if ty is types.Ty.TFn(_, _, _, _) {
		return
	}
	if ty is types.Ty.TUnknown {
		return
	}
	if ty is types.Ty.TVar(_) {
		return
	}
	if ty is types.Ty.TAddress(_) {
		return
	}
	report(c, "`{name}` here is " + types.show(ty) + ", which is not something a call can reach through. A local binding shadows a declaration of the same name, so the `{name}` this calls is the one bound above it rather than any callable")
}

proc checkMemberCall(c: mut Check, env: infer.Env, subject: ast.Expr, field: Str, args: ast.Arg[]): void {
	if subject is ast.Expr.Ident(head) {
		if head == "Result" {
			if field != "Ok" && field != "Error" {
				report(c, "`Result` has two variants, `Ok` and `Error`, and `{field}` is neither")
			} else if len(args) != 1 {
				report(c, "`Result.{field}` carries exactly one payload, and this call passes " + countOf(len(args)))
			}
			return
		}
		if head == "hive" {
			checkBuiltinCall(c, env, field, args)
			return
		}
		if head == "Table" && field == "decode" {
			report(c, stdlib.tableHasNoDecoder())
			return
		}
		shown := types.shownName(head)
		if types.findType(env.table, head) is Result.Ok(info) {
			// `T.decode(text, codec)` is the decoder, not a variant.
			if field == "decode" {
				checkDecodes(c, env, "`" + shown + ".decode`", head, args)
				return
			}
			if types.findVariant(env.table, head, field) is Result.Ok(fields) {
				checkFieldArguments(c, env, shown + "." + field, fields, args)
			} else {
				report(c, "`" + shown + "` has no variant `{field}`")
			}
			return
		}
	}
	if subject is ast.Expr.Member(root, module) {
		// `T.Variant.decode(text, codec)` — the one variant's own decoder.
		if field == "decode" {
			if root is ast.Expr.Ident(head) {
				shown := types.shownName(head)
				if stdlib.isJsonValue(head) {
					report(c, "a document says for itself which variant of `{shown}` it is, so it is read whole: `{shown}.decode(text, codec)`")
					return
				}
				if types.findType(env.table, head) is Result.Ok(_) {
					if types.findVariant(env.table, head, module) is Result.Ok(_) {
						checkDecodes(c, env, "`" + shown + "." + module + ".decode`", head, args)
					} else {
						report(c, "`" + shown + "` has no variant `{module}`, so there is no `{module}.decode` to call. Its variants are " + join(types.variantNames(env.table, head), ", "))
					}
					return
				}
			}
		}
		if root is ast.Expr.Ident(hiveName) {
			if hiveName == "hive" {
				if stdlib.isKnownModule(module) == false {
					report(c, "this compiler does not carry `hive.{module}`")
				} else if stdlib.hasName(module, field) == false {
					report(c, "`hive.{module}` has no `{field}`")
				} else {
					checkLibraryArguments(c, env, module, field, args)
				}
				return
			}
		}
		// `hive.ui.TextSize.Caption()` — a variant of one of the library's own
		// enumerations. Nothing downstream can refuse a name that is not one: it
		// lowers to a member of a member and the Go toolchain reports it.
		if root is ast.Expr.Member(head, libModule) {
			if head is ast.Expr.Ident(rootName) && rootName == "hive" {
				variants := stdlib.variantsOf(libModule, module)
				if len(variants) > 0 {
					if indexOf(variants, field) is Result.Error(_) {
						report(c, "`hive.{libModule}.{module}` has no variant `{field}`. Its variants are " + join(variants, ", "))
					}
					return
				}
				if stdlib.isKnownModule(libModule) == false {
					report(c, "this compiler does not carry `hive.{libModule}`")
					return
				}
				if stdlib.isLibType(libModule, module) == false {
					report(c, "`hive.{libModule}` has no `{module}`")
					return
				}
			}
		}
	}
	checkMember(c, env, subject, field)
	// A call through a function value is checked by what the value's type says.
	ty := infer.typeOf(env, ast.Expr.Member(subject, field))
	if ty is types.Ty.TFn(_, params, mutexes, _) {
		checkValueArguments(c, env, "`{field}`", params, mutexes, args)
	}
}

proc checkValueArguments(c: mut Check, env: infer.Env, shown: Str, params: types.Ty[], mutexes: Bool[], args: ast.Arg[]): void {
	if len(params) != len(args) {
		report(c, shown + " takes " + countOf(len(params)) + ", and this call passes " + countOf(len(args)))
		return
	}
	partial := hasHole(args)
	mut i := 0
	for each a in args {
		if a.name != "" {
			report(c, shown + " is a function value, whose parameters have no names, so `{a.name}` has to be passed by position")
			return
		}
		if a.value is ast.Expr.Hole {
			i = i + 1
			continue
		}
		if types.mutexAt(mutexes, i) {
			checkMutexArgument(c, shown, "parameter {i + 1}", a.value, partial)
		}
		if params bounds i {
			fits(c, params[i], infer.typeOf(env, a.value), "argument {i + 1} of " + shown)
		}
		i = i + 1
	}
}

proc checkMutexArgument(c: mut Check, shown: Str, param: Str, found: ast.Expr, partial: Bool): void {
	if partial {
		report(c, shown + " asks for the mutex itself in {param}, and a partial application captures what it is given by value, so the writes would land in a copy nobody sees. Leave it a hole, `_`, and hand the storage over where the result is called")
		return
	}
	root := rootName(found)
	if root == "" || isMutable(c.mutable, root) == false {
		report(c, shown + " asks for the mutex itself in {param}, so the argument has to be a `mut` variable or a path into one — this one is not")
	}
}

// What a standard library call takes: how many, where the table can say, and what
// each position holds. The type table is positional rather than a count, so the
// positions it has an answer for are checked and the rest left.
//
// Without it the mismatch reaches the Go toolchain, which reports it in terms of
// Go's own types — and a message that only said `float64` would leave the reader
// hunting for a conversion nobody mentioned.
proc checkLibraryArguments(c: mut Check, env: infer.Env, module: Str, name: Str, written: ast.Arg[]): void {
	// One of the library's own types being built takes its fields, matched by
	// name the way a declared type's are.
	fields := stdlib.fieldsOf(module, name)
	if len(fields) > 0 {
		checkFieldArguments(c, env, "hive.{module}.{name}", fields, written)
		return
	}
	if refusesHoles(c, "`hive.{module}.{name}`", written) {
		return
	}
	if checkArgumentNames(c, "hive.{module}.{name}", stdlib.paramNamesOf(module, name), written) == false {
		return
	}
	args := stdlib.libraryArgs(module, name, written)
	if module == "sql" && name == "run" {
		checkRunsQuery(c, env, args)
	}
	if module == "ui" && (name == "window" || name == "webview") && len(args) == 3 {
		checkWindow(c, env, name, ast.argFor(args, "", 1), ast.argFor(args, "", 2))
	}
	// The notice is posted to the watcher, so it is one of the watcher's messages.
	if module == "syslink" && name == "monitor" && len(args) == 3 {
		if infer.typeOf(env, ast.argFor(args, "", 0)) is types.Ty.TAddress(mailbox) {
			fits(c, mailbox, typeOfArg(c, env, args, 2), "the notice `hive.syslink.monitor` posts to the watcher")
		}
	}
	if stdlib.signatureOf(module, name) is Result.Ok(wanted) {
		if len(args) != len(wanted) {
			report(c, "`hive.{module}.{name}` takes " + countOf(len(wanted)) + ", and this call passes " + countOf(len(args)))
			return
		}
		names := stdlib.paramNamesOf(module, name)
		named := ast.anyNamed(written)
		mut i := 0
		for each a in args {
			if a.value is ast.Expr.Hole {
				i = i + 1
				continue
			}
			// A call that named its arguments is told about them by name.
			mut which := "the " + nth(i) + " argument"
			if named && names bounds i {
				which = "the argument `" + names[i] + "`"
			}
			if wanted bounds i {
				fits(c, wanted[i], infer.typeOf(env, a.value), which + " of `hive.{module}.{name}`")
			}
			i = i + 1
		}
	}
}

proc checkSpawn(c: mut Check, env: infer.Env, args: ast.Arg[]): void {
	if len(args) != 2 && len(args) != 3 {
		report(c, "`spawn` takes a handler, the state it starts with and, optionally, the name to register it under — and this call passes " + countOf(len(args)))
		return
	}
	if checkHandler(c, env, "`spawn`", ast.argFor(args, "", 0)) {
		if infer.typeOf(env, ast.argFor(args, "", 0)) is types.Ty.TFn(_, params, _, _) {
			fits(c, infer.typeAt(params, 0), typeOfArg(c, env, args, 1), "the state `spawn` starts the service with")
		}
	}
	if len(args) == 3 {
		fits(c, types.Ty.TAtom(), typeOfArg(c, env, args, 2), "the name `spawn` registers the service under")
	}
}

proc checkAt(c: mut Check, env: infer.Env, args: ast.Arg[]): void {
	if len(args) == 1 {
		fits(c, types.Ty.TAtom(), typeOfArg(c, env, args, 0), "the name `at` reaches")
		return
	}
	if len(args) == 2 {
		fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 0), "the endpoint of the node `at` reaches")
		fits(c, types.Ty.TAtom(), typeOfArg(c, env, args, 1), "the name `at` reaches")
		return
	}
	report(c, "`at` takes the name a service is registered under, or the endpoint of the node it is on and that name — and this call passes " + countOf(len(args)))
}

proc checkHandler(c: mut Check, env: infer.Env, starts: Str, handler: ast.Expr): Bool {
	ty := infer.typeOf(env, handler)
	if ty is types.Ty.TUnknown {
		return false
	}
	shape := "`proc(mut S, M): M`, or `proc(mut S, M, Address<M>): M` to be handed its own address"
	if ty is types.Ty.TFn(_, params, mutexes, result) {
		if len(params) != 2 && len(params) != 3 {
			report(c, "{starts} wants a handler of the shape " + shape + ", and this one has {len(params)} parameters")
			return false
		}
		if types.mutexAt(mutexes, 0) == false {
			report(c, "a handler writes its state in place, so its first parameter takes the mutex itself: `state: mut "
				+ types.show(infer.typeAt(params, 0)) + "`, which is what {starts} hands it")
			return false
		}
		if types.mutexAt(mutexes, 1) {
			report(c, "a handler is handed its message, never lent it, so its second parameter cannot take the mutex itself")
			return false
		}
		message := infer.typeAt(params, 1)
		if types.same(result, message) == false {
			report(c, "a handler answers with one of its own messages, so it returns " + types.show(message)
				+ ", and this one returns " + types.show(result))
			return false
		}
		own := types.Ty.TAddress(message)
		if len(params) == 3 && types.same(infer.typeAt(params, 2), own) == false {
			report(c, "a handler with a third parameter is handed its own address there, an `" + types.show(own)
				+ "`, and this one takes " + types.show(infer.typeAt(params, 2)))
			return false
		}
		return true
	}
	report(c, "{starts} starts a service from a handler, " + shape + ", and this is " + types.show(ty))
	return false
}

proc checkWindow(c: mut Check, env: infer.Env, name: Str, view: ast.Expr, update: ast.Expr): void {
	if checkHandler(c, env, "`hive.ui.{name}`", update) == false {
		return
	}
	mut state := types.Ty.TUnknown()
	if infer.typeOf(env, update) is types.Ty.TFn(_, params, _, _) {
		state = infer.typeAt(params, 0)
	}
	fits(c, types.Ty.TFn(true, [state], [false], types.Ty.TLib("ui", "View")), infer.typeOf(env, view),
		"the view `hive.ui.{name}` draws the state with")
}

// `hive.sql.run` is the one library call whose second argument has a shape
// rather than a type: a fragment of some row type, which is what tells it how to
// read what comes back. Nothing downstream can refuse a wrong one — the emitter
// needs the row type before it can write the mapper — so it is refused here.
proc checkRunsQuery(c: mut Check, env: infer.Env, args: ast.Arg[]): void {
	if len(args) < 2 {
		report(c, "`hive.sql.run` takes a connection and the query to run, and this names only one of the two")
		return
	}
	if args bounds 1 {
		asked := args[1].value
		if asked is ast.Expr.Hole {
			return
		}
		held := infer.typeOf(env, asked)
		if held is types.Ty.TFragment(_) {
			return
		}
		if held is types.Ty.TUnknown {
			return
		}
		report(c, "the second argument of `hive.sql.run` is a `hive.sql.Fragment` — what calling a `query` declaration answers with — and this is " + types.show(held))
	}
}

// Why an `Int` beside a `Float` is refused, said only where that is what
// happened — anywhere else it would explain something that is not the mistake.
func whyMixed(left: types.Ty, right: types.Ty): Str {
	if isNumberPair(left, right) {
		return ". Hive never widens a number behind your back — `hive.conv.itf` is how an `Int` becomes a `Float`"
	}
	return ""
}

func isNumberPair(left: types.Ty, right: types.Ty): Bool {
	if left is types.Ty.TInt {
		return right is types.Ty.TFloat
	}
	if left is types.Ty.TFloat {
		return right is types.Ty.TInt
	}
	return false
}

proc checkArguments(c: mut Check, env: infer.Env, name: Str, info: types.CallableInfo, args: ast.Arg[]): void {
	if checkArgumentNames(c, name, namesOfParams(info.params), args) == false {
		return
	}
	if len(args) != len(info.params) {
		report(c, "`{name}` takes " + countOf(len(info.params)) + ", and this call passes " + countOf(len(args)))
		return
	}
	partial := hasHole(args)
	mut open := 0
	for each p in info.params {
		found := ast.argFor(args, p.name, open)
		if ast.claimedByName(args, p.name) == false {
			open = open + 1
		}
		if found is ast.Expr.Hole {
			continue
		}
		// A `mut T` parameter takes the caller's own storage, so the argument has
		// to be a `mut` variable or a path into one.
		if p.mutex {
			checkMutexArgument(c, "`{name}`", "`{p.name}: mut ...`", found, partial)
		}
		fits(c, types.resolve(env.table, p.declared), infer.typeOf(env, found), "the argument `{p.name}` of `{name}`")
	}
}

// Neither has a signature a function value could carry.
proc refusesHoles(c: mut Check, shown: Str, args: ast.Arg[]): Bool {
	if hasHole(args) {
		report(c, shown + " cannot be partially applied: a `_` makes a function value, and a builtin or a library call cannot become one. Wrap it in a `func` of your own, and partially apply that")
		return true
	}
	return false
}

func hasHole(args: ast.Arg[]): Bool {
	for each a in args {
		if a.value is ast.Expr.Hole {
			return true
		}
	}
	return false
}

proc checkFieldArguments(c: mut Check, env: infer.Env, name: Str, fields: ast.Field[], args: ast.Arg[]): void {
	if checkArgumentNames(c, name, namesOfFields(fields), args) == false {
		return
	}
	if len(args) != len(fields) {
		report(c, "`{name}` has " + fieldCount(len(fields)) + ", and this call passes " + countOf(len(args)))
		return
	}
	mut open := 0
	for each f in fields {
		found := ast.argFor(args, f.name, open)
		if ast.claimedByName(args, f.name) == false {
			open = open + 1
		}
		if found is ast.Expr.Hole {
			continue
		}
		fits(c, types.resolve(env.table, f.declared), infer.typeOf(env, found), "the field `{f.name}` of `{name}`")
	}
}

// Named arguments may appear anywhere; only the unnamed ones need to be in
// order. Names must exist, must not repeat, and once named arguments are used
// the call must cover the full parameter list.
proc checkArgumentNames(c: mut Check, name: Str, parameters: Str[], args: ast.Arg[]): Bool {
	mut Int[dyn] seen = []
	mut named := false
	for each a in args {
		if a.name == "" {
			continue
		}
		named = true
		slot := ast.slotNamed(parameters, a.name)
		if slot < 0 {
			report(c, "`{name}` has no parameter called `" + a.name + "`" + parameterList(parameters))
			return false
		}
		if indexOf(seen, slot) is Result.Ok(_) {
			report(c, "this call names `" + a.name + "` twice")
			return false
		}
		append(seen, slot)
	}
	if named && len(args) != len(parameters) {
		report(c, "once a call uses named arguments it has to cover the full parameter list, and `{name}` has " + countOf(len(parameters)))
		return false
	}
	return true
}

// The names a call could have used, for a message about one it could not.
func parameterList(parameters: Str[]): Str {
	if len(parameters) == 0 {
		return ": it takes no arguments"
	}
	mut Str[dyn] shown = []
	for each p in parameters {
		append(shown, "`" + join(split(p, "|"), "` or `") + "`")
	}
	return ". Its parameters are " + join(shown, ", ")
}

func namesOfParams(params: ast.Param[]): Str[dyn] {
	mut Str[dyn] out = []
	for each p in params {
		append(out, p.name)
	}
	return out
}

func namesOfFields(fields: ast.Field[]): Str[dyn] {
	mut Str[dyn] out = []
	for each f in fields {
		append(out, f.name)
	}
	return out
}

// Which argument, counted the way a person counts them.
func nth(index: Int): Str {
	if index == 0 { return "first" }
	if index == 1 { return "second" }
	if index == 2 { return "third" }
	if index == 3 { return "fourth" }
	return "argument {index}"
}

func countOf(n: Int): Str {
	if n == 0 {
		return "no arguments"
	}
	if n == 1 {
		return "1 argument"
	}
	return "{n} arguments"
}

func fieldCount(n: Int): Str {
	if n == 1 {
		return "1 field"
	}
	return "{n} fields"
}

// --- The builtins ------------------------------------------------------------

// Every builtin has a signature ([13](../spec/13-builtins.md)), and a call that
// does not match one is a compile error. Caught here rather than left to the
// generated Go, whose message would be about Go's types and a file nobody wrote.
proc checkBuiltinCall(c: mut Check, env: infer.Env, name: Str, written: ast.Arg[]): void {
	if refusesHoles(c, "`{name}`", written) {
		return
	}
	if checkArgumentNames(c, name, infer.builtinParams(name, len(written)), written) == false {
		return
	}
	args := infer.builtinArgs(name, written)
	if name == "append" || name == "prepend" {
		checkGrows(c, env, name, args, 2)
		// What goes in has to be what the vector holds.
		if len(args) == 2 {
			element := types.elementOf(typeOfArg(c, env, args, 0))
			fits(c, element, typeOfArg(c, env, args, 1), "what `{name}` puts in")
		}
	} else if name == "drop" {
		checkGrows(c, env, name, args, 3)
		if len(args) == 3 {
			fits(c, types.Ty.TInt(), typeOfArg(c, env, args, 1), "the low bound of `drop`")
			fits(c, types.Ty.TInt(), typeOfArg(c, env, args, 2), "the high bound of `drop`")
		}
	} else if name == "sort" {
		checkSort(c, env, args)
	} else if name == "map" || name == "filter" || name == "filterMap" {
		checkWalk(c, env, name, args)
	} else if name == "len" || name == "bytes" {
		checkMeasured(c, env, name, args)
	} else if name == "join" {
		if arity(c, name, args, 2) {
			fits(c, strings(), typeOfArg(c, env, args, 0), "what `join` concatenates")
			fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 1), "the separator `join` puts between elements")
		}
	} else if name == "split" {
		if arity(c, name, args, 2) {
			fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 0), "what `split` takes apart")
			fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 1), "the separator `split` cuts on")
		}
	} else if name == "replaceFirst" || name == "replaceAll" {
		if arity(c, name, args, 3) {
			fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 0), "what `{name}` rewrites")
			fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 1), "what `{name}` looks for")
			fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 2), "what `{name}` puts in its place")
		}
	} else if name == "indexOf" {
		checkIndexOf(c, env, args)
	} else if name == "spawn" {
		checkSpawn(c, env, args)
	} else if name == "at" {
		checkAt(c, env, args)
	} else if name == "kill" {
		if arity(c, name, args, 1) {
			fits(c, types.Ty.TAddress(types.Ty.TUnknown()), typeOfArg(c, env, args, 0), "what `kill` stops")
		}
	} else if name == "hide" || name == "bypass" {
		if arity(c, name, args, 1) {
			checkKeepable(c, "`{name}`", typeOfArg(c, env, args, 0))
		}
	} else if name == "reveal" {
		if arity(c, name, args, 1) {
			fits(c, types.Ty.TSecret(types.Ty.TUnknown()), typeOfArg(c, env, args, 0), "what `reveal` reads")
		}
	} else if name == "row" || name == "column" {
		if arity(c, name, args, 2) {
			fits(c, table(), typeOfArg(c, env, args, 0), "what `{name}` reads")
			fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 1), "the key `{name}` looks for")
		}
	} else if name == "toTable" {
		if arity(c, name, args, 2) {
			fits(c, strings(), typeOfArg(c, env, args, 0), "what `toTable` cuts into rows")
			fits(c, types.Ty.TInt(), typeOfArg(c, env, args, 1), "the row width `toTable` cuts at")
			checkRowWidth(c, args)
		}
	} else if name == "encode" {
		// Anything with a static type encodes as JSON, so beyond the count the
		// only thing to refuse is a codec whose type names no format — and a
		// value a flat format's parameters cannot hold.
		if arity(c, name, args, 2) {
			if args bounds 1 {
				format := stdlib.formatOfCodec(infer.typeOf(env, args[1].value))
				checkNamesCodec(c, env, "`encode`", args[1].value)
				checkFlatShape(c, "`encode`", typeOfArg(c, env, args, 0), format)
				checkJsonShape(c, "`encode`", typeOfArg(c, env, args, 0), format)
			}
		}
	}
}

// `sort(v)` orders a vector by its element type's own order; `sort(v, first)`
// orders it by a `func` answering whether its first element comes before its
// second.
func isEnumeration(module: Str, name: Str): Bool {
	return len(stdlib.variantsOf(module, name)) > 0
}

proc checkSort(c: mut Check, env: infer.Env, args: ast.Arg[]): void {
	if len(args) != 1 && len(args) != 2 {
		report(c, "`sort` takes a vector, and optionally the `func` that says which of two elements comes first")
		return
	}
	subject := typeOfArg(c, env, args, 0)
	if isVector(subject) == false && isUnknown(subject) == false {
		report(c, "`sort` orders a vector, and this is " + types.show(subject))
		return
	}
	element := types.elementOf(subject)
	if len(args) == 1 {
		if isVector(subject) && types.isOrdered(env.table, element, isEnumeration) == false {
			report(c, "`sort` puts a vector in its elements' own order, and " + types.show(element)
				+ " has none: a map, an address, a `Secret` and a function value have no order, and nor does a type holding one. Hand `sort` the `func` that says which of two comes first")
		}
		return
	}
	fits(c, types.Ty.TFn(true, [element, element], [false, false], types.Ty.TBool()), typeOfArg(c, env, args, 1),
		"the order `sort` was given")
}

// `len` counts a vector's elements, a `Str`'s characters or a map's pairs;
// `bytes` measures a vector's storage or a `Str`'s encoding.
proc checkMeasured(c: mut Check, env: infer.Env, name: Str, args: ast.Arg[]): void {
	if arity(c, name, args, 1) == false {
		return
	}
	subject := typeOfArg(c, env, args, 0)
	if isVector(subject) {
		return
	}
	if subject is types.Ty.TStr {
		return
	}
	// A measurement is one thing for a `Str` and another for a vector, and the
	// answer decides what is emitted. Waving an unknown through picked the
	// vector reading and left the mistake to the Go toolchain, or worse, counted
	// a `Str`'s bytes where its characters were asked for.
	if isUnknown(subject) {
		report(c, "`{name}` measures a vector or a `Str`" + mapToo(name) +
			", and what this is cannot be told from here")
		return
	}
	if subject is types.Ty.TMap(_, _) {
		if name == "len" {
			return
		}
		report(c, "`bytes` measures a vector's storage or a `Str`'s encoding, and a map is neither — a map's storage is not one contiguous thing to measure")
		return
	}
	report(c, "`{name}` measures a vector or a `Str`" + mapToo(name) + ", and this is " + types.show(subject))
}

func mapToo(name: Str): Str {
	if name == "len" {
		return " or a map"
	}
	return ""
}

// `indexOf` finds a value in a vector or a substring in a `Str`, and either way
// what is looked for has to be what could be there.
proc checkIndexOf(c: mut Check, env: infer.Env, args: ast.Arg[]): void {
	if arity(c, "indexOf", args, 2) == false {
		return
	}
	subject := typeOfArg(c, env, args, 0)
	if subject is types.Ty.TStr {
		fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 1), "what `indexOf` looks for in a `Str`")
		return
	}
	if isVector(subject) {
		fits(c, types.elementOf(subject), typeOfArg(c, env, args, 1), "what `indexOf` looks for")
		return
	}
	if isUnknown(subject) {
		report(c, "`indexOf` searches a vector or a `Str`, and what this is cannot be told from here")
		return
	}
	report(c, "`indexOf` searches a vector or a `Str`, and this is " + types.show(subject))
}

// A literal width below one could only hand back an empty `Table` — dead code
// wearing the shape of the form that works. A computed width is total instead.
proc checkRowWidth(c: mut Check, args: ast.Arg[]): void {
	if literalInt(ast.argFor(args, "", 1)) is Result.Ok(n) {
		if n < 1 {
			report(c, "`toTable` cuts a vector into rows of {n} cells, and a row holds at least one — this could only hand back an empty `Table`")
		}
	}
}

func literalInt(e: ast.Expr): Result<Int, Bool> {
	if e is ast.Expr.IntLit(n) {
		return Result.Ok(n)
	}
	if e is ast.Expr.Negate(operand) {
		if operand is ast.Expr.IntLit(n) {
			return Result.Ok(0 - n)
		}
	}
	return Result.Error(false)
}

// How many a builtin takes. Answers whether the call had that many, so what
// follows can read the arguments knowing they are there.
proc arity(c: mut Check, name: Str, args: ast.Arg[], wanted: Int): Bool {
	if len(args) == wanted {
		return true
	}
	report(c, "`{name}` takes " + countOf(wanted) + ", and this call passes " + countOf(len(args)))
	return false
}

// One argument's type, or `TUnknown` where a hole stands instead — a partial
// application says nothing about what will fill it.
proc typeOfArg(c: mut Check, env: infer.Env, args: ast.Arg[], index: Int): types.Ty {
	given := ast.argFor(args, "", index)
	if given is ast.Expr.Hole {
		return types.Ty.TUnknown()
	}
	return infer.typeOf(env, given)
}

func isVector(ty: types.Ty): Bool {
	return ty is types.Ty.TVec(_, _)
}

func isUnknown(ty: types.Ty): Bool {
	return ty is types.Ty.TUnknown
}

func strings(): types.Ty {
	return types.Ty.TVec(types.Ty.TStr(), ast.Dim.Any())
}

// `Table` is rows of cells: a vector of vectors of `Str`, any length either way.
func table(): types.Ty {
	return types.Ty.TVec(strings(), ast.Dim.Any())
}

// `map`, `filter` and `filterMap` each walk a vector with a function over its
// elements, and each is specific about what that function answers with.
proc checkWalk(c: mut Check, env: infer.Env, name: Str, args: ast.Arg[]): void {
	if len(args) != 2 {
		report(c, "`{name}` takes the vector to walk and the `func` to walk it with, and this call passes " + countOf(len(args)))
		return
	}
	ty := infer.typeOf(env, ast.argFor(args, "", 1))
	if ty is types.Ty.TUnknown {
		return
	}
	if ty is types.Ty.TFn(pure, params, _, result) {
		// A walk says nothing about the order its function runs in or how often,
		// so there is nowhere to hang a side effect. A `for each` loop does say.
		if pure == false {
			report(c, "`{name}` walks with a `func`, never a `proc`: it says nothing about the order it runs in or how often, so there is nowhere to hang a side effect. Write a `for each` loop, which does say")
			return
		}
		if len(params) != 1 {
			report(c, "`{name}` hands its function one element at a time, and this one takes " + countOf(len(params)))
			return
		}
		element := types.elementOf(infer.typeOf(env, ast.argFor(args, "", 0)))
		fits(c, typeAt(params, 0), element, "the element `{name}` hands its function")
		checkWalkResult(c, name, result)
		return
	}
	report(c, "`{name}` walks a vector with a function over its elements, and this second argument is " + types.show(ty))
}

proc checkWalkResult(c: mut Check, name: Str, result: types.Ty): void {
	if name == "filter" {
		if result is types.Ty.TBool {
			return
		}
		report(c, "`filter` keeps the elements its function said yes to, so that function has to answer with a `Bool` — this one answers with " + types.show(result))
		return
	}
	if name == "filterMap" {
		if result is types.Ty.TResult(_, _) {
			return
		}
		report(c, "`filterMap` transforms and selects in one pass, so its function has to answer with a `Result` — an `Ok` is kept and an `Error` is dropped. This one answers with " + types.show(result))
		return
	}
	// `map` wants *something*: a `void` function collects nothing, and that too
	// is a `for each` loop.
	if result is types.Ty.TVoid {
		report(c, "`map` collects what its function answered with, and this one answers with nothing. A walk that only acts is a `for each` loop")
	}
}

func typeAt(list: types.Ty[], index: Int): types.Ty {
	if list bounds index {
		return list[index]
	}
	return types.Ty.TUnknown()
}

// `append`, `prepend` and `drop` all write *through* a vector and all ask for a
// mutable dynamic one. Dynamic has to be declared: a `:=` binding reads its
// length off the value, and that is a static length it cannot grow out of.
proc checkGrows(c: mut Check, env: infer.Env, name: Str, args: ast.Arg[], wanted: Int): void {
	if len(args) != wanted {
		report(c, "`{name}` takes " + countOf(wanted) + ", and this call passes " + countOf(len(args)))
		return
	}
	target := ast.argFor(args, "", 0)
	root := rootName(target)
	if root == "" || isMutable(c.mutable, root) == false {
		report(c, "`{name}` grows a vector in place, so its target has to be `mut` — this one is not")
		return
	}
	ty := infer.typeOf(env, target)
	if ty is types.Ty.TVec(_, dim) {
		if dim is ast.Dim.Fixed(size) {
			report(c, "`{name}` needs a vector declared `[dyn]`, and `{root}` promises exactly {size}. A `:=` binding reads its length off the value, and a length read off a value is a promise it cannot grow out of — declare it `mut T[dyn]`")
		}
		return
	}
	if ty is types.Ty.TUnknown {
		return
	}
	report(c, "`{name}` grows a vector, and `{root}` is " + types.show(ty))
}

// A discarded `sort` on a `mut` vector reorders it where it lies. One that
// cannot is a compile error rather than a statement that quietly does nothing.
proc checkStatementExpr(c: mut Check, env: infer.Env, value: ast.Expr): void {
	checkExpr(c, env, value)
	// A call may stand alone for what it does; anything else only computes a
	// value, and one nothing keeps is a line that does nothing.
	if (value is ast.Expr.Call(_, _) || value is ast.Expr.AwaitAll(_, _) || value is ast.Expr.Timed(_, _)) == false {
		report(c, "this computes a value and does nothing with it, so it is not a statement. Keep it — `x := ...` — or, if the value really is not wanted, `_ := ...`")
		return
	}
	if value is ast.Expr.Call(callee, args) {
		mut name := ""
		if callee is ast.Expr.Ident(bare) {
			name = bare
		} else if callee is ast.Expr.Member(head, member) {
			if head is ast.Expr.Ident(hiveName) {
				if hiveName == "hive" {
					name = member
				}
			}
		}
		if name == "sort" && infer.isBound(env, name) == false && len(args) >= 1 {
			target := ast.argFor(infer.builtinArgs("sort", args), "", 0)
			root := rootName(target)
			if root == "" {
				report(c, "a `sort` written as a statement throws away the vector it answers with, so it only means something when it can sort in place — and there is nothing here to sort in place. Keep the answer instead")
			} else if isMutable(c.mutable, root) == false {
				report(c, "a `sort` written as a statement sorts in place, which needs a `mut` vector — `{root}` is not one. Declare it `mut` to sort it where it lies, or keep the answer")
			}
		}
	}
}

// --- `async` -----------------------------------------------------------------

// Every entry starts on a thread of its own, so each is held to what `async` is;
// and the barrier resolves to one vector, so they answer with one type.
proc checkAwaitAll(c: mut Check, env: infer.Env, calls: ast.Expr[], timeout: ast.Expr): void {
	mut types.Ty first = types.Ty.TUnknown()
	for each call in calls {
		if (call is ast.Expr.Call(_, _)) == false {
			checkExpr(c, env, call)
			report(c, "every entry of an await-all is a call, started on a thread of its own — this one is a value already in hand, with nothing to wait for")
			continue
		}
		checkAsync(c, env, call)
		ty := infer.typeOf(env, call)
		if first is types.Ty.TUnknown {
			first = ty
		} else if (ty is types.Ty.TUnknown) == false && types.same(first, ty) == false {
			report(c, "an await-all resolves to one vector, so its calls answer with one type — this list has " + types.show(first) + " and " + types.show(ty) + ". Give calls of different types names of their own: `a := async f()`, `b := async g()`")
		}
	}
	if timeout is ast.Expr.Absent {
		return
	}
	checkExpr(c, env, timeout)
	fits(c, types.Ty.TInt(), infer.typeOf(env, timeout), "the milliseconds `with timeout` waits")
	if first is types.Ty.TVoid {
		report(c, "`with timeout` answers with a `Result` of what the calls answer, and these answer with nothing, so there is no value to wait for")
	}
}

// `async` works on any call, and what it refuses it refuses by name.
proc checkAsync(c: mut Check, env: infer.Env, call: ast.Expr): void {
	checkExpr(c, env, call)
	if call is ast.Expr.Call(callee, args) {
		for each a in args {
			if a.value is ast.Expr.Hole {
				report(c, "`async` cannot fire off a partial application: `f(1, _)` makes a function value, and nothing runs until something calls it")
				return
			}
		}
		if callee is ast.Expr.Ident(name) {
			// A declaration of your own named after a builtin is an ordinary
			// callable, so it is fired off like any other.
			target := infer.callTarget(env, name)
			if target is infer.CallTarget.Builtin {
				report(c, "`async` cannot fire off the builtin `{name}`: the global builtins exist for the value they hand back, so firing one off would leave nothing of it")
				return
			}
			if target is infer.CallTarget.Struct(_) {
				report(c, "`async` cannot fire off a constructor: `{name}(...)` builds a value and runs no body")
			} else if target is infer.CallTarget.Union {
				report(c, "`async` cannot fire off a constructor: `{name}(...)` builds a value and runs no body")
			}
		}
		if callee is ast.Expr.Member(head, variant) {
			if head is ast.Expr.Ident(typeName) {
				if typeName == "Result" || types.findType(env.table, typeName) is Result.Ok(_) {
					report(c, "`async` cannot fire off a constructor: `{typeName}.{variant}(...)` builds a value and runs no body")
				}
			}
		}
	}
}

// --- Patterns ----------------------------------------------------------------

proc checkPattern(c: mut Check, env: infer.Env, subject: ast.Expr, p: ast.Pattern): void {
	subjectType := infer.typeOf(env, subject)
	if p is ast.Pattern.Constructor(path, bindings, parenthesised) {
		checkConstructorPattern(c, subjectType, path, bindings, parenthesised)
	} else if p is ast.Pattern.VectorPat(_, _) {
		if subjectType is types.Ty.TVec(_, _) || subjectType is types.Ty.TUnknown {
			return
		}
		report(c, "a vector pattern matches a vector, and this subject is " + types.show(subjectType))
	} else if p is ast.Pattern.StrTemplate(_) {
		if subjectType is types.Ty.TStr || subjectType is types.Ty.TUnknown {
			return
		}
		report(c, "a string pattern matches a `Str`, and this subject is " + types.show(subjectType))
	}
}

proc checkConstructorPattern(c: mut Check, subjectType: types.Ty, path: Str[], bindings: Str[], parenthesised: Bool): void {
	head := segment(path, 0)
	variant := segment(path, 1)
	if head == "Result" {
		if variant != "Ok" && variant != "Error" {
			report(c, "`Result` has two variants, `Ok` and `Error`, and `{variant}` is neither")
		} else if parenthesised && len(bindings) != 1 {
			report(c, "`Result.{variant}` carries one payload, and this pattern binds " + countOf(len(bindings)))
		} else {
			checkPatternType(c, subjectType, head, variant)
		}
		return
	}
	if types.findType(c.table, head) is Result.Error(_) {
		report(c, "`{head}` is not a type anything here declared")
		return
	}
	if types.findVariant(c.table, head, variant) is Result.Ok(fields) {
		// Name every field or none, so a pattern never quietly skips one.
		if parenthesised && len(bindings) != len(fields) {
			report(c, "`" + types.shownName(head) + ".{variant}` has " + fieldCount(len(fields)) + ", and this pattern binds " + countOf(len(bindings)) + ". Name every field or none — `_` is how one is skipped")
		} else {
			checkPatternType(c, subjectType, head, variant)
		}
		return
	}
	report(c, "`" + types.shownName(head) + "` has no variant `{variant}`")
}

proc checkPatternType(c: mut Check, subjectType: types.Ty, head: Str, variant: Str): void {
	if subjectType is types.Ty.TUnknown || subjectType is types.Ty.TVar(_) {
		return
	}
	if head == "Result" && subjectType is types.Ty.TResult(_, _) {
		return
	}
	if subjectType is types.Ty.TNamed(name) && name == head {
		return
	}
	shown := types.shownName(head)
	report(c, "`{shown}.{variant}` matches a `{shown}`, and what it is matched against is " + types.show(subjectType))
}

func segment(path: Str[], index: Int): Str {
	if path bounds index {
		return path[index]
	}
	return ""
}

// --- Terminating paths -------------------------------------------------------

// A path terminates by ending in `return`, `panic` or `hive.term.exit`, in an
// `if`/`else` or a `switch` whose every branch terminates, or in an else-less `if`/`else if`
// chain that covers its subject's whole type. Not in an `assert`: one that holds
// carries on past it, with nothing to answer.
func terminates(t: types.Table, b: ast.Block): Bool {
	last := len(b.stmts) - 1
	if b.stmts bounds last {
		return terminatesWith(t, b.stmts[last])
	}
	return false
}

func terminatesWith(t: types.Table, s: ast.Stmt): Bool {
	if s is ast.Stmt.ReturnStmt(_) { return true }
	if s is ast.Stmt.PanicStmt(_) { return true }
	if s is ast.Stmt.Expression(value) { return exitsTheProgram(value) }
	if s is ast.Stmt.IfChain(branches, otherwise, hasElse) {
		for each branch in branches {
			if terminates(t, branch.body) == false {
				return false
			}
		}
		if hasElse {
			return terminates(t, otherwise)
		}
		return cover.covers(t, branches)
	}
	// A `switch` that falls short of its subjects is an error of its own.
	if s is ast.Stmt.SwitchStmt(_, _, arms, _) {
		for each arm in arms {
			if terminates(t, arm.body) == false {
				return false
			}
		}
		return true
	}
	return false
}

// A value the else-less chain ending `b` lets through, where that is why `b` does
// not terminate.
func missedAtEnd(t: types.Table, b: ast.Block): Str {
	last := len(b.stmts) - 1
	if b.stmts bounds last {
		if b.stmts[last] is ast.Stmt.IfChain(branches, otherwise, hasElse) {
			for each branch in branches {
				if terminates(t, branch.body) == false {
					return missedAtEnd(t, branch.body)
				}
			}
			if hasElse {
				return missedAtEnd(t, otherwise)
			}
			return cover.missed(t, branches)
		}
		if b.stmts[last] is ast.Stmt.SwitchStmt(_, _, arms, _) {
			for each arm in arms {
				if terminates(t, arm.body) == false {
					return missedAtEnd(t, arm.body)
				}
			}
		}
	}
	return ""
}

func exitsTheProgram(value: ast.Expr): Bool {
	if value is ast.Expr.Call(callee, _) {
		if callee is ast.Expr.Member(subject, name) && name == "exit" {
			if subject is ast.Expr.Member(root, module) && module == "term" {
				if root is ast.Expr.Ident(head) {
					return head == "hive"
				}
			}
		}
	}
	return false
}

// --- Small questions ---------------------------------------------------------

// `at(...)` or `hive.at(...)`: the builtin, where what it answers with is an
// address of no message type yet.
func isAtCall(value: ast.Expr): Bool {
	if value is ast.Expr.Call(callee, _) {
		if callee is ast.Expr.Ident(name) {
			return name == "at"
		}
		if callee is ast.Expr.Member(root, name) {
			if root is ast.Expr.Ident(hiveName) {
				return hiveName == "hive" && name == "at"
			}
		}
	}
	return false
}

func isEmptyMap(value: ast.Expr): Bool {
	if value is ast.Expr.Call(callee, _) {
		if callee is ast.Expr.Member(subject, name) {
			if name == "new" && subject is ast.Expr.Member(root, module) {
				if module == "map" && root is ast.Expr.Ident(hiveName) {
					return hiveName == "hive"
				}
			}
		}
	}
	return false
}

proc fits(c: mut Check, wanted: types.Ty, given: types.Ty, where: Str): void {
	if types.accepts(wanted, given) {
		return
	}
	mut why := ""
	if wanted is types.Ty.TFn(_, _, _, _) && given is types.Ty.TFn(_, _, _, _) {
		why = ". A function value fills a slot only when it takes everything the slot's calls can hand it — a `Str[3]` parameter cannot take the any-length vector a `Str[]` slot passes — and answers with what they expect"
	}
	report(c, where + " wants " + types.show(wanted) + " and this is " + types.show(given) + why)
}
