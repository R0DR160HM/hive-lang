// Checks
// ======
// Everything a program has to be that the grammar cannot say. The parser has held
// every name to its shape and the loader has resolved every import, so what is left
// is about meaning: whether a call has the arguments its declaration asked for,
// whether a `func` stayed a `func`, and whether every path returns.
//
// Every check reports and carries on. A program with six mistakes is one whose
// author would rather hear about six than about the first.
//
// A message says which declaration it is in and is reported against the line of
// what is wrong (spec 17.3). This is the last pass that may refuse a program.
import ./ast
import ./bake
import ./cover
import ./diag
import ./infer
import ./messages
import ./stdlib
import ./text
import ./token
import ./types
import hive.map

// The table is not here: every check reads it from `env`, which copies nothing.
type Check {
    errors: diag.Diagnostic[dyn]
    // The declaration being walked, which is what a message names.
    inside: Str
    at: token.Pos
    // Whether the body is a `func` — which may not declare a `mut` parameter.
    pure: Bool
    // What the body has to return, or `TVoid`.
    result: types.Ty
    // Whether the body is a `test`, where `return value` is refused.
    inTest: Bool
    // How many loops enclose the statement being walked.
    loops: Int
    // The names in scope that are `mut`, as a stack the scopes push and pop.
    mutable: Str[dyn]
    // The names declared so far in the body, as a stack, and where the innermost
    // block's own start in it: one block may not declare a name twice.
    declared: Str[dyn]
    blockStart: Int
    // Whether the expression walked is one of a branch's own `&&` tests, where a match binds.
    guard: Bool
    // Every `hive.map.new()` in the declaration walked, and what each that landed became.
    empties: token.Pos[dyn]
    landings: infer.Landing[dyn]
    // Whether the call walked stands as a statement, and what that statement has left to say.
    bare: Bool
    pending: diag.Diagnostic[dyn]
    // The file an editor has open, or `""`, and what stands in it.
    watching: Str
    uses: infer.Use[dyn]
    scopes: infer.Scope[dyn]
    // Every law the program declares, and whether the body walked is one: only a
    // law may call a law, and none is ever a value.
    laws: Str[dyn]
    inLaw: Bool
    // The names the body walked binds once to a `with compiler` call, which another may be handed.
    baked: bake.Constant[dyn]
}

type Checked {
    errors: diag.Diagnostic[dyn]
    landings: infer.Landing[dyn]
    uses: infer.Use[dyn]
    scopes: infer.Scope[dyn]
}

proc checkModule(m: ast.Module): diag.Diagnostic[dyn] {
    return checkProgram(m).errors
}

proc checkProgram(m: ast.Module): Checked {
    return checkWatching(m, "")
}

proc checkWatching(m: ast.Module, file: Str): Checked {
    t := types.tableOf(m)
    mut Check c = Check([], "", token.nowhere(), false, types.Ty.TVoid(), false, 0, [], [], 0, false, [], [], false, [], file, [], [], lawsOf(m), false, [])
    env := infer.newEnv(t)
    checkTestTitles(c, m)
    for each d in m.decls {
        checkDecl(c, env, d)
        settleMaps(c)
    }
    if bake.cycleIn(m) is Result.Ok(stuck) {
        c.inside = stuck.decl
        reportAt(c, stuck.at, messages.bakedCycle(bake.shown(stuck.call)))
    }
    return Checked(c.errors, c.landings, c.uses, c.scopes)
}

func lawsOf(m: ast.Module): Str[dyn] {
    mut Str[dyn] out = []
    for each d in m.decls {
        if ast.isLaw(d) {
            append(out, ast.declName(d))
        }
    }
    return out
}

proc see(c: mut Check, env: infer.Env, e: ast.Expr): void {
    switch e {
        ast.Expr.Ident(name, at) {
            append(c.uses, infer.Use(at, c.inside, name, "", types.Ty.TUnknown(), infer.typeOf(env, e), infer.isBound(env, name), false))
        }
        ast.Expr.Member(subject, field, at) {
            append(c.uses, infer.Use(at, c.inside, field, pathOf(env, subject), infer.typeOf(env, subject), infer.typeOf(env, e), false, true))
        }
        ast.Expr.Call(callee, _, _) {
            if callee is ast.Expr.Ident(_, _) || callee is ast.Expr.Member(_, _, _) {
                see(c, env, callee)
            }
        }
        _ { }
    }
}

func pathOf(env: infer.Env, subject: ast.Expr): Str {
    if subject is ast.Expr.Ident(name, _) {
        if infer.isBound(env, name) {
            return ""
        }
        return name
    }
    if subject is ast.Expr.Member(inner, field, _) {
        head := pathOf(env, inner)
        if head == "hive" || text.startsWith(head, "hive.") {
            return head + "." + field
        }
    }
    return ""
}

// An empty map nothing gave a type to is one nothing could be built for.
proc settleMaps(c: mut Check): void {
    for each at in c.empties {
        if infer.landedAt(c.landings, c.inside, at) is Result.Error(_) {
            reportAt(c, at, messages.mapNewNeedsLanding())
        }
    }
    c.empties = []
}

// An empty map takes the slot's type, through a vector or a `Result` written around it.
proc land(c: mut Check, wanted: types.Ty, e: ast.Expr): void {
    if infer.isEmptyMap(e) {
        if wanted is types.Ty.TMap(_, _) {
            append(c.landings, infer.Landing(c.inside, infer.emptyMapAt(e), wanted))
        }
        return
    }
    if e is ast.Expr.VectorLit(items, _) && wanted is types.Ty.TVec(element, _) {
        for each item in items {
            land(c, element, item)
        }
    }
    if e is ast.Expr.Call(callee, args, _) && wanted is types.Ty.TResult(ok, bad) && args bounds 0 {
        if callee is ast.Expr.Member(head, variant, _) && head is ast.Expr.Ident(result, _) && result == "Result" {
            if variant == "Error" {
                land(c, bad, args[0].value)
            } else {
                land(c, ok, args[0].value)
            }
        }
    }
}

// A test's title is its name in the report, so two tests answering to one name
// would be reported as one. Go's runner turns spaces into underscores, which makes
// `a b` and `a_b` the same name too.
proc checkTestTitles(c: mut Check, m: ast.Module): void {
    mut Str[dyn] seen = []
    mut Str[dyn] titles = []
    for each d in m.decls {
        if d is ast.Decl.TestDecl(title, _, _) {
            key := join(split(title, " "), "_")
            if indexOf(seen, key) is Result.Ok(at) {
                c.inside = "\"{title}\""
                c.at = d.at
                if titles bounds at {
                    if titles[at] == title {
                        report(c, messages.testTitleTaken())
                    } else {
                        report(c, messages.testTitleUnderscoreClash(titles[at]))
                    }
                }
            }
            append(seen, key)
            append(titles, title)
        }
    }
}

proc report(c: mut Check, message: Str): void {
    reportAt(c, c.at, message)
}

proc reportAt(c: mut Check, at: token.Pos, message: Str): void {
    append(c.errors, diag.on(at, diag.inDecl(ast.lawShown(c.inside), message)))
}

// --- Declarations ------------------------------------------------------------

proc checkDecl(c: mut Check, env: infer.Env, d: ast.Decl): void {
    switch d {
        ast.Decl.TypeDecl(name, fields, variants, at) {
            c.inside = name
            c.at = at
            checkTypeDecl(c, env, fields, variants)
            checkHoldsItself(c, env.table, name)
            for each f in fields {
                checkLibTypes(c, env, types.resolve(env.table, f.declared))
            }
            for each v in variants {
                for each f in v.fields {
                    checkLibTypes(c, env, types.resolve(env.table, f.declared))
                }
            }
        }
        ast.Decl.CallableDecl(kind, name, params, result, body, at) {
            c.inside = name
            c.at = at
            c.pure = kind is ast.CallableKind.FuncKind
            c.inLaw = kind is ast.CallableKind.LawKind || kind is ast.CallableKind.TypeLawKind
            c.result = types.resolve(env.table, result)
            checkLibTypes(c, env, c.result)
            for each p in params {
                checkLibTypes(c, env, types.resolve(env.table, p.declared))
            }
            c.inTest = false
            c.loops = 0
            c.mutable = []
            c.baked = bake.constants(params, body)
            checkCallable(c, env, name, params, body)
        }
        ast.Decl.QueryDecl(name, params, result, sql, at) {
            c.inside = name
            c.at = at
            // A query is a `func` whose body happens to be SQL: nothing in one could
            // write to storage its caller can see.
            c.pure = true
            c.inLaw = false
            c.result = types.resolve(env.table, result)
            c.inTest = false
            c.loops = 0
            c.mutable = []
            c.baked = []
            checkQuery(c, env, params, result, sql)
        }
        ast.Decl.TableLawDecl(name, params, _, filter, at) {
            c.inside = name
            c.at = at
            c.pure = true
            c.inLaw = false
            c.result = types.Ty.TVoid()
            c.inTest = false
            c.loops = 0
            c.mutable = []
            c.baked = []
            for each p in params {
                if p.mutable {
                    report(c, messages.lawTakesMut(p.name))
                }
            }
            checkSql(c, infer.boundParams(env, params, 0), filter)
        }
        ast.Decl.TestDecl(title, body, at) {
            c.inside = "\"{title}\""
            c.at = at
            c.pure = false
            c.inLaw = false
            c.result = types.Ty.TVoid()
            c.inTest = true
            c.loops = 0
            c.mutable = []
            c.baked = bake.constants([], body)
            c.declared = []
            c.blockStart = 0
            checkBlock(c, env, body)
        }
        _ { }
    }
}

// A query's parameters go into scope, then the two things in its body that are
// not text are checked as the expressions they are: a bound value, and the
// condition on an optional predicate.
proc checkQuery(c: mut Check, env: infer.Env, params: ast.Param[], result: ast.TypeExpr, sql: ast.SqlPart[]): void {
    mut Str[dyn] seen = []
    for each p in params {
        if indexOf(seen, p.name) is Result.Ok(_) {
            report(c, messages.paramDeclaredTwice(p.name))
        }
        append(seen, p.name)
        if p.mutable {
            report(c, messages.queryTakesMut(p.name))
        }
    }
    inner := infer.boundParams(env, params, 0)
    rows := types.resolve(env.table, result)
    checkRowType(c, env, rows)
    checkSelectStar(c, env, rows, sql)
    checkSql(c, inner, sql)
}

// What a query declares its rows to be. Three shapes mean something: one row
// type per row, a single column, and no rows at all.
proc checkRowType(c: mut Check, env: infer.Env, declared: types.Ty): void {
    if declared is types.Ty.TVoid {
        return
    }
    if declared is types.Ty.TVec(element, _) {
        if element is types.Ty.TNamed(name) {
            if types.findType(env.table, name) is Result.Ok(info) {
                if len(info.variants) > 0 {
                    report(c, messages.queryRowIsUnion(name))
                }
                return
            }
            report(c, messages.queryRowNotDeclared(name))
            return
        }
        if element is types.Ty.TVec(_, _) && types.isTable(declared) == false {
            report(c, messages.queryRowsNestedNotTable(types.show(declared)))
        }
        return
    }
    report(c, messages.queryResultShape(types.show(declared)))
}

// --- `SELECT *` against a declared row type ----------------------------------

// A query that says what its rows are may not then ask for whatever the table
// happens to have.
//
// `SELECT *` says neither how many columns come back nor what they are called, so
// nothing can line them up against the fields — and what it stands for changes the
// day somebody adds a column, reported at run time in a program nobody edited.
//
// The rule is about the result and only the result: `count(*)`, `a * 2`, a star
// inside a subquery and a `void` statement's select list all still compile.
proc checkSelectStar(c: mut Check, env: infer.Env, declared: types.Ty, sql: ast.SqlPart[]): void {
    if rowTyped(env.table, declared) == false {
        return
    }
    if selectsEverything(sqlText(sql)) == false {
        return
    }
    report(c, messages.selectStarIntoRows())
}

// Whether the declared result is one row type per row, as against a single
// column, a `Table` (which has no fields to disagree with), or a statement.
func rowTyped(table: types.Table, declared: types.Ty): Bool {
    if declared is types.Ty.TVec(element, _) {
        if element is types.Ty.TNamed(name) {
            return types.findType(table, name) is Result.Ok(_)
        }
    }
    return false
}

// The query's text with its holes filled by something inert. A bound value is a
// placeholder anyway, and an optional predicate only appears after the select
// list, so neither can change what the select list is.
func sqlText(parts: ast.SqlPart[]): Str {
    mut Str out = ""
    for each part in parts {
        if part is ast.SqlPart.Lit(written) {
            out = out + written
        } else {
            out = out + " ? "
        }
    }
    return out
}

// Whether any select list that decides the result asks for a bare star.
//
// It is a scan rather than a parse, and four things make it one:
//
//   * depth. A star inside brackets is `count(*)` or a subquery's.
//   * what came before it. A star beginning an item — after `SELECT`, a comma,
//     `DISTINCT`, `ALL`, or the dot of `t.*` — is every column; one after a name, a
//     number or a closing bracket is multiplication.
//   * where the list ends. At the top-level `FROM`, starting again at the next
//     top-level `SELECT`, so both halves of a `UNION` are looked at.
//   * quotes and comments. A star in `'a * b'` or in `/* ... */` is text.
func selectsEverything(sql: Str): Bool {
    cs := text.chars(sql)
    mut Int depth = 0
    mut Bool listing = false
    // The last thing that mattered — how a star meaning every column is told
    // from a star meaning times.
    mut Str before = ""
    mut Int i = 0
    for ; i < len(cs); {
        ch := text.charAt(cs, i)
        if ch == "'" || ch == "\"" || ch == "`" {
            i = pastQuoted(cs, i, ch)
            before = "value"
        } else if ch == "-" && text.charAt(cs, i + 1) == "-" {
            i = pastLine(cs, i)
        } else if ch == "/" && text.charAt(cs, i + 1) == "*" {
            i = pastBlock(cs, i)
        } else if ch == "(" {
            depth = depth + 1
            before = "("
            i = i + 1
        } else if ch == ")" {
            depth = depth - 1
            before = ")"
            i = i + 1
        } else if ch == "," {
            before = ","
            i = i + 1
        } else if ch == "." {
            before = "."
            i = i + 1
        } else if ch == "*" {
            if listing && depth == 0 && opensAnItem(before) {
                return true
            }
            before = "*"
            i = i + 1
        } else if text.isAlnum(ch) || ch == "_" {
            word := text.lower(wordAt(cs, i))
            i = i + len(word)
            // Only at the top level: a `SELECT` inside brackets belongs to a
            // subquery or a CTE, and neither decides the result.
            if depth == 0 && word == "select" {
                listing = true
                before = "select"
            } else if depth == 0 && word == "from" {
                listing = false
                before = "from"
            } else if word == "distinct" || word == "all" {
                before = ","
            } else {
                before = "word"
            }
        } else {
            // Whitespace and every operator that is not a star leave what came before
            // alone, so `SELECT  *` and `SELECT\n*` read as `SELECT *`.
            if text.isSpace(ch) == false {
                before = "operator"
            }
            i = i + 1
        }
    }
    return false
}

// Whether a star here begins a select item rather than continuing an expression.
func opensAnItem(before: Str): Bool {
    return before == "select" || before == "," || before == "."
}

// Past a quoted run, from its opening mark. A doubled quote — `'it''s'` — needs no
// case of its own: the first run closes on the first of the pair and the second
// immediately opens another.
func pastQuoted(cs: Str[], from: Int, mark: Str): Int {
    mut Int i = from + 1
    for ; i < len(cs); {
        if text.charAt(cs, i) == mark {
            return i + 1
        }
        i = i + 1
    }
    return len(cs)
}

func pastLine(cs: Str[], from: Int): Int {
    mut Int i = from
    for ; i < len(cs); {
        if text.charAt(cs, i) == "\n" {
            return i
        }
        i = i + 1
    }
    return len(cs)
}

func pastBlock(cs: Str[], from: Int): Int {
    mut Int i = from + 2
    for ; i < len(cs); {
        if text.charAt(cs, i) == "*" && text.charAt(cs, i + 1) == "/" {
            return i + 2
        }
        i = i + 1
    }
    return len(cs)
}

// The word starting here: letters, digits and underscores, which a SQL keyword
// and a column name are both made of.
func wordAt(cs: Str[], from: Int): Str {
    mut Str out = ""
    mut Int i = from
    for ; i < len(cs); {
        ch := text.charAt(cs, i)
        if text.isAlnum(ch) == false && ch != "_" {
            return out
        }
        out = out + ch
        i = i + 1
    }
    return out
}

proc checkSql(c: mut Check, env: infer.Env, parts: ast.SqlPart[]): void {
    for each part in parts {
        switch part {
            ast.SqlPart.Param(value) {
                checkExpr(c, env, value)
                checkBoundValue(c, env, value)
            }
            ast.SqlPart.Where(group) {
                checkSqlGroup(c, env, group)
            }
            _ { }
        }
    }
}

proc checkSqlGroup(c: mut Check, env: infer.Env, group: ast.SqlGroup): void {
    for each item in group.items {
        switch item {
            ast.SqlItem.Cond(condition, body) {
                checkCondition(c, env, condition)
                checkSql(c, env, body)
            }
            ast.SqlItem.Nested(inner) {
                checkSqlGroup(c, env, inner)
            }
        }
    }
}

// A bound value is one cell, so it is one of the four things a cell can be. A
// vector or a record would have to be spliced into the text, which a query never
// does.
proc checkBoundValue(c: mut Check, env: infer.Env, value: ast.Expr): void {
    ty := infer.typeOf(env, value)
    if ty is types.Ty.TStr || types.isNumber(ty)
        || ty is types.Ty.TBool || ty is types.Ty.TAtom || ty is types.Ty.TUnknown {
        return
    }
    report(c, messages.boundValueNotCell(types.show(ty)))
}

proc checkLibTypes(c: mut Check, env: infer.Env, ty: types.Ty): void {
    switch ty {
        types.Ty.TLib(module, name) {
            if stdlib.isLibType(env.table, module, name) == false {
                report(c, messages.libTypeMissing(module, name))
            }
        }
        types.Ty.TVec(element, _) {
            checkLibTypes(c, env, element)
        }
        types.Ty.TResult(ok, bad) {
            checkLibTypes(c, env, ok)
            checkLibTypes(c, env, bad)
        }
        types.Ty.TMap(key, value) {
            checkLibTypes(c, env, key)
            checkLibTypes(c, env, value)
        }
        types.Ty.TFn(_, params, _, result) {
            for each p in params {
                checkLibTypes(c, env, p)
            }
            checkLibTypes(c, env, result)
        }
        types.Ty.TAddress(message) {
            if message is types.Ty.TUnknown {
                report(c, messages.addressNeedsMessageType())
            } else {
                checkLibTypes(c, env, message)
            }
        }
        types.Ty.TSecret(held) {
            if held is types.Ty.TUnknown {
                report(c, messages.secretNeedsHeldType())
            } else {
                checkLibTypes(c, env, held)
                checkKeepable(c, env, messages.secretAsKeeper(), held)
            }
        }
        _ { }
    }
}

proc checkKeepable(c: mut Check, env: infer.Env, what: Str, ty: types.Ty): void {
    if types.unkeepable(env.table, ty, []) is Result.Ok(found) {
        mut held := ""
        if types.same(found, ty) == false {
            held = messages.keepWhichHolds(types.show(found))
        }
        report(c, messages.secretCannotKeep(what, types.show(ty), held))
    }
}

proc checkTypeDecl(c: mut Check, env: infer.Env, fields: ast.Field[], variants: ast.Variant[]): void {
    mut hive.map.Map<Str, Bool> seen = hive.map.new()
    for each f in fields {
        if hive.map.has(seen, f.name) {
            report(c, messages.typeFieldTwice(f.name))
        }
        hive.map.set(seen, f.name, true)
        checkReservedField(c, f.name)
        checkMarks(c, env, f)
    }
    mut hive.map.Map<Str, Bool> variantNames = hive.map.new()
    for each v in variants {
        if hive.map.has(variantNames, v.name) {
            report(c, messages.typeVariantTwice(v.name))
        }
        hive.map.set(variantNames, v.name, true)
        // A field declared outside any variant is added to every one of them, so
        // a variant naming one of its own the same way would have two.
        for each f in v.fields {
            if hive.map.has(seen, f.name) {
                report(c, messages.variantFieldShadowsShared(v.name, f.name))
            }
            checkReservedField(c, f.name)
            checkMarks(c, env, f)
        }
    }
    checkJsonNames(c, fields, variants)
}

// A struct holding itself field by field — directly, through another struct, or
// through a `Result` — would be a value that never finishes. A vector, a map and
// a union's variant can each be empty, so any of them ends it.
proc checkHoldsItself(c: mut Check, t: types.Table, name: Str): void {
    if types.findType(t, name) is Result.Ok(info) {
        if len(info.variants) == 0 && holdsByValue(t, name, info.shared, [name]) {
            report(c, messages.typeHoldsItself(types.shownName(name)))
        }
    }
}

func holdsByValue(t: types.Table, target: Str, fields: ast.Field[], seen: Str[]): Bool {
    for each f in fields {
        if reachesByValue(t, target, types.resolve(t, f.declared), seen) {
            return true
        }
    }
    return false
}

func reachesByValue(t: types.Table, target: Str, ty: types.Ty, seen: Str[]): Bool {
    if ty is types.Ty.TResult(ok, bad) {
        return reachesByValue(t, target, ok, seen) || reachesByValue(t, target, bad, seen)
    }
    if ty is types.Ty.TNamed(name) {
        if name == target {
            return true
        }
        if indexOf(seen, name) is Result.Ok(_) {
            return false
        }
        if types.findType(t, name) is Result.Ok(info) {
            if len(info.variants) == 0 {
                return holdsByValue(t, target, info.shared, seen + [name])
            }
        }
    }
    return false
}

// Every `decode` reads a `Str` in the format its second argument names, and
// answers with a `Result` the caller has to open. Checked here because the
// emitter needs both before it can name a decoder, so nothing downstream could
// report a wrong one.
proc checkDecodes(c: mut Check, env: infer.Env, what: Str, typeName: Str, args: ast.Arg[]): void {
    if len(args) != 2 {
        report(c, messages.decodeArgCount(what, countOf(len(args))))
        return
    }
    if args bounds 0 {
        fits(c, types.Ty.TStr(), infer.typeOf(env, args[0].value), messages.decodeReadsWhat(what))
    }
    if args bounds 1 {
        format := stdlib.formatOfCodec(infer.typeOf(env, args[1].value))
        checkNamesCodec(c, env, what, args[1].value)
        checkFlatShape(c, env, what, types.Ty.TNamed(typeName), format)
        checkJsonShape(c, env, what, types.Ty.TNamed(typeName), format, true)
    }
}

// A `Secret` is only ever read: a document carrying one is ordinary text by the
// time it arrives, so decoding keeps what it says the way `bypass` would, and
// nothing about that can leak. Writing one out is the leak, so `encode` refuses.
proc checkJsonShape(c: mut Check, env: infer.Env, what: Str, ty: types.Ty, format: Str, decoding: Bool): void {
    if format != "json" && format != "jwt" {
        return
    }
    if tableIn(env.table, ty, []) is Result.Ok(place) {
        mut carried := messages.carriedThis()
        if place != "" {
            carried = place
        }
        report(c, messages.codecCannotCarry(what, carried, stdlib.tableHasNoJson()))
    }
    if decoding == false && types.holdsSecret(env.table, ty) {
        report(c, messages.codecCannotCarry(what, types.show(ty), stdlib.secretHasNoJson()))
    }
    if decoding == false && mapIn(env.table, ty, []) {
        report(c, messages.codecCannotCarry(what, types.show(ty), stdlib.mapHasNoJson()))
    }
}

// Follows the road the encoder is derived along; a `JsonValue` is written by its own.
func mapIn(t: types.Table, ty: types.Ty, seen: Str[]): Bool {
    if ty is types.Ty.TMap(_, _) {
        return true
    }
    if ty is types.Ty.TVec(element, _) {
        return mapIn(t, element, seen)
    }
    if ty is types.Ty.TNamed(name) {
        if stdlib.isJsonValue(name) || indexOf(seen, name) is Result.Ok(_) {
            return false
        }
        if types.findType(t, name) is Result.Ok(info) {
            inner := seen + [name]
            for each f in info.shared {
                if mapIn(t, types.resolve(t, f.declared), inner) {
                    return true
                }
            }
            for each v in info.variants {
                for each f in v.fields {
                    if mapIn(t, types.resolve(t, f.declared), inner) {
                        return true
                    }
                }
            }
        }
    }
    return false
}

// A message is encoded even when it never leaves the machine, so it is held to what `encode` takes.
proc checkCrosses(c: mut Check, env: infer.Env, what: Str, message: types.Ty): void {
    checkJsonShape(c, env, what, message, "json", false)
}

// Where a `Table` sits in `ty`: `""` for `ty` itself, or the field holding one.
func tableIn(t: types.Table, ty: types.Ty, seen: Str[]): Result<Str, Bool> {
    if types.isTable(ty) {
        return Result.Ok("")
    }
    if ty is types.Ty.TVec(element, _) {
        return tableIn(t, element, seen)
    }
    if ty is types.Ty.TNamed(name) {
        if indexOf(seen, name) is Result.Error(_) {
            if types.findType(t, name) is Result.Ok(info) {
                mut ast.Field[dyn] fields = []
                for each v in info.variants {
                    for each f in v.fields {
                        append(fields, f)
                    }
                }
                for each f in info.shared {
                    append(fields, f)
                }
                for each f in fields {
                    if tableIn(t, types.resolve(t, f.declared), seen + [name]) is Result.Ok(place) {
                        if place == "" {
                            return Result.Ok(messages.carriedTableField(types.shownName(name), f.name))
                        }
                        return Result.Ok(place)
                    }
                }
            }
        }
    }
    return Result.Error(false)
}

// A query string and a command line are one flat set of parameters, so only a
// type without variants whose fields are values, or vectors of values, travels as one.
proc checkFlatShape(c: mut Check, env: infer.Env, what: Str, ty: types.Ty, format: Str): void {
    if stdlib.isFlatFormat(format) == false || ty is types.Ty.TUnknown {
        return
    }
    carrier := stdlib.flatCarrier(format)
    if ty is types.Ty.TNamed(name) {
        if types.findType(env.table, name) is Result.Ok(info) {
            if len(info.variants) > 0 {
                report(c, messages.flatHasVariants(carrier, what, types.shownName(name)))
                return
            }
            for each f in info.shared {
                checkFlatField(c, env, name, f, stdlib.flatUnit(format))
            }
            return
        }
    }
    report(c, messages.flatNotDeclaredType(carrier, what, types.show(ty)))
}

proc checkFlatField(c: mut Check, env: infer.Env, typeName: Str, f: ast.Field, unit: Str): void {
    ty := types.resolve(env.table, f.declared)
    if stdlib.isFlatValue(ty) {
        return
    }
    if ty is types.Ty.TVec(element, _) {
        if stdlib.isFlatValue(element) {
            return
        }
    }
    report(c, messages.flatFieldNotValue(typeName, f.name, types.show(ty), unit))
}

// A codec is a value like any other, and its type says which format it is: the
// encoder and decoder are still written from the declaration at the call, off
// that type, which is what keeps this free of reflection.
proc checkNamesCodec(c: mut Check, env: infer.Env, what: Str, given: ast.Expr): void {
    if given is ast.Expr.Hole {
        return
    }
    held := infer.typeOf(env, given)
    if held is types.Ty.TUnknown {
        return
    }
    if held is types.Ty.TCodec(error) {
        // A generic one is settled per copy, where the variable is known.
        if error is types.Ty.TVar(_) || stdlib.formatOfCodec(held) != "" {
            return
        }
        report(c, messages.codecNamesNoFormat(types.show(held), errorTypes()))
        return
    }
    report(c, messages.codecWrongType(what, types.show(held)))
}

// Every error type that names a format, for a message that has to list them.
func errorTypes(): Str {
    mut Str[dyn] out = []
    for each format in stdlib.codecFormats() {
        append(out, types.show(stdlib.codecErrorOf(format)))
    }
    return join(out, ", ")
}

// A field-less variant is a value, so `T.Variant.decode` would read as that field
// of it as readily as the decoder — and the two mean entirely different things.
// One name is the whole cost of naming the decoder at all.
proc checkReservedField(c: mut Check, name: Str): void {
    if name == "decode" {
        report(c, messages.fieldNamedDecode())
    }
}

// What a field's `--` annotations have to be true of. The parser has already
// settled their shape; what is left is the one thing it could not know, which is
// what the field's type is.
proc checkMarks(c: mut Check, env: infer.Env, f: ast.Field): void {
    if f.marks.fallback is ast.Expr.Absent {
        return
    }
    declared := types.resolve(env.table, f.declared)
    given := literalType(f.marks.fallback)
    if types.same(declared, given) {
        return
    }
    if infer.intLiteral(f.marks.fallback) is Result.Ok(n) && types.holdsLiteral(declared, n) {
        return
    }
    if infer.isFloatLiteral(f.marks.fallback) && declared is types.Ty.TFloat32 && holdsFloat32(f.marks.fallback) {
        return
    }
    // A literal of the wrong type would be a field decoding into something its
    // own declaration says it cannot hold, so this is the one place the
    // annotation is held to the type beside it.
    report(c, messages.fallbackWrongType(f.name, types.show(declared), types.show(given)))
}

// Two fields of one object cannot answer to one key: the decoder would read the same
// member twice and the encoder would write it twice. Checked over each variant's own
// fields together with the shared ones, since that is the object a variant encodes to.
proc checkJsonNames(c: mut Check, fields: ast.Field[], variants: ast.Variant[]): void {
    if len(variants) == 0 {
        reportClashes(c, fields, [])
        reportUrlClashes(c, fields)
        reportFlagClashes(c, fields)
        return
    }
    for each v in variants {
        reportClashes(c, v.fields, fields)
    }
}

proc reportClashes(c: mut Check, fields: ast.Field[], andShared: ast.Field[]): void {
    mut hive.map.Map<Str, Bool> keys = hive.map.new()
    for each f in fields {
        clashingKey(c, keys, f)
    }
    for each f in andShared {
        clashingKey(c, keys, f)
    }
}

proc clashingKey(c: mut Check, keys: mut hive.map.Map<Str, Bool>, f: ast.Field): void {
    key := ast.jsonKey(f)
    if hive.map.has(keys, key) {
        report(c, messages.jsonKeyClash(key))
    }
    hive.map.set(keys, key, true)
}

// Only a type without variants travels as a query string, so only its
// parameters can clash.
proc reportUrlClashes(c: mut Check, fields: ast.Field[]): void {
    mut hive.map.Map<Str, Bool> keys = hive.map.new()
    for each f in fields {
        key := ast.urlKey(f)
        if hive.map.has(keys, key) {
            report(c, messages.urlKeyClash(key))
        }
        hive.map.set(keys, key, true)
    }
}

proc reportFlagClashes(c: mut Check, fields: ast.Field[]): void {
    mut hive.map.Map<Str, Bool> keys = hive.map.new()
    mut hive.map.Map<Str, Bool> shorts = hive.map.new()
    for each f in fields {
        key := ast.flagKey(f)
        if hive.map.has(keys, key) {
            report(c, messages.flagKeyClash(key))
        }
        hive.map.set(keys, key, true)
        short := f.marks.flagShort
        if short != "" {
            if hive.map.has(shorts, short) {
                report(c, messages.flagShortClash(short))
            }
            hive.map.set(shorts, short, true)
        }
    }
}

// What a literal is, which is the whole of what a `Default` may be — the parser
// accepts nothing else there, so this needs no scope to answer.
func literalType(e: ast.Expr): types.Ty {
    if e is ast.Expr.IntLit(_, _) { return types.Ty.TInt() }
    if e is ast.Expr.FloatLit(_, _) { return types.Ty.TFloat() }
    if e is ast.Expr.StrLit(_, _) { return types.Ty.TStr() }
    if e is ast.Expr.BoolLit(_, _) { return types.Ty.TBool() }
    if e is ast.Expr.AtomLit(_, _) { return types.Ty.TAtom() }
    return types.Ty.TUnknown()
}

proc checkCallable(c: mut Check, env: infer.Env, name: Str, params: ast.Param[], body: ast.Block): void {
    mut Str[dyn] seen = []
    if name == "main" && (len(params) > 0 || (c.result is types.Ty.TVoid) == false) {
        report(c, messages.mainSignature())
    }
    c.declared = []
    c.blockStart = 0
    for each p in params {
        append(c.declared, p.name)
        if indexOf(seen, p.name) is Result.Ok(_) {
            report(c, messages.paramDeclaredTwice(p.name))
        }
        append(seen, p.name)
        // Only a `proc` may ask for the caller's storage. A `mut` value handed to a
        // `func` is seen as an ordinary immutable copy instead.
        if p.mutable && c.inLaw {
            report(c, messages.lawParamTakesMut(p.name))
        } else if p.mutable && c.pure {
            report(c, messages.funcTakesMut(p.name))
        }
        if p.mutable {
            append(c.mutable, p.name)
        }
    }
    // The body's own top level is the parameters' scope too.
    checkStmts(c, infer.boundParams(env, params, 0), body.stmts, 0)

    // Every non-`void` callable must return on every path.
    if c.result is types.Ty.TVoid {
        return
    }
    if terminates(env.table, body) {
        return
    }
    missed := missedAtEnd(env.table, body)
    if missed != "" {
        report(c, messages.returnMissedAtEnd(name, types.show(c.result), missed))
    } else {
        report(c, messages.notEveryPathReturns(name, types.show(c.result)))
    }
}

// --- Statements --------------------------------------------------------------

proc checkBlock(c: mut Check, env: infer.Env, b: ast.Block): infer.Env {
    mark := len(c.mutable)
    declaredMark := len(c.declared)
    outerStart := c.blockStart
    c.blockStart = declaredMark
    after := checkStmts(c, env, b.stmts, 0)
    restore(c, mark)
    c.blockStart = outerStart
    last := len(c.declared) - 1
    if declaredMark <= last && c.declared bounds declaredMark {
        if c.declared bounds last {
            drop(c.declared, declaredMark, last)
        }
    }
    return after
}

// A name one block declares once. An inner block may reuse an outer name, which
// is shadowing; the same block declaring it again would be two variables with no
// way to tell which a later line means.
proc declareName(c: mut Check, name: Str): void {
    if name == "_" {
        return
    }
    mut i := c.blockStart
    for ; i < len(c.declared); i++ {
        if c.declared bounds i && i >= 0 {
            if c.declared[i] == name {
                report(c, messages.nameAlreadyDeclared(name))
                return
            }
        }
    }
    append(c.declared, name)
}

// Each statement checked with the bindings of everything before it in scope.
// Recursion rather than a `mut infer.Env` through a loop: an `Env` carries the whole
// table, and a `mut` one is copied at every use to keep `8.3`'s invariant.
proc checkStmts(c: mut Check, env: infer.Env, stmts: ast.Stmt[], at: Int): infer.Env {
    if stmts bounds at {
        return checkStmts(c, checkStmt(c, env, stmts[at]), stmts, at + 1)
    }
    return env
}

proc restore(c: mut Check, mark: Int): void {
    last := len(c.mutable) - 1
    if mark <= last && c.mutable bounds mark {
        if c.mutable bounds last {
            drop(c.mutable, mark, last)
        }
    }
}

// What a statement left to say is said only where it was otherwise right.
proc checkStmt(c: mut Check, env: infer.Env, s: ast.Stmt): infer.Env {
    if (s is ast.Stmt.Nothing) == false {
        c.at = s.at
    }
    before := len(c.errors)
    held := c.pending
    c.pending = []
    watched := c.watching != "" && s.at.file == c.watching
    slot := len(c.scopes)
    if watched {
        append(c.scopes, infer.Scope(s.at, c.inside, env.names, env.names))
    }
    after := checkWrittenStmt(c, env, s)
    if watched && c.scopes bounds slot {
        c.scopes[slot] = infer.Scope(s.at, c.inside, env.names, after.names)
    }
    if len(c.errors) == before {
        for each left in c.pending {
            append(c.errors, left)
        }
    }
    c.pending = held
    return after
}

proc checkWrittenStmt(c: mut Check, env: infer.Env, s: ast.Stmt): infer.Env {
    switch s {
        ast.Stmt.VarDecl(name, value, mutable, deferred, _) {
            checkExpr(c, env, value)
            ty := infer.typeOf(env, value)
            // `hive.map.new()` says empty and nothing about what it holds, so it has
            // to land somewhere that says.
            if infer.isEmptyMap(value) {
                // Said here, in full, so it is not said again when the declaration ends.
                append(c.landings, infer.Landing(c.inside, infer.emptyMapAt(value), types.Ty.TUnknown()))
                report(c, messages.mapNewBindingNeedsLanding(name))
            }
            // A name says where a service is, and nothing about what it takes.
            if isAtCall(value) && ty is types.Ty.TAddress(types.Ty.TUnknown) {
                report(c, messages.atBindingNeedsLanding(name))
            }
            // `Result.Ok(v)` says one half of what it is, and the other has to be said.
            if infer.isResultLiteral(value) {
                checkResultHalves(c, name, ty)
            }
            checkHoldsValue(c, name, ty, deferred)
            declareName(c, name)
            if mutable {
                append(c.mutable, name)
            }
            return infer.bound(env, name, ty)
        }
        ast.Stmt.TypedDecl(declared, name, value, mutable, deferred, _) {
            checkExpr(c, env, value)
            ty := types.resolve(env.table, declared)
            checkLibTypes(c, env, ty)
            checkHoldsValue(c, name, infer.typeOf(env, value), deferred)
            if deferred == false {
                fitsValue(c, env, ty, value, messages.declarationOfWhat(name))
            }
            declareName(c, name)
            if mutable {
                append(c.mutable, name)
            }
            return infer.bound(env, name, ty)
        }
        ast.Stmt.Assign(target, value, _) {
            checkAssign(c, env, target, value)
            return env
        }
        ast.Stmt.ReturnStmt(value, _) {
            checkReturn(c, env, value)
            return env
        }
        ast.Stmt.IfChain(branches, otherwise, hasElse, _) {
            for each b in branches {
                checkGuard(c, env, b.condition)
                checkBlock(c, afterCondition(env, b.condition), b.body)
            }
            if hasElse {
                checkBlock(c, env, otherwise)
            }
            return env
        }
        ast.Stmt.SwitchStmt(lets, subjects, arms, binds, where) {
            checkSwitch(c, env, lets, subjects, arms, where, binds)
            return env
        }
        _ { }
    }
    return checkStmtTail(c, env, s)
}

proc checkSwitch(c: mut Check, env: infer.Env, lets: ast.Stmt[], subjects: ast.Expr[], arms: ast.Branch[], where: token.Pos, binds: Bool): void {
    before := len(c.errors)
    inner := checkLets(c, env, lets, where, binds, 0)
    for each subject in subjects {
        checkExpr(c, inner, subject)
    }
    for each arm in arms {
        checkGuard(c, inner, arm.condition)
    }
    // Coverage over a pattern already found wrong would only repeat the mistake.
    clean := len(c.errors) == before
    mut skip := binds
    for each arm in arms {
        if skip {
            skip = false
        } else {
            checkBlock(c, afterCondition(inner, arm.condition), arm.body)
        }
    }
    if binds {
        checkElseLeaves(c, env, arms, where)
        checkRest(c, inner, arms)
    }
    if clean && binds {
        checkElseCover(c, env, subjects, arms, where)
    } else if clean {
        checkCover(c, env, subjects, arms, where)
    }
}

proc checkLets(c: mut Check, env: infer.Env, lets: ast.Stmt[], where: token.Pos, binds: Bool, at: Int): infer.Env {
    if lets bounds at {
        if lets[at] is ast.Stmt.VarDecl(name, value, _, _, _) {
            checkExpr(c, env, value)
            ty := infer.typeOf(env, value)
            if ty is types.Ty.TVoid && binds {
                reportAt(c, where, messages.bindingFromVoidCall())
            } else if ty is types.Ty.TVoid {
                reportAt(c, where, messages.switchOnVoidCall())
            }
            return checkLets(c, infer.bound(env, name, ty), lets, where, binds, at + 1)
        }
        return checkLets(c, env, lets, where, binds, at + 1)
    }
    return env
}

// The rest of a binding's block is still that block, so the pattern's names are declared in it.
proc checkRest(c: mut Check, env: infer.Env, arms: ast.Branch[]): void {
    if arms bounds 0 {
        taken := arms[0]
        for each name in ast.bindingsIn(taken.condition) {
            declareName(c, name)
        }
        _ := checkStmts(c, afterCondition(env, taken.condition), taken.body.stmts, 0)
    }
}

proc checkElseLeaves(c: mut Check, env: infer.Env, arms: ast.Branch[], where: token.Pos): void {
    mut n := 0
    for each arm in arms {
        if n > 0 && leaves(env.table, arm.body) == false {
            reportAt(c, where, messages.elseArmCarriesOn(n))
        }
        n++
    }
}

proc checkElseCover(c: mut Check, env: infer.Env, subjects: ast.Expr[], arms: ast.Branch[], where: token.Pos): void {
    for each n in cover.deadArms(env.table, subjects, arms) {
        at := n - 1
        mut byPattern := false
        if arms bounds 0 && arms bounds at {
            byPattern = len(cover.deadArms(env.table, subjects, [arms[0], arms[at]])) > 0
        }
        if byPattern {
            reportAt(c, where, messages.elseArmDeadByPattern(at))
        } else {
            reportAt(c, where, messages.elseArmDeadByArms(at))
        }
    }
    if cover.unmatched(env.table, subjects, arms) is Result.Ok(value) {
        if value == "_" {
            reportAt(c, where, messages.elseCannotCover())
        } else {
            reportAt(c, where, messages.elseMissesValue(value))
        }
    }
}

proc checkCover(c: mut Check, env: infer.Env, subjects: ast.Expr[], arms: ast.Branch[], where: token.Pos): void {
    for each n in cover.deadArms(env.table, subjects, arms) {
        reportAt(c, where, messages.switchArmDead(n))
    }
    rest := wildcards(len(subjects))
    if len(arms) == 0 {
        reportAt(c, where, messages.switchNoArms(rest))
        return
    }
    if cover.unmatched(env.table, subjects, arms) is Result.Ok(value) {
        if value == rest {
            reportAt(c, where, messages.switchCannotCover(rest))
        } else {
            reportAt(c, where, messages.switchMissesValue(value, rest))
        }
    }
}

func wildcards(n: Int): Str {
    mut Str[dyn] out = []
    for i := 0; i < n; i++ {
        append(out, "_")
    }
    return join(out, ", ")
}

// `r := Result.Ok(3)` still missing a half. A later use that said it would have
// pinned the binding before the check ran, so nothing in the program says it. A
// payload whose own type is unknown leaves both halves so, and has been reported.
proc checkResultHalves(c: mut Check, name: Str, ty: types.Ty): void {
    if ty is types.Ty.TResult(ok, bad) {
        mut said := "Ok"
        mut unsaid := "Error"
        mut example := types.Ty.TResult(ok, types.Ty.TStr())
        if ok is types.Ty.TUnknown {
            if bad is types.Ty.TUnknown {
                return
            }
            said = "Error"
            unsaid = "Ok"
            example = types.Ty.TResult(types.Ty.TInt(), bad)
        } else if (bad is types.Ty.TUnknown) == false {
            return
        }
        report(c, messages.resultHalfUnsaid(said, unsaid, name, types.show(example)))
    }
}

// A call that answers with nothing leaves a name nothing to hold.
proc checkHoldsValue(c: mut Check, name: Str, ty: types.Ty, deferred: Bool): void {
    if (ty is types.Ty.TVoid) == false {
        return
    }
    if deferred {
        report(c, messages.asyncBindingOfVoid(name))
        return
    }
    report(c, messages.bindingOfVoid(name))
}

proc checkStmtTail(c: mut Check, env: infer.Env, s: ast.Stmt): infer.Env {
    if s is ast.Stmt.ForLoop(init, cond, post, body, _) {
        mark := len(c.mutable)
        // The counter belongs to the loop, not to the block around it.
        declaredMark := len(c.declared)
        outerStart := c.blockStart
        c.blockStart = declaredMark
        inner := checkStmt(c, env, init)
        if cond is ast.Expr.Absent {
        } else {
            checkCondition(c, inner, cond)
        }
        checkStmt(c, inner, post)
        c.loops = c.loops + 1
        checkBlock(c, inner, body)
        c.loops = c.loops - 1
        restore(c, mark)
        c.blockStart = outerStart
        last := len(c.declared) - 1
        if declaredMark <= last && c.declared bounds declaredMark {
            if c.declared bounds last {
                drop(c.declared, declaredMark, last)
            }
        }
        return env
    } else if s is ast.Stmt.ForEach(name, declared, subject, body, _) {
        checkExpr(c, env, subject)
        subjectType := infer.typeOf(env, subject)
        // A turn of the loop would have to be handed a map's key or its value,
        // and the syntax never said which.
        switch subjectType {
            types.Ty.TMap(_, _) {
                report(c, messages.forEachOverMap())
            }
            types.Ty.TStr {
                report(c, messages.forEachOverStr())
            }
            _ { }
        }
        mut elementType := types.elementOf(subjectType)
        if declared is ast.TypeExpr.VoidType {
        } else {
            written := types.resolve(env.table, declared)
            fits(c, written, elementType, messages.forEachWrittenType(name))
            elementType = written
        }
        c.loops = c.loops + 1
        checkBlock(c, infer.bound(env, name, elementType), body)
        c.loops = c.loops - 1
        return env
    } else if s is ast.Stmt.BreakStmt || s is ast.Stmt.ContinueStmt {
        if c.loops == 0 {
            report(c, messages.breakOutsideLoop())
        }
        return env
    } else if s is ast.Stmt.EchoStmt(value, _) {
        checkExpr(c, env, value)
        checkShown(c, env, value, messages.echoShows())
        return env
    } else if s is ast.Stmt.AssertStmt(condition, _) {
        checkCondition(c, env, condition)
        return env
    } else if s is ast.Stmt.PanicStmt(value, _) {
        checkExpr(c, env, value)
        checkShown(c, env, value, messages.panicShows())
        return env
    } else if s is ast.Stmt.AsyncStmt(call, _) {
        checkAsync(c, env, call)
        return env
    } else if s is ast.Stmt.Expression(value, _) {
        c.bare = true
        checkStatementExpr(c, env, value)
        c.bare = false
        return env
    }
    return env
}

proc checkReturn(c: mut Check, env: infer.Env, value: ast.Expr): void {
    if value is ast.Expr.Absent {
        if c.result is types.Ty.TVoid {
            return
        }
        report(c, messages.returnsNothingButDeclared(types.show(c.result)))
        return
    }
    if c.inTest {
        report(c, messages.testReturnsValue())
        return
    }
    checkExpr(c, env, value)
    if c.result is types.Ty.TVoid {
        report(c, messages.returnValueInVoid())
        return
    }
    fitsValue(c, env, c.result, value, messages.returnWhat())
}

proc checkAssign(c: mut Check, env: infer.Env, target: ast.Expr, value: ast.Expr): void {
    checkExpr(c, env, value)
    checkExpr(c, env, target)
    // A `Str` is read by position but never written by one: it is a value rather
    // than storage, so there is nothing behind `s[0]` to assign into — and a
    // character written over one of a different width would move every character
    // after it.
    if writesIntoStr(env, target) {
        report(c, messages.strAssignedByPosition())
        return
    }
    root := rootName(target)
    if root == "" {
        report(c, messages.notAssignable())
        return
    }
    if isMutable(c.mutable, root) == false {
        report(c, messages.assignImmutable(root))
        return
    }
    if target is ast.Expr.Member(owner, _, _) && types.isUnion(env.table, infer.typeOf(env, owner)) {
        report(c, messages.unionFieldAssigned())
        return
    }
    fitsValue(c, env, infer.typeOf(env, target), value, messages.assignmentToWhat(root))
}

// Whether a target writes through a `Str`'s subscript, at any depth: `s[0]` and
// `rows[2][1]` where the row is a `Str` are the same mistake.
func writesIntoStr(env: infer.Env, target: ast.Expr): Bool {
    if target is ast.Expr.Index(subject, _, _) {
        return infer.typeOf(env, subject) is types.Ty.TStr
    }
    return false
}

// The name a target is a path into: `v`, `v[0]`, `rec.f` and `b.items[2]` all
// answer with the variable at the bottom, whose mutability decides.
func rootName(target: ast.Expr): Str {
    if target is ast.Expr.Ident(name, _) { return name }
    if target is ast.Expr.Member(subject, _, _) { return rootName(subject) }
    if target is ast.Expr.Index(subject, _, _) { return rootName(subject) }
    return ""
}

func isMutable(mutable: Str[], name: Str): Bool {
    return indexOf(mutable, name) is Result.Ok(_)
}

// A condition is a `Bool` and nothing else. There is no truthiness in Hive: an
// atom is a label rather than a yes or a no, and a number is a number.
proc checkGuard(c: mut Check, env: infer.Env, condition: ast.Expr): void {
    c.guard = true
    checkCondition(c, env, condition)
    c.guard = false
}

proc checkCondition(c: mut Check, env: infer.Env, condition: ast.Expr): void {
    checkExpr(c, env, condition)
    ty := infer.typeOf(env, condition)
    if ty is types.Ty.TBool || ty is types.Ty.TUnknown {
        return
    }
    if ty is types.Ty.TAtom {
        report(c, messages.atomAsCondition())
        return
    }
    report(c, messages.conditionNotBool(types.show(ty)))
}

// What `!` takes. The same rule a condition is held to — there is no truthiness, so
// there is nothing to invert but a `Bool` — said separately because a `!` may be
// stored, returned or passed as an argument, and each has to refuse the same operand.
proc checkNegated(c: mut Check, env: infer.Env, operand: ast.Expr): void {
    ty := infer.typeOf(env, operand)
    if ty is types.Ty.TBool || ty is types.Ty.TUnknown {
        return
    }
    if ty is types.Ty.TAtom {
        report(c, messages.atomNegated())
        return
    }
    if types.isInteger(ty) {
        report(c, messages.notOnInteger(types.show(ty)))
        return
    }
    report(c, messages.notOnNonBool(types.show(ty)))
}

// --- Bits ----------------------------------------------------------------------

// How many bits an integer type takes, or 0 for anything else.
func widthOf(ty: types.Ty): Int {
    if ty is types.Ty.TInt {
        return 64
    }
    if ty is types.Ty.TSized(_, bits) {
        return bits
    }
    return 0
}

func isByteVector(ty: types.Ty): Bool {
    if ty is types.Ty.TVec(element, _) {
        return types.same(element, types.Ty.TSized(false, 8))
    }
    return false
}

// `<<<a, b: UInt16, payload>>>`: every part's width is known here, so whether they
// come to whole bytes, and land a run of bytes on a byte, is too.
proc checkBitsLit(c: mut Check, env: infer.Env, parts: ast.BitPart[]): void {
    mut offset := 0
    for each part in parts {
        checkExpr(c, env, part.value)
        width := partWidth(c, env, part)
        if width < 0 {
            return
        }
        if refusesAlignment(c, pathText(part.value), offset, width, part.little) {
            return
        }
        offset = offset + width
    }
    if offset % 8 != 0 {
        report(c, messages.bitsNotWholeBytes(offset, 8 - offset % 8))
    }
}

// A run of bytes, and a `little` number, start on a byte; `little` orders whole bytes.
proc refusesAlignment(c: mut Check, shown: Str, offset: Int, width: Int, little: Bool): Bool {
    if little && width == 0 {
        report(c, messages.littleOnByteRun(shown))
        return true
    }
    if little && width % 8 != 0 {
        report(c, messages.littleNotWholeBytes(shown, width))
        return true
    }
    if (width == 0 || little) && offset % 8 != 0 {
        mut what := messages.bitsRunOfBytes()
        if little {
            what = messages.bitsLittleNumber()
        }
        report(c, messages.bitsPartOffByte(shown, offset % 8, what))
        return true
    }
    return false
}

// A part's width in bits: 0 for a run of bytes of any length, -1 once it has been
// refused.
proc partWidth(c: mut Check, env: infer.Env, part: ast.BitPart): Int {
    if (part.declared is ast.TypeExpr.VoidType) == false {
        said := types.resolve(env.table, part.declared)
        if infer.intLiteral(part.value) is Result.Ok(n) {
            if widthOf(said) == 0 {
                report(c, messages.bitsLiteralTypeNotInteger(n, types.show(said)))
                return -1
            }
            if types.holdsLiteral(said, n) == false {
                report(c, messages.bitsLiteralDoesNotFit(n, types.show(said)))
                return -1
            }
            return widthOf(said)
        }
        report(c, messages.bitsWidthOnlyOnLiteral(types.show(said), pathText(part.value)))
        return -1
    }
    if infer.intLiteral(part.value) is Result.Ok(n) {
        if n < 0 || n > 255 {
            report(c, messages.bitsLiteralNotByte(n))
            return -1
        }
        return 8
    }
    ty := infer.landedType(env, part.value, types.Ty.TVec(types.Ty.TSized(false, 8), ast.Dim.Dynamic()))
    if ty is types.Ty.TStr || isByteVector(ty) {
        return 0
    }
    width := widthOf(ty)
    if width > 0 {
        return width
    }
    if ty is types.Ty.TUnknown {
        return -1
    }
    report(c, messages.bitsPartWrongType(pathText(part.value), types.show(ty)))
    return -1
}

// The scope a condition leaves behind, which is whatever its patterns bound.
func afterCondition(env: infer.Env, condition: ast.Expr): infer.Env {
    return infer.narrowed(env, condition)
}

// --- Expressions -------------------------------------------------------------

proc checkExpr(c: mut Check, env: infer.Env, e: ast.Expr): void {
    if e is ast.Expr.Absent {
        return
    }
    outer := c.at
    c.at = e.at
    if c.watching != "" && e.at.file == c.watching {
        see(c, env, e)
    }
    if (e is ast.Expr.Call(_, _, _)) == false {
        c.bare = false
    }
    // An `&&` chain that binds is tested the way a branch's condition is, wherever it stands.
    guarded := c.guard || (isConjunction(e) && ast.conjunctsBind(ast.conjuncts(e)))
    held := c.guard
    c.guard = guarded && isConjunction(e)
    if guarded == false && e is ast.Expr.IsMatch(_, pattern, _) && pattern is ast.Pattern.VectorPat(_, _) {
        report(c, messages.vectorPatternOutsideIf())
    }
    checkWritten(c, env, e)
    c.guard = held
    c.at = outer
}

func isConjunction(e: ast.Expr): Bool {
    if e is ast.Expr.Binary(op, _, _, _) {
        return op is ast.BinOp.And
    }
    return false
}

proc checkWritten(c: mut Check, env: infer.Env, e: ast.Expr): void {
    switch e {
        ast.Expr.Call(callee, args, _) {
            if infer.isEmptyMap(e) {
                append(c.empties, infer.emptyMapAt(e))
            }
            checkCall(c, env, callee, args)
        }
        ast.Expr.Binary(op, left, right, _) {
            checkExpr(c, env, left)
            // A binding an `is` made is usable in the rest of the same condition after
            // `&&`, which is why the two are told apart here.
            if op is ast.BinOp.And {
                narrowed := afterCondition(env, left)
                checkExpr(c, narrowed, right)
                checkOperands(c, narrowed, op, left, right)
            } else {
                checkExpr(c, env, right)
                checkOperands(c, env, op, left, right)
            }
        }
        ast.Expr.Negate(operand, _) {
            checkExpr(c, env, operand)
            ty := infer.typeOf(env, operand)
            if types.isUnsigned(ty) {
                report(c, messages.negateUnsigned(types.show(ty)))
            } else if (types.isNumber(ty) || ty is types.Ty.TUnknown) == false {
                report(c, messages.negateNotNumber(types.show(ty)))
            }
        }
        ast.Expr.AwaitAll(calls, timeout, _) {
            checkAwaitAll(c, env, calls, timeout)
        }
        ast.Expr.Timed(call, ms, _) {
            checkExpr(c, env, call)
            fits(c, types.Ty.TInt(), infer.typeOf(env, ms), messages.timeoutMillisWhat())
            if infer.isSendExpr(env, call) == false && infer.typeOf(env, call) is types.Ty.TVoid {
                report(c, messages.timeoutOnVoidCall())
            }
        }
        ast.Expr.Baked(call, _) {
            checkExpr(c, env, call)
            checkBaked(c, env, call)
        }
        ast.Expr.Not(operand, _) {
            checkExpr(c, env, operand)
            checkNegated(c, env, operand)
        }
        ast.Expr.BitNot(operand, _) {
            checkExpr(c, env, operand)
            ty := infer.typeOf(env, operand)
            if (types.isInteger(ty) || ty is types.Ty.TUnknown) == false {
                mut instead := ""
                if ty is types.Ty.TBool {
                    instead = messages.bitNotBoolHint()
                }
                report(c, messages.bitNotNotInteger(types.show(ty), instead))
            }
        }
        ast.Expr.Bits(parts, _) {
            checkBitsLit(c, env, parts)
        }
        ast.Expr.Index(subject, index, _) {
            checkExpr(c, env, subject)
            checkExpr(c, env, index)
            checkIndexable(c, env, subject)
        }
        ast.Expr.Slice(subject, low, high, _) {
            checkExpr(c, env, subject)
            checkExpr(c, env, low)
            checkExpr(c, env, high)
            checkIndexable(c, env, subject)
        }
        ast.Expr.VectorLit(items, _) {
            for each item in items {
                checkExpr(c, env, item)
            }
        }
        ast.Expr.Interp(parts, _) {
            for each part in parts {
                if part is ast.InterpPart.Expression(value) {
                    checkExpr(c, env, value)
                    checkShown(c, env, value, messages.interpolationShows())
                }
            }
        }
        ast.Expr.IsMatch(subject, pattern, _) {
            checkExpr(c, env, subject)
            checkPattern(c, env, subject, pattern)
        }
        ast.Expr.Ident(name, _) {
            checkName(c, env, name)
        }
        ast.Expr.Member(subject, field, _) {
            checkMember(c, env, subject, field)
        }
        _ { }
    }
}

// Only `reveal` opens a `Secret`, so nothing that shows a value shows one.
proc checkShown(c: mut Check, env: infer.Env, value: ast.Expr, what: Str): void {
    ty := infer.typeOf(env, value)
    if ty is types.Ty.TSecret(_) {
        report(c, messages.secretShown(what, types.show(ty)))
    } else if types.holdsSecret(env.table, ty) {
        report(c, messages.secretHeldShown(what, types.show(ty)))
    }
}

// A vector and a `Str` both have a subscript; a map does not — there is no
// first pair to ask for.
proc checkIndexable(c: mut Check, env: infer.Env, subject: ast.Expr): void {
    ty := infer.typeOf(env, subject)
    if ty is types.Ty.TMap(_, _) {
        report(c, messages.mapByPosition())
    }
}

proc checkName(c: mut Check, env: infer.Env, name: Str): void {
    if name == "_" {
        return
    }
    if infer.isBound(env, name) {
        return
    }
    if name == "hive" {
        report(c, messages.hiveNotValue())
        return
    }
    if indexOf(c.laws, name) is Result.Ok(_) {
        report(c, messages.lawNotValue(types.shownName(name)))
        return
    }
    if types.findCallable(env.table, name) is Result.Ok(_) {
        return
    }
    if types.findType(env.table, name) is Result.Ok(_) || name == "Result" {
        report(c, messages.typeNotValue(types.shownName(name)))
        return
    }
    // A builtin is a name a *call* reaches, never a value. Several are overloaded
    // — `len` takes a vector, a `Str` or a map — so which one a bare reference
    // meant is decided by the argument types, and a value carries none. The same
    // reason a generic cannot be a value, with the same two ways out.
    if infer.isBuiltin(name) {
        report(c, messages.builtinNotValue(name))
        return
    }
    report(c, messages.nameNotDeclared(name))
}

proc checkMember(c: mut Check, env: infer.Env, subject: ast.Expr, field: Str): void {
    // A `hive.<module>.<name>` is a library call and is checked where it is
    // called, not where the module is named.
    if subject is ast.Expr.Ident(head, _) {
        if head == "hive" {
            if infer.isBuiltin(field) {
                report(c, messages.hiveBuiltinNotValue(field))
            } else if stdlib.isKnownModule(field) {
                report(c, messages.hiveModuleNotValue(field))
            } else {
                report(c, messages.compilerLacksModule(field))
            }
            return
        }
        if head == "Result" {
            if field == "Ok" || field == "Error" {
                report(c, messages.resultVariantNotValue(field))
            } else {
                report(c, messages.resultNoSuchVariant(field))
            }
            return
        }
        if types.findType(env.table, head) is Result.Ok(_) {
            checkVariantValue(c, env, head, field)
            return
        }
    }
    if subject is ast.Expr.Member(root, module, _) {
        if root is ast.Expr.Ident(hiveName, _) {
            if hiveName == "hive" {
                wrong := libraryValue(env.table, module, field)
                if wrong == "" {
                    report(c, messages.libTypeNotValue(module, field))
                } else {
                    report(c, wrong)
                }
                return
            }
        }
        if root is ast.Expr.Member(head, libModule, _) {
            if head is ast.Expr.Ident(rootName, _) && rootName == "hive" {
                checkLibraryMember(c, env, libModule, module, field)
                return
            }
        }
    }
    checkExpr(c, env, subject)
    ty := infer.typeOf(env, subject)
    if ty is types.Ty.TNamed(name) {
        if hasField(env.table, name, field) == false {
            report(c, messages.noSuchField(types.shownName(name), field, ""))
        } else if variantOnly(env.table, name, field) != "" {
            report(c, unsharedField(env.table, name, field))
        }
    } else if hasNoFields(ty) {
        report(c, messages.noSuchField(types.show(ty), field, shadowedModule(subject)))
    }
}

// What is wrong with `hive.<module>.<name>` where a value was wanted, or `""` for a type.
func libraryValue(t: types.Table, module: Str, name: Str): Str {
    if stdlib.isKnownModule(module) == false {
        return messages.compilerLacksModule(module)
    }
    if stdlib.hasName(t, module, name) == false {
        return messages.libHasNoName(module, name)
    }
    if stdlib.isLibType(t, module, name) == false {
        return messages.libCallNotValue(module, name)
    }
    return ""
}

proc checkLibraryMember(c: mut Check, env: infer.Env, module: Str, typeName: Str, field: Str): void {
    wrong := libraryValue(env.table, module, typeName)
    if wrong != "" {
        report(c, wrong)
        return
    }
    shown := "hive.{module}.{typeName}"
    variants := stdlib.variantsOf(env.table, module, typeName)
    if indexOf(variants, field) is Result.Ok(_) {
        report(c, messages.variantNotBuilt(shown, field))
    } else if len(variants) > 0 {
        report(c, messages.libNoVariant(shown, field, join(variants, ", ")))
    } else {
        report(c, messages.libNoMember(shown, field))
    }
}

func hasNoFields(ty: types.Ty): Bool {
    return ty is types.Ty.TStr || types.isNumber(ty)
        || ty is types.Ty.TBool || ty is types.Ty.TAtom || ty is types.Ty.TAddress(_)
        || ty is types.Ty.TSecret(_)
        || ty is types.Ty.TFn(_, _, _, _) || ty is types.Ty.TVec(_, _)
        || ty is types.Ty.TResult(_, _) || ty is types.Ty.TMap(_, _)
}

func shadowedModule(subject: ast.Expr): Str {
    if subject is ast.Expr.Ident(name, _) {
        if stdlib.isKnownModule(name) {
            return messages.moduleShadowed(name)
        }
    }
    return ""
}

func unsharedField(t: types.Table, typeName: Str, field: Str): Str {
    shown := types.shownName(typeName)
    owner := variantOnly(t, typeName, field)
    mut holders := 0
    if types.findType(t, typeName) is Result.Ok(info) {
        for each v in info.variants {
            for each f in v.fields {
                if f.name == field {
                    holders = holders + 1
                }
            }
        }
    }
    if holders > 1 {
        return messages.fieldInSeveralVariants(field, shown)
    }
    return messages.fieldInOneVariant(field, owner, shown)
}

// The variant a union's field belongs to, when it is not one every variant has.
func variantOnly(t: types.Table, typeName: Str, field: Str): Str {
    if types.findType(t, typeName) is Result.Ok(info) {
        for each f in info.shared {
            if f.name == field {
                return ""
            }
        }
        for each v in info.variants {
            for each f in v.fields {
                if f.name == field {
                    return v.name
                }
            }
        }
    }
    return ""
}

// A variant named where a value is wanted. Building one is a call — the same
// call a variant carrying fields is built by — so the name on its own is the
// variant rather than a value of it, and Go has nothing to make of it.
proc checkVariantValue(c: mut Check, env: infer.Env, head: Str, field: Str): void {
    shown := types.shownName(head)
    if types.findVariant(env.table, head, field) is Result.Ok(fields) {
        if len(fields) == 0 {
            report(c, messages.variantNotBuilt(shown, field))
            return
        }
        report(c, messages.variantConstructorNotValue(shown, field))
        return
    }
    report(c, messages.noSuchVariant(shown, field))
}

func hasField(t: types.Table, typeName: Str, field: Str): Bool {
    if types.findType(t, typeName) is Result.Ok(info) {
        for each f in info.shared {
            if f.name == field {
                return true
            }
        }
        for each v in info.variants {
            for each f in v.fields {
                if f.name == field {
                    return true
                }
            }
        }
    }
    return false
}

// There is no implicit numeric widening anywhere, so an operator's two sides
// have to be the same type — the rule that makes `hive.math.max(0, health)` a
// compile error rather than a surprise.
proc checkOperands(c: mut Check, env: infer.Env, op: ast.BinOp, left: ast.Expr, right: ast.Expr): void {
    leftType := infer.typeOf(env, left)
    rightType := infer.typeOf(env, right)
    if leftType is types.Ty.TUnknown || rightType is types.Ty.TUnknown {
        return
    }
    if op is ast.BinOp.And || op is ast.BinOp.Or {
        if leftType is types.Ty.TBool && rightType is types.Ty.TBool {
            return
        }
        report(c, messages.boolOpNotBools(ast.opSpelling(op), types.show(leftType), types.show(rightType)))
        return
    }
    if infer.isShift(op) {
        checkShift(c, op, right, leftType, rightType)
        return
    }
    operands := infer.operandType(env, left, right)
    if operands is types.Ty.TUnknown {
        // Comparing converts nothing that is kept, so two integers compare by value
        // whatever their sizes, which is what keeps `i < len(v)` a guard.
        if infer.isComparison(op) && types.isInteger(leftType) && types.isInteger(rightType) {
            return
        }
        if types.operandsFit(leftType, rightType) == false {
            report(c, messages.operandsMixed(ast.opSpelling(op), types.show(leftType), types.show(rightType), whyMixed(leftType, rightType)))
            return
        }
        checkOperandKind(c, env, op, leftType)
        return
    }
    spelled := messages.backticked(ast.opSpelling(op))
    if literalMisses(c, operands, left, spelled) || literalMisses(c, operands, right, spelled) {
        return
    }
    checkOperandKind(c, env, op, operands)
}

// What each operator is defined on (5.6), once both sides are the same type.
proc checkOperandKind(c: mut Check, env: infer.Env, op: ast.BinOp, ty: types.Ty): void {
    spelled := messages.backticked(ast.opSpelling(op))
    number := types.isNumber(ty)
    if op is ast.BinOp.Eq || op is ast.BinOp.Neq {
        if types.holds(env.table, ty, isFunction, []) {
            report(c, messages.functionsHaveNoEquality(spelled))
        }
    } else if op is ast.BinOp.Lt || op is ast.BinOp.Gt || op is ast.BinOp.Le || op is ast.BinOp.Ge {
        if (number || ty is types.Ty.TStr) == false {
            report(c, messages.orderingWrongType(spelled, types.show(ty)))
        }
    } else if op is ast.BinOp.Add {
        if (number || ty is types.Ty.TStr || ty is types.Ty.TVec(_, _)) == false {
            report(c, messages.plusWrongType(types.show(ty)))
        }
    } else if op is ast.BinOp.And || op is ast.BinOp.Or {
    } else if infer.isBitwise(op) {
        if types.isInteger(ty) == false {
            report(c, messages.bitwiseNotInteger(spelled, types.show(ty), boolInstead(op, ty)))
        }
    } else if number == false {
        report(c, messages.arithmeticNotNumber(spelled, types.show(ty)))
    }
}

// The `Bool` operator somebody reaching for a bitwise one on two `Bool`s meant.
func boolInstead(op: ast.BinOp, ty: types.Ty): Str {
    if (ty is types.Ty.TBool) == false {
        return ""
    }
    if op is ast.BinOp.BitAnd { return messages.boolAndInstead() }
    if op is ast.BinOp.BitOr { return messages.boolOrInstead() }
    if op is ast.BinOp.BitXor { return messages.boolXorInstead() }
    return ""
}

// A shift moves the left side's bits, so its answer is that type whatever the count
// is. The count is unsigned or a literal: a negative one has no answer to give.
proc checkShift(c: mut Check, op: ast.BinOp, count: ast.Expr, leftType: types.Ty, countType: types.Ty): void {
    spelled := messages.backticked(ast.opSpelling(op))
    if types.isInteger(leftType) == false {
        report(c, messages.shiftNotInteger(spelled, types.show(leftType)))
        return
    }
    if infer.intLiteral(count) is Result.Ok(n) {
        if n < 0 {
            report(c, messages.shiftNegative(spelled, n))
        }
        return
    }
    if types.isUnsigned(countType) == false {
        report(c, messages.shiftCountSigned(spelled, types.show(countType), ast.opSpelling(op)))
    }
}

func isFunction(ty: types.Ty): Bool {
    return ty is types.Ty.TFn(_, _, _, _)
}

// --- Calls -------------------------------------------------------------------

proc checkCall(c: mut Check, env: infer.Env, callee: ast.Expr, args: ast.Arg[]): void {
    bare := c.bare
    c.bare = false
    for each a in args {
        if a.value is ast.Expr.Hole {
            continue
        }
        checkExpr(c, env, a.value)
    }
    if infer.typeOf(env, callee) is types.Ty.TAddress(mailbox) {
        checkSend(c, env, callee, mailbox, args)
    }
    if callee is ast.Expr.Ident(name, _) {
        c.bare = bare
        checkNamedCall(c, env, name, args)
        c.bare = false
        return
    }
    if callee is ast.Expr.Member(subject, field, _) {
        c.bare = bare
        checkMemberCall(c, env, subject, field, args)
        c.bare = false
        return
    }
    checkExpr(c, env, callee)
    if infer.typeOf(env, callee) is types.Ty.TFn(_, params, mutables, _) {
        checkValueArguments(c, env, messages.functionValueShown(), params, mutables, args)
    }
}

// A send carries one message, of the type the address says its service takes.
proc checkSend(c: mut Check, env: infer.Env, callee: ast.Expr, mailbox: types.Ty, args: ast.Arg[]): void {
    if len(args) != 1 {
        report(c, messages.sendArgCount(countOf(len(args))))
        return
    }
    if mailbox is types.Ty.TUnknown {
        if isAtCall(callee) {
            report(c, messages.sendToBareAt())
        }
        return
    }
    fitsArg(c, env, mailbox, args, 0, messages.messageSentTo(types.show(types.Ty.TAddress(mailbox))))
    checkCrosses(c, env, messages.messageToService(), mailbox)
}

proc checkNamedCall(c: mut Check, env: infer.Env, name: Str, args: ast.Arg[]): void {
    // A local binding shadows a declaration, which shadows a builtin, so a call
    // through one calls whatever the binding holds. That order is `callTarget`,
    // which inference and the emitter read the same call through.
    target := infer.callTarget(env, name)
    switch target {
        infer.CallTarget.Bound {
            checkCallableValue(c, env, name)
            if infer.typeOf(env, ast.Expr.Ident(name, c.at)) is types.Ty.TFn(_, params, mutables, _) {
                checkValueArguments(c, env, messages.backticked(name), params, mutables, args)
            }
        }
        infer.CallTarget.Declared(info) {
            if c.inLaw == false && indexOf(c.laws, name) is Result.Ok(_) {
                report(c, messages.lawCalledOutsideLaw(types.shownName(name)))
            }
            checkArguments(c, env, name, info, args)
        }
        infer.CallTarget.Struct(fields) {
            checkFieldArguments(c, env, name, fields, args)
        }
        infer.CallTarget.Builtin {
            checkBuiltinCall(c, env, name, args)
        }
        infer.CallTarget.Union {
            report(c, messages.unionCalled(types.shownName(name)))
        }
        _ {
            report(c, messages.nameNotDeclared(name))
        }
    }
}

// What a name has to hold for a call through it to mean something: a callable value,
// or an address, which a call sends to and waits for the answer of. `TUnknown` and a
// type variable are not complained about, having been complained about already.
proc checkCallableValue(c: mut Check, env: infer.Env, name: Str): void {
    ty := infer.typeOf(env, ast.Expr.Ident(name, c.at))
    if ty is types.Ty.TFn(_, _, _, _) {
        return
    }
    if ty is types.Ty.TUnknown {
        return
    }
    if ty is types.Ty.TVar(_) {
        return
    }
    if ty is types.Ty.TAddress(_) {
        return
    }
    report(c, messages.callThroughNonCallable(name, types.show(ty)))
}

proc checkMemberCall(c: mut Check, env: infer.Env, subject: ast.Expr, field: Str, args: ast.Arg[]): void {
    if subject is ast.Expr.Ident(head, _) {
        if head == "Result" {
            if field != "Ok" && field != "Error" {
                report(c, messages.resultNoSuchVariant(field))
            } else if len(args) != 1 {
                report(c, messages.resultPayloadCount(field, countOf(len(args))))
            }
            return
        }
        if head == "hive" {
            checkBuiltinCall(c, env, field, args)
            return
        }
        if head == "Table" && field == "decode" {
            report(c, stdlib.tableHasNoDecoder())
            return
        }
        shown := types.shownName(head)
        if types.findType(env.table, head) is Result.Ok(info) {
            // `T.decode(text, codec)` is the decoder, not a variant.
            if field == "decode" {
                checkDecodes(c, env, messages.decoderShown(shown), head, args)
                return
            }
            if types.findVariant(env.table, head, field) is Result.Ok(fields) {
                checkFieldArguments(c, env, shown + "." + field, fields, args)
            } else {
                report(c, messages.noSuchVariant(shown, field))
            }
            return
        }
        if infer.isConversion(head) {
            target := infer.conversionType(head)
            if field != "checked" || types.isInteger(target) == false {
                report(c, messages.conversionMemberNotCall(head, field))
            } else if arity(c, "{head}.checked", args, 1) {
                checkConversion(c, head, typeOfArg(c, env, args, 0))
            }
            return
        }
    }
    if subject is ast.Expr.Member(root, module, _) {
        // `T.Variant.decode(text, codec)` — the one variant's own decoder.
        if field == "decode" {
            if root is ast.Expr.Ident(head, _) {
                shown := types.shownName(head)
                if stdlib.isJsonValue(head) {
                    report(c, messages.jsonValueVariantDecode(shown))
                    return
                }
                if types.findType(env.table, head) is Result.Ok(_) {
                    if types.findVariant(env.table, head, module) is Result.Ok(_) {
                        checkDecodes(c, env, messages.variantDecoderShown(shown, module), head, args)
                    } else {
                        report(c, messages.noVariantToDecode(shown, module, join(types.variantNames(env.table, head), ", ")))
                    }
                    return
                }
            }
        }
        if root is ast.Expr.Ident(hiveName, _) {
            if hiveName == "hive" {
                if stdlib.isKnownModule(module) == false {
                    report(c, messages.compilerLacksModule(module))
                } else if stdlib.hasName(env.table, module, field) == false {
                    report(c, messages.libHasNoName(module, field))
                } else {
                    checkLibraryArguments(c, env, module, field, args)
                }
                return
            }
        }
        // `hive.ui.TextSize.Caption()` — a variant of one of the library's own
        // enumerations. Nothing downstream can refuse a name that is not one: it
        // lowers to a member of a member and the Go toolchain reports it.
        if root is ast.Expr.Member(head, libModule, _) {
            if head is ast.Expr.Ident(rootName, _) && rootName == "hive" {
                variants := stdlib.variantsOf(env.table, libModule, module)
                if len(variants) > 0 {
                    if indexOf(variants, field) is Result.Error(_) {
                        report(c, messages.libNoVariant("hive.{libModule}.{module}", field, join(variants, ", ")))
                    }
                    return
                }
                if stdlib.isKnownModule(libModule) == false {
                    report(c, messages.compilerLacksModule(libModule))
                    return
                }
                if stdlib.isLibType(env.table, libModule, module) == false {
                    report(c, messages.libHasNoName(libModule, module))
                    return
                }
            }
        }
    }
    checkMember(c, env, subject, field)
    // A call through a function value is checked by what the value's type says.
    ty := infer.typeOf(env, ast.Expr.Member(subject, field, c.at))
    if ty is types.Ty.TFn(_, params, mutables, _) {
        checkValueArguments(c, env, messages.backticked(field), params, mutables, args)
    }
}

proc checkValueArguments(c: mut Check, env: infer.Env, shown: Str, params: types.Ty[], mutables: Bool[], args: ast.Arg[]): void {
    if len(params) != len(args) {
        report(c, messages.valueArgCount(shown, countOf(len(params)), countOf(len(args))))
        return
    }
    partial := hasHole(args)
    mut ast.Expr[dyn] lent = []
    mut i := 0
    for each a in args {
        if a.name != "" {
            report(c, messages.functionValueArgNamed(shown, a.name))
            return
        }
        if a.value is ast.Expr.Hole {
            i = i + 1
            continue
        }
        if types.mutableAt(mutables, i) {
            checkMutableArgument(c, shown, messages.parameterNumber(i + 1), a.value, partial)
            append(lent, a.value)
        }
        if params bounds i {
            where := messages.argumentOf(i + 1, shown)
            if refusesFixedForDyn(c, params[i], infer.typeOf(env, a.value), types.mutableAt(mutables, i), where) {
            } else if types.mutableAt(mutables, i) {
                fits(c, params[i], infer.typeOf(env, a.value), where)
            } else {
                fitsValue(c, env, params[i], a.value, where)
            }
        }
        i = i + 1
    }
    checkLentApart(c, shown, lent)
}

proc checkMutableArgument(c: mut Check, shown: Str, param: Str, found: ast.Expr, partial: Bool): void {
    if partial {
        report(c, messages.partialLendsMut(shown, param))
        return
    }
    root := rootName(found)
    if root == "" || isMutable(c.mutable, root) == false {
        report(c, messages.mutArgNotMutable(shown, param))
    }
}

// Through the outer argument the call may grow the vector the inner one is in.
proc checkLentApart(c: mut Check, shown: Str, lent: ast.Expr[]): void {
    for each outer in lent {
        for each inner in lent {
            if reachesInto(stepsOf(outer), stepsOf(inner)) {
                report(c, messages.lentApart(shown, pathText(outer), pathText(inner)))
                return
            }
        }
    }
}

// `[?]` stands for an index that is not a literal.
func stepsOf(e: ast.Expr): Str[dyn] {
    if e is ast.Expr.Ident(name, _) { return [name] }
    if e is ast.Expr.Member(subject, field, _) {
        mut out := stepsOf(subject)
        if len(out) > 0 {
            append(out, "." + field)
        }
        return out
    }
    if e is ast.Expr.Index(subject, index, _) {
        mut out := stepsOf(subject)
        if len(out) > 0 {
            if index is ast.Expr.IntLit(n, _) {
                append(out, "[{n}]")
            } else {
                append(out, "[?]")
            }
        }
        return out
    }
    return []
}

// Two indexes may name one element unless both are literals that differ.
func reachesInto(outer: Str[], inner: Str[]): Bool {
    if len(outer) == 0 || len(inner) <= len(outer) {
        return false
    }
    mut at := 0
    for each step in outer {
        if inner bounds at {
            if sameStep(step, inner[at]) == false {
                return false
            }
        }
        at = at + 1
    }
    mut rest := len(outer)
    for each step in inner {
        if rest <= 0 && text.startsWith(step, "[") {
            return true
        }
        rest = rest - 1
    }
    return false
}

func sameStep(a: Str, b: Str): Bool {
    if a == b {
        return true
    }
    return (a == "[?]" && text.startsWith(b, "[")) || (b == "[?]" && text.startsWith(a, "["))
}

func pathText(e: ast.Expr): Str {
    if e is ast.Expr.Ident(name, _) { return name }
    if e is ast.Expr.Member(subject, field, _) { return pathText(subject) + "." + field }
    if e is ast.Expr.Index(subject, index, _) {
        if index is ast.Expr.IntLit(n, _) {
            return pathText(subject) + "[{n}]"
        }
        return pathText(subject) + "[" + pathText(index) + "]"
    }
    if e is ast.Expr.StrLit(t, _) { return "\"{t}\"" }
    if infer.intLiteral(e) is Result.Ok(n) { return "{n}" }
    return "…"
}

// What a standard library call takes: how many, where the table can say, and what
// each position holds. The type table is positional rather than a count, so the
// positions it has an answer for are checked and the rest left.
//
// Without it the mismatch reaches the Go toolchain, which reports it in terms of
// Go's own types — and a message that only said `float64` would leave the reader
// hunting for a conversion nobody mentioned.
proc checkLibraryArguments(c: mut Check, env: infer.Env, module: Str, name: Str, written: ast.Arg[]): void {
    // One of the library's own types being built takes its fields, matched by
    // name the way a declared type's are.
    fields := stdlib.fieldsOf(env.table, module, name)
    if len(fields) > 0 {
        checkFieldArguments(c, env, "hive.{module}.{name}", fields, written)
        return
    }
    if refusesHoles(c, messages.backticked("hive.{module}.{name}"), written) {
        return
    }
    if checkArgumentNames(c, "hive.{module}.{name}", stdlib.paramNamesOf(env.table, module, name), written) == false {
        return
    }
    args := stdlib.libraryArgs(env.table, module, name, written)
    if module == "sql" && name == "run" {
        checkRunsQuery(c, env, args)
    }
    if module == "ui" && (name == "window" || name == "webview") && len(args) == 3 {
        checkWindow(c, env, name, ast.argFor(args, "", 1), ast.argFor(args, "", 2))
    }
    // The notice is posted to the watcher, so it is one of the watcher's messages.
    if module == "syslink" && name == "monitor" && len(args) == 3 {
        if infer.typeOf(env, ast.argFor(args, "", 0)) is types.Ty.TAddress(mailbox) {
            fits(c, mailbox, typeOfArg(c, env, args, 2), messages.monitorNoticeToWatcher())
        }
        checkCrosses(c, env, messages.monitorNotice(), typeOfArg(c, env, args, 2))
    }
    // A `mut` parameter follows `append`'s rule: what it is handed is a `mut`
    // variable or a path into one. Anything else would be storage some immutable
    // name still observes, through which the write would reach the caller.
    names := stdlib.paramNamesOf(env.table, module, name)
    ordered := ast.positional(args, names)
    mut i := 0
    for each writes in types.callMutables(env.table, module, name) {
        if writes && ordered bounds i && names bounds i {
            root := rootName(ordered[i].value)
            if root == "" || isMutable(c.mutable, root) == false {
                report(c, messages.libWritesIntoImmutable(module, name, names[i]))
            }
        }
        i = i + 1
    }
    if module == "map" && infer.typeOf(env, ast.argFor(args, "", 0)) is types.Ty.TMap(key, value) {
        if (name == "set" || name == "get" || name == "has" || name == "delete" || name == "plus" || name == "minus") && args bounds 1 {
            fitsValue(c, env, key, args[1].value, messages.mapKeyWhat(name))
        }
        if (name == "set" || name == "plus") && args bounds 2 {
            fitsValue(c, env, value, args[2].value, messages.mapValueWhat(name))
        }
    }
    if stdlib.signatureOf(env.table, module, name) is Result.Ok(wanted) {
        if len(args) != len(wanted) {
            report(c, messages.callArgCount("hive.{module}.{name}", countOf(len(wanted)), countOf(len(args))))
            return
        }
        names := stdlib.paramNamesOf(env.table, module, name)
        named := ast.anyNamed(written)
        mut i := 0
        for each a in args {
            if a.value is ast.Expr.Hole {
                i = i + 1
                continue
            }
            // A call that named its arguments is told about them by name.
            mut which := messages.nthArgument(nth(i))
            if named && names bounds i {
                which = messages.namedArgument(names[i])
            }
            if wanted bounds i {
                mut here := wanted[i]
                if module == "math" && stdlib.resultOf(env.table, module, name, infer.mathArgTypes(env, args)) is types.Ty.TFloat32 {
                    here = types.Ty.TFloat32()
                }
                where := messages.argumentOfLibrary(which, module, name)
                takes := types.callTakes(env.table, module, name)
                if takes bounds i && refusesFixedForDyn(c, takes[i], infer.typeOf(env, a.value), false, where) {
                } else {
                    fitsValue(c, env, here, a.value, where)
                }
            }
            i = i + 1
        }
    }
}

proc checkSpawn(c: mut Check, env: infer.Env, args: ast.Arg[]): void {
    if len(args) != 2 && len(args) != 3 {
        report(c, messages.spawnArgCount(countOf(len(args))))
        return
    }
    if checkHandler(c, env, messages.backticked("spawn"), ast.argFor(args, "", 0)) {
        if infer.typeOf(env, ast.argFor(args, "", 0)) is types.Ty.TFn(_, params, _, _) {
            fitsArg(c, env, infer.typeAt(params, 0), args, 1, messages.spawnStateWhat())
        }
    }
    if len(args) == 3 {
        fits(c, types.Ty.TAtom(), typeOfArg(c, env, args, 2), messages.spawnNameWhat())
    }
}

proc checkAt(c: mut Check, env: infer.Env, args: ast.Arg[]): void {
    if len(args) == 1 {
        fits(c, types.Ty.TAtom(), typeOfArg(c, env, args, 0), messages.atNameWhat())
        return
    }
    if len(args) == 2 {
        fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 0), messages.atEndpointWhat())
        fits(c, types.Ty.TAtom(), typeOfArg(c, env, args, 1), messages.atNameWhat())
        return
    }
    report(c, messages.atArgCount(countOf(len(args))))
}

proc checkHandler(c: mut Check, env: infer.Env, starts: Str, handler: ast.Expr): Bool {
    ty := infer.typeOf(env, handler)
    if ty is types.Ty.TUnknown {
        return false
    }
    shape := messages.handlerShape()
    if ty is types.Ty.TFn(_, params, mutables, result) {
        if len(params) != 2 && len(params) != 3 {
            report(c, messages.handlerParamCount(starts, shape, len(params)))
            return false
        }
        if types.mutableAt(mutables, 0) == false {
            report(c, messages.handlerStateNotMut(types.show(infer.typeAt(params, 0)), starts))
            return false
        }
        if types.mutableAt(mutables, 1) {
            report(c, messages.handlerMessageMut())
            return false
        }
        message := infer.typeAt(params, 1)
        if types.same(result, message) == false {
            report(c, messages.handlerReturnsOther(types.show(message), types.show(result)))
            return false
        }
        own := types.Ty.TAddress(message)
        if len(params) == 3 && types.same(infer.typeAt(params, 2), own) == false {
            report(c, messages.handlerThirdParam(types.show(own), types.show(infer.typeAt(params, 2))))
            return false
        }
        checkCrosses(c, env, messages.messageToService(), message)
        return true
    }
    report(c, messages.notHandler(starts, shape, types.show(ty)))
    return false
}

proc checkWindow(c: mut Check, env: infer.Env, name: Str, view: ast.Expr, update: ast.Expr): void {
    if checkHandler(c, env, messages.backticked("hive.ui.{name}"), update) == false {
        return
    }
    mut state := types.Ty.TUnknown()
    if infer.typeOf(env, update) is types.Ty.TFn(_, params, _, _) {
        state = infer.typeAt(params, 0)
    }
    fits(c, types.Ty.TFn(true, [state], [false], types.Ty.TLib("ui", "View")), infer.typeOf(env, view),
        messages.windowViewWhat(name))
}

// `hive.sql.run` is the one library call whose second argument has a shape
// rather than a type: a fragment of some row type, which is what tells it how to
// read what comes back. Nothing downstream can refuse a wrong one — the emitter
// needs the row type before it can write the mapper — so it is refused here.
proc checkRunsQuery(c: mut Check, env: infer.Env, args: ast.Arg[]): void {
    if len(args) < 2 {
        report(c, messages.sqlRunNeedsQuery())
        return
    }
    if args bounds 1 {
        asked := args[1].value
        if asked is ast.Expr.Hole {
            return
        }
        held := infer.typeOf(env, asked)
        if held is types.Ty.TFragment(_) {
            return
        }
        if held is types.Ty.TUnknown {
            return
        }
        report(c, messages.sqlRunNotFragment(types.show(held)))
    }
}

// Why an `Int` beside a `Float` is refused, said only where that is what
// happened — anywhere else it would explain something that is not the mistake.
func whyMixed(left: types.Ty, right: types.Ty): Str {
    if isNumberPair(left, right) {
        return messages.mixedIntFloat()
    }
    if types.isNumber(left) && types.isNumber(right) {
        return messages.mixedNumbers(types.show(right))
    }
    return ""
}

func isNumberPair(left: types.Ty, right: types.Ty): Bool {
    if types.isInteger(left) {
        return types.isFloat(right)
    }
    if types.isFloat(left) {
        return types.isInteger(right)
    }
    return false
}

proc checkArguments(c: mut Check, env: infer.Env, name: Str, info: types.CallableInfo, args: ast.Arg[]): void {
    if checkArgumentNames(c, name, namesOfParams(info.params), args) == false {
        return
    }
    if len(args) != len(info.params) {
        report(c, messages.callArgCount(name, countOf(len(info.params)), countOf(len(args))))
        return
    }
    partial := hasHole(args)
    mut ast.Expr[dyn] lent = []
    mut open := 0
    for each p in info.params {
        found := ast.argFor(args, p.name, open)
        if ast.claimedByName(args, p.name) == false {
            open = open + 1
        }
        if found is ast.Expr.Hole {
            continue
        }
        // A `mut T` parameter takes the caller's own storage, so the argument has
        // to be a `mut` variable or a path into one.
        if p.mutable {
            checkMutableArgument(c, messages.backticked(name), messages.mutParamShown(p.name), found, partial)
            append(lent, found)
        }
        declared := types.resolve(env.table, p.declared)
        where := messages.namedArgumentOf(p.name, name)
        if refusesFixedForDyn(c, declared, infer.typeOf(env, found), p.mutable, where) {
        } else if p.mutable {
            fits(c, declared, infer.typeOf(env, found), where)
        } else {
            fitsValue(c, env, declared, found, where)
        }
    }
    checkLentApart(c, messages.backticked(name), lent)
}

// A parameter declared `[dyn]` takes only a vector declared `[dyn]`: a fixed length
// never becomes one by being handed along. `T[]` is the parameter for any length.
proc refusesFixedForDyn(c: mut Check, wanted: types.Ty, given: types.Ty, mutable: Bool, where: Str): Bool {
    if wanted is types.Ty.TVec(element, wantedDim) && given is types.Ty.TVec(_, givenDim) {
        if wantedDim is ast.Dim.Dynamic && givenDim is ast.Dim.Fixed(_) {
            if mutable {
                report(c, messages.fixedIntoMutDynParam(where, types.show(wanted), types.show(given)))
            } else {
                report(c, messages.fixedIntoDynParam(where, types.show(wanted), types.show(given), types.show(element)))
            }
            return true
        }
    }
    return false
}

// Neither has a signature a function value could carry.
proc refusesHoles(c: mut Check, shown: Str, args: ast.Arg[]): Bool {
    if hasHole(args) {
        report(c, messages.holesRefused(shown))
        return true
    }
    return false
}

func hasHole(args: ast.Arg[]): Bool {
    for each a in args {
        if a.value is ast.Expr.Hole {
            return true
        }
    }
    return false
}

proc checkFieldArguments(c: mut Check, env: infer.Env, name: Str, fields: ast.Field[], args: ast.Arg[]): void {
    if checkArgumentNames(c, name, namesOfFields(fields), args) == false {
        return
    }
    if len(args) != len(fields) {
        report(c, messages.fieldArgCount(name, fieldCount(len(fields)), countOf(len(args))))
        return
    }
    mut open := 0
    for each f in fields {
        found := ast.argFor(args, f.name, open)
        if ast.claimedByName(args, f.name) == false {
            open = open + 1
        }
        if found is ast.Expr.Hole {
            continue
        }
        fitsValue(c, env, types.resolve(env.table, f.declared), found, messages.fieldOfWhat(f.name, name))
    }
}

// Named arguments may appear anywhere; only the unnamed ones need to be in
// order. Names must exist, must not repeat, and once named arguments are used
// the call must cover the full parameter list.
proc checkArgumentNames(c: mut Check, name: Str, parameters: Str[], args: ast.Arg[]): Bool {
    mut Int[dyn] seen = []
    mut named := false
    for each a in args {
        if a.name == "" {
            continue
        }
        named = true
        slot := ast.slotNamed(parameters, a.name)
        if slot < 0 {
            report(c, messages.noParamCalled(name, a.name, parameterList(parameters)))
            return false
        }
        if indexOf(seen, slot) is Result.Ok(_) {
            report(c, messages.argNamedTwice(a.name))
            return false
        }
        append(seen, slot)
    }
    if named && len(args) != len(parameters) {
        report(c, messages.namedArgsIncomplete(name, countOf(len(parameters))))
        return false
    }
    return true
}

// The names a call could have used, for a message about one it could not.
func parameterList(parameters: Str[]): Str {
    if len(parameters) == 0 {
        return messages.takesNoArguments()
    }
    mut Str[dyn] shown = []
    for each p in parameters {
        append(shown, messages.backticked(join(split(p, "|"), messages.orBetweenNames())))
    }
    return messages.parametersAre(join(shown, ", "))
}

func namesOfParams(params: ast.Param[]): Str[dyn] {
    mut Str[dyn] out = []
    for each p in params {
        append(out, p.name)
    }
    return out
}

func namesOfFields(fields: ast.Field[]): Str[dyn] {
    mut Str[dyn] out = []
    for each f in fields {
        append(out, f.name)
    }
    return out
}

// Which argument, counted the way a person counts them.
func nth(index: Int): Str {
    return messages.ordinal(index)
}

func countOf(n: Int): Str {
    return messages.argumentCount(n)
}

func fieldCount(n: Int): Str {
    return messages.fieldsCount(n)
}

// --- The builtins ------------------------------------------------------------

// Every builtin has a signature ([13](../spec/13-builtins.md)), and a call that
// does not match one is a compile error. Caught here rather than left to the
// generated Go, whose message would be about Go's types and a file nobody wrote.
proc checkBuiltinCall(c: mut Check, env: infer.Env, name: Str, written: ast.Arg[]): void {
    if refusesHoles(c, messages.backticked(name), written) {
        return
    }
    if checkArgumentNames(c, name, infer.builtinParams(name, len(written)), written) == false {
        return
    }
    args := infer.builtinArgs(name, written)
    if name == "append" || name == "prepend" {
        checkGrows(c, env, name, args, 2)
        // What goes in has to be what the vector holds.
        if len(args) == 2 {
            element := types.elementOf(typeOfArg(c, env, args, 0))
            fitsArg(c, env, element, args, 1, messages.putsInWhat(name))
        }
    } else if name == "drop" {
        checkGrows(c, env, name, args, 3)
        if len(args) == 3 {
            fits(c, types.Ty.TInt(), typeOfArg(c, env, args, 1), messages.dropLowWhat())
            fits(c, types.Ty.TInt(), typeOfArg(c, env, args, 2), messages.dropHighWhat())
        }
    } else if name == "sort" {
        checkSort(c, env, args)
    } else if name == "map" || name == "filter" || name == "filterMap" {
        checkWalk(c, env, name, args)
    } else if name == "len" || name == "bytes" {
        checkMeasured(c, env, name, args)
    } else if name == "join" {
        if arity(c, name, args, 2) {
            fits(c, strings(), typeOfArg(c, env, args, 0), messages.joinWhat())
            fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 1), messages.joinSeparatorWhat())
        }
    } else if name == "split" {
        if arity(c, name, args, 2) {
            fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 0), messages.splitWhat())
            fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 1), messages.splitSeparatorWhat())
        }
    } else if name == "trim" {
        if arity(c, name, args, 1) {
            fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 0), messages.trimWhat())
        }
    } else if name == "replaceFirst" || name == "replaceAll" {
        if arity(c, name, args, 3) {
            fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 0), messages.rewritesWhat(name))
            fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 1), messages.looksForWhat(name))
            fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 2), messages.putsInPlaceWhat(name))
        }
    } else if name == "indexOf" {
        checkIndexOf(c, env, args)
    } else if name == "spawn" {
        checkSpawn(c, env, args)
    } else if name == "at" {
        checkAt(c, env, args)
    } else if name == "kill" {
        if arity(c, name, args, 1) {
            fits(c, types.Ty.TAddress(types.Ty.TUnknown()), typeOfArg(c, env, args, 0), messages.killWhat())
        }
    } else if name == "hide" || name == "bypass" {
        if arity(c, name, args, 1) {
            checkKeepable(c, env, messages.backticked(name), typeOfArg(c, env, args, 0))
        }
    } else if name == "reveal" {
        if arity(c, name, args, 1) {
            fits(c, types.Ty.TSecret(types.Ty.TUnknown()), typeOfArg(c, env, args, 0), messages.revealWhat())
        }
    } else if infer.isConversion(name) {
        if arity(c, name, args, 1) {
            checkConversion(c, name, typeOfArg(c, env, args, 0))
        }
    } else if name == "row" || name == "column" {
        if arity(c, name, args, 2) {
            fits(c, table(), typeOfArg(c, env, args, 0), messages.readsWhat(name))
            fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 1), messages.keyLooksForWhat(name))
        }
    } else if name == "toTable" {
        if arity(c, name, args, 2) {
            fits(c, strings(), typeOfArg(c, env, args, 0), messages.toTableWhat())
            fits(c, types.Ty.TInt(), typeOfArg(c, env, args, 1), messages.toTableWidthWhat())
            checkRowWidth(c, args)
        }
    } else if name == "encode" {
        // Anything with a static type encodes as JSON, so beyond the count the
        // only thing to refuse is a codec whose type names no format — and a
        // value a flat format's parameters cannot hold.
        if arity(c, name, args, 2) {
            if args bounds 1 {
                format := stdlib.formatOfCodec(infer.typeOf(env, args[1].value))
                checkNamesCodec(c, env, messages.backticked("encode"), args[1].value)
                checkFlatShape(c, env, messages.backticked("encode"), typeOfArg(c, env, args, 0), format)
                checkJsonShape(c, env, messages.backticked("encode"), typeOfArg(c, env, args, 0), format, false)
            }
        }
    }
}

// An integer converts to any integer type and a float to any float type; crossing
// between the two is `hive.conv`'s business, which says how it rounds.
proc checkConversion(c: mut Check, name: Str, given: types.Ty): void {
    target := infer.conversionType(name)
    if given is types.Ty.TUnknown {
        return
    }
    if types.isInteger(target) && types.isInteger(given) == false {
        report(c, messages.conversionNeedsInteger(name, types.show(given)))
    } else if types.isFloat(target) && types.isFloat(given) == false {
        report(c, messages.conversionNeedsFloat(name, types.show(given)))
    }
}

// `sort(v)` orders a vector by its element type's own order; `sort(v, first)`
// orders it by a `func` answering whether its first element comes before its
// second.
proc checkSort(c: mut Check, env: infer.Env, args: ast.Arg[]): void {
    if len(args) != 1 && len(args) != 2 {
        report(c, messages.sortArgCount())
        return
    }
    subject := typeOfArg(c, env, args, 0)
    if isVector(subject) == false && isUnknown(subject) == false {
        report(c, messages.sortNotVector(types.show(subject)))
        return
    }
    element := types.elementOf(subject)
    if len(args) == 1 {
        if isVector(subject) && types.isOrdered(env.table, element) == false {
            report(c, messages.sortUnordered(types.show(element)))
        }
        return
    }
    fits(c, types.Ty.TFn(true, [element, element], [false, false], types.Ty.TBool()), typeOfArg(c, env, args, 1),
        messages.sortOrderWhat())
}

// `len` counts a vector's elements, a `Str`'s characters or a map's pairs;
// `bytes` measures a vector's storage or a `Str`'s encoding.
proc checkMeasured(c: mut Check, env: infer.Env, name: Str, args: ast.Arg[]): void {
    if arity(c, name, args, 1) == false {
        return
    }
    subject := typeOfArg(c, env, args, 0)
    if isVector(subject) {
        return
    }
    if subject is types.Ty.TStr {
        return
    }
    // A measurement is one thing for a `Str` and another for a vector, and the
    // answer decides what is emitted. Waving an unknown through picked the
    // vector reading and left the mistake to the Go toolchain, or worse, counted
    // a `Str`'s bytes where its characters were asked for.
    if isUnknown(subject) {
        report(c, messages.measureUnknown(name, mapToo(name)))
        return
    }
    if subject is types.Ty.TMap(_, _) {
        if name == "len" {
            return
        }
        report(c, messages.bytesOfMap())
        return
    }
    report(c, messages.measureWrongType(name, mapToo(name), types.show(subject)))
}

func mapToo(name: Str): Str {
    if name == "len" {
        return messages.orAMap()
    }
    return ""
}

// `indexOf` finds a value in a vector or a substring in a `Str`, and either way
// what is looked for has to be what could be there.
proc checkIndexOf(c: mut Check, env: infer.Env, args: ast.Arg[]): void {
    if arity(c, "indexOf", args, 2) == false {
        return
    }
    subject := typeOfArg(c, env, args, 0)
    if subject is types.Ty.TStr {
        fits(c, types.Ty.TStr(), typeOfArg(c, env, args, 1), messages.indexOfInStrWhat())
        return
    }
    if isVector(subject) {
        fitsArg(c, env, types.elementOf(subject), args, 1, messages.indexOfWhat())
        return
    }
    if isUnknown(subject) {
        report(c, messages.indexOfUnknown())
        return
    }
    report(c, messages.indexOfWrongType(types.show(subject)))
}

// A literal width below one could only hand back an empty `Table` — dead code
// wearing the shape of the form that works. A computed width is total instead.
proc checkRowWidth(c: mut Check, args: ast.Arg[]): void {
    if literalInt(ast.argFor(args, "", 1)) is Result.Ok(n) {
        if n < 1 {
            report(c, messages.toTableWidthBelowOne(n))
        }
    }
}

func literalInt(e: ast.Expr): Result<Int, Bool> {
    if e is ast.Expr.IntLit(n, _) {
        return Result.Ok(n)
    }
    if e is ast.Expr.Negate(operand, _) {
        if operand is ast.Expr.IntLit(n, _) {
            return Result.Ok(0 - n)
        }
    }
    return Result.Error(false)
}

// How many a builtin takes. Answers whether the call had that many, so what
// follows can read the arguments knowing they are there.
proc arity(c: mut Check, name: Str, args: ast.Arg[], wanted: Int): Bool {
    if len(args) == wanted {
        return true
    }
    report(c, messages.callArgCount(name, countOf(wanted), countOf(len(args))))
    return false
}

// One argument's type, or `TUnknown` where a hole stands instead — a partial
// application says nothing about what will fill it.
proc typeOfArg(c: mut Check, env: infer.Env, args: ast.Arg[], index: Int): types.Ty {
    given := ast.argFor(args, "", index)
    if given is ast.Expr.Hole {
        return types.Ty.TUnknown()
    }
    return infer.typeOf(env, given)
}

func isVector(ty: types.Ty): Bool {
    return ty is types.Ty.TVec(_, _)
}

func isUnknown(ty: types.Ty): Bool {
    return ty is types.Ty.TUnknown
}

func strings(): types.Ty {
    return types.Ty.TVec(types.Ty.TStr(), ast.Dim.Any())
}

// `Table` is rows of cells: a vector of vectors of `Str`, any length either way.
func table(): types.Ty {
    return types.Ty.TVec(strings(), ast.Dim.Any())
}

// `map`, `filter` and `filterMap` each walk a vector with a function over its
// elements, and each is specific about what that function answers with.
proc checkWalk(c: mut Check, env: infer.Env, name: Str, args: ast.Arg[]): void {
    if len(args) != 2 {
        report(c, messages.walkArgCount(name, countOf(len(args))))
        return
    }
    ty := infer.typeOf(env, ast.argFor(args, "", 1))
    if ty is types.Ty.TUnknown {
        return
    }
    if ty is types.Ty.TFn(_, params, mutables, result) {
        if len(params) != 1 {
            report(c, messages.walkFunctionArity(name, countOf(len(params))))
            return
        }
        if mutables bounds 0 && mutables[0] {
            report(c, messages.walkTakesMutElement(name))
            return
        }
        element := types.elementOf(infer.typeOf(env, ast.argFor(args, "", 0)))
        fits(c, typeAt(params, 0), element, messages.walkElementWhat(name))
        checkWalkResult(c, name, result)
        return
    }
    report(c, messages.walkSecondArgumentNotFunction(name, types.show(ty)))
}

proc checkWalkResult(c: mut Check, name: Str, result: types.Ty): void {
    if name == "filter" {
        if result is types.Ty.TBool {
            return
        }
        report(c, messages.filterNeedsBool(types.show(result)))
        return
    }
    if name == "filterMap" {
        if result is types.Ty.TResult(_, _) {
            return
        }
        report(c, messages.filterMapNeedsResult(types.show(result)))
        return
    }
    // `map` wants *something*: a `void` function collects nothing, and that too
    // is a `for each` loop.
    if result is types.Ty.TVoid {
        report(c, messages.mapCollectsVoid())
    }
}

func typeAt(list: types.Ty[], index: Int): types.Ty {
    if list bounds index {
        return list[index]
    }
    return types.Ty.TUnknown()
}

// `append`, `prepend` and `drop` all write *through* a vector and all ask for a
// mutable dynamic one. Dynamic has to be declared: a `:=` binding reads its
// length off the value, and that is a static length it cannot grow out of.
proc checkGrows(c: mut Check, env: infer.Env, name: Str, args: ast.Arg[], wanted: Int): void {
    // `drop` answers with what it took off; the other two answer with nothing.
    if c.bare == false && name != "drop" {
        append(c.pending, diag.on(c.at, diag.inDecl(c.inside, messages.growHandsNothing(name))))
    }
    if len(args) != wanted {
        report(c, messages.callArgCount(name, countOf(wanted), countOf(len(args))))
        return
    }
    target := ast.argFor(args, "", 0)
    root := rootName(target)
    if root == "" || isMutable(c.mutable, root) == false {
        report(c, messages.growTargetNotMut(name))
        return
    }
    ty := infer.typeOf(env, target)
    if ty is types.Ty.TVec(_, dim) {
        if dim is ast.Dim.Fixed(size) {
            report(c, messages.growFixedLength(name, root, size))
        }
        return
    }
    if ty is types.Ty.TUnknown {
        return
    }
    report(c, messages.growNotVector(name, root, types.show(ty)))
}

// A discarded `sort` on a `mut` vector reorders it where it lies. One that
// cannot is a compile error rather than a statement that quietly does nothing.
proc checkStatementExpr(c: mut Check, env: infer.Env, value: ast.Expr): void {
    checkExpr(c, env, value)
    // A call may stand alone for what it does; anything else only computes a
    // value, and one nothing keeps is a line that does nothing.
    if (value is ast.Expr.Call(_, _, _) || value is ast.Expr.AwaitAll(_, _, _) || value is ast.Expr.Timed(_, _, _)) == false {
        if value is ast.Expr.Negate(_, _) {
            report(c, messages.minusOpensStatement())
            return
        }
        report(c, messages.valueStatement())
        return
    }
    if value is ast.Expr.Call(callee, args, _) {
        mut name := ""
        switch callee {
            ast.Expr.Ident(bare, _) {
                name = bare
            }
            ast.Expr.Member(head, member, _) {
                if head is ast.Expr.Ident(hiveName, _) {
                    if hiveName == "hive" {
                        name = member
                    }
                }
            }
            _ { }
        }
        if name == "sort" && infer.isBound(env, name) == false && len(args) >= 1 {
            target := ast.argFor(infer.builtinArgs("sort", args), "", 0)
            root := rootName(target)
            if root == "" {
                report(c, messages.sortStatementNothingInPlace())
            } else if isMutable(c.mutable, root) == false {
                report(c, messages.sortStatementNotMut(root))
            }
        }
    }
}

// --- `with compiler` ---------------------------------------------------------

// The call runs while the program builds, so which function it is and everything
// it is handed are known by then, and what it answers can be built in.
proc checkBaked(c: mut Check, env: infer.Env, call: ast.Expr): void {
    if call is ast.Expr.Call(callee, args, _) {
        root := rootName(callee)
        if root != "" && hive.map.has(env.names, root) {
            report(c, messages.bakedCalleeVariable(root))
        }
        for each a in args {
            found := bake.unsettled(a.value, c.baked)
            if found == "*" {
                reportAt(c, a.value.at, messages.bakedArgNotKnown())
            } else if found != "" {
                reportAt(c, a.value.at, messages.bakedNameNotKnown(found))
            }
        }
    }
    answer := infer.typeOf(env, call)
    if answer is types.Ty.TVoid {
        report(c, messages.bakedVoid())
        return
    }
    held := bake.notData(env.table, answer)
    if held != "" {
        report(c, messages.bakedNotData(types.show(answer), held))
    }
}

// --- `async` -----------------------------------------------------------------

// Every entry starts on a thread of its own, so each is held to what `async` is;
// and the barrier resolves to one vector, so they answer with one type.
proc checkAwaitAll(c: mut Check, env: infer.Env, calls: ast.Expr[], timeout: ast.Expr): void {
    mut types.Ty first = types.Ty.TUnknown()
    for each call in calls {
        if (call is ast.Expr.Call(_, _, _)) == false {
            checkExpr(c, env, call)
            report(c, messages.awaitAllEntryNotCall())
            continue
        }
        checkAsync(c, env, call)
        ty := infer.typeOf(env, call)
        if first is types.Ty.TUnknown {
            first = ty
        } else if (ty is types.Ty.TUnknown) == false && types.same(first, ty) == false {
            report(c, messages.awaitAllMixedTypes(types.show(first), types.show(ty)))
        }
    }
    if timeout is ast.Expr.Absent {
        return
    }
    checkExpr(c, env, timeout)
    fits(c, types.Ty.TInt(), infer.typeOf(env, timeout), messages.timeoutMillisWhat())
    if first is types.Ty.TVoid {
        report(c, messages.awaitAllTimeoutVoid())
    }
}

// `async` works on any call, and what it refuses it refuses by name.
proc checkAsync(c: mut Check, env: infer.Env, call: ast.Expr): void {
    checkExpr(c, env, call)
    if call is ast.Expr.Call(callee, args, _) {
        for each a in args {
            if a.value is ast.Expr.Hole {
                report(c, messages.asyncPartial())
                return
            }
        }
        if callee is ast.Expr.Ident(name, _) {
            // A declaration of your own named after a builtin is an ordinary
            // callable, so it is fired off like any other.
            target := infer.callTarget(env, name)
            if target is infer.CallTarget.Builtin {
                report(c, messages.asyncBuiltin(name))
                return
            }
            switch target {
                infer.CallTarget.Struct(_) {
                    report(c, messages.asyncConstructor(name))
                }
                infer.CallTarget.Union {
                    report(c, messages.asyncConstructor(name))
                }
                _ { }
            }
        }
        if callee is ast.Expr.Member(head, variant, _) {
            if head is ast.Expr.Ident(typeName, _) {
                if typeName == "Result" || types.findType(env.table, typeName) is Result.Ok(_) {
                    report(c, messages.asyncConstructor("{typeName}.{variant}"))
                }
            }
        }
    }
}

// --- Patterns ----------------------------------------------------------------

proc checkPattern(c: mut Check, env: infer.Env, subject: ast.Expr, p: ast.Pattern): void {
    subjectType := infer.typeOf(env, subject)
    switch p {
        ast.Pattern.Constructor(path, bindings, parenthesised) {
            checkConstructorPattern(c, env, subjectType, path, bindings, parenthesised)
        }
        ast.Pattern.VectorPat(_, _) {
            if subjectType is types.Ty.TVec(_, _) || subjectType is types.Ty.TUnknown {
                return
            }
            report(c, messages.vectorPatternWrongSubject(types.show(subjectType)))
        }
        ast.Pattern.StrTemplate(_) {
            if subjectType is types.Ty.TStr || subjectType is types.Ty.TUnknown {
                return
            }
            report(c, messages.strPatternWrongSubject(types.show(subjectType)))
        }
        ast.Pattern.BitsPat(fields, rest) {
            checkBitsPattern(c, env, subjectType, fields, rest)
        }
    }
}

// Every field's width is known here but a run's, which is whole bytes — so where
// each one starts within a byte is too.
proc checkBitsPattern(c: mut Check, env: infer.Env, subject: types.Ty, fields: ast.BitField[], rest: Str): void {
    whole := widthOf(subject)
    if subject is types.Ty.TUnknown {
        return
    }
    if (subject is types.Ty.TStr || isByteVector(subject) || whole > 0) == false {
        report(c, messages.bitsPatternWrongSubject(types.show(subject)))
        return
    }
    if whole > 0 && rest != "" {
        report(c, messages.bitsPatternNoRest(types.show(subject)))
        return
    }
    mut scope := env
    mut offset := 0
    for each f in fields {
        width := fieldWidth(c, scope, subject, f)
        if width < 0 {
            return
        }
        if refusesAlignment(c, fieldText(f), offset, width, f.little) {
            return
        }
        offset = offset + width
        if f.name != "" {
            scope = infer.bound(scope, f.name, infer.bitFieldType(env.table, f))
        }
    }
    if whole > 0 {
        if offset != whole {
            report(c, messages.bitsPatternWidthMismatch(offset, types.show(subject), whole))
        }
        return
    }
    if offset % 8 == 0 {
        return
    }
    if rest != "" {
        report(c, messages.bitsRestOffByte(rest, offset % 8, 8 - offset % 8))
        return
    }
    report(c, messages.bitsPatternNotWholeBytes(offset, 8 - offset % 8))
}

// A field's width in bits: 0 for a run of bytes, -1 once it has been refused.
proc fieldWidth(c: mut Check, env: infer.Env, subject: types.Ty, f: ast.BitField): Int {
    shown := fieldText(f)
    if (f.length is ast.Expr.Absent) == false {
        if (f.value is ast.Expr.Absent) == false {
            report(c, messages.bitsRunIsLiteral(shown))
            return -1
        }
        if widthOf(subject) > 0 {
            report(c, messages.bitsRunFromInteger(shown))
            return -1
        }
        element := types.resolve(env.table, f.declared)
        if types.same(element, types.Ty.TSized(false, 8)) == false {
            report(c, messages.bitsRunNotBytes(shown, types.show(element)))
            return -1
        }
        checkExpr(c, env, f.length)
        counted := infer.typeOf(env, f.length)
        if (types.isInteger(counted) || counted is types.Ty.TUnknown) == false {
            report(c, messages.bitsRunLengthNotInteger(shown, types.show(counted)))
            return -1
        }
        return 0
    }
    if f.value is ast.Expr.StrLit(_, _) {
        if widthOf(subject) > 0 {
            report(c, messages.bitsStrFromInteger(shown))
            return -1
        }
        if (f.declared is ast.TypeExpr.VoidType) == false {
            report(c, messages.bitsStrHasType(shown))
            return -1
        }
        return 0
    }
    mut ty := types.Ty.TSized(false, 8)
    if (f.declared is ast.TypeExpr.VoidType) == false {
        ty = types.resolve(env.table, f.declared)
    }
    width := widthOf(ty)
    if width == 0 {
        report(c, messages.bitsFieldNotInteger(shown, types.show(ty)))
        return -1
    }
    if f.value is ast.Expr.Absent {
        return width
    }
    if infer.intLiteral(f.value) is Result.Ok(n) {
        if types.holdsLiteral(ty, n) == false {
            report(c, messages.bitsFieldLiteralDoesNotFit(n, types.show(ty)))
            return -1
        }
        return width
    }
    report(c, messages.bitsFieldNotLiteral(shown))
    return -1
}

func fieldText(f: ast.BitField): Str {
    if f.name != "" {
        return f.name
    }
    if infer.intLiteral(f.value) is Result.Ok(n) {
        return "{n}"
    }
    if f.value is ast.Expr.StrLit(t, _) {
        return "\"{t}\""
    }
    return "…"
}

proc checkConstructorPattern(c: mut Check, env: infer.Env, subjectType: types.Ty, path: Str[], bindings: Str[], parenthesised: Bool): void {
    head := segment(path, 0)
    variant := segment(path, 1)
    if head == "Result" {
        if variant != "Ok" && variant != "Error" {
            report(c, messages.resultNoSuchVariant(variant))
        } else if parenthesised && len(bindings) != 1 {
            report(c, messages.resultPatternPayloadCount(variant, countOf(len(bindings))))
        } else {
            checkPatternType(c, subjectType, head, variant)
        }
        return
    }
    if types.findType(env.table, head) is Result.Error(_) {
        report(c, messages.patternTypeNotDeclared(head))
        return
    }
    if types.findVariant(env.table, head, variant) is Result.Ok(fields) {
        // Name every field or none, so a pattern never quietly skips one.
        if parenthesised && len(bindings) != len(fields) {
            report(c, messages.patternFieldCount(types.shownName(head), variant, fieldCount(len(fields)), countOf(len(bindings))))
        } else {
            checkPatternType(c, subjectType, head, variant)
        }
        return
    }
    report(c, messages.noSuchVariant(types.shownName(head), variant))
}

proc checkPatternType(c: mut Check, subjectType: types.Ty, head: Str, variant: Str): void {
    if subjectType is types.Ty.TUnknown || subjectType is types.Ty.TVar(_) {
        return
    }
    if head == "Result" && subjectType is types.Ty.TResult(_, _) {
        return
    }
    if subjectType is types.Ty.TNamed(name) && name == head {
        return
    }
    shown := types.shownName(head)
    report(c, messages.patternWrongSubject(shown, variant, types.show(subjectType)))
}

func segment(path: Str[], index: Int): Str {
    if path bounds index {
        return path[index]
    }
    return ""
}

// --- Terminating paths -------------------------------------------------------

// A path terminates by ending in `return`, `panic` or `hive.term.exit`, in an
// `if`/`else` or a `switch` whose every branch terminates, or in an else-less `if`/`else if`
// chain that covers its subject's whole type. Not in an `assert`: one that holds
// carries on past it, with nothing to answer.
func terminates(t: types.Table, b: ast.Block): Bool {
    last := len(b.stmts) - 1
    if b.stmts bounds last {
        return terminatesWith(t, b.stmts[last])
    }
    return false
}

func terminatesWith(t: types.Table, s: ast.Stmt): Bool {
    if s is ast.Stmt.ReturnStmt(_, _) { return true }
    if s is ast.Stmt.PanicStmt(_, _) { return true }
    if s is ast.Stmt.Expression(value, _) { return exitsTheProgram(value) }
    if s is ast.Stmt.IfChain(branches, otherwise, hasElse, _) {
        for each branch in branches {
            if terminates(t, branch.body) == false {
                return false
            }
        }
        if hasElse {
            return terminates(t, otherwise)
        }
        return cover.covers(t, branches)
    }
    // A `switch` that falls short of its subjects is an error of its own.
    if s is ast.Stmt.SwitchStmt(_, _, arms, _, _) {
        for each arm in arms {
            if terminates(t, arm.body) == false {
                return false
            }
        }
        return true
    }
    return false
}

// How an arm of a binding's `else` ends: anywhere a path terminates, or by `break` or `continue`.
func leaves(t: types.Table, b: ast.Block): Bool {
    last := len(b.stmts) - 1
    if b.stmts bounds last {
        return leavesWith(t, b.stmts[last])
    }
    return false
}

func leavesWith(t: types.Table, s: ast.Stmt): Bool {
    if s is ast.Stmt.BreakStmt { return true }
    if s is ast.Stmt.ContinueStmt { return true }
    if s is ast.Stmt.IfChain(branches, otherwise, hasElse, _) {
        for each branch in branches {
            if leaves(t, branch.body) == false {
                return false
            }
        }
        if hasElse {
            return leaves(t, otherwise)
        }
        return cover.covers(t, branches)
    }
    if s is ast.Stmt.SwitchStmt(_, _, arms, _, _) {
        for each arm in arms {
            if leaves(t, arm.body) == false {
                return false
            }
        }
        return true
    }
    return terminatesWith(t, s)
}

// A value the else-less chain ending `b` lets through, where that is why `b` does
// not terminate.
func missedAtEnd(t: types.Table, b: ast.Block): Str {
    last := len(b.stmts) - 1
    if b.stmts bounds last {
        if b.stmts[last] is ast.Stmt.IfChain(branches, otherwise, hasElse, _) {
            for each branch in branches {
                if terminates(t, branch.body) == false {
                    return missedAtEnd(t, branch.body)
                }
            }
            if hasElse {
                return missedAtEnd(t, otherwise)
            }
            return cover.missed(t, branches)
        }
        if b.stmts[last] is ast.Stmt.SwitchStmt(_, _, arms, _, _) {
            for each arm in arms {
                if terminates(t, arm.body) == false {
                    return missedAtEnd(t, arm.body)
                }
            }
        }
    }
    return ""
}

func exitsTheProgram(value: ast.Expr): Bool {
    if value is ast.Expr.Call(callee, _, _) {
        if callee is ast.Expr.Member(subject, name, _) && name == "exit" {
            if subject is ast.Expr.Member(root, module, _) && module == "term" {
                if root is ast.Expr.Ident(head, _) {
                    return head == "hive"
                }
            }
        }
    }
    return false
}

// --- Small questions ---------------------------------------------------------

// `at(...)` or `hive.at(...)`: the builtin, where what it answers with is an
// address of no message type yet.
func isAtCall(value: ast.Expr): Bool {
    if value is ast.Expr.Call(callee, _, _) {
        if callee is ast.Expr.Ident(name, _) {
            return name == "at"
        }
        if callee is ast.Expr.Member(root, name, _) {
            if root is ast.Expr.Ident(hiveName, _) {
                return hiveName == "hive" && name == "at"
            }
        }
    }
    return false
}
// `fits` for a value written where it lands: a literal takes the number type of
// the spot, so `UInt4 x = 9` holds and `UInt4 x = 16` says why it does not.
// Reported where the value is, which in a call over several lines is not where the call is.
proc fitsValue(c: mut Check, env: infer.Env, wanted: types.Ty, e: ast.Expr, where: Str): void {
    outer := c.at
    if e.at.line > 0 {
        c.at = e.at
    }
    if literalMisses(c, wanted, e, where) == false {
        fits(c, wanted, infer.landedType(env, e, wanted), where)
    }
    land(c, wanted, e)
    c.at = outer
}

proc fitsArg(c: mut Check, env: infer.Env, wanted: types.Ty, args: ast.Arg[], index: Int, where: Str): void {
    given := ast.argFor(args, "", index)
    if given is ast.Expr.Hole {
        return
    }
    fitsValue(c, env, wanted, given, where)
}

proc literalMisses(c: mut Check, wanted: types.Ty, e: ast.Expr, where: Str): Bool {
    if infer.intLiteral(e) is Result.Ok(n) && wanted is types.Ty.TSized(_, _) && types.holdsLiteral(wanted, n) == false {
        report(c, messages.literalOutOfRange(where, types.show(wanted), rangeOf(wanted), n))
        return true
    }
    if infer.isFloatLiteral(e) && wanted is types.Ty.TFloat32 && holdsFloat32(e) == false {
        report(c, messages.float32OutOfRange(where))
        return true
    }
    if e is ast.Expr.VectorLit(items, _) && wanted is types.Ty.TVec(element, _) {
        mut missed := false
        for each item in items {
            if literalMisses(c, element, item, where) {
                missed = true
            }
        }
        return missed
    }
    return false
}

func holdsFloat32(e: ast.Expr): Bool {
    mut v := 0.0
    if e is ast.Expr.FloatLit(f, _) {
        v = f
    } else if e is ast.Expr.Negate(operand, _) && operand is ast.Expr.FloatLit(f, _) {
        v = f
    }
    return v <= 340282346638528859811704183484516925440.0
}

// What an integer type holds, written out for a message.
func rangeOf(ty: types.Ty): Str {
    if ty is types.Ty.TSized(true, bits) {
        top := types.twoTo(bits - 1)
        return messages.rangeBetween(0 - top, top - 1)
    }
    if ty is types.Ty.TSized(false, bits) {
        if bits == 64 {
            return messages.uint64Range()
        }
        if bits == 63 {
            return messages.uint63Range()
        }
        return messages.rangeBetween(0, types.twoTo(bits) - 1)
    }
    return messages.everyInt()
}

proc fits(c: mut Check, wanted: types.Ty, given: types.Ty, where: Str): void {
    if types.accepts(wanted, given) {
        return
    }
    mut why := ""
    if wanted is types.Ty.TFn(_, _, _, _) && given is types.Ty.TFn(_, _, _, _) {
        why = messages.functionSlotWhy()
    }
    report(c, messages.typeMismatch(where, types.show(wanted), types.show(given), why))
}
