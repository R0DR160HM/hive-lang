// Indentation
// ===========
// `hive indent`: every line's indentation in spaces, a tab moving to the next
// multiple of four. Only what says where a line sits is rewritten, never what a
// literal holds — a `"..."` string spanning lines keeps every character, and a
// backtick string or a query body loses only the indentation the lexer strips from
// it anyway, so the program reads the same text before and after.
import ./diag
import ./lexer
import ./project
import ./text
import hive.file

// What one run did.
type Indented {
    changed: Str[dyn]
    looked: Int
    problems: diag.Diagnostic[dyn]
}

// Every Hive file a path names: the file itself, or each one under a directory
// that git does not ignore.
proc filesAt(path: Str): Result<Str[dyn], Str> {
    if hive.file.list(path) is Result.Ok(_) {
        return Result.Ok(project.hiveFilesUnder(path))
    }
    if text.endsWith(path, ".hive") && hive.file.exists(path) {
        return Result.Ok([path])
    }
    return Result.Error("`hive indent` takes a directory or a `.hive` file, and `{path}` is neither")
}

proc indentAll(files: Str[]): Indented {
    mut Str[dyn] changed = []
    mut diag.Diagnostic[dyn] problems = []
    for each file in files {
        read := hive.file.read(file)
        if read is Result.Error(why) {
            append(problems, diag.about(file, "left as it was: {why.message}"))
        } else if read is Result.Ok(source) {
            done := indentSource(source)
            if done is Result.Error(why) {
                append(problems, diag.about(file, "left as it was: {why}"))
            } else if done is Result.Ok(result) && result != source {
                if hive.file.write(file, result) is Result.Error(why) {
                    append(problems, diag.about(file, "cannot write it: {why.message}"))
                } else {
                    append(changed, file)
                }
            }
        }
    }
    return Indented(changed, len(files), problems)
}

proc indentSource(source: Str): Result<Str, Str> {
    if text.contains(text.replace(source, "\r\n", ""), "\r") {
        return Result.Error("a lone carriage return breaks a line in it, so its lines are not the ones the compiler reads")
    }
    lexed := lexer.lex(source)
    if lexed.errors bounds 0 {
        first := lexed.errors[0]
        return Result.Error("it does not lex, so its strings cannot be told from its code — line {first.line}: {first.message}")
    }
    return Result.Ok(reindented(source, lexed.literals))
}

// One literal's indentation, as `text.dedent` reads it: the blanks it strips from
// each line between `low` and `high`, and whether those are spelled alike on every
// line, so that spelling them in spaces strips just as much.
type Shape {
    lines: Str[dyn]
    low: Int
    high: Int
    shared: Int
    same: Bool
}

func reindented(source: Str, literals: lexer.Literal[]): Str {
    cs := text.chars(lexer.normalised(source))
    mut Str[dyn] out = []
    mut start := 0
    mut at := 0
    mut shapeOf := -1
    mut Shape shape = Shape([], 0, -1, 0, false)
    mut row := 0
    for each written in split(source, "\n") {
        mut line := written
        mut ending := ""
        if text.endsWith(written, "\r") {
            ending = "\r"
            line = text.span(text.chars(written), 0, len(text.chars(written)) - 2)
        }
        for ; literals bounds at && literals[at].closes < start; at++ {
        }
        mut inside := false
        mut lit := lexer.Literal(0, 0, false)
        if literals bounds at {
            lit = literals[at]
            inside = lit.opens < start
        }
        if inside == false {
            append(out, spaced(line) + ending)
        } else if lit.dedented == false {
            append(out, written)
        } else {
            if shapeOf != at {
                shapeOf = at
                shape = shapeIn(text.span(cs, lit.opens, lit.closes - 1))
                row = 0
            }
            row++
            append(out, inDedented(line, shape, row) + ending)
        }
        start = start + len(text.chars(line)) + 1
    }
    return join(out, "\n")
}

func shapeIn(raw: Str): Shape {
    lines := split(raw, "\n")
    mut low := 0
    for ; lines bounds low && text.trim(lines[low]) == ""; low++ {
    }
    mut high := len(lines) - 1
    for ; high >= low && lines bounds high && text.trim(lines[high]) == ""; high-- {
    }
    mut shared := -1
    mut prefix := ""
    mut same := true
    for i := low; i <= high; i++ {
        if lines bounds i && text.trim(lines[i]) != "" {
            blanks := text.leadingBlanks(lines[i])
            if shared < 0 || blanks < shared {
                shared = blanks
            }
        }
    }
    for i := low; i <= high; i++ {
        if lines bounds i && text.trim(lines[i]) != "" && shared > 0 {
            opening := text.span(text.chars(lines[i]), 0, shared - 1)
            if prefix == "" {
                prefix = opening
            } else if opening != prefix {
                same = false
            }
        }
    }
    // The text after the opening delimiter is not a line's start, so it is not respelled.
    if lines bounds 0 && text.trim(lines[0]) != "" {
        same = false
    }
    return Shape(lines, low, high, shared, same)
}

// Line `row` of a backtick string or a query body. A blank line is never part of
// the text where the lexer drops or empties it; a line with text keeps everything
// past the blanks the lexer strips.
func inDedented(line: Str, shape: Shape, row: Int): Str {
    mut segment := ""
    if shape.lines bounds row {
        segment = shape.lines[row]
    }
    if text.trim(segment) == "" {
        if row < shape.low || row > shape.high || shape.shared > 0 {
            return spaced(line)
        }
        return line
    }
    if shape.same == false || shape.shared <= 0 {
        return line
    }
    cs := text.chars(line)
    return text.repeat(" ", columns(cs, shape.shared)) + text.span(cs, shape.shared, len(cs) - 1)
}

// A line with its leading blanks in spaces.
func spaced(line: Str): Str {
    cs := text.chars(line)
    blanks := text.leadingBlanks(line)
    if blanks == 0 {
        return line
    }
    return text.repeat(" ", columns(cs, blanks)) + text.span(cs, blanks, len(cs) - 1)
}

// How wide the first `count` blanks are: a space is one column, and a tab moves to
// the next multiple of four.
func columns(cs: Str[], count: Int): Int {
    mut column := 0
    for i := 0; i < count; i++ {
        if text.charAt(cs, i) == "\t" {
            column = (column / 4 + 1) * 4
        } else {
            column++
        }
    }
    return column
}
