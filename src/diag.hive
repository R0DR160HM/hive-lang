// Diagnostics
// ===========
// One error, and where it happened. Every message opens with `file:line:`, the
// shape an editor's error format expects.
//
// A diagnostic is a value, not a thing that stops the compiler: a pass collects
// as many as it can find and hands them all back.
//
// The passes after the parser run on a flattened program whose nodes carry no
// position, so they report against the entrypoint's first line and name the
// declaration instead.

type Diagnostic {
	file: Str
	line: Int
	message: Str
}

// The lexer and parser are handed source text rather than a path, so the file
// goes on afterwards, at the one place holding both.
func at(line: Int, message: Str): Diagnostic {
	return Diagnostic("", onSomeLine(line), message)
}

// Every diagnostic points at a line: `file:0:` is not a position an editor can
// jump to.
func onSomeLine(line: Int): Int {
	if line < 1 {
		return 1
	}
	return line
}

// About a whole file rather than a line in it — unreadable, unwritable, or
// refused by the toolchain. The top of the file is the only position it has.
func about(file: Str, message: Str): Diagnostic {
	return Diagnostic(file, 1, message)
}

// The file a diagnostic came from, put on where it is not already known.
func inFile(file: Str, d: Diagnostic): Diagnostic {
	if d.file != "" {
		return d
	}
	return Diagnostic(file, d.line, d.message)
}

func allInFile(file: Str, ds: Diagnostic[]): Diagnostic[dyn] {
	mut Diagnostic[dyn] out = []
	for each d in ds {
		append(out, inFile(file, d))
	}
	return out
}

// `file:line: message`. With no file yet, the line alone — what a unit test
// over the lexer sees.
func render(d: Diagnostic): Str {
	if d.file == "" {
		return "{d.line}: {d.message}"
	}
	return "{d.file}:{d.line}: {d.message}"
}

func renderAll(ds: Diagnostic[]): Str {
	mut Str[dyn] lines = []
	for each d in ds {
		append(lines, render(d))
	}
	return join(lines, "\n")
}

// Naming the declaration is the whole of what a flattened-program message has,
// so this is the one place that shape is written down.
func inDecl(declaration: Str, message: Str): Str {
	return "in `{declaration}`: {message}"
}
