// Diagnostics
// ===========
// One error, and where it happened. Every message the compiler prints opens
// with `file:line:`, which is the shape an editor's error format expects — so
// wiring one up needs nothing more than a compile command and a pattern.
//
// A diagnostic is a value, not a thing that stops the compiler. A pass collects
// as many as it can find and hands them all back, because being told about one
// mistake per run is a miserable way to fix six.

type Diagnostic {
	file: Str
	line: Int
	message: Str
}

// A diagnostic that knows its line but not yet its file. The lexer and parser
// are handed source text rather than a path, so the file goes on afterwards, at
// the one place holding both.
func at(line: Int, message: Str): Diagnostic {
	return Diagnostic("", onSomeLine(line), message)
}

// Every diagnostic points at a line, because `file:0:` is not a position an
// editor can jump to. The passes that run on the flattened program do not
// always have one — nothing there carries a position but a declaration — and
// the file's first line is what those are reported against.
func onSomeLine(line: Int): Int {
	if line < 1 {
		return 1
	}
	return line
}

// A diagnostic about a whole file rather than about a line in it: one that
// could not be read, one that could not be written, a toolchain that refused
// what came out. It opens the file at the top, which is the only position such
// a message has.
func about(file: Str, message: Str): Diagnostic {
	return Diagnostic(file, 1, message)
}

// The file a diagnostic came from, put on where it is not already known. A pass
// that runs per file knows it; the ones that run on the flattened program do
// not, and the entrypoint is what those are reported against.
func inFile(file: Str, d: Diagnostic): Diagnostic {
	if d.file != "" {
		return d
	}
	return Diagnostic(file, d.line, d.message)
}

func allInFile(file: Str, ds: Diagnostic[]): Diagnostic[dyn] {
	mut Diagnostic[dyn] out = []
	for each d in ds {
		append(out, inFile(file, d))
	}
	return out
}

// `file:line: message`. A diagnostic with no file yet prints its line alone,
// which is what a unit test over the lexer sees.
func render(d: Diagnostic): Str {
	if d.file == "" {
		return "{d.line}: {d.message}"
	}
	return "{d.file}:{d.line}: {d.message}"
}

func renderAll(ds: Diagnostic[]): Str {
	mut Str[dyn] lines = []
	for each d in ds {
		append(lines, render(d))
	}
	return join(lines, "\n")
}

// The passes after the parser run on a flattened program whose nodes carry no
// position, so they report against the entrypoint and name the declaration
// instead. Saying which declaration is the whole of what those messages have,
// so this is the one place that shape is written down.
func inDecl(declaration: Str, message: Str): Str {
	return "in `{declaration}`: {message}"
}
