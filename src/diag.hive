// Diagnostics
// ===========
// One error, and where it happened. Every message opens with `file:line:`, the
// shape an editor's error format expects.
//
// A diagnostic is a value, not a thing that stops the compiler: a pass collects
// as many as it can find and hands them all back.
import ./token

type Diagnostic {
    file: Str
    line: Int
    message: Str
    // 0 where only the line is known. Not printed: an error format is promised `file:line:`.
    col: Int
}

// For a pass handed source text rather than a path: the file goes on afterwards.
func at(line: Int, message: Str): Diagnostic {
    return Diagnostic("", onSomeLine(line), message, 0)
}

func on(where: token.Pos, message: Str): Diagnostic {
    return Diagnostic(where.file, onSomeLine(where.line), message, where.col)
}

// `file:0:` is not a position an editor can jump to.
func onSomeLine(line: Int): Int {
    if line < 1 {
        return 1
    }
    return line
}

// About a whole file rather than a line in it — unreadable, unwritable, or
// refused by the toolchain.
func about(file: Str, message: Str): Diagnostic {
    return Diagnostic(file, 1, message, 0)
}

func inFile(file: Str, d: Diagnostic): Diagnostic {
    if d.file != "" {
        return d
    }
    return Diagnostic(file, d.line, d.message, d.col)
}

// With no file yet, the line alone — what a unit test over the lexer sees.
func render(d: Diagnostic): Str {
    if d.file == "" {
        return "{d.line}: {d.message}"
    }
    return "{d.file}:{d.line}: {d.message}"
}

func inDecl(declaration: Str, message: Str): Str {
    return "in `{declaration}`: {message}"
}
