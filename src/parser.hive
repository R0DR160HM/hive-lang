// Parser
// ======
// A recursive-descent parser turning a token list into an `ast.Module`.
//
// It is also where a name's spelling is held to the rules in `naming`. This is
// the pass that knows what a name *is* — the same identifier token is a type in
// one position and a field in the next — and the last one holding the line to
// report it against.
//
// **Errors do not stop it.** A failure sets a flag, every loop checks it and
// stops, and the declaration loop at the top clears it and skips to the next
// `proc`, `func`, `type`, `query` or `test`. One error per declaration is
// reported, which is as many as are worth trusting — everything after a mistake
// inside one is guesswork.
//
// The cursor is a `mut Parse` and the tokens are an immutable parameter beside
// it, as in the lexer: reading a token costs nothing, and only the cursor moves.
import ./ast
import ./diag
import ./lexer
import ./naming
import ./regex
import ./text
import ./token

/// A parsed file: what it produced, and what it could not.
type Parsed {
	module: ast.Module
	errors: diag.Diagnostic[dyn]
}

/// Where the parse is, and what it has found wrong.
type Parse {
	pos: Int
	/// Set by the first failure inside a declaration and cleared when the
	/// declaration loop moves on. Every loop checks it, which keeps a broken
	/// declaration from being read as ten more.
	failed: Bool
	/// While a speculative parse is running. The parser looks ahead in exactly
	/// one place — telling `Type name = value` from an expression — and a guess
	/// that did not work out is nobody's mistake.
	quiet: Bool
	errors: diag.Diagnostic[dyn]
}

/// Parse a whole file.
proc parse(ts: token.Token[]): Parsed {
	mut Parse p = Parse(0, false, false, [])
	mut ast.ImportLine[dyn] imports = []
	mut ast.Decl[dyn] decls = []

	for ; atEnd(ts, p) == false; {
		before := p.pos
		if kindAt(ts, p.pos) == token.Kind.KwImport() {
			appendImport(ts, p, imports)
		} else {
			appendDecl(ts, p, decls)
		}
		if p.failed {
			synchronise(ts, p)
		}
		// Nothing below should leave the cursor where it found it; a pass that
		// consumed nothing would loop forever.
		if p.pos == before {
			p.pos = p.pos + 1
		}
	}
	return Parsed(ast.Module(imports, decls, []), p.errors)
}

proc appendImport(ts: token.Token[], p: mut Parse, into: mut ast.ImportLine[dyn]): void {
	line := parseImport(ts, p)
	if p.failed == false {
		append(into, line)
	}
}

proc appendDecl(ts: token.Token[], p: mut Parse, into: mut ast.Decl[dyn]): void {
	d := parseDecl(ts, p)
	if p.failed == false {
		append(into, d)
	}
}

// --- The cursor --------------------------------------------------------------

func kindAt(ts: token.Token[], i: Int): token.Kind {
	if ts bounds i {
		return ts[i].kind
	}
	return token.Kind.Eof()
}

func lineAt(ts: token.Token[], i: Int): Int {
	if ts bounds i {
		return ts[i].line
	}
	last := len(ts) - 1
	if ts bounds last {
		return ts[last].line
	}
	return 1
}

// The identifier a token spells, or `""`. Several words are keywords only where
// they are written — `as`, `run`, `raw`, `csv`, `separating`, `timeout` — and
// this is how those positions ask.
func wordAt(ts: token.Token[], i: Int): Str {
	k := kindAt(ts, i)
	if k is token.Kind.Ident(name) {
		return name
	}
	return ""
}

func atEnd(ts: token.Token[], p: Parse): Bool {
	return kindAt(ts, p.pos) == token.Kind.Eof()
}

proc advance(p: mut Parse): void {
	p.pos = p.pos + 1
}

proc fail(ts: token.Token[], p: mut Parse, message: Str): void {
	if p.quiet == false && p.failed == false {
		append(p.errors, diag.at(lineAt(ts, p.pos), message))
	}
	p.failed = true
}

// `expected X but found Y` — the message nine failures in ten want.
proc expected(ts: token.Token[], p: mut Parse, what: Str): void {
	fail(ts, p, "expected {what} but found " + token.describe(kindAt(ts, p.pos)))
}

proc expect(ts: token.Token[], p: mut Parse, k: token.Kind): Bool {
	if kindAt(ts, p.pos) == k {
		advance(p)
		return true
	}
	expected(ts, p, "`" + token.spelling(k) + "`")
	return false
}

// The identifier at the cursor, consumed. `""` on anything else, with the
// failure already recorded.
proc expectIdent(ts: token.Token[], p: mut Parse, role: naming.Role): Str {
	name := wordAt(ts, p.pos)
	if name == "" {
		expected(ts, p, "an identifier")
		return ""
	}
	advance(p)
	if naming.check(role, name) is Result.Error(why) {
		// The cursor has moved past the name, so report against the name itself
		// rather than whatever follows it.
		if p.quiet == false && p.failed == false {
			append(p.errors, diag.at(lineAt(ts, p.pos - 1), why))
		}
		p.failed = true
	}
	return name
}

// Skip to the next thing that can start a declaration. A mistake inside one
// says nothing about the next, which is what lets one run report on all of them.
proc synchronise(ts: token.Token[], p: mut Parse): void {
	p.failed = false
	for ; atEnd(ts, p) == false; advance(p) {
		if startsDecl(kindAt(ts, p.pos)) {
			return
		}
	}
}

func startsDecl(k: token.Kind): Bool {
	return k == token.Kind.KwProc()
		|| k == token.Kind.KwFunc()
		|| k == token.Kind.KwQuery()
		|| k == token.Kind.KwType()
		|| k == token.Kind.KwTest()
		|| k == token.Kind.KwImport()
}

// --- Imports -----------------------------------------------------------------

proc parseImport(ts: token.Token[], p: mut Parse): ast.ImportLine {
	line := lineAt(ts, p.pos)
	advance(p)
	path := wordOfPath(ts, p)
	if p.failed {
		return ast.ImportLine("", "", line)
	}
	// `as <name>` overrides the name the module is reached through, which is
	// otherwise read off the path.
	if wordAt(ts, p.pos) == "as" {
		advance(p)
		alias := expectIdent(ts, p, naming.Role.Module())
		return ast.ImportLine(path, alias, line)
	}
	if miscased(wordAt(ts, p.pos), "as") {
		fail(ts, p, naming.miscasedKeyword(wordAt(ts, p.pos)) + ".")
		return ast.ImportLine(path, "", line)
	}
	alias := defaultAlias(ts, p, path, line)
	return ast.ImportLine(path, alias, line)
}

proc wordOfPath(ts: token.Token[], p: mut Parse): Str {
	k := kindAt(ts, p.pos)
	if k is token.Kind.PathLit(path) {
		advance(p)
		return path
	}
	expected(ts, p, "a module path after `import`")
	return ""
}

// The name a module is reached through when the import did not say: the last
// segment of the path, with any extension dropped.
proc defaultAlias(ts: token.Token[], p: mut Parse, path: Str, line: Int): Str {
	segments := split(path, "/")
	mut last := text.charAt(segments, len(segments) - 1)
	// A standard library module names no file, so its last segment is separated
	// by a `.` rather than a `/`: `hive.map` is reached as `map`.
	if len(segments) == 1 && text.contains(last, ".") {
		dotted := split(last, ".")
		last = text.charAt(dotted, len(dotted) - 1)
	}
	// A Go file writes its extension and a Hive module never does, so this only
	// has the one to drop.
	if text.endsWith(last, ".go") {
		last = text.span(text.chars(last), 0, len(last) - 4)
	}
	if naming.fits(naming.Role.Module(), last) == false {
		if p.quiet == false && p.failed == false {
			append(p.errors, diag.at(line, "`import {path}` needs a name of its own: `{last}` cannot be used as one — write `import {path} as <name>`"))
		}
		p.failed = true
		return ""
	}
	return last
}

// Whether `word` is `wanted` written in some other casing — a keyword shouted
// rather than a name, even for the positional keywords.
func miscased(word: Str, wanted: Str): Bool {
	return word != "" && word != wanted && text.lower(word) == wanted
}

// --- Declarations ------------------------------------------------------------

proc parseDecl(ts: token.Token[], p: mut Parse): ast.Decl {
	k := kindAt(ts, p.pos)
	if k == token.Kind.KwType() {
		return parseTypeDecl(ts, p)
	} else if k == token.Kind.KwProc() {
		return parseCallable(ts, p, ast.CallableKind.ProcKind())
	} else if k == token.Kind.KwFunc() {
		return parseCallable(ts, p, ast.CallableKind.FuncKind())
	} else if k == token.Kind.KwQuery() {
		return parseQueryDecl(ts, p)
	} else if k == token.Kind.KwTest() {
		return parseTestDecl(ts, p)
	}
	fail(ts, p, "expected a declaration — `type`, `proc`, `func`, `query` or `test` — but found " + token.describe(k))
	return ast.Decl.TestDecl("", ast.Block([]), lineAt(ts, p.pos))
}

// --- Query bodies ------------------------------------------------------------
//
// The lexer captured a query's body whole, most of it being text for a database
// rather than tokens for a compiler. Its own small grammar is read here rather
// than in the lexer because two of the three things in it are ordinary Hive
// expressions — a `\{param}` and an `if`'s condition.
//
// Everything below works over the body's characters and hands each expression it
// finds to the lexer and to `parseExpr`, so an expression inside a query is the
// same expression it would be anywhere else.

// A query body's own failures. It has no tokens to report against — the body
// arrived as one — so it reports against the declaration.
proc sqlFail(p: mut Parse, message: Str): void {
	if p.quiet == false && p.failed == false {
		append(p.errors, diag.at(0, message))
	}
	p.failed = true
}

/// A query body, in the three pieces it is made of.
proc parseSqlBody(body: Str, p: mut Parse): ast.SqlPart[dyn] {
	return parseSqlParts(body, p)
}

proc parseSqlParts(body: Str, p: mut Parse): ast.SqlPart[dyn] {
	cs := text.chars(body)
	mut ast.SqlPart[dyn] parts = []
	mut lit := ""
	mut at := 0
	for ; at < len(cs); {
		c := text.charAt(cs, at)
		if c == "\{" {
			shut := matchingBrace(cs, at)
			if shut < 0 {
				sqlFail(p, "this `\{` in the query body never closes")
				return parts
			}
			inside := text.span(cs, at + 1, shut - 1)
			// A `\{` right after WHERE opens a block of optional predicates;
			// anywhere else it is a value being bound. The WHERE is held back
			// until the block has something to put after it.
			if endsWithWhere(lit) {
				append(parts, ast.SqlPart.Lit(withoutWhere(lit)))
				append(parts, ast.SqlPart.Where(parseSqlGroup(inside, true, p)))
			} else {
				append(parts, ast.SqlPart.Lit(lit))
				append(parts, ast.SqlPart.Param(parseSqlExpr(inside, p)))
			}
			lit = ""
			at = shut + 1
		} else {
			lit = lit + c
			at = at + 1
		}
	}
	if lit != "" {
		append(parts, ast.SqlPart.Lit(lit))
	}
	return parts
}

/// The items of one group: `if`s, and the nested groups that flip the
/// connective.
proc parseSqlGroup(inside: Str, conjunction: Bool, p: mut Parse): ast.SqlGroup {
	cs := text.chars(inside)
	mut ast.SqlItem[dyn] items = []
	mut at := 0
	for ; at < len(cs); {
		at = pastBlanks(cs, at)
		if at >= len(cs) {
			return ast.SqlGroup(conjunction, items)
		}
		word := sqlWord(cs, at)
		if word == "" {
			sqlFail(p, "a WHERE block holds `if`, `or` and `and` blocks, and this is none of them")
			return ast.SqlGroup(conjunction, items)
		}
		at = at + len(word)
		if word == "if" {
			opens := nextBrace(cs, at)
			if opens < 0 {
				sqlFail(p, "this `if` in a WHERE block has no `\{ ... }` after its condition")
				return ast.SqlGroup(conjunction, items)
			}
			condition := parseSqlExpr(text.span(cs, at, opens - 1), p)
			shut := matchingBrace(cs, opens)
			if shut < 0 {
				sqlFail(p, "this `if` in a WHERE block never closes")
				return ast.SqlGroup(conjunction, items)
			}
			append(items, ast.SqlItem.Cond(condition, parseSqlParts(text.span(cs, opens + 1, shut - 1), p)))
			at = shut + 1
		} else if word == "or" || word == "and" {
			opens := nextBrace(cs, at)
			mut shut := -1
			if opens >= 0 {
				shut = matchingBrace(cs, opens)
			}
			if shut < 0 {
				sqlFail(p, "this `{word}` in a WHERE block has no `\{ ... }` after it")
				return ast.SqlGroup(conjunction, items)
			}
			append(items, ast.SqlItem.Nested(parseSqlGroup(text.span(cs, opens + 1, shut - 1), word == "and", p)))
			at = shut + 1
		} else {
			sqlFail(p, "a WHERE block holds `if`, `or` and `and` blocks, and `{word}` is none of them")
			return ast.SqlGroup(conjunction, items)
		}
	}
	return ast.SqlGroup(conjunction, items)
}

/// One expression out of a query body, lexed and parsed exactly as it would be
/// anywhere else.
proc parseSqlExpr(source: Str, p: mut Parse): ast.Expr {
	lexed := lexer.lex(text.trim(source))
	for each e in lexed.errors {
		append(p.errors, e)
	}
	mut Parse inner = Parse(0, false, false, [])
	written := parseExpr(lexed.tokens, inner)
	for each e in inner.errors {
		append(p.errors, e)
	}
	if inner.failed {
		p.failed = true
	}
	return written
}

/// The `}` that closes the `\{` at `opens`, or `-1`. Braces are counted, because
/// a WHERE block holds `if` blocks which hold bound values of their own.
func matchingBrace(cs: Str[], opens: Int): Int {
	mut depth := 0
	for i := opens; i < len(cs); i++ {
		c := text.charAt(cs, i)
		if c == "\{" {
			depth = depth + 1
		} else if c == "}" {
			depth = depth - 1
			if depth == 0 {
				return i
			}
		}
	}
	return -1
}

// The next `\{` at this level, which is where a condition ends and its
// predicate begins.
func nextBrace(cs: Str[], from: Int): Int {
	for i := from; i < len(cs); i++ {
		if text.charAt(cs, i) == "\{" {
			return i
		}
	}
	return -1
}

func pastBlanks(cs: Str[], from: Int): Int {
	mut at := from
	for ; at < len(cs) && text.isSpace(text.charAt(cs, at)); {
		at = at + 1
	}
	return at
}

func sqlWord(cs: Str[], from: Int): Str {
	mut out := ""
	for i := from; i < len(cs); i++ {
		c := text.charAt(cs, i)
		if text.isAlpha(c) == false {
			return out
		}
		out = out + c
	}
	return out
}

/// Whether the text before a `\{` ends with the WHERE the block belongs to.
func endsWithWhere(lit: Str): Bool {
	return text.endsWith(text.upper(text.trim(lit)), "WHERE")
}

/// The same text with that WHERE taken off, because a block with nothing in it
/// leaves no WHERE behind — there is no `WHERE 1 = 1` to write here.
func withoutWhere(lit: Str): Str {
	cs := text.chars(lit)
	mut cut := len(cs)
	for ; cut > 0 && text.isSpace(text.charAt(cs, cut - 1)); {
		cut = cut - 1
	}
	if cut < 5 {
		return lit
	}
	return text.span(cs, 0, cut - 6)
}

// `type T { field: T  Variant { field: T }  Variant }`. Fields and variants may
// be interleaved: a field written outside any variant is added to every one of
// them, and where it was written says nothing about which.
proc parseTypeDecl(ts: token.Token[], p: mut Parse): ast.Decl {
	line := lineAt(ts, p.pos)
	advance(p)
	name := expectIdent(ts, p, naming.Role.TypeName())
	mut ast.Field[dyn] fields = []
	mut ast.Variant[dyn] variants = []
	if expect(ts, p, token.Kind.LBrace()) == false {
		return ast.Decl.TypeDecl(name, fields, variants, line)
	}
	for ; p.failed == false && atEnd(ts, p) == false; {
		if kindAt(ts, p.pos) == token.Kind.RBrace() {
			advance(p)
			return ast.Decl.TypeDecl(name, fields, variants, line)
		}
		// A name followed by `:` is a field; anything else at this position is a
		// variant, whose own fields are in the braces after it.
		if kindAt(ts, p.pos + 1) == token.Kind.Colon() {
			append(fields, parseField(ts, p))
		} else {
			append(variants, parseVariant(ts, p))
		}
		skipCommas(ts, p)
	}
	if p.failed == false {
		expected(ts, p, "`}` to close this type")
	}
	return ast.Decl.TypeDecl(name, fields, variants, line)
}

proc parseField(ts: token.Token[], p: mut Parse): ast.Field {
	name := expectIdent(ts, p, naming.Role.Field())
	if expect(ts, p, token.Kind.Colon()) == false {
		return ast.Field(name, ast.TypeExpr.VoidType())
	}
	return ast.Field(name, parseTypeExpr(ts, p))
}

proc parseVariant(ts: token.Token[], p: mut Parse): ast.Variant {
	name := expectIdent(ts, p, naming.Role.Variant())
	mut ast.Field[dyn] fields = []
	if kindAt(ts, p.pos) != token.Kind.LBrace() {
		return ast.Variant(name, fields)
	}
	advance(p)
	for ; p.failed == false && atEnd(ts, p) == false; {
		if kindAt(ts, p.pos) == token.Kind.RBrace() {
			advance(p)
			return ast.Variant(name, fields)
		}
		append(fields, parseField(ts, p))
		skipCommas(ts, p)
	}
	if p.failed == false {
		expected(ts, p, "`}` to close this variant")
	}
	return ast.Variant(name, fields)
}

// A field list may be written with commas between its entries or without them.
proc skipCommas(ts: token.Token[], p: mut Parse): void {
	for ; kindAt(ts, p.pos) == token.Kind.Comma(); advance(p) {
	}
}

proc parseCallable(ts: token.Token[], p: mut Parse, kind: ast.CallableKind): ast.Decl {
	line := lineAt(ts, p.pos)
	advance(p)
	name := expectIdent(ts, p, naming.Role.Callable())
	params := parseParams(ts, p)
	result := parseResultType(ts, p)
	body := parseBlock(ts, p)
	return ast.Decl.CallableDecl(kind, name, params, result, body, line)
}

proc parseQueryDecl(ts: token.Token[], p: mut Parse): ast.Decl {
	line := lineAt(ts, p.pos)
	advance(p)
	name := expectIdent(ts, p, naming.Role.Callable())
	params := parseParams(ts, p)
	result := parseResultType(ts, p)
	mut ast.SqlPart[dyn] sql = []
	k := kindAt(ts, p.pos)
	if k is token.Kind.SqlBody(body) {
		advance(p)
		sql = parseSqlBody(body, p)
	} else if p.failed == false {
		expected(ts, p, "a `\{ ... }` SQL body after the query's return type")
	}
	return ast.Decl.QueryDecl(name, params, result, sql, line)
}

// `test "what should be true" { ... }`. The name is prose because a test name is
// documentation rather than something anything calls — which is also why it takes
// no parameters and returns nothing.
proc parseTestDecl(ts: token.Token[], p: mut Parse): ast.Decl {
	line := lineAt(ts, p.pos)
	advance(p)
	mut title := ""
	k := kindAt(ts, p.pos)
	if k is token.Kind.StrLit(t) {
		advance(p)
		title = t
	} else if k is token.Kind.StrParts(_) {
		fail(ts, p, "a test's name is prose, not a value: it is written once and read by whoever runs the suite, so there is nothing in scope for an interpolation to reach")
		return ast.Decl.TestDecl("", ast.Block([]), line)
	} else {
		expected(ts, p, "a name in quotes after `test`")
		return ast.Decl.TestDecl("", ast.Block([]), line)
	}
	return ast.Decl.TestDecl(title, parseBlock(ts, p), line)
}

proc parseParams(ts: token.Token[], p: mut Parse): ast.Param[dyn] {
	mut ast.Param[dyn] params = []
	if expect(ts, p, token.Kind.LParen()) == false {
		return params
	}
	for ; p.failed == false && atEnd(ts, p) == false; {
		if kindAt(ts, p.pos) == token.Kind.RParen() {
			advance(p)
			return params
		}
		name := expectIdent(ts, p, naming.Role.Parameter())
		if expect(ts, p, token.Kind.Colon()) == false {
			return params
		}
		// `v: mut T` asks for the mutex itself rather than a view of it. Only a
		// `proc` may — a later pass's business; here it is only a shape.
		mutex := kindAt(ts, p.pos) == token.Kind.KwMut()
		if mutex {
			advance(p)
		}
		append(params, ast.Param(name, parseTypeExpr(ts, p), mutex))
		if kindAt(ts, p.pos) == token.Kind.Comma() {
			advance(p)
		} else if kindAt(ts, p.pos) != token.Kind.RParen() && p.failed == false {
			expected(ts, p, "`,` or `)` in a parameter list")
			return params
		}
	}
	return params
}

proc parseResultType(ts: token.Token[], p: mut Parse): ast.TypeExpr {
	if expect(ts, p, token.Kind.Colon()) == false {
		return ast.TypeExpr.VoidType()
	}
	return parseTypeExpr(ts, p)
}

// --- Types -------------------------------------------------------------------

proc parseTypeExpr(ts: token.Token[], p: mut Parse): ast.TypeExpr {
	k := kindAt(ts, p.pos)
	if k == token.Kind.KwVoid() {
		advance(p)
		return ast.TypeExpr.VoidType()
	}
	if k == token.Kind.KwFunc() {
		return parseFnType(ts, p, true)
	}
	if k == token.Kind.KwProc() {
		return parseFnType(ts, p, false)
	}
	return parseNamedType(ts, p)
}

// `func(Int, Str): Bool` — a declaration with the name dropped.
proc parseFnType(ts: token.Token[], p: mut Parse, pure: Bool): ast.TypeExpr {
	advance(p)
	mut ast.TypeExpr[dyn] params = []
	if expect(ts, p, token.Kind.LParen()) == false {
		return ast.TypeExpr.Fn(pure, params, ast.TypeExpr.VoidType())
	}
	for ; p.failed == false && atEnd(ts, p) == false; {
		if kindAt(ts, p.pos) == token.Kind.RParen() {
			advance(p)
			return ast.TypeExpr.Fn(pure, params, parseResultType(ts, p))
		}
		append(params, parseTypeExpr(ts, p))
		if kindAt(ts, p.pos) == token.Kind.Comma() {
			advance(p)
		} else if kindAt(ts, p.pos) != token.Kind.RParen() && p.failed == false {
			expected(ts, p, "`,` or `)` in a function type")
			return ast.TypeExpr.Fn(pure, params, ast.TypeExpr.VoidType())
		}
	}
	return ast.TypeExpr.Fn(pure, params, ast.TypeExpr.VoidType())
}

// `hive.map.Map<Str, Int>[dyn]` — qualifier segments, the name, its type
// arguments, and its dimensions.
proc parseNamedType(ts: token.Token[], p: mut Parse): ast.TypeExpr {
	mut Str[dyn] segments = []
	name := wordAt(ts, p.pos)
	if name == "" {
		expected(ts, p, "a type")
		return ast.TypeExpr.VoidType()
	}
	advance(p)
	append(segments, name)
	for ; kindAt(ts, p.pos) == token.Kind.Dot(); {
		advance(p)
		next := wordAt(ts, p.pos)
		if next == "" {
			expected(ts, p, "a name after `.` in a type")
			return ast.TypeExpr.VoidType()
		}
		advance(p)
		append(segments, next)
	}

	// The last segment is the type; everything before it is what stands in
	// front of it, which is a module and is written like one.
	last := len(segments) - 1
	typeName := text.charAt(segments, last)
	mut Str[dyn] qualifier = []
	for i := 0; i < last; i++ {
		part := text.charAt(segments, i)
		if naming.fits(naming.Role.Module(), part) == false {
			fail(ts, p, naming.message(naming.Role.Module(), part))
			return ast.TypeExpr.VoidType()
		}
		append(qualifier, part)
	}
	if naming.fits(naming.Role.TypeName(), typeName) == false {
		fail(ts, p, naming.message(naming.Role.TypeName(), typeName))
		return ast.TypeExpr.VoidType()
	}

	args := parseTypeArgs(ts, p)
	dims := parseDims(ts, p)
	return ast.TypeExpr.Named(join(qualifier, "."), typeName, args, dims)
}

proc parseTypeArgs(ts: token.Token[], p: mut Parse): ast.TypeExpr[dyn] {
	mut ast.TypeExpr[dyn] args = []
	if kindAt(ts, p.pos) != token.Kind.Lt() {
		return args
	}
	advance(p)
	for ; p.failed == false && atEnd(ts, p) == false; {
		append(args, parseTypeExpr(ts, p))
		if kindAt(ts, p.pos) == token.Kind.Comma() {
			advance(p)
		} else if kindAt(ts, p.pos) == token.Kind.Gt() {
			advance(p)
			return args
		} else if p.failed == false {
			expected(ts, p, "`,` or `>` in a type's arguments")
			return args
		}
	}
	return args
}

// `[]`, `[dyn]` and `[3]` — the three things a vector's length can say, and the
// only three.
proc parseDims(ts: token.Token[], p: mut Parse): ast.Dim[dyn] {
	mut ast.Dim[dyn] dims = []
	for ; kindAt(ts, p.pos) == token.Kind.LBracket(); {
		advance(p)
		inner := kindAt(ts, p.pos)
		if inner == token.Kind.RBracket() {
			advance(p)
			append(dims, ast.Dim.Any())
		} else if inner == token.Kind.KwDyn() {
			advance(p)
			if expect(ts, p, token.Kind.RBracket()) == false {
				return dims
			}
			append(dims, ast.Dim.Dynamic())
		} else if inner is token.Kind.IntLit(size) {
			advance(p)
			if expect(ts, p, token.Kind.RBracket()) == false {
				return dims
			}
			append(dims, ast.Dim.Fixed(size))
		} else {
			expected(ts, p, "`]`, `dyn` or a length in a vector type")
			return dims
		}
	}
	return dims
}

// --- Statements --------------------------------------------------------------

proc parseBlock(ts: token.Token[], p: mut Parse): ast.Block {
	mut ast.Stmt[dyn] stmts = []
	if expect(ts, p, token.Kind.LBrace()) == false {
		return ast.Block(stmts)
	}
	for ; p.failed == false && atEnd(ts, p) == false; {
		skipSemicolons(ts, p)
		if kindAt(ts, p.pos) == token.Kind.RBrace() {
			advance(p)
			return ast.Block(stmts)
		}
		before := p.pos
		s := parseStmt(ts, p)
		if p.failed {
			return ast.Block(stmts)
		}
		append(stmts, s)
		if p.pos == before {
			expected(ts, p, "a statement")
			return ast.Block(stmts)
		}
	}
	if p.failed == false {
		expected(ts, p, "`}` to close this block")
	}
	return ast.Block(stmts)
}

proc skipSemicolons(ts: token.Token[], p: mut Parse): void {
	for ; kindAt(ts, p.pos) == token.Kind.Semicolon(); advance(p) {
	}
}

proc parseStmt(ts: token.Token[], p: mut Parse): ast.Stmt {
	k := kindAt(ts, p.pos)
	if k == token.Kind.KwReturn() {
		return parseReturn(ts, p)
	} else if k == token.Kind.KwIf() {
		return parseIf(ts, p)
	} else if k == token.Kind.KwFor() {
		return parseFor(ts, p)
	} else if k == token.Kind.KwEcho() {
		advance(p)
		return ast.Stmt.EchoStmt(parseExpr(ts, p))
	} else if k == token.Kind.KwAssert() {
		advance(p)
		return ast.Stmt.AssertStmt(parseExpr(ts, p))
	} else if k == token.Kind.KwPanic() {
		advance(p)
		return ast.Stmt.PanicStmt(parseExpr(ts, p))
	} else if k == token.Kind.KwBreak() {
		advance(p)
		return ast.Stmt.BreakStmt()
	} else if k == token.Kind.KwContinue() {
		advance(p)
		return ast.Stmt.ContinueStmt()
	} else if k == token.Kind.KwAsync() {
		return ast.Stmt.AsyncStmt(parseAsyncCall(ts, p))
	} else if k == token.Kind.KwMut() {
		return parseMut(ts, p)
	}
	if kindAt(ts, p.pos + 1) == token.Kind.ColonEq() && wordAt(ts, p.pos) != "" {
		return parseInferredDecl(ts, p, false)
	}
	return parseTypedOrExpr(ts, p)
}

// `name := value`, and `name := async f(x)`, which starts the call now and waits
// wherever the name is read.
proc parseInferredDecl(ts: token.Token[], p: mut Parse, mutable: Bool): ast.Stmt {
	mut role := naming.Role.Variable()
	if mutable {
		role = naming.Role.MutVariable()
	}
	name := expectIdent(ts, p, role)
	advance(p)
	if mutable && refuseMutAsync(ts, p) {
		return ast.Stmt.Nothing()
	}
	deferred := kindAt(ts, p.pos) == token.Kind.KwAsync()
	if deferred {
		call := parseAsyncCall(ts, p)
		refuseDeferredTimeout(ts, p)
		return ast.Stmt.VarDecl(name, call, mutable, true)
	}
	return ast.Stmt.VarDecl(name, parseExpr(ts, p), mutable, false)
}

// `mut name := value` or `mut Type name = value`.
proc parseMut(ts: token.Token[], p: mut Parse): ast.Stmt {
	advance(p)
	if kindAt(ts, p.pos + 1) == token.Kind.ColonEq() && wordAt(ts, p.pos) != "" {
		return parseInferredDecl(ts, p, true)
	}
	mut declared := parseTypeExpr(ts, p)
	if p.failed {
		return ast.Stmt.Nothing()
	}
	name := wordAt(ts, p.pos)
	if name == "" || kindAt(ts, p.pos + 1) != token.Kind.Assign() {
		fail(ts, p, "expected `name := value` or `Type name = value` after `mut`")
		return ast.Stmt.Nothing()
	}
	bound := expectIdent(ts, p, naming.Role.MutVariable())
	advance(p)
	if refuseMutAsync(ts, p) {
		return ast.Stmt.Nothing()
	}
	return ast.Stmt.TypedDecl(declared, bound, parseExpr(ts, p), true, false)
}

// `mut` asks for storage that can be written to; an `async` binding is a value
// still being computed somewhere else. Nothing sensible comes of the two
// together, so the combination is refused where it is written.
proc refuseMutAsync(ts: token.Token[], p: mut Parse): Bool {
	if kindAt(ts, p.pos) != token.Kind.KwAsync() {
		return false
	}
	fail(ts, p, "`mut` and `async` cannot be combined: `x := async f()` names work that is still running, and the wait for it happens wherever the name is read — there is no storage of its own to assign to afterwards. Drop the `mut`, or wait for the call (`mut x := f()`) and reassign that.")
	return true
}

// A bound on an `async` binding would have nothing fixed to measure: the wait
// happens wherever the name is read, so the same variable could answer one read
// with a value and the next with a timeout.
proc refuseDeferredTimeout(ts: token.Token[], p: mut Parse): void {
	if kindAt(ts, p.pos) == token.Kind.KwWith() && wordAt(ts, p.pos + 1) == "timeout" {
		fail(ts, p, "`with timeout` cannot bound an `async` binding: the wait happens wherever the name is read, so there is no one moment for the bound to run from — two reads would get two different answers. Bound the wait itself instead: `r := f(x) with timeout 500`.")
	}
}

// The call an `async` fires off, in either position the word is allowed. The
// operand is parsed at the postfix level — exactly a call and nothing more —
// since `async` is not an operator over expressions.
proc parseAsyncCall(ts: token.Token[], p: mut Parse): ast.Expr {
	advance(p)
	operand := parsePostfix(ts, p)
	if p.failed {
		return ast.Expr.Absent()
	}
	if operand is ast.Expr.Call(_, _) {
		return operand
	}
	fail(ts, p, "`async` takes a call — `async slowThing(x)` runs it on its own virtual thread and does not wait for it. There is nothing else to fire off: every other expression is already finished by the time it is written.")
	return ast.Expr.Absent()
}

// An identifier-led statement is either a typed declaration (`Type name =
// value`) or an expression statement. The declaration form is tried first and
// commits only when a type expression is followed by `identifier =` — the one
// place this parser looks ahead.
proc parseTypedOrExpr(ts: token.Token[], p: mut Parse): ast.Stmt {
	start := p.pos
	p.quiet = true
	mut declared := parseTypeExpr(ts, p)
	committed := p.failed == false
		&& wordAt(ts, p.pos) != ""
		&& kindAt(ts, p.pos + 1) == token.Kind.Assign()
	p.quiet = false
	p.failed = false

	if committed {
		name := expectIdent(ts, p, naming.Role.Variable())
		advance(p)
		deferred := kindAt(ts, p.pos) == token.Kind.KwAsync()
		if deferred {
			call := parseAsyncCall(ts, p)
			refuseDeferredTimeout(ts, p)
			return ast.Stmt.TypedDecl(declared, name, call, false, true)
		}
		return ast.Stmt.TypedDecl(declared, name, parseExpr(ts, p), false, false)
	}
	p.pos = start
	return parseExprStmt(ts, p)
}

// Either a bare expression statement or a reassignment. The left-hand side is
// parsed as an ordinary expression — so `v`, `v[0]` and `v.field` all work — and
// a trailing `=` promotes it to an assignment.
proc parseExprStmt(ts: token.Token[], p: mut Parse): ast.Stmt {
	subject := parseExpr(ts, p)
	if p.failed {
		return ast.Stmt.Nothing()
	}
	k := kindAt(ts, p.pos)
	if k == token.Kind.Assign() {
		advance(p)
		return ast.Stmt.Assign(subject, parseExpr(ts, p))
	}
	// Compound assignment and the two steps desugar into a plain one, so nothing
	// downstream has four more shapes to know about — and the mutability check
	// and zero-safe division apply to them unchanged.
	if k == token.Kind.PlusEq() {
		return compound(ts, p, subject, ast.BinOp.Add())
	} else if k == token.Kind.MinusEq() {
		return compound(ts, p, subject, ast.BinOp.Sub())
	} else if k == token.Kind.StarEq() {
		return compound(ts, p, subject, ast.BinOp.Mul())
	} else if k == token.Kind.SlashEq() {
		return compound(ts, p, subject, ast.BinOp.Div())
	} else if k == token.Kind.PlusPlus() {
		advance(p)
		return step(subject, ast.BinOp.Add())
	} else if k == token.Kind.MinusMinus() {
		advance(p)
		return step(subject, ast.BinOp.Sub())
	}
	return ast.Stmt.Expression(subject)
}

proc compound(ts: token.Token[], p: mut Parse, target: ast.Expr, op: ast.BinOp): ast.Stmt {
	advance(p)
	return ast.Stmt.Assign(target, ast.Expr.Binary(op, target, parseExpr(ts, p)))
}

func step(target: ast.Expr, op: ast.BinOp): ast.Stmt {
	return ast.Stmt.Assign(target, ast.Expr.Binary(op, target, ast.Expr.IntLit(1)))
}

proc parseReturn(ts: token.Token[], p: mut Parse): ast.Stmt {
	advance(p)
	k := kindAt(ts, p.pos)
	// A bare `return` leaves a `void` callable, or a test, early. What makes it
	// bare is that nothing follows it on this statement.
	if k == token.Kind.RBrace() || k == token.Kind.Semicolon() || k == token.Kind.Eof() {
		return ast.Stmt.ReturnStmt(ast.Expr.Absent())
	}
	return ast.Stmt.ReturnStmt(parseExpr(ts, p))
}

proc parseIf(ts: token.Token[], p: mut Parse): ast.Stmt {
	mut ast.Branch[dyn] branches = []
	advance(p)
	condition := parseExpr(ts, p)
	body := parseBlock(ts, p)
	append(branches, ast.Branch(condition, body))

	for ; p.failed == false && kindAt(ts, p.pos) == token.Kind.KwElse(); {
		advance(p)
		if kindAt(ts, p.pos) == token.Kind.KwIf() {
			advance(p)
			nextCondition := parseExpr(ts, p)
			append(branches, ast.Branch(nextCondition, parseBlock(ts, p)))
		} else {
			return ast.Stmt.IfChain(branches, parseBlock(ts, p), true)
		}
	}
	return ast.Stmt.IfChain(branches, ast.Block([]), false)
}

proc parseFor(ts: token.Token[], p: mut Parse): ast.Stmt {
	advance(p)
	if kindAt(ts, p.pos) == token.Kind.KwEach() {
		return parseForEach(ts, p)
	}

	mut ast.Stmt init = ast.Stmt.Nothing()
	if kindAt(ts, p.pos) != token.Kind.Semicolon() {
		init = asCounter(ts, p, parseStmt(ts, p))
	}
	if expect(ts, p, token.Kind.Semicolon()) == false {
		return ast.Stmt.Nothing()
	}
	mut ast.Expr cond = ast.Expr.Absent()
	if kindAt(ts, p.pos) != token.Kind.Semicolon() {
		cond = parseExpr(ts, p)
	}
	if expect(ts, p, token.Kind.Semicolon()) == false {
		return ast.Stmt.Nothing()
	}
	mut ast.Stmt post = ast.Stmt.Nothing()
	if kindAt(ts, p.pos) != token.Kind.LBrace() {
		post = parseStmt(ts, p)
	}
	return ast.Stmt.ForLoop(init, cond, post, parseBlock(ts, p))
}

// A variable an init clause declares is forced mutable: the post clause advances
// it, which the mutability check would otherwise reject. Its name is rechecked
// for the same reason — a counter is not a constant.
proc asCounter(ts: token.Token[], p: mut Parse, s: ast.Stmt): ast.Stmt {
	if s is ast.Stmt.VarDecl(name, value, _, deferred) {
		refuseCounterAsync(ts, p, deferred)
		checkCounterName(ts, p, name)
		return ast.Stmt.VarDecl(name, value, true, deferred)
	} else if s is ast.Stmt.TypedDecl(declared, name, value, _, deferred) {
		refuseCounterAsync(ts, p, deferred)
		checkCounterName(ts, p, name)
		return ast.Stmt.TypedDecl(declared, name, value, true, deferred)
	}
	return s
}

proc checkCounterName(ts: token.Token[], p: mut Parse, name: Str): void {
	if naming.check(naming.Role.MutVariable(), name) is Result.Error(why) {
		fail(ts, p, why)
	}
}

proc refuseCounterAsync(ts: token.Token[], p: mut Parse, deferred: Bool): void {
	if deferred {
		fail(ts, p, "an `async` binding cannot be a loop's init clause: the counter that clause sets up is advanced by the loop itself, and work running on another thread is not. Start it before the loop and read the name inside.")
	}
}

proc parseForEach(ts: token.Token[], p: mut Parse): ast.Stmt {
	advance(p)
	name := expectIdent(ts, p, naming.Role.Binding())
	mut ast.TypeExpr declared = ast.TypeExpr.VoidType()
	if kindAt(ts, p.pos) == token.Kind.Colon() {
		advance(p)
		declared = parseTypeExpr(ts, p)
	}
	if expect(ts, p, token.Kind.KwIn()) == false {
		return ast.Stmt.Nothing()
	}
	subject := parseExpr(ts, p)
	return ast.Stmt.ForEach(name, declared, subject, parseBlock(ts, p))
}

// --- Expressions -------------------------------------------------------------
//
// Precedence climbing, loosest to tightest: `||`, `&&`, `is`/`bounds`,
// comparison, `+`/`-`, `*`/`/`/`%`, unary `-`, `**`, a `with` clause, postfix,
// primary.

proc parseExpr(ts: token.Token[], p: mut Parse): ast.Expr {
	return parseOr(ts, p)
}

proc parseOr(ts: token.Token[], p: mut Parse): ast.Expr {
	mut ast.Expr left = parseAnd(ts, p)
	for ; p.failed == false && kindAt(ts, p.pos) == token.Kind.PipePipe(); {
		advance(p)
		left = ast.Expr.Binary(ast.BinOp.Or(), left, parseAnd(ts, p))
	}
	return left
}

proc parseAnd(ts: token.Token[], p: mut Parse): ast.Expr {
	mut ast.Expr left = parseIs(ts, p)
	for ; p.failed == false && kindAt(ts, p.pos) == token.Kind.AmpAmp(); {
		advance(p)
		left = ast.Expr.Binary(ast.BinOp.And(), left, parseIs(ts, p))
	}
	return left
}

proc parseIs(ts: token.Token[], p: mut Parse): ast.Expr {
	left := parseComparison(ts, p)
	if p.failed {
		return left
	}
	k := kindAt(ts, p.pos)
	if k == token.Kind.KwIs() {
		advance(p)
		return ast.Expr.IsMatch(left, parsePattern(ts, p))
	}
	// `vector bounds index` is sugar for `index >= 0 && index < hive.len(vector)`.
	// Desugaring here means the emitter and the bounds pass understand it for
	// free — the bounds pass already mines this shape. The `len` is qualified so
	// the guard means the same thing in a program with a `len` of its own.
	if k == token.Kind.KwBounds() {
		advance(p)
		index := parseAdditive(ts, p)
		return ast.Expr.Binary(
			ast.BinOp.And(),
			ast.Expr.Binary(ast.BinOp.Ge(), index, ast.Expr.IntLit(0)),
			ast.Expr.Binary(ast.BinOp.Lt(), index, ast.Expr.Call(
				ast.Expr.Member(ast.Expr.Ident("hive"), "len"),
				[ast.Arg("", left)]
			))
		)
	}
	return left
}

proc parseComparison(ts: token.Token[], p: mut Parse): ast.Expr {
	left := parseAdditive(ts, p)
	if p.failed {
		return left
	}
	k := kindAt(ts, p.pos)
	if k == token.Kind.Gt() { return comparison(ts, p, left, ast.BinOp.Gt()) }
	else if k == token.Kind.Lt() { return comparison(ts, p, left, ast.BinOp.Lt()) }
	else if k == token.Kind.Ge() { return comparison(ts, p, left, ast.BinOp.Ge()) }
	else if k == token.Kind.Le() { return comparison(ts, p, left, ast.BinOp.Le()) }
	else if k == token.Kind.EqEq() { return comparison(ts, p, left, ast.BinOp.Eq()) }
	else if k == token.Kind.NotEq() { return comparison(ts, p, left, ast.BinOp.Neq()) }
	return left
}

proc comparison(ts: token.Token[], p: mut Parse, left: ast.Expr, op: ast.BinOp): ast.Expr {
	advance(p)
	return ast.Expr.Binary(op, left, parseAdditive(ts, p))
}

proc parseAdditive(ts: token.Token[], p: mut Parse): ast.Expr {
	mut ast.Expr left = parseMultiplicative(ts, p)
	for ; p.failed == false; {
		k := kindAt(ts, p.pos)
		if k == token.Kind.Plus() {
			advance(p)
			left = ast.Expr.Binary(ast.BinOp.Add(), left, parseMultiplicative(ts, p))
		} else if k == token.Kind.Minus() {
			advance(p)
			left = ast.Expr.Binary(ast.BinOp.Sub(), left, parseMultiplicative(ts, p))
		} else {
			return left
		}
	}
	return left
}

proc parseMultiplicative(ts: token.Token[], p: mut Parse): ast.Expr {
	mut ast.Expr left = parseUnary(ts, p)
	for ; p.failed == false; {
		k := kindAt(ts, p.pos)
		if k == token.Kind.Star() {
			advance(p)
			left = ast.Expr.Binary(ast.BinOp.Mul(), left, parseUnary(ts, p))
		} else if k == token.Kind.Slash() {
			advance(p)
			left = ast.Expr.Binary(ast.BinOp.Div(), left, parseUnary(ts, p))
		} else if k == token.Kind.Percent() {
			advance(p)
			left = ast.Expr.Binary(ast.BinOp.Mod(), left, parseUnary(ts, p))
		} else {
			return left
		}
	}
	return left
}

proc parseUnary(ts: token.Token[], p: mut Parse): ast.Expr {
	if kindAt(ts, p.pos) == token.Kind.Minus() {
		advance(p)
		return ast.Expr.Negate(parseUnary(ts, p))
	}
	return parsePower(ts, p)
}

// `**` is right-associative: `2 ** 3 ** 2` is `2 ** (3 ** 2)`. Its exponent is
// parsed at the unary level so `2 ** -3` reads the sign as part of the exponent.
proc parsePower(ts: token.Token[], p: mut Parse): ast.Expr {
	base := parseWith(ts, p)
	if p.failed == false && kindAt(ts, p.pos) == token.Kind.StarStar() {
		advance(p)
		return ast.Expr.Binary(ast.BinOp.Pow(), base, parseUnary(ts, p))
	}
	return base
}

// Two unrelated clauses share the `with` keyword: `with timeout <ms>` bounds a
// wait, anything else names a decode target. Told apart here so `timeout` is
// never read as a type name, and stays an ordinary identifier elsewhere.
proc parseWith(ts: token.Token[], p: mut Parse): ast.Expr {
	value := parsePostfix(ts, p)
	if p.failed || kindAt(ts, p.pos) != token.Kind.KwWith() {
		return value
	}
	if wordAt(ts, p.pos + 1) == "timeout" {
		advance(p)
		advance(p)
		// At the arithmetic level, not as a full expression: the clause stops
		// before `is` and `&&`, so `f(x) with timeout 500 is Result.Ok(v)` reads
		// as `(f(x) with timeout 500) is ...` rather than folding the comparison
		// into the millisecond count.
		ms := parseAdditive(ts, p)
		return timed(ts, p, value, ms)
	}
	advance(p)
	return ast.Expr.WithType(value, parseTypeExpr(ts, p))
}

// Anything that waits may be bounded: one blocking call, or the whole barrier of
// an await-all.
proc timed(ts: token.Token[], p: mut Parse, value: ast.Expr, ms: ast.Expr): ast.Expr {
	if value is ast.Expr.AwaitAll(calls, existing) {
		if existing is ast.Expr.Absent {
			return ast.Expr.AwaitAll(calls, ms)
		}
		fail(ts, p, "this `await` already has a `with timeout` clause")
		return value
	}
	if value is ast.Expr.Call(_, _) {
		return ast.Expr.Timed(value, ms)
	}
	if value is ast.Expr.Timed(_, _) {
		fail(ts, p, "this call already has a `with timeout` clause")
		return value
	}
	fail(ts, p, "`with timeout <ms>` bounds how long a wait may take, so it belongs on something that waits: a call (`f(x) with timeout 500`) or an await-all (`await [f(a), f(b)] with timeout 500`)")
	return value
}

proc parsePostfix(ts: token.Token[], p: mut Parse): ast.Expr {
	mut ast.Expr subject = parsePrimary(ts, p)
	for ; p.failed == false; {
		k := kindAt(ts, p.pos)
		if k == token.Kind.LParen() {
			advance(p)
			subject = ast.Expr.Call(subject, parseArgs(ts, p))
		} else if k == token.Kind.LBracket() {
			advance(p)
			subject = parseIndexOrSlice(ts, p, subject)
		} else if k == token.Kind.Dot() {
			advance(p)
			field := wordAt(ts, p.pos)
			if field == "" {
				expected(ts, p, "a name after `.`")
				return subject
			}
			advance(p)
			subject = ast.Expr.Member(subject, field)
		} else {
			return subject
		}
	}
	return subject
}

proc parseArgs(ts: token.Token[], p: mut Parse): ast.Arg[dyn] {
	mut ast.Arg[dyn] args = []
	for ; p.failed == false && atEnd(ts, p) == false; {
		if kindAt(ts, p.pos) == token.Kind.RParen() {
			advance(p)
			return args
		}
		append(args, parseArg(ts, p))
		if kindAt(ts, p.pos) == token.Kind.Comma() {
			advance(p)
		} else if kindAt(ts, p.pos) == token.Kind.RParen() {
			advance(p)
			return args
		} else if p.failed == false {
			expected(ts, p, "`,` or `)` in an argument list")
			return args
		}
	}
	return args
}

// An argument is either `name: value` or a plain expression.
proc parseArg(ts: token.Token[], p: mut Parse): ast.Arg {
	name := wordAt(ts, p.pos)
	if name != "" && kindAt(ts, p.pos + 1) == token.Kind.Colon() {
		advance(p)
		advance(p)
		return ast.Arg(name, parseExpr(ts, p))
	}
	return ast.Arg("", parseExpr(ts, p))
}

proc parseIndexOrSlice(ts: token.Token[], p: mut Parse, subject: ast.Expr): ast.Expr {
	// `[:` — a slice with no low bound.
	if kindAt(ts, p.pos) == token.Kind.Colon() {
		advance(p)
		if kindAt(ts, p.pos) == token.Kind.RBracket() {
			advance(p)
			return ast.Expr.Slice(subject, ast.Expr.Absent(), ast.Expr.Absent())
		}
		high := parseExpr(ts, p)
		expect(ts, p, token.Kind.RBracket())
		return ast.Expr.Slice(subject, ast.Expr.Absent(), high)
	}
	low := parseExpr(ts, p)
	if p.failed {
		return subject
	}
	if kindAt(ts, p.pos) == token.Kind.RBracket() {
		advance(p)
		return ast.Expr.Index(subject, low)
	}
	if expect(ts, p, token.Kind.Colon()) == false {
		return subject
	}
	if kindAt(ts, p.pos) == token.Kind.RBracket() {
		advance(p)
		return ast.Expr.Slice(subject, low, ast.Expr.Absent())
	}
	high := parseExpr(ts, p)
	expect(ts, p, token.Kind.RBracket())
	return ast.Expr.Slice(subject, low, high)
}

proc parsePrimary(ts: token.Token[], p: mut Parse): ast.Expr {
	k := kindAt(ts, p.pos)

	if k is token.Kind.IntLit(v) { advance(p) return ast.Expr.IntLit(v) }
	else if k is token.Kind.FloatLit(v) { advance(p) return ast.Expr.FloatLit(v) }
	else if k is token.Kind.StrLit(t) { advance(p) return ast.Expr.StrLit(t) }
	else if k is token.Kind.AtomLit(atom) { advance(p) return ast.Expr.AtomLit(atom) }
	else if k is token.Kind.StrParts(parts) { return parseInterp(ts, p, parts) }
	else if k is token.Kind.Ident(name) {
		advance(p)
		// `_` is a hole where a call's argument was expected and a discarding
		// binding everywhere else. Where it landed decides, so it is carried as
		// itself and read later.
		if name == "_" {
			return ast.Expr.Hole()
		}
		return ast.Expr.Ident(name)
	}

	if k == token.Kind.KwTrue() { advance(p) return ast.Expr.BoolLit(true) }
	else if k == token.Kind.KwFalse() { advance(p) return ast.Expr.BoolLit(false) }
	else if k == token.Kind.LBracket() { advance(p) return parseVectorLit(ts, p) }
	else if k == token.Kind.KwAwait() { return parseAwaitAll(ts, p) }
	else if k == token.Kind.KwUsing() { return parseUsing(ts, p) }
	else if k == token.Kind.LParen() {
		advance(p)
		inner := parseExpr(ts, p)
		expect(ts, p, token.Kind.RParen())
		return inner
	}
	// `async` is not an expression: it says how a call is *run*, which can only
	// be asked as a statement of its own or on the value side of a declaration.
	// Anywhere else the value is wanted right there.
	else if k == token.Kind.KwAsync() {
		fail(ts, p, "`async` has no value of its own: it says how a call runs, not what it evaluates to, so it cannot sit inside a larger expression. Give it a name and read the name here — `x := async f(a)` starts the call now and waits at the first place `x` is read — or drop the `async` to wait for the result on the spot.")
		return ast.Expr.Absent()
	}

	fail(ts, p, "unexpected " + token.describe(k) + " in an expression")
	return ast.Expr.Absent()
}

proc parseVectorLit(ts: token.Token[], p: mut Parse): ast.Expr {
	mut ast.Expr[dyn] items = []
	for ; p.failed == false && atEnd(ts, p) == false; {
		if kindAt(ts, p.pos) == token.Kind.RBracket() {
			advance(p)
			return ast.Expr.VectorLit(items)
		}
		append(items, parseExpr(ts, p))
		if kindAt(ts, p.pos) == token.Kind.Comma() {
			advance(p)
		} else if kindAt(ts, p.pos) == token.Kind.RBracket() {
			advance(p)
			return ast.Expr.VectorLit(items)
		} else if p.failed == false {
			expected(ts, p, "`,` or `]` in a vector literal")
			return ast.Expr.VectorLit(items)
		}
	}
	return ast.Expr.VectorLit(items)
}

// `await [f(a), g(b)]` — the await-all, and the only `await` there is. A single
// call needs no keyword, calling it blocks already, so the `[` is required.
proc parseAwaitAll(ts: token.Token[], p: mut Parse): ast.Expr {
	advance(p)
	mut ast.Expr[dyn] calls = []
	if kindAt(ts, p.pos) != token.Kind.LBracket() {
		fail(ts, p, "`await` takes a list of calls to run all at once — `await [f(a), f(b)]` — but found " + token.describe(kindAt(ts, p.pos)) + ". One call on its own needs no `await`: calling it already blocks until it answers.")
		return ast.Expr.Absent()
	}
	advance(p)
	for ; p.failed == false && atEnd(ts, p) == false; {
		if kindAt(ts, p.pos) == token.Kind.RBracket() {
			advance(p)
			if len(calls) == 0 {
				fail(ts, p, "`await []` waits for nothing at all. List the calls to run together: `await [f(a), f(b)]`.")
			}
			return ast.Expr.AwaitAll(calls, ast.Expr.Absent())
		}
		item := parseExpr(ts, p)
		if p.failed {
			return ast.Expr.Absent()
		}
		if item is ast.Expr.Call(_, _) {
			append(calls, item)
		} else {
			fail(ts, p, "`await` runs each of its calls on its own virtual thread, so every entry has to be a call — this one is not. A value that is already in hand has nothing to wait for.")
			return ast.Expr.Absent()
		}
		if kindAt(ts, p.pos) == token.Kind.Comma() {
			advance(p)
		} else if kindAt(ts, p.pos) != token.Kind.RBracket() && p.failed == false {
			expected(ts, p, "`,` or `]` in an `await` list")
			return ast.Expr.Absent()
		}
	}
	return ast.Expr.AwaitAll(calls, ast.Expr.Absent())
}

// `using` reads a table, each form saying in the source what it is reading. The
// operand is parsed at the postfix level so a call is consumed whole; none of
// the words below is a postfix operator, so the source stops cleanly before them.
proc parseUsing(ts: token.Token[], p: mut Parse): ast.Expr {
	advance(p)
	source := parsePostfix(ts, p)
	if p.failed {
		return ast.Expr.Absent()
	}
	word := wordAt(ts, p.pos)
	if word == "as" {
		advance(p)
		return ast.Expr.UsingExpr(source, parseUsingFormat(ts, p))
	}
	if word == "run" {
		advance(p)
		// A query is camelCase, so `RAW` is this word shouted rather than
		// something to call.
		if miscased(wordAt(ts, p.pos), "raw") {
			fail(ts, p, naming.miscasedKeyword(wordAt(ts, p.pos)) + ".")
			return ast.Expr.Absent()
		}
		if wordAt(ts, p.pos) == "raw" {
			advance(p)
			return ast.Expr.UsingExpr(source, ast.UsingForm.Raw(parsePostfix(ts, p)))
		}
		return ast.Expr.UsingExpr(source, ast.UsingForm.RunQuery(parsePostfix(ts, p)))
	}
	if miscased(word, "as") || miscased(word, "run") {
		fail(ts, p, naming.miscasedKeyword(word) + ".")
		return ast.Expr.Absent()
	}
	// A bare `using <path>` is a comma-separated CSV.
	return ast.Expr.UsingExpr(source, ast.UsingForm.Csv(ast.Expr.Absent()))
}

proc parseUsingFormat(ts: token.Token[], p: mut Parse): ast.UsingForm {
	word := wordAt(ts, p.pos)
	if word == "xlsx" {
		advance(p)
		return ast.UsingForm.Xlsx()
	}
	if word == "ods" {
		advance(p)
		return ast.UsingForm.Ods()
	}
	if word == "csv" {
		advance(p)
		if wordAt(ts, p.pos) != "separating" {
			return ast.UsingForm.Csv(ast.Expr.Absent())
		}
		advance(p)
		if wordAt(ts, p.pos) != "by" {
			expected(ts, p, "`by` after `separating`")
			return ast.UsingForm.Csv(ast.Expr.Absent())
		}
		advance(p)
		return ast.UsingForm.Csv(parsePostfix(ts, p))
	}
	if miscased(word, "csv") || miscased(word, "xlsx") || miscased(word, "ods") {
		fail(ts, p, naming.miscasedKeyword(word) + ".")
		return ast.UsingForm.Csv(ast.Expr.Absent())
	}
	fail(ts, p, "`using ... as` names the format being read: `csv` (with an optional `separating by <separator>`), `xlsx` or `ods`")
	return ast.UsingForm.Csv(ast.Expr.Absent())
}

// An interpolated string, with each captured `{...}` parsed as a full
// expression of its own.
proc parseInterp(ts: token.Token[], p: mut Parse, parts: token.StrPart[]): ast.Expr {
	line := lineAt(ts, p.pos)
	advance(p)
	mut ast.InterpPart[dyn] out = []
	for each part in parts {
		if part is token.StrPart.Literal(t) {
			append(out, ast.InterpPart.Literal(t))
		} else if part is token.StrPart.Code(source) {
			append(out, ast.InterpPart.Expression(parseSubExpr(ts, p, source, line)))
		} else if part is token.StrPart.Hole(name, _) {
			// `\{name is (regex)}` asks a question, and a string being built has
			// nobody to answer it.
			fail(ts, p, "`\{{name} is (...)}` is a pattern's hole, not something a string can hold: it says what the text there has to look like, which only means anything on the right of an `is`. To put a `\{` in a string, write `\\\{`")
		}
	}
	return ast.Expr.Interp(out)
}

// An expression captured as text — a string's interpolation — parsed by running
// the lexer and the parser over it again: same grammar, same two passes.
proc parseSubExpr(ts: token.Token[], p: mut Parse, source: Str, line: Int): ast.Expr {
	lexed := lexer.lex(source)
	if len(lexed.errors) > 0 {
		reportSub(ts, p, line, source, "does not lex")
		return ast.Expr.Absent()
	}
	mut Parse inner = Parse(0, false, false, [])
	value := parseExpr(lexed.tokens, inner)
	if inner.failed || kindAt(lexed.tokens, inner.pos) != token.Kind.Eof() {
		reportSub(ts, p, line, source, "is not one expression")
		return ast.Expr.Absent()
	}
	return value
}

proc reportSub(ts: token.Token[], p: mut Parse, line: Int, source: Str, why: Str): void {
	if p.quiet == false && p.failed == false {
		append(p.errors, diag.at(line, "the interpolated expression `{source}` {why}"))
	}
	p.failed = true
}

// --- Patterns ----------------------------------------------------------------

proc parsePattern(ts: token.Token[], p: mut Parse): ast.Pattern {
	k := kindAt(ts, p.pos)
	if k is token.Kind.StrLit(t) {
		advance(p)
		// A hole that arrived as literal text was written where nothing reads it
		// as one — a backtick string, or behind an escaped `\{`. Either way it
		// would match the characters rather than the shape, and never match.
		if looksLikeHole(t) {
			fail(ts, p, "this pattern holds `\{name is (...)}` as literal text rather than as a hole, so it would match those characters and never match at all. A hole only opens in an ordinary `\"...\"` pattern — a backtick string has no holes, and a `\\\{` asked for the brace itself")
			return ast.Pattern.StrTemplate([token.StrPart.Literal(t)])
		}
		// A hole-less template is an exact match, which is the whole of what a
		// plain string pattern says.
		return ast.Pattern.StrTemplate([token.StrPart.Literal(t)])
	}
	if k is token.Kind.StrParts(parts) {
		advance(p)
		return stringPattern(ts, p, parts)
	}
	if k == token.Kind.LBracket() {
		advance(p)
		return parseVectorPattern(ts, p)
	}
	return parseConstructorPattern(ts, p)
}

// A string pattern's holes bind; they do not compute. Two rules keep that
// honest, both compile errors rather than a match impossible to read.
proc stringPattern(ts: token.Token[], p: mut Parse, parts: token.StrPart[]): ast.Pattern {
	mut wasHole := false
	mut token.StrPart[dyn] out = []
	mut Str[dyn] named = []
	for each part in parts {
		if part is token.StrPart.Code(source) {
			name := text.trim(source)
			if naming.fits(naming.Role.Binding(), name) == false || name == "_" {
				fail(ts, p, "a string pattern's `\{{source}}` has to be a plain name to bind the text to — it is a hole, not an expression")
				return ast.Pattern.StrTemplate(parts)
			}
			// Two plain holes side by side have no split point. A hole that says
			// what it matches does, so the rule is about the open ones only.
			if wasHole {
				fail(ts, p, "two holes that take any text may not sit side by side in a string pattern: with no literal text between them there is nothing to say where one ends and the next begins. Give one of them a regex — `\{{name} is (...)}` — and it says where it ends itself")
				return ast.Pattern.StrTemplate(parts)
			}
			if duplicateHole(named, name, ts, p) {
				return ast.Pattern.StrTemplate(parts)
			}
			append(named, name)
			append(out, part)
			wasHole = true
		} else if part is token.StrPart.Hole(name, pattern) {
			if naming.fits(naming.Role.Binding(), name) == false || name == "_" {
				fail(ts, p, "`\{{name} is (...)}` binds the text it matches to `{name}`, so `{name}` has to be a plain binding name — `camelCase`")
				return ast.Pattern.StrTemplate(parts)
			}
			if duplicateHole(named, name, ts, p) {
				return ast.Pattern.StrTemplate(parts)
			}
			// Read here, once, so a malformed regex is a compile error naming
			// what is wrong with it rather than something the Go toolchain says
			// about a file nobody wrote. What comes back is the same pattern with
			// its capturing groups made plain — a template's holes are its
			// capture groups, one each.
			if regex.check(pattern) is Result.Ok(compiled) {
				append(named, name)
				append(out, token.StrPart.Hole(name, compiled))
			} else if regex.check(pattern) is Result.Error(why) {
				fail(ts, p, "in the hole `\{{name} is (...)}`: " + why)
				return ast.Pattern.StrTemplate(parts)
			}
			wasHole = false
		} else {
			append(out, part)
			wasHole = false
		}
	}
	return ast.Pattern.StrTemplate(out)
}

// Two holes of one name would bind the same word to two different pieces of the
// text, and the second would quietly win.
proc duplicateHole(named: Str[], name: Str, ts: token.Token[], p: mut Parse): Bool {
	if indexOf(named, name) is Result.Ok(_) {
		fail(ts, p, "this pattern binds `{name}` twice, and the two holes would take different text. Give them different names")
		return true
	}
	return false
}

// Whether literal text holds what somebody meant as a regex hole — one written
// where nothing reads it as such: a backtick pattern, or an escaped `\{`.
//
// The shape is looked for exactly, name and all, so an escaped brace with
// unrelated text after it — `"\\{a} is (b)}"` — is left alone.
func looksLikeHole(t: Str): Bool {
	mut first := true
	for each piece in split(t, "\{") {
		// `split` gives the text before the first `\{` as well, and nothing
		// opened that one.
		if first {
			first = false
		} else if opensHole(piece) {
			return true
		}
	}
	return false
}

// Whether `piece` — the text just past a `\{` — reads as `name is (...)}`.
func opensHole(piece: Str): Bool {
	cs := text.chars(piece)
	mut i := 0
	for ; i < len(cs); i++ {
		c := text.charAt(cs, i)
		if text.isAlnum(c) == false {
			if i == 0 {
				return false
			}
			return text.matchesAt(cs, i, " is (") && text.contains(piece, ")}")
		}
	}
	return false
}

proc parseVectorPattern(ts: token.Token[], p: mut Parse): ast.Pattern {
	mut ast.VecElem[dyn] elements = []
	mut rest := ""
	for ; p.failed == false && atEnd(ts, p) == false; {
		if kindAt(ts, p.pos) == token.Kind.RBracket() {
			advance(p)
			return ast.Pattern.VectorPat(elements, rest)
		}
		// `...name` relaxes the length from an exact count to a lower bound, and
		// binds the leftovers as a vector. It closes the pattern.
		if kindAt(ts, p.pos) == token.Kind.Ellipsis() {
			advance(p)
			rest = expectIdent(ts, p, naming.Role.Binding())
			if expect(ts, p, token.Kind.RBracket()) == false {
				return ast.Pattern.VectorPat(elements, rest)
			}
			return ast.Pattern.VectorPat(elements, rest)
		}
		append(elements, parseVecElem(ts, p))
		if kindAt(ts, p.pos) == token.Kind.Comma() {
			advance(p)
		} else if kindAt(ts, p.pos) != token.Kind.RBracket() && p.failed == false {
			expected(ts, p, "`,` or `]` in a vector pattern")
			return ast.Pattern.VectorPat(elements, rest)
		}
	}
	return ast.Pattern.VectorPat(elements, rest)
}

// One position: a literal the element has to equal, a name to bind it to, or `_`
// to skip it.
proc parseVecElem(ts: token.Token[], p: mut Parse): ast.VecElem {
	k := kindAt(ts, p.pos)
	if k is token.Kind.IntLit(v) { advance(p) return ast.VecElem.Match(ast.Expr.IntLit(v)) }
	else if k is token.Kind.FloatLit(v) { advance(p) return ast.VecElem.Match(ast.Expr.FloatLit(v)) }
	else if k is token.Kind.StrLit(t) { advance(p) return ast.VecElem.Match(ast.Expr.StrLit(t)) }
	else if k is token.Kind.AtomLit(atom) { advance(p) return ast.VecElem.Match(ast.Expr.AtomLit(atom)) }
	else if k == token.Kind.KwTrue() { advance(p) return ast.VecElem.Match(ast.Expr.BoolLit(true)) }
	else if k == token.Kind.KwFalse() { advance(p) return ast.VecElem.Match(ast.Expr.BoolLit(false)) }
	else if k == token.Kind.Minus() {
		advance(p)
		inner := kindAt(ts, p.pos)
		if inner is token.Kind.IntLit(v) {
			advance(p)
			return ast.VecElem.Match(ast.Expr.Negate(ast.Expr.IntLit(v)))
		}
		expected(ts, p, "a number after `-` in a vector pattern")
		return ast.VecElem.Bind("_")
	}
	return ast.VecElem.Bind(expectIdent(ts, p, naming.Role.Binding()))
}

// `Result.Ok(v)`, `Shape.Circle(r, _)`, `text.Align.Left`.
proc parseConstructorPattern(ts: token.Token[], p: mut Parse): ast.Pattern {
	mut Str[dyn] path = []
	mut Str[dyn] bindings = []
	first := wordAt(ts, p.pos)
	if first == "" {
		expected(ts, p, "a pattern")
		return ast.Pattern.Constructor(path, bindings, false)
	}
	advance(p)
	append(path, first)
	for ; kindAt(ts, p.pos) == token.Kind.Dot(); {
		advance(p)
		next := wordAt(ts, p.pos)
		if next == "" {
			expected(ts, p, "a name after `.` in a pattern")
			return ast.Pattern.Constructor(path, bindings, false)
		}
		advance(p)
		append(path, next)
	}
	if kindAt(ts, p.pos) != token.Kind.LParen() {
		return ast.Pattern.Constructor(path, bindings, false)
	}
	advance(p)
	for ; p.failed == false && atEnd(ts, p) == false; {
		if kindAt(ts, p.pos) == token.Kind.RParen() {
			advance(p)
			return ast.Pattern.Constructor(path, bindings, true)
		}
		append(bindings, expectIdent(ts, p, naming.Role.Binding()))
		if kindAt(ts, p.pos) == token.Kind.Comma() {
			advance(p)
		} else if kindAt(ts, p.pos) != token.Kind.RParen() && p.failed == false {
			expected(ts, p, "`,` or `)` in a pattern's bindings")
			return ast.Pattern.Constructor(path, bindings, true)
		}
	}
	return ast.Pattern.Constructor(path, bindings, true)
}
