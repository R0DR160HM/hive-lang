#!/usr/bin/env bash
# The Hive command line.
#
#   hive check <entrypoint.hive>       Report any errors, build nothing
#   hive emit  <entrypoint.hive>       Print the generated Go source
#   hive build <entrypoint.hive>       Compile to a native executable
#   hive run   <entrypoint.hive> [..]  Compile and run
#   hive test  <entrypoint.hive>       Run the program's tests, with coverage
#
# This is a two-line script because the compiler does everything itself: it
# writes the Go module and runs the Go toolchain over it, through
# `hive.term.exec`. All that is left here is finding the binary.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

if [ ! -x "$here/src/hivec" ]; then
	echo "hive: the compiler has not been built yet. Run: ./bootstrap" >&2
	exit 1
fi

exec "$here/src/hivec" "$@"
