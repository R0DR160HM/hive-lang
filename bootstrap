#!/usr/bin/env bash
# Build the Hive compiler.
#
# The compiler is written in Hive, so something has to compile it — and that
# something is a Hive compiler. Normally it is the one already built here:
# `src/hivec` compiles `src/hivec.hive` and replaces itself with what came out.
#
#   ./bootstrap                       with the compiler already at src/hivec
#   HIVEC=/path/to/hivec ./bootstrap  with one from somewhere else
#
# Nothing else is needed and nothing else is used: Hive builds Hive, and the
# compiler it was first built by is no longer in the picture. `./selfhost` is
# what proves that — stage 2 and stage 3 emit byte-identical Go, so whatever
# started the chain has left nothing of itself behind.
#
# After this runs, ./hive is the command line and src/hivec is the compiler it
# drives.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
compiler="${HIVEC:-$here/src/hivec}"

if [ ! -x "$compiler" ]; then
	echo "bootstrap: no Hive compiler to build this one with." >&2
	echo "           Expected one at $compiler." >&2
	echo "" >&2
	echo "           A compiler written in its own language needs a copy of" >&2
	echo "           itself to start from: take a built \`hivec\` from a release" >&2
	echo "           or another checkout and point at it —" >&2
	echo "" >&2
	echo "             HIVEC=/path/to/hivec ./bootstrap" >&2
	exit 1
fi

if [ "$compiler" == "$here/src/hivec" ]; then
	echo "Rebuilding the compiler with itself..."
else
	echo "Building the compiler with $compiler..."
fi
"$compiler" build "$here/src/hivec.hive"

chmod +x "$here/hive"
echo
echo "Done. The compiler is at src/hivec, and ./hive drives it:"
echo
echo "  ./hive run   <entrypoint.hive>"
echo "  ./hive test  <entrypoint.hive>"
echo "  ./hive check <entrypoint.hive>"
