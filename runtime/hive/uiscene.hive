// hive.ui
// =======
// The half of `hive.ui` that is a world: the scene, the shapes in it, and the attributes
// only a scene gives meaning to. A file of its own because its Go is — a program that draws
// no scene carries no engine.

func scene(attrs: Attr[dyn], shapes: Shape[dyn]): View {}
func inset(attrs: Attr[dyn], views: View[dyn]): View {}
func box(attrs: Attr[dyn], width: Float, height: Float, depth: Float): Shape {}
func sphere(attrs: Attr[dyn], radius: Float): Shape {}
func cylinder(attrs: Attr[dyn], radius: Float, height: Float): Shape {}
func cone(attrs: Attr[dyn], top: Float, bottom: Float, height: Float): Shape {}
func roof(attrs: Attr[dyn], wide: Float, tall: Float, long: Float): Shape {}
func ground(attrs: Attr[dyn], width: Float, depth: Float): Shape {}
func label(attrs: Attr[dyn], words: Str): Shape {}
func line(attrs: Attr[dyn], fromX: Float, fromY: Float, fromZ: Float, toX: Float, toY: Float, toZ: Float): Shape {}
func sound(attrs: Attr[dyn], name: Str): Shape {}
func sprite(attrs: Attr[dyn], image: Str, wide: Float, tall: Float): Shape {}
func figure(attrs: Attr[dyn], model: Str, bones: Float[dyn], paints: Tone[dyn]): Shape {}
func terrain(attrs: Attr[dyn], wide: Int, cell: Float, heights: Float[dyn], colours: Int[dyn]): Shape {}
func surface(value: Surface): Attr {}
func lens(value: Int): Attr {}
func fog(value: Int): Attr {}
func track(value: Str): Attr {}
func grain(value: Int): Attr {}
func bits(value: Int): Attr {}
func grab(value: Bool): Attr {}
func crosshair(value: Bool): Attr {}
func shadows(value: Bool): Attr {}
func at(x: Float, y: Float, z: Float): Attr {}
func turn(x: Float, y: Float, z: Float): Attr {}
func eye(x: Float, y: Float, z: Float): Attr {}
func aim(yaw: Float, pitch: Float): Attr {}
func scale(x: Float, y: Float, z: Float): Attr {}
func sun(yaw: Float, pitch: Float): Attr {}
func cast(value: Int): Attr {}
func voice(value: Voice): Attr {}
func pitch(value: Float): Attr {}
func volume(value: Float): Attr {}
func onKeyDown(f: func(Str): M): Attr {}
func onKeyUp(f: func(Str): M): Attr {}
func onGrab(f: func(Bool): M): Attr {}
func onFrame(f: func(Int): M): Attr {}
func onRate(f: func(Int): M): Attr {}
func onLook(f: func(Float, Float): M): Attr {}
func onSize(f: func(Int, Int): M): Attr {}
func onPad(f: func(Int, Str, Float): M): Attr {}
