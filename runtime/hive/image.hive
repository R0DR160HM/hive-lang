// hive.image
// ==========
// A picture read from the bytes of a file — PNG, JPEG, GIF or WebP — and the same picture at another size.

type Picture {
    width: Int
    height: Int
    pixels: UInt8[dyn]
}

type ImageError {
    message: Str
}

func decode(data: Str): Result<Picture, ImageError> {}
func scale(picture: Picture, width: Int, height: Int): Picture {}
