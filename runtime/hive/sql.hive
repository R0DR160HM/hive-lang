// hive.sql
// ========
// A connection, and running what a `query` declaration built.

type SqlConnection {
}

type DatabaseDriver {
    name: Str
    SQLite
    PostgreSQL
    Other
}

// A statement, which declares no rows, answers with how many it touched.
func run(connection: SqlConnection, _query: hive.sql.Fragment<R>): Result<R, SqlError> {}
func connect(driver: DatabaseDriver, connString: Str): Result<SqlConnection, SqlError> {}
func pool(driver: DatabaseDriver, connString: Str, maxOpen: Int, maxIdle: Int): Result<SqlConnection, SqlError> {}
func close(connection: SqlConnection): void {}
func raw(connection: SqlConnection, text: Str): Result<Table, SqlError> {}
