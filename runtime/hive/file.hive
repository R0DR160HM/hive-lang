// hive.file
// =========
// Files and folders, and the three tables a file can hold: CSV, XLSX and ODS.

type TableError {
    path: Str
    message: Str
}

func delete(path: Str): Result<Bool, FileError> {}
func read(path: Str): Result<Str, FileError> {}
func csv(path: Str, separator: Str): Result<Table, TableError> {}
func xlsx(path: Str): Result<Table[dyn], TableError> {}
func ods(path: Str): Result<Table[dyn], TableError> {}
func lines(path: Str): Result<Str[dyn], FileError> {}
func list(path: Str): Result<Str[dyn], FileError> {}
func write(path: Str, contents: Str): Result<Int, FileError> {}
func append(path: Str, contents: Str): Result<Int, FileError> {}
func size(path: Str): Result<Int, FileError> {}
func copy(from: Str, to: Str): Result<Int, FileError> {}
func writeSecret(path: Str, contents: Secret<Str>): Result<Int, FileError> {}
func makeDir(path: Str): Result<Bool, FileError> {}
func move(from: Str, to: Str): Result<Bool, FileError> {}
func exists(path: Str): Bool {}
