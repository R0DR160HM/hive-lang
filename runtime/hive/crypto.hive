// hive.crypto
// ===========
// Hashes, a cipher, random bytes, and tokens. A key is always a `Secret`.

type JwtError {
    path: Str
    expected: Str
    found: Str
}

type Header {
    alg: Str
    typ: Str
    kid: Str
}

func jwtCodec(secret: Secret<Str>): hive.codec.Codec<JwtError> {}
func sha256(input: Str): Str {}
func sha512(input: Str): Str {}
func hmacSha256(input: Str, key: Secret<Str>): Str {}
func base64Encode(input: Str): Str {}
func randomHex(bytes: Int): Str {}
func encrypt(plaintext: Secret<Str>, password: Secret<Str>): Str {}
func base64Decode(input: Str): Result<Str, CryptoError> {}
func randomSecret(bytes: Int): Result<Secret<Str>, SecretError> {}
func decrypt(ciphertext: Str, password: Secret<Str>): Result<Secret<Str>, CryptoError> {}
func decryptBypass(ciphertext: Str, password: Secret<Str>): Result<Secret<Str>, CryptoError> {}
func jwtHeader(token: Str): Result<Header, CryptoError> {}
func jwtDecode(token: Str): Result<Str, CryptoError> {}
