// hive.term
// =========
// The terminal a program runs in, its arguments, and the commands it starts.

type ExecError {
    command: Str
    code: Int
    output: Str
    message: Str
}

type FlagError {
    path: Str
    expected: Str
    found: Str
}

type Key {
    name: Str
    text: Str
}

type Size {
    width: Int
    height: Int
}

type Process {
    id: Int
}

func codec(): hive.codec.Codec<FlagError> {}
func print(text: Str): void {}
func println(text: Str): void {}
func status(text: Str): void {}
func size(): Result<Size, TermError> {}
func raw(on: Bool): Result<Bool, TermError> {}
func readKey(): Result<Key, TermError> {}
func read(): Str {}
func readSecret(): Result<Secret<Str>, SecretError> {}
func readSecretBypass(): Secret<Str> {}
func isTerminal(): Bool {}
func platform(): Str {}
func args(): Str[dyn] {}
func flags(): Str {}
func positional(line: Str): Str[dyn] {}
func exec(command: Str, arguments: Str[], directory: Str): Result<Str, ExecError> {}
func execWith(command: Str, arguments: Str[], directory: Str, environment: hive.map.Map<Str, Str>): Result<Str, ExecError> {}
func attach(command: Str, arguments: Str[], directory: Str): Int {}
func start(command: Str, arguments: Str[], directory: Str): Result<Process, ExecError> {}
func startWith(command: Str, arguments: Str[], directory: Str, environment: hive.map.Map<Str, Str>): Result<Process, ExecError> {}
func processReceive(process: Process, bytes: Int): Result<Str, ProcessError> {}
func processReceiveLine(process: Process): Result<Str, ProcessError> {}
func processSend(process: Process, text: Str): Result<Int, ProcessError> {}
func processCloseInput(process: Process): void {}
func processWait(process: Process): Int {}
func processKill(process: Process): void {}
func exit(code: Int): void {}
