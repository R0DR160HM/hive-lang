// hive.term
// =========
// The terminal a program runs in, its arguments, and the commands it starts.

type ExecError {
    command: Str
    code: Int
    output: Str
    message: Str
}

type FlagError {
    path: Str
    expected: Str
    found: Str
}

func codec(): hive.codec.Codec<FlagError> {}
func print(text: Str): void {}
func status(text: Str): void {}
func read(): Str {}
func readSecret(): Result<Secret<Str>, SecretError> {}
func readSecretBypass(): Secret<Str> {}
func isTerminal(): Bool {}
func platform(): Str {}
func args(): Str[dyn] {}
func exec(command: Str, arguments: Str[dyn], directory: Str): Result<Str, ExecError> {}
func execWith(command: Str, arguments: Str[dyn], directory: Str, environment: hive.map.Map<Str, Str>): Result<Str, ExecError> {}
func attach(command: Str, arguments: Str[dyn], directory: Str): Int {}
func exit(code: Int): void {}
