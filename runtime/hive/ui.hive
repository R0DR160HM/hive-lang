// hive.ui
// =======
// A window as a value: widgets, the attributes that dress them, a canvas's marks and a code
// editor's runs. What goes in a scene is in `uiscene.hive`, which is the same module.

type View {
}

type Attr {
}

type Shape {
}

type Mark {
}

type Run {
}

type Align {
    Start
    Center
    End
    Stretch
}

type Justify {
    Start
    Center
    End
    Between
}

type TextSize {
    Title
    Subtitle
    Body
    Caption
}

type Tone {
    Normal
    Muted
    Good
    Warn
    Danger
    HEX
    RGBA
}

type Axis {
    Horizontal
    Vertical
    Both
}

type Anchor {
    Pointer
    Caret
}

type InputKind {
    Text
    Number
    Date
    Password
    Search
    Range
}

type Icon {
    Search
    Close
    Check
    Plus
    Minus
    Up
    Down
    Left
    Right
    Warning
    Info
    Star
    Heart
    Reply
    Repeat
    Trash
    User
    Menu
}

type Voice {
    Engine
    Tyres
    Brakes
    Wind
    Crowd
    Music
    Impact
    Chime
    Talk
}

type Surface {
    Turf
    Gravel
    Tarmac
    Kerb
    Concrete
    Brick
    Panes
    Planks
    Staves
    Bark
    Leaves
    Crowd
    Mesh
    Speckle
    Metal
    Carbon
    Rubber
    Glass
    Gloss
}

func icon(attrs: Attr[dyn], name: Icon): View {}
func keys(value: Str[dyn]): Attr {}
// A window is a `spawn` handler of the same shape as its `update`.
func window(title: Str, view: func(S): View, update: H): H {}
func webview(title: Str, view: func(S): View, update: H): H {}
func size(value: TextSize): Attr {}
func path(attrs: Attr[dyn], points: Float[dyn]): Mark {}
func code(attrs: Attr[dyn], text: Str, runs: Run[dyn]): View {}
func input(attrs: Attr[dyn], value: Str): View {}
func row(attrs: Attr[dyn], views: View[dyn]): View {}
func column(attrs: Attr[dyn], views: View[dyn]): View {}
func spacer(): View {}
func overlay(attrs: Attr[dyn], child: View): View {}
func text(attrs: Attr[dyn], content: Str): View {}
func image(attrs: Attr[dyn], src: Str, alt: Str): View {}
func link(attrs: Attr[dyn], href: Str, label: Str): View {}
func button(attrs: Attr[dyn], label: Str): View {}
func textarea(attrs: Attr[dyn], value: Str): View {}
func checkbox(attrs: Attr[dyn], label: Str, checked: Bool): View {}
func select(attrs: Attr[dyn], options: Str[dyn], chosen: Str): View {}
func table(attrs: Attr[dyn], rows: Table): View {}
func canvas(attrs: Attr[dyn], marks: Mark[dyn]): View {}
func spinner(attrs: Attr[dyn]): View {}
func none(): View {}
func ink(from: Int, to: Int, tone: Tone): Run {}
func shade(from: Int, to: Int, tone: Tone): Run {}
func squiggle(from: Int, to: Int, tone: Tone): Run {}
func marker(line: Int, tone: Tone): Run {}
func underline(from: Int, to: Int, tone: Tone): Run {}
func band(line: Int, tone: Tone): Run {}
func note(line: Int, text: Str, tone: Tone): Run {}
func dot(attrs: Attr[dyn], x: Float, y: Float, radius: Float): Mark {}
func bar(attrs: Attr[dyn], x: Float, y: Float, width: Float, height: Float): Mark {}
func patch(attrs: Attr[dyn], points: Float[dyn]): Mark {}
func words(attrs: Attr[dyn], x: Float, y: Float, height: Float, text: Str): Mark {}
func gap(value: Int): Attr {}
func pad(value: Int): Attr {}
func width(value: Int): Attr {}
func height(value: Int): Attr {}
func grow(value: Int): Attr {}
func heading(value: Int): Attr {}
func align(value: Align): Attr {}
func justify(value: Justify): Attr {}
func scroll(value: Axis): Attr {}
func tone(value: Tone): Attr {}
func background(value: Tone): Attr {}
func kind(value: InputKind): Attr {}
func placeholder(value: Str): Attr {}
func hint(value: Str): Attr {}
func title(value: Str): Attr {}
func disabled(value: Bool): Attr {}
func caret(anchor: Int, head: Int, serial: Int): Attr {}
func numbers(value: Bool): Attr {}
func tabSize(value: Int): Attr {}
func anchor(value: Anchor): Attr {}
func focus(value: Int): Attr {}
func readOnly(value: Bool): Attr {}
func clip(text: Str, serial: Int): Attr {}
func perform(command: Str, serial: Int): Attr {}
func fontSize(value: Int): Attr {}
func border(value: Int): Attr {}
func borderTone(value: Tone): Attr {}
func radius(value: Int): Attr {}
func ring(value: Bool): Attr {}
func hover(value: Tone): Attr {}
func busy(value: Bool): Attr {}
func paint(value: Tone): Attr {}
func thick(value: Float): Attr {}
func region(x: Float, y: Float, width: Float, height: Float): Attr {}
func touch(value: Str): Attr {}
func on(message: M): Attr {}
func onDismiss(message: M): Attr {}
func onMenu(message: M): Attr {}
func onMiddle(message: M): Attr {}
func onDouble(message: M): Attr {}
func onInput(f: func(Str): M): Attr {}
func onSubmit(f: func(Str): M): Attr {}
func onChoose(f: func(Str): M): Attr {}
func onKey(f: func(Str): M): Attr {}
func onPaste(f: func(Str): M): Attr {}
func onToggle(f: func(Bool): M): Attr {}
func onCaret(f: func(Int, Int): M): Attr {}
func onView(f: func(Int, Int): M): Attr {}
func onFit(f: func(Int, Int): M): Attr {}
func onEdit(f: func(Int, Int, Str): M): Attr {}
func onDrag(f: func(Int, Int, Bool): M): Attr {}
func onHover(f: func(Int): M): Attr {}
func onJump(f: func(Int): M): Attr {}
func onProbe(f: func(Int): M): Attr {}
func onPick(f: func(Int): M): Attr {}
func onSort(f: func(Int): M): Attr {}
func html(view: View): Str {}
func page(title: Str, view: View): Str {}
