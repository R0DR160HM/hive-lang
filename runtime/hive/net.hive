// hive.net
// ========
// HTTP, WebSockets and plain sockets, each named for its protocol, and looking a name up.

type QueryParamsError {
    path: Str
    expected: Str
    found: Str
}

type HttpError {
    url: Str
    message: Str
}

type HttpResponse {
    status: Int
    headers: Table
    body: Str
}

type WsConnection {
}

type HttpRequest {
    method: Str
    url: Str
    headers: Table
    body: Str
}

type SocketConnection {
}

func httpRequest(request: HttpRequest): Result<HttpResponse, HttpError> {}
func queryParamsCodec(): hive.codec.Codec<QueryParamsError> {}
func httpServe(port: Int, handler: proc(HttpRequest): HttpResponse): void {}
func wsServe(port: Int, handler: proc(WsConnection): void): void {}
func socketServe(port: Int, handler: proc(SocketConnection): void): void {}
func wsClose(conn: WsConnection): void {}
func socketClose(conn: SocketConnection): void {}
func wsConnect(url: Str): Result<WsConnection, WsError> {}
func wsSend(conn: WsConnection, message: Str): Result<Int, WsError> {}
func wsReceive(conn: WsConnection): Result<Str, WsError> {}
func wsRequest(conn: WsConnection): HttpRequest {}
func socketConnect(host: Str, port: Int): Result<SocketConnection, SocketError> {}
func socketSend(conn: SocketConnection, data: Str): Result<Int, SocketError> {}
func socketReceive(conn: SocketConnection, bytes: Int): Result<Str, SocketError> {}
func socketReceiveLine(conn: SocketConnection): Result<Str, SocketError> {}
func socketPeer(conn: SocketConnection): Str {}
func resolve(name: Str): Result<Str[dyn], NetError> {}
func localAddress(): Result<Str, NetError> {}
func urlEncode(text: Str): Str {}
