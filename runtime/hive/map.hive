// hive.map
// ========
// A map from keys to values, in the order the keys were put in. What one holds is its
// own type's business, so every call here reads `K` and `V` off the map it is handed.

func new(): hive.map.Map<K, V> {}
func set(m: hive.map.Map<K, V>, key: K, value: V): void {}
func get(m: hive.map.Map<K, V>, key: K): Result<V, Bool> {}
func has(m: hive.map.Map<K, V>, key: K): Bool {}
func delete(m: hive.map.Map<K, V>, key: K): void {}
func keys(m: hive.map.Map<K, V>): K[dyn] {}
func values(m: hive.map.Map<K, V>): V[dyn] {}
func fromTable(t: Table): hive.map.Map<Str, Str> {}
func toTable(m: hive.map.Map<K, V>): Table {}
