// hive.conv
// =========
// Between numbers and text, and between text and its bytes. Nothing here widens or rounds
// on its own: each call says which way it goes.

type ConversionError {
    input: Str
    message: Str
}

func ceil(v: Float): Int {}
func floor(v: Float): Int {}
func round(v: Float): Int {}
func itf(v: Int): Float {}
func itf32(v: Int): Float32 {}
func its(v: Int): Str {}
func fts(v: Float): Str {}
func fromBytes(bytes: UInt8[]): Str {}
func bytesOf(text: Str): UInt8[dyn] {}
func sti(text: Str): Result<Int, ConversionError> {}
func stf(text: Str): Result<Float, ConversionError> {}
