// Distributed Actors (hive.syslink)
// =================================
// A `hive.syslink` *service* is a long-lived, addressable thing with a mailbox
// and private state. The point of the module is that one statement reaches it
// whether it is a mailbox in this process or a service on another machine — and
// there is only ever the one statement: you *call the address*. What the *call
// site* does with it decides what it means, exactly as it does for a func:
//
//   a(msg)                          send it, wait for the answer -> Result
//   a(msg) with timeout 500         ...for at most half a second
//   async a(msg)        (statement) send it and do not wait: never fails
//   r := async a(msg)               send it now, wait where `r` is read
//   await [a(m1), b(m2)]            send both, one barrier, one deadline
//
// There is no `send` and no `call` — an address is not a handle you pass to a
// function, it is the thing you call. A service answers with one of *its own*
// messages, so the reply type is the mailbox type and nothing has to be
// annotated.
//
// ANSWERING, AND FORGETTING TO
// ----------------------------
// A request that a service handles but never answers comes back immediately as
// `NoReply` — it does not sit there until the caller's patience runs out.
// Forgetting to reply on one branch is the easiest mistake to make in service
// code, and a five-second timeout is a terrible way to be told about it.
//
// The compiler decides which services that applies to, and you write nothing
// either way. If a handler's envelope only ever reaches `answer`, `self` or
// `monitor`, it cannot outlive the turn it arrived in, so once the turn ends no
// answer can possibly still be coming. If the envelope goes anywhere else —
// stored in the state, handed to a call the handler does not wait for — a reply
// may genuinely still be on its way, and the runtime keeps waiting instead. Both
// cases are shown below: `inbox` is the first kind, `unhurried` the second.
//
// An address is an ordinary value, and that is what separates a service from a
// call you did not wait for: a call has at most a result waiting to be read, while
// an address outlives everything, can be stored, and can travel inside a message.
//
// RUN IT — two terminals on one machine:
//
//   hive run distributed-actors.hive     # me 127.0.0.1:9100, peer 127.0.0.1:9101
//   hive run distributed-actors.hive     # me 127.0.0.1:9101, peer 127.0.0.1:9100
//
// or two machines on the same network: run it on each and give each the other's
// "ip:port" (the ports may then match). Both sides run identical code — a node
// is identified by where it is, so there are no roles to hand out and nothing
// distinguishes the two processes but the addresses they are given.
//
// Every connection is TLS 1.3 either way; the two nodes only have to share a
// cluster key, which is generated into ~/.hive/syslink.key on first run — copy
// that file to the second machine, or set HIVE_SYSLINK_KEY the same in both.

// The mailbox type. A service's mailbox is one user type, so `is` narrows every
// message and the compiler checks each send against it.
type Note {
	// A plain message: nothing is waiting for a reply.
	Say { text: Str }
	// A request, and the shape of its answer. A service replies with one of its
	// own messages, so a mailbox type is the whole protocol — requests and
	// responses together — and `is` narrows a reply exactly like anything else.
	HowMany
	Counted { seen: Int }
	// Asking the inbox to watch another service. Addresses are ordinary values,
	// so one travels inside a message like anything else.
	Watch { peer: hive.syslink.Address }
	// A death notice. The watcher picks this message itself, which is what keeps
	// the mailbox a single user type with no builtin envelope union mixed in.
	PeerLost
	// A request the inbox deliberately never answers.
	Ignore
	// An answer that arrives from a task rather than from a turn.
	Late { text: Str }
	// Asking the inbox to fall over, to show a crash stays local to it.
	Explode
}

// A service handler is the fold over its mailbox: state in, one message, the
// turn's envelope, and the next state out. There is no mutex anywhere and no
// `mut` — the fold *is* the mutex, which is the whole payoff of the model.
proc inbox(seen: Int, note: Note, from: hive.syslink.Envelope): Int {
	if note is Note.Say(text) {
		echo "  [inbox] {text}"
		return seen + 1
	} else if note is Note.HowMany {
		// `answer` replies to whoever is waiting. If the sender used `async`,
		// nothing is waiting and this is a no-op — one handler serves both
		// shapes without caring which it was.
		hive.syslink.answer(from, Note.Counted(seen))
		return seen
	} else if note is Note.Counted(count) {
		echo "  [inbox] someone told us they have seen {count} notes"
		return seen
	} else if note is Note.Watch(peer) {
		// A monitor needs the envelope, because a death notice has to land in
		// some mailbox — this one.
		hive.syslink.monitor(from, peer, Note.PeerLost())
		echo "  [inbox] watching the peer's inbox"
		return seen
	} else if note is Note.PeerLost {
		echo "  [inbox] !! the peer's inbox is gone"
		return seen
	} else if note is Note.Ignore {
		// Handled, and deliberately not answered. Every envelope in this handler
		// only ever reaches `answer` and `monitor`, so the compiler knows none of
		// them can outlive their turn: whoever is waiting is told at once.
		echo "  [inbox] ignoring that one on purpose"
		return seen
	} else if note is Note.Late(text) {
		echo "  [inbox] a late answer arrived: {text}"
		return seen
	}
	// A panic inside a service kills only that service: its monitors are told,
	// its callers stop waiting, and the node carries on.
	panic "the inbox was asked to explode"
}

// A service that answers from another thread instead of from its turn — the
// pattern for work too slow to hold a mailbox open for. `async answerLate(from)`
// lets the envelope outlive the turn, so the compiler switches the automatic
// `NoReply` off for this handler and the caller waits for the real answer.
proc unhurried(handled: Int, note: Note, from: hive.syslink.Envelope): Int {
	async answerLate(from)
	return handled + 1
}

func answerLate(from: hive.syslink.Envelope): void {
	hive.task.sleep(400)
	hive.syslink.answer(from, Note.Late("worth the wait"))
}

proc main(): void {
	echo "This node's own ip:port? (e.g. 127.0.0.1:9100)"
	me := hive.term.read()

	echo "The other node's ip:port? (e.g. 127.0.0.1:9101 or 192.168.1.42:9100)"
	peer := hive.term.read()

	// A node is identified by *where it is*. The endpoint is what peers dial and
	// what this node advertises, so an address handed to the peer stays dialable
	// even if the peer passes it on again. There is no port-mapper daemon, no
	// cluster-wide name registry, and nothing here has to be known when the
	// program is written — the endpoint could equally come from config or DNS.
	if hive.syslink.listen(me) is Result.Error(err) {
		panic err
	}
	echo "listening on {me}, peer at {peer}"

	// `at` is a service on this node; `on` is the same service somewhere else.
	// Only the *service* name is an atom, which is what lets the compiler know
	// every mailbox this program publishes.
	chat(hive.syslink.at(#Inbox), hive.syslink.on(peer, #Inbox))
}

// One address is a mailbox in this process, the other a service on the far node.
// Nothing below tells them apart.
proc chat(mine: hive.syslink.Address, theirs: hive.syslink.Address): void {
	// Spawn the service and publish it under a name. A service name is an atom
	// from a closed set, which is exactly why neither `at` nor `on` above needs a
	// type annotation: the compiler can see what every registered mailbox takes.
	box := hive.syslink.spawn(inbox, 0)
	if hive.syslink.register(#Inbox, box) is Result.Error(err) {
		panic err
	}

	// Nothing is waiting for a reply to a `Say`, so it is sent with `async`: that
	// form never blocks and never fails, which is precisely what keeps a local
	// send and a remote one the same statement.
	async mine(Note.Say("a local note"))

	echo "Press enter once the other node is listening."
	hive.term.read()

	// Nothing is dialed until there is a message to carry, so at this point the
	// other node is in our peer list only if *it* has already sent us something.
	echo "peers before the first send: {len(hive.syslink.peers())}"

	async theirs(Note.Say("hello from the other node"))
	async mine(Note.Watch(theirs))

	// ...and now it is there, because a connection *is* the list: one pipe per
	// node pair, filed under the endpoint the peer advertised no matter which end
	// opened it. So sending to a node adds it, a node dialing in adds itself, and
	// losing the connection — a peer that quits, or one that stops answering its
	// health checks — takes it back out with nothing to clean up. Each entry is
	// the endpoint to hand to `on`, which is what makes this the answer to "who
	// can I call later?".
	for each endpoint in hive.syslink.peers() {
		echo "  connected to {endpoint}"
	}

	// The same call *without* `async` is a request: it waits for the answer. This
	// is the one place in the module that reports failure, because it is the only
	// one with somewhere to report to — a timeout, a service that died mid-request
	// and an unreachable node all arrive here as a Result.Error. `with timeout`
	// bounds the wait; leave it off and syslink waits its own default instead.
	answer := theirs(Note.HowMany()) with timeout 4000
	if answer is Result.Ok(reply) && reply is Note.Counted(count) {
		echo "the peer's inbox has seen {count} notes"
	} else if answer is Result.Error(err) {
		echo "could not ask the peer: {err.reason} — {err.message}"
	}

	// Many at once: both go out, then one barrier with one deadline resolves them
	// in order. Waiting for a batch of sends spawns nothing at all — each answer
	// arrives on its own connection's reader.
	both := await [
		theirs(Note.HowMany()),
		mine(Note.HowMany()),
	] with timeout 4000
	if both[0] is Result.Ok(there) && there is Note.Counted(n) {
		echo "asked again, and the peer says {n}"
	}
	if both[1] is Result.Ok(here) && here is Note.Counted(n) {
		echo "our own inbox says {n}"
	}

	// Forgetting to answer, seen from the caller's side. `inbox` handles this and
	// never replies — and because its envelope cannot outlive the turn, this comes
	// straight back rather than waiting out the four seconds asked for.
	ignored := mine(Note.Ignore()) with timeout 4000
	if ignored is Result.Error(err) {
		echo "forgot to answer: {err.reason} — {err.message}"
	}

	// The other side of the same rule. `unhurried` hands its envelope to a call it
	// does not wait for, so an answer may still be coming and nothing is failed
	// early: the reply turns up 400ms later, and this call is what waits for it.
	slow := hive.syslink.spawn(unhurried, 0)
	late := slow(Note.Say("take your time")) with timeout 4000
	if late is Result.Ok(reply) && reply is Note.Late(text) {
		echo "answered late:    {text}"
	}

	echo "Type `boom` to crash the peer's inbox, or enter to finish."
	if hive.term.read() == "boom" {
		async theirs(Note.Explode())
		hive.task.sleep(1000)

		// The service is gone, but its node is fine — so this reports NoProc
		// rather than hanging, and the peer is still up to say so.
		if theirs(Note.HowMany()) with timeout 2000
			is Result.Error(err) {
			echo "asking again: {err.reason} — {err.message}"
		}
	}

	hive.task.sleep(500)
	echo "done"
}
