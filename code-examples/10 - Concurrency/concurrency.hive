// Concurrency
// ===========
// Every call blocks the caller. Nothing about a declaration says otherwise —
// there is no `async func`, no Future and no Promise type to name — so what a
// call means is decided where it is written:
//
//   f(x)                       wait for it, yields T
//   async f(x)   (a statement) fire-and-forget: its own thread, no result
//   f(x) with timeout 500      wait at most 500ms, yields Result<T, _>
//   await [f(a), f(b)]         run both at once, wait for both, yields T[2]
//
// `async` has no value: it starts the call and keeps nothing, so there is no
// handle to hold, to pass, or to leak out of the scope that spawned it. Which is
// why the language needs no type for one — every expression here has a type you
// could write down.

// Two ordinary funcs. Being funcs they can perform I/O but take no mutex.
func slowShout(text: Str): Str {
	hive.task.sleep(1000)
	return text + "!!!"
}

func lengthOf(text: Str): Int {
	return len(text)
}

proc main(): void {
	// 1. Fire-and-forget. `async` puts the call on its own thread and carries
	// on. Nothing comes back — that is the whole of the trade.
	async slowShout("logged in the background")

	// 2. A plain call. It blocks until the value is ready, and costs neither a
	// goroutine nor a channel: it is a function call.
	echo slowShout("blocking")

	// 3. Many at once: the await-all. Every call in the list starts, then the
	// whole list is one barrier resolving in order into a statically-sized,
	// fully-typed vector (`Str[3]`) — never a dynamic or `Any` vector. All three
	// sleep for a second, and this takes about one.
	Str[3] shouts = await [slowShout("a"), slowShout("b"), slowShout("c")]
	echo shouts[0] + " " + shouts[1] + " " + shouts[2]

	// A list of one is legal and still means "on its own thread, then wait".
	Str[1] alone = await [slowShout("just me")]
	echo alone[0]

	// 4. Void calls are waited for the same way. There is no value, so the
	// barrier has none either — it is a statement meaning "both of these, then
	// carry on".
	await [note("first"), note("second")]

	// 5. Work of *different* types is waited for one call at a time. Each is an
	// ordinary blocking call, so this costs the sum rather than the slowest —
	// which is exactly what the writing says it does.
	Str message = slowShout("mixed")
	Int count = lengthOf("mixed")
	echo message + " has base length " + hive.conv.its(count)

	// 6. Bounding a wait. `with timeout <ms>` may follow any call, and it changes
	// what the call yields: without it the value, with it a `Result` — running
	// out of patience is a value to handle, not a crash.
	if slowShout("worth waiting for") with timeout 100 is Result.Error(err) {
		echo "gave up after " + hive.conv.its(err.waited) + "ms: " + err.message
	}

	// The timeout abandons the *waiting*, not the work: a virtual thread cannot
	// be stopped from outside, so that shout ran to completion regardless — its
	// result was simply dropped. Asking again with more patience gets one.
	if slowShout("worth waiting for") with timeout 2000 is Result.Ok(value) {
		echo "waited long enough: " + value
	}

	// An await-all takes one deadline across the whole barrier, so this means
	// "both of them within two seconds", not two seconds each.
	if await [slowShout("first"), slowShout("second")] with timeout 2000
		is Result.Ok(done)
	{
		echo join(done, " / ")
	}

	// 7. A mutex parameter, and the one place the call site changes what an
	// argument *is*. `collect` asks for the vector itself (`log: mut Str[dyn]`),
	// not a view of it, so it can append to storage its caller keeps reading.
	mut Str[dyn] log = ["start"]

	// Waited for, the two names are one storage: this append is visible here.
	collect(log, "waited")
	echo log

	// Fired off, it is not. A thread of its own gets storage of its own — the
	// copy is made here, before the thread starts, so there is no moment where
	// both sides could write the same array. `log` never sees "fired".
	async collect(log, "fired")
	hive.task.sleep(400)
	echo log

	// `await` spawns too, so it copies for the same reason.
	await [collect(log, "awaited")]
	echo log

	// Which is the whole rule: `mut` on the parameter says the callee may write
	// through it, and where the call is written says whose storage that is.
}

// Only a `proc` may take a mutex — writing through one is exactly the side
// effect a `func` is the absence of. The argument has to be a `mut` variable (or
// a path into one): there has to be storage to point at, and its owner has to
// have said it can change.
proc collect(log: mut Str[dyn], entry: Str): void {
	hive.task.sleep(200)
	append(log, entry)
}

proc note(text: Str): void {
	hive.task.sleep(200)
	echo "noted " + text
}
