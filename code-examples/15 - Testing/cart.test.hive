// Testing
// =======
// A test is a top-level declaration, like a `proc` or a `type`:
//
//     test "what should be true" { ... }
//
// Run them with `hive test cart.test.hive`. There is no framework to install and
// nothing to register — the runner is the Go toolchain the compiler already
// drives, and coverage is not a separate mode: every run reports it.
//
// A test is named in prose because a test name is documentation, not something
// anything calls. It takes no parameters and returns nothing, for the same
// reason: there is no caller to give it either.

import ./cart

// `assert` is the same keyword as everywhere else, and it means the same thing:
// this must hold. What differs is what happens when it does not — outside a test
// the program has been proved wrong and stops, and inside one the *test* has,
// so the failure is recorded and the rest of the suite still runs.
test "an empty cart costs nothing" {
	cart.Item[0] empty = []
	assert cart.total(empty) == 0
}

test "one line multiplies price by quantity" {
	cart.Item[1] one = [cart.Item("pear", 3, 2)]
	assert cart.total(one) == 6
}

test "lines add up" {
	cart.Item[2] two = [cart.Item("pear", 3, 2), cart.Item("fig", 10, 1)]
	assert cart.total(two) == 16
}

// A comparison is worth more than a yes or no, so a failing one shows both
// sides — the compiler has the source text and the static types, so neither the
// values nor the condition have to be repeated in a message by hand:
//
//     FAIL  lines add up
//           cart.test.hive:33: assert cart.total(two) == 17
//             left:  16
//             right: 17
test "ten percent off" {
	assert cart.discount(200, 10) == 180
}

test "more than everything off is refused" {
	assert cart.discount(200, 101) == 0
}

// Anything a test can reach, a test can use: procs, I/O, the standard library.
// A table-driven test needs no new syntax, only a vector and a `for each`.
test "a discount never grows the total" {
	Int[3] percentages = [0, 50, 100]
	for each percent in percentages {
		assert cart.discount(100, percent) <= 100
	}
}

// `describe` is never called above. The run ends with
//
//     coverage: 87.5% of statements (7/8)
//     never exercised: describe
//
// which is the question a test run should answer and usually does not: not just
// what passed, but what was never looked at.
