// Multi-file programs
// ===================
// `import <path>` brings another file's declarations into scope, outside any
// proc or func. There are three kinds of path, and the path says which:
//
//     import ./lib/text          a Hive file on this disk (no `.hive` — ever)
//     import ./lib/measures.go   a Go file on this disk (`.go` — always)
//     import https://host/o/r/p  a Hive or Go file in a git repository
//
// The two extensions are opposites on purpose. A Hive module's is never written,
// because the path names a module and the file is only where it lives; a Go
// file's always is, because nothing about `import ./lib/measures` should leave
// you wondering which of the two languages you are about to read.
//
// A module is reached through a name: the file's own name by default, or whatever
// `as` says. The `as` form is there for when two modules would otherwise
// collide, or when the file name isn't usable as a name.
import ./lib/text
import ./lib/inventory as stock

// A Go file, called through the same `.` as any other module. Go exports a name
// by capitalising it and Hive names callables in camelCase, so `Grams` is
// reached as `measures.grams` — while a type keeps its PascalCase
// (`measures.Weight`). Every value crossing the boundary is copied, which is why
// a Go function can be a `func` here at all.
import ./lib/measures.go

// A module from a git repository. The path is a host, an owner and a repository,
// then the path inside it: this one is *this* file, in the repository it lives
// in. The quotes are there because the path has spaces in it — any path can be
// quoted, and one with a space has to be.
//
// The repository is cloned once into a cache under your home directory, and the
// commit it resolved to is written into `modules.hive-lock` beside this file. So
// only the first build needs the network, and a build from the same lock file
// gets the same code — here, and on anybody else's machine. Pin a commit, tag or
// branch yourself by putting it on the repository:
//
//     import "https://github.com/R0DR160HM/hive-lang@0aafed9/code-examples/11 - Modules/lib/text"
import "https://github.com/R0DR160HM/hive-lang/code-examples/11 - Modules/lib/text" as remoteText

// Both this file and lib/text declare an `Align`, and they stay separate types:
// a name only ever means what the module you read it in says it means.
type Align {
	Centre
}

proc main(): void {
	// A type from another module is constructed, annotated and matched through
	// the same name its module is reached by.
	shelf := [
		stock.Item("Beeswax", 450),
		stock.Item("Smoker fuel", 1225),
		stock.Item("Hive tool", 899),
	]

	echo text.repeat("=", 28)
	for each item in shelf {
		echo stock.line(item)
	}
	echo text.repeat("-", 28)
	echo text.pad("total", 16, text.Align.Left()) + text.pad(stock.money(stock.total(shelf)), 12, text.Align.Right())

	// The local `Align` is this file's, not lib/text's.
	mine := Align.Centre()
	if mine is Align.Centre {
		echo "and this file has an Align of its own"
	}

	// A module's declarations are ordinary values, so one can be partially
	// applied or passed along like any other function.
	rule := text.repeat("~", _)
	echo rule(28)

	echo ""
	goExample()

	echo ""
	remoteExample()
}

// Calling Go
// ----------
proc goExample(): void {
	// A Go struct is a Hive type: constructed, annotated and read like any other.
	measures.Weight tool = measures.Weight(899, "Hive tool")
	echo measures.grams(tool)
	echo measures.grams(measures.Weight(1225, "Smoker fuel"))

	// `Heaviest` sorts the slice it is handed, in place. Hive's vector is
	// untouched, because what crossed the boundary was a copy — which is the
	// whole reason a Go function is allowed to be a `func` here.
	mut Str[dyn] labels = ["Beeswax", "Smoker fuel", "Hive tool"]
	echo measures.heaviest(labels, [450, 1225, 899])
	echo labels

	// A Go map arrives as a `hive.map.Map`, its keys in sorted order — a Go map
	// has no order of its own to give.
	echo measures.tally(["Bee", "hive", "bee"])

	// Go reports failure with a second return value, which is what a `Result`
	// means, so that is what this answers with.
	if measures.parse("450 1225 899") is Result.Ok(total) {
		echo "weighed {total} g in total"
	}
	if measures.parse("450 heavy") is Result.Error(why) {
		echo "could not weigh it: {why}"
	}
}

// Importing from a repository
// ---------------------------
proc remoteExample(): void {
	// `remoteText` is the same file as `text`, fetched from the repository rather
	// than read next door — so it is a *different module*, with types of its own.
	echo remoteText.repeat("=", 28)
	echo remoteText.pad("from the repository", 28, remoteText.Align.Right())
	echo remoteText.repeat("=", 28)
}
