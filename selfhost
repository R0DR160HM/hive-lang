#!/usr/bin/env bash
# Compile the compiler with itself, twice, and check the two agree.
#
# This is the test that says a self-hosted compiler works. Stage 1 is whatever
# ./bootstrap built. Stage 2 is stage 1 compiling its own source. Stage 3 is
# stage 2 doing the same. If stage 2 and stage 3 emit byte-identical Go, the
# compiler is a fixpoint of itself — which means the language it accepts and the
# code it writes are the same on both sides, and nothing about whatever compiled
# it first is left in it.
#
# A difference here is a real bug, and a loud one: it says the compiler does not
# understand something it wrote.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
work="${TMPDIR:-/tmp}/hive-selfhost.$$"
trap 'rm -rf "$work"' EXIT

# Where `hive build` left the compiler. Everywhere but Windows that is `hivec`;
# there Go writes the `.exe` that makes a file runnable at all, and this script
# runs from the shell that ships with git, which sees both spellings.
hivec() {
	if [ -x "$1" ]; then echo "$1"; elif [ -x "$1.exe" ]; then echo "$1.exe"; fi
}

stage1="$(hivec "$here/src/hivec")"
if [ -z "$stage1" ]; then
	echo "selfhost: stage 1 has not been built. Run ./bootstrap first." >&2
	exit 1
fi

# Compile the compiler's source with `compiler`, then keep the executable and the
# Go it was built from in $work/stageN. Every stage builds at the one path, since
# an imported Go file's package is named after where it is.
stage() {
	local n="$1" compiler="$2"
	rm -rf "$work/src"
	mkdir -p "$work/stage$n"
	cp -r "$here/src" "$work/"
	rm -f "$work/src/hivec" "$work/src/hivec.exe"
	rm -rf "$work"/src/*-build
	"$compiler" build "$work/src/hivec.hive" >/dev/null
	mv "$work/src/hivec.hive-build/main.go" "$work/stage$n/main.go"
	mv "$(hivec "$work/src/hivec")" "$work/stage$n/"
}

echo "stage 2: the compiler, compiled by stage 1..."
stage 2 "$stage1"

echo "stage 3: the compiler, compiled by stage 2..."
stage 3 "$(hivec "$work/stage2/hivec")"

if diff -q "$work/stage2/main.go" "$work/stage3/main.go" >/dev/null; then
	echo
	echo "  FIXPOINT — stage 2 and stage 3 emit byte-identical Go."
else
	echo
	echo "  DIFFERENT — stage 2 and stage 3 disagree:" >&2
	diff "$work/stage2/main.go" "$work/stage3/main.go" | head -40 >&2
	exit 1
fi
