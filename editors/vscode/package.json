{
  "name": "hive-lang",
  "displayName": "Hive",
  "description": "Hive in VS Code: errors as you type, hover, go to definition and completion, from `hive lsp`.",
  "version": "0.1.0",
  "publisher": "hive-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/R0DR160HM/hive-lang"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "hive",
        "aliases": [
          "Hive"
        ],
        "extensions": [
          ".hive"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Hive",
      "properties": {
        "hive.path": {
          "type": "string",
          "default": "hive",
          "description": "The Hive compiler to start as the language server, when it is not `hive` on the PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
