# Writes every compiled material into one C++ file, as the bytes it is.
string(REPLACE "," ";" NAMES "${NAMES}")
file(WRITE ${OUT_CPP} "#include \"baked.h\"\nnamespace hive { namespace baked {\n")
file(WRITE ${OUT_H} "#pragma once\n#include <cstddef>\nnamespace hive { namespace baked {\n")
foreach(name ${NAMES})
    file(READ ${DIR}/${name}.filamat bytes HEX)
    string(LENGTH "${bytes}" doubled)
    math(EXPR size "${doubled} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," listed "${bytes}")
    string(REGEX REPLACE "(................................................................................)" "\\1\n" listed "${listed}")
    file(APPEND ${OUT_CPP} "extern const unsigned char ${name}[] = {\n${listed}\n};\nextern const size_t ${name}_size = ${size};\n")
    file(APPEND ${OUT_H} "extern const unsigned char ${name}[];\nextern const size_t ${name}_size;\n")
endforeach()
file(APPEND ${OUT_CPP} "}}\n")
file(APPEND ${OUT_H} "}}\n")
