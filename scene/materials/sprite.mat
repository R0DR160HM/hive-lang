// A picture that always faces the viewer, unlit.
material {
    name : sprite,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    culling : none,
    flipUV : false,
    requires : [ uv0 ],
    parameters : [
        { type : sampler2d, name : picture },
        { type : float4, name : tint },
        { type : float4, name : shape },
        { type : float4, name : fog },
        { type : float4, name : haze }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        vec2 corner = getPosition().xy;
        mat4 stood = getWorldFromModelMatrix();
        vec3 right = getWorldFromViewMatrix()[0].xyz;
        vec3 up = getWorldFromViewMatrix()[1].xyz;
        vec3 world = stood[3].xyz + right * (corner.x * materialParams.shape.x)
            + up * ((corner.y - materialParams.shape.z) * materialParams.shape.y);
        material.worldPosition = vec4(world, 1.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 texel = texture(materialParams_picture, getUV0());
        vec4 colour = vec4(texel.rgb * materialParams.tint.rgb, texel.a * materialParams.tint.a);
        if (colour.a < materialParams.shape.w) {
            discard;
        }
        float depth = -mulMat4x4Float3(getViewFromWorldMatrix(), getWorldPosition()).z;
        float veil = materialParams.fog.z * smoothstep(materialParams.fog.x, materialParams.fog.y, depth);
        colour.rgb = mix(colour.rgb, materialParams.haze.rgb, veil);
        material.baseColor = vec4(colour.rgb * colour.a, colour.a);
    }
}
