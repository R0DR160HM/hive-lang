// The finished picture put on the sheet, enlarged unfiltered, dithered when a scene asks.
material {
    name : sheet,
    shadingModel : unlit,
    blending : opaque,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    vertexDomain : device,
    flipUV : false,
    requires : [ uv0 ],
    parameters : [
        { type : sampler2d, name : picture },
        { type : sampler2d, name : weave },
        { type : float4, name : shape },
        { type : float4, name : frame }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 c = texture(materialParams_picture, uvToRenderTargetUV(getUV0())).rgb;
        float steps = materialParams.shape.x;
        if (steps > 0.0) {
            vec2 cell = floor(gl_FragCoord.xy / materialParams.frame.zw * materialParams.frame.xy);
            float d = texture(materialParams_weave, (cell + 0.5) / 4.0).r - 0.5;
            c = floor(c * steps + d + 0.5) / steps;
        }
        c = clamp(c, 0.0, 1.0);
        if (materialParams.shape.y > 0.5) {
            c = c.bgr;
        }
        material.baseColor = vec4(c, 1.0);
    }
}
