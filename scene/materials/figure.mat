// One mesh drawn once for a whole crowd: bones and paints are rows of textures.
material {
    name : figure,
    shadingModel : lit,
    blending : opaque,
    postLightingBlending : transparent,
    instanced : true,
    requires : [ color, custom0, custom1, custom2 ],
    parameters : [
        { type : sampler2d, name : bones, precision : high },
        { type : sampler2d, name : paints, precision : high },
        { type : float4, name : fog },
        { type : float4, name : haze },
        { type : float, name : base }
    ],
    variables : [ paint ]
}

vertex {
    mat4 boneOf(float i, int who) {
        int x = 4 + int(i + 0.5) * 4;
        return mat4(texelFetch(materialParams_bones, ivec2(x, who), 0),
            texelFetch(materialParams_bones, ivec2(x + 1, who), 0),
            texelFetch(materialParams_bones, ivec2(x + 2, who), 0),
            texelFetch(materialParams_bones, ivec2(x + 3, who), 0));
    }

    void materialVertex(inout MaterialVertexInputs material) {
        int who = getInstanceIndex() + int(materialParams.base);
        vec4 joint = getCustom0();
        vec4 weight = getCustom1();
        float part = getCustom2().x;
        mat4 by = weight.x * boneOf(joint.x, who) + weight.y * boneOf(joint.y, who)
            + weight.z * boneOf(joint.z, who) + weight.w * boneOf(joint.w, who);
        vec3 posed = (by * vec4(getPosition().xyz, 1.0)).xyz;
        vec3 facing = (by * vec4(material.worldNormal, 0.0)).xyz;

        vec4 r0 = texelFetch(materialParams_bones, ivec2(0, who), 0);
        vec4 r1 = texelFetch(materialParams_bones, ivec2(1, who), 0);
        vec4 r2 = texelFetch(materialParams_bones, ivec2(2, who), 0);
        vec3 c0 = vec3(r0.x, r1.x, r2.x);
        vec3 c1 = vec3(r0.y, r1.y, r2.y);
        vec3 c2 = vec3(r0.z, r1.z, r2.z);
        vec3 size = max(vec3(dot(c0, c0), dot(c1, c1), dot(c2, c2)), vec3(0.0000000001));
        vec3 world = vec3(dot(r0.xyz, posed) + r0.w, dot(r1.xyz, posed) + r1.w, dot(r2.xyz, posed) + r2.w);
        vec3 inverse = facing / size;
        material.worldNormal = normalize(c0 * inverse.x + c1 * inverse.y + c2 * inverse.z);

        // A see-through part is collapsed to a point, so it casts no shadow either.
        vec4 tint = texelFetch(materialParams_paints, ivec2(int(part + 0.5), who), 0);
        if (tint.a < 0.5) {
            world = vec3(0.0);
        }
        material.worldPosition = getWorldFromModelMatrix() * vec4(world, 1.0);
        material.paint = vec4(tint.rgb * material.color.rgb, tint.a);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float depth = -mulMat4x4Float3(getViewFromWorldMatrix(), getWorldPosition()).z;
        float veil = materialParams.fog.z * smoothstep(materialParams.fog.x, materialParams.fog.y, depth);
        material.postLightingColor = vec4(materialParams.haze.rgb * veil, veil);
        material.baseColor = vec4(variable_paint.rgb, 1.0);
        material.roughness = 0.72;
        material.metallic = 0.0;
    }
}
