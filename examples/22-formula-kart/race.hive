// Ten cars, five teams, one seed
// ==============================
// A kart racer with a Formula One face on it. Pick a team, take the first seat,
// and race the other nine — one of whom is your own second driver and will be
// noticeably easier on you than the other eight.
//
// RUN IT:
//
//   hive run race.hive              a track rolled from the clock
//   hive run race.hive 4821         that track, every time
//
// It opens a real window — an installed Chrome or Edge in app mode, an ordinary
// tab where there is none. three.js was fetched once when this was first compiled
// and lives inside the executable, so it runs with no network and nothing
// installed.
//
// DRIVING. Arrow keys or W A S D. **Space is the drift**, and it is the whole
// game: hold it through a corner and the car steps sideways and harvests; let go
// and it deploys what it harvested. Three levels, and the third is worth going a
// long way round a corner for. `E` spends whatever you picked up. `C` changes the
// camera, `Tab` shows the standings.
//
// **A CONTROLLER WORKS**, and it is worth using: the left stick is a real wheel
// rather than a switch, and the triggers are real pedals. Left stick steers, right
// trigger drives, left trigger brakes, A drifts, B spends, Y is the camera, Back is
// the standings. Press something on it and it will announce itself — a browser does
// not admit a pad exists until it has been used.
//
// WHAT IS IN THE CRATES. Five things, and every one of them is something that
// happens in a real race, because that is the joke this whole example is built on:
// a mushroom is a boost and so is opening your rear wing; a banana is something on
// the road that punctures whoever finds it and so is a piece of somebody's front
// wing; the blue shell is the item that hurts the leader most and so is a safety
// car. Which one you get depends on where you are — the leader gets debris and a
// wing, the car at the back gets the safety car — and that is the one deliberately
// unfair thing here, because a race with an unassailable lead stops being a race.
//
// THE TRACK is rolled from a number and no two are the same. What that means and
// how it is done is `lib/circuit.hive`, which is also where the racing line comes
// from and why the bots know where the apex is.
//
// WHO DOES WHAT
// -------------
//   lib/circuit.hive   the track: rolled, relaxed, measured, and the fast way round
//   lib/grid.hive      five teams, two cars each, and what makes a teammate one
//   lib/drive.hive     what a car is and what one frame does to it
//   lib/pace.hive      how a bot drives — and it can ask for nothing you cannot
//   lib/control.hive   the clock, the flags, the safety car, the timing screen
//
// This file is the window: what the fold does with a key, a pad and a frame, and
// what the picture and the pit board look like. There is no game logic in it. That
// is not tidiness for its own sake — it is what lets `race.test.hive` race a whole
// grand prix with no window, no keyboard and no browser anywhere.

import ./lib/circuit
import ./lib/control
import ./lib/drive
import ./lib/grid
import hive.ui
import hive.math
import hive.conv

// ---------------------------------------------------------------------------
// The state
// ---------------------------------------------------------------------------

type Screen {
	Lobby
	Racing
}

// Where the camera is. Two, and the difference is worth having: the chase camera
// shows you the car's attitude, which is what you need to catch a drift, and the
// cockpit shows you the apex, which is what you need to hit one.
type Seat {
	Chase
	Cockpit
}

// What a pad is currently saying. It is a snapshot rather than a stream of events
// because that is what a stick *is* — `onPad` reports the changes, and holding the
// last value of each control is how a program turns changes back into a position.
type Pad {
	// Which pad this is. The first one to say anything claims the seat and the rest
	// are ignored — and when there are two people in this program, this field is
	// where the second one is told apart from the first.
	which: Int
	// Whether the browser could name its layout. It reports every pad either way,
	// but for one it does not recognise the control names are its best guess at the
	// usual order rather than a promise — so it is worth saying out loud, because
	// it is also the answer to "why is the brake on the wrong pedal".
	named: Bool
	steer: Float
	throttle: Float
	brake: Float
	drifting: Bool
}

func nopad(): Pad {
	return Pad(-1, false, 0.0, 0.0, 0.0, false)
}

type Model {
	screen: Screen
	race: control.Race
	seed: Int
	seat: Int
	// The keys currently held, and the wheel angle they have eased the steering to.
	// A key is on or off and a wheel is not, so the two are not the same thing and
	// the easing is what makes a keyboard drivable at all.
	held: Str[dyn]
	wheel: Float
	pad: Pad
	// The token button, pressed rather than held: set by a key or a pad, and taken
	// away again by the next frame that reads it.
	spend: Bool
	view: Seat
	board: Bool
	// The camera, which follows the car rather than being welded to it. Held here
	// because smoothing needs to remember where it was.
	eyeX: Float
	eyeY: Float
	eyeZ: Float
	eyeYaw: Float
	// The lobby's one field.
	team: Str
}

// The window's mailbox. A key, a pad, a frame and a click all arrive at the same
// fold and are told apart by which variant they are.
type Msg {
	Tick { ms: Int }
	Pressed { key: Str }
	Released { key: Str }
	// Which pad, which control on it, and where that control now is. One shape for
	// the whole device: a button is a control that is only ever nought or one.
	Padded { pad: Int, control: Str, at: Float }
	Chose { team: Str }
	Go
	Again
}

func start(seed: Int): Model {
	return Model(
		Screen.Lobby(),
		control.lined(seed, 0),
		seed,
		0,
		[],
		0.0,
		nopad(),
		false,
		Seat.Chase(),
		false,
		0.0, 0.0, 0.0, 0.0,
		firstTeam()
	)
}

func firstTeam(): Str {
	all := grid.teams()
	if all bounds 0 {
		return all[0].name
	}
	return ""
}

// ---------------------------------------------------------------------------
// The fold
// ---------------------------------------------------------------------------

// There is no mutex in this program. The fold is the mutex.
proc update(model: Model, msg: Msg, from: hive.syslink.Envelope): Model {
	mut Model next = model

	if msg is Msg.Tick(ms) {
		return ticked(model, math.min(0.05, conv.itf(ms) / 1000.0))
	}
	if msg is Msg.Pressed(key) {
		return pressed(model, key)
	}
	if msg is Msg.Released(key) {
		next.held = filter(model.held, notKey(_, key))
		return next
	}
	if msg is Msg.Padded(pad, control, at) {
		return padded(model, pad, control, at)
	}
	if msg is Msg.Chose(team) {
		next.team = team
		return next
	}
	if msg is Msg.Go {
		next.screen = Screen.Racing()
		next.seat = seatOf(model.team)
		next.race = control.lined(model.seed, next.seat)
		return next
	}
	if msg is Msg.Again {
		return start(circuit.hash(model.seed, 7717))
	}
	return next
}

// One frame: the world stepped by what the driver asked for, and the camera moved
// to wherever that put the car.
func ticked(model: Model, dt: Float): Model {
	mut Model next = model
	if model.screen is Screen.Lobby {
		return next
	}
	next.wheel = eased(model, dt)
	next.race = control.stepped(model.race, asking(next), dt)
	// Pressed, not held: the token button is spent by the frame that reads it, so
	// one press is one token however long the finger stays down.
	next.spend = false
	return watched(next, dt)
}

// The wheel, eased toward wherever the keys are pointing it. A pad writes the
// angle directly and this leaves it alone — `asking` below takes whichever of the
// two is actually being used.
func eased(model: Model, dt: Float): Float {
	mut Float want = 0.0
	if down(model, "left") || down(model, "a") {
		want = -1.0
	}
	if down(model, "right") || down(model, "d") {
		want = 1.0
	}
	// Toward the middle faster than away from it, which is what makes a keyboard
	// car catchable: letting go is immediate and turning in is not.
	rate := 5.0
	if want == 0.0 {
		return model.wheel + (want - model.wheel) * math.min(1.0, rate * 2.0 * dt)
	}
	return model.wheel + (want - model.wheel) * math.min(1.0, rate * dt)
}

// What the person at the controls is asking for.
//
// The pad and the keyboard are both read, every frame, and whichever is saying
// more wins. There is no mode and nothing to switch: pick the pad up mid-race and
// it works, put it down and the keys do.
func asking(model: Model): drive.Wants {
	mut Float steer = model.wheel
	if math.abs(model.pad.steer) > math.abs(steer) {
		steer = model.pad.steer
	}
	mut Float throttle = model.pad.throttle
	if down(model, "up") || down(model, "w") {
		throttle = 1.0
	}
	mut Float brake = model.pad.brake
	if down(model, "down") || down(model, "s") {
		brake = 1.0
	}
	drifting := model.pad.drifting || down(model, "space")
	return drive.Wants(steer, throttle, brake, drifting, model.spend)
}

func down(model: Model, key: Str): Bool {
	return indexOf(model.held, key) is Result.Ok(_)
}

func notKey(held: Str, key: Str): Bool {
	return held != key
}

func pressed(model: Model, key: Str): Model {
	mut Model next = model
	if key == "c" {
		next.view = other(model.view)
		return next
	}
	if key == "tab" {
		next.board = model.board == false
		return next
	}
	if key == "e" {
		next.spend = true
		return next
	}
	if down(model, key) == false {
		append(next.held, key)
	}
	return next
}

func other(view: Seat): Seat {
	if view is Seat.Chase {
		return Seat.Cockpit()
	}
	return Seat.Chase()
}

// One control on one pad moved.
//
// The first pad to say anything takes the seat and the rest are ignored. That is
// not a limitation being papered over — it is one line, `model.pad.which`, and it
// is exactly the line a second player would be added at.
func padded(model: Model, pad: Int, control: Str, at: Float): Model {
	mut Model next = model
	if model.pad.which >= 0 && model.pad.which != pad {
		return next
	}
	next.pad.which = pad
	// A pad that has been unplugged lets go of everything on the way out, so there
	// is nothing to tidy up here beyond forgetting which one it was.
	if control == "here" {
		if at < 0.5 {
			next.pad = nopad()
			return next
		}
		// One means the browser knows this pad; two means it is reporting one it
		// could not name.
		next.pad.named = at < 1.5
		return next
	}
	if control == "leftX" {
		next.pad.steer = math.clamp(at, -1.0, 1.0)
		return next
	}
	if control == "rt" {
		next.pad.throttle = math.clamp(at, 0.0, 1.0)
		return next
	}
	if control == "lt" {
		next.pad.brake = math.clamp(at, 0.0, 1.0)
		return next
	}
	if control == "a" {
		next.pad.drifting = at > 0.5
		return next
	}
	// The three that are presses rather than positions. A button reports going down
	// and going up, and only the first of those is a press.
	if at < 0.5 {
		return next
	}
	if control == "b" || control == "rb" {
		next.spend = true
		return next
	}
	if control == "y" {
		next.view = other(model.view)
		return next
	}
	if control == "back" || control == "start" {
		next.board = model.board == false
		return next
	}
	return next
}

func seatOf(team: Str): Int {
	all := grid.teams()
	for i := 0; i < len(all); i++ {
		if all[i].name == team {
			return i * 2
		}
	}
	return 0
}

// ---------------------------------------------------------------------------
// The camera
// ---------------------------------------------------------------------------

// Where the eye ends up. It follows the car rather than being bolted to it, and
// the lag is the point: a camera welded to the car's heading swings through
// ninety degrees in a drift and is unusable, while one that catches up over about
// a fifth of a second shows you the car going sideways, which is the whole thing
// you are trying to see.
func watched(model: Model, dt: Float): Model {
	mut Model next = model
	me := control.find(model.race.cars, model.seat)
	track := model.race.track
	ground := circuit.heightAt(track, circuit.Where(me.node, me.along, me.across))
	// Behind where the car is *pointing*, not where it is going — so a drift shows
	// as the car turned across the screen rather than as the camera swinging round
	// to hide it.
	want := me.yaw
	next.eyeYaw = model.eyeYaw + circuit.wrapped(want - model.eyeYaw)
		* math.min(1.0, 7.0 * dt)

	if model.view is Seat.Cockpit {
		next.eyeX = me.x - math.sin(me.yaw) * 0.25
		next.eyeY = ground + 1.15
		next.eyeZ = me.z - math.cos(me.yaw) * 0.25
		next.eyeYaw = me.yaw
		return next
	}
	// The chase camera pulls back and lifts as the speed comes up, which is the
	// cheapest way there is of making a car feel fast.
	back := 7.4 + me.speed * 0.055
	lift := 2.9 + me.speed * 0.014
	wantX := me.x + math.sin(next.eyeYaw) * back
	wantZ := me.z + math.cos(next.eyeYaw) * back
	catch := math.min(1.0, 9.0 * dt)
	next.eyeX = model.eyeX + (wantX - model.eyeX) * catch
	next.eyeY = model.eyeY + (ground + lift - model.eyeY) * catch
	next.eyeZ = model.eyeZ + (wantZ - model.eyeZ) * catch
	return next
}

func pitchOf(model: Model): Float {
	if model.view is Seat.Cockpit {
		return -0.03
	}
	return -0.145
}

// ---------------------------------------------------------------------------
// The picture
// ---------------------------------------------------------------------------

// A scene is a value, so this is a `func` like any other view — and like any other
// view it cannot act. Sixty of these are built a second and thrown away.
func world(model: Model): ui.Shape[dyn] {
	race := model.race
	track := race.track
	me := control.find(race.cars, model.seat)
	mut ui.Shape[dyn] shapes = []

	// The road, from the node behind the camera to as far ahead as the fog lets
	// anybody see. Drawing the whole lap would be nine hundred boxes for the sake of
	// the eight hundred nobody can see.
	for step := -8; step < 46; step++ {
		for each piece in laid(track, me.node + step) {
			append(shapes, piece)
		}
	}
	for each piece in gantry(track) {
		append(shapes, piece)
	}
	for each piece in lights(track, race) {
		append(shapes, piece)
	}

	for each crate in race.crates {
		if crate.back <= race.clock && near(track, crate.along, me.along) {
			append(shapes, ui.box(
				[
					ui.at(circuit.placeX(track, crate.along, crate.across),
						groundAt(track, crate.along) + 1.0,
						circuit.placeZ(track, crate.along, crate.across)),
					// Spun by the clock, which is what makes it read as a pickup
					// rather than as a box somebody left.
					ui.turn(0.4, race.clock * 1.6, 0.4),
					ui.paint(ui.Tone.HEX("#f2c14e")),
					ui.surface(ui.Surface.Metal())
				],
				0.9, 0.9, 0.9
			))
		}
	}
	for each shard in race.shards {
		if near(track, shard.along, me.along) {
			append(shapes, ui.box(
				[
					ui.at(circuit.placeX(track, shard.along, shard.across),
						groundAt(track, shard.along) + 0.08,
						circuit.placeZ(track, shard.along, shard.across)),
					ui.turn(0.0, conv.itf(shard.by), 0.0),
					ui.paint(ui.Tone.HEX("#2b3037")),
					ui.surface(ui.Surface.Carbon())
				],
				0.8, 0.14, 0.5
			))
		}
	}
	for each wheel in race.wheels {
		if near(track, wheel.along, me.along) {
			append(shapes, ui.cylinder(
				[
					ui.at(circuit.placeX(track, wheel.along, wheel.across),
						groundAt(track, wheel.along) + 0.34,
						circuit.placeZ(track, wheel.along, wheel.across)),
					// Laid on its side, rolling: the axle points across the road.
					ui.turn(0.0, circuit.nodeAlong(track, wheel.along).dir + math.pi(),
						math.pi() / 2.0),
					ui.paint(ui.Tone.HEX("#3a3d42")),
					ui.surface(ui.Surface.Gloss())
				],
				0.34, 0.36
			))
		}
	}

	for each car in race.cars {
		if near(track, car.along, me.along) {
			for each piece in bodywork(track, car, model) {
				append(shapes, piece)
			}
		}
	}
	return shapes
}

// Whether a thing is close enough to the camera to be worth drawing at all.
func near(track: circuit.Circuit, along: Float, mine: Float): Bool {
	off := circuit.nearGap(track, along, mine)
	return off > -40.0 && off < 250.0
}

func groundAt(track: circuit.Circuit, along: Float): Float {
	at := circuit.indexAlong(track, along)
	return circuit.nodeAt(track, at).y
}

// One slice of road: the verge under it, the tarmac, and a kerb on each side where
// the road bends enough to have earned one.
//
// It is boxes rather than the `ground` planes an earlier draft used, and for one
// reason: a plane has no thickness, so two of them at slightly different heights
// on a hill leave a slot you can see the sky through. A box has a bottom, and
// consecutive boxes overlap into each other.
func laid(track: circuit.Circuit, at: Int): ui.Shape[dyn] {
	mut ui.Shape[dyn] shapes = []
	node := circuit.nodeAt(track, at)
	steep := math.abs(node.bend) > 0.006
	// Every colour in this file is a good deal lighter than the thing it stands for.
	// The renderer's lighting is fixed and each surface is painted over the colour in
	// translucent black, so a shade picked to look like tarmac on a swatch comes out
	// as tarmac at midnight. They are chosen against the picture, not the paint chart.
	mut ui.Tone verge = ui.Tone.HEX("#6f9c55")
	mut ui.Surface grain = ui.Surface.Turf()
	if node.trap {
		verge = ui.Tone.HEX("#cbb98e")
		grain = ui.Surface.Gravel()
	}
	// **Every height here is written as "the top of it", minus half its thickness.**
	// A node's `y` is the surface a car drives on, and the tops have to come out in
	// the right order or the ground eats the road: a verge a few centimetres taller
	// than the tarmac is a race run entirely on grass, and it looks exactly like a
	// race run entirely on grass.
	append(shapes, ui.box(
		[
			ui.at(node.x, node.y - 0.15 - 0.70, node.z),
			ui.turn(0.0, node.dir, 0.0),
			ui.paint(verge),
			ui.surface(grain)
		],
		verges() * 2.0, 1.4, along(track, node, verges())
	))
	append(shapes, ui.box(
		[
			ui.at(node.x, node.y - 0.275, node.z),
			ui.turn(0.0, node.dir, 0.0),
			ui.paint(ui.Tone.HEX("#61686f")),
			ui.surface(ui.Surface.Tarmac())
		],
		node.half * 2.0, 0.55, along(track, node, node.half)
	))
	if steep == false {
		return shapes
	}
	for each side in [-1.0, 1.0] {
		off := (node.half + 0.85) * side
		append(shapes, ui.box(
			[
				ui.at(node.x + math.cos(node.dir) * off,
					node.y + 0.06 - 0.16,
					node.z - math.sin(node.dir) * off),
				ui.turn(0.0, node.dir, 0.0),
				ui.paint(ui.Tone.HEX("#d3353d")),
				ui.surface(ui.Surface.Kerb())
			],
			1.7, 0.32, along(track, node, node.half + 1.7)
		))
	}
	// A marker cone every so often on the outside of a corner, which is the one
	// thing that tells you how fast the corner is tightening.
	if at % 6 != 0 {
		return shapes
	}
	mut Float outside = node.half + 3.4
	if node.bend > 0.0 {
		outside = -outside
	}
	append(shapes, ui.cone(
		[
			ui.at(node.x + math.cos(node.dir) * outside,
				node.y + 0.28,
				node.z - math.sin(node.dir) * outside),
			ui.paint(ui.Tone.HEX("#ff5a1f")),
			ui.surface(ui.Surface.Gloss())
		],
		0.04, 0.24, 0.62
	))
	return shapes
}

// How far the grass reaches either side of the middle of the road.
func verges(): Float {
	return 21.0
}

// How long to cut a slab of road `wide` metres across, so that it still meets the
// next one.
//
// **A slab is a rectangle and a corner is not.** Two rectangles laid end to end
// round a bend overlap on the inside of it and leave a wedge between them on the
// outside, and a wedge in the ground is a wedge of sky — which is what a hairpin
// looked like until this function existed. The outer edge of a corner of radius r
// is longer than the middle by (r + w) / r, which is one plus the width times the
// curvature; that is exactly the factor a slab has to grow by. On a straight it
// comes to one and costs nothing.
//
// Overlapping is free: two boxes in the same place are two boxes in the same place,
// and nobody can see the join.
func along(track: circuit.Circuit, node: circuit.Node, wide: Float): Float {
	fan := 1.0 + math.abs(node.bend) * wide
	return circuit.spacing(track) * fan * 1.08
}

// The start line, and the gantry over it.
func gantry(track: circuit.Circuit): ui.Shape[dyn] {
	mut ui.Shape[dyn] shapes = []
	node := circuit.nodeAt(track, 0)
	append(shapes, ui.box(
		[
			ui.at(node.x, node.y + 0.02, node.z),
			ui.turn(0.0, node.dir, 0.0),
			ui.paint(ui.Tone.HEX("#e8ecef")),
			ui.surface(ui.Surface.Gloss())
		],
		node.half * 2.0, 0.05, 1.1
	))
	for each side in [-1.0, 1.0] {
		off := (node.half + 1.6) * side
		append(shapes, ui.cylinder(
			[
				ui.at(node.x + math.cos(node.dir) * off,
					node.y + 3.2,
					node.z - math.sin(node.dir) * off),
				ui.paint(ui.Tone.HEX("#b6c2ce")),
				ui.surface(ui.Surface.Metal())
			],
			0.16, 6.6
		))
	}
	append(shapes, ui.box(
		[
			ui.at(node.x, node.y + 6.3, node.z),
			ui.turn(0.0, node.dir, 0.0),
			ui.paint(ui.Tone.HEX("#b6c2ce")),
			ui.surface(ui.Surface.Metal())
		],
		node.half * 2.0 + 3.2, 0.7, 0.5
	))
	return shapes
}

// Five lights on the gantry, and they go out rather than turning green — which is
// what a Formula One start is and is the only bit of the ceremony that matters.
func lights(track: circuit.Circuit, race: control.Race): ui.Shape[dyn] {
	mut ui.Shape[dyn] shapes = []
	if race.lights <= 0.0 {
		return shapes
	}
	node := circuit.nodeAt(track, 0)
	// One more comes on every fifth of the countdown.
	lit := 5 - conv.floor(race.lights / control.countdown() * 5.0)
	for i := 0; i < 5; i++ {
		off := (conv.itf(i) - 2.0) * 1.5
		mut ui.Tone bulb = ui.Tone.HEX("#2a1416")
		if i < lit {
			bulb = ui.Tone.HEX("#ff2d2d")
		}
		append(shapes, ui.sphere(
			[
				ui.at(node.x + math.cos(node.dir) * off,
					node.y + 5.9,
					node.z - math.sin(node.dir) * off),
				ui.paint(bulb),
				ui.surface(ui.Surface.Gloss())
			],
			0.34
		))
	}
	return shapes
}

// One car. Ten shapes and a name, and every one of them is placed off the car's
// own yaw, so the whole thing turns together.
//
// **The nose and the wheels are the two that need the awkward rotation.** A cone
// and a cylinder both stand on their end, and a nose points forwards while an axle
// points sideways. `along` and `axle` below are the two Euler triples that do it,
// worked out once each rather than in ten places.
func bodywork(track: circuit.Circuit, car: drive.Car, model: Model): ui.Shape[dyn] {
	mut ui.Shape[dyn] shapes = []
	team := grid.teamOf(car.seat)
	one := grid.driverOf(car.seat)
	base := circuit.heightAt(track, circuit.Where(car.node, car.along, car.across))
	yaw := car.yaw
	// The three directions everything on the car is placed along.
	forwardX := -math.sin(yaw)
	forwardZ := -math.cos(yaw)
	rightX := math.cos(yaw)
	rightZ := -math.sin(yaw)

	// The floor: the widest, flattest, blackest thing on the car, and what makes it
	// read as a single-seater rather than as a box on wheels.
	append(shapes, ui.box(
		[
			ui.at(car.x, base + 0.14, car.z),
			ui.turn(0.0, yaw, 0.0),
			ui.paint(ui.Tone.HEX("#2b3037")),
			ui.surface(ui.Surface.Carbon())
		],
		1.55, 0.10, 4.4
	))
	// The body, in the team's colour.
	append(shapes, ui.box(
		[
			ui.at(car.x + forwardX * 0.25, base + 0.40, car.z + forwardZ * 0.25),
			ui.turn(0.0, yaw, 0.0),
			ui.paint(ui.Tone.HEX(team.body)),
			ui.surface(ui.Surface.Gloss())
		],
		0.78, 0.44, 2.7
	))
	// The sidepods.
	for each side in [-1.0, 1.0] {
		append(shapes, ui.box(
			[
				ui.at(car.x + rightX * 0.62 * side - forwardX * 0.35,
					base + 0.34,
					car.z + rightZ * 0.62 * side - forwardZ * 0.35),
				ui.turn(0.0, yaw, 0.0),
				ui.paint(ui.Tone.HEX(team.body)),
				ui.surface(ui.Surface.Gloss())
			],
			0.48, 0.36, 1.7
		))
	}
	// The nose. A cone with a blade rather than a point, which is what one is.
	append(shapes, ui.cone(
		[
			ui.at(car.x + forwardX * 2.1, base + 0.30, car.z + forwardZ * 2.1),
			ui.turn(0.0, yaw - math.pi() / 2.0, math.pi() / 2.0),
			ui.paint(ui.Tone.HEX(team.body)),
			ui.surface(ui.Surface.Gloss())
		],
		0.05, 0.30, 1.5
	))
	// The front wing, and the rear one.
	append(shapes, ui.box(
		[
			ui.at(car.x + forwardX * 2.75, base + 0.11, car.z + forwardZ * 2.75),
			ui.turn(0.0, yaw, 0.0),
			ui.paint(ui.Tone.HEX(team.trim)),
			ui.surface(ui.Surface.Carbon())
		],
		1.85, 0.08, 0.55
	))
	append(shapes, ui.box(
		[
			ui.at(car.x - forwardX * 2.0, base + 0.78, car.z - forwardZ * 2.0),
			// A wing that is open is turned flat, which is what a wing that is open
			// looks like and is the only tell anybody has that somebody has DRS.
			ui.turn(wingTilt(car), yaw, 0.0),
			ui.paint(ui.Tone.HEX(team.trim)),
			ui.surface(ui.Surface.Carbon())
		],
		1.25, 0.30, 0.12
	))
	// The airbox over the driver's head, and the helmet under it.
	append(shapes, ui.cone(
		[
			ui.at(car.x - forwardX * 0.85, base + 0.86, car.z - forwardZ * 0.85),
			ui.paint(ui.Tone.HEX(team.body)),
			ui.surface(ui.Surface.Gloss())
		],
		0.13, 0.24, 0.44
	))
	append(shapes, ui.sphere(
		[
			ui.at(car.x - forwardX * 0.35, base + 0.72, car.z - forwardZ * 0.35),
			ui.paint(ui.Tone.HEX(one.helmet)),
			ui.surface(ui.Surface.Gloss())
		],
		0.21
	))
	// Four wheels, lying on their sides.
	for each side in [-1.0, 1.0] {
		for each end in [-1.0, 1.0] {
			mut Float wide = 0.86
			if end > 0.0 {
				wide = 0.80
			}
			append(shapes, ui.cylinder(
				[
					ui.at(car.x + rightX * wide * side + forwardX * 1.45 * end,
						base + 0.33,
						car.z + rightZ * wide * side + forwardZ * 1.45 * end),
					ui.turn(0.0, yaw + math.pi(), math.pi() / 2.0),
					ui.paint(tyre(car)),
					ui.surface(ui.Surface.Gloss())
				],
				0.33, 0.34
			))
		}
	}
	// What it is doing, if it is doing anything. The plume is translucent, which is
	// the only way a thing behind a car can be seen through and therefore the only
	// way it can be behind a car at all.
	if car.deploy > 0.0 || car.wing > 0.0 {
		append(shapes, ui.box(
			[
				ui.at(car.x - forwardX * 3.4, base + 0.5, car.z - forwardZ * 3.4),
				ui.turn(0.0, yaw, 0.0),
				ui.paint(ui.Tone.RGBA(120, 200, 255, 96)),
				ui.surface(ui.Surface.Gloss())
			],
			1.0, 0.7, 2.4
		))
	}
	if car.spun > 0.0 {
		append(shapes, ui.label(
			[ui.at(car.x, base + 2.3, car.z), ui.paint(ui.Tone.HEX("#ffd166"))],
			"!"
		))
	}
	// The name, but not your own — you know who you are, and a label in the middle
	// of the screen is a label in the way.
	if car.seat != model.seat {
		append(shapes, ui.label(
			[ui.at(car.x, base + 1.7, car.z), ui.paint(ui.Tone.HEX(team.body))],
			"{one.tag}"
		))
	}
	return shapes
}

// How far the rear wing is tipped. Shut it stands up; open it lies down.
func wingTilt(car: drive.Car): Float {
	if car.wing > 0.0 {
		return math.pi() / 2.4
	}
	return 0.0
}

// What colour the tyres are, which is how you tell at a glance that somebody has
// just put a new set on or is running on a flat.
func tyre(car: drive.Car): ui.Tone {
	if car.hurt > 0.0 {
		return ui.Tone.HEX("#7a4a4a")
	}
	if car.fresh > 0.0 {
		return ui.Tone.HEX("#e0343f")
	}
	return ui.Tone.HEX("#3a3d42")
}

// ---------------------------------------------------------------------------
// The window
// ---------------------------------------------------------------------------

func view(model: Model): ui.View {
	if model.screen is Screen.Lobby {
		return ui.column([ui.grow(1)], [lobby(model)])
	}
	return ui.column([ui.height(0), ui.grow(1)], [
		pitboard(model),
		ui.scene(
			[
				ui.grow(1),
				ui.eye(model.eyeX, model.eyeY, model.eyeZ),
				ui.aim(model.eyeYaw, pitchOf(model)),
				ui.lens(lensOf(model)),
				// Far enough to see the corner after next, and not so far that the
				// whole lap is on the screen at once.
				ui.fog(230),
				ui.background(ui.Tone.HEX("#8fb6d6")),
				// The mouse is left alone: nothing here needs it, and a game that takes
				// the pointer is a game you cannot click a button in.
				ui.grab(false),
				ui.crosshair(false),
				ui.onFrame(Msg.Tick(_)),
				ui.onKeyDown(Msg.Pressed(_)),
				ui.onKeyUp(Msg.Released(_)),
				ui.onPad(Msg.Padded(_, _, _))
			],
			world(model)
		),
		strip(model),
		footer(model),
		panel(model)
	])
}

func lensOf(model: Model): Int {
	if model.view is Seat.Cockpit {
		return 82
	}
	return 74
}

// ---------------------------------------------------------------------------
// The lobby
// ---------------------------------------------------------------------------

func lobby(model: Model): ui.View {
	mut Str[dyn] names = []
	for each team in grid.teams() {
		append(names, team.name)
	}
	seat := seatOf(model.team)
	team := grid.teamOf(seat)
	return ui.column([ui.pad(28), ui.gap(16), ui.width(760)], [
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "Formula Kart"),
		ui.text([ui.tone(ui.Tone.Muted())],
			"{model.race.track.name} · {conv.round(model.race.track.length)} metres · {model.race.track.laps} laps · ten cars · seed {model.seed}"),
		ui.text([ui.size(ui.TextSize.Subtitle())], "Pick a garage"),
		ui.select([ui.onChoose(Msg.Chose(_))], names, model.team),
		lineup(seat, team),
		ui.button([ui.on(Msg.Go()), ui.kind(ui.InputKind.Text())],
			"Take the seat"),
		ui.text([ui.size(ui.TextSize.Subtitle())], "Driving it"),
		ui.text([],
			"Arrows or W A S D. SPACE holds a drift — through a corner it harvests, and letting go deploys it. E spends whatever you picked up. C changes the camera, TAB shows the standings."),
		ui.text([ui.tone(ui.Tone.Muted())],
			"A controller works and is better: left stick steers, RT drives, LT brakes, A drifts, B spends, Y is the camera, Back is the standings. Press something on it first — a browser will not admit a pad exists until it has been used, and it only looks while the race is on screen."),
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())],
			"Your second driver will let you past. Nobody else will.")
	])
}

// Who is in the garage you picked, which is the one thing about the choice that
// changes how the race goes.
func lineup(seat: Int, team: grid.Team): ui.View {
	you := grid.driverOf(seat)
	mate := grid.driverOf(grid.partner(seat))
	return ui.row([ui.gap(14), ui.align(ui.Align.Center()), ui.pad(8),
		ui.background(ui.Tone.Muted())], [
		ui.text([ui.background(ui.Tone.HEX(team.body)),
			ui.tone(ui.Tone.HEX("#ffffff")), ui.pad(6)], " {team.tag} "),
		ui.text([], "{you.number} {you.name}"),
		ui.text([ui.tone(ui.Tone.Muted())], "with {mate.number} {mate.name}"),
		ui.spacer(),
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())],
			"car {conv.fts(team.machine)}")
	])
}

// ---------------------------------------------------------------------------
// The pit board
// ---------------------------------------------------------------------------

func pitboard(model: Model): ui.View {
	race := model.race
	me := control.find(race.cars, model.seat)
	place := control.placeOf(race.cars, me) + 1
	return ui.row([ui.pad(9), ui.gap(14), ui.align(ui.Align.Center())], [
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)], "P{place}"),
		ui.text([ui.tone(ui.Tone.Muted())], "of {grid.field()}"),
		ui.text([ui.size(ui.TextSize.Subtitle())],
			"LAP {math.min(conv.itf(me.sheet.lap + 1), conv.itf(race.track.laps))}/{race.track.laps}"),
		ui.text([ui.background(ui.Tone.HEX(grid.bodyOf(model.seat))),
			ui.tone(ui.Tone.HEX("#ffffff")), ui.pad(4)],
			" {grid.driverOf(model.seat).tag} "),
		ui.spacer(),
		harvest(me),
		token(me, race),
		ui.spacer(),
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], "GAP"),
		ui.text([], control.gapped(control.interval(race, model.seat))),
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], "LAST"),
		ui.text([], control.clocked(me.sheet.last)),
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())], "BEST"),
		ui.text([ui.tone(ui.Tone.Good())], control.clocked(me.sheet.best)),
		penalties(me)
	])
}

// The energy, and it is the one gauge on the board worth watching: eight cells,
// with the three level marks lit as they are reached. Drifting fills it and letting
// go spends it.
func harvest(me: drive.Car): ui.View {
	mut ui.View[dyn] cells = []
	for i := 0; i < 8; i++ {
		full := me.harvest / drive.harvestCap() * 8.0
		mut ui.Tone shade = ui.Tone.HEX("#22272d")
		if conv.itf(i) < full {
			shade = ui.Tone.HEX("#2fbf71")
			if me.harvest >= drive.harvestFor(3) {
				shade = ui.Tone.HEX("#c86bff")
			} else if me.harvest >= drive.harvestFor(2) {
				shade = ui.Tone.HEX("#f0b429")
			}
		}
		append(cells, ui.text([ui.width(9), ui.height(14), ui.background(shade)], " "))
	}
	return ui.row([ui.gap(8), ui.align(ui.Align.Center())], [
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())],
			deploying(me)),
		ui.row([ui.gap(2), ui.align(ui.Align.Center())], cells)
	])
}

func deploying(me: drive.Car): Str {
	if me.deploy > 0.0 {
		return "DEPLOY"
	}
	if me.wing > 0.0 {
		return "DRS"
	}
	return "ERS"
}

// What is in the car, and whether pressing the button would do anything with it.
func token(me: drive.Car, race: control.Race): ui.View {
	if me.holding is drive.Token.Nothing {
		return ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())],
			"no parts")
	}
	mut ui.Tone shade = ui.Tone.Good()
	if usable(me, race) == false {
		shade = ui.Tone.Muted()
	}
	return ui.text(
		[ui.background(shade), ui.tone(ui.Tone.HEX("#0d1013")), ui.pad(4)],
		" {drive.tokenName(me.holding)} · E "
	)
}

// Whether the token in the car can be spent where it is standing. The wing only
// opens on a straight and the safety car cannot be called twice in a row, and
// greying the label is cheaper than letting somebody press it and wonder.
func usable(me: drive.Car, race: control.Race): Bool {
	if me.holding is drive.Token.Wing {
		return math.abs(circuit.nodeAt(race.track, me.node).bend) <= drive.wingStraight()
	}
	if me.holding is drive.Token.Safety {
		return race.clock >= race.safetyAgain && race.safety <= 0.0
	}
	return true
}

func penalties(me: drive.Car): ui.View {
	if me.sheet.penalty <= 0.0 && me.sheet.warnings == 0 {
		return ui.none()
	}
	if me.sheet.penalty <= 0.0 {
		return ui.text([ui.tone(ui.Tone.Warn()), ui.size(ui.TextSize.Caption())],
			"LIMITS {me.sheet.warnings}/{drive.allowed()}")
	}
	return ui.text([ui.tone(ui.Tone.Danger())],
		"+{conv.round(me.sheet.penalty)}s")
}

// ---------------------------------------------------------------------------
// The strip along the bottom
// ---------------------------------------------------------------------------

func strip(model: Model): ui.View {
	mut ui.View[dyn] rows = []
	for each note in model.race.notes {
		append(rows, ui.text([ui.tone(colourOf(note.kind)),
			ui.size(ui.TextSize.Caption())], note.text))
	}
	return ui.column([
		ui.height(96),
		ui.pad(6),
		ui.gap(1),
		ui.justify(ui.Justify.End()),
		ui.background(ui.Tone.Muted())
	], rows)
}

func colourOf(kind: control.Kind): ui.Tone {
	if kind is control.Kind.Info { return ui.Tone.Normal() }
	else if kind is control.Kind.Warn { return ui.Tone.Warn() }
	else if kind is control.Kind.Good { return ui.Tone.Good() }
	else if kind is control.Kind.Fast { return ui.Tone.HEX("#c86bff") }
}

func footer(model: Model): ui.View {
	return ui.row([ui.pad(7), ui.gap(12), ui.align(ui.Align.Center())], [
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())],
			"W A S D or arrows · SPACE drifts · E spends · C camera · TAB standings"),
		ui.spacer(),
		flag(model.race),
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())],
			padline(model))
	])
}

// What the footer says about the controller. It is a diagnostic as much as a
// label: "no pad" and "pad 0, layout unknown" want two different things done
// about them, and neither of them is obvious from a car that will not steer.
func padline(model: Model): Str {
	if model.pad.which < 0 {
		return "no pad — press something on it"
	}
	if model.pad.named == false {
		return "pad {model.pad.which} · layout unknown"
	}
	return "pad {model.pad.which}"
}

// What flag is out, which is the one thing on the screen that has to be seen
// without being looked for.
func flag(race: control.Race): ui.View {
	if race.safety > 0.0 {
		return ui.text([ui.background(ui.Tone.Warn()),
			ui.tone(ui.Tone.HEX("#0d1013")), ui.pad(4)], " SAFETY CAR ")
	}
	mut Str sectors = ""
	for i := 0; i < 3; i++ {
		if control.slotOf(race.yellow, i) > 0.0 {
			sectors = sectors + " S{i + 1}"
		}
	}
	if sectors == "" {
		return ui.none()
	}
	return ui.text([ui.background(ui.Tone.HEX("#f0b429")),
		ui.tone(ui.Tone.HEX("#0d1013")), ui.pad(4)], " YELLOW{sectors} ")
}

// ---------------------------------------------------------------------------
// Whatever is in front of the race
// ---------------------------------------------------------------------------

func panel(model: Model): ui.View {
	if model.race.over {
		return ui.overlay([ui.pad(24)], classification(model))
	}
	if model.race.lights > 0.0 {
		return ui.overlay([ui.pad(24)], grid5(model))
	}
	if model.board {
		return ui.overlay([ui.pad(24)], standings(model, false))
	}
	return ui.none()
}

func grid5(model: Model): ui.View {
	lit := 5 - conv.floor(model.race.lights / control.countdown() * 5.0)
	mut ui.View[dyn] bulbs = []
	for i := 0; i < 5; i++ {
		mut ui.Tone shade = ui.Tone.HEX("#2a1416")
		if i < lit {
			shade = ui.Tone.HEX("#ff2d2d")
		}
		append(bulbs, ui.text([ui.width(34), ui.height(34), ui.background(shade)], " "))
	}
	return ui.column([ui.gap(12), ui.align(ui.Align.Center()), ui.pad(18)], [
		ui.text([ui.size(ui.TextSize.Title())], model.race.track.name),
		ui.row([ui.gap(8)], bulbs),
		ui.text([ui.tone(ui.Tone.Muted())],
			"{grid.field()} cars · {model.race.track.laps} laps · lights out when they all go out")
	])
}

func standings(model: Model, final: Bool): ui.View {
	mut Str[dyn][dyn] rows = []
	append(rows, ["", "", "DRIVER", "TEAM", "GAP", "BEST"])
	mut Int place = 1
	for each seat in control.order(model.race) {
		car := control.find(model.race.cars, seat)
		one := grid.driverOf(seat)
		append(rows, [
			"{place}",
			"{one.number}",
			one.name,
			grid.teamOf(seat).tag,
			standingGap(model, car, place, final),
			control.clocked(car.sheet.best)
		])
		place = place + 1
	}
	return ui.column([ui.gap(10), ui.pad(16)], [
		ui.text([ui.size(ui.TextSize.Subtitle()), ui.heading(2)], headline(model, final)),
		ui.table([], rows)
	])
}

func headline(model: Model, final: Bool): Str {
	if final {
		return "{model.race.track.name} — classification"
	}
	me := control.find(model.race.cars, model.seat)
	on := math.min(conv.itf(me.sheet.lap + 1), conv.itf(model.race.track.laps))
	return "{model.race.track.name} — lap {on} of {model.race.track.laps}"
}

func standingGap(model: Model, car: drive.Car, place: Int, final: Bool): Str {
	if place == 1 {
		if car.sheet.finished {
			return control.clocked(car.sheet.finishedAt)
		}
		return "leader"
	}
	if car.sheet.finished {
		leader := control.find(model.race.cars,
			control.roundSeat(control.order(model.race), 0))
		return control.gapped(car.sheet.finishedAt - leader.sheet.finishedAt)
	}
	return control.gapped(control.interval(model.race, car.seat))
}

func classification(model: Model): ui.View {
	me := control.find(model.race.cars, model.seat)
	place := control.placeOf(model.race.cars, me) + 1
	return ui.column([ui.gap(12), ui.pad(16)], [
		ui.text([ui.size(ui.TextSize.Title()), ui.heading(1)],
			"You finished P{place}"),
		standings(model, true),
		ui.row([ui.gap(10)], [
			ui.button([ui.on(Msg.Again())], "Another circuit")
		])
	])
}

// ---------------------------------------------------------------------------

proc main(): void {
	args := hive.term.args()
	mut Int seed = hive.time.now() % 100000
	if args bounds 0 {
		if hive.conv.sti(args[0]) is Result.Ok(asked) {
			seed = asked
		}
	}
	// Opens a real application window. The window *is* a service — `update` is
	// checked as a `hive.syslink.spawn` handler and gets an address like one.
	ui.window("Formula Kart", view, update, start(seed))
}
