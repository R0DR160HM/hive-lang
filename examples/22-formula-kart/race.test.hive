// The race, with no window in it
// ==============================
// A grand prix is a picture, a keyboard and a browser, and none of those is here.
// What is here is everything else — the track, the line round it, the physics, the
// bots, the flags and the clock — because all of it is a `func` of a value and none
// of it ever knew there was a screen.
//
//   hive test race.test.hive
//
// The suite is in the order the program is: the circuit first, because everything
// stands on it; then a car on its own; then a bot; then the two rules about
// teammates, which are the ones worth being sure of; then a whole race.
//
// **Two of these tests exist because of bugs that got as far as the picture.** The
// one about a token being spent once and the one about the flag actually falling
// are both cases where a function wrote to a field that the caller then overwrote,
// and both were silent: the race simply never ended, and a bot laid a carpet of
// debris down the racing line at sixty pieces a second. They are here so that they
// stay fixed.

import ./lib/circuit
import ./lib/control
import ./lib/drive
import ./lib/grid
import ./lib/pace
import ./lib/scenery
import ./lib/wire
import hive.math
import hive.conv

// ---------------------------------------------------------------------------
// Standing a car somewhere on purpose
// ---------------------------------------------------------------------------

// A car put exactly where the test wants it, pointing along the road. Everything
// below that is about two cars near each other needs this, and doing it by driving
// one there would be a test of the driving rather than of the thing being tested.
func put(
	track: circuit.Circuit,
	seat: Int,
	along: Float,
	across: Float,
	speed: Float
): drive.Car {
	mut drive.Car car = drive.parked(track, seat)
	car.along = circuit.wrappedAlong(track, along)
	car.across = across
	car.x = circuit.placeX(track, car.along, across)
	car.z = circuit.placeZ(track, car.along, across)
	car.node = circuit.indexAlong(track, car.along)
	car.yaw = circuit.nodeAlong(track, car.along).dir
	car.speed = speed
	return car
}

// Nobody at any wheel: ten bots and no people, which is what a race steps as when
// this suite is not being one of the people.
func nobody(): control.Asking[dyn] {
	mut control.Asking[dyn] none = []
	return none
}

// A car driven by the bot for a while, on an empty track.
func lapped(track: circuit.Circuit, seat: Int, seconds: Float): drive.Car {
	mut drive.Car car = drive.parked(track, seat)
	steps := conv.round(seconds * 60.0)
	for frame := 0; frame < steps; frame++ {
		want := pace.driving(track, [car], [], [], drive.garaged(), seat, 0.0, false, true,
			conv.itf(frame) / 60.0)
		car = drive.stepped(track, car, want, grid.teamOf(seat).machine,
			1.0 / 60.0)
	}
	return car
}

// ---------------------------------------------------------------------------
// The circuit
// ---------------------------------------------------------------------------

test "the same seed rolls the same circuit" {
	one := circuit.build(4821)
	two := circuit.build(4821)
	assert one.name == two.name
	assert one.length == two.length
	assert one.nodes == two.nodes
}

test "different seeds roll different circuits" {
	assert circuit.build(1).length != circuit.build(2).length
}

test "a lap is a lap of somewhere you could drive" {
	for each seed in [1, 77, 4821, 90210] {
		track := circuit.build(seed)
		assert len(track.nodes) == circuit.nodes()
		assert track.length > 900.0
		assert track.length < 2200.0
	}
}

// The one property everything downstream leans on: `nodeAlong` finds a node by
// dividing, which is only true if the nodes really are evenly spaced.
test "every node is the same distance from the next" {
	track := circuit.build(4821)
	want := circuit.spacing(track)
	for i := 0; i < len(track.nodes); i++ {
		here := circuit.nodeAt(track, i)
		on := circuit.nodeAt(track, i + 1)
		assert math.abs(math.hypot(on.x - here.x, on.z - here.z) - want) < 0.05
	}
}

test "the track does not cross itself" {
	for each seed in [1, 77, 4821, 90210] {
		track := circuit.build(seed)
		count := len(track.nodes)
		for i := 0; i < count; i++ {
			here := circuit.nodeAt(track, i)
			// Anything more than a few nodes away has to stay more than a road's width
			// off, or the two stretches of it are the same piece of ground.
			for step := 8; step < count / 2; step++ {
				there := circuit.nodeAt(track, i + step)
				assert math.hypot(there.x - here.x, there.z - here.z) > here.half * 2.4
			}
		}
	}
}

test "no corner is tighter than a car can get round" {
	for each seed in [1, 77, 4821, 90210] {
		for each node in circuit.build(seed).nodes {
			if math.abs(node.bend) > 0.0001 {
				assert 1.0 / math.abs(node.bend) > 10.0
			}
		}
	}
}

test "the road's terms and the world's are the same place" {
	track := circuit.build(4821)
	for step := 0; step < 60; step++ {
		along := track.length * conv.itf(step) / 60.0
		for each across in [-5.0, 0.0, 5.0] {
			x := circuit.placeX(track, along, across)
			z := circuit.placeZ(track, along, across)
			back := circuit.locate(track, x, z, -1)
			// Across has to be right to the centimetre, because it is what track
			// limits are decided on. Along is allowed a node either way: the nearest
			// point on the centreline to somewhere on the inside of a hairpin really
			// is a little further round than the cross-section it was built from.
			assert math.abs(back.across - across) < 0.4
			assert math.abs(circuit.nearGap(track, back.along, along))
				< circuit.spacing(track) * 1.1
		}
	}
}

test "the fast way round stays on the road" {
	for each seed in [1, 4821] {
		for each node in circuit.build(seed).nodes {
			assert math.abs(node.line) <= node.half - 1.8
		}
	}
}

// The racing line is not the middle of the road. If it were, the relaxation in
// `fastest` would have done nothing and nobody would notice.
test "the fast way round uses the width of the road" {
	mut Float widest = 0.0
	for each node in circuit.build(4821).nodes {
		widest = math.max(widest, math.abs(node.line))
	}
	assert widest > 4.0
}

// The whole point of the backward pass in `pacing`.
test "the pace at a node lets you slow down for the one after it" {
	track := circuit.build(4821)
	for i := 0; i < len(track.nodes); i++ {
		here := circuit.nodeAt(track, i)
		on := circuit.nodeAt(track, i + 1)
		// The distance along the *racing line*, which is what the profile was worked
		// out over and is not the spacing of the nodes: the line cuts the inside of a
		// corner and runs long round the outside of one.
		hereAt := circuit.across(circuit.Spot(here.x, here.z), here.dir, here.line)
		onAt := circuit.across(circuit.Spot(on.x, on.z), on.dir, on.line)
		run := math.hypot(onAt.x - hereAt.x, onAt.z - hereAt.z)
		reachable := math.sqrt(on.pace * on.pace + 2.0 * circuit.braking() * run)
		assert here.pace <= reachable + 0.01
	}
}

test "a corner is slower than a straight" {
	track := circuit.build(4821)
	// The tightest corner against the quickest point anywhere, rather than corners
	// against straights. Two reasons: the *slowest* straight is a braking zone, so
	// comparing with that would be asserting that braking does not happen; and
	// whether a given circuit has a node straight enough to count is a fact about
	// the seed, so a test written that way passes or fails on which one it was given.
	mut Float quickest = 0.0
	mut Float sharpest = 0.0
	mut Float atTheApex = 0.0
	for each node in track.nodes {
		quickest = math.max(quickest, node.pace)
		if math.abs(node.bend) > sharpest {
			sharpest = math.abs(node.bend)
			atTheApex = node.pace
		}
	}
	// Somewhere on the lap is flat out, and the tightest corner is nothing like it.
	assert quickest > 60.0
	assert atTheApex < quickest * 0.6
}

test "what is under the wheels changes as you go off" {
	track := circuit.build(4821)
	half := circuit.nodeAt(track, 40).half
	assert circuit.under(track, circuit.Where(40, 0.0, 0.0)) is circuit.Ground.Tarmac
	assert circuit.under(track, circuit.Where(40, 0.0, half + 0.5))
		is circuit.Ground.Kerb
	assert circuit.hold(circuit.Ground.Tarmac()) > circuit.hold(circuit.Ground.Kerb())
	assert circuit.hold(circuit.Ground.Grass()) > circuit.hold(circuit.Ground.Gravel())
	assert circuit.drag(circuit.Ground.Tarmac()) == 0.0
}

test "the white line is still the track and a car's width past it is not" {
	track := circuit.build(4821)
	half := circuit.nodeAt(track, 40).half
	assert circuit.exceeded(track, circuit.Where(40, 0.0, half)) == false
	assert circuit.exceeded(track, circuit.Where(40, 0.0, half + 3.0))
}

test "a lap is three sectors and they are in order" {
	track := circuit.build(4821)
	assert circuit.sector(track, 0.0) == 1
	assert circuit.sector(track, track.length * 0.5) == 2
	assert circuit.sector(track, track.length * 0.9) == 3
	assert circuit.sector(track, track.length - 0.001) == 3
	assert circuit.sectorStart(track, 1) == 0.0
}

// ---------------------------------------------------------------------------
// The grid
// ---------------------------------------------------------------------------

test "the field is counted rather than written down" {
	assert grid.field() == len(grid.teams()) * 2
	assert grid.field() == 10
}

test "a garage holds two cars and they are each other's partner" {
	for seat := 0; seat < grid.field(); seat++ {
		mate := grid.partner(seat)
		assert mate != seat
		assert grid.partner(mate) == seat
		assert grid.garage(mate) == grid.garage(seat)
		assert grid.teammates(seat, mate)
	}
}

test "nobody is their own teammate and nobody is in two garages" {
	assert grid.teammates(0, 0) == false
	assert grid.teammates(0, 1)
	assert grid.teammates(0, 2) == false
	assert grid.teammates(8, 9)
}

test "every seat has a driver and a livery" {
	for seat := 0; seat < grid.field(); seat++ {
		assert len(grid.driverOf(seat).tag) == 3
		assert grid.driverOf(seat).number > 0
		assert len(grid.bodyOf(seat)) == 7
		assert len(grid.helmetOf(seat)) == 7
	}
}

test "no two drivers share a number" {
	for one := 0; one < grid.field(); one++ {
		for two := 0; two < grid.field(); two++ {
			if one != two {
				assert grid.driverOf(one).number != grid.driverOf(two).number
			}
		}
	}
}

// ---------------------------------------------------------------------------
// One car
// ---------------------------------------------------------------------------

test "the throttle makes it go and the brake makes it stop" {
	track := circuit.build(4821)
	mut drive.Car car = drive.parked(track, 0)
	// Two seconds and no steering, which is short enough that the road has not gone
	// anywhere the car has not. Three seconds of it puts the car on the grass, which
	// is a fair test of the grass and a poor one of the throttle.
	for frame := 0; frame < 120; frame++ {
		car = drive.stepped(track, car, drive.Wants(0.0, 1.0, 0.0, false, false),
			1.0, 1.0 / 60.0)
	}
	assert car.speed > 25.0
	rolling := car.speed
	for frame := 0; frame < 40; frame++ {
		car = drive.stepped(track, car, drive.Wants(0.0, 0.0, 1.0, false, false),
			1.0, 1.0 / 60.0)
	}
	assert car.speed < rolling - 10.0
}

test "grass is slower than tarmac" {
	track := circuit.build(4821)
	mut drive.Car onRoad = put(track, 0, 200.0, 0.0, 30.0)
	mut drive.Car offRoad = put(track, 0, 200.0,
		circuit.nodeAt(track, circuit.indexAlong(track, 200.0)).half + 4.0, 30.0)
	for frame := 0; frame < 60; frame++ {
		onRoad = drive.stepped(track, onRoad,
			drive.Wants(0.0, 1.0, 0.0, false, false), 1.0, 1.0 / 60.0)
		offRoad = drive.stepped(track, offRoad,
			drive.Wants(0.0, 1.0, 0.0, false, false), 1.0, 1.0 / 60.0)
	}
	assert offRoad.speed < onRoad.speed
}

test "holding a drift harvests, and letting go deploys it" {
	track := circuit.build(4821)
	// Started against the left of the road and drifting right, for a second.
	//
	// **A drift now has to fit on the circuit.** This used to hold full lock for two
	// seconds from the middle of the road, which put the car twenty-five metres
	// wide of it — and passed, because until the barrier was something a car could
	// hit there was nothing out there to stop it. A drift crosses fourteen metres
	// of road in about a second, so a second is what there is.
	mut drive.Car car = put(track, 0, 300.0, -5.0, 35.0)
	held := drive.Wants(1.0, 1.0, 0.0, true, false)
	for frame := 0; frame < 60; frame++ {
		car = drive.stepped(track, car, held, 1.0, 1.0 / 60.0)
	}
	assert car.knock == 0.0
	assert car.drift == 1.0
	assert car.harvest > drive.harvestFor(1)
	assert math.abs(car.slide) > 0.1
	// And now let go.
	after := drive.stepped(track, car, drive.Wants(1.0, 1.0, 0.0, false, false),
		1.0, 1.0 / 60.0)
	assert after.drift == 0.0
	assert after.harvest == 0.0
	assert after.deploy > 0.0
	assert after.push > 1.0
}

test "a flick of the drift button is worth nothing" {
	track := circuit.build(4821)
	mut drive.Car car = put(track, 0, 300.0, 0.0, 35.0)
	for frame := 0; frame < 12; frame++ {
		car = drive.stepped(track, car, drive.Wants(1.0, 1.0, 0.0, true, false),
			1.0, 1.0 / 60.0)
	}
	after := drive.stepped(track, car, drive.Wants(1.0, 1.0, 0.0, false, false),
		1.0, 1.0 / 60.0)
	assert drive.levelOf(car.harvest) == 0
	assert after.deploy == 0.0
}

// The claim the steering model is built on, and it is a claim about a *ratio*.
// At a crawl a tenth of lock buys about a tenth of what the car can corner; at
// two hundred an hour the same tenth buys a third of it. That is what makes a
// fast car feel alive, and a model where full lock is always exactly the limit —
// which this one had first — has none of it.
test "the wheel is more use the faster you are going" {
	assert drive.demand(70.0) > drive.demand(10.0) * 1.9
	// Full lock always asks for more than the tyres hold, at every speed, so there
	// is always something to get wrong.
	for each v in [10.0, 25.0, 45.0, 70.0] {
		limit := drive.holdable(v, 1.0)
		assert limit * drive.demand(v) > limit
		// And the same tenth of lock is a larger share of the limit the faster it is.
		assert 0.1 * drive.demand(v) < 1.0
	}
	assert 0.1 * drive.demand(70.0) > 0.1 * drive.demand(10.0) * 1.9
}

test "asking for more cornering than there is costs speed" {
	track := circuit.build(4821)
	// Two identical cars on the same piece of road, one turning in gently and one
	// on full lock. A third of a second is short enough that neither has had time
	// to reach different ground, so the only difference between them is the wheel.
	mut drive.Car gentle = put(track, 0, 200.0, 0.0, 60.0)
	mut drive.Car heavy = put(track, 0, 200.0, 0.0, 60.0)
	for frame := 0; frame < 20; frame++ {
		gentle = drive.stepped(track, gentle,
			drive.Wants(0.12, 1.0, 0.0, false, false), 1.0, 1.0 / 60.0)
		heavy = drive.stepped(track, heavy,
			drive.Wants(1.0, 1.0, 0.0, false, false), 1.0, 1.0 / 60.0)
	}
	assert drive.pushing(gentle, drive.Wants(0.12, 0.0, 0.0, false, false), 1.0) == 0.0
	assert drive.pushing(heavy, drive.Wants(1.0, 0.0, 0.0, false, false), 1.0) > 0.5
	assert heavy.speed < gentle.speed - 3.0
}

test "the wheel a bot asks for is the rate it wanted" {
	// `lockFor` is the exact inverse of what the car does with an input, and the
	// two being one function is what stops a bot and a car drifting apart.
	for each v in [12.0, 30.0, 55.0] {
		limit := drive.holdable(v, 1.0)
		wanted := limit * 0.6
		wheel := drive.lockFor(wanted, v, 1.0)
		assert math.abs(wheel * limit * drive.demand(v) - wanted) < 0.001
		// And a bot asking for six tenths of the limit is nowhere near full lock.
		assert wheel < 0.6
	}
	// More than the tyres hold cannot be asked for: the wheel stops at the stop.
	assert drive.lockFor(1000.0, 40.0, 1.0) == 1.0
}

test "one excursion is one warning, however long it lasts" {
	track := circuit.build(4821)
	half := circuit.nodeAt(track, circuit.indexAlong(track, 400.0)).half
	mut drive.Car car = put(track, 0, 400.0, half + 5.0, 8.0)
	for frame := 0; frame < 60; frame++ {
		car = drive.stepped(track, car, drive.Wants(0.0, 0.2, 0.0, false, false),
			1.0, 1.0 / 60.0)
	}
	assert car.sheet.warnings == 1
	assert car.adrift
}

test "a car nobody is steering is not running wide" {
	// The same excursion three times over: once driven into, once on a tyre
	// somebody else's debris let the air out of, and once mid-spin. Only the first
	// is the driver's, and only the first is written down.
	track := circuit.build(4821)
	half := circuit.nodeAt(track, circuit.indexAlong(track, 400.0)).half
	flat := drive.Wants(0.0, 0.2, 0.0, false, false)

	mut drive.Car own = put(track, 0, 400.0, half + 5.0, 8.0)
	own = drive.stepped(track, own, flat, 1.0, 1.0 / 60.0)
	assert own.sheet.warnings == 1

	mut drive.Car flat2 = drive.punctured(put(track, 0, 400.0, half + 5.0, 8.0))
	assert drive.passenger(flat2)
	flat2 = drive.stepped(track, flat2, flat, 1.0, 1.0 / 60.0)
	assert flat2.sheet.warnings == 0

	mut drive.Car spun = drive.spinning(put(track, 0, 400.0, half + 5.0, 8.0))
	spun = drive.stepped(track, spun, flat, 1.0, 1.0 / 60.0)
	assert spun.sheet.warnings == 0
	// And it is still off the road when the spin ends, which is the frame the bug
	// was in: `adrift` is kept true throughout, so nothing reads the car coming back
	// under control as a driver putting it on the grass. Two seconds of spinning,
	// then the throttle, and nothing on the sheet.
	for frame := 0; frame < 120; frame++ {
		assert spun.adrift
		spun = drive.stepped(track, spun, flat, 1.0, 1.0 / 60.0)
	}
	assert spun.spun <= 0.0
	assert spun.sheet.warnings == 0
	// The forgiveness ends with the puncture, though — it is two and a half seconds
	// of tyre, not an afternoon off. Back on the road, then off it again, and that
	// one is the driver's.
	mut drive.Car after = put(track, 0, 400.0, 0.0, 8.0)
	after = drive.punctured(after)
	for frame := 0; frame < 60 * 4; frame++ {
		after = drive.stepped(track, after, flat, 1.0, 1.0 / 60.0)
	}
	assert drive.passenger(after) == false
	after = drive.nudged(track, after, half + 5.0)
	after = drive.stepped(track, after, flat, 1.0, 1.0 / 60.0)
	assert after.sheet.warnings == 1
}

test "three warnings is five seconds" {
	track := circuit.build(4821)
	half := circuit.nodeAt(track, circuit.indexAlong(track, 400.0)).half
	// Three separate excursions, which is what three warnings means — a car that
	// stays off gets one, and that is the test above. The sheet is carried from one
	// to the next because it is the only thing that is supposed to survive them.
	mut drive.Sheet sheet = drive.freshSheet()
	for round := 0; round < 3; round++ {
		mut drive.Car car = put(track, 0, 400.0, half + 6.0, 4.0)
		car.sheet = sheet
		car = drive.stepped(track, car, drive.idle(), 1.0, 1.0 / 60.0)
		sheet = car.sheet
	}
	assert sheet.penalty == drive.added()
	assert sheet.warnings == 0
}

test "a puncture costs grip, and new tyres are immune to one" {
	track := circuit.build(4821)
	car := put(track, 0, 200.0, 0.0, 40.0)
	hurt := drive.punctured(car)
	assert hurt.hurt > 0.0
	assert hurt.speed < car.speed
	mut drive.Car fresh = car
	fresh.fresh = drive.softsFor()
	assert drive.punctured(fresh).hurt == 0.0
}

test "a car already spinning cannot be spun harder" {
	track := circuit.build(4821)
	spun := drive.spinning(put(track, 0, 200.0, 0.0, 40.0))
	again := drive.spinning(spun)
	assert again.spun == spun.spun
	assert again.speed == spun.speed
}

test "the leader never draws the safety car and the back marker can" {
	mut Bool leaderGotOne = false
	mut Bool backGotOne = false
	for salt := 0; salt < 400; salt++ {
		if drive.rolled(0, 10, 4821, salt, true) is drive.Token.Safety {
			leaderGotOne = true
		}
		if drive.rolled(9, 10, 4821, salt, true) is drive.Token.Safety {
			backGotOne = true
		}
	}
	assert leaderGotOne == false
	assert backGotOne
}

test "nobody draws a safety car that cannot be called" {
	for salt := 0; salt < 400; salt++ {
		assert (drive.rolled(9, 10, 4821, salt, false) is drive.Token.Safety) == false
	}
}

test "the crates are laid out across the road and off the start line" {
	track := circuit.build(4821)
	crates := drive.crates(track)
	assert len(crates) == 21
	for each crate in crates {
		assert math.abs(crate.across) < circuit.nodeAt(track, 0).half
		assert circuit.gap(track, crate.along, 0.0) > 20.0
	}
}

test "the ground under a car follows the hill rather than stepping up it" {
	track := circuit.build(4821)
	mut Float worst = 0.0
	for step := 0; step < 400; step++ {
		along := track.length * conv.itf(step) / 400.0
		here := circuit.heightAt(track, circuit.locate(track,
			circuit.placeX(track, along, 0.0),
			circuit.placeZ(track, along, 0.0), -1))
		on := circuit.heightAt(track, circuit.locate(track,
			circuit.placeX(track, along + 2.0, 0.0),
			circuit.placeZ(track, along + 2.0, 0.0), -1))
		worst = math.max(worst, math.abs(on - here))
	}
	// Two metres of road never climbs more than a few centimetres, which is what
	// makes it a hill rather than a staircase.
	assert worst < 0.3
}

test "a token says what it is and what it is worth" {
	assert drive.tokenName(drive.Token.Nothing()) == "—"
	assert drive.tokenName(drive.Token.Wing()) == "DRS"
	assert drive.tokenWorth(drive.Token.Nothing()) == 0
	assert drive.tokenWorth(drive.Token.Safety()) > drive.tokenWorth(drive.Token.Wing())
	assert drive.tokenWorth(drive.Token.Wheel()) > drive.tokenWorth(drive.Token.Debris())
}

test "a timing screen has a number, three letters and two colours" {
	assert grid.board(0) == "1  HAL"
	assert grid.trimOf(0) == grid.teamOf(0).trim
	assert grid.trimOf(0) != grid.bodyOf(0)
}

// ---------------------------------------------------------------------------
// A bot
// ---------------------------------------------------------------------------

// A bot that never put a wheel wrong would be a bot on rails, which is the thing
// this whole example is written not to be. So what is asserted is not that it
// never goes off — it does, about one corner in twenty — but that it gets round,
// spends nearly all of its time on the road, and **comes back from an excursion
// rather than sitting in the gravel**. The last is the one that would actually
// break, and it is the one a lap time cannot tell you about.
test "a bot gets round, and comes back when it goes off" {
	track := circuit.build(4821)
	mut drive.Car car = drive.parked(track, 0)
	mut Int off = 0
	mut Int longest = 0
	mut Int run = 0
	for frame := 0; frame < 2400; frame++ {
		want := pace.driving(track, [car], [], [], drive.garaged(), 0, 0.0, false, true,
			conv.itf(frame) / 60.0)
		car = drive.stepped(track, car, want, 1.0, 1.0 / 60.0)
		if circuit.exceeded(track, circuit.Where(car.node, car.along, car.across)) {
			off = off + 1
			run = run + 1
			if run > longest {
				longest = run
			}
		} else {
			run = 0
		}
	}
	// Forty seconds, which is more than a lap of anywhere this rolls.
	assert car.sheet.travelled > track.length
	// On the road nine tenths of the time, and never off it for more than a couple
	// of seconds at a stretch. A bot stuck in a gravel trap would fail the second
	// of those long before the first.
	assert off < 240
	assert longest < 150
}

test "a bot obeys a speed limit it is given" {
	track := circuit.build(4821)
	mut drive.Car car = put(track, 0, 100.0, 0.0, 60.0)
	for frame := 0; frame < 240; frame++ {
		want := pace.driving(track, [car], [], [], drive.garaged(), 0, 20.0, false, true,
			conv.itf(frame) / 60.0)
		car = drive.stepped(track, car, want, 1.0, 1.0 / 60.0)
	}
	assert car.speed < 21.0
}

test "a better driver is a quicker driver" {
	track := circuit.build(4821)
	// Seat 0 is the best driver in the best car; seat 8 is neither.
	assert lapped(track, 0, 40.0).sheet.travelled
		> lapped(track, 8, 40.0).sheet.travelled
}

// ---------------------------------------------------------------------------
// Teammates — the two rules
// ---------------------------------------------------------------------------

test "a bot will not fire a wheel at its own teammate" {
	track := circuit.build(4821)
	me := put(track, 0, 100.0, 0.0, 50.0)
	mate := put(track, grid.partner(0), 160.0, 0.0, 50.0)
	rival := put(track, 4, 160.0, 0.0, 50.0)
	assert pace.worthFiring(track, [me, mate], me) == false
	assert pace.worthFiring(track, [me, rival], me)
}

test "a bot will not drop debris in front of its own teammate" {
	track := circuit.build(4821)
	me := put(track, 0, 200.0, 0.0, 50.0)
	mate := put(track, grid.partner(0), 190.0, 0.0, 50.0)
	rival := put(track, 4, 190.0, 0.0, 50.0)
	assert pace.worthDropping(track, [me, mate], me) == false
	assert pace.worthDropping(track, [me, rival], me)
}

// The second rule, and the one that is a matter of degree rather than a refusal.
// A rival coming down the inside gets the door shut; a teammate gets it left open.
test "a bot covers a rival and yields to a teammate" {
	track := circuit.build(4821)
	me := put(track, 0, 300.0, 0.0, 50.0)
	mate := put(track, grid.partner(0), 296.0, 2.5, 52.0)
	rival := put(track, 4, 296.0, 2.5, 52.0)
	againstRival := pace.defending(track, [me, rival], me, true)
	againstMate := pace.defending(track, [me, mate], me, true)
	// Toward the rival, to cover the side they are coming down.
	assert againstRival > 0.0
	// And away from the teammate, which is the same move in reverse.
	assert againstMate < 0.0
}

test "a teammate on the other side is still given room on that side" {
	track := circuit.build(4821)
	me := put(track, 0, 300.0, 0.0, 50.0)
	mate := put(track, grid.partner(0), 296.0, -2.5, 52.0)
	assert pace.defending(track, [me, mate], me, true) > 0.0
}

test "nobody defends against a car that is dropping away" {
	track := circuit.build(4821)
	me := put(track, 0, 300.0, 0.0, 50.0)
	slower := put(track, 4, 296.0, 2.5, 40.0)
	assert pace.defending(track, [me, slower], me, true) == 0.0
}

test "nobody races behind the safety car" {
	track := circuit.build(4821)
	me := put(track, 0, 300.0, 0.0, 50.0)
	rival := put(track, 4, 296.0, 2.5, 52.0)
	ahead := put(track, 6, 306.0, 0.0, 48.0)
	assert pace.defending(track, [me, rival], me, false) == 0.0
	assert pace.passing(track, [me, ahead], me, false) == 0.0
	assert pace.passing(track, [me, ahead], me, true) != 0.0
}

// ---------------------------------------------------------------------------
// Race control
// ---------------------------------------------------------------------------

test "nobody moves before the lights go out" {
	mut control.Race race = control.lined(4821)
	assert race.lights > 0.0
	before := control.find(race.cars, 3).along
	for frame := 0; frame < 60; frame++ {
		race = control.stepped(race,
			[control.Asking(0, drive.Wants(0.0, 1.0, 0.0, false, false))],
			1.0 / 60.0)
	}
	assert control.find(race.cars, 3).along == before
	assert race.clock == 0.0
}

test "standing on the throttle before the lights costs five seconds, once" {
	mut control.Race race = control.lined(4821)
	for frame := 0; frame < 120; frame++ {
		race = control.stepped(race,
			[control.Asking(0, drive.Wants(0.0, 1.0, 0.0, false, false))],
			1.0 / 60.0)
	}
	assert control.find(race.cars, 0).sheet.penalty == drive.added()
	assert control.find(race.cars, 1).sheet.penalty == 0.0
}

test "the grid is two staggered columns behind the line" {
	track := circuit.build(4821)
	for seat := 0; seat < grid.field(); seat++ {
		spot := drive.gridSpot(track, seat)
		assert math.abs(spot.across) > 2.0
		assert math.abs(spot.across) < circuit.nodeAt(track, 0).half
		// Behind the line, which is most of the way round from it.
		assert spot.along > track.length * 0.8
	}
	// And nobody is exactly alongside anybody.
	for seat := 0; seat < grid.field() - 1; seat++ {
		assert drive.gridSpot(track, seat).along
			!= drive.gridSpot(track, seat + 1).along
	}
}

// ---------------------------------------------------------------------------
// The flags, which are places now
// ---------------------------------------------------------------------------

test "a yellow applies where it is and nowhere else" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	assert control.deltaAt(race, 400.0) == 0.0
	race = control.waved(race, 400.0)
	assert control.deltaAt(race, 400.0) == control.yellowSpeed()
	// Just inside the stretch, and just outside it.
	assert control.deltaAt(race, 400.0 + control.yellowSpan() - 5.0)
		== control.yellowSpeed()
	assert control.deltaAt(race, 400.0 + control.yellowSpan() + 5.0) == 0.0
	assert control.deltaAt(race, 400.0 - control.yellowSpan() - 5.0) == 0.0
	// And racing is still allowed, because a yellow is not a safety car: it asks for
	// a speed in one place, and nothing else about the race changes.
	assert control.green(race)
}

test "a yellow over the start line is one stretch, not two" {
	mut control.Race race = control.lined(4821)
	race = control.waved(race, 10.0)
	// Ten metres before the line is a lap and a bit away by simple subtraction and
	// twenty metres away by the only measure that means anything.
	assert control.deltaAt(race, race.track.length - 10.0)
		== control.yellowSpeed()
	assert len(race.zones) == 1
}

test "the safety car's delta is everywhere and a yellow's is not" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	race = control.deployed(race)
	assert control.deltaAt(race, 0.0) == control.safetySpeed()
	assert control.deltaAt(race, race.track.length / 2.0) == control.safetySpeed()
	assert control.green(race) == false
}

test "a car in a gravel trap waves the flag where it is standing" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	// Find somewhere with gravel beside it, and put a car in it, stopped.
	mut Float at = 0.0
	for i := 0; i < len(race.track.nodes); i++ {
		if circuit.nodeAt(race.track, i).trap {
			at = circuit.nodeAt(race.track, i).along
			break
		}
	}
	assert at > 0.0
	node := circuit.nodeAlong(race.track, at)
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = car
		if one.seat == 4 {
			one = put(race.track, 4, at, node.half + circuit.kerbWidth() + 3.0, 1.0)
		}
		append(cars, one)
	}
	race.cars = cars
	race = control.flagged(race)
	assert len(race.zones) == 1
	assert control.deltaAt(race, at) == control.yellowSpeed()
}

test "a yellow that runs out shows green before it goes" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	race = control.waved(race, 400.0)
	race = control.clearing(race, control.yellowFor() + 0.01)
	assert len(race.zones) == 1
	assert control.deltaAt(race, 400.0) == 0.0
	assert control.slotOfZone(race.zones, 0).green > 0.0
	race = control.clearing(race, control.greenFor() + 0.01)
	assert len(race.zones) == 0
}

// ---------------------------------------------------------------------------
// The stewards
// ---------------------------------------------------------------------------

test "nothing slows a car down for a flag" {
	track := circuit.build(4821)
	// The identical car, driven identically, with and without a flag over it. The
	// old `capFor` made these two different; nothing does now, and that is the whole
	// change: the physics has never heard of a flag.
	mut drive.Car free = put(track, 0, 400.0, 0.0, 70.0)
	mut drive.Car under = put(track, 0, 400.0, 0.0, 70.0)
	for frame := 0; frame < 60; frame++ {
		flat := drive.Wants(0.0, 1.0, 0.0, false, false)
		free = drive.stepped(track, free, flat, 1.0, 1.0 / 60.0)
		under = drive.stepped(track, under, flat, 1.0, 1.0 / 60.0)
	}
	assert free.speed == under.speed
}

test "a moment over the delta is forgiven and a lap of it is not" {
	// Just over, for less than the leeway: nothing.
	mut drive.Car brief = drive.parked(circuit.build(4821), 0)
	for frame := 0; frame < 60; frame++ {
		brief = drive.policed(brief, true, 1.0 / 60.0)
	}
	assert brief.sheet.ignored == 0
	assert brief.sheet.penalty == 0.0
	// Past it: one offence, and the clock starts again.
	mut drive.Car caught = drive.parked(circuit.build(4821), 0)
	for frame := 0; frame < 120; frame++ {
		caught = drive.policed(caught, true, 1.0 / 60.0)
	}
	assert caught.sheet.ignored == 1
	assert caught.sheet.speeding < drive.leeway()
}

test "every offence costs, and each one costs more than the last" {
	// Twelve seconds flat out over the delta. At a leeway apiece that is eight
	// offences, and the eight are worth 1+2+…+8 of `disregard()` rather than eight
	// of it — which is the whole of the rule and the whole of what makes ignoring
	// a delta a worse idea than obeying one.
	mut drive.Car car = drive.parked(circuit.build(4821), 0)
	for frame := 0; frame < 60 * 13; frame++ {
		car = drive.policed(car, true, 1.0 / 60.0)
	}
	assert car.sheet.ignored == 8
	assert car.sheet.penalty == drive.disregard() * 36.0
	// The tally runs on rather than starting again, because it is what the next one
	// will cost rather than a count towards anything.
	mut drive.Car one = drive.parked(circuit.build(4821), 0)
	for frame := 0; frame < 120; frame++ {
		one = drive.policed(one, true, 1.0 / 60.0)
	}
	assert one.sheet.ignored == 1
	assert one.sheet.penalty == drive.disregard()
	// And the second is worth twice the first, which the third-of-a-penalty a
	// warning used to be worth never was.
	for frame := 0; frame < 120; frame++ {
		one = drive.policed(one, true, 1.0 / 60.0)
	}
	assert one.sheet.ignored == 2
	assert one.sheet.penalty == drive.disregard() * 3.0
}

test "one blast down the pit lane costs more than the lane it skipped" {
	// The arithmetic the rule exists for, asserted rather than argued. A car held
	// flat through the walled length of the pit lane is over the limit for the
	// whole of it, and what that costs has to beat both of the honest ways round:
	// the eleven-odd seconds the lane costs at the limit, and the `unserved()` it
	// costs to skip the lane altogether.
	track := circuit.build(4821)
	walled := circuit.pitRun(track) - circuit.pitMouth(track) * 2.0
	racing := 55.0
	mut drive.Car car = drive.parked(track, 0)
	blast := walled / racing
	mut Int frames = conv.round(blast * 60.0)
	for frame := 0; frame < frames; frame++ {
		car = drive.policed(car, true, 1.0 / 60.0)
	}
	lane := walled / circuit.pitSpeed() - blast
	assert car.sheet.penalty > lane
	assert car.sheet.penalty > drive.unserved()
}

test "the count comes off again once you are under it" {
	mut drive.Car car = drive.parked(circuit.build(4821), 0)
	for frame := 0; frame < 60; frame++ {
		car = drive.policed(car, true, 1.0 / 60.0)
	}
	over := car.sheet.speeding
	assert over > 0.5
	for frame := 0; frame < 60; frame++ {
		car = drive.policed(car, false, 1.0 / 60.0)
	}
	assert car.sheet.speeding < over
	assert car.sheet.ignored == 0
}

test "driving through a yellow at racing speed costs, and goes on costing" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	// A car well over the delta, standing inside a yellow stretch, held there.
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = car
		if one.seat == 0 {
			one = put(race.track, 0, 400.0, 0.0, control.yellowSpeed() + 25.0)
		}
		append(cars, one)
	}
	race.cars = cars
	// The clock is wound by hand because `policing` is called by hand: `grace()` is
	// read off how long ago the flag went out, and a race whose clock never moved
	// would be a race in which the flag is forever two frames old.
	for frame := 0; frame < 60 * 12; frame++ {
		race.clock = race.clock + 1.0 / 60.0
		race = control.waved(race, 400.0)
		race = control.policing(race, 1.0 / 60.0)
	}
	// Not one penalty and then silence: the clock starts again after every offence,
	// and every offence is dearer than the one before it.
	caught := control.find(race.cars, 0)
	assert caught.sheet.ignored > 2
	assert caught.sheet.penalty > drive.disregard() * conv.itf(caught.sheet.ignored)
}

test "a flag two seconds old has caught nobody yet" {
	// The same car in the same yellow, but only for as long as `grace()` lasts. It
	// is over the delta from the first frame to the last and the stewards have
	// written down nothing, which is the whole of what the grace is for: a flag
	// arrives instantly and a car does not.
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = car
		if one.seat == 0 {
			one = put(race.track, 0, 400.0, 0.0, control.yellowSpeed() + 25.0)
		}
		append(cars, one)
	}
	race.cars = cars
	race = control.waved(race, 400.0)
	assert control.justOut(race, 400.0, 0.0)
	// A hundred and ten frames is comfortably inside the two seconds, and the point
	// of stopping short of them is that a test which stepped exactly to the boundary
	// would be a test of how sixty sixtieths of a second add up.
	for frame := 0; frame < 110; frame++ {
		race.clock = race.clock + 1.0 / 60.0
		race = control.waved(race, 400.0)
		race = control.policing(race, 1.0 / 60.0)
	}
	assert control.justOut(race, 400.0, 0.0)
	assert control.find(race.cars, 0).sheet.speeding == 0.0
	assert control.find(race.cars, 0).sheet.ignored == 0
	// **Silent to the stewards and loud to the driver.** The grace is not two free
	// seconds, it is two seconds of being told: nothing is being written down and
	// the border of the window is already red, which is the difference between the
	// two calls and the reason there are two of them.
	assert control.judged(race, control.find(race.cars, 0)) == false
	assert control.ignoring(race, control.find(race.cars, 0))
	// And the moment it stops being new it starts counting, on the same flag and at
	// the same speed. The zone is *refreshed* every frame above, so this also pins
	// down that the grace is read off when the flag went out and not off what it
	// has left.
	for frame := 0; frame < 140; frame++ {
		race.clock = race.clock + 1.0 / 60.0
		race = control.waved(race, 400.0)
		race = control.policing(race, 1.0 / 60.0)
	}
	assert control.justOut(race, 400.0, 0.0) == false
	assert control.find(race.cars, 0).sheet.ignored == 1
}

test "a driver on the brakes is counted as being at the limit" {
	// Two identical cars, both a long way over a yellow's delta, both held there
	// for eight seconds. One is braking and one is not. The braking one is doing
	// the only thing the flag asks and is not judged for how long the car takes to
	// answer; the other one is simply ignoring it.
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	race.clock = 30.0
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = put(race.track, car.seat, 400.0, 0.0,
			control.yellowSpeed() + 25.0)
		one.braking = car.seat == 0
		append(cars, one)
	}
	race.cars = cars
	race = control.waved(race, 400.0)
	for frame := 0; frame < 60 * 8; frame++ {
		race.clock = race.clock + 1.0 / 60.0
		race = control.waved(race, 400.0)
		race = control.policing(race, 1.0 / 60.0)
	}
	onBrakes := control.find(race.cars, 0)
	flatOut := control.find(race.cars, 1)
	// Braking answers both of them: the stewards are not counting and the border is
	// not red either, because a driver hard on the brakes is doing the one thing the
	// flag asks and has nothing to be told.
	assert control.judged(race, onBrakes) == false
	assert control.ignoring(race, onBrakes) == false
	assert control.judged(race, flatOut)
	assert control.ignoring(race, flatOut)
	assert onBrakes.sheet.penalty == 0.0
	assert onBrakes.sheet.speeding == 0.0
	assert flatOut.sheet.penalty > 0.0
}

// ---------------------------------------------------------------------------
// Blue flags
// ---------------------------------------------------------------------------

// Two cars a hundred metres apart on the road, and a lap of total distance between
// them. `travelled` is the only thing that says who is lapping whom, so it is the
// only thing these set.
func lapDown(race: control.Race, ahead: Float, behind: Float, across: Float,
	apart: Float): control.Race {
	mut control.Race it = race
	it.lights = 0.0
	it.clock = 60.0
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = car
		if car.seat == 0 {
			// The one being lapped, out on the racing line.
			one = put(race.track, 0, ahead, across, 40.0)
			one.sheet.travelled = race.track.length * 2.0
		} else if car.seat == 1 {
			// The one doing the lapping, `apart` metres back and a whole lap up.
			one = put(race.track, 1, behind, 0.0, 46.0)
			one.sheet.travelled = race.track.length * 3.0 - apart
		} else {
			// Everybody else parked a long way round, so they are nobody's flag.
			one = put(race.track, car.seat, ahead + race.track.length / 2.0, 0.0, 0.0)
			one.sheet.travelled = race.track.length * 2.0
		}
		append(cars, one)
	}
	it.cars = cars
	return it
}

test "a car about to be lapped is shown a blue flag, and one on the same lap is not" {
	mut control.Race race = control.lined(4821)
	track := race.track
	race = lapDown(race, 400.0, 400.0 - 60.0, 0.0, 60.0)
	me := control.find(race.cars, 0)
	assert control.blueFor(race, me) == 1
	assert control.blue(race, me)
	// The car doing the lapping is not itself under one.
	assert control.blue(race, control.find(race.cars, 1)) == false

	// The same two cars on the same lap: nobody is being lapped and there is no
	// flag, however close behind the quicker one is. This is the whole reason the
	// test is on total distance rather than on a lap counter.
	mut control.Race level = control.lined(4821)
	level = lapDown(level, 400.0, 400.0 - 60.0, 0.0, 60.0)
	mut drive.Car[dyn] same = []
	for each car in level.cars {
		mut drive.Car one = car
		if one.seat == 1 {
			one.sheet.travelled = track.length * 2.0 - 60.0
		}
		append(same, one)
	}
	level.cars = same
	assert control.blue(level, control.find(level.cars, 0)) == false

	// And a lap down but half a circuit back is nobody in your mirrors.
	mut control.Race far = control.lined(4821)
	far = lapDown(far, 400.0, 400.0 - 600.0, 0.0, 600.0)
	assert control.blue(far, control.find(far.cars, 0)) == false
}

test "getting out of the way costs nothing, and staying in it costs more each time" {
	// The same blue flag held for twenty seconds, once by a car on the racing line
	// and once by a car at the edge of the road. Nothing moves: `lapping` is asked
	// directly, so what is being tested is the rule rather than whether a car can
	// be driven to the side of a circuit.
	mut control.Race blocking = control.lined(4821)
	blocking = lapDown(blocking, 400.0, 400.0 - 60.0, 0.0, 60.0)
	half := circuit.nodeAlong(blocking.track, 400.0).half
	mut control.Race aside = control.lined(4821)
	aside = lapDown(aside, 400.0, 400.0 - 60.0, half * 0.8, 60.0)
	assert control.yielding(aside.track, control.find(aside.cars, 0))
	assert control.yielding(blocking.track, control.find(blocking.cars, 0)) == false

	for frame := 0; frame < 60 * 21; frame++ {
		blocking = control.lapping(blocking, 1.0 / 60.0)
		aside = control.lapping(aside, 1.0 / 60.0)
	}
	// Four five-second stretches of holding somebody up, and they are worth
	// 1+2+3+4 of `blueCost()` rather than four of it.
	held := control.find(blocking.cars, 0)
	assert held.sheet.blocked == 4
	assert held.sheet.penalty == drive.blueCost() * 10.0
	// And the car that moved over has nothing at all — not a smaller penalty, none.
	moved := control.find(aside.cars, 0)
	assert moved.sheet.blocked == 0
	assert moved.sheet.penalty == 0.0
	assert moved.sheet.blocking == 0.0
}

test "a bot under a blue flag goes to the side of the road" {
	// A whole lap of it, driven. The bot is given the flag and nothing else, and
	// what is asserted is where the car ends up — not what `aside` returns, which
	// would be a test of arithmetic rather than of a car getting out of the way.
	track := circuit.build(4821)
	mut drive.Car car = put(track, 0, 400.0, 0.0, 40.0)
	mut Float took = -1.0
	for frame := 0; frame < 60 * 6; frame++ {
		want := pace.driving(track, [car], [], [], drive.garaged(), 0, 0.0, true,
			true, conv.itf(frame) / 60.0)
		car = drive.stepped(track, car, want, 1.0, 1.0 / 60.0)
		if took < 0.0 && control.yielding(track, car) {
			took = conv.itf(frame) / 60.0
		}
	}
	// **The assertion is the time**, because that is the rule: a car that gets to
	// the edge inside `blueLeeway()` is never penalised for the flag, and one that
	// takes longer is. Where it gets to is `control.yielding`, the stewards' own
	// question, rather than arithmetic this test does for itself.
	assert took >= 0.0
	assert took < drive.blueLeeway()
	assert control.yielding(track, car)
	assert circuit.exceeded(track, circuit.Where(car.node, car.along, car.across))
		== false
}

// ---------------------------------------------------------------------------
// The safety car, which is a car
// ---------------------------------------------------------------------------

test "obeying a safety car as fast as the brakes allow costs nothing" {
	// **The bug this exists for.** A safety car takes the whole circuit to eighty-
	// three kilometres an hour in the frame it is called; a car at two hundred and
	// forty needs the better part of two seconds on the brakes to get there. That
	// used to be an offence, and then — once every offence cost — five seconds and
	// then ten, for braking as hard as the car could be braked.
	//
	// Nothing here helps the car. It is `control.stepped` with the brake down, and
	// how long it takes is `drive.brakes()` rather than anything this test decides.
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	race.clock = 40.0
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		append(cars, put(race.track, car.seat,
			300.0 + conv.itf(car.seat) * 60.0, 0.0, 66.0))
	}
	race.cars = cars
	race = control.deployed(race)
	assert control.judged(race, control.find(race.cars, 0)) == false
	for frame := 0; frame < 60 * 4; frame++ {
		race = control.stepped(race,
			[control.Asking(0, drive.Wants(0.0, 0.0, 1.0, false, false))],
			1.0 / 60.0)
	}
	me := control.find(race.cars, 0)
	assert me.speed <= control.safetySpeed()
	// `ignored` and `speeding` rather than `penalty`, because a car braking in a
	// straight line down a bending road may well run wide, and running wide is a
	// different rule with a different count. This is about the delta.
	assert me.sheet.ignored == 0
	assert me.sheet.speeding == 0.0
}

test "the safety car comes out of the pit lane and goes back into it" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	race = control.deployed(race)
	assert drive.onTrack(race.pace)
	assert circuit.alongPits(race.track, race.pace.along)
	// It gets up to the delta and no further.
	for frame := 0; frame < 60 * 8; frame++ {
		race = control.paced(race, 1.0 / 60.0)
	}
	assert race.pace.speed <= control.safetySpeed() + 0.01
	assert race.pace.speed > control.safetySpeed() - 1.0
	// Its own count runs out, it goes green, and it drives itself in.
	for frame := 0; frame < 60 * 200; frame++ {
		race = control.paced(race, 1.0 / 60.0)
		if drive.onTrack(race.pace) == false {
			break
		}
	}
	assert drive.onTrack(race.pace) == false
	assert control.green(race)
}

test "driving into the back of the safety car spins you" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	race = control.deployed(race)
	race.pace.speed = control.safetySpeed()
	race.pace.along = 400.0
	race.pace.across = 0.0
	race.pace.node = circuit.indexAlong(race.track, 400.0)
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = car
		if one.seat == 2 {
			one = put(race.track, 2, 400.0, 0.0, 68.0)
		}
		append(cars, one)
	}
	race.cars = cars
	race = control.ranInto(race)
	assert control.find(race.cars, 2).spun > 0.0
	// And a car doing the delta behind it is fine, which is the point of lifting.
	assert control.find(race.cars, 0).spun == 0.0
}

// ---------------------------------------------------------------------------
// The pit lane
// ---------------------------------------------------------------------------

test "the pit lane runs beside the road and never over it" {
	for each seed in [4821, 17, 90210, 5, 66666] {
		track := circuit.build(seed)
		run := circuit.pitRun(track)
		assert run > 80.0
		// The part of it that is a lane rather than a merge — the tapers at each end
		// are *supposed* to be on the road, because that is what a pit entry and a pit
		// exit are. Everywhere else, the lane is clear of the road by nearly its whole
		// offset, and it stays clear of every other stretch of road too: `locate` is
		// asked with no hint, so what it answers with is the nearest tarmac anywhere
		// on the circuit rather than the nearest piece of the bit it is beside. A
		// track that looped back past its own pit lane would fail this.
		steps := 120
		for i := 40; i <= steps - 40; i++ {
			along := circuit.wrappedAlong(track,
				track.pits.entry + run * conv.itf(i) / conv.itf(steps))
			lane := circuit.pitAcross(track, along)
			assert lane * track.pits.side > 0.0
			where := circuit.placed(track, along, lane)
			back := circuit.locate(track, where.x, where.z, -1)
			assert math.abs(back.across)
				> circuit.nodeAt(track, back.node).half + circuit.kerbWidth()
		}
	}
}

test "the pit lane tapers in at one end and out at the other" {
	track := circuit.build(4821)
	// Nothing at all outside it, and the ends are narrower than the middle.
	assert circuit.pitAcross(track,
		circuit.wrappedAlong(track, track.pits.exit + 30.0)) == 0.0
	run := circuit.pitRun(track)
	near := math.abs(circuit.pitAcross(track,
		circuit.wrappedAlong(track, track.pits.entry + 4.0)))
	middle := math.abs(circuit.pitAcross(track,
		circuit.wrappedAlong(track, track.pits.entry + run / 2.0)))
	assert near < middle
	assert middle > track.pits.off - 0.01
}

// ---------------------------------------------------------------------------
// The compulsory stop
// ---------------------------------------------------------------------------

test "a race is five laps and the stop fits inside one of them" {
	track := circuit.build(4821)
	assert track.laps == 5
	// Every seat picks a lap to come in on, it is never the last one, and the field
	// does not all pick the same one — which is the whole reason it is rolled.
	mut Bool spread = false
	for seat := 0; seat < grid.field(); seat++ {
		on := pace.pitsOn(track, seat)
		assert on >= 1
		assert on < track.laps
		if on != pace.pitsOn(track, 0) {
			spread = true
		}
	}
	assert spread
	// And the same seat picks the same lap every time, so a race can be learned.
	assert pace.pitsOn(track, 3) == pace.pitsOn(circuit.build(4821), 3)
}

test "the pit wall has a way in and a way out and nothing in between" {
	for each seed in [4821, 17, 90210, 5] {
		track := circuit.build(seed)
		run := circuit.pitRun(track)
		mouth := circuit.pitMouth(track)
		// Open at each end, closed down the middle. Without the two openings a pit
		// lane is a corridor nothing can get into.
		assert circuit.pitWalled(track,
			circuit.wrappedAlong(track, track.pits.entry + mouth / 2.0)) == false
		assert circuit.pitWalled(track,
			circuit.wrappedAlong(track, track.pits.exit - mouth / 2.0)) == false
		assert circuit.pitWalled(track,
			circuit.wrappedAlong(track, track.pits.entry + run / 2.0))
		// And nothing anywhere else on the circuit.
		assert circuit.pitWalled(track,
			circuit.wrappedAlong(track, track.pits.exit + run / 4.0)) == false
		// Where it is closed it stands clear of the road and clear of the lane, which
		// is what makes it a wall with a car on each side rather than a kerb.
		middle := circuit.wrappedAlong(track, track.pits.entry + run / 2.0)
		node := circuit.nodeAlong(track, middle)
		wall := circuit.pitWallAt(track, middle)
		assert wall > node.half + circuit.kerbWidth()
		assert wall < math.abs(circuit.pitAcross(track, middle)) - track.pits.half
	}
}

test "a car cannot cross the pit wall where it is closed" {
	track := circuit.build(4821)
	middle := circuit.wrappedAlong(track, track.pits.entry + circuit.pitRun(track) / 2.0)
	wall := circuit.pitWallAt(track, middle)
	// Driven at it from the circuit, hard.
	mut drive.Car car = put(track, 0, middle - 40.0, 0.0, 34.0)
	car.yaw = car.yaw - track.pits.side * 0.5
	for frame := 0; frame < 150; frame++ {
		car = drive.stepped(track, car, drive.Wants(0.0, 1.0, 0.0, false, false),
			1.0, 1.0 / 60.0)
		if circuit.pitWalled(track, car.along) {
			assert car.across * track.pits.side < wall
		}
	}
	// So it never got in, and so it never served anything.
	assert car.sheet.pitted == false
}

test "the pit lane is a road: tarmac, and not a track-limits offence" {
	track := circuit.build(4821)
	middle := circuit.wrappedAlong(track, track.pits.entry + circuit.pitRun(track) / 2.0)
	lane := circuit.pitAcross(track, middle)
	where := circuit.Where(circuit.indexAlong(track, middle), middle, lane)
	// A car in its pit box is on a road, not on a lawn. Without this the compulsory
	// stop would be a third of the grip and half the speed, and a rule you are
	// punished for obeying is not a rule.
	assert circuit.under(track, where) is circuit.Ground.Tarmac
	assert circuit.exceeded(track, where) == false
	// And the same place is well past where the track limits would otherwise be.
	assert math.abs(lane) > circuit.nodeAlong(track, middle).half + circuit.kerbWidth()
}

test "driving through the pit lane serves the stop" {
	track := circuit.build(4821)
	// Put in the middle of the lane, which is where a car that came in ends up.
	middle := circuit.wrappedAlong(track, track.pits.entry + circuit.pitRun(track) / 2.0)
	mut drive.Car car = put(track, 0, middle, circuit.pitAcross(track, middle), 20.0)
	assert car.sheet.pitted == false
	car = drive.stepped(track, car, drive.Wants(0.0, 0.5, 0.0, false, false),
		1.0, 1.0 / 60.0)
	assert car.sheet.pitted
	// A car on the circuit alongside is not in the pit lane and has served nothing.
	mut drive.Car past = put(track, 1, middle, 0.0, 40.0)
	past = drive.stepped(track, past, drive.Wants(0.0, 1.0, 0.0, false, false),
		1.0, 1.0 / 60.0)
	assert past.sheet.pitted == false
}

test "the pit lane has a limit, and it is policed the way a flag is" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	track := race.track
	middle := circuit.wrappedAlong(track, track.pits.entry + circuit.pitRun(track) / 2.0)
	lane := circuit.pitAcross(track, middle)
	// The limit applies in the lane and nowhere else — not to the car a few metres
	// away on the other side of the wall, which is the whole reason a delta is asked
	// of a *place* rather than of a distance round the lap.
	assert control.deltaFor(race, middle, lane) == circuit.pitSpeed()
	assert control.deltaFor(race, middle, 0.0) == 0.0
	// And somebody blasting down it is on the stewards' clock for it, by the same
	// count an ignored yellow is kept on — which is the join being tested here:
	// that the number `policing` compares a car with is the one for the place the
	// car is actually in, and not the one for the stretch of road it is beside.
	//
	// Two cars, same speed, a few metres apart across the pit wall. One of them is
	// speeding and the other is racing.
	inLane := circuit.wrappedAlong(track,
		track.pits.entry + circuit.pitMouth(track) + 8.0)
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut Float across = 0.0
		if car.seat == 0 {
			across = circuit.pitAcross(track, inLane)
		}
		append(cars, put(track, car.seat, inLane - conv.itf(car.seat) * 40.0,
			across, 60.0))
	}
	race.cars = cars
	// Held down by somebody at the wheel: a bot would lift, which is the point of a
	// bot and no use at all for testing what happens to a driver who does not.
	flat := [control.Asking(0, drive.Wants(0.0, 1.0, 0.0, false, false))]
	for frame := 0; frame < 24; frame++ {
		race = control.stepped(race, flat, 1.0 / 60.0)
	}
	speeder := control.find(race.cars, 0)
	// Still down there, so the test is about the rule rather than about a car that
	// left the lane on the second frame.
	assert circuit.inPits(track, speeder.along, speeder.across)
	assert speeder.sheet.speeding > 0.3
	// Nobody on the circuit is on any clock at all.
	assert control.find(race.cars, 2).sheet.speeding == 0.0
}

test "taking the flag without the stop costs, and serving it costs nothing" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	race.clock = 100.0
	track := race.track
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = put(track, car.seat, track.length - 24.0, -2.0, 30.0)
		one.sheet.lap = track.laps
		one.sheet.sector = 3
		one.sheet.travelled = track.length * conv.itf(track.laps)
		// The even seats came in at some point and the odd ones did not.
		one.sheet.pitted = car.seat % 2 == 0
		append(cars, one)
	}
	race.cars = cars
	for frame := 0; frame < 240; frame++ {
		race = control.stepped(race, nobody(), 1.0 / 60.0)
	}
	for each car in race.cars {
		assert car.sheet.finished
		if car.seat % 2 == 0 {
			assert car.sheet.penalty == 0.0
		} else {
			// Not counted in threes and not forgiven: it either happened or it did not.
			assert car.sheet.penalty >= drive.unserved()
			assert car.sheet.finishedAt >= car.sheet.penalty
		}
	}
}

test "a bot comes in, and comes in once" {
	// A whole race, nobody driving, on three seeds — and the three are chosen
	// rather than pretty. **Both of the bugs this test exists for were seed-shaped
	// and neither showed on 4821.**
	//
	// A bot asked whether it was in the pit lane by "is it on the lane's tarmac",
	// and the lane's two tapers overlap the racing line by design — so a car merely
	// running wide past the pit entry read as a car already in the pits and turned
	// in. Every lap. On 17 the field pitted up to five times each and the race
	// could not end at all; on 777 half of them never got round.
	//
	// So what is asserted is what actually went wrong: the race **ends**, and
	// nobody spends it going round the pit lane.
	for each seed in [4821, 17, 777] {
		mut control.Race race = control.lined(seed)
		mut Int[dyn] visits = []
		mut Bool[dyn] inside = []
		for seat := 0; seat < grid.field(); seat++ {
			append(visits, 0)
			append(inside, false)
		}
		for frame := 0; frame < 60 * 60 * 10; frame++ {
			race = control.stepped(race, nobody(), 1.0 / 60.0)
			for each car in race.cars {
				if visits bounds car.seat && inside bounds car.seat {
					now := circuit.inPits(race.track, car.along, car.across)
					if now && inside[car.seat] == false {
						visits[car.seat] = visits[car.seat] + 1
					}
					inside[car.seat] = now
				}
			}
			if race.over {
				break
			}
		}
		assert race.over
		mut Int served = 0
		for each car in race.cars {
			assert car.sheet.finished
			if car.sheet.pitted {
				served = served + 1
			}
		}
		// Most of them get in. A bot that misses the window takes the twenty-five
		// seconds like anybody else, which is a result rather than a fault — but a
		// field where hardly anybody manages it would mean the lane cannot be
		// entered, and that is a fault.
		assert served > grid.field() / 2
		for each n in visits {
			assert n <= 2
		}
	}
}

// ---------------------------------------------------------------------------
// The shape of the ground
// ---------------------------------------------------------------------------

test "the hill is a hill rather than a ramp" {
	// Every seed, and the whole point of the number: a circuit a kilometre and a
	// half round with six metres of climb in it is at a slope somewhere for most of
	// the lap, and the corner you are braking for is behind it.
	for each seed in [4821, 17, 90210, 5, 66666, 123, 777] {
		track := circuit.build(seed)
		mut Float lowest = 1000.0
		mut Float highest = -1000.0
		mut Float steepest = 0.0
		for i := 0; i < len(track.nodes); i++ {
			here := circuit.nodeAt(track, i)
			on := circuit.nodeAt(track, i + 1)
			lowest = math.min(lowest, here.y)
			highest = math.max(highest, here.y)
			steepest = math.max(steepest,
				math.abs(on.y - here.y) / circuit.spacing(track))
		}
		assert highest - lowest < 7.0
		// And under four percent everywhere, which is a rise you feel and not one
		// you launch off.
		assert steepest < 0.04
	}
}

// ---------------------------------------------------------------------------
// Everywhere that is not the road
// ---------------------------------------------------------------------------

test "nothing beside the circuit is standing on it" {
	for each seed in [4821, 17, 90210] {
		track := circuit.build(seed)
		props := scenery.props(track)
		assert len(props) > 200
		for each prop in props {
			where := circuit.locate(track, prop.x, prop.z, -1)
			// Past the run-off, every one of them. A tree on the racing line is not a
			// tree, it is a wall nobody can see coming.
			assert math.abs(where.across)
				> circuit.nodeAt(track, where.node).half + circuit.kerbWidth()
		}
	}
}

test "the same seed grows the same wood" {
	assert len(scenery.props(circuit.build(4821)))
		== len(scenery.props(circuit.build(4821)))
	assert len(scenery.props(circuit.build(4821)))
		!= len(scenery.props(circuit.build(90210)))
}

test "there is a marshal's post inside every yellow that can be waved" {
	track := circuit.build(4821)
	props := scenery.props(track)
	// Every hundred metres round the lap, a flag waved there has somebody to wave it.
	mut Float at = 0.0
	for ; at < track.length; {
		mut Bool found = false
		for each prop in props {
			if prop.kind is scenery.Kind.Post
				&& math.abs(circuit.nearGap(track, prop.along, at))
					<= control.yellowSpan() {
				found = true
			}
		}
		assert found
		at = at + 100.0
	}
}

test "everything beside the circuit can be drawn, and a marshal shows the flag" {
	track := circuit.build(4821)
	mut Int posts = 0
	for each prop in scenery.props(track) {
		// Every kind draws something, and nothing draws nothing — a prop with no
		// shapes in it is a prop that is standing there invisibly, which is the
		// failure this catches and which no screenshot would.
		assert len(scenery.shaped(prop, scenery.Flag.Clear())) > 0
		if prop.kind is scenery.Kind.Post {
			posts = posts + 1
			// A marshal with a flag out is one shape more than a marshal without one,
			// and that shape is the flag.
			assert len(scenery.shaped(prop, scenery.Flag.Yellow()))
				== len(scenery.shaped(prop, scenery.Flag.Clear())) + 1
			assert len(scenery.shaped(prop, scenery.Flag.Green()))
				== len(scenery.shaped(prop, scenery.Flag.Clear())) + 1
		}
	}
	assert posts > 6
}

test "the barrier goes round the outside of the pit lane, not through it" {
	// The barrier used to be *skipped* on the pit lane's side, because the lane
	// wanted the ground it stood on. That was fine while nothing could touch it and
	// is a hole in the wall now that something can — so it goes round the outside
	// of the lane instead, and there is a piece of it on both sides of every node
	// on the circuit.
	for each seed in [4821, 17, 90210] {
		track := circuit.build(seed)
		mut Int clear = 0
		mut Int beside = 0
		for i := 0; i < len(track.nodes); i++ {
			node := circuit.nodeAt(track, i)
			pieces := len(scenery.verge(track, i))
			assert pieces >= 2
			if circuit.alongPits(track, node.along) {
				beside = beside + pieces
				// Where the lane runs, the wall on that side is beyond the far edge of
				// it: a car in its pit box is inside the circuit, not outside it.
				lane := math.abs(circuit.pitAcross(track, node.along))
				if lane > 0.0 {
					assert circuit.wallAt(track, node.along, track.pits.side)
						> lane + track.pits.half
				}
			} else {
				clear = clear + pieces
				// And where it does not, both walls are the plain barrier offset.
				assert circuit.wallAt(track, node.along, 1.0) == node.half + circuit.wallOff()
				assert circuit.wallAt(track, node.along, -1.0) == node.half + circuit.wallOff()
			}
		}
		// The pit stretch draws more than the plain verge does — the lane, its wall
		// and the boxes — rather than less.
		assert beside > 0
		assert clear > 0
	}
}

// ---------------------------------------------------------------------------
// The walls
// ---------------------------------------------------------------------------

test "a car cannot drive through the barrier" {
	track := circuit.build(4821)
	// Pointed thirty degrees off the road and given everything it has. Before the
	// wall was a wall this ended up in a field; the only question now is which side
	// of the barrier it ends up on.
	mut drive.Car car = put(track, 0, 300.0, 0.0, 40.0)
	car.yaw = car.yaw + 0.52
	for frame := 0; frame < 240; frame++ {
		car = drive.stepped(track, car, drive.Wants(0.0, 1.0, 0.0, false, false),
			1.0, 1.0 / 60.0)
		// Every frame, not only the last one: a car that went through and came back
		// would pass a test that only looked at where it stopped.
		mut Float side = 1.0
		if car.across < 0.0 {
			side = -1.0
		}
		assert math.abs(car.across) <= circuit.wallAt(track, car.along, side)
	}
	// And it hit something on the way.
	assert car.sheet.warnings > 0
}

test "hitting a wall square costs more than brushing it" {
	track := circuit.build(4821)
	// Two cars, same speed, same wall, different angles at it.
	mut drive.Car square = put(track, 0, 300.0, 0.0, 40.0)
	mut drive.Car glance = put(track, 0, 300.0, 0.0, 40.0)
	square.yaw = square.yaw + 1.2
	glance.yaw = glance.yaw + 0.14
	coast := drive.Wants(0.0, 0.0, 0.0, false, false)
	for frame := 0; frame < 180; frame++ {
		square = drive.stepped(track, square, coast, 1.0, 1.0 / 60.0)
		glance = drive.stepped(track, glance, coast, 1.0, 1.0 / 60.0)
	}
	// The one that arrived across the wall is stopped; the one that leaned on it
	// kept most of what it had. A flat fraction of the speed would have made these
	// two the same, which is exactly backwards.
	assert glance.speed > square.speed + 8.0
}

test "driving away from a wall costs nothing" {
	track := circuit.build(4821)
	// Sitting against the barrier, pointed away from it, on the throttle. A car in
	// this position is in contact every single frame — so if a wall took the size
	// of the sideways speed rather than the part of it going *into* the wall, it
	// would scrub off the very movement that gets the car out, sixty times a
	// second, and the car would never leave. One bot spent nine minutes there and
	// the race could not end.
	edge := circuit.wallAt(track, 300.0, 1.0) - 1.2
	mut drive.Car car = put(track, 0, 300.0, edge, 4.0)
	car.yaw = car.yaw - 0.5
	for frame := 0; frame < 90; frame++ {
		car = drive.stepped(track, car, drive.Wants(-0.6, 1.0, 0.0, false, false),
			1.0, 1.0 / 60.0)
	}
	assert car.across < edge - 2.0
	assert car.speed > 12.0
}

test "a wall does not weld a spun car to itself" {
	track := circuit.build(4821)
	// Parked against the barrier facing back down the circuit, which is where a car
	// ends up after a spin. It has to be able to get round again: a wall that
	// straightened every car it touched, every frame, whatever the speed, would
	// hold this one here for the rest of the race.
	edge := circuit.wallAt(track, 300.0, 1.0) - 1.2
	mut drive.Car car = put(track, 0, 300.0, edge, 6.0)
	car.yaw = car.yaw + math.pi()
	was := circuit.wrapped(car.yaw - circuit.nodeAlong(track, car.along).dir)
	for frame := 0; frame < 120; frame++ {
		want := pace.driving(track, [car], [], [], drive.garaged(), 0, 0.0, false, true, 0.0)
		car = drive.stepped(track, car, want, 1.0, 1.0 / 60.0)
	}
	now := circuit.wrapped(car.yaw - circuit.nodeAlong(track, car.along).dir)
	assert math.abs(now) < math.abs(was) - 0.6
}

test "a lap fits inside the box a map is drawn in" {
	for each seed in [4821, 17, 90210, 5, 66666] {
		track := circuit.build(seed)
		box := circuit.extent(track)
		assert box.across > 0.0
		assert box.down > 0.0
		// Everything a map draws is inside it: the road, and the pit lane beside it.
		// A map is `preserveAspectRatio`, so anything outside the box is not clipped —
		// it is off the edge of the picture, which is worse.
		for each node in track.nodes {
			assert node.x > box.x
			assert node.x < box.x + box.across
			assert node.z > box.z
			assert node.z < box.z + box.down
		}
		steps := 40
		for i := 0; i <= steps; i++ {
			along := circuit.wrappedAlong(track,
				track.pits.entry + circuit.pitRun(track) * conv.itf(i) / conv.itf(steps))
			where := circuit.placed(track, along, circuit.pitAcross(track, along))
			assert where.x > box.x
			assert where.x < box.x + box.across
			assert where.z > box.z
			assert where.z < box.z + box.down
		}
	}
}

// ---------------------------------------------------------------------------
// What crosses the wire
// ---------------------------------------------------------------------------

test "a race survives the round trip" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	for frame := 0; frame < 60 * 6; frame++ {
		race = control.stepped(race, nobody(), 1.0 / 60.0)
	}
	said := wire.told(wire.Down.Ran(wire.taken(race)))
	heard := wire.heard(said)
	assert heard is Result.Ok(_)
	if heard is Result.Ok(down) && down is wire.Down.Ran(at) {
		// The circuit is not in it — it is a `func` of the seed at both ends — so the
		// race it is put back into is one built from the same number.
		back := wire.given(control.lined(4821), at)
		assert back.clock == race.clock
		assert len(back.cars) == len(race.cars)
		for each car in race.cars {
			there := control.find(back.cars, car.seat)
			assert there.x == car.x
			assert there.z == car.z
			assert there.sheet.travelled == car.sheet.travelled
			assert there.sheet.penalty == car.sheet.penalty
		}
	}
}

test "the controls are the whole of what a client is trusted with" {
	want := drive.Wants(-0.4, 0.9, 0.1, true, false)
	said := wire.said(wire.drives(want))
	heard := wire.asked(said)
	assert heard is Result.Ok(_)
	if heard is Result.Ok(up) {
		back := wire.drove(up)
		assert back.steer == want.steer
		assert back.throttle == want.throttle
		assert back.brake == want.brake
		assert back.drifting == want.drifting
	}
}

test "a message from something else is refused rather than guessed at" {
	// A `{` opens an interpolation in a Hive string, so the one place a JSON literal
	// has to be written out is the one place it has to be escaped.
	assert wire.asked("\{\"Drove\": \{\"steer\": \"left a bit\"}}") is Result.Error(_)
	assert wire.heard("not json at all") is Result.Error(_)
}

// ---------------------------------------------------------------------------
// Who is driving
// ---------------------------------------------------------------------------

test "a seat nobody is asking anything of is driven by a bot" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	// Nobody at any wheel: ten bots, and they all get going.
	for frame := 0; frame < 60 * 4; frame++ {
		race = control.stepped(race, nobody(), 1.0 / 60.0)
	}
	for each car in race.cars {
		assert car.speed > 10.0
	}
}

test "a seat somebody is asking nothing of stands still" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	// The difference between "nobody is driving it" and "the driver asked for
	// nothing", which is the one distinction `atWheel` exists for.
	held := [control.Asking(6, drive.idle())]
	for frame := 0; frame < 60 * 4; frame++ {
		race = control.stepped(race, held, 1.0 / 60.0)
	}
	assert control.find(race.cars, 6).speed == 0.0
	assert control.find(race.cars, 7).speed > 10.0
}

test "two people race each other and eight bots" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	// Two seats driven from outside, eight from inside, and one call for all ten.
	// What is asserted is how far each of them *got*, not how fast it is going: two
	// cars held at full throttle with the wheel straight are two cars in the middle
	// of a corner by the third second, and whether either is still pointing the
	// right way at the end is a fact about the corner rather than about who is
	// driving.
	both := [
		control.Asking(0, drive.Wants(0.0, 1.0, 0.0, false, false)),
		control.Asking(5, drive.Wants(0.0, 1.0, 0.0, false, false))
	]
	for frame := 0; frame < 60 * 3; frame++ {
		race = control.stepped(race, both, 1.0 / 60.0)
	}
	assert control.find(race.cars, 0).sheet.travelled > 20.0
	assert control.find(race.cars, 5).sheet.travelled > 20.0
	assert control.find(race.cars, 3).sheet.travelled > 20.0
}

// The bug this is here for: `thrown` used to take the token off a copy of the
// field that the caller then overwrote, so the press landed again every frame.
test "a token is spent once" {
	mut control.Race race = control.lined(4821)
	// Past the lights, and give somebody something to throw.
	race.lights = 0.0
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = car
		if one.seat == 0 {
			one.holding = drive.Token.Debris()
			one.speed = 30.0
		}
		append(cars, one)
	}
	race.cars = cars
	pressing := [control.Asking(0, drive.Wants(0.0, 1.0, 0.0, false, true))]
	for frame := 0; frame < 30; frame++ {
		race = control.stepped(race, pressing, 1.0 / 60.0)
	}
	assert len(race.shards) == 1
	assert control.find(race.cars, 0).holding is drive.Token.Nothing
}

// And the other one: the race used to run for ever, because the car marked as
// finished was thrown away with the copy of the field it was marked on.
test "the flag falls" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	race.clock = 100.0
	// Everybody on the last lap, a few metres short of the line.
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = put(race.track, car.seat,
			race.track.length - 30.0 - conv.itf(car.seat) * 9.0,
			conv.itf(car.seat % 2) * 4.0 - 2.0, 40.0)
		one.sheet.lap = race.track.laps
		one.sheet.sector = 3
		one.sheet.travelled = race.track.length * conv.itf(race.track.laps)
		append(cars, one)
	}
	race.cars = cars
	for frame := 0; frame < 600; frame++ {
		race = control.stepped(race, nobody(), 1.0 / 60.0)
	}
	assert race.over
	for each car in race.cars {
		assert car.sheet.finished
		assert car.sheet.finishedAt > 0.0
		assert car.sheet.lap == race.track.laps
	}
}

test "the order is total distance, not how far round the lap" {
	mut control.Race race = control.lined(4821)
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = car
		// Seat 1 has just crossed the line and is barely into the lap; seat 2 is
		// most of the way round the one before. Sorting on `along` puts seat 1 last,
		// which is exactly the wrong answer.
		if one.seat == 1 {
			one.along = 5.0
			one.sheet.travelled = 3000.0
		}
		if one.seat == 2 {
			one.along = race.track.length - 5.0
			one.sheet.travelled = 1400.0
		}
		append(cars, one)
	}
	race.cars = cars
	standings := control.order(race)
	assert control.roundSeat(standings, 0) == 1
	assert control.placeOf(race.cars, control.find(race.cars, 1))
		< control.placeOf(race.cars, control.find(race.cars, 2))
}

test "the gap to the car in front is a time" {
	mut control.Race race = control.lined(4821)
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = car
		one.speed = 50.0
		one.sheet.travelled = 1000.0 - conv.itf(one.seat) * 25.0
		append(cars, one)
	}
	race.cars = cars
	// The leader has nobody in front, and everybody else is half a second back.
	assert control.interval(race, 0) == 0.0
	assert control.interval(race, 1) > 0.0
	assert control.interval(race, 1) < 1.0
	assert control.gapped(control.interval(race, 1)) != "—"
}

test "a finished car is placed by its time, penalties and all" {
	mut control.Race race = control.lined(4821)
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = car
		if one.seat == 0 {
			one.sheet.finished = true
			one.sheet.finishedAt = 100.0
		}
		if one.seat == 1 {
			one.sheet.finished = true
			one.sheet.finishedAt = 96.0
		}
		append(cars, one)
	}
	race.cars = cars
	standings := control.order(race)
	assert control.roundSeat(standings, 0) == 1
	assert control.roundSeat(standings, 1) == 0
}

// ---------------------------------------------------------------------------
// Watching, once your own race has ended
// ---------------------------------------------------------------------------

// A race with the given seats already past the flag, in that order, and everybody
// else still out on the circuit.
func parked(seed: Int, done: Int[]): control.Race {
	mut control.Race race = control.lined(seed)
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = car
		// Spread along the lap so the running order is something in particular
		// rather than ten cars on a grid.
		one.sheet.travelled = 5000.0 - conv.itf(one.seat) * 120.0
		if indexOf(done, one.seat) is Result.Ok(at) {
			one.sheet.finished = true
			one.sheet.finishedAt = 300.0 + conv.itf(at)
		}
		append(cars, one)
	}
	race.cars = cars
	return race
}

test "a driver who has finished is shown whoever is still leading" {
	// Nobody chosen yet — `wanted` is your own seat, which is what a model that has
	// never been asked holds. The answer is the leader of those still running, and
	// it is never you.
	race := parked(4821, [3])
	assert control.following(race, 3, 3) == 0
	// And once that one has finished too, the next one still out there. Nothing had
	// to notice: the same call gives a different answer because the race did.
	after := parked(4821, [3, 0])
	assert control.following(after, 3, 0) == 1
	// A choice that is still running is kept.
	assert control.following(after, 3, 4) == 4
}

test "turning goes along the order and steps past anybody parked" {
	// Travelled falls with the seat number, so the running order is the seat order —
	// except that seat 7 has finished, and a finished car sorts ahead of everybody
	// still out there whatever distance says.
	race := parked(4821, [7])
	standings := control.order(race)
	assert control.roundSeat(standings, 0) == 7
	assert control.roundSeat(standings, 1) == 0
	assert control.roundSeat(standings, 9) == 9
	assert control.turned(race, 0, 1) == 1
	assert control.turned(race, 2, -1) == 1
	// Seat 7 has finished, so stepping onto it goes past it in both directions.
	assert control.turned(race, 6, 1) == 8
	assert control.turned(race, 8, -1) == 6
	// And it wraps rather than stopping at the end of the list.
	assert control.running(race, control.turned(race, 9, 1))
	assert control.turned(race, 7, 1) != 7
}

test "watching a race where everybody else has finished answers with you" {
	mut Int[dyn] all = []
	for seat := 0; seat < grid.field(); seat++ {
		append(all, seat)
	}
	race := parked(4821, all)
	// Every car is parked, so there is nothing to watch and nothing to pretend.
	// The window never asks in this state — the race is over and the
	// classification is up — but a function that answered with somebody else's
	// stationary car would be a camera pointed at a car park.
	assert control.following(race, 4, 4) == 4
	assert control.turned(race, 4, 1) == 4
}

test "a lap time is written the way a lap time is written" {
	assert control.clocked(0.0) == "—"
	assert control.clocked(31.5) == "31.500"
	assert control.clocked(92.25) == "1:32.250"
	assert control.clocked(9.0009) == "9.001"
	// The carry that used to print "47.1000".
	assert control.clocked(47.9996) == "48.000"
	assert control.gapped(1.25) == "+1.25"
	assert control.gapped(59.999) == "+60.00"
}

// ---------------------------------------------------------------------------
// The whole thing
// ---------------------------------------------------------------------------

test "a grand prix runs itself" {
	mut control.Race race = control.lined(4821)
	for frame := 0; frame < 4200; frame++ {
		race = control.stepped(race, nobody(), 1.0 / 60.0)
	}
	assert race.clock > 60.0
	// Everybody has been somewhere, and the leader has been round at least once.
	leader := control.find(race.cars, control.roundSeat(control.order(race), 0))
	assert leader.sheet.lap >= 1
	assert leader.sheet.best > 0.0
	for each car in race.cars {
		assert car.sheet.travelled > 200.0
		assert car.holding is drive.Token.Nothing || drive.tokenWorth(car.holding) > 0
	}
	// And the timing screen has something on it for everybody.
	standings := control.order(race)
	assert len(standings) == grid.field()
	for seat := 0; seat < grid.field(); seat++ {
		assert indexOf(standings, seat) is Result.Ok(_)
	}
}

test "the safety car cannot be called twice in a row" {
	mut control.Race race = control.lined(4821)
	race.lights = 0.0
	race.clock = 10.0
	mut drive.Car[dyn] cars = []
	for each car in race.cars {
		mut drive.Car one = car
		one.holding = drive.Token.Safety()
		one.speed = 30.0
		append(cars, one)
	}
	race.cars = cars
	pressing := [control.Asking(0, drive.Wants(0.0, 1.0, 0.0, false, true))]
	for frame := 0; frame < 20; frame++ {
		race = control.stepped(race, pressing, 1.0 / 60.0)
	}
	assert race.pace.life > 0.0
	assert race.safetyAgain > race.clock
	// Nine cars are still holding one, and none of them got to use it.
	mut Int holding = 0
	for each car in race.cars {
		if car.holding is drive.Token.Safety {
			holding = holding + 1
		}
	}
	assert holding == grid.field() - 1
}
