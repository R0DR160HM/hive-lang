// The grid
// ========
// Five teams, two cars each, and **nothing anywhere else in this program knows
// that it is five**. The field is `len(teams()) * 2`; the seats are numbered off
// that; the standings, the pit wall, the colours in the mirror and the amount of
// road the tokens are spread over all count what is here rather than a number
// somebody typed twice. Adding a sixth team is one entry in the vector below and
// nothing else at all — which is the only kind of "ready for more later" worth
// claiming, because it is the kind you can check by doing it.
//
// A SEAT is what everything else in the program calls a car by. Seat `2n` is a
// team's first driver and seat `2n + 1` is its second, so the team a seat belongs
// to is `seat / 2` and the other car in the garage is the seat with the low bit
// flipped. That is why the seat number is arithmetic rather than a lookup: the
// bots ask "is that my teammate?" several times a frame, and the answer has to be
// cheaper than a search.
//
// WHY THE CARS ARE NOT ALL THE SAME. A grid of ten identical cars driven by ten
// identical drivers produces a train, and a train is not a race. So there are two
// separate spreads here and they are deliberately not the same spread:
//
//   * **the car** (`machine`) is a team's, and both its drivers have it — a good
//     car is good in both garages, which is what makes a team mean anything;
//   * **the driver** is two numbers, and they pull in different directions.
//     `skill` is how close to the limit somebody will run — how late they brake,
//     how much of the road they use. `nerve` is how much they will lean on
//     somebody else to get past. The fast, careful driver and the slower one who
//     will put a wheel up the inside are both here, and they are not the same
//     person.
//
// A driver with high nerve is who you do not want to see in your mirror at a
// hairpin. A driver with high skill is who you will not see at all.

// One driver: what they are called, what is painted on the car, and the two
// numbers that decide how they drive.
type Driver {
	name: Str
	// Three letters, which is what fits on a timing screen and what everybody uses
	// anyway.
	tag: Str
	number: Int
	// How close to the limit they run: how late the braking is, how much of the
	// road gets used, how near the pace `circuit.hive` worked out they get.
	skill: Float
	// How much they will lean on somebody to get past, and how little room they
	// will leave. Kept apart from skill because they are not the same thing.
	nerve: Float
	// The helmet, which is the only thing that tells two cars in one livery apart
	// at forty metres. It is why it is here and not a decoration.
	helmet: Str
}

// One team: a name, a livery, a car, and two drivers.
type Team {
	name: Str
	tag: Str
	// The two colours the car is painted in — the body and everything that is not
	// the body: the wing, the airbox, the floor edge.
	body: Str
	trim: Str
	// How good the car is, as a multiplier on very nearly everything: the engine,
	// the grip and the brakes. Around one, and the spread across the field is
	// deliberately smaller than the spread across the drivers.
	machine: Float
	// Exactly two, because that is what a team enters. A static length, so the
	// compiler holds every construction to it and nothing has to check.
	drivers: Driver[2]
}

// The field. Ordered as the constructors' championship stood at the end of last
// season, which is what decides who is where in the garage and nothing else.
func teams(): Team[dyn] {
	return [
		Team("Meridian Works", "MER", "#5b6770", "#00d2be", 1.045, [
			Driver("Nils Halvard", "HAL", 1, 1.00, 0.74, "#f2f4f6"),
			Driver("Ada Okonjo", "OKO", 2, 0.965, 0.91, "#ffd166")
		]),
		Team("Scuderia Aquila", "AQU", "#c8102e", "#efe6d2", 1.020, [
			Driver("Enzo Bertoli", "BER", 7, 0.975, 0.86, "#1b2a4a"),
			Driver("Rafa Salvi", "SAL", 8, 0.925, 0.70, "#8ed081")
		]),
		Team("Vantage Grand Prix", "VNT", "#12294f", "#d4a437", 0.995, [
			Driver("Piet Rask", "RAS", 14, 0.940, 0.97, "#e0533d"),
			Driver("Camille Delaunay", "DEL", 15, 0.910, 0.66, "#c9a0dc")
		]),
		Team("Kestrel Racing", "KES", "#ff8000", "#2b2f33", 0.970, [
			Driver("Tomas Moreno", "MOR", 23, 0.900, 0.89, "#3fa9f5"),
			Driver("Jo Ashworth", "ASH", 24, 0.880, 0.61, "#f2f4f6")
		]),
		Team("Nordkap Motorsport", "NOR", "#dfe7ec", "#3fa9f5", 0.945, [
			Driver("Elin Lindqvist", "LIN", 31, 0.870, 0.78, "#c8102e"),
			Driver("Yusuf Farouk", "FAR", 32, 0.850, 0.95, "#2b2f33")
		])
	]
}

// How many cars are in the race. Counted rather than written down, which is the
// whole of what makes a sixth team one edit.
func field(): Int {
	return len(teams()) * 2
}

// Which team a seat belongs to, and which of its two cars it is.
func garage(seat: Int): Int {
	return seat / 2
}

func which(seat: Int): Int {
	return seat % 2
}

// The other car in the same garage. The low bit flipped, which is what makes
// `teammates` below arithmetic rather than a search — the bots ask it several
// times a frame, once per rival, and it has to be cheaper than looking.
func partner(seat: Int): Int {
	return garage(seat) * 2 + (1 - which(seat))
}

func teammates(one: Int, other: Int): Bool {
	return one != other && garage(one) == garage(other)
}

// The team in a seat. Every lookup that could be out of range answers with the
// first team rather than failing, because a seat out of range is a bug in the
// caller and a race that stops is a worse way to find out than a car in the wrong
// colour.
func teamOf(seat: Int): Team {
	all := teams()
	at := garage(seat)
	if all bounds at {
		return all[at]
	}
	if all bounds 0 {
		return all[0]
	}
	return Team("Privateer", "PRV", "#8b98a5", "#2b2f33", 1.0, [
		Driver("First", "ONE", 0, 0.9, 0.7, "#ffffff"),
		Driver("Second", "TWO", 0, 0.9, 0.7, "#000000")
	])
}

// The driver in a seat. `drivers` is a `Driver[2]`, and a static length is a
// promise the compiler holds every construction to — so the index needs no guard
// and there is no third case to write.
func driverOf(seat: Int): Driver {
	team := teamOf(seat)
	if which(seat) == 0 {
		return team.drivers[0]
	}
	return team.drivers[1]
}

// What goes on the timing screen: the number, then the three letters.
func board(seat: Int): Str {
	one := driverOf(seat)
	return "{one.number}  {one.tag}"
}

// The colour a car is painted. The body is the team's; the wing, the airbox and
// the floor edge are the trim; the helmet is the driver's, and is the only thing
// telling two cars in one livery apart from behind.
func bodyOf(seat: Int): Str {
	return teamOf(seat).body
}

func trimOf(seat: Int): Str {
	return teamOf(seat).trim
}

func helmetOf(seat: Int): Str {
	return driverOf(seat).helmet
}
