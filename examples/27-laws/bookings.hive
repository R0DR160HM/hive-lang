// A hotel's bookings, and three laws they keep. A cancelled booking stays
// cancelled, whatever happens to it afterwards: that `law` is proved while this file
// compiles — for every booking and every event, not for the few a test would pick —
// so if `apply` ever let one come back, the program would stop compiling and say
// which booking and which event do it. Every booking names a guest and a room: that
// one lives in the type, so every place that makes a booking or changes one has to
// keep it. And a guest only ever sees their own bookings: that one is about a table,
// so every query on it has to say so in its SQL.
//
// Nothing runs a law: `hive run` prints what `main` prints, and the laws were
// settled before any of it was written.

type Status {
    Requested
    Confirmed
    CheckedIn
    CheckedOut
    Cancelled
}

type Event {
    Confirm
    Cancel { reason: Str }
    Arrive
    Leave
}

type Booking {
    guest: Str
    room: Str
    status: Status

    law named(b: Booking) {
        assert b.guest != "" && b.room != ""
    }

}

// What one event does to a booking, written into it. A cancelled or finished
// booking stays as it is.
proc apply(booking: mut Booking, event: Event): void {
    if booking.status is Status.Cancelled || booking.status is Status.CheckedOut {
        return
    }
    switch event {
        Event.Confirm {
            if booking.status is Status.Requested {
                booking.status = Status.Confirmed()
            }
        }
        Event.Cancel(_) {
            booking.status = Status.Cancelled()
        }
        Event.Arrive {
            if booking.status is Status.Confirmed {
                booking.status = Status.CheckedIn()
            }
        }
        Event.Leave {
            if booking.status is Status.CheckedIn {
                booking.status = Status.CheckedOut()
            }
        }
    }
}

// You can use laws to ensure some fundamental truth about a function 
// (or procedure, in this case) will never change silently.
law cancelledIsFinal(booking: Booking, event: Event) {
    if booking.status is Status.Cancelled {
        mut after := booking
        apply(after, event)
        assert after.status == booking.status
    }
}

func statusName(s: Status): Str {
    switch s {
        Status.Requested { return "requested" }
        Status.Confirmed { return "confirmed" }
        Status.CheckedIn { return "checked in" }
        Status.CheckedOut { return "checked out" }
        Status.Cancelled { return "cancelled" }
    }
}

type Guest {
    name: Str
}

type Stay {
    room: Str
    status: Str
}

law ownBookingsOnly(guest: Guest) for table bookings {
    guest_name = {guest.name}
}

query saved(guest: Guest, room: Str, status: Str): void {
    INSERT INTO bookings (guest_name, room, status) VALUES ({guest.name}, {room}, {status})
}

query staysOf(guest: Guest): Stay[dyn] {
    SELECT room, status FROM bookings WHERE guest_name = {guest.name} ORDER BY room
}

proc replay(booking: mut Booking, log: Event[]): void {
    for each event in log {
        apply(booking, event)
    }
    echo "{booking.guest}, room {booking.room}: {statusName(booking.status)}"
}

proc main(): void {
    mut ada := Booking("Ada", "12", Status.Requested())
    replay(ada, [Event.Confirm(), Event.Arrive(), Event.Leave()])

    mut grace := Booking("Grace", "14", Status.Requested())
    replay(grace, [Event.Confirm(), Event.Cancel("flight moved"), Event.Arrive()])

    opened := hive.sql.pool(hive.sql.DatabaseDriver.SQLite(), ":memory:", 1, 1)
    if opened is Result.Ok(db) {
        _ := hive.sql.unsafe(db, "CREATE TABLE bookings (guest_name TEXT, room TEXT, status TEXT)")
        for each b in [ada, grace] {
            _ := hive.sql.run(db, saved(Guest(b.guest), b.room, statusName(b.status)))
        }
        echo hive.sql.run(db, staysOf(Guest("Ada")))
        hive.sql.close(db)
    }
}
