// First-class functions
// =====================
// A `func` or a `proc` can be a VALUE: passed to another callable, held in a
// name, called later. Three things produce one:
//
//   * a bare reference — the callable's name on its own (`increment`);
//   * a partial application — a call with `_` holes (`addN(1, _)`), which fixes
//     the arguments given and leaves each `_` as a parameter of the new
//     function, in order;
//   * anything that hands one of those back.
//
// A function type is a declaration with the name dropped: `func(Int): Int`, or
// `proc(Str): void`. A `func` value goes wherever a `proc` is wanted — pure
// widens to impure — and never the other way, so a `func`-typed parameter turns
// a proc value down.

// A higher-order func: it takes a function and applies it twice.
func twice(f: func(Int): Int, x: Int): Int {
	return f(f(x))
}

func addN(n: Int, x: Int): Int {
	return n + x
}

func mulN(n: Int, x: Int): Int {
	return n * x
}

func isEven(n: Int): Bool {
	return n % 2 == 0
}

func label(n: Int): Str {
	return "#{n}"
}

// The one that earns its keep on input you do not trust: an `Error` is how an
// element says it has no place in the output, so parsing and discarding happen
// in one pass and there is no half-converted vector in between.
func asPort(s: Str): Result<Int, Bool> {
	if hive.conv.sti(s) is Result.Ok(n) && n > 0 && n < 65536 {
		return Result.Ok(n)
	}
	return Result.Error(false)
}

func longerFirst(a: Str, b: Str): Bool {
	return len(a) > len(b)
}

proc main(): void {
	// A partial application fixes the first argument and leaves the second
	// open, which makes a `func(Int): Int`.
	increment := addN(1, _)
	triple := mulN(3, _)

	echo increment(41)
	echo triple(4)

	// Those values, handed to a higher-order func.
	echo twice(increment, 10)
	echo twice(triple, 2)

	// A bare reference is a value too — the name, and no call.
	op := increment
	echo op(99)

	// And a partial application can be written where it is used.
	echo twice(addN(5, _), 0)

	// A constructor takes a hole like anything else.
	make := Shout.Loud(_)
	if make("hello") is Shout.Loud(text) {
		echo text
	}

	walks()
	echo shadowing()
}

type Shout {
	Loud { text: Str }
	Quiet
}

// --- Walking a vector -------------------------------------------------------
// `map`, `filter`, `filterMap` and `sort` are builtins that take a vector and a
// function over its elements. Each hands back a NEW vector and none of them
// touches the one they were given:
//
//     map(T[], func(T): K): K[dyn]                    every element, transformed
//     filter(T[], func(T): Bool): T[dyn]              the ones that passed
//     filterMap(T[], func(T): Result<K, E>): K[dyn]   transform and select at once
//     sort(T[], func(T, T): Bool): T[dyn]             the elements, put in order
//
// The function is a `func`, never a `proc`: a walk says nothing about the order
// it runs in or how often, so there is nowhere to hang a side effect. That is
// also what lets a `func` body use one. To walk with a proc, write a `for each`
// loop — which does say.
proc walks(): void {
	echo ""
	Int[dyn] nums = [1, 2, 3, 4]

	Str[dyn] labels = map(nums, label)
	echo join(labels, " ")

	Int[dyn] evens = filter(nums, isEven)
	echo join(map(evens, label), " ")

	// A partial application walks as well as a named func.
	Int[dyn] tenfold = map(nums, mulN(10, _))
	echo join(map(tenfold, label), " ")

	// Three strings in, two ports out, and nothing in between to check.
	Str[dyn] raw = ["8080", "nope", "443"]
	Int[dyn] ports = filterMap(raw, asPort)
	echo "{len(ports)} of {len(raw)} were ports: " + join(map(ports, label), " ")

	// `sort` with no function is the type's own order; with one, it is whatever
	// the function says comes first.
	Str[3] words = ["pear", "apple", "fig"]
	echo join(sort(words), "|")
	echo join(sort(words, longerFirst), "|")
	// Neither call moved anything: `words` is as it was written.
	echo join(words, "|")
}

// --- Your own name wins -----------------------------------------------------
// A declaration of your own with a builtin's name is what your bare calls mean,
// with its own parameters and its own arity. The builtin is still there under
// its long name, `hive.<name>` — which is also what compiler-generated code
// uses, so `v bounds i` means the same thing in a program that declared a `len`
// of its own.
//
// A name you declared quietly reading as somebody else's function is not a
// surprise a compiler should spring on you, and it would make adding a builtin
// a breaking change for every program that had already used the word. Locals
// and parameters shadow the same way, and shadowing is per module: another
// file's `map` leaves this one's alone.
proc shadowing(): Str {
	Int[dyn] nums = [1, 2, 3, 4]

	// A local shadows a builtin like any other name. `filter` here holds a
	// function value, so `filter(21)` calls that and not the builtin.
	filter := mulN(2, _)
	echo filter(21)

	// The builtin, by its long name.
	return "the builtin is still there: {len(hive.filter(nums, isEven))} even"
}
