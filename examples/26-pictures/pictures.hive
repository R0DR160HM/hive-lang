// Pictures
// ========
// `hive.image.decode` reads the bytes of a PNG, JPEG, GIF or WebP file into a
// `Picture`: its `width`, its `height`, and its `pixels` — four bytes each, red,
// green, blue and alpha, row by row from the top left. `hive.image.scale` is the
// same picture at another size.
//
// The picture here is Hive's logo, and it is in no file the program opens. It
// sits in `assets/`, beside this one, which the build puts into the executable,
// and `hive.file.asset` reads it back out of there — so the program runs the
// same from any folder, copied anywhere, with nothing beside it.
//
// It is drawn the way a terminal can draw: a character a cell, darker for darker.

proc main(): void {
    stored := hive.file.asset("hive.png")
    if stored is Result.Error(why) {
        echo "the logo is not in this program: {why.message}"
        return
    }
    if stored is Result.Ok(data) {
        decoded := hive.image.decode(data)
        if decoded is Result.Error(why) {
            echo "not a picture: {why.message}"
            return
        }
        if decoded is Result.Ok(logo) {
            echo "{logo.width} by {logo.height}, {len(logo.pixels)} bytes of pixels"
            // A terminal's cell is about twice as tall as it is wide.
            draw(hive.image.scale(logo, 32, 16))
        }
    }

    // A path the build put nothing at is the same error a missing file is.
    if hive.file.asset("nothing.png") is Result.Error(why) {
        echo why.message
    }
}

// One character a pixel: nothing where the picture is see-through, and the
// darker the pixel the denser the character. Each of the four bytes a pixel is
// made of is proved in range before it is read, as every index in Hive is.
proc draw(picture: hive.image.Picture): void {
    shades := ["@", "%", "#", "*", "+", "=", "-", ":", "."]
    pixels := picture.pixels
    for y := 0; y < picture.height; y++ {
        mut line := ""
        mut shown := ""
        for x := 0; x < picture.width; x++ {
            red := (y * picture.width + x) * 4
            green := red + 1
            blue := red + 2
            alpha := red + 3
            mut cell := " "
            if pixels bounds red && pixels bounds green && pixels bounds blue && pixels bounds alpha {
                if Int(pixels[alpha]) >= 128 {
                    light := (Int(pixels[red]) * 299 + Int(pixels[green]) * 587 + Int(pixels[blue]) * 114) / 1000
                    shade := light * len(shades) / 256
                    if shades bounds shade {
                        cell = shades[shade]
                    }
                }
            }
            line += cell
            if cell != " " {
                shown = line
            }
        }
        echo shown
    }
}
