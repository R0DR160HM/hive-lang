// The code under test. Nothing here knows it is being tested — no interface to
// implement, no constructor to inject, nothing exported on purpose. A test is
// compiled into the same package, so it can already see everything.

type Item {
	name: Str
	price: Int
	qty: Int
}

func total(items: Item[]): Int {
	mut sum := 0
	for each line in items {
		sum = sum + line.price * line.qty
	}
	return sum
}

// A percentage off, refusing anything that would take the total below nothing.
func discount(subtotal: Int, percent: Int): Int {
	if percent > 100 {
		return 0
	}
	return subtotal - subtotal * percent / 100
}

// Never called by a test below, which is the point: `hive test` says so.
func describe(line: Item): Str {
	return "{line.qty} x {line.name}"
}
