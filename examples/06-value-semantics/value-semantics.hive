// Value semantics
// ===============
// Vectors, maps, and any type that holds one, are VALUES. Two names for one
// value never observe each other's writes — which is not what the Go slices
// they lower to do by default, so the compiler inserts a copy wherever sharing
// could leak a mutation into something that was supposed to stand still.
//
// The copy is only inserted where it is needed. Each binding is classified by
// the mutability of its two ends:
//
//   immutable <- immutable    alias — neither side can ever write
//   mut       <- mut          alias — shared mutable state is the intent
//   mut       <- immutable    copy
//   immutable <- mut          copy
//
// The last two are where the specification allows an alias when it is provably
// indistinguishable from a copy; this compiler does not attempt that proof and
// copies instead, which is slower and never wrong. A FRESH right-hand side — a
// literal, a `+`, a call's result — is already nobody else's and is never
// copied.
//
// When a copy is made it is deep and type-directed: a flat vector copies its
// array, a nested one copies every level, a struct copies its storage-owning
// fields, and none of it uses reflection.

proc main(): void {
	echo snapshotIsIndependent()
	echo ""
	echo mutableSharesStorage()
	echo ""
	echo deepCopyOfNestedVectors()
	echo ""
	echo structFieldsAreDeepCopied()
	echo ""
	echo aParameterIsACopyUnlessItSaysOtherwise()
}

// An immutable binding is a stable snapshot: mutating the original afterwards
// does not change it, because it was given its own copy.
proc snapshotIsIndependent(): Str {
	mut original := [1, 2, 3]
	snapshot := original      // copied: one end can write, the other cannot

	original[0] = 99          // in place, and allowed because `original` is mut

	echo snapshot             // [1 2 3]
	echo original             // [99 2 3]
	return "a snapshot stays independent of later mutations"
}

// Two `mut` bindings are one storage. This is the one case where sharing is the
// point, so nothing is copied — and it goes further than sharing an array:
// there is one slice header for both names, so even `append` and a whole
// reassignment are seen by both.
proc mutableSharesStorage(): Str {
	mut a := [1, 2, 3]
	mut b := a

	b[0] = 99

	echo a                    // [99 2 3]
	echo b                    // [99 2 3]

	mut Str[dyn] xs = ["x"]
	mut Str[dyn] ys = xs
	append(ys, "y")
	echo len(xs)              // 2 — one header, so the growth is shared
	ys = ["replaced"]
	echo xs                   // [replaced] — rebinding one rebinds both
	return "two mut bindings share one storage"
}

// The copy recurses. A snapshot of a nested vector is independent all the way
// down, so writing into a row of the original leaves the snapshot alone.
proc deepCopyOfNestedVectors(): Str {
	mut grid := [[1, 2], [3, 4]]
	snapshot := grid          // deep-copied: every row gets storage of its own

	// A row reached through an index has no length the compiler knows, so the
	// write into it is guarded.
	if grid bounds 0 {
		if grid[0] bounds 0 {
			grid[0][0] = 99
		}
	}

	echo snapshot             // [[1 2] [3 4]]
	echo grid                 // [[99 2] [3 4]]
	return "nested vectors are copied at every level"
}

type Basket {
	items: Int[dyn]
	label: Str
}

// A struct that holds a vector is a value too, so copying the struct copies the
// vector — the snapshot's items cannot be changed through the original's.
proc structFieldsAreDeepCopied(): Str {
	mut basket := Basket([1, 2, 3], "live")
	snapshot := basket        // deep-copied: `items` gets storage of its own

	append(basket.items, 99)

	echo snapshot.items       // [1 2 3]
	echo basket.items         // [1 2 3 99]
	return "a struct's vector fields are copied, not shared"
}

// Across a call it is the same rule, with the parameter's spelling for the
// second end. `mut Int[dyn]` asks for the caller's own storage; anything else
// takes a copy of it. Only a `proc` may ask — writing through a parameter is
// exactly the side effect a `func` is the absence of.
proc grow(items: mut Int[dyn], value: Int): void {
	append(items, value)
}

func countOf(items: Int[]): Int {
	return len(items)
}

proc aParameterIsACopyUnlessItSaysOtherwise(): Str {
	mut items := [1, 2]

	grow(items, 3)
	echo items                // [1 2 3] — `grow` appended to this very vector

	echo countOf(items)       // 3, counted on a copy that is gone by now
	echo items
	return "a mutex parameter takes the caller's storage; every other kind takes a copy"
}
