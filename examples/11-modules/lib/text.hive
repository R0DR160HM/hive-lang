// A module is just a .hive file — there is nothing to declare at the top of it.
// Everything it holds (procs, funcs, queries and types) is visible to whoever
// imports it; there is no pub/priv distinction yet.

type Align {
	Left
	Right
}

// Pads `word` out to `width`, putting the spaces on whichever side `align`
// leaves free.
func pad(word: Str, width: Int, align: Align): Str {
	mut out := word
	for ; len(out) < width; {
		if align is Align.Left {
			out = out + " "
		} else {
			out = " " + out
		}
	}
	return out
}

// `unit` repeated `times` over — for rules and separators.
func repeat(unit: Str, times: Int): Str {
	mut out := ""
	for i := 0; i < times; i++ {
		out = out + unit
	}
	return out
}
