// A module may import modules of its own. This one reaches for ./text, and so
// does the entrypoint — a file is loaded once however many modules import it.
//
// What it may *not* do is import (directly or through any number of steps) a
// module that leads back here: the compiler rejects an import cycle outright.
import ./text

type Item {
	name: Str
	pence: Int
}

func total(items: Item[dyn]): Int {
	mut sum := 0
	for each item in items {
		sum = sum + item.pence
	}
	return sum
}

// Pence as pounds, always with two decimals.
func money(pence: Int): Str {
	pounds := hive.conv.its(pence / 100)
	pennies := pence % 100
	if pennies < 10 {
		return "GBP " + pounds + ".0" + hive.conv.its(pennies)
	}
	return "GBP " + pounds + "." + hive.conv.its(pennies)
}

func line(item: Item): Str {
	return text.pad(item.name, 16, text.Align.Left()) + text.pad(money(item.pence), 12, text.Align.Right())
}
