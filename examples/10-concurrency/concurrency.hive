// Concurrency
// ===========
// Every call blocks the caller. Nothing about a declaration says otherwise —
// there is no `async func`, no Future and no Promise type to name — so what a
// call means is decided where it is written:
//
//   f(x)                       wait for it, yields T
//   async f(x)   (a statement) fire-and-forget: its own thread, no result
//   x := async f(a)            its own thread, and the wait moves to `x`
//   f(x) with timeout 500      wait at most 500ms, yields Result<T, _>
//   await [f(a), f(b)]         both at once, wait for both, yields T[2]
//
// None of those has a Future in it. `async f(x)` on its own keeps nothing, so
// there is nothing to hold; given a name, what the name holds is the call's own
// return type — `Str`, not a promise of one — and reading it is what waits. So
// every expression here has a type you could write down, and there is nowhere
// to forget an `await`.
import hive.task

// Two ordinary funcs. Being funcs they may print but take no mutex.
func slowShout(text: Str): Str {
	hive.task.sleep(200)
	return text + "!!!"
}

// A second one, answering with a *different* type — which is the shape the
// named `async` binding exists for.
func slowCount(text: Str): Int {
	hive.task.sleep(200)
	return len(text)
}

proc main(): void {
	// 1. Fire and forget. `async` puts the call on its own virtual thread and
	// carries on. Nothing comes back, and that is the whole of the trade.
	async slowShout("logged in the background")

	// 2. A plain call. It blocks until the value is there, and costs neither a
	// goroutine nor a channel: it is a function call.
	echo slowShout("blocking")

	// 3. The middle way: give the call a name. It starts on its own thread
	// exactly as the statement does, and *keeps* the result — the wait happens
	// where the name is read, and only if the call has not finished by then.
	held := async slowShout("started early")
	echo "main carried on"
	echo held                       // waits here for whatever is left of it
	echo len(held)                  // free: the value is in hand now

	// `held` is a plain `Str`. There is no handle type, nothing to unwrap, and
	// no way to forget to — and a second read cannot answer differently. A name
	// nothing ever reads is `async` on its own, arrived at from the other side.

	// 4. Many at once: the await-all. Every call in the list starts, then the
	// list is one barrier resolving in order into a statically-sized, fully
	// typed vector — never a dynamic or an `Any` one. All three sleep, and this
	// takes about as long as one of them.
	Str[3] shouts = await [slowShout("a"), slowShout("b"), slowShout("c")]
	echo shouts[0] + " " + shouts[1] + " " + shouts[2]

	// A list of one is legal, and still means "on its own thread, then wait".
	Str[1] alone = await [slowShout("just me")]
	echo alone[0]

	// 5. Void calls are waited for the same way. There is no value, so the
	// barrier has none either: it is a statement meaning "both of these, then
	// carry on".
	await [note("first"), note("second")]

	// 6. Work of different types. One barrier resolves to one vector and a
	// vector holds one type, so an await-all cannot mix them — names can. Two
	// threads, two types, each waited for where its own name is read.
	Str message = async slowShout("mixed")
	Int count = async slowCount("mixed")
	echo "{message} has base length {count}"

	timeouts()
	storage()
}

proc timeouts(): void {
	echo ""
	// `with timeout <ms>` may follow any call, and it changes what the call
	// yields: without it the value, with it a `Result` — running out of
	// patience is a value to handle rather than a crash.
	if slowShout("worth waiting for") with timeout 20 is Result.Error(err) {
		echo "gave up after {err.waited}ms: {err.message}"
	}

	// The timeout abandons the *waiting*, not the work: a virtual thread cannot
	// be stopped from outside, so that shout ran to completion regardless and
	// its result was dropped. Asking again with more patience gets one.
	if slowShout("worth waiting for") with timeout 2000 is Result.Ok(value) {
		echo "waited long enough: {value}"
	}

	// An await-all takes one deadline across the whole barrier, so this means
	// "both of them within two seconds", not two seconds each.
	if await [slowShout("first"), slowShout("second")] with timeout 2000 is Result.Ok(done) {
		echo join(done, " / ")
	}
}

// A mutex parameter, and the one place the call site changes what an argument
// *is*. `collect` asks for the vector itself, not a view of it, so it can
// append to storage its caller keeps reading.
proc storage(): void {
	echo ""
	mut Str[dyn] log = ["start"]

	// Waited for, the two names are one storage: this append is visible here.
	collect(log, "waited")
	echo log

	// Fired off, it is not. A thread of its own gets storage of its own, and the
	// copy is made here, before the thread starts, so there is no moment where
	// both sides could write one array. `log` never sees "fired". Keeping the
	// call's result would change nothing: what decides is the thread.
	async collect(log, "fired")
	hive.task.sleep(400)
	echo log

	// `await` spawns too, so it copies for the same reason.
	await [collect(log, "awaited")]
	echo log

	// Which is the whole rule: `mut` on the parameter says the callee may write
	// through it, and where the call is written says whose storage that is.
}

// Only a `proc` may take a mutex — writing through one is exactly the side
// effect a `func` is the absence of. The argument has to be a `mut` name (or a
// path into one): there has to be storage to point at, and its owner has to
// have said it can change.
proc collect(log: mut Str[dyn], entry: Str): void {
	hive.task.sleep(100)
	append(log, entry)
}

proc note(text: Str): void {
	hive.task.sleep(100)
	echo "noted {text}"
}
