// The vault's tests. Run them with:
//
//     hive test vault.test.hive
//
// Two kinds of test live here. The first kind is about the vault as a value —
// adding, replacing and deleting entries — and touches nothing outside itself.
// The second is about the vault as a file, and really does encrypt, write, read
// and decrypt: `hive test` builds and runs inside `vault.test.hive-build/`, so
// what those write lands in a throwaway folder rather than on top of a vault
// anybody is using.

import ./vault

// A master password the tests share. Long enough to be one `create` would have
// accepted, so that nothing here passes on a password the program itself would
// have turned down.
func master(): Str {
	return "correct horse battery staple"
}

func entries(vault: vault.Vault): Int {
	return len(vault.entries)
}

// --- The vault as a value ---------------------------------------------------

test "a new vault holds nothing" {
	empty := vault.Vault([])
	assert entries(empty) == 0
	assert vault.secretOf(empty.entries, "github") is Result.Error(_)
}

test "adding an entry stores its secret" {
	one := vault.replace(vault.Vault([]), "github", "s3cr3t")
	assert entries(one) == 1
	if vault.secretOf(one.entries, "github") is Result.Ok(secret) {
		assert secret == "s3cr3t"
	} else {
		assert false
	}
}

test "adding a name twice replaces it rather than storing it twice" {
	once := vault.replace(vault.Vault([]), "github", "old")
	twice := vault.replace(once, "github", "new")
	assert entries(twice) == 1
	if vault.secretOf(twice.entries, "github") is Result.Ok(secret) {
		assert secret == "new"
	} else {
		assert false
	}
}

test "the vault a replace answers with is a new one" {
	// Values are copied on binding, so the vault handed in is untouched — which
	// is what lets `save` be handed the new one and the old one stay valid.
	before := vault.replace(vault.Vault([]), "github", "old")
	after := vault.replace(before, "github", "new")
	if vault.secretOf(before.entries, "github") is Result.Ok(secret) {
		assert secret == "old"
	} else {
		assert false
	}
	assert entries(after) == 1
}

test "deleting one entry leaves the others" {
	mail := vault.replace(vault.Vault([]), "email", "one")
	both := vault.replace(mail, "github", "two")
	assert entries(both) == 2

	left := vault.Vault(vault.without(both.entries, "email"))
	assert entries(left) == 1
	assert vault.secretOf(left.entries, "email") is Result.Error(_)
	assert vault.secretOf(left.entries, "github") is Result.Ok(_)
}

test "deleting a name that was never there changes nothing" {
	one := vault.replace(vault.Vault([]), "github", "s3cr3t")
	left := vault.Vault(vault.without(one.entries, "never-stored"))
	assert entries(left) == 1
}

// --- The vault as a file ----------------------------------------------------

test "a vault survives being sealed, written, read and opened" {
	hive.file.delete(vault.file())

	stored := vault.replace(vault.Vault([]), "github", "s3cr3t")
	vault.save(stored, master())

	opened := vault.open(master())
	if opened is Result.Ok(reopened) {
		assert entries(reopened) == 1
		if vault.secretOf(reopened.entries, "github") is Result.Ok(secret) {
			assert secret == "s3cr3t"
		} else {
			assert false
		}
	} else {
		assert false
	}
}

test "nothing readable is left on disk" {
	hive.file.delete(vault.file())
	vault.save(vault.replace(vault.Vault([]), "github", "s3cr3t"), master())

	if hive.file.read(vault.file()) is Result.Ok(onDisk) {
		// `indexOf` on a string answers with where the text is, or Error(false)
		// if it is not there at all — which is the answer wanted for both of
		// these. The name is as much a secret as the password is.
		assert indexOf(onDisk, "s3cr3t") is Result.Error(_)
		assert indexOf(onDisk, "github") is Result.Error(_)
	} else {
		assert false
	}
}

test "the wrong master password does not open the vault" {
	hive.file.delete(vault.file())
	vault.save(vault.replace(vault.Vault([]), "github", "s3cr3t"), master())

	assert vault.open("not the master password") is Result.Error(_)
}

test "a vault changed behind the program's back is refused" {
	hive.file.delete(vault.file())
	vault.save(vault.replace(vault.Vault([]), "github", "s3cr3t"), master())

	if hive.file.read(vault.file()) is Result.Ok(sealed) {
		// Four more base64 characters is three more bytes of ciphertext. The
		// key still derives and the file still decodes; it is GCM's
		// authentication tag that refuses it.
		hive.file.write(vault.file(), sealed + "AAAA")
	} else {
		assert false
	}

	assert vault.open(master()) is Result.Error(_)
}

test "two saves of the same entries look nothing alike on disk" {
	// A fresh salt and nonce every time. Without them, an onlooker holding two
	// copies of the file would learn that nothing had changed between them.
	hive.file.delete(vault.file())
	stored := vault.replace(vault.Vault([]), "github", "s3cr3t")

	vault.save(stored, master())
	first := hive.file.read(vault.file())
	vault.save(stored, master())
	second := hive.file.read(vault.file())

	if first is Result.Ok(before) && second is Result.Ok(after) {
		assert before != after
	} else {
		assert false
	}
}

test "an absent vault is a failure to open, not a crash" {
	hive.file.delete(vault.file())
	assert vault.open(master()) is Result.Error(_)
}

// The run ends with
//
//     coverage: 27.7% of statements (33/119)
//         vault.test.hive 100.0%
//         vault.hive 26.5%
//     never exercised: create, main, run
//
// and that is the report doing its job rather than the tests falling short.
// `create`, `main` and `run` are the parts that talk to a person: they prompt,
// they read the terminal, and there is no one at the keyboard during `hive
// test`. What can be tested without a human — the vault as a value, and the
// vault as a file — is, and the report says plainly which third of the program
// that leaves. A number that flattered us here would be worth less.
