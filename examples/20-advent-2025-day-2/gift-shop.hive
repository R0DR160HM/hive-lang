// Advent of Code 2025, day 2
// ==========================
// https://adventofcode.com/2025/day/2 — on the demo input, and written to use
// as much of the language as one puzzle reasonably can.
//
// A range like `11-22` is every number from 11 to 22. Part one wants the ones
// whose digits are the same string twice; part two wants the ones whose digits
// are any string repeated, twice or more.
//
// `assert` outside a test is the ordinary one: it has to hold, and the program
// stops if it does not. So this file is its own check — it prints `Success` or
// it does not print at all.
proc main(): void {
	// The input is one line of comma-separated ranges, which is a CSV of a
	// single row — and `using` is how Hive reads one. The reader is part of the
	// compiler, so this line and the flattening below are the whole of reading
	// the file ([14.6](../../spec/14-stdlib.md#146-reading-tables-using)).
	read := using "./input.csv"
	assert read is Result.Ok(_)
	if read is Result.Ok(table) {
		ranges := rangesOf(table)
		assert partOne(ranges) == 1227775554
		assert partTwo(ranges) == 4174379265
		echo "Success"
	}
}

// Every cell of the table in order, with the empty ones left out: a trailing
// separator or a blank last line is what leaves those behind.
func rangesOf(table: Table): Str[dyn] {
	mut Str[dyn] out = []
	for each row in table {
		for each set in row {
			if set != "" {
				append(out, set)
			}
		}
	}
	return out
}

// The two ends of `11-22`, or nothing at all if it does not read as a range.
func boundsOf(set: Str): Result<Int[2], Bool> {
	edges := split(set, "-")
	if edges bounds 1 {
		low := hive.conv.sti(edges[0])
		high := hive.conv.sti(edges[1])
		if low is Result.Ok(from) && high is Result.Ok(to) {
			return Result.Ok([from, to])
		}
	}
	return Result.Error(false)
}

func partOne(ranges: Str[]): Int {
	mut total := 0
	for each set in ranges {
		if boundsOf(set) is Result.Ok(edges) {
			for i := edges[0]; i <= edges[1]; i++ {
				if isDoubled(i) {
					total += i
				}
			}
		}
	}
	return total
}

// A number whose digits are one half written twice. A `Str` has no subscript in
// Hive, so the digits are taken apart with `split(text, "")` and compared as
// vectors — and `==` on two vectors compares their elements.
func isDoubled(n: Int): Bool {
	digits := split("{n}", "")
	if len(digits) % 2 != 0 {
		return false
	}
	upper := len(digits) / 2
	lower := upper - 1
	// Both bounds are proved before either slice is taken. A slice's high bound
	// is inclusive, so `[:lower]` is the first half and `[upper:]` the second.
	if digits bounds lower && digits bounds upper {
		return digits[:lower] == digits[upper:]
	}
	return false
}

func partTwo(ranges: Str[]): Int {
	mut total := 0
	for each set in ranges {
		if boundsOf(set) is Result.Ok(edges) {
			for i := edges[0]; i <= edges[1]; i++ {
				if isRepeated(i) {
					total += i
				}
			}
		}
	}
	return total
}

// A number whose digits are some shorter string repeated — twice, or ten times.
// Every prefix up to half the length is tried, repeated until it is long enough,
// and compared with the whole.
func isRepeated(n: Int): Bool {
	digits := split("{n}", "")
	whole := join(digits, "")
	for size := 1; size <= len(digits) / 2; size++ {
		// A computed index has nothing to hang a guard on, so it is bound to a
		// name and the name is what gets proved.
		last := size - 1
		if digits bounds last {
			unit := join(digits[:last], "")
			mut grown := unit
			for ; len(grown) < len(whole); {
				grown = grown + unit
			}
			if grown == whole {
				return true
			}
		}
	}
	return false
}
