// Countries, built in
// ===================
// A country's name from its code, with no file to open and nothing to parse
// when the program runs. `countries() with compiler` reads countries.csv, beside
// this file, once, while the program builds, and the map it answers with is
// built into the executable in the call's place: copied anywhere, the program
// still knows every country, without the file.
//
// Only the entrypoint may write `with compiler`, and the call runs from the
// entrypoint's folder, so the path is the one beside this file.

func countries(): hive.map.Map<Str, Str> {
    Result.Ok(rows) := hive.file.csv("countries.csv", ",") else {
        Result.Error(why) { panic why.message }
    }
    return hive.map.fromTable(rows)
}

proc main(): void {
    names := countries() with compiler
    for each code in ["BR", "JP", "PT", "XX"] {
        if hive.map.get(names, code) is Result.Ok(name) {
            echo "{code}: {name}"
        } else {
            echo "{code}: no such country"
        }
    }
}
