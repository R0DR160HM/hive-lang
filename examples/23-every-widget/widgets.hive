// Every widget
// ============
// One window holding every hive.ui widget but the two that draw a world (`scene`
// and `inset`, which 19 and 22 are about), with every attribute and every event
// among them, all doing something. On Windows and Linux the program draws the
// window itself; elsewhere, and under HIVE_WINDOW=print, the same tree is a page.
//
//     hive run examples/23-every-widget/widgets.hive
//     hive test examples/23-every-widget/widgets.test.hive
import hive.conv
import hive.task
import hive.ui

type City {
	name: Str
	state: Str
	people: Int
	capital: Bool
}

type Msg {
	Searched { text: Str }
	Chose { region: Str }
	Capitals { only: Bool }
	Least { text: Str }
	Sorted { column: Int }
	Picked { row: Int }
	Visited { date: Str }
	Zoomed { level: Str }
	Noted { text: Str }
	Opened
	Named { text: Str }
	Typed { secret: Str }
	SignedIn { secret: Str }
	Closed
	Saving
	Saved
	Dismissed
}

type Model {
	search: Str
	region: Str
	capitalsOnly: Bool
	least: Str
	sortedBy: Int
	picked: Str
	visit: Str
	zoom: Str
	notes: Str
	signing: Bool
	name: Str
	secret: Str
	who: Str
	saving: Bool
	saved: Bool
}

func fresh(): Model {
	return Model("", "Every region", false, "", 2, "", "2026-10-12", "50", "", false, "", "", "", false, false)
}

// People in thousands, from the 2022 census.
func cities(): City[dyn] {
	return [
		City("São Paulo", "SP", 11451, true),
		City("Rio de Janeiro", "RJ", 6211, true),
		City("Brasília", "DF", 2817, true),
		City("Fortaleza", "CE", 2428, true),
		City("Salvador", "BA", 2418, true),
		City("Belo Horizonte", "MG", 2315, true),
		City("Manaus", "AM", 2063, true),
		City("Curitiba", "PR", 1773, true),
		City("Recife", "PE", 1488, true),
		City("Porto Alegre", "RS", 1332, true),
		City("Campinas", "SP", 1139, false),
		City("Uberlândia", "MG", 713, false),
		City("Joinville", "SC", 616, false),
		City("Londrina", "PR", 555, false),
		City("Florianópolis", "SC", 537, true)
	]
}

func regions(): Str[dyn] {
	return ["Every region", "North", "Northeast", "Center-West", "Southeast", "South"]
}

func regionOf(state: Str): Str {
	if state == "SP" || state == "RJ" || state == "MG" { return "Southeast" }
	if state == "PR" || state == "SC" || state == "RS" { return "South" }
	if state == "CE" || state == "BA" || state == "PE" { return "Northeast" }
	if state == "AM" { return "North" }
	return "Center-West"
}

func shown(model: Model): City[dyn] {
	mut floor := 0
	if hive.conv.sti(model.least) is Result.Ok(least) {
		floor = least
	}
	mut City[dyn] kept = []
	for each city in cities() {
		if keeps(model, city, floor) {
			append(kept, city)
		}
	}
	return sort(kept, before(model.sortedBy, _, _))
}

func keeps(model: Model, city: City, floor: Int): Bool {
	if model.capitalsOnly && city.capital == false { return false }
	if model.region != "Every region" && regionOf(city.state) != model.region { return false }
	if city.people < floor { return false }
	return model.search == "" || indexOf(city.name, model.search) is Result.Ok(_)
}

func before(column: Int, a: City, b: City): Bool {
	if column == 0 { return a.name < b.name }
	if column == 1 { return a.state < b.state }
	return a.people > b.people
}

func tabled(list: City[]): Table {
	mut Str[dyn] cells = ["City", "State", "People"]
	for each city in list {
		append(cells, city.name)
		append(cells, city.state)
		append(cells, "{city.people} thousand")
	}
	return toTable(cells, 3)
}

func view(model: Model): ui.View {
	list := shown(model)
	mut ui.View[dyn] layers = [page(model, list)]
	if model.signing {
		append(layers, signIn(model))
	}
	if model.saved {
		append(layers, toast())
	}
	return ui.column([ui.grow(1)], layers)
}

func page(model: Model, list: City[]): ui.View {
	return ui.column([ui.gap(16), ui.pad(20), ui.grow(1), ui.scroll(ui.Axis.Vertical())], [
		header(model),
		ui.text([ui.tone(ui.Tone.Muted())], "Every widget hive.ui has but the 3D ones, in one window."),
		ui.row([ui.gap(8), ui.align(ui.Align.Center())], [
			ui.input([ui.kind(ui.InputKind.Search()), ui.placeholder("Search"), ui.onInput(Msg.Searched(_))], model.search),
			ui.select([ui.onChoose(Msg.Chose(_))], regions(), model.region),
			ui.input([ui.kind(ui.InputKind.Number()), ui.placeholder("At least, in thousands"),
				ui.width(210), ui.onInput(Msg.Least(_))], model.least),
			ui.checkbox([ui.onToggle(Msg.Capitals(_))], "Capitals only", model.capitalsOnly)
		]),
		ui.table([ui.onSort(Msg.Sorted(_)), ui.onPick(Msg.Picked(_))], tabled(list)),
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.Muted())],
			"{len(list)} cities. Click a heading to sort by it, and a row to pick it."),
		ui.row([ui.gap(16), ui.align(ui.Align.Start())], [
			chart(model, list),
			details(model)
		]),
		ui.row([ui.gap(8), ui.align(ui.Align.Center()), ui.justify(ui.Justify.Between())], [
			ui.text([ui.size(ui.TextSize.Subtitle())], "Planning a visit"),
			ui.row([ui.gap(8), ui.align(ui.Align.Center())], [
				ui.text([], "on"),
				ui.input([ui.kind(ui.InputKind.Date()), ui.onInput(Msg.Visited(_))], model.visit),
				ui.text([], "chart"),
				ui.input([ui.kind(ui.InputKind.Range()), ui.hint("How tall the chart is"), ui.onInput(Msg.Zoomed(_))], model.zoom)
			])
		]),
		ui.textarea([ui.placeholder("Notes about the trip"), ui.height(96), ui.onInput(Msg.Noted(_))], model.notes),
		ui.row([ui.gap(8), ui.align(ui.Align.Center())], [
			ui.button([ui.on(Msg.Saving()), ui.busy(model.saving), ui.hint("Pretends to save the notes")], "Save notes"),
			saving(model),
			ui.spacer(),
			ui.image([ui.width(84), ui.hint("A flag, drawn for this example")], "/_hive/asset/flag.png", "A flag")
		])
	])
}

func header(model: Model): ui.View {
	mut Str who = "Not signed in"
	if model.who != "" {
		who = "Signed in as {model.who}"
	}
	return ui.row([ui.gap(10), ui.align(ui.Align.Center())], [
		ui.icon([ui.tone(ui.Tone.Warn())], ui.Icon.Star()),
		ui.text([ui.heading(1), ui.size(ui.TextSize.Title())], "Cities of Brazil"),
		ui.spacer(),
		ui.text([ui.tone(ui.Tone.Muted())], who),
		ui.button([ui.on(Msg.Opened())], "Sign in")
	])
}

// A spinner while saving, and nothing otherwise: `none` holds its place either way.
func saving(model: Model): ui.View {
	if model.saving {
		return ui.spinner([])
	}
	return ui.none()
}

func picked(model: Model, list: City[]): Result<City, Bool> {
	for each city in list {
		if city.name == model.picked {
			return Result.Ok(city)
		}
	}
	return Result.Error(false)
}

// Bars in the canvas's own units: a hundred across, forty up, whatever size it is drawn.
func chart(model: Model, list: City[]): ui.View {
	mut most := 1
	for each city in list {
		if city.people > most {
			most = city.people
		}
	}
	mut ui.Mark[dyn] marks = [
		ui.path([ui.paint(ui.Tone.Muted()), ui.thick(0.3)], [4.0, 34.0, 96.0, 34.0])
	]
	mut count := len(list)
	if count == 0 {
		count = 1
	}
	wide := 92.0 / hive.conv.itf(count)
	mut at := 0
	for each city in list {
		tall := 30.0 * hive.conv.itf(city.people) / hive.conv.itf(most)
		x := 4.0 + wide * (hive.conv.itf(at) + 0.5)
		mut ui.Tone tone = ui.Tone.HEX("#1d9bf0")
		if city.name == model.picked {
			tone = ui.Tone.Warn()
			append(marks, ui.patch([ui.paint(ui.Tone.Danger())], [x - 1.2, 34.0 - tall - 3.0, x + 1.2, 34.0 - tall - 3.0, x, 34.0 - tall - 1.2]))
		}
		append(marks, ui.bar([ui.paint(tone)], x, 34.0 - tall / 2.0, wide * 0.7, tall))
		append(marks, ui.words([ui.paint(ui.Tone.Muted())], x, 37.0, 2.2, city.state))
		at = at + 1
	}
	append(marks, ui.dot([ui.paint(ui.Tone.RGBA(244, 33, 46, 200))], 96.0, 4.0, 1.2))
	append(marks, ui.words([], 88.0, 4.0, 2.4, "peak {most}"))
	mut level := 50
	if hive.conv.sti(model.zoom) is Result.Ok(zoom) {
		level = zoom
	}
	return ui.canvas([ui.region(0.0, 0.0, 100.0, 40.0), ui.width(560), ui.height(120 + level * 2),
		ui.background(ui.Tone.Muted())], marks)
}

func details(model: Model): ui.View {
	found := picked(model, cities())
	if found is Result.Ok(city) {
		mut Str kind = "a city"
		if city.capital {
			kind = "a state capital"
		}
		return ui.column([ui.gap(4), ui.pad(14), ui.grow(1), ui.background(ui.Tone.Muted())], [
			ui.text([ui.heading(3)], city.name),
			ui.text([], "{city.people} thousand people, {kind} in {city.state}, in the {regionOf(city.state)}."),
			ui.link([], "https://en.wikipedia.org/wiki/" + replaceAll(city.name, " ", "_"), "Read about it")
		])
	}
	return ui.column([ui.gap(4), ui.pad(14), ui.grow(1), ui.background(ui.Tone.Muted())], [
		ui.text([ui.tone(ui.Tone.Muted())], "Pick a row to see a city here."),
		ui.link([ui.on(Msg.Opened())], "#", "or sign in")
	])
}

func signIn(model: Model): ui.View {
	return ui.overlay([ui.pad(24), ui.width(360), ui.onDismiss(Msg.Closed())], ui.column([ui.gap(12)], [
		ui.text([ui.heading(2)], "Sign in"),
		ui.input([ui.kind(ui.InputKind.Text()), ui.placeholder("Name"), ui.onInput(Msg.Named(_))], model.name),
		ui.input([ui.kind(ui.InputKind.Password()), ui.placeholder("Password, then Enter"),
			ui.onInput(Msg.Typed(_)), ui.onSubmit(Msg.SignedIn(_))], model.secret),
		ui.row([ui.gap(8), ui.justify(ui.Justify.End())], [
			ui.button([ui.on(Msg.Closed())], "Cancel"),
			ui.button([ui.on(Msg.SignedIn(model.secret)), ui.tone(ui.Tone.Good()), ui.disabled(model.name == "")], "Sign in")
		])
	]))
}

// Pinned to a corner, so nothing behind it is dimmed and every click around it lands.
func toast(): ui.View {
	return ui.overlay([ui.align(ui.Align.End()), ui.justify(ui.Justify.End())],
		ui.row([ui.gap(10), ui.pad(12), ui.align(ui.Align.Center()), ui.background(ui.Tone.Good())], [
			ui.icon([], ui.Icon.Check()),
			ui.text([], "Notes saved"),
			ui.button([ui.on(Msg.Dismissed())], "OK")
		]))
}

proc update(model: mut Model, msg: Msg, window: Address<Msg>): Msg {
	if msg is Msg.Searched(text) {
		model.search = text
	} else if msg is Msg.Chose(region) {
		model.region = region
	} else if msg is Msg.Capitals(only) {
		model.capitalsOnly = only
	} else if msg is Msg.Least(text) {
		model.least = text
	} else if msg is Msg.Sorted(column) {
		model.sortedBy = column
	} else if msg is Msg.Picked(row) {
		list := shown(model)
		if list bounds row {
			model.picked = list[row].name
		}
	} else if msg is Msg.Visited(date) {
		model.visit = date
	} else if msg is Msg.Zoomed(level) {
		model.zoom = level
	} else if msg is Msg.Noted(text) {
		model.notes = text
	} else if msg is Msg.Opened {
		model.signing = true
	} else if msg is Msg.Named(text) {
		model.name = text
	} else if msg is Msg.Typed(secret) {
		model.secret = secret
	} else if msg is Msg.SignedIn(_secret) {
		if model.name != "" {
			model.who = model.name
			model.signing = false
			model.secret = ""
		}
	} else if msg is Msg.Closed {
		model.signing = false
	} else if msg is Msg.Saving {
		model.saving = true
		async settle(window)
	} else if msg is Msg.Saved {
		model.saving = false
		model.saved = true
	} else if msg is Msg.Dismissed {
		model.saved = false
	}
	return msg
}

// Off the window's thread, so the window keeps drawing its spinner meanwhile.
proc settle(window: Address<Msg>): void {
	hive.task.sleep(900)
	async window(Msg.Saved())
}

proc main(): void {
	opened := spawn(ui.window("Every widget", view, update), fresh())
	if opened is Result.Error(problem) {
		panic problem
	}
}
