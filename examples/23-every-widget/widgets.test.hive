// The window's own tests. Run them with:
//
//     hive test widgets.test.hive
//
// `update` is an ordinary proc and a view is a value, so neither needs a window.
import ./widgets
import hive.ui

func nameOf(city: widgets.City): Str {
	return city.name
}

func names(model: widgets.Model): Str {
	return join(map(widgets.shown(model), nameOf), ",")
}

test "the filters narrow the table and a heading sorts it" {
	mut widgets.Model model = widgets.fresh()
	Address<widgets.Msg> window = at(#Widgets)
	widgets.update(model, widgets.Msg.Chose("South"), window)
	assert names(model) == "Curitiba,Porto Alegre,Joinville,Londrina,Florianópolis"
	widgets.update(model, widgets.Msg.Capitals(true), window)
	assert names(model) == "Curitiba,Porto Alegre,Florianópolis"
	widgets.update(model, widgets.Msg.Sorted(0), window)
	assert names(model) == "Curitiba,Florianópolis,Porto Alegre"
	widgets.update(model, widgets.Msg.Least("1500"), window)
	assert names(model) == "Curitiba"
}

test "a picked row stays picked however the table is sorted" {
	mut widgets.Model model = widgets.fresh()
	Address<widgets.Msg> window = at(#Widgets)
	widgets.update(model, widgets.Msg.Picked(2), window)
	assert model.picked == "Brasília"
	widgets.update(model, widgets.Msg.Sorted(0), window)
	assert model.picked == "Brasília"
	widgets.update(model, widgets.Msg.Picked(99), window)
	assert model.picked == "Brasília"
}

test "signing in takes a name, and the dialog closes on it" {
	mut widgets.Model model = widgets.fresh()
	Address<widgets.Msg> window = at(#Widgets)
	widgets.update(model, widgets.Msg.Opened(), window)
	widgets.update(model, widgets.Msg.SignedIn("secret"), window)
	assert model.signing
	widgets.update(model, widgets.Msg.Named("Ada"), window)
	widgets.update(model, widgets.Msg.SignedIn("secret"), window)
	assert model.signing == false
	assert model.who == "Ada"
}

test "the view is the model's" {
	mut widgets.Model model = widgets.fresh()
	Address<widgets.Msg> window = at(#Widgets)
	widgets.update(model, widgets.Msg.Searched("Rio"), window)
	page := ui.html(widgets.view(model))
	assert indexOf(page, "Rio de Janeiro") is Result.Ok(_)
	assert indexOf(page, "Recife") is Result.Error(_)
	assert indexOf(page, "Sign in") is Result.Ok(_)
}
