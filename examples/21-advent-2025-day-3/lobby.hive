// Advent of Code 2025, day 3
// ==========================
// https://adventofcode.com/2025/day/3 — on the demo input.
//
// Each line is a row of batteries, one digit each. Take the biggest, then the
// biggest of the ones after it, and read the two as a two-digit number; the
// answer is those added up.
//
// The interesting part is that every index below is proved in range at compile
// time. A `[dyn]` vector has no length the compiler knows, so each read is
// either under a `bounds` guard or comes from a counting loop — and the
// compiler refuses the program otherwise rather than trusting it.
import hive.file

proc main(): void {
	mut joltage := 0

	if hive.file.lines("./input.txt") is Result.Ok(rows) {
		for each row in rows {
			bank := digitsOf(row)
			if len(bank) > 1 {
				joltage += batteries(bank)
			}
		}
	}

	echo joltage
	assert joltage == 357
}

// The two biggest digits, in the order the puzzle wants them: the largest
// anywhere but the last place, and then the largest after it.
// A guard proves the indexes in the branch it opens, so the comparison goes in
// the body rather than after another `&&` in the guard itself: what an earlier
// conjunct proved is not carried into a later one.
func batteries(bank: Int[]): Int {
	mut biggest := 0
	for i := 1; i < len(bank) - 1; i++ {
		if bank bounds i && bank bounds biggest {
			if bank[i] > bank[biggest] {
				biggest = i
			}
		}
	}
	mut second := biggest + 1
	for i := second; i < len(bank); i++ {
		if bank bounds i && bank bounds second {
			if bank[i] > bank[second] {
				second = i
			}
		}
	}
	if bank bounds biggest && bank bounds second {
		return bank[biggest] * 10 + bank[second]
	}
	return 0
}

// A row of digits as numbers. `split(text, "")` takes a Str apart into its
// characters all at once, which is what a walk wants, and anything that does not
// read as a digit is left out.
func digitsOf(row: Str): Int[dyn] {
	mut Int[dyn] out = []
	for each character in split(row, "") {
		if hive.conv.sti(character) is Result.Ok(digit) {
			append(out, digit)
		}
	}
	return out
}
