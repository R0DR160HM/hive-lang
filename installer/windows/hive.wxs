<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Hive" Manufacturer="Hive" Version="$(var.Version)"
           UpgradeCode="1647d0b4-7821-4245-9b43-f25dd4230c7b"
           Scope="perUser" Compressed="yes">
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer Hive is already installed. `hive use` switches it to an older release." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="RememberedFolder" Root="HKCU" Key="Software\Hive" Name="InstallFolder" Type="raw" />
    </Property>

    <!-- Not %LOCALAPPDATA%\Hive: that is the cache Hive programs keep their window profiles in. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Hive" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Hive">
      <Component Id="Hive" Directory="INSTALLFOLDER" Guid="bce97811-8c18-45e3-bf59-34b26067fc91">
        <RegistryKey Root="HKCU" Key="Software\Hive" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </RegistryKey>
        <CreateFolder />
        <!-- hive.exe, and the hive.exe~ `hive use` sets aside, are downloads rather than files this package carries. -->
        <RemoveFile Id="Compiler" Name="hive.exe*" On="uninstall" />
        <RemoveFolder Id="Folder" On="uninstall" />
        <RemoveFolder Id="Programs" Directory="UserPrograms" On="uninstall" />
      </Component>
    </Feature>

    <Binary Id="HiveSetup" SourceFile="$(var.SetupExe)" />
    <!-- The trailing `.` keeps INSTALLFOLDER's trailing `\` from escaping the closing quote. -->
    <CustomAction Id="FetchHive" BinaryRef="HiveSetup" ExeCommand="fetch $(var.Version) &quot;[INSTALLFOLDER].&quot; [UILevel]"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <!-- Not the Environment table: it adds an entry spelled with no trailing `\` a second time, and never reads the system PATH. -->
    <CustomAction Id="UndoAddToPath" BinaryRef="HiveSetup" ExeCommand="path remove" Execute="rollback" Impersonate="yes" Return="ignore" />
    <CustomAction Id="AddToPath" BinaryRef="HiveSetup" ExeCommand="path add &quot;[INSTALLFOLDER].&quot;"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="RemoveFromPath" BinaryRef="HiveSetup" ExeCommand="path remove" Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="OfferGo" BinaryRef="HiveSetup" ExeCommand="go" Execute="immediate" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="RemoveFromPath" Before="RemoveRegistryValues" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="FetchHive" After="InstallFiles" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="UndoAddToPath" After="WriteRegistryValues" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="AddToPath" After="UndoAddToPath" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OfferGo" Condition="NOT Installed" />
    </UI>
  </Package>
</Wix>
