# The compiler binary, built by ./bootstrap. `hivec.exe` is the same thing on
# Windows; `./hive` and `hive.cmd` are the scripts that find it, and they are
# tracked. No compiler binary is tracked at all: the one a build starts from is
# downloaded from a release, and `seed/` holds only the pin naming it.
src/hivec
src/hivec.exe

# A compiler downloaded to bootstrap with — by the workflow into `.seed/`, or by
# hand into `seed/`. What is tracked there is `pinned.txt`, not the binary.
/.seed/
seed/hivec-*

# An executable a `hive build` left beside its entrypoint. On Unix it is named
# after the entrypoint and has no extension, which is why the rules below
# whitelist what is tracked rather than trying to name what is not.
*.exe

# What an editor or a desktop leaves behind — and, on Windows, what `go build`
# does: it cannot overwrite a running executable, so it moves the old one aside
# under the same name with a `~` on the end.
.DS_Store
*~
*.swp

# Claude Code's own settings, shared and personal alike: whose tool built this
# is not the repository's business.
.claude/

# What a build leaves beside an entrypoint: the generated Go module, and the
# executable the Go toolchain made from it.
*-build/

# Where the workflow puts the binaries it cross-compiles.
/dist/

# A program the end-to-end suite compiled. The source and the expected output
# are what is tracked; the binary is not.
test/e2e/*
!test/e2e/*.hive
!test/e2e/*.expected
!test/e2e/lib/
!test/e2e/run

# What a test writes for itself.
test/_program/

# What running an example leaves beside it: the generated Go module (covered
# above) and, if it was built rather than run, the executable. The sources, the
# data an example reads and the output it is expected to print are tracked; the
# rest is generated.
examples/*/*
!examples/*/
!examples/*/*.hive
!examples/*/*.expected
# What an example reads: a separated-value file, a workbook, a puzzle's input.
!examples/*/*.csv
!examples/*/*.tsv
!examples/*/*.txt
!examples/*/*.xlsx
!examples/*/*.ods
# A module of an example's own, and the one Go file an example imports.
!examples/*/lib/
!examples/*/*.go
# What an example writes for itself — a database, an encrypted vault — is
# generated, and so is the lock file a remote import would leave.
examples/*/*.db
examples/*/*.dat

# What `hive agents` writes for a coding agent to read: one short page per
# feature of the language, out of the compiler that ran it. Regenerated rather
# than committed, so that it can never describe a compiler nobody here has.
.hivedocs/
