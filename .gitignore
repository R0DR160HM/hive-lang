# Gleam
/build
*.beam
*.ez
erl_crash.dump

# Hive build output (generated by `hive build` next to each entrypoint)
*.hive-build/

# Compiled example binaries. On Linux/macOS they have no extension (the
# binary is named after the .hive entrypoint), so only whitelisted source and
# asset files are tracked inside code-examples/.
*.exe
code-examples/**
!code-examples/**/
!code-examples/**/*.hive
!code-examples/**/*.csv
!code-examples/**/*.xlsx
!code-examples/**/*.ods
# A Go file an example imports through the FFI, and the lock file a remote
# import writes beside the entrypoint — which belongs in version control for the
# same reason it exists: it is what makes another machine build the same program.
!code-examples/**/*.go
!code-examples/**/*.hive-lock

# ...but never a build directory, whose contents are generated — including the
# `.go` the line above would otherwise have let back in. This comes last because
# the last matching rule is the one that decides.
code-examples/**/*.hive-build/
