#!/bin/sh
# Builds classes.dex, the WebView host every Hive app carries, and writes it
# into src/shim.hive for the compiler to carry.
#
#   sh android/shim/build            build it (needs a JDK and an Android SDK)
#   sh android/shim/build --check    hold what is committed against its source
#
# It is the same dex in every app — an activity's Java package and an
# application's id are allowed to disagree — so this runs when the shim changes
# and never on the machine of somebody compiling a Hive program. Neither a JDK
# nor an SDK is a dependency of Hive itself.
set -eu

here=$(dirname "$0")
carried="$here/../../src/shim.hive"
stamp="// Built from android/shim/java at "

# What the Java amounts to: every path and its text, carriage returns dropped so
# a Windows worktree and a Linux runner agree. Recorded when the dex is built
# and checked against later, because the dex itself cannot be compared — javac
# and d8 are not promised to emit the same bytes twice on different machines,
# and the version of each is not something a repository can hold still.
fingerprint() {
	(
		cd "$here"
		find java -name '*.java' | sort | while read -r file; do
			printf '%s\n' "$file"
			tr -d '\r' < "$file"
		done
	) | sha256sum | cut -d' ' -f1
}

# The dex, and the hex src/shim.hive carries, as the same text. `od -v` is not
# optional: without it od folds repeated lines into `*`, and a dex is full of
# runs of zeros.
dexAsHex() {
	od -An -v -tx1 "$here/classes.dex" | tr -d ' \n'
}

carriedAsHex() {
	sed -n 's/^\t\t//p' "$carried" | tr -d '\n'
}

if [ "${1:-}" = "--check" ]; then
	wrong=0

	if [ ! -f "$here/classes.dex" ] || [ ! -f "$carried" ]; then
		echo "shim: classes.dex or src/shim.hive is missing" >&2
		exit 1
	fi

	if [ "$(carriedAsHex)" != "$(dexAsHex)" ]; then
		echo "shim: src/shim.hive does not carry android/shim/classes.dex." >&2
		echo "      The two are written together; one of them was committed alone." >&2
		wrong=1
	fi

	recorded=$(sed -n "s|^$stamp||p" "$carried")
	now=$(fingerprint)
	if [ -z "$recorded" ]; then
		echo "shim: src/shim.hive records no source it was built from." >&2
		wrong=1
	elif [ "$recorded" != "$now" ]; then
		echo "shim: android/shim/java has changed since classes.dex was built." >&2
		echo "      built from $recorded" >&2
		echo "      java is at $now" >&2
		wrong=1
	fi

	if [ "$wrong" -ne 0 ]; then
		echo "" >&2
		echo "      Run 'sh android/shim/build' and commit android/shim/classes.dex" >&2
		echo "      and src/shim.hive together." >&2
		exit 1
	fi
	echo "shim: src/shim.hive is the dex android/shim/java builds"
	exit 0
fi

sdk=${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$LOCALAPPDATA/Android/Sdk}}
api=${HIVE_ANDROID_API:-35}
tools=${HIVE_ANDROID_BUILD_TOOLS:-35.0.0}

jar="$sdk/platforms/android-$api/android.jar"
[ -f "$jar" ] || { echo "shim: no android.jar at $jar" >&2; exit 1; }

# The SDK's own launchers are .bat on Windows and extensionless everywhere else.
d8="$sdk/build-tools/$tools/d8"
[ -x "$d8" ] || d8="$d8.bat"
[ -f "$d8" ] || { echo "shim: no d8 at $d8" >&2; exit 1; }

classes="$here/classes"
rm -rf "$classes"
mkdir -p "$classes"

# -source/-target 8 keeps d8 from having to desugar more than it must.
javac -nowarn -source 8 -target 8 -bootclasspath "$jar" -classpath "$jar" \
	-d "$classes" $(find "$here/java" -name '*.java')

# EVERY class file, not just the named ones: javac emits an anonymous class as a
# file of its own, and a dex missing one fails at runtime rather than at build
# time, with NoClassDefFoundError on the line that needed it.
found=$(find "$classes" -name '*.class' | sort)
echo "shim: dexing"
echo "$found" | sed 's/^/  /'

# shellcheck disable=SC2086
"$d8" --min-api 24 --lib "$jar" --output "$here" $found

# The compiler carries the dex, because a machine compiling a Hive program has
# no JDK to build one with. Hex rather than bytes: nothing binary is tracked
# here, and hex reviews as a diff.
#
# Written with LF, which is what a blob holds and what a runner checks out. A
# Windows worktree is CRLF through core.autocrlf and still diffs clean, while
# writing CRLF here would make --check fail on a difference that is not one.
tab=$(printf '\t')
{
	cat <<'OPENING'
// The WebView host every Hive app carries
// =======================================
// One fixed dex: an activity's Java package and an application's id are allowed
// to disagree, so the same shim serves every app and is built once by CI rather
// than on the machine of somebody compiling a Hive program. Carried as hex
// because the repository's tree is text.
//
// Regenerated by `android/shim/build`; its source is under `android/shim/java`,
// and `--check` holds this against it.
OPENING
	printf '%s%s\n' "$stamp" "$(fingerprint)"
	cat <<'SIGNATURE'
func dexHex(): Str {
	return `
SIGNATURE
	# awk rather than sed, because tr left the stream with no trailing newline
	# and awk terminates every record it prints, including the last.
	dexAsHex | fold -w 76 | awk -v t="$tab$tab" '{print t $0}'
	cat <<'CLOSING'
`
}
CLOSING
} > "$carried"

ls -l "$here/classes.dex"
echo "shim: carried into src/shim.hive"
