// Tests for `src/hivec`.
//
// The command line, which is the whole of what that file is. Two parts of it
// have a decision in them, and they are what is here: what followed the
// entrypoint on a `build` — one flag, both its spellings, and the four ways of
// getting it wrong — and what followed `hive version`, which is nothing.
import ../src/hivec
import ../src/text

test "a build with no flags asks for this machine" {
	asked := hivec.askedFor([])
	assert asked.target == ""
	assert asked.error == ""
}

test "--target takes the platform after it" {
	asked := hivec.askedFor(["--target", "linux/arm64"])
	assert asked.target == "linux/arm64"
	assert asked.error == ""
}

test "--target= is the same flag spelled the other way" {
	asked := hivec.askedFor(["--target=linux/arm64"])
	assert asked.target == "linux/arm64"
	assert asked.error == ""
}

test "a platform with no slash is left for the toolchain to refuse" {
	// Reading the flag and knowing the platforms are two jobs. This one only
	// says what was written down; `go tool dist list` is what says whether it
	// exists, and it is asked later.
	asked := hivec.askedFor(["--target", "sparc"])
	assert asked.target == "sparc"
	assert asked.error == ""
}

test "the flag said twice takes the last one, as every flag does" {
	asked := hivec.askedFor(["--target", "linux/arm64", "--target=darwin/arm64"])
	assert asked.target == "darwin/arm64"
	assert asked.error == ""
}

test "--target with nothing after it is refused" {
	asked := hivec.askedFor(["--target"])
	assert asked.target == ""
	assert asked.error != ""
}

test "--target= with nothing after it is the same mistake" {
	asked := hivec.askedFor(["--target="])
	assert asked.target == ""
	assert asked.error != ""
}

test "a flag this does not know is refused rather than skipped" {
	// The whole point: a build that ignored a flag would have done something
	// other than what it was told to, and said nothing about it.
	asked := hivec.askedFor(["--lto"])
	assert asked.target == ""
	assert asked.error != ""
}

test "a bad flag beside a good one still refuses the build" {
	asked := hivec.askedFor(["--target", "linux/arm64", "--lto"])
	assert asked.target == ""
	assert asked.error != ""
}

test "mentions finds a flag under either spelling" {
	assert hivec.mentions(["--target", "linux/arm64"], "--target")
	assert hivec.mentions(["--target=linux/arm64"], "--target")
}

test "mentions does not mistake a longer flag for this one" {
	assert hivec.mentions(["--targeted"], "--target") == false
	assert hivec.mentions([], "--target") == false
	assert hivec.mentions(["linux/arm64"], "--target") == false
}

// --- `hive version` ----------------------------------------------------------

test "hive version on its own is the whole command" {
	assert hivec.versionRefusal([]) == ""
}

test "an entrypoint after hive version is refused" {
	// Not ignored: `hive version main.hive` reads like it might say something
	// about `main.hive`, and it cannot. Printing the compiler's own release to
	// somebody who asked about a file would be the wrong answer, confidently.
	assert hivec.versionRefusal(["main.hive"]) != ""
}

test "a flag after hive version is refused too" {
	assert hivec.versionRefusal(["--target", "linux/arm64"]) != ""
	assert hivec.versionRefusal(["--short"]) != ""
}

test "what was refused is named in the complaint" {
	// So that the line says which word it could not use, rather than only that
	// there was one.
	wrong := hivec.versionRefusal(["--short"])
	assert text.contains(wrong, "--short")
}
