// Tests for `src/hivec`.
//
// The command line, which is the whole of what that file is. Two parts of it
// have a decision in them, and they are what is here: what followed the
// entrypoint on a `build` — one flag, both its spellings, and the four ways of
// getting it wrong — and what followed `hive version`, which is nothing.
import ../src/hivec
import ../src/testreport
import ../src/text

test "an Android target Go cannot link on its own is refused by name" {
    // The three that need a C cross-compiler, answered apart from every other
    // platform because they are the ones somebody would expect to work.
    for each target in ["android/386", "android/amd64", "android/arm"] {
        said := hivec.refusalOf(target)
        assert text.contains(said, target)
        assert text.contains(said, "C cross-compiler")
    }
}

test "a platform with no app to be packaged into says so instead" {
    said := hivec.refusalOf("linux/arm64")
    assert text.contains(said, "linux/arm64")
    assert text.contains(said, "android/arm64")
    assert text.contains(said, "C cross-compiler") == false
}

test "a build with no flags asks for this machine" {
    asked := hivec.askedFor("build", [])
    assert asked.target == ""
    assert asked.error == ""
}

test "--target takes the platform after it" {
    asked := hivec.askedFor("build", ["--target", "linux/arm64"])
    assert asked.target == "linux/arm64"
    assert asked.error == ""
}

test "--target= is the same flag spelled the other way" {
    asked := hivec.askedFor("build", ["--target=linux/arm64"])
    assert asked.target == "linux/arm64"
    assert asked.error == ""
}

test "a platform with no slash is left for the toolchain to refuse" {
    // Reading the flag and knowing the platforms are two jobs. This one only
    // says what was written down; `go tool dist list` is what says whether it
    // exists, and it is asked later.
    asked := hivec.askedFor("build", ["--target", "sparc"])
    assert asked.target == "sparc"
    assert asked.error == ""
}

test "the flag said twice takes the last one, as every flag does" {
    asked := hivec.askedFor("build", ["--target", "linux/arm64", "--target=darwin/arm64"])
    assert asked.target == "darwin/arm64"
    assert asked.error == ""
}

test "--target with nothing after it is refused" {
    asked := hivec.askedFor("build", ["--target"])
    assert asked.target == ""
    assert asked.error != ""
}

test "--target= with nothing after it is the same mistake" {
    asked := hivec.askedFor("build", ["--target="])
    assert asked.target == ""
    assert asked.error != ""
}

test "a flag this does not know is refused rather than skipped" {
    // The whole point: a build that ignored a flag would have done something
    // other than what it was told to, and said nothing about it.
    asked := hivec.askedFor("build", ["--lto"])
    assert asked.target == ""
    assert asked.error != ""
}

test "a bad flag beside a good one still refuses the build" {
    asked := hivec.askedFor("build", ["--target", "linux/arm64", "--lto"])
    assert asked.target == ""
    assert asked.error != ""
}

// What `go test -coverprofile` writes for the runtime package, which has no
// tests, came out as a blank line under the last failure.
test "a failure's output is what the test printed, and nothing go test said" {
    run := "=== RUN   TestHive/fails\nshown\n    main_test.go:9: assert x\n--- FAIL: TestHive/fails (0.00s)\nFAIL\ncoverage: 70.0% of statements\nFAIL\thiveapp\t1.4s\n\thiveapp/hive\t\tcoverage: 0.0% of statements\nFAIL\n"
    details := testreport.detailFor(testreport.collectDetails(run), "fails")
    assert len(details) == 2
    if details bounds 1 {
        assert details[0] == "shown"
        assert details[1] == "main_test.go:9: assert x"
    }
}

test "a line a test printed keeps the tabs in it" {
    run := "=== RUN   TestHive/tabs\na\tb\n--- FAIL: TestHive/tabs (0.00s)\n"
    details := testreport.detailFor(testreport.collectDetails(run), "tabs")
    assert len(details) == 1
    for each d in details {
        assert d == "a\tb"
    }
}

test "coverage names an imported declaration the way its module spells it" {
    assert testreport.readable("text_0_pad") == "text.pad"
    assert testreport.readable("main") == "main"
    assert testreport.readable("MAX_RETRIES") == "MAX_RETRIES"
}

test "a refused flag names the command it was given to" {
    asked := hivec.askedFor("export", ["--lto"])
    assert text.contains(asked.error, "`hive export`")
}

test "only the commands there are are commands" {
    assert hivec.isCommand("check")
    assert hivec.isCommand("container")
    assert hivec.isCommand("chekc") == false
    assert hivec.isCommand("") == false
}

test "mentions finds a flag under either spelling" {
    assert hivec.mentions(["--target", "linux/arm64"], "--target")
    assert hivec.mentions(["--target=linux/arm64"], "--target")
}

test "mentions does not mistake a longer flag for this one" {
    assert hivec.mentions(["--targeted"], "--target") == false
    assert hivec.mentions([], "--target") == false
    assert hivec.mentions(["linux/arm64"], "--target") == false
}

// --- `hive version` ----------------------------------------------------------

test "hive version on its own is the whole command" {
    assert hivec.versionRefusal([]) == ""
}

test "an entrypoint after hive version is refused" {
    // Not ignored: `hive version main.hive` reads like it might say something
    // about `main.hive`, and it cannot. Printing the compiler's own release to
    // somebody who asked about a file would be the wrong answer, confidently.
    assert hivec.versionRefusal(["main.hive"]) != ""
}

test "a flag after hive version is refused too" {
    assert hivec.versionRefusal(["--target", "linux/arm64"]) != ""
    assert hivec.versionRefusal(["--short"]) != ""
}

test "what was refused is named in the complaint" {
    // So that the line says which word it could not use, rather than only that
    // there was one.
    wrong := hivec.versionRefusal(["--short"])
    assert text.contains(wrong, "--short")
}

test "a directory's run totals its programs, its tests and what did not compile" {
    assert hivec.totals(2, 5, 0, 0) == "  2 programs, 5 tests: 5 passed"
    assert hivec.totals(1, 3, 1, 2) == "  1 program, 4 tests: 3 passed, 1 failed; 2 did not compile"
}
