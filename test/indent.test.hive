// Tests for `src/indent`.
import ../src/indent
import ../src/lexer

proc respaced(source: Str): Str {
    done := indent.indentSource(source)
    if done is Result.Ok(text) {
        return text
    }
    return "refused"
}

test "a code line's tabs become four spaces each" {
    assert respaced("proc main(): void \{\n\tif true \{\n\t\techo 1\n\t}\n}\n") == "proc main(): void \{\n    if true \{\n        echo 1\n    }\n}\n"
}

test "a tab moves to the next multiple of four" {
    assert respaced("proc main(): void \{\n  \techo 1\n\t  echo 2\n}\n") == "proc main(): void \{\n    echo 1\n      echo 2\n}\n"
}

test "line endings are kept" {
    assert respaced("proc main(): void \{\r\n\techo 1\r\n}\r\n") == "proc main(): void \{\r\n    echo 1\r\n}\r\n"
    assert respaced("proc main(): void \{\n\techo 1\r\n}\n") == "proc main(): void \{\n    echo 1\r\n}\n"
}

test "a quoted string spanning lines keeps every character" {
    assert respaced("func s(): Str \{\n\treturn \"a\n\tb\"\n}\n") == "func s(): Str \{\n    return \"a\n\tb\"\n}\n"
}

test "a backtick string loses only the indentation the lexer strips" {
    source := "func s(): Str \{\n\treturn `\n\t\tone\n\n\t\t\ttwo\n\t`\n}\n"
    got := respaced(source)
    assert got == "func s(): Str \{\n    return `\n        one\n\n        \ttwo\n    `\n}\n"
    assert lexer.lex(got).tokens == lexer.lex(source).tokens
}

test "a backtick string with text after its opening is left as it is" {
    source := "func s(): Str \{\n\treturn `  one\n\t\ttwo`\n}\n"
    assert respaced(source) == "func s(): Str \{\n    return `  one\n\t\ttwo`\n}\n"
}

test "a file that does not lex, or breaks a line with a lone carriage return, is left as it was" {
    assert respaced("func s(): Str \{\n\treturn \"open\n}\n") == "refused"
    assert respaced("proc main(): void \{\r\techo 1\n}\n") == "refused"
}

test "indenting twice changes nothing the second time" {
    once := respaced("func s(): Str \{\n\treturn `\n\t\tone\n\t`\n}\n")
    assert respaced(once) == once
}
