// Tests for `src/indent`.
import ../src/indent
import ../src/lexer
import ../src/token

// Indenting a line moves its tokens along it, so only what each holds is compared.
proc held(source: Str): token.Kind[dyn] {
    mut token.Kind[dyn] out = []
    for each t in lexer.lex(source).tokens {
        append(out, t.kind)
    }
    return out
}

proc respaced(source: Str): Str {
    done := indent.indentSource(source)
    if done is Result.Ok(text) {
        return text
    }
    return "refused"
}

test "a type's law stands apart from the fields and braces around it" {
    assert respaced("type Stay \{\n    nights: Int\n    law positive(s: Stay) \{\n        assert s.nights > 0\n    }\n}\n") == "type Stay \{\n    nights: Int\n\n    law positive(s: Stay) \{\n        assert s.nights > 0\n    }\n\n}\n"
    assert respaced("type Stay \{\r\n    law positive(s: Stay) \{\r\n        assert true\r\n    }\r\n    nights: Int\r\n}\r\n") == "type Stay \{\r\n\r\n    law positive(s: Stay) \{\r\n        assert true\r\n    }\r\n\r\n    nights: Int\r\n}\r\n"
}

test "two laws may touch, and a comment above a law moves with it" {
    written := "type Stay \{\n    nights: Int\n    // Every stay is at least a night.\n    law positive(s: Stay) \{\n        assert s.nights > 0\n    }\n    law short(s: Stay) \{\n        assert s.nights < 400\n    }\n}\n"
    wanted := "type Stay \{\n    nights: Int\n\n    // Every stay is at least a night.\n    law positive(s: Stay) \{\n        assert s.nights > 0\n    }\n    law short(s: Stay) \{\n        assert s.nights < 400\n    }\n\n}\n"
    assert respaced(written) == wanted
    assert respaced(wanted) == wanted
}

test "a law already apart, a law in a string, and a law on one line are left alone" {
    apart := "type Stay \{\n    nights: Int\n\n    law positive(s: Stay) \{\n        assert s.nights > 0\n    }\n\n}\n"
    assert respaced(apart) == apart
    quoted := "func source(): Str \{\n    return `\n        type Stay \{\n            nights: Int\n            law positive(s: Stay) \{ assert true }\n        }\n    `\n}\n"
    assert respaced(quoted) == quoted
    inline := "type Stay \{ nights: Int law positive(s: Stay) \{ assert true } }\n"
    assert respaced(inline) == inline
}

test "a code line's tabs become four spaces each" {
    assert respaced("proc main(): void \{\n\tif true \{\n\t\techo 1\n\t}\n}\n") == "proc main(): void \{\n    if true \{\n        echo 1\n    }\n}\n"
}

test "a tab moves to the next multiple of four" {
    assert respaced("proc main(): void \{\n  \techo 1\n\t  echo 2\n}\n") == "proc main(): void \{\n    echo 1\n      echo 2\n}\n"
}

test "line endings are kept" {
    assert respaced("proc main(): void \{\r\n\techo 1\r\n}\r\n") == "proc main(): void \{\r\n    echo 1\r\n}\r\n"
    assert respaced("proc main(): void \{\n\techo 1\r\n}\n") == "proc main(): void \{\n    echo 1\r\n}\n"
}

test "a quoted string spanning lines keeps every character" {
    assert respaced("func s(): Str \{\n\treturn \"a\n\tb\"\n}\n") == "func s(): Str \{\n    return \"a\n\tb\"\n}\n"
}

test "a backtick string loses only the indentation the lexer strips" {
    source := "func s(): Str \{\n\treturn `\n\t\tone\n\n\t\t\ttwo\n\t`\n}\n"
    got := respaced(source)
    assert got == "func s(): Str \{\n    return `\n        one\n\n        \ttwo\n    `\n}\n"
    assert held(got) == held(source)
}

test "a backtick string with text after its opening is left as it is" {
    source := "func s(): Str \{\n\treturn `  one\n\t\ttwo`\n}\n"
    assert respaced(source) == "func s(): Str \{\n    return `  one\n\t\ttwo`\n}\n"
}

test "a file that does not lex, or breaks a line with a lone carriage return, is left as it was" {
    assert respaced("func s(): Str \{\n\treturn \"open\n}\n") == "refused"
    assert respaced("proc main(): void \{\r\techo 1\n}\n") == "refused"
}

test "indenting twice changes nothing the second time" {
    once := respaced("func s(): Str \{\n\treturn `\n\t\tone\n\t`\n}\n")
    assert respaced(once) == once
}
