// Tests for `src/text`.
import ../src/text

test "chars splits a string into its characters, not its bytes" {
	assert len(text.chars("hello")) == 5
	assert len(text.chars("café")) == 4
	assert len(text.chars("")) == 0
	assert text.charAt(text.chars("café"), 3) == "é"
}

test "charAt answers past either end rather than failing" {
	cs := text.chars("ab")
	assert text.charAt(cs, 0) == "a"
	assert text.charAt(cs, 1) == "b"
	assert text.charAt(cs, 2) == ""
	assert text.charAt(cs, -1) == ""
}

test "span takes an inclusive range, clamped to what is there" {
	cs := text.chars("abcdef")
	assert text.span(cs, 0, 2) == "abc"
	assert text.span(cs, 3, 5) == "def"
	assert text.span(cs, 0, 99) == "abcdef"
	assert text.span(cs, -4, 1) == "ab"
	assert text.span(cs, 4, 2) == ""
	assert text.span(cs, 2, 2) == "c"
}

test "matchesAt reads a word from a position" {
	cs := text.chars("import ./lib/text")
	assert text.matchesAt(cs, 0, "import")
	assert text.matchesAt(cs, 7, "./lib")
	assert text.matchesAt(cs, 1, "import") == false
	assert text.matchesAt(cs, 0, "")
	assert text.matchesAt(cs, 15, "extra") == false
}

test "startsWith and endsWith" {
	assert text.startsWith("hive.map", "hive.")
	assert text.startsWith("hive", "hive.") == false
	assert text.startsWith("anything", "")
	assert text.endsWith("main.hive", ".hive")
	assert text.endsWith("main.go", ".hive") == false
	assert text.endsWith("x", "")
}

test "contains" {
	assert text.contains("hello world", "o w")
	assert text.contains("hello", "z") == false
	assert text.contains("hello", "")
}

test "replace rewrites every occurrence" {
	assert text.replace("a.b.c", ".", "/") == "a/b/c"
	assert text.replace("aaa", "aa", "b") == "ba"
	assert text.replace("none", "x", "y") == "none"
	assert text.replace("keep", "", "x") == "keep"
}

test "repeat" {
	assert text.repeat("=", 4) == "===="
	assert text.repeat("ab", 2) == "abab"
	assert text.repeat("=", 0) == ""
	assert text.repeat("=", -3) == ""
}

test "the character classes answer false for a non-character" {
	assert text.isDigit("7")
	assert text.isDigit("x") == false
	assert text.isDigit("") == false
	assert text.isDigit("77") == false
	assert text.isLower("q")
	assert text.isLower("Q") == false
	assert text.isUpper("Q")
	assert text.isAlpha("Q")
	assert text.isAlpha("q")
	assert text.isAlpha("1") == false
	assert text.isAlnum("1")
	assert text.isAlnum("z")
	assert text.isAlnum("_") == false
	assert text.isSpace(" ")
	assert text.isSpace("\t")
	assert text.isSpace("\n")
	assert text.isSpace("_") == false
}

test "lower and upper leave everything that is neither alone" {
	assert text.lower("PascalCase") == "pascalcase"
	assert text.upper("camelCase") == "CAMELCASE"
	assert text.lower("MAX_RETRIES_2") == "max_retries_2"
	assert text.upper("café") == "CAFé"
	assert text.lower("") == ""
}

test "capitalise and decapitalise touch only the first character" {
	assert text.capitalise("grams") == "Grams"
	assert text.decapitalise("Grams") == "grams"
	assert text.capitalise("gramsPerLitre") == "GramsPerLitre"
	assert text.decapitalise("HttpRequest") == "httpRequest"
	assert text.capitalise("") == ""
	assert text.decapitalise("") == ""
}

test "trim removes whitespace from both ends and nothing from the middle" {
	assert text.trim("  spaced  ") == "spaced"
	assert text.trim("\t\ntabbed\n") == "tabbed"
	assert text.trim("in  the  middle") == "in  the  middle"
	assert text.trim("   ") == ""
	assert text.trim("") == ""
}

test "leadingBlanks counts spaces and tabs alike" {
	assert text.leadingBlanks("    four") == 4
	assert text.leadingBlanks("\t\tone each") == 2
	assert text.leadingBlanks("none") == 0
	assert text.leadingBlanks("   ") == 3
}

test "dedent removes the indentation every line shares" {
	// `\{` is a literal brace: an unescaped one would open an interpolation.
	block := "\n\t\tpackage hive\n\n\t\tfunc f() \{\n\t\t\treturn\n\t\t}\n\t"
	assert text.dedent(block) == "package hive\n\nfunc f() \{\n\treturn\n}"
}

test "dedent leaves an already-flush block alone" {
	assert text.dedent("a\nb") == "a\nb"
	assert text.dedent("") == ""
	assert text.dedent("\n\n") == ""
}

test "dedent measures only the lines that hold something" {
	// The blank line in the middle has no indentation to contribute, and must
	// not drag the shared count down to zero.
	assert text.dedent("  a\n\n  b") == "a\n\nb"
}
