// Tests for `src/paths`.
import ../src/paths

test "dirOf is everything before the last slash" {
	assert paths.dirOf("lib/text.hive") == "lib"
	assert paths.dirOf("a/b/c.hive") == "a/b"
	assert paths.dirOf("main.hive") == "."
	assert paths.dirOf("/abs/main.hive") == "/abs"
	assert paths.dirOf("/main.hive") == "/"
}

test "baseOf is everything after it" {
	assert paths.baseOf("lib/text.hive") == "text.hive"
	assert paths.baseOf("main.hive") == "main.hive"
	assert paths.baseOf("a/b/") == ""
}

test "stem drops the extension, and only the last one" {
	assert paths.stem("lib/text.hive") == "text"
	assert paths.stem("cart.test.hive") == "cart.test"
	assert paths.stem("Makefile") == "Makefile"
}

test "extensionOf keeps the dot" {
	assert paths.extensionOf("main.hive") == ".hive"
	assert paths.extensionOf("lib/util.go") == ".go"
	assert paths.extensionOf("Makefile") == ""
}

test "joinPath puts one after the other" {
	assert paths.joinPath("lib", "text.hive") == "lib/text.hive"
	assert paths.joinPath("lib/", "text.hive") == "lib/text.hive"
	assert paths.joinPath(".", "text.hive") == "text.hive"
	assert paths.joinPath("", "text.hive") == "text.hive"
	assert paths.joinPath("lib", "") == "lib"
	assert paths.joinPath("lib", "/abs") == "/abs"
}

test "normalise resolves away `.` and `..`" {
	assert paths.normalise("./lib/text") == "lib/text"
	assert paths.normalise("lib/../lib/text") == "lib/text"
	assert paths.normalise("a/b/../../c") == "c"
	assert paths.normalise("a//b") == "a/b"
	assert paths.normalise("/a/./b") == "/a/b"
	assert paths.normalise(".") == "."
}

test "a `..` with nothing to climb out of is kept, because it means something" {
	assert paths.normalise("../shared/text") == "../shared/text"
	assert paths.normalise("../../shared") == "../../shared"
	assert paths.normalise("a/../../shared") == "../shared"
}

test "two spellings of one file normalise to one string" {
	// Which is what keeps a module loaded once however many ways it is reached.
	assert paths.normalise("./lib/../lib/text") == paths.normalise("lib/text")
}

test "fromShell reads a Windows path in the one spelling everything else uses" {
	assert paths.fromShell("src\\hivec.hive") == "src/hivec.hive"
	assert paths.fromShell(".\\src\\hivec.hive") == "./src/hivec.hive"
	assert paths.fromShell("C:\\dev\\hive\\main.hive") == "C:/dev/hive/main.hive"
	assert paths.fromShell("src/hivec.hive") == "src/hivec.hive"
}

test "an entrypoint typed with backslashes still finds the file beside it" {
	// The bug this exists for: `dirOf` reads only `/`, so `src\hivec.hive` had no
	// directory at all and every import resolved against the working folder.
	entry := paths.fromShell("src\\hivec.hive")
	assert paths.dirOf(entry) == "src"
	assert paths.normalise(paths.joinPath(paths.dirOf(entry), "./text") + ".hive") == "src/text.hive"
	assert paths.stem(entry) == "hivec"
}
