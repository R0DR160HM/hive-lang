// Tests for `src/runtime`.
//
// The runtime holds Hive, Go and JavaScript in one file and the compiler checks
// only the Hive. What is asserted here is the JavaScript the window runs, as
// text — which is worth doing for the things that break silently: a line that
// reads fine, compiles fine, and passes every other suite in this directory.
//
// No needle below carries a brace. A Hive string interpolates on `{`, so a
// fragment of JavaScript with one in it is a parse error rather than a needle.
import ../src/runtime
import ../src/stdlib
import ../src/text

// **Sounds live in slots past the end of `live`.** Only a solid is ever written
// there, so a trim loop bounded by `live.length` never clears a voice: the
// stranded slot keeps the track it last had and fights the live one for the name,
// tearing it down every frame. What that sounds like is no music at all.
//
// It has been written the wrong way twice, and both times everything else passed.
test "the frame's trim loop reaches the sound slots, not only the solids" {
	js := runtime.uiSceneJs()
	assert text.contains(js, "function trim(count)")
	assert text.contains(js, "for (var i = count; i < live.length; i++)") == false
	assert text.contains(js, "far = voiceOf.length;")
	assert text.contains(js, "for (var i = count; i < far; i++)")
}

// Clearing the voice is the whole of letting a sound go: `regather` drops any
// slot `trim` has nulled, so nothing else has to be tidied up.
test "a trimmed voice is dropped rather than left in the list" {
	js := runtime.uiSceneJs()
	assert text.contains(js, "function regather()")
	assert text.contains(js, "if (!heard)")
}

// The coarse buffer and the dither are one pass, and the order inside it is the
// only thing about it easy to get wrong. Rendering to a target skips the encode
// three.js does on its way to the canvas, so the pass has to do it — and it has
// to do it *before* the quantise, because a display's bit depth is a fact about
// what it displays. Wrong once: the world came back at a quarter of its
// brightness and read as a different time of day.
test "the handheld pass encodes for the screen before it quantises" {
	js := runtime.uiSceneJs()
	assert text.contains(js, "vec3 shown(vec3 c)")
	assert text.contains(js, "c = shown(texture2D(tex, vUv).rgb);")
	// The dither reads the coarse buffer's own pixel rather than the screen's, so
	// the pattern is at the size the world was actually drawn at.
	assert text.contains(js, "vec2 cell = floor(vUv * size);")
}

// A sprite wears a SpriteMaterial and every solid wears what `paintOf` answers
// with. They meet in `put`, and a billboard handed a mesh material samples a
// surface texture it has no normals for and comes out solid black — which is
// exactly what the trees did the first time.
test "a sprite keeps its own material through a frame" {
	js := runtime.uiSceneJs()
	assert text.contains(js, "o.material.color.setStyle(bare(s.c));")
	assert text.contains(js, "made.center.set(0.5, 0);")
	assert text.contains(js, "sprite")
}

// The window is set in the program's own typeface when it ships one and in the
// system's when it does not. The rule is always written; a program with no font
// serves a 404 and the stack falls through.
test "a program may ship its own typeface" {
	css := runtime.uiSource()
	assert text.contains(css, "font-family:hive-own")
	assert text.contains(css, "/_hive/asset/font.woff2")
	assert text.contains(css, "font:14px/1.5 hive-own,system-ui")
}

// Android keeps its resolvers in a service rather than in a file, and Go's pure
// resolver has only `/etc/resolv.conf` to read. The three modules that look a
// name up ask for the file that fixes it; a program that touches no network
// asks for none of them.
test "the modules that resolve a name carry the resolver" {
	for each module in ["net", "sql", "syslink"] {
		mut Bool asks = false
		for each needed in runtime.requires(module) {
			if needed == "resolver" {
				asks = true
			}
		}
		assert asks
	}
	assert len(runtime.requires("conv")) == 0
	assert len(runtime.requires("term")) == 1
}

test "the resolver is a file of its own, and only acts on one platform" {
	source := runtime.moduleSource("resolver")
	assert text.contains(source, "net.DefaultResolver")
	// Gated on the platform rather than on a build tag, so the same file
	// compiles everywhere and does nothing anywhere else.
	assert text.contains(source, "runtime.GOOS != \"android\"")
	assert text.contains(source, "PreferGo: true")
	// A port is added where the file named none, and a bare v6 address gets its
	// brackets from JoinHostPort.
	assert text.contains(source, "net.JoinHostPort(line, \"53\")")
}

// A window with a host in front of it is told about, not launched: the line is
// a fixed shape the host reads rather than prose it would have to parse.
test "a window on a handset announces itself instead of opening a browser" {
	ui := runtime.uiSource()
	assert text.contains(ui, "hive-window ")
	// And the program does not end itself when the socket goes quiet there,
	// because a sleeping device holds one quiet for minutes.
	assert text.contains(ui, "func (w *uiWindow) linger()")
}

test "the resolver is not a module a program can name" {
	// Emitted beside `net`, `sql` and `syslink` and called only by Go the runtime
	// wrote. Putting it on the language's surface would be a decision rather than
	// a detail, so the list that decides what `hive.` accepts leaves it out.
	assert stdlib.isKnownModule("resolver") == false
	assert stdlib.isKnownModule("syslinknet") == false
	assert stdlib.isKnownModule("net")
}
