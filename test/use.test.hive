// Tests for `src/use`.
import ../src/text
import ../src/use

test "hive use takes exactly one version" {
    assert text.contains(use.refusal([]), "needs a version")
    assert text.contains(use.refusal(["v0.3.4", "extra"]), "`extra`")
    assert use.refusal(["v0.3.4"]) == ""
}

test "a version is three numbers, with or without the v" {
    assert use.refusal(["0.3.4"]) == ""
    assert text.contains(use.refusal(["latest"]), "is not a version")
    assert text.contains(use.refusal(["v0.3"]), "is not a version")
    assert text.contains(use.refusal(["v0.3.4.1"]), "is not a version")
    assert text.contains(use.refusal(["v0.3.x"]), "is not a version")
    assert text.contains(use.refusal(["v0..4"]), "is not a version")
    assert text.contains(use.refusal(["v-1.3.4"]), "is not a version")
    assert text.contains(use.refusal(["v"]), "is not a version")
}

test "hive use reaches back no further than the first release that has it" {
    assert use.refusal(["v0.3.3"]) == ""
    assert use.refusal(["v1.0.0"]) == ""
    assert use.refusal(["v0.10.0"]) == ""
    assert text.contains(use.refusal(["v0.3.2"]), "reaches back to v0.3.3")
    assert text.contains(use.refusal(["v0.2.15"]), "reaches back to v0.3.3")
}

test "a version is spelled the way its tag is" {
    if use.releaseOf("00.3.04") is Result.Ok(release) {
        assert use.tagOf(release) == "v0.3.4"
    } else {
        assert false
    }
}

test "each platform has its own asset" {
    assert use.assetFor("windows/arm64") == "hivec-windows-arm64.exe"
    assert use.assetFor("linux/amd64") == "hivec-linux-amd64"
    assert use.assetFor("darwin/arm64") == "hivec-darwin-arm64"
}

test "SHA256SUMS gives each asset its own digest" {
    sums := "aaa  hivec-linux-amd64\nbbb  hivec-linux-amd64.exe\r\nccc *hivec-windows-amd64.exe\n"
    assert use.digestIn(sums, "hivec-linux-amd64") == "aaa"
    assert use.digestIn(sums, "hivec-windows-amd64.exe") == "ccc"
    assert use.digestIn(sums, "hivec-darwin-arm64") == ""
}
