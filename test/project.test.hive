// Tests for `src/project`.
//
// The parts of the last two steps that can be asked without a build running:
// what the toolchain is given for a target, what its answer is read as, and what
// the executable ends up called. Everything else in that file writes a Go module
// or runs `go` over one, and the end-to-end suite is where those are exercised.
import ../src/project
import ../src/shim
import ../src/text
import hive.map

test "no target hands the toolchain no environment at all" {
	// The whole of why a build for this machine is unchanged: an empty overlay
	// is exactly `exec`, so there is no second path through the toolchain to
	// keep working.
	assert len(hive.map.keys(project.crossing(""))) == 0
}

test "a target becomes GOOS, GOARCH and no cgo" {
	asked := project.crossing("linux/arm64")
	assert valueOf(asked, "GOOS") == "linux"
	assert valueOf(asked, "GOARCH") == "arm64"
	// Nothing in the runtime needs a C compiler, and a C cross-compiler is the
	// one thing a machine with Go on it may not have.
	assert valueOf(asked, "CGO_ENABLED") == "0"
}

test "a target that is not a pair sets nothing rather than half of it" {
	assert len(hive.map.keys(project.crossing("linux"))) == 0
}

test "names finds a platform in what the toolchain listed" {
	listed := "darwin/arm64\nlinux/amd64\nlinux/arm64\nwindows/amd64\n"
	assert project.names(listed, "linux/arm64")
	assert project.names(listed, "windows/amd64")
	assert project.names(listed, "sparc/vax") == false
}

test "names matches a whole line rather than part of one" {
	// `linux/arm` is a real platform and `linux/arm64` is another, so a match on
	// the front of a line would build the wrong one.
	assert project.names("linux/arm64\n", "linux/arm") == false
	assert project.names("linux/arm64\n", "arm64") == false
}

test "a cross build is named for the platform it is for" {
	// Two files that cannot run in the same places must not answer to one name.
	assert project.executableOf("main.hive", "linux/arm64") == "main-linux-arm64"
	assert project.executableOf("src/hivec.hive", "darwin/arm64") == "hivec-darwin-arm64"
}

test "the .exe follows the target rather than this machine" {
	assert project.executableOf("main.hive", "windows/amd64") == "main-windows-amd64.exe"
}

test "an app is named for its platform too, and carries no .exe" {
	assert project.apkOf("chat.hive", "android/arm64") == "chat-android-arm64.apk"
	assert project.apkOf("examples/17-chat/chat.hive", "android/arm64") == "chat-android-arm64.apk"
}

test "the shim the compiler carries is a dex" {
	// Its first eight bytes are the format's own magic, so a blob that was
	// truncated or reflowed on its way into the source would not start with
	// them. `android/shim/build` writes it; nothing here can rebuild it.
	hexed := text.replace(text.replace(shim.dexHex(), "\n", ""), "\t", "")
	assert text.startsWith(hexed, "6465780a30333700")
	assert len(hexed) % 2 == 0
	assert len(hexed) > 1000
}

test "the program inside an app stays in the build" {
	// What belongs beside the entrypoint is the app, not a binary this machine
	// cannot run.
	assert project.payloadName() == "payload"
}

test "a windowed program is linked without a console, and nothing else is" {
	// The whole of what makes a window one visible thing rather than two: with a
	// console, Windows opens a terminal beside it.
	assert join(project.compact(true), " ") == "-trimpath -ldflags -s -w -H=windowsgui"
	assert join(project.compact(false), " ") == "-trimpath -ldflags -s -w"
}

test "whether the target wants a console is the target's own question" {
	// A Windows build is the only one with a console to suppress, and a cross
	// build is asked about the platform it is for.
	assert project.windowsTarget("windows/amd64")
	assert project.windowsTarget("linux/arm64") == false
	assert project.windowsTarget("darwin/arm64") == false
}

test "progress says which platform a build is for, and only then" {
	assert project.saying("") == ""
	assert project.saying("linux/arm64") == " — linux/arm64"
}

// The value under a key, or `""` where there is none — so a missing pair fails
// an assertion rather than quietly skipping it.
func valueOf(asked: hive.map.Map<Str, Str>, key: Str): Str {
	if hive.map.get(asked, key) is Result.Ok(value) {
		return value
	}
	return ""
}
