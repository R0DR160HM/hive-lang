// Tests for `src/check`.
//
// Each test names a rule and shows a program that breaks it. The assertion is on
// the opening of the message rather than every word of it, so a message can be
// improved without a test having to be rewritten — but a message that stopped
// naming the right thing would still fail.
import ../src/check
import ../src/loader
import ../src/text

// The first thing wrong with `source`, or `""`.
proc problem(source: Str): Str {
	p := loader.loadText("main.hive", source)
	if len(p.errors) > 0 {
		for each e in p.errors {
			return "loader: " + e.message
		}
	}
	for each e in check.checkModule(p.module) {
		return e.message
	}
	return ""
}

proc problemCount(source: Str): Int {
	p := loader.loadText("main.hive", source)
	if len(p.errors) > 0 {
		return -1
	}
	return len(check.checkModule(p.module))
}

// A whole program wrapped around one statement, which is what most of these are
// about.
func inMain(body: Str): Str {
	return "proc main(): void \{ " + body + " }"
}

func opens(got: Str, wanted: Str): Bool {
	return text.startsWith(got, wanted)
}

// --- Nothing wrong -----------------------------------------------------------

test "a program that is right has nothing said about it" {
	assert problemCount(inMain("echo 1")) == 0
	assert problemCount("func two(): Int \{ return 2 }\nproc main(): void \{ echo two() }") == 0
	assert problemCount("type User \{ id: Int  name: Str }\nproc main(): void \{ echo User(1, \"a\").name }") == 0
}

// --- Names -------------------------------------------------------------------

test "a name nothing declared is named" {
	assert problem(inMain("echo nowhere")) == "in `main`: `nowhere` is not a name anything here declared"
}

test "a field a type does not have is named" {
	got := problem("type User \{ id: Int }\nproc main(): void \{ echo User(1).nope }")
	assert got == "in `main`: `User` has no field `nope`"
}

test "a variant a type does not have is named" {
	got := problem("type Shape \{ Circle \{ radius: Int } }\nproc main(): void \{ echo Shape.Square(1) }")
	assert got == "in `main`: `Shape` has no variant `Square`"
}

test "a type declaring the same field twice is refused" {
	got := problem("type User \{ id: Int  id: Str }")
	assert got == "in `User`: this type declares `id` twice"
}

test "a shared field a variant declares again would be there twice" {
	got := problem("type Event \{ at: Int  Opened \{ at: Str } }")
	assert opens(got, "in `Event`: the variant `Opened` declares `at`")
}

// --- Arity and arguments -----------------------------------------------------

test "a call with the wrong number of arguments is named" {
	got := problem("func two(): Int \{ return 2 }\nproc main(): void \{ echo two(1) }")
	assert got == "in `main`: `two` takes 0 arguments, and this call passes 1 argument"
}

test "a constructor with the wrong number of fields is named" {
	got := problem("type User \{ id: Int  name: Str }\nproc main(): void \{ echo User(1) }")
	assert got == "in `main`: `User` has 2 fields, and this call passes 1 argument"
}

test "a named argument that names no parameter is refused" {
	got := problem("func f(a: Int): Int \{ return a }\nproc main(): void \{ echo f(b: 1) }")
	assert got == "in `main`: `f` has no parameter called `b`"
}

test "a named argument written twice is refused" {
	got := problem("func f(a: Int, b: Int): Int \{ return a }\nproc main(): void \{ echo f(a: 1, a: 2) }")
	assert got == "in `main`: this call names `a` twice"
}

test "once named arguments are used the call covers the whole parameter list" {
	got := problem("func f(a: Int, b: Int): Int \{ return a }\nproc main(): void \{ echo f(a: 1) }")
	assert opens(got, "in `main`: once a call uses named arguments")
}

test "a Result and a map widen through their halves" {
	// A `[dyn]` promises nothing, so a known length is welcome to fill it — one
	// layer down as much as at the top.
	assert problemCount("func f(): Result<Int, Str[dyn]> \{ return Result.Error([\"one\"]) }") == 0
	assert problemCount("func f(): Str[dyn] \{ return [\"one\"] }") == 0
	// And a promise is still a promise: three does not fill a slot that said two.
	assert opens(problem("func f(): Result<Int, Str[2]> \{ return Result.Error([\"a\", \"b\", \"c\"]) }"), "in `f`: this `return` wants Result<Int, Str[2]>")
}

test "an argument of the wrong type is named, with both types" {
	got := problem("func f(a: Int): Int \{ return a }\nproc main(): void \{ echo f(\"s\") }")
	assert got == "in `main`: the argument `a` of `f` wants Int and this is Str"
}

// --- The proc/func split -----------------------------------------------------

test "a func cannot call a proc" {
	got := problem("proc side(): Int \{ return 1 }\nfunc pure(): Int \{ return side() }")
	assert opens(got, "in `pure`: a `func` cannot call the `proc` `side`")
}

test "a func cannot declare a mutex parameter" {
	got := problem("func grow(v: mut Str[dyn]): void \{ }")
	assert opens(got, "in `grow`: a `func` cannot declare the mutex parameter `v: mut ...`")
}

test "a proc calling a proc is fine, and so is a func calling a func" {
	assert problemCount("proc a(): Int \{ return 1 }\nproc b(): Int \{ return a() }") == 0
	assert problemCount("func a(): Int \{ return 1 }\nfunc b(): Int \{ return a() }") == 0
	// A func value may fill a proc slot: pure widens to impure.
	assert problemCount("func a(): Int \{ return 1 }\nproc b(): Int \{ return a() }") == 0
}

// --- Mutability --------------------------------------------------------------

test "assigning to an immutable binding is refused" {
	got := problem(inMain("x := 1  x = 2"))
	assert got == "in `main`: cannot assign to `x`: it is immutable — declare it with `mut` to allow reassignment"
}

test "a mut binding may be reassigned, and through a path into it" {
	assert problemCount(inMain("mut x := 1  x = 2")) == 0
	assert problemCount("type Box \{ n: Int }\nproc main(): void \{ mut Box b = Box(1)  b.n = 2 }") == 0
	assert problemCount(inMain("mut Int[dyn] v = [1]  v[0] = 2")) == 0
}

test "assigning through an immutable path is refused" {
	got := problem("type Box \{ n: Int }\nproc main(): void \{ b := Box(1)  b.n = 2 }")
	assert opens(got, "in `main`: cannot assign to `b`")
}

test "append needs a mut target" {
	got := problem(inMain("Str[dyn] v = []  append(v, \"a\")"))
	assert got == "in `main`: `append` grows a vector in place, so its target has to be `mut` — this one is not"
}

test "append needs a vector declared dynamic, because an inferred length is a promise" {
	got := problem(inMain("mut v := [\"a\"]  append(v, \"b\")"))
	assert opens(got, "in `main`: `append` needs a vector declared `[dyn]`, and `v` promises exactly 1")
}

test "prepend and drop follow append's rule exactly" {
	assert opens(problem(inMain("Str[dyn] v = []  prepend(v, \"a\")")), "in `main`: `prepend` grows a vector in place")
	assert opens(problem(inMain("Str[dyn] v = []  drop(v, 0, 0)")), "in `main`: `drop` grows a vector in place")
}

test "a mut parameter takes the caller's own storage, so its argument has to be mut" {
	got := problem("proc grow(v: mut Str[dyn]): void \{ }\nproc main(): void \{ Str[dyn] v = []  grow(v) }")
	assert opens(got, "in `main`: `grow` asks for the mutex itself")
	assert problemCount("proc grow(v: mut Str[dyn]): void \{ }\nproc main(): void \{ mut Str[dyn] v = []  grow(v) }") == 0
}

test "a discarded sort has to be able to sort in place" {
	assert opens(problem(inMain("Int[dyn] v = [3, 1]  sort(v)")), "in `main`: a `sort` written as a statement sorts in place")
	assert opens(problem(inMain("sort(split(\"a,b\", \",\"))")), "in `main`: a `sort` written as a statement throws away")
	assert problemCount(inMain("mut Int[dyn] v = [3, 1]  sort(v)")) == 0
	// Keeping the answer is always fine.
	assert problemCount(inMain("Int[dyn] v = [3, 1]  ordered := sort(v)  echo ordered")) == 0
}

// --- A field's annotations ---------------------------------------------------

test "a Default has to be a value the field can hold" {
	assert opens(problem("type User \{ age: Int -- Default as \"none\"; }"),
		"in `User`: `age` is declared Int and falls back to Str")
	// No widening here either: an `Int` literal does not fill a `Float`.
	assert opens(problem("type P \{ ratio: Float -- Default as 1; }"),
		"in `P`: `ratio` is declared Float and falls back to Int")
	assert problemCount("type User \{ age: Int -- Default as 0; }") == 0
	assert problemCount("type User \{ name: Str -- Default as \"\"; }") == 0
	assert problemCount("type P \{ r: Float -- Default as 0.0;  b: Bool -- Default as false; }") == 0
}

test "two fields cannot answer to one JSON key" {
	// One key read into two fields is a decoder reading the same member twice,
	// and an encoder writing it twice.
	assert opens(problem("type User \{ name: Str  nickname: Str -- JSON as name; }"),
		"in `User`: two fields here are `name` in JSON")
	assert opens(problem("type User \{ a: Str -- JSON as who;  b: Str -- JSON as who; }"),
		"in `User`: two fields here are `who` in JSON")
	// A rename that clears a clash rather than making one is fine.
	assert problemCount("type User \{ name: Str  nickname: Str -- JSON as nick; }") == 0
}

test "a variant is the object, so a clash is looked for across its own fields and the shared ones" {
	assert opens(problem("type Event \{ at: Int  Opened \{ when: Int -- JSON as at; } }"),
		"in `Event`: two fields here are `at` in JSON")
	// Two variants may each use a key, since neither is ever the other's object.
	assert problemCount("type Event \{ Opened \{ who: Str -- JSON as by; } Closed \{ shut: Str -- JSON as by; } }") == 0
}

// --- Conditions --------------------------------------------------------------

test "a condition is a Bool and nothing else" {
	assert opens(problem(inMain("if 1 \{ }")), "in `main`: a condition is a `Bool`, and this one is Int")
	assert opens(problem(inMain("if \"s\" \{ }")), "in `main`: a condition is a `Bool`, and this one is Str")
}

test "`!` inverts a Bool and nothing else" {
	// The same rule a condition is held to, because it is the same reason:
	// there is no truthiness, so there is nothing else to be the opposite of.
	assert opens(problem(inMain("n := 3  echo !n")), "in `main`: `!` inverts a `Bool`, and this is Int")
	assert opens(problem(inMain("echo !\"s\"")), "in `main`: `!` inverts a `Bool`, and this is Str")
	assert opens(problem(inMain("Str[dyn] v = []  echo !v")), "in `main`: `!` inverts a `Bool`, and this is Str[dyn]")
	assert opens(problem(inMain("flag := #Ready  echo !flag")), "in `main`: an atom is a label, not a yes or a no")
}

test "a Bool is a Bool wherever the ! was written" {
	// Not only in a condition: a `!` may be stored, returned or passed, and each
	// of those has to hold its operand to the same rule.
	assert problemCount(inMain("found := false  if !found \{ }")) == 0
	assert problemCount(inMain("mut seen := false  seen = !seen")) == 0
	assert problemCount(inMain("mut Bool[dyn] flags = [true]  append(flags, !true)")) == 0
	assert problemCount(inMain("found := false  ready := true  if !found && ready \{ }")) == 0
	assert problemCount(inMain("Str[dyn] v = []  if !(v bounds 0) \{ }")) == 0
	assert problemCount(inMain("echo !!true")) == 0
}

test "a negated Bool is still a Bool, so it answers where one is wanted" {
	assert problemCount("func no(b: Bool): Bool \{ return !b }") == 0
	// And a `func` value of that shape is what a walk takes.
	assert problemCount("func no(b: Bool): Bool \{ return !b }\nproc main(): void \{ Bool[dyn] v = [true]  echo filter(v, no) }") == 0
}

test "an atom is a label, not a yes or a no" {
	got := problem(inMain("flag := #Ready  if flag \{ }"))
	assert opens(got, "in `main`: an atom is a label, not a yes or a no")
	assert problemCount(inMain("flag := #Ready  if flag == #Ready \{ }")) == 0
}

// --- Returning ---------------------------------------------------------------

test "every path of a non-void callable has to return" {
	got := problem("func f(n: Int): Int \{ if n > 0 \{ return 1 } }")
	assert opens(got, "in `f`: `f` answers with Int, so every path through it has to return one")
}

test "an if/else whose every branch returns is a terminating path" {
	assert problemCount("func f(n: Int): Int \{ if n > 0 \{ return 1 } else \{ return 2 } }") == 0
}

test "panic and assert close off a path" {
	assert problemCount("func f(n: Int): Int \{ panic \"no\" }") == 0
	assert problemCount("func f(n: Int): Int \{ if n > 0 \{ return 1 } panic \"unreachable\" }") == 0
}

test "an else-less chain covering a union's whole type is a terminating path" {
	source := "type Shape \{ Circle \{ radius: Int } Point }\nfunc name(s: Shape): Str \{ if s is Shape.Circle(r) \{ return \"c\" } else if s is Shape.Point \{ return \"p\" } }"
	assert problemCount(source) == 0
}

test "and dropping one branch of it is not" {
	source := "type Shape \{ Circle \{ radius: Int } Point }\nfunc name(s: Shape): Str \{ if s is Shape.Circle(r) \{ return \"c\" } }"
	assert opens(problem(source), "in `name`: `name` answers with Str")
}

test "a Result's Ok and Error cover it" {
	source := "func name(r: Result<Int, Bool>): Str \{ if r is Result.Ok(v) \{ return \"ok\" } else if r is Result.Error(e) \{ return \"no\" } }"
	assert problemCount(source) == 0
}

test "a return whose value does not fit the declaration is named" {
	assert opens(problem("func f(): Int \{ return \"s\" }"), "in `f`: this `return` wants Int and this is Str")
	assert opens(problem("proc f(): void \{ return 1 }"), "in `f`: this `return` answers with a value")
	assert opens(problem("func f(): Int \{ return }"), "in `f`: this `return` answers with nothing")
}

// --- Tests -------------------------------------------------------------------

test "a test returns nothing, because there is nobody to answer" {
	got := problem("test \"t\" \{ return 1 }")
	assert opens(got, "in `\"t\"`: a test returns nothing")
	// A bare return to leave early is fine.
	assert problemCount("test \"t\" \{ return }") == 0
}

// --- Loops -------------------------------------------------------------------

test "break and continue act on the innermost loop, and there has to be one" {
	assert opens(problem(inMain("break")), "in `main`: `break` and `continue` act on the innermost enclosing loop")
	assert problemCount(inMain("for i := 0; i < 3; i++ \{ break }")) == 0
	assert problemCount(inMain("for each x in [1] \{ continue }")) == 0
}

test "for each walks a vector, and a map and a Str are not one" {
	assert opens(problem("import hive.map\nproc main(): void \{ hive.map.Map<Str, Int> m = hive.map.new()  for each k in m \{ } }"), "in `main`: a map is reached by key")
	assert opens(problem(inMain("for each c in \"abc\" \{ }")), "in `main`: a `Str` is not a vector")
}

// --- Subscripts --------------------------------------------------------------

test "a Str is subscripted, by character" {
	assert problemCount(inMain("s := \"abc\"  if s bounds 0 \{ echo s[0] }")) == 0
	assert problemCount(inMain("s := \"abc\"  if s bounds 1 \{ echo s[0:1] }")) == 0
	assert problemCount(inMain("s := \"abc\"  if s bounds 1 \{ echo s[1:] }")) == 0
}

test "replaceFirst and replaceAll take three Strs" {
	assert problemCount(inMain("echo replaceFirst(\"a-b\", \"-\", \"+\")")) == 0
	assert problemCount(inMain("echo replaceAll(\"a-b\", \"-\", \"+\")")) == 0
	assert opens(problem(inMain("echo replaceAll(\"a\", \"-\")")), "in `main`: `replaceAll` takes 3 arguments")
	assert opens(problem(inMain("echo replaceFirst(1, \"-\", \"+\")")), "in `main`: what `replaceFirst` rewrites")
	assert opens(problem(inMain("echo replaceAll(\"a\", 1, \"+\")")), "in `main`: what `replaceAll` looks for")
	assert opens(problem(inMain("echo replaceFirst(\"a\", \"-\", 1)")), "in `main`: what `replaceFirst` puts in its place")
}

test "a Str cannot be assigned into by position" {
	got := problem(inMain("mut s := \"abc\"  if s bounds 0 \{ s[0] = \"x\" }"))
	assert opens(got, "in `main`: a `Str` cannot be assigned into by position")
	// A vector still can be: this refuses a Str, not every subscript.
	assert problemCount(inMain("mut Str[dyn] v = [\"a\"]  if v bounds 0 \{ v[0] = \"x\" }")) == 0
}

test "a map is reached by key, never by position" {
	got := problem("import hive.map\nproc main(): void \{ hive.map.Map<Str, Int> m = hive.map.new()  echo m[0] }")
	assert opens(got, "in `main`: a map is reached by key")
}

// --- Maps --------------------------------------------------------------------

test "an empty map has to land somewhere that says what it holds" {
	got := problem("import hive.map\nproc main(): void \{ m := hive.map.new() }")
	assert opens(got, "in `main`: `hive.map.new()` has to land somewhere that says what it holds")
	assert problemCount("import hive.map\nproc main(): void \{ hive.map.Map<Str, Int> m = hive.map.new()  echo len(m) }") == 0
}

// --- Operators ---------------------------------------------------------------

test "Hive never widens a number behind your back" {
	got := problem(inMain("echo 1 + 2.0"))
	assert got == "in `main`: `+` wants two of one type, and these are Int and Float. Hive never widens a number behind your back — `hive.conv.itf` is how an `Int` becomes a `Float`"

	// And the why is said only where widening is what was wanted: a message that
	// explained a conversion to somebody comparing an atom with a boolean would
	// be explaining something that is not the mistake.
	assert problem(inMain("flag := #Ready  if flag == true \{ echo 1 }")) == "in `main`: `==` wants two of one type, and these are Atom and Bool"
	assert problem(inMain("echo [1, 2] == 2")) == "in `main`: `==` wants two of one type, and these are Int[2] and Int"
}

test "&& and || join two Bools" {
	got := problem(inMain("echo 1 && true"))
	assert opens(got, "in `main`: `&&` joins two `Bool`s")
}

// --- async -------------------------------------------------------------------

test "async refuses a builtin, a constructor and a partial application by name" {
	assert opens(problem(inMain("Int[dyn] v = []  async len(v)")), "in `main`: `async` cannot fire off the builtin `len`")
	assert opens(problem("type User \{ id: Int }\nproc main(): void \{ async User(1) }"), "in `main`: `async` cannot fire off a constructor")
	assert opens(problem("proc f(a: Int, b: Int): void \{ }\nproc main(): void \{ async f(1, _) }"), "in `main`: `async` cannot fire off a partial application")
	assert problemCount("proc f(a: Int): void \{ }\nproc main(): void \{ async f(1) }") == 0
}

// --- Patterns ----------------------------------------------------------------

test "a pattern binds every field or none" {
	got := problem("type Shape \{ Rectangle \{ width: Int height: Int } }\nproc main(): void \{ s := Shape.Rectangle(1, 2)  if s is Shape.Rectangle(w) \{ } }")
	assert opens(got, "in `main`: `Shape.Rectangle` has 2 fields, and this pattern binds 1 argument")
	assert problemCount("type Shape \{ Rectangle \{ width: Int height: Int } }\nproc main(): void \{ s := Shape.Rectangle(1, 2)  if s is Shape.Rectangle(w, _) \{ } }") == 0
}

test "a pattern's subject has to be the kind of thing the pattern matches" {
	assert opens(problem(inMain("n := 1  if n is [\"a\"] \{ }")), "in `main`: a vector pattern matches a vector")
	assert opens(problem(inMain("n := 1  if n is \"/a\" \{ }")), "in `main`: a string pattern matches a `Str`")
}

// --- `SELECT *` --------------------------------------------------------------

// A query whose rows are a declared type may not ask for whatever the table
// happens to have. The rule is about the *result*, so everything that is not a
// select list still compiles.
func withRow(sql: Str): Str {
	return "type User \{ id: Int name: Str }\nquery q(): User[dyn] \{ " + sql + " }\nproc main(): void \{ }"
}

test "a star cannot fill in rows of a declared type" {
	assert opens(problem(withRow("SELECT * FROM users")),
		"in `q`: `SELECT *` cannot fill in rows of a declared type")
	assert opens(problem(withRow("SELECT *, id FROM users")),
		"in `q`: `SELECT *` cannot fill in rows of a declared type")
	assert opens(problem(withRow("SELECT u.* FROM users u")),
		"in `q`: `SELECT *` cannot fill in rows of a declared type")
	assert opens(problem(withRow("SELECT DISTINCT * FROM users")),
		"in `q`: `SELECT *` cannot fill in rows of a declared type")
	// Either half of a union is the result.
	assert opens(problem(withRow("SELECT id, name FROM users UNION SELECT * FROM ghosts")),
		"in `q`: `SELECT *` cannot fill in rows of a declared type")
}

test "naming the columns is what it wants" {
	assert problemCount(withRow("SELECT id, name FROM users")) == 0
	assert problemCount(withRow("SELECT u.id, u.name AS name FROM users u")) == 0
}

test "a star that is not a select list is nobody's business" {
	// Multiplication, a function's argument, a subquery, and a common table
	// expression — none of which is what the caller is handed.
	assert problemCount(withRow("SELECT id, name FROM users WHERE id * 2 > 4")) == 0
	assert problemCount(withRow("SELECT id, name FROM users HAVING count(*) > 1")) == 0
	assert problemCount(withRow("SELECT id, name FROM (SELECT * FROM users) u")) == 0
	assert problemCount(withRow("WITH all AS (SELECT * FROM users) SELECT id, name FROM all")) == 0
	assert problemCount(withRow("SELECT id, name FROM users WHERE note = 'a * b'")) == 0
	assert problemCount(withRow("SELECT id, name FROM users -- SELECT * would be wrong")) == 0
	assert problemCount(withRow("SELECT /* SELECT * */ id, name FROM users")) == 0
}

test "a star is fine where there are no fields to disagree with" {
	// A `Table` is rows of cells and has no names to line up, a single column is
	// not a row type, and a statement hands back a count rather than rows.
	assert problemCount("query q(): Table \{ SELECT * FROM users }\nproc main(): void \{ }") == 0
	assert problemCount("query q(): Str[dyn] \{ SELECT * FROM users }\nproc main(): void \{ }") == 0
	assert problemCount("query q(): void \{ INSERT INTO old SELECT * FROM users }\nproc main(): void \{ }") == 0
}

// --- What a call can reach through ------------------------------------------
//
// Every one of these used to reach the Go toolchain instead, which reported it
// against the generated file in terms of Go's own types. A rejection has to name
// the thing at fault ([18.1](../spec/18-conformance.md)), and Go naming `len_`
// or `float64` names nothing anybody wrote.

test "a call through a binding that holds no callable is named" {
	got := problem("proc greet(name: Str): Str \{ return name }\nproc main(): void \{ greet := 3  echo greet(\"a\") }")
	assert opens(got, "in `main`: `greet` here is Int, which is not something a call can reach through")
}

test "a binding that does hold one is called through happily" {
	assert problemCount("func twice(n: Int): Int \{ return n * 2 }\nproc main(): void \{ f := twice  echo f(2) }") == 0
	assert problemCount("func twice(n: Int): Int \{ return n * 2 }\nfunc via(f: func(Int): Int, n: Int): Int \{ return f(n) }\nproc main(): void \{ echo via(twice, 2) }") == 0
}

test "a name the standard library does not have is named" {
	assert problem(inMain("hive.task.nonsense(1)")) == "in `main`: `hive.task` has no `nonsense`"
	assert problem(inMain("echo hive.conv.nonsense(\"x\")")) == "in `main`: `hive.conv` has no `nonsense`"
	assert problem(inMain("echo hive.file.slurp(\"x\")")) == "in `main`: `hive.file` has no `slurp`"
	// A module it does not carry at all is a different sentence.
	assert problem(inMain("hive.nowhere.get()")) == "in `main`: this compiler does not carry `hive.nowhere`"
}

test "the names it does have are left alone" {
	assert problemCount(inMain("hive.task.sleep(1)")) == 0
	assert problemCount(inMain("echo hive.conv.its(1)")) == 0
	assert problemCount(inMain("echo hive.crypto.jwtDecode(\"t\") with Int")) == 0
	assert problemCount(inMain("hive.map.Map<Str, Int> m = hive.map.new()  hive.map.set(m, \"a\", 1)")) == 0
}

test "a library call is held to what its module takes" {
	// Hive never widens a number behind your back, and this is where that is
	// caught rather than left to Go to say `float64` about.
	got := problem(inMain("health := 3  echo hive.math.max(0, health)"))
	assert opens(got, "in `main`: the first argument of `hive.math.max` wants Float and this is Int")
	// And only where the module really does take one thing. A token's claims are
	// a value of the program's own type, so that position says nothing.
	session := "type Session \{ user: Str  exp: Int }\n"
	assert problemCount(session + inMain("echo hive.crypto.jwtSign(Session(\"ada\", 1), \"secret\")")) == 0
	assert opens(problem(session + inMain("echo hive.crypto.jwtSign(Session(\"ada\", 1), 1)")),
		"in `main`: the second argument of `hive.crypto.jwtSign` wants Str and this is Int")
	assert opens(problem(inMain("health := 3  echo hive.math.max(0.0, health)")),
		"in `main`: the second argument of `hive.math.max` wants Float and this is Int")
	assert problemCount(inMain("health := 3.0  echo hive.math.max(0.0, health)")) == 0
}

test "a builtin cannot be used as a value" {
	got := problem(inMain("Str[dyn] names = [\"a\"]  echo map(names, len)"))
	assert opens(got, "in `main`: `len` is a builtin, so it cannot be used as a value")
}

// --- Walking a vector --------------------------------------------------------

test "filter wants a Bool, filterMap a Result, and map something" {
	twice := "func twice(n: Int): Int \{ return n * 2 }\n"
	nothing := "proc shout(n: Int): void \{ echo n }\n"
	assert opens(problem(twice + inMain("echo filter([1, 2], twice)")),
		"in `main`: `filter` keeps the elements its function said yes to, so that function has to answer with a `Bool`")
	assert opens(problem(twice + inMain("echo filterMap([1, 2], twice)")),
		"in `main`: `filterMap` transforms and selects in one pass, so its function has to answer with a `Result`")
	assert opens(problem(nothing + inMain("echo map([1, 2], shout)")),
		"in `main`: `map` walks with a `func`, never a `proc`")
}

test "a walk takes a func over the elements, one at a time" {
	pair := "func pair(a: Int, b: Int): Int \{ return a + b }\n"
	assert opens(problem(pair + inMain("echo map([1, 2], pair)")),
		"in `main`: `map` hands its function one element at a time, and this one takes 2 arguments")
	assert opens(problem(inMain("echo map([1, 2], 3)")),
		"in `main`: `map` walks a vector with a function over its elements, and this second argument is Int")
	assert opens(problem(inMain("echo map([1, 2])")),
		"in `main`: `map` takes the vector to walk and the `func` to walk it with, and this call passes 1 argument")
	// And the element type has to be the one the function takes.
	assert opens(problem("func shout(s: Str): Str \{ return s }\n" + inMain("echo map([1, 2], shout)")),
		"in `main`: the element `map` hands its function wants Str and this is Int")
}

test "a walk that is right is left alone" {
	assert problemCount("func twice(n: Int): Int \{ return n * 2 }\n" + inMain("echo map([1, 2], twice)")) == 0
	assert problemCount("func big(n: Int): Bool \{ return n > 1 }\n" + inMain("echo filter([1, 2], big)")) == 0
	assert problemCount("func ok(n: Int): Result<Int, Bool> \{ return Result.Ok(n) }\n" + inMain("echo filterMap([1, 2], ok)")) == 0
}

// --- What a builtin takes ----------------------------------------------------
//
// Every builtin has a signature ([13](../spec/13-builtins.md)); every one of
// these used to reach the Go toolchain instead.

test "join, split, row and column are held to their signatures" {
	assert opens(problem(inMain("echo join([1, 2], \",\")")),
		"in `main`: what `join` concatenates wants Str[] and this is Int[2]")
	assert opens(problem(inMain("echo join([\"a\"], 1)")),
		"in `main`: the separator `join` puts between elements wants Str and this is Int")
	assert opens(problem(inMain("echo split(12, \",\")")),
		"in `main`: what `split` takes apart wants Str and this is Int")
	assert opens(problem(inMain("echo row([1, 2], \"a\")")),
		"in `main`: what `row` reads wants Str[][] and this is Int[2]")
	assert opens(problem(inMain("Str[dyn][dyn] t = []  echo column(t, 1)")),
		"in `main`: the key `column` looks for wants Str and this is Int")
}

test "len and bytes measure something that has a size" {
	assert opens(problem(inMain("echo len(1)")),
		"in `main`: `len` measures a vector or a `Str` or a map, and this is Int")
	assert opens(problem(inMain("hive.map.Map<Str, Int> m = hive.map.new()  echo bytes(m)")),
		"in `main`: `bytes` measures a vector's storage or a `Str`'s encoding, and a map is neither")
	assert opens(problem(inMain("echo len(\"a\", \"b\")")),
		"in `main`: `len` takes 1 argument, and this call passes 2 arguments")
	assert problemCount(inMain("hive.map.Map<Str, Int> m = hive.map.new()  echo len(m)  echo len(\"a\")  echo len([1])  echo bytes([1])")) == 0
}

test "indexOf looks for what could be there" {
	assert opens(problem(inMain("echo indexOf([1, 2], \"a\")")),
		"in `main`: what `indexOf` looks for wants Int and this is Str")
	assert opens(problem(inMain("echo indexOf(\"ab\", 1)")),
		"in `main`: what `indexOf` looks for in a `Str` wants Str and this is Int")
	assert problemCount(inMain("echo indexOf([1, 2], 2)  echo indexOf(\"ab\", \"b\")")) == 0
}

test "sort orders a vector, by its own order or by a func of two" {
	twice := "func twice(n: Int): Int \{ return n * 2 }\n"
	assert opens(problem(twice + inMain("echo sort([2, 1], twice)")),
		"in `main`: the order `sort` was given wants func(Int, Int): Bool and this is func(Int): Int")
	assert opens(problem(inMain("echo sort(1)")),
		"in `main`: `sort` orders a vector, and this is Int")
	assert problemCount("func firstOf(a: Int, b: Int): Bool \{ return a < b }\n" + inMain("echo sort([2, 1], firstOf)")) == 0
	assert problemCount(inMain("echo sort([2, 1])")) == 0
}

test "append and drop are held to what the vector holds" {
	assert opens(problem(inMain("mut Int[dyn] v = [1]  append(v, \"a\")")),
		"in `main`: what `append` puts in wants Int and this is Str")
	assert opens(problem(inMain("mut Int[dyn] v = [1, 2]  echo drop(v, \"a\", 1)")),
		"in `main`: the low bound of `drop` wants Int and this is Str")
	assert problemCount(inMain("mut Int[dyn] v = [1, 2]  append(v, 3)  echo drop(v, 0, 1)")) == 0
}

// --- Several at once ---------------------------------------------------------

test "every mistake is reported, not just the first" {
	// Three declarations, one mistake each.
	source := "func a(): Int \{ return \"s\" }\nfunc b(): Int \{ }\nproc c(): void \{ echo nowhere }"
	assert problemCount(source) == 3
}
