// Tests for `src/icon`.
//
// What can be asked without a build running: which file a program's icon is
// read from, what the resource object beside it is called, and which
// architectures one is written for. That the object is a resource Windows reads
// is not a thing a Hive test can ask — it takes a linker and a `.exe` — so it is
// checked by building one.
import ../src/icon
import hive.file

// A program at `_icons/<name>/app.hive`, with `assets/icon.png` beside it where
// `withIcon`. The contents are never read here: `iconOf` answers on the file
// being there, and what it holds is the generator's business.
proc program(name: Str, withIcon: Bool): Str {
	directory := "_icons/" + name
	if hive.file.makeDir(directory + "/assets") is Result.Error(why) {
		panic "could not make {directory}: {why.message}"
	}
	entry := directory + "/app.hive"
	if hive.file.write(entry, "proc main(): void \{ }\n") is Result.Error(why) {
		panic "could not write {entry}: {why.message}"
	}
	if withIcon {
		if hive.file.write(directory + "/assets/icon.png", "not really a PNG") is Result.Error(why) {
			panic "could not write the icon: {why.message}"
		}
	}
	return entry
}

test "an icon is the one file beside the program, and nothing else is" {
	assert icon.iconOf(program("shipped", true)) == "_icons/shipped/assets/icon.png"
	// An assets directory holding other things is a program with no icon.
	assert icon.iconOf(program("bare", false)) == ""
	// And so is a program with no assets directory at all.
	assert icon.iconOf("_icons/nowhere/app.hive") == ""
}

test "the resource object is named for the platform it is for" {
	// The name is the whole of what keeps a Windows resource out of a build for
	// somewhere else: the Go toolchain reads the platform off it.
	assert icon.sysoName("amd64") == "rsrc_windows_amd64.syso"
	assert icon.sysoName("arm64") == "rsrc_windows_arm64.syso"
}

test "an object is written for the architectures the generator knows" {
	assert icon.carriesResource("amd64")
	assert icon.carriesResource("386")
	assert icon.carriesResource("arm64")
	// One it does not know keeps its window icon and gives the file none.
	assert icon.carriesResource("arm") == false
	assert icon.carriesResource("") == false
}

test "what the build embeds is what the embed names" {
	// The two have to agree: `//go:embed` names a file in its own package, and
	// the copy is what it names.
	assert icon.embeddedName() == "windowicon.png"
	embedded := icon.embedSource()
	assert contains(embedded, "//go:embed " + icon.embeddedName())
	assert contains(embedded, "uiWindowIconIs(body)")
}

// The generator is Go rather than Hive, so what is asked of it here is that it
// is the program the build runs: three arguments, in the order they are passed.
test "the generator takes the image, the object to write and the architecture" {
	source := icon.generatorSource()
	assert contains(source, "package main")
	assert contains(source, "usage: icon <image.png> <out.syso> <arch>")
	assert contains(source, "RT_GROUP_ICON")
}

func contains(haystack: Str, needle: Str): Bool {
	return indexOf(haystack, needle) is Result.Ok(_)
}
