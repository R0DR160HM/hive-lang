// Every local below shares a name with this module's own `value` func, so each
// must keep shadowing it while the bare calls still reach the module-level one.
func value(): Str {
	return "module-func"
}

func useLocal(): Str {
	value := "local-var"
	return value
}

func useModule(): Str {
	return value()
}

func useParam(value: Str): Str {
	return value
}

func useLoop(): Str {
	mut out := ""
	for each value in ["a", "b"] {
		out = out + value
	}
	return out + "/" + value()
}

func useBinding(text: Str): Str {
	parsed := hive.conv.sti(text)
	if parsed is Result.Ok(value) && value > 10 {
		return "big-" + hive.conv.its(value)
	}
	return value()
}
