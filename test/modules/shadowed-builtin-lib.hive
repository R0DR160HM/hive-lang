// This module declares no `map`, so a bare `map` here is the builtin — even
// though the module that imports it has one of its own. Shadowing is per module:
// another module's declarations are only ever reached through its alias.

func double(n: Int): Int {
	return n * 2
}

func doubleAll(v: Int[]): Int[] {
	return map(v, double)
}

func count(v: Int[]): Int {
	return len(v)
}
