import ./shadow-lib as helper

type Box {
	label: Str
}

// A local named like the import shadows it, so this is plain field access.
proc localWins(): Str {
	helper := Box("field-access")
	return helper.label
}

proc main(): void {
	echo helper.useLocal()
	echo helper.useModule()
	echo helper.useParam("param")
	echo helper.useLoop()
	echo helper.useBinding("42")
	echo localWins()
}
