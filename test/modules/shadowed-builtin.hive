import ./shadowed-builtin-lib as nums

// This module's own `map` wins for every bare `map` it writes.
func map(a: Int, b: Int): Int {
	return a * b
}

func show(n: Int): Str {
	return "{n}"
}

proc main(): void {
	echo map(6, 7)
	Int[dyn] v = [1, 2, 3]
	echo nums.count(v)
	Int[dyn] doubled = nums.doubleAll(v)
	// And the builtin is still here, by its long name.
	echo hive.join(hive.map(doubled, show), ",")
}
