import ./lib as helper

type Style {
	Boxed
}

proc main(): void {
	echo helper.shout("hi")
	echo helper.decorate("x", helper.Style.Plain())
	helper.Style loud = helper.Style.Loud()
	if loud is helper.Style.Loud {
		echo "matched"
	}
	if Style.Boxed() is Style.Boxed {
		echo "own type is distinct"
	}
}
