// A program holding `hive.net`'s streamed responses, so their Go is in the
// package the tests beside it are dropped into.
import hive.net

proc main(): void {
    if hive.net.httpOpen(hive.net.HttpRequest("GET", "http://127.0.0.1:1/", [], "")) is Result.Ok(stream) {
        echo hive.net.httpReceiveLine(stream)
        echo hive.net.httpReceive(stream, 10)
        hive.net.httpClose(stream)
    }
}
