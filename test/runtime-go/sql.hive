// What `sql_test.go` is compiled against: a program that opens a database, which
// is what brings the drivers into the build.
query answer(): Int[dyn] {
    SELECT 42
}

proc main(): void {
    if hive.sql.connect(hive.sql.DatabaseDriver.SQLite(), ":memory:") is Result.Ok(db) {
        echo hive.sql.run(db, answer()) is Result.Ok(_)
    }
}
