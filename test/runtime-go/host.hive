// What the Go beside this is compiled against.
//
// `test/runtime.test.hive` asserts about the runtime as text, which catches a
// line that reads wrong. This catches one that reads right: the Go is built and
// its own tests are run over it. See `test/runtime-go/run`.
import hive.ui

proc main(): void {
	echo ui.html(ui.scene([ui.eye(0.0, 1.7, 0.0)], [
		ui.box([ui.at(0.0, 0.0, 0.0), ui.paint(ui.Tone.Good())], 1.0, 1.0, 1.0)
	]))
}
