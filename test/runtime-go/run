#!/usr/bin/env bash
# The runtime's own Go, tested as Go.
#
# `test/runtime.test.hive` asserts about that Go as text, which catches a line
# that reads wrong. This catches one that reads right: `host.hive` is compiled,
# the `_test.go` files here are dropped into the package the compiler wrote, and
# `go test` is run over it.
#
# It is here for the things only running can show — a difference against a tree
# that no longer describes the document it came from, an event that stopped being
# delivered — and it needs no more than the Go the compiler already requires.
set -uo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
hive="$here/../../hive"

if ! command -v go >/dev/null 2>&1; then
	echo "  SKIP  runtime-go (no Go toolchain)"
	exit 0
fi

build="$here/host.hive-build"
rm -rf "$build"
if ! out="$("$hive" build "$here/host.hive" 2>&1)"; then
	echo "  FAIL  runtime-go (host.hive did not build)"
	echo "$out" | sed 's/^/        /'
	exit 1
fi

cp "$here"/*_test.go "$build/hive/"

# -count=1 because the package is written fresh every run and Go would otherwise
# answer from a cache keyed on a file it has already seen.
if out="$(cd "$build" && go test -count=1 ./hive/ 2>&1)"; then
	echo "$out" | grep -E '^(ok|---)' | sed 's/^/  /'
	echo "  PASS  runtime-go"
	rm -rf "$build" "$here/host.exe" "$here/host"
	exit 0
fi

echo "  FAIL  runtime-go"
echo "$out" | sed 's/^/        /' | head -40
exit 1
