#!/usr/bin/env bash
# The runtime's own Go, tested as Go.
#
# `test/runtime.test.hive` asserts about that Go as text, which catches a line
# that reads wrong. This catches one that reads right: each host program here is
# compiled, its `_test.go` files are dropped into the package the compiler wrote,
# and `go test` is run over it.
#
# It is here for the things only running can show — a difference against a tree
# that no longer describes the document it came from, an event that stopped being
# delivered — and it needs no more than the Go the compiler already requires.
set -uo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
hive="$here/../../hive"

if ! command -v go >/dev/null 2>&1; then
	echo "  SKIP  runtime-go (no Go toolchain)"
	exit 0
fi

# Each host is handed the tests written against what it compiles to: `host.hive`
# draws a scene, and `native.hive` a window the program draws itself.
tested() {
	local host="$1"
	shift
	local build="$here/$host.hive-build"
	rm -rf "$build"
	if ! out="$("$hive" build "$here/$host.hive" 2>&1)"; then
		echo "  FAIL  runtime-go ($host.hive did not build)"
		echo "$out" | sed 's/^/        /'
		return 1
	fi
	for test in "$@"; do
		cp "$here/$test" "$build/hive/"
	done
	# -count=1 because the package is written fresh every run and Go would otherwise
	# answer from a cache keyed on a file it has already seen.
	if out="$(cd "$build" && go test -count=1 ./hive/ 2>&1)"; then
		echo "$out" | grep -E '^(ok|---)' | sed 's/^/  /'
		rm -rf "$build" "$here/$host.exe" "$here/$host"
		return 0
	fi
	echo "  FAIL  runtime-go ($host)"
	echo "$out" | sed 's/^/        /' | head -40
	return 1
}

tested host document_test.go events_test.go || exit 1
tested native native_test.go || exit 1
tested syslink syslink_test.go || exit 1
tested secrets secret_test.go secretlimit_test.go || exit 1
echo "  PASS  runtime-go"
