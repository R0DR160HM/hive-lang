// A program holding `hive.image` and `hive.file`'s places and assets, so their
// Go is in the package the tests beside it are dropped into.
import hive.image
import hive.file

proc main(): void {
    if hive.image.decode("") is Result.Ok(picture) {
        echo hive.image.scale(picture, 1, 1).width
    }
    echo hive.file.isDir(".")
    echo hive.file.workingDirectory()
    echo hive.file.home()
    echo hive.file.executable()
    echo hive.file.asset("nothing")
}
