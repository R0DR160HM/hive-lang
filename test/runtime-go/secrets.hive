// What `secret_test.go` and `secretlimit_test.go` are compiled against: a
// program that reads and opens a secret both ways, locked and not.
proc main(): void {
    sealed := hive.crypto.encrypt(bypass("text"), bypass("password"))
    if hive.crypto.decrypt(sealed, bypass("password")) is Result.Ok(opened) {
        echo opened == hive.term.readSecretBypass()
    }
}
