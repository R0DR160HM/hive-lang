// A window with no scene in it, so the build writes the window the program draws
// itself, which `native_test.go` is run against. See `test/runtime-go/run`.
import hive.ui

func view(count: Int): ui.View {
    return ui.text([], "{count}")
}

proc update(count: mut Int, by: Int): Int {
    count = count + by
    return by
}

proc main(): void {
    opened := spawn(ui.window("native", view, update), 0)
    if opened is Result.Error(problem) {
        panic problem
    }
}
