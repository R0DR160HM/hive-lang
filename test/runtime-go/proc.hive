// A program holding `hive.term.start`, so the Go for programs that run
// alongside is in the package the tests beside it are dropped into.
import hive.term

proc main(): void {
    if hive.term.start("go", ["version"], "") is Result.Ok(started) {
        echo hive.term.processReceiveLine(started)
        echo hive.term.processWait(started)
    }
}
