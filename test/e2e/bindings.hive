type Shape {
	Circle { r: Int }
	Square { side: Int }
	Point
}

func parse(s: Str): Result<Int, Str> {
	if s == "1" {
		return Result.Ok(1)
	}
	return Result.Error("bad {s}")
}

func doubled(s: Str): Result<Int, Str> {
	Result.Ok(n) := parse(s) else {
		Result.Error(why) { return Result.Error("doubled: {why}") }
	}
	return Result.Ok(n * 2)
}

func radius(s: Shape): Int {
	Shape.Circle(r) := s else {
		Shape.Square(side) { return side / 2 }
		_ { return 0 }
	}
	return r
}

func head(v: Str[]): Str {
	[first, ...rest] := v else {
		[] { return "empty" }
	}
	return "{first} and {len(rest)} more"
}

func user(path: Str): Str {
	"/users/{id}" := path else {
		_ { return "no user" }
	}
	return "user {id}"
}

proc main(): void {
	echo doubled("1")
	echo doubled("2")
	echo radius(Shape.Circle(3))
	echo radius(Shape.Square(8))
	echo radius(Shape.Point())
	echo head(["a", "b", "c"])
	echo head([])
	echo user("/users/42")
	echo user("/nope")
	mut total := 0
	for each s in ["1", "x", "1"] {
		Result.Ok(n) := parse(s) else {
			Result.Error(_) { continue }
		}
		total = total + n
	}
	echo total
}
