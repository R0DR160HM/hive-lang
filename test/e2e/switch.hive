type Bazz {
    Something { n: Int }
    Nothing
}

type Fuzz {
    Variable { v: Str }
    Other
}

type Shape {
    Circle { r: Int }
    Square { side: Int }
    Point
}

type Pair {
    Of { left: Int, right: Int }
}

type Counter {
    n: Int
}

proc foo(bazz: Bazz, fuzz: Fuzz): void {
    switch bazz, fuzz {
        Bazz.Something(_), Fuzz.Variable(myVariable) {
            echo "something, {myVariable}"
        }
        Bazz.Nothing(), _ {
            echo "nothing"
        }
        _, Fuzz.Other {
            echo "something, other"
        }
    }
}

func describe(s: Shape): Str {
    switch s {
        Shape.Circle(r) { return "circle {r}" }
        Shape.Square(side) { return "square {side}" }
        Shape.Point { return "point" }
    }
}

func both(a: Bool, b: Bool): Str {
    switch a, b {
        true, true { return "both" }
        true, false { return "first" }
        false, _ { return "not first" }
    }
}

func count(n: Int): Str {
    switch n {
        0 { return "zero" }
        -1 { return "minus one" }
        _ { return "many" }
    }
}

func first(v: T[], fallback: T): T {
    switch v {
        [] { return fallback }
        [x, ...rest] { return x }
    }
}

func route(path: Str): Str {
    switch path {
        "/" { return "home" }
        "/users/{id}" { return "user {id}" }
        _ { return "missing" }
    }
}

func parse(s: Str): Result<Int, Str> {
    if s == "1" {
        return Result.Ok(1)
    }
    return Result.Error("bad {s}")
}

func shadowed(a: Pair, b: Int): Str {
    switch a, b {
        Pair.Of(b, _), 7 { return "left {b}, seven" }
        _, _ { return "other" }
    }
}

proc step(c: mut Counter): Int {
    c.n = c.n + 1
    return c.n
}

proc main(): void {
    foo(Bazz.Something(1), Fuzz.Variable("x"))
    foo(Bazz.Nothing(), Fuzz.Variable("y"))
    foo(Bazz.Something(2), Fuzz.Other())
    echo describe(Shape.Circle(2))
    echo describe(Shape.Point())
    echo both(true, false)
    echo both(false, true)
    echo count(0)
    echo count(-1)
    echo count(7)
    echo first([3, 4], 0)
    echo first(["x"], "none")
    echo route("/")
    echo route("/users/42")
    echo route("/nope")
    switch parse("1"), parse("2") {
        Result.Ok(a), Result.Ok(b) { echo "two: {a} {b}" }
        Result.Ok(a), Result.Error(e) { echo "one: {a}, then {e}" }
        Result.Error(e), _ { echo "none: {e}" }
    }
    echo shadowed(Pair.Of(1, 2), 7)
    echo shadowed(Pair.Of(1, 2), 8)
    mut c := Counter(0)
    switch c.n, step(c) {
        0, 1 { echo "read before the step" }
        _, _ { echo "read after the step" }
    }
    mut total := 0
    for each s in [Shape.Point(), Shape.Square(3), Shape.Circle(1)] {
        switch s {
            Shape.Point { continue }
            _ { total = total + 1 }
        }
    }
    echo total
}
