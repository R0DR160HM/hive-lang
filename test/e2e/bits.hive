// Bitwise operators, and bytes matched and built field by field.
func fnv1a(text: Str): UInt32 {
    mut UInt32 hash = 0x811C_9DC5
    for each b in hive.conv.bytesOf(text) {
        hash = (hash ^ UInt32(b)) * 0x0100_0193
    }
    return hash
}

func describe(packet: UInt8[]): Str {
    if packet is <<version: UInt4, ihl: UInt4, _: UInt8, length: UInt16, ...rest>> {
        return "v{version} ihl {ihl} length {length} rest {rest}"
    }
    return "not a packet"
}

proc main(): void {
    UInt8 a = 0b1100_1010
    echo a & 0x0F
    echo a | 0x01
    echo a ^ 0xFF
    echo ~a
    UInt4 small = 3
    echo ~small
    echo a << 1
    echo a >> 4
    Int8 s = -16
    echo s >> 2
    n := 1 << 40
    echo n
    UInt8 shift = 3
    echo 1 << shift
    mut UInt16 flags = 0
    flags |= 0x0100
    flags ^= 0x0001
    flags <<= 1
    echo flags
    echo a & 1 == 0
    UInt64 top = 0xFFFF_FFFF_FFFF_FFFF
    echo top
    echo fnv1a("hello")
    echo fnv1a("")

    UInt8[dyn] header = <<UInt4(4), UInt4(5), 0, 0x0054: UInt16, 7, 9>>
    echo header
    echo describe(header)
    echo describe([1])

    if "PNG\{rest}" is <<"PNG", ...tail>> {
        echo "magic, then {tail}"
    }
    UInt8[dyn] framed = <<3, "abc", 0xFF>>
    if framed is <<size, body: UInt8[size], last>> {
        echo "{size} {body} {last}"
    }
    UInt16 word = 0xAB_CD
    if word is <<high: UInt8, low: UInt4, _: UInt4>> {
        echo "{high} {low}"
    }
    UInt8[dyn] le = <<0x1234: UInt16 little>>
    echo le
    if le is <<v: UInt16 little>> {
        echo v
    }
    Int8 neg = -2
    echo <<neg, UInt4(15), UInt4(0)>>
    if <<neg>> is <<back: Int8>> {
        echo back
    }
    str := hive.conv.fromBytes(<<72, 105>>)
    echo str
    Str[16] names = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p"]
    Int h = 0x1234_5679
    echo names[h & 15]
    echo [1, 2] |> len
}
