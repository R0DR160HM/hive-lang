// Writing a secret: `hive.file.writeSecret` is `hive.file.write` leaving the
// file readable by the one account that wrote it.
//
// What that means is a mode on Linux and macOS and an access list on Windows, so
// the platform is asked rather than assumed — `go env GOOS` says which this is,
// and `ls -l` or `icacls` answers the question. The Go toolchain is already what
// compiled this, so nothing new has to be installed for the suite to run, which
// is the same bargain `exec.hive` strikes.
import hive.term

func directory(): Str { return "./secrets-e2e" }

proc main(): void {
	hive.file.makeDir(directory())

	fresh := directory() + "/fresh.key"
	echo "a secret nobody wrote before"
	if hive.file.writeSecret(fresh, "hunter2") is Result.Ok(written) {
		echo "  wrote          {written}"
	}
	echo "  reads back     " + contents(fresh)
	echo "  others reach   {reachableByOthers(fresh)}"

	// The half `hive.file.write` cannot do: a file that is already there keeps
	// whatever it was created with, and a secret going into it must not.
	older := directory() + "/older.key"
	hive.file.write(older, "a much longer old secret")
	widen(older)
	echo ""
	echo "a wider file that was already there"
	echo "  others reach   {reachableByOthers(older)} before"
	hive.file.writeSecret(older, "short")
	echo "  others reach   {reachableByOthers(older)} after"
	// And it is a replacement rather than an overwrite: none of the longer
	// secret it replaced is left on the end.
	echo "  reads back     " + contents(older)

	echo ""
	echo "a path that cannot be written"
	if hive.file.writeSecret(directory() + "/nowhere/x.key", "x") is Result.Error(why) {
		echo "  " + why.reason
	}

	hive.file.delete(fresh)
	hive.file.delete(older)
	hive.file.delete(directory())
}

func contents(path: Str): Str {
	if hive.file.read(path) is Result.Ok(text) {
		return text
	}
	return "<not there>"
}

// Opens the file to everybody, so that what `writeSecret` then does to it is
// visible rather than whatever this machine's umask happened to leave. On
// Windows it is already open: a new file inherits the containing folder's list,
// which names SYSTEM and the administrators besides whoever made it.
proc widen(path: Str): void {
	if platform() != "windows" {
		hive.term.exec("chmod", ["644", path], "")
	}
}

// Whether anybody but the owner can reach the file.
proc reachableByOthers(path: Str): Bool {
	if platform() == "windows" {
		// `icacls` prints the access list one entry to a line, each naming an
		// account and what it is allowed. A secret's names one.
		return entries(ran("icacls", [path])) != 1
	}
	return othersInMode(firstLine(ran("ls", ["-l", path])))
}

// Whether the mode `ls` prints at the front of a line leaves anything to
// anybody but the owner.
func othersInMode(line: Str): Bool {
	mut Str[dyn] beyond = []
	mut i := 0
	for each c in split(line, "") {
		// Character 0 is the type and 1 to 3 are the owner's. 4 to 9 are the
		// group's and the world's, and an `11`th character of `+` is an access
		// list holding more than the mode can show.
		if i >= 4 && i <= 9 && c != "-" {
			append(beyond, c)
		}
		if i == 10 && c == "+" {
			append(beyond, c)
		}
		i = i + 1
	}
	return len(beyond) > 0
}

// How many entries `icacls` printed, counted by the `ACCOUNT:(rights)` each is
// written as.
func entries(printed: Str): Int {
	mut counted := 0
	for each line in split(printed, "\n") {
		if indexOf(line, ":(") is Result.Ok(_) {
			counted = counted + 1
		}
	}
	return counted
}

proc platform(): Str {
	return firstLine(ran("go", ["env", "GOOS"]))
}

proc ran(command: Str, arguments: Str[]): Str {
	if hive.term.exec(command, arguments, "") is Result.Ok(output) {
		return output
	}
	return ""
}

// The first line of what a command wrote, without the carriage return Windows
// puts in front of the newline.
func firstLine(whole: Str): Str {
	lines := split(whole, "\n")
	if lines bounds 0 {
		parts := split(lines[0], "\r")
		if parts bounds 0 {
			return parts[0]
		}
	}
	return ""
}
