// The same rule as `shadowing.hive`, through `hive test`.
//
// `hive test` emits a second file into the same package and walks the passes
// over a `test` body rather than a `proc` one. That is where this was reported
// from, and for a reason worth keeping: an `assert` compares two types, so a
// test says out loud what ordinary code can leave unsaid.

func len(label: Str, extra: Int): Str {
	return "{label}{extra}"
}

proc append(label: Str, extra: Str): Str {
	return label + extra
}

func join(a: Str, b: Str): Str {
	return a + "-" + b
}

// Reached from nowhere but a test, which is the one place a copy of a generic
// used never to be made.
func firstOf(v: T[]): Result<T, Bool> {
	if hive.len(v) > 0 {
		return Result.Ok(v[0])
	}
	return Result.Error(false)
}

test "a shadowing declaration answers with its own type" {
	assert len("x", 2) == "x2"
	Str s = len("y", 3)
	assert s == "y3"
}

test "and at its own arity" {
	assert join("c", "d") == "c-d"
	assert append("a", "b") == "ab"
}

test "the long name still reaches the builtin" {
	Str[dyn] v = ["p", "q"]
	assert hive.len(v) == 2
	assert hive.join(v, "+") == "p+q"
	mut Str[dyn] growing = []
	hive.append(growing, "r")
	assert hive.len(growing) == 1
}

test "a local binding shadows the declaration in turn" {
	len := "a name, not a callable"
	assert len == "a name, not a callable"
}

test "and the long name still stands as a statement beside one that does" {
	mut Str[dyn] v = []
	append := "a name either"
	hive.append(v, "x")
	assert hive.len(v) == 1
	assert append == "a name either"
}

test "a generic reached only from a test is copied for it" {
	Str[2] names = ["a", "b"]
	if firstOf(names) is Result.Ok(first) {
		assert first == "a"
	}
	Int[dyn] counts = [7]
	if firstOf(counts) is Result.Ok(n) {
		assert n == 7
	}
}
