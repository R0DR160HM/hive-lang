-- a copy, because one end can write --
["a", "b", "c"]
["a", "b"]
-- shared, because both ends are mut --
4
changed
4
1
-- a mut parameter takes the caller's own storage --
["one", "two"]
-- an ordinary parameter takes a copy --
2
["one", "two"]
-- a nested vector copies every level --
[["changed", "2"], ["3", "4"]]
[["1", "2"], ["3", "4"]]
-- a struct copies its storage-owning fields --
["p", "q", "r"]
["p", "q"]
-- a map is a value: only a `mut` one is written, and a copy is its own --
2
{"bees": 3}
{}
{"bees": 3}
{"bees": 3, "wasps": 1}
{"bees": 3}
{"bees": 3}
-- an assignment copies what an immutable name still sees --
Ok(1)
false
false
["a", "b"]
-- a field holding a mut name's storage is copied with its record --
false
-- a fresh right-hand side is already independent --
["a", "b"]
