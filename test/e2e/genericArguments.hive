// A type variable inside a generic type's own arguments. `count(b: Box<T>)`
// handed a `Box<Int>` reads `T` off the `Int` the box was written out at, however
// the box got there and however deep the variable sits.
import ./lib/paging

type Box {
    items: T[dyn]
    label: Str
}

type Holder {
    box: Box<Int>
}

type Entry {
    title: Str
}

func count(b: Box<T>): Int {
    return len(b.items)
}

func deep(b: Box<Box<T>>): Int {
    mut total := 0
    for each inner in b.items {
        total = total + count(inner)
    }
    return total
}

func countIfOk(r: Result<Box<T>, Str>): Int {
    if r is Result.Ok(b) {
        return count(b)
    }
    return 0
}

func firstOr(v: T[], fallback: T): T {
    for each item in v {
        return item
    }
    return fallback
}

func made(): Box<Int> {
    return Box([4, 5], "made")
}

// The declared result says which copy an empty `[]` builds.
func emptyLabels(): Box<Str> {
    return Box([], "none")
}

func titleOf(e: Entry): Str {
    return e.title
}

proc main(): void {
    // However the box got there: declared, built in place, bound with `:=`,
    // answered by a call, or read out of a field.
    Box<Int> numbers = Box([1, 2, 3], "numbers")
    echo count(numbers)
    echo count(Box(["a", "b"], "in place"))
    bound := Box([1.5], "bound")
    echo count(bound)
    echo count(made())
    echo count(emptyLabels())
    Holder held = Holder(Box([7, 8, 9, 10], "held"))
    echo count(held.box)

    // However deep the variable sits.
    Box<Box<Int>> nested = Box([Box([1], "a"), Box([2, 3], "b")], "nested")
    echo deep(nested)
    echo count(nested)
    Result<Box<Int>, Str> answer = Result.Ok(numbers)
    echo countIfOk(answer)
    Box<Int>[dyn] boxes = [numbers, made()]
    echo count(firstOr(boxes, numbers))

    // An empty `[]` says nothing about `T`, so another argument does — or the
    // declaration beside it.
    echo firstOr([], 42)
    Box<Int> none = Box([], "none")
    echo count(none)

    // A hole is fine once what is passed fixes every variable.
    orElse := firstOr(_, "nobody")
    Str[dyn] nobody = []
    echo orElse(nobody)

    // A generic type from another module.
    Entry[dyn] entries = [Entry("ada"), Entry("grace"), Entry("hedy"), Entry("joan"), Entry("mary")]
    paging.Page<Entry> first = paging.paginate(entries, 2, 1)
    echo paging.countOf(first)
    last := paging.paginate(entries, 2, 3)
    echo paging.headline(last, titleOf)
    echo paging.headline(paging.paginate(entries, 2, 9), titleOf)
    paging.Page<Entry> blank = paging.Page([], 1)
    echo paging.countOf(blank)
}
