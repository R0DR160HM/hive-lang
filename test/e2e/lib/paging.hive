// A generic type and the generics that take it, from a module of their own: a
// caller writes `paging.Page<T>`, and the copies are made in the program that
// asked for them.

type Page {
	items: T[dyn]
	number: Int
}

// Page `number`, counting from 1, of `items` cut into pages of `size`. A page
// that does not exist comes back empty, and the declared result is what says
// which copy that empty one is.
func paginate(items: T[], size: Int, number: Int): Page<T> {
	first := (number - 1) * size
	mut last := first + size - 1
	if last >= len(items) {
		last = len(items) - 1
	}
	if items bounds first && items bounds last {
		return Page(items[first:last], number)
	}
	return Page([], number)
}

func countOf(p: Page<T>): Int {
	return len(p.items)
}

func headline(p: Page<T>, show: func(T): Str): Str {
	for each item in p.items {
		return "page {p.number} starts at {show(item)}"
	}
	return "page {p.number} is empty"
}
