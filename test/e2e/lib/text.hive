// A module is just a `.hive` file — there is nothing to declare at the top of
// one, and everything it holds is visible to whoever imports it.
type Align {
	Left
	Right
}

func pad(word: Str, width: Int, align: Align): Str {
	mut out := word
	for ; len(out) < width; {
		if align is Align.Left {
			out = out + " "
		} else {
			out = " " + out
		}
	}
	return out
}

func repeat(unit: Str, times: Int): Str {
	mut out := ""
	for i := 0; i < times; i++ {
		out = out + unit
	}
	return out
}
