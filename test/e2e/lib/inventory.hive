// A module may import modules of its own, and a file is loaded once however many
// modules reach for it.
import ./text

type Item {
	name: Str
	pence: Int
}

func total(items: Item[]): Int {
	mut sum := 0
	for each item in items {
		sum = sum + item.pence
	}
	return sum
}

func money(pence: Int): Str {
	pounds := hive.conv.its(pence / 100)
	pennies := pence % 100
	if pennies < 10 {
		return "GBP {pounds}.0{pennies}"
	}
	return "GBP {pounds}.{pennies}"
}

func line(item: Item): Str {
	return text.pad(item.name, 16, text.Align.Left()) + text.pad(money(item.pence), 12, text.Align.Right())
}
