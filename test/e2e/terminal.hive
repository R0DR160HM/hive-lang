// Writing to the terminal a piece at a time, and asking it what it is.
//
// The suite collects what a program prints, so standard output is a pipe here
// and never a window: `size` is the error a program sees when it is redirected.
import hive.term

proc main(): void {
    hive.term.print("built ")
    hive.term.print("in ")
    hive.term.print("pieces")
    hive.term.println("")
    hive.term.println("a whole line")
    hive.term.print("")
    hive.term.println("and nothing printed before it")

    if hive.term.size() is Result.Error(hive.term.TermError.NotATerminal(message)) {
        echo "not a terminal: {message}"
    }

    key := hive.term.Key("Ctrl+C", "")
    echo key
    echo hive.term.Size(80, 24)
}
