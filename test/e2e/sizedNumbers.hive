type Options {
	level: UInt8 -- Default as 3;
	ratio: Float32
	steps: Int12[dyn]
}

type Pixel {
	r: UInt8
	g: UInt8
	b: UInt8
	alpha: UInt4 -- Default as 15;
}

type Reading {
	celsius: Float32
	sensor: Int12
}

func grow(n: Int): Int {
	return n * 2
}

func paint(level: UInt4): Str {
	return "level {level}"
}

func clampTo(n: Int): UInt8 {
	if UInt8.checked(n) is Result.Ok(v) {
		return v
	}
	return 255
}

func twice(x: T): T {
	return x + x
}

func widest(a: UInt8): Int64 {
	return Int(a)
}

proc bump(n: mut UInt8): void {
	n += 1
}

proc rest(): void {
	mut Int total = 0
	UInt8 b = 250
	total = Int(b)
	echo total
	echo widest(b)
	mut UInt16[dyn] list = []
	append(list, UInt16(b))
	append(list, 7)
	echo list
	UInt8[3] mix = [b, 1, 2]
	echo mix
	echo twice(UInt8(200))
	echo twice(3)
	f := widest
	echo f(UInt8(100))
	mut UInt8 m = 254
	bump(m)
	bump(m)
	echo m
	for UInt8 i = 0; i < 3; i++ {
		echo "i {i}"
	}
	Float64 x = 2.5
	Int64 y = 7
	echo x + 1.0
	echo y + 1
	echo hive.UInt4(31)
	echo UInt64(-1)
	echo Int(UInt64(-1))
	echo Float(Float32(0.5))
	echo indexOf([UInt8(1), 2, 3], 2)
	if Options.decode("--level=9 --ratio=0.25 --steps=5 --steps=-7", hive.term.codec()) is Result.Ok(o) {
		echo o
		echo encode(o, hive.term.codec())
	}
	if Options.decode("--level=300 --ratio=1", hive.term.codec()) is Result.Error(why) {
		echo "{why.path} {why.expected} {why.found}"
	}
	if Options.decode("--ratio=1", hive.term.codec()) is Result.Ok(o) {
		echo o.level
	}
}

proc main(): void {
	rest()
	UInt4 a = 15
	echo a + 1
	Int4 b = 7
	echo b + 1
	Int4 low = -8
	echo low - 1

	Int7 small = 2
	Int wide = Int(small)
	echo grow(Int(small)) + wide

	UInt8 byte = 200
	Int9 signed = Int9(byte)
	echo signed
	echo byte + 100
	echo UInt8(300)
	echo UInt4(20)
	echo UInt4(-1)
	echo Int4(9)
	echo UInt4.checked(9)
	echo UInt4.checked(20)
	echo clampTo(1000)
	echo paint(9)

	UInt8 x = 10
	UInt16 y = 1000
	echo UInt16(x) + y
	Int8 neg = -100
	echo Int9(byte) + Int9(neg)
	echo x < y
	echo x == 10

	mut UInt8 count = 250
	for i := 0; i < 10; i++ {
		count++
	}
	echo count

	echo UInt8(7) / UInt8(0)
	echo UInt8(7) % UInt8(0)
	echo UInt4(3) ** UInt4(3)
	echo Int4(-8) / Int4(-1)

	Float32 f = 0.1
	echo f
	echo f * 3.0
	Float d = Float(f)
	echo d
	Float mixed = Float(f + 1.0)
	echo mixed
	echo Float32(1.0 / 3.0)
	echo hive.conv.itf32(16777217)
	echo hive.math.sqrt(f)
	echo hive.math.sqrt(2.0)

	UInt8[dyn] bytes = [1, 2, 3, 250]
	echo bytes
	echo sort([UInt8(9), 3, 200])
	Str[16] names = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p"]
	UInt4 slot = 13
	echo names[slot]
	Str[dyn] more = ["x", "y"]
	UInt8 at = 1
	if at < len(more) {
		echo more[at]
	}

	p := Pixel(255, 128, 0, 7)
	echo p
	text := encode(p, hive.json.codec())
	echo text
	if Pixel.decode(`\{"r": 1, "g": 2, "b": 3}`, hive.json.codec()) is Result.Ok(q) {
		echo q
	}
	if Pixel.decode(`\{"r": 300, "g": 2, "b": 3}`, hive.json.codec()) is Result.Error(why) {
		echo "{why.path} {why.expected}"
	}
	echo encode(Reading(21.5, -2048), hive.json.codec())

	if hide(p) is Result.Ok(s) {
		echo reveal(s).g
	}
	echo bypass(Reading(1.5, 7)) == bypass(Reading(1.5, 7))

	mut hive.map.Map<UInt8, Str> m = hive.map.new()
	hive.map.set(m, 3, "three")
	echo hive.map.get(m, 3)

	UInt64 top = UInt64(-1)
	Int minus = -1
	echo top > minus
	echo minus < UInt8(0)
	echo UInt8(200) == 200
	echo Int16(-5) == minus
	echo top == minus
}
