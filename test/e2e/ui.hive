// Every widget, attribute and escape the renderer has a branch for, rendered
// once, against the exact bytes it came out as.
//
// The renderer has been rewritten for speed twice, and both times the only thing
// that could say it still drew the same page was the page itself. A needle would
// not have done: what breaks is a quote that stopped being escaped, a class that
// lost its order, an attribute that moved.
import hive.ui

type Msg {
	Hit {}
	Typed { text: Str }
	Picked { row: Int }
	Switched { on: Bool }
	Chose { what: Str }
}

func everything(): ui.View {
	return ui.column([ui.gap(8), ui.pad(12), ui.width(400), ui.height(300),
		ui.align(ui.Align.Center()), ui.justify(ui.Justify.Between()),
		ui.scroll(ui.Axis.Both()), ui.background(ui.Tone.Muted()),
		ui.hint("a column of everything")], [
		ui.text([ui.heading(2), ui.size(ui.TextSize.Title()), ui.tone(ui.Tone.Good())],
			"Ampersand & <angle> \"quote\" 'apostrophe'"),
		ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ui.Tone.HEX("#ff8800"))], "hex tone"),
		ui.text([ui.tone(ui.Tone.RGBA(10, 20, 30, 255))], "rgba tone"),
		ui.row([ui.gap(4), ui.grow(2)], [
			ui.spacer(),
			ui.spinner([ui.tone(ui.Tone.Warn())]),
			ui.none(),
			ui.icon([], ui.Icon.Search()),
			ui.image([ui.width(32)], "pic.png", "alt & <text>"),
			ui.link([], "https://example.com/a?b=1&c=2", "a link <here>")
		]),
		ui.button([ui.on(Msg.Hit()), ui.disabled(true)], "press & hold"),
		ui.input([ui.onInput(Msg.Typed(_)), ui.placeholder("type <here>"),
			ui.kind(ui.InputKind.Password()), ui.busy(true)], "value \"v\""),
		ui.textarea([ui.onInput(Msg.Typed(_)), ui.placeholder("notes & more")], "body & text"),
		ui.checkbox([ui.onToggle(Msg.Switched(_))], "tick & <box>", true),
		ui.select([ui.onChoose(Msg.Chose(_))], ["one & two", "three"], "three"),
		ui.overlay([ui.align(ui.Align.End()), ui.justify(ui.Justify.Start()),
			ui.onDismiss(Msg.Hit())], ui.text([], "pinned")),
		ui.overlay([ui.onDismiss(Msg.Hit())], ui.text([], "dialog")),
		ui.table([ui.onPick(Msg.Picked(_)), ui.onSort(Msg.Picked(_))],
			toTable(["head & one", "head two", "a < b", "c > d"], 2)),
		ui.canvas([ui.region(0.0, 0.0, 10.0, 10.0), ui.width(200), ui.height(100)], [
			ui.path([ui.thick(2.0), ui.paint(ui.Tone.Good())], [0.0, 0.0, 5.0, 9.0]),
			ui.dot([ui.paint(ui.Tone.Danger())], 5.0, 5.0, 1.0),
			ui.words([ui.paint(ui.Tone.HEX("#123456"))], 5.0, 8.0, 2.0, "on canvas & more")
		])
	])
}

proc main(): void {
	echo ui.page("Held still & <checked>", everything())
}
