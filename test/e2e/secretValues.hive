type Login {
    user: Str
    password: Secret<Str>
}

proc main(): void {
    hidden := hide("hunter2")
    if hidden is Result.Ok(s) {
        shown(s)
    } else if hidden is Result.Error(why) {
        echo why
    }
}

proc shown(s: Secret<Str>): void {
    echo reveal(s)
    echo "[" + reveal(bypass("")) + "]"
    echo reveal(bypass("café ☕"))
    if hide("") is Result.Ok(empty) {
        echo "[" + reveal(empty) + "]"
    }

    echo s == bypass("hunter2")
    echo s != bypass("hunter3")
    echo s == bypass("hunter")
    echo Login("ada", s) == Login("ada", bypass("hunter2"))
    echo Login("ada", s) == Login("ada", bypass("other"))
    echo indexOf([bypass("a"), bypass("b")], bypass("b"))

    sealed := hive.crypto.encrypt(bypass("attack at dawn"), s)
    if hive.crypto.decrypt(sealed, bypass("hunter2")) is Result.Ok(plain) {
        echo reveal(plain)
    }
    if hive.crypto.decrypt(sealed, bypass("wrong")) is Result.Error(crypto.CryptoError.BadSignature(_)) {
        echo "BadSignature"
    }
    if hive.crypto.decrypt(hive.crypto.encrypt(bypass(""), s), s) is Result.Ok(plain) {
        echo "[" + reveal(plain) + "]"
    }
    if hive.crypto.decrypt("bm90IGEgbWVzc2FnZQ==", s) is Result.Error(crypto.CryptoError.Malformed(_)) {
        echo "Malformed"
    }
    if hive.crypto.decryptBypass(sealed, bypass("hunter2")) is Result.Ok(plain) {
        echo reveal(plain)
    }
    if hive.crypto.decryptBypass(sealed, bypass("wrong")) is Result.Error(crypto.CryptoError.BadSignature(_)) {
        echo "BadSignature"
    }

    if hive.env.getSecret("PATH") is Result.Ok(path) && hive.env.get("PATH") is Result.Ok(plain) {
        echo reveal(path) == plain
    }
    if hive.env.getSecret("HIVE_NOT_SET_ANYWHERE") is Result.Error(why) {
        echo "{why.key} {why.message}"
    }

    if hive.crypto.randomSecret(16) is Result.Ok(key) && hive.crypto.randomSecret(16) is Result.Ok(other) {
        echo len(reveal(key))
        echo key == other
    }
    if hive.crypto.randomSecret(0) is Result.Ok(none) {
        echo len(reveal(none))
    }
    echo hive.crypto.hmacSha256("message", bypass("shared-key"))

    mut Secret<Str>[dyn] many = []
    for i := 0; i < 5000; i++ {
        if hide("secret {i}") is Result.Ok(one) {
            append(many, one)
        }
    }
    if many bounds 4999 {
        echo reveal(many[4999])
    }

    mut long := ""
    for i := 0; i < 5000; i++ {
        long = long + "0123456789"
    }
    if hide(long) is Result.Ok(kept) {
        echo reveal(kept) == long
    }

    if hive.file.read("/proc/self/status") is Result.Ok(status) {
        for each line in split(status, "\n") {
            if line is "VmLck:{rest}" && indexOf(rest, " 0 kB") is Result.Ok(_) {
                echo "a Secret is not locked in memory"
            }
        }
    }
}
