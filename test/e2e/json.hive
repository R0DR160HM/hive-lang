// The JSON codecs, and the field annotations that decide what they do.
//
// A type declaration *is* the schema, so a codec is derived from it rather than
// read off a value while the program runs. What the annotations add is the two
// things a declaration could not say on its own: what a field is called on the
// wire, and what to read where the wire has nothing.

type User {
	name: Str -- JSON as username;
	age:  Int
	firstName: Str -- Default as "";
}

// Both clauses on one field, in either order, and a default of every literal
// kind there is.
type Settings {
	theme: Str -- JSON as colour_scheme; Default as "light";
	fontSize: Int -- Default as 14; JSON as font_size;
	ratio: Float -- Default as 1.5;
	compact: Bool -- Default as false;
	state: Atom -- Default as #Nil;
}

// A union: the field outside every variant is annotated once and reaches all of
// them, and a variant's own fields may be annotated too.
type Event {
	at: Int -- JSON as timestamp; Default as 0;
	Opened { by: Str -- JSON as opened_by; }
	Closed
}

proc main(): void {
	// --- The name on the wire ------------------------------------------------
	echo encode(User("ada", 36, "Ada"), hive.json.codec())

	if User.decode("\{\"username\":\"grace\",\"age\":45,\"firstName\":\"Grace\"}", hive.json.codec()) is Result.Ok(u) {
		echo "{u.name} {u.age} {u.firstName}"
	}

	// A round trip: what the encoder writes is what the decoder reads.
	if User.decode(encode(User("ada", 36, "Ada"), hive.json.codec()), hive.json.codec()) is Result.Ok(u) {
		echo u.name
	}

	// --- What a default stands in for ----------------------------------------
	// A key that is not there, and a key that is there and null, are the same
	// nothing.
	if User.decode("\{\"username\":\"ada\",\"age\":36}", hive.json.codec()) is Result.Ok(u) {
		echo "absent: [{u.firstName}]"
	}
	if User.decode("\{\"username\":\"ada\",\"age\":36,\"firstName\":null}", hive.json.codec()) is Result.Ok(u) {
		echo "null: [{u.firstName}]"
	}

	// A field with nowhere to fall back to still insists on being there.
	if User.decode("\{\"username\":\"ada\"}", hive.json.codec()) is Result.Error(why) {
		echo "{why.path}: expected {why.expected}, found {why.found}"
	}

	// And a default excuses nothing that *was* said: it stands in for a value
	// that is missing, never for one of the wrong type.
	if User.decode("\{\"username\":\"ada\",\"age\":36,\"firstName\":7}", hive.json.codec()) is Result.Error(why) {
		echo "{why.path}: expected {why.expected}, found {why.found}"
	}

	// --- Every literal a default may be --------------------------------------
	if Settings.decode("\{}", hive.json.codec()) is Result.Ok(s) {
		echo "{s.theme} {s.fontSize} {s.ratio} {s.compact}"
		// On its own, because interpolating an atom renders its number and
		// `echo` renders its name — which the annotations do not change.
		echo s.state
	}
	echo encode(Settings("dark", 18, 2.0, true, #Ready), hive.json.codec())

	// One key given, the rest fallen back to.
	if Settings.decode("\{\"font_size\":20}", hive.json.codec()) is Result.Ok(s) {
		echo "{s.theme} {s.fontSize}"
	}

	// --- A union -------------------------------------------------------------
	echo encode(Event.Opened("ada", 1700000000), hive.json.codec())
	echo encode(Event.Closed(1700000001), hive.json.codec())

	if Event.decode("\{\"Opened\":\{\"opened_by\":\"grace\"}}", hive.json.codec()) is Result.Ok(e) {
		if e is Event.Opened(by, at) {
			echo "{by} at {at}"
		}
	}

	// --- One variant, named -------------------------------------------------
	// `T.Variant.decode` reads the payload without the key the union is
	// wrapped in — for a document whose variant the caller already knows.
	if Event.Opened.decode("\{\"opened_by\":\"ada\"}", hive.json.codec()) is Result.Ok(e) {
		if e is Event.Opened(by, at) {
			echo "untagged: {by} at {at}"
		}
	}

	// A variant with no fields of its own still takes the type's shared ones,
	// under the name the wire gives them.
	if Event.Closed.decode("\{\"timestamp\":7}", hive.json.codec()) is Result.Ok(e) {
		if e is Event.Closed(at) {
			echo "untagged closed at {at}"
		}
	}

	// The wrapper is not read here, so a tagged document leaves the payload's
	// required field missing — and a default is the only thing that excuses one.
	if Event.Opened.decode("\{\"Opened\":\{}}", hive.json.codec()) is Result.Error(why) {
		echo "untagged wants the payload: {why.path} expected {why.expected}"
	}

	// --- What the annotations do not touch -----------------------------------
	// A field JSON does not declare is still ignored, and the Hive field keeps
	// its own name however the wire spells it.
	if User.decode("\{\"username\":\"ada\",\"age\":36,\"firstName\":\"Ada\",\"extra\":true}", hive.json.codec()) is Result.Ok(u) {
		echo u.name + " " + u.firstName
	}
}
