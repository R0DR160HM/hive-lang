type Login {
    user: Str
    pin: Int
    codes: Str[dyn]
}

type Shape {
    Circle { r: Float }
    Square { side: Float }
    Empty
    label: Str
}

type Tree {
    Leaf { v: Int }
    Node { kids: Tree[dyn] }
}

func keep(x: T): Secret<T> {
    return bypass(x)
}

proc main(): void {
    login := Login("ana", 4321, ["a1", "b2"])
    if hide(login) is Result.Ok(s) {
        back := reveal(s)
        echo "{back.user} {back.pin} {join(back.codes, ",")}"
        echo s == bypass(login)
        echo s == bypass(Login("ana", 4322, ["a1", "b2"]))
    }

    echo reveal(bypass(1234)) + 1
    echo bypass(0.0) == bypass(-0.0)
    echo reveal(bypass(2.5)) * 2.0

    shapes := bypass([Shape.Circle(1.5, "c"), Shape.Empty("e"), Shape.Square(2.0, "s")])
    for each sh in reveal(shapes) {
        echo sh.label
    }

    if reveal(keep(Tree.Node([Tree.Leaf(1), Tree.Node([Tree.Leaf(2)])]))) is Tree.Node(kids) {
        echo len(kids)
    }

    mut hive.map.Map<Str, Int> a = hive.map.new()
    hive.map.set(a, "x", 1)
    hive.map.set(a, "y", 2)
    mut hive.map.Map<Str, Int> b = hive.map.new()
    hive.map.set(b, "y", 2)
    hive.map.set(b, "x", 1)
    echo bypass(a) == bypass(b)
    echo hive.map.keys(reveal(bypass(b)))

    Result<Int, Str> r = Result.Error("nope")
    if reveal(bypass(r)) is Result.Error(why) {
        echo why
    }

    Secret<Int[dyn]> v = bypass([1, 2, 3])
    echo reveal(v)
    echo reveal(bypass(#Blue))
    echo reveal(bypass(true))
    echo reveal(keep("plain"))
    if hide([Login("", 0, [])]) is Result.Ok(empty) {
        echo len(reveal(empty)[0].codes)
    }
}
