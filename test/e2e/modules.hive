// A program spanning several files. Names carry no baggage across a module
// boundary: this file's `Align` and lib/text's are two distinct types.
import ./lib/text
import ./lib/inventory as stock

type Align {
	Centre
}

proc main(): void {
	shelf := [
		stock.Item("Beeswax", 450),
		stock.Item("Smoker fuel", 1225),
		stock.Item("Frame rest", 899),
	]

	echo text.repeat("=", 28)
	for each item in shelf {
		echo stock.line(item)
	}
	echo text.repeat("-", 28)
	echo text.pad("total", 16, text.Align.Left()) + text.pad(stock.money(stock.total(shelf)), 12, text.Align.Right())

	// The local `Align` is this file's, not lib/text's.
	mine := Align.Centre()
	if mine is Align.Centre {
		echo "and this file has an Align of its own"
	}

	// A module's declarations are ordinary values, so one can be partially
	// applied like any other function.
	rule := text.repeat("~", _)
	echo rule(28)
}
