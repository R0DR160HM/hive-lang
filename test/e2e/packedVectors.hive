type Bag {
	name: Str
	small: UInt4[dyn]
}

type Reading {
	label: Str
	levels: UInt3[dyn]
	fixed: Int6[3]
}

type Levels {
	levels: UInt3[dyn]
}

proc bump(x: mut UInt4): UInt4 {
	x = x + 1
	return x
}

proc swap(a: mut Int5, b: mut Int5): void {
	t := a
	a = b
	b = t
}

proc grow(v: mut UInt4[dyn]): void {
	append(v, 7)
}

func double(x: UInt4): UInt4 {
	return x + x
}

func odd(x: UInt4): Bool {
	return x % 2 == 1
}

proc main(): void {
	mut UInt4[dyn] v = [1, 2, 3, 15]
	echo v
	echo len(v)
	echo bytes(v)
	append(v, 9)
	prepend(v, 7)
	echo v
	if v bounds 2 {
		v[2] = 14
		v[2] += 3
		echo v[2]
		bump(v[2])
	}
	if v bounds 0 && v bounds 3 {
		echo v[2]
		echo v[0:2]
		echo v[3:]
	}
	UInt4[dyn] more = [4, 5]
	echo v + more
	echo map(v, double)
	echo filter(v, odd)
	echo sort(v)
	echo indexOf(v, 9)
	if v bounds 1 && v bounds 2 {
		echo drop(v, 1, 2)
	}
	echo v

	// A signed element is read back with its sign, and a wide one straddles words.
	mut Int5[dyn] s = [-16, -1, 0, 15]
	if s bounds 0 && s bounds 3 {
		swap(s[0], s[3])
	}
	echo s
	for each x in s {
		echo x
	}
	if s is [first, ...rest] {
		echo "{first} {rest}"
	}
	mut UInt17[dyn] wide = []
	for mut i := 0; i < 10; i += 1 {
		append(wide, UInt17(i * 13000))
	}
	echo wide
	echo bytes(wide)

	// Lent elements are written back, and a thread of its own gets a copy.
	f := bump
	if v bounds 1 {
		echo f(v[1])
	}
	mut UInt4[3] w = [0, 1, 2]
	echo bump(w[0]) + bump(w[0])
	echo w
	grow(v)
	echo v
	if v bounds 2 {
		n := async bump(v[2])
		echo n
	}
	echo v
	sort(v)
	echo v

	// Equality, order and nesting.
	echo Bag("b", [1, 2, 3]) == Bag("b", [1, 2, 3])
	mut UInt4[dyn] e = [1]
	if e bounds 0 {
		drop(e, 0, 0)
	}
	UInt4[dyn] none = []
	echo e == none
	mut UInt4[dyn][dyn] grid = [[3], [1, 2]]
	if grid bounds 0 && grid bounds 1 {
		append(grid[0], 4)
		if grid[1] bounds 1 {
			grid[1][1] = 9
		}
	}
	echo grid
	echo sort(grid)
	echo sort([Reading("b", [3], [0, 0, 0]), Reading("b", [1, 7], [0, 0, 0])])

	// What carries a value out of the program reads the values, never the words.
	r := Reading("a", [1, 2, 7], [-32, 0, 31])
	text := encode(r, hive.json.codec())
	echo text
	if Reading.decode(text, hive.json.codec()) is Result.Ok(back) {
		echo back == r
	}
	echo Reading.decode("\{\"label\": \"x\", \"levels\": [8], \"fixed\": [0, 0, 0]}", hive.json.codec())
	if hide(r) is Result.Ok(kept) {
		echo reveal(kept) == r
	}
	if Levels.decode("--levels 3 --levels 6", hive.term.codec()) is Result.Ok(l) {
		echo encode(l, hive.term.codec())
	}
	m := hive.map.new()
	hive.map.set(m, "x", [UInt4(5)])
	echo hive.map.values(m)
}
