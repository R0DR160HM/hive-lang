// A query's columns fill its row type by name: wherever the SELECT puts them,
// in whatever case the database spells them, and only when every column fills
// a field and every field is filled.

type Entry {
    id:      Int
    account: Int
    memo:    Str
}

// Two columns of one type in the other order. Read by position, each would land
// in the other's field and nothing would say so.
query reordered(): Entry[dyn] {
    SELECT account, id, note AS memo FROM entries ORDER BY id
}

// SQL names are not case-sensitive, and PostgreSQL folds the ones nobody quoted
// to lower case, so a field is found in any case.
query shouted(): Entry[dyn] {
    SELECT ID, e.ACCOUNT, e.note AS Memo FROM entries e ORDER BY id
}

// A column with no field: one too many, and one spelt as no field is.
query extra(): Entry[dyn] {
    SELECT id, account, note AS memo, note FROM entries
}

query unaliased(): Entry[dyn] {
    SELECT id, account, note FROM entries
}

query missing(): Entry[dyn] {
    SELECT id, account FROM entries
}

query twice(): Entry[dyn] {
    SELECT id, account AS memo, note AS MEMO FROM entries
}

// The names are all it takes, so no rows is no reason to pass.
query emptyAndWrong(): Entry[dyn] {
    SELECT id, account FROM entries WHERE id < 0
}

// A single column has no field to be named after.
query notes(): Str[dyn] {
    SELECT note FROM entries ORDER BY id
}

query twoNotes(): Str[dyn] {
    SELECT note, id FROM entries
}

proc main(): void {
    opened := hive.sql.pool(hive.sql.DatabaseDriver.SQLite(), ":memory:", 1, 1)
    if opened is Result.Ok(db) {
        _ := hive.sql.raw(db, "CREATE TABLE entries (id INTEGER, account INTEGER, note TEXT)")
        _ := hive.sql.raw(db, "INSERT INTO entries VALUES (1, 10001, 'rent'), (2, 10002, 'food')")
        echo hive.sql.run(db, reordered())
        echo hive.sql.run(db, shouted())
        for each q in [extra(), unaliased(), missing(), twice(), emptyAndWrong()] {
            if hive.sql.run(db, q) is Result.Error(sql.SqlError.Shape(why)) {
                echo why
            }
        }
        echo hive.sql.run(db, notes())
        if hive.sql.run(db, twoNotes()) is Result.Error(sql.SqlError.Shape(why)) {
            echo why
        }
        hive.sql.close(db)
    }
}
