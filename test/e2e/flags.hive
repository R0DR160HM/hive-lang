// The command-line flags codec: `--name value` into a declared type, and back.

type Something {
	foo: Str
	bazzBazz: Bool
}

type Options {
	somethingElse: Str -- Flag as something-else;
	count: Int -- Default as 1;
	verbose: Bool -- Default as false;
	tags: Str[dyn] -- Flag as tag;
	ratio: Float -- Default as 1.5;
}

func asFlags(line: Str): Result<Options, hive.term.FlagError> {
	return Options.decode(line, hive.term.codec())
}

proc report(o: Options): void {
	echo "{o.somethingElse} | {o.count} | {o.verbose} | " + join(o.tags, ",") + " | {o.ratio}"
}

proc main(): void {
	if Something.decode("--foo ABC --bazzBazz true", hive.term.codec()) is Result.Ok(s) {
		echo "{s.foo} {s.bazzBazz}"
	}
	echo encode(Something("ABC", true), hive.term.codec())

	// A round trip, quoting whatever would split, vanish or read as a flag.
	written := encode(Options("Ada Lovelace", 3, true, ["a b", "--c", ""], 2.5), hive.term.codec())
	echo written
	if asFlags(written) is Result.Ok(o) {
		report(o)
	}

	// Arguments joined into one line, a quoted one kept together: a Bool standing
	// alone is true, `--name=value` is the same flag, and a stray word is ignored.
	joined := join(["--something-else", "\"Grace Hopper\"", "--verbose", "--tag", "x", "--count=7", "stray"], " ")
	if asFlags(joined) is Result.Ok(o) {
		report(o)
	}

	// Quotes and an escaped space keep a word together, and a lone `--` ends the flags.
	if asFlags("--something-else 'Ada \"L\"' --tag=a\\ b -- --count 9") is Result.Ok(o) {
		report(o)
	}

	for each bad in ["--count 2", "--something-else a --count many", "--something-else --count 2", "--something-else a --verbose maybe", "--something-else a --something-else b", "--something-else 'open"] {
		if asFlags(bad) is Result.Error(why) {
			echo "{why.path}: expected {why.expected}, found {why.found}"
		}
	}
}
