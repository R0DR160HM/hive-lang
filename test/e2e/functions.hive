// First-class functions, named arguments, and the func/proc split.
type Msg {
	Changed { text: Str }
	Cleared
}

func addN(n: Int, x: Int): Int { return n + x }
func apply(f: func(Int): Int, x: Int): Int { return f(x) }
func describe(a: Str, b: Int, c: Bool): Str { return "{a}/{b}/{c}" }

proc main(): void {
	// A bare reference.
	f := addN
	echo f(1, 2)
	// A partial application.
	addOne := addN(1, _)
	echo addOne(41)
	echo apply(addOne, 9)
	// A constructor may be partially applied too.
	make := Msg.Changed(_)
	built := make("hello")
	if built is Msg.Changed(t) {
		echo t
	}
	// Named arguments may appear anywhere.
	echo describe(b: 2, "a", c: true)
	echo describe("a", 2, true)
}
