// A codec is a value: held in a variable, passed, returned and stored. Its type
// says which format it is, so the encoder is still written from the declaration.

type Note {
	body: Str
	stars: Int -- Default as 0;
}

type Outbox {
	codec: hive.codec.Codec<hive.crypto.JwtError>
}

func pick(): hive.codec.Codec<hive.json.JsonError> {
	return hive.json.codec()
}

// Generic in the error type, so one function serves every format.
func writeNote(note: Note, codec: hive.codec.Codec<E>): Str {
	return encode(note, codec)
}

func readNote(text: Str, codec: hive.codec.Codec<E>): Result<Note, E> {
	return Note.decode(text, codec)
}

proc main(): void {
	asJson := pick()
	echo encode(Note("hi", 3), asJson)
	if Note.decode("\{\"body\":\"back\"}", asJson) is Result.Ok(n) {
		echo "{n.body} {n.stars}"
	}

	asQuery := hive.net.queryParamsCodec()
	asFlags := hive.term.codec()
	echo writeNote(Note("a b", 1), asQuery)
	echo writeNote(Note("a b", 1), asFlags)
	if readNote("--body there", asFlags) is Result.Ok(n) {
		echo "{n.body} {n.stars}"
	}
	if readNote("stars=2", asQuery) is Result.Error(why) {
		echo "{why.path}: expected {why.expected}, found {why.found}"
	}

	// A JWT codec carries its secret wherever it is kept.
	box := Outbox(hive.crypto.jwtCodec("s3cret"))
	token := encode(Note("sealed", 5), box.codec)
	if Note.decode(token, box.codec) is Result.Ok(n) {
		echo "{n.body} {n.stars}"
	}
	if Note.decode(token, hive.crypto.jwtCodec("wrong")) is Result.Error(why) {
		echo "{why.path}: expected {why.expected}"
	}
}
