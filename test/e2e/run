#!/usr/bin/env bash
# The end-to-end suite: every `.hive` here is compiled, run, and its output
# compared with the `.expected` beside it.
#
# This is the one suite that cannot be written in Hive. A Hive test can call
# every pass the compiler is made of — and `test/emit.test.hive` does — but it
# cannot run the Go toolchain over what came out, because Hive has no way to run
# another program. So this part is a shell script, and it is the only part that
# is.
#
# A `.test.hive` here is run by `hive test` instead, and passes when every test
# in it does. `hive test` emits a second file into the same package and walks
# the passes over a `test` body rather than a `proc` one, so it is a code path
# of its own — and one nothing else in this suite ever compiled.
set -uo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
hive="$here/../../hive"

passed=0
failed=0

for source in "$here"/*.hive; do
	name="$(basename "$source" .hive)"
	# A test program is not run: it has no `main` to run. The loop below it.
	case "$name" in *.test) continue ;; esac
	expected="$here/$name.expected"

	if [ ! -f "$expected" ]; then
		echo "  SKIP  $name (no .expected beside it)"
		continue
	fi

	actual="$("$hive" run "$source" 2>&1)"
	if [ "$actual" == "$(cat "$expected")" ]; then
		echo "  PASS  $name"
		passed=$((passed + 1))
	else
		echo "  FAIL  $name"
		diff <(echo "$actual") "$expected" | sed 's/^/        /'
		failed=$((failed + 1))
	fi
done

# The same programs through `hive test`. What is asserted is that every test
# passed rather than the exact report, which carries a coverage figure that
# moves whenever the program does.
for source in "$here"/*.test.hive; do
	[ -e "$source" ] || continue
	name="$(basename "$source" .hive)"

	out="$("$hive" test "$source" 2>&1)"
	if echo "$out" | grep -qE '^  [0-9]+ tests?: [0-9]+ passed$'; then
		echo "  PASS  $name"
		passed=$((passed + 1))
	else
		echo "  FAIL  $name"
		echo "$out" | sed 's/^/        /'
		failed=$((failed + 1))
	fi
done

echo
total=$((passed + failed))
if [ "$failed" -eq 0 ]; then
	echo "  $total programs: $passed passed"
else
	echo "  $total programs: $passed passed, $failed failed"
	exit 1
fi
