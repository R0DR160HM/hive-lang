// Building a stamp, and reading the fields of the current instant.
import hive.time

func within(value: Int, low: Int, high: Int): Bool {
	return value >= low && value <= high
}

proc main(): void {
	// A named date is the same kind of Int `now()` answers, and round-trips
	// through `format` because both work in local time. Mid-June, so no zone
	// shifts the clock underneath any of this.
	day := hive.time.dateFrom(2026, 6, 15)
	echo hive.time.format(day, "%Y-%m-%d %H:%M:%S %A")
	echo hive.time.format(hive.time.dateTimeFrom(2026, 6, 15, 13, 30, 45), "%Y-%m-%d %H:%M:%S")
	echo hive.time.dateTimeFrom(2026, 6, 15, 13, 30, 45) - day

	// A field out of range carries into the next one.
	echo hive.time.format(hive.time.dateFrom(2026, 13, 1), "%Y-%m-%d")
	echo hive.time.format(hive.time.dateFrom(2026, 3, 0), "%Y-%m-%d")
	echo hive.time.format(hive.time.dateFrom(2024, 3, 0), "%Y-%m-%d")
	echo hive.time.format(hive.time.dateTimeFrom(2026, 6, 15, 25, 0, 0), "%Y-%m-%d %H:%M")

	// The readings are of now, so only what holds whenever this runs is asserted.
	echo hive.time.year() > 2000
	echo within(hive.time.month(), 1, 12)
	echo within(hive.time.day(), 1, 31)
	echo within(hive.time.weekday(), 1, 7)
	echo within(hive.time.lastDayOfMonth(), 28, 31)
	echo within(hive.time.hour(), 0, 23)
	echo within(hive.time.minute(), 0, 59) && within(hive.time.second(), 0, 59)
	echo within(hive.time.millisecond(), 0, 999)

	// The day after this month's last is the first of the next, whichever month
	// it is — which is what `lastDayOfMonth` claims to know.
	year := hive.time.year()
	month := hive.time.month()
	rolled := hive.time.dateFrom(year, month, hive.time.lastDayOfMonth() + 1)
	echo hive.time.format(rolled, "%d")

	// The ends of the current month, which is what these are for: both land in
	// the one month, and the first comes before the last.
	first := hive.time.dateFrom(year, month, 1)
	last := hive.time.dateFrom(year, month, hive.time.lastDayOfMonth())
	echo hive.time.format(first, "%d")
	echo hive.time.format(first, "%m") == hive.time.format(last, "%m") && first < last
}
