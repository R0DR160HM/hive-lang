// Every mark a canvas draws and every attribute a mark takes, rendered once,
// against the exact bytes they came out as.
import hive.ui

func marks(): ui.Mark[dyn] {
    return [
        ui.oval([ui.paint(ui.Tone.Good())], 10.0, 10.0, 8.0, 4.0),
        ui.arc([ui.paint(ui.Tone.Danger()), ui.thick(0.5)], 20.0, 10.0, 3.0, 0.0, 4.0),
        ui.arc([], 20.0, 10.0, 2.0, 0.0, 7.0),
        ui.wedge([ui.paint(ui.Tone.Warn())], 30.0, 10.0, 3.0, -1.0, 1.0),
        ui.curve([ui.paint(ui.Tone.Muted()), ui.dash(1.0, 0.5)], [0.0, 0.0, 1.0, 2.0, 3.0, 2.0, 4.0, 0.0]),
        ui.dot([ui.edge(ui.Tone.Danger()), ui.thick(0.2)], 40.0, 10.0, 2.0),
        ui.bar([ui.paint(ui.Tone.HEX("#123456")), ui.edge(ui.Tone.Good()), ui.opacity(0.5)], 50.0, 10.0, 4.0, 2.0),
        ui.cutout([ui.paint(ui.Tone.Good())], ui.dot([], 60.0, 10.0, 3.0), [ui.bar([], 60.0, 10.0, 2.0, 2.0)]),
        ui.patch([ui.gradient(ui.Tone.Good(), ui.Tone.HEX("#ffffff"), 1.5)], [0.0, 20.0, 4.0, 20.0, 2.0, 24.0]),
        ui.symbol([ui.crop(-1.0, -1.0, 2.0, 1.0), ui.opacity(0.75)], 70.0, 10.0, 0.5, 2.0, [
            ui.dot([ui.paint(ui.Tone.Warn())], 0.0, 0.0, 1.0)
        ]),
        ui.picture([ui.fit(ui.Fit.Cover())], "/_hive/asset/a & b.png", 80.0, 10.0, 6.0, 4.0),
        ui.words([ui.justify(ui.Justify.Start()), ui.align(ui.Align.End()), ui.weight(700), ui.italic(true)],
            10.0, 30.0, 2.0, "set <here> & measured")
    ]
}

proc main(): void {
    echo ui.html(ui.canvas([ui.region(0.0, 0.0, 100.0, 40.0)], marks()))
    echo ui.measure("Mi", 10.0)
    echo ui.measure("", 3.0)
}
