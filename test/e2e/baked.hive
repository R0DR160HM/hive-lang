// Calls run while the program builds, and every kind of value built in from them.
type Conversion {
    Scaled { factor: Float }
    Same
}

type Unit {
    name: Str
    symbol: Atom
    conversion: Conversion
    digits: UInt4[dyn]
}

func units(): Unit[dyn] {
    return [
        Unit("metre", #Metre, Conversion.Same(), [UInt4(1), UInt4(15)]),
        Unit("foot", #Foot, Conversion.Scaled(0.3048), [UInt4(3)]),
    ]
}

func squares(upTo: Int): hive.map.Map<Int, Int> {
    mut hive.map.Map<Int, Int> out = hive.map.new()
    for i := 1; i < upTo + 1; i++ {
        hive.map.set(out, i, i * i)
    }
    return out
}

func edges(): Float[dyn] {
    return [10.0 ** 400.0, -(10.0 ** 400.0), 0.1 + 0.2]
}

func smallest(): Int {
    return -9223372036854775807 - 1
}

func lines(path: Str): Str[dyn] {
    Result.Ok(found) := hive.file.lines(path) else {
        Result.Error(why) { panic why.message }
    }
    return found
}

func total(values: Int[], scale: Int): Int {
    mut sum := 0
    for each v in values {
        sum = sum + v * scale
    }
    return sum
}

proc main(): void {
    for each u in units() with compiler {
        echo u
    }
    table := squares(4) with compiler
    echo table
    echo hive.map.get(table, 3)
    echo edges() with compiler
    echo smallest() with compiler
    // Read from the entrypoint's folder, as the program would be.
    own := lines("baked.hive") with compiler
    if own bounds 0 {
        echo own[0]
    }
    // One call handed what another answered, by name and written in place.
    n := total([1, 2, 3], 10) with compiler
    echo total([n, total([1], 1) with compiler], -1) with compiler
    // A `mut` copy of a built-in value is the program's own to change.
    for i := 0; i < 2; i++ {
        mut grown := squares(1) with compiler
        hive.map.set(grown, 2 + i, 0)
        echo grown
    }
}
