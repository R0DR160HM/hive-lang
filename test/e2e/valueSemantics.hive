// Vectors, maps and the types that hold them are values. Two names for one value
// never observe each other's writes — unless both of them are `mut`, which is
// how shared mutable state is opted into.
import hive.map

type Box {
	items: Str[dyn]
	label: Str
}

type Shelf {
	counts: hive.map.Map<Str, Int>
}

proc grow(vec: mut Str[dyn], tag: Str): void {
	append(vec, tag)
}

func lengthOf(vec: Str[]): Int {
	return len(vec)
}

// A `func` may not write the map it was handed, but it may take a `mut` copy of
// it and write that: the caller's map is left as it was.
func withOneMore(shelf: Shelf): Int {
	mut counts := shelf.counts
	hive.map.set(counts, "more", 1)
	return len(counts)
}

proc stock(shelf: mut Shelf, key: Str): void {
	hive.map.set(shelf.counts, key, 1)
}

proc main(): void {
	echo "-- a copy, because one end can write --"
	mut Str[dyn] source = ["a", "b"]
	Str[dyn] watcher = source
	append(source, "c")
	echo source
	echo watcher

	echo "-- shared, because both ends are mut --"
	mut Str[dyn] a = ["x", "y", "z"]
	mut Str[dyn] b = a
	append(b, "w")
	echo len(a)
	// A `[dyn]` vector promises nothing about its length, so every index into one
	// is guarded — which is the price of being able to grow it.
	if a bounds 0 {
		a[0] = "changed"
	}
	// A proof is tied to the vector it was made about, so `b` needs its own —
	// even though the two are the same storage.
	if b bounds 0 {
		echo b[0]
	}
	// Rebinding a name is not a write through it: `b` is handed storage of its
	// own and `a` keeps what the two were sharing.
	b = ["replaced"]
	echo len(a)
	echo len(b)

	echo "-- a mut parameter takes the caller's own storage --"
	mut Str[dyn] v = ["one"]
	grow(v, "two")
	echo v

	echo "-- an ordinary parameter takes a copy --"
	echo lengthOf(v)
	echo v

	echo "-- a nested vector copies every level --"
	mut Table grid = [["1", "2"], ["3", "4"]]
	Table snapshot = grid
	if grid bounds 0 {
		if grid[0] bounds 0 {
			grid[0][0] = "changed"
		}
	}
	echo grid
	echo snapshot

	echo "-- a struct copies its storage-owning fields --"
	mut Box box = Box(["p", "q"], "first")
	Box kept = box
	append(box.items, "r")
	echo box.items
	echo kept.items

	echo "-- a map is a value: only a `mut` one is written, and a copy is its own --"
	mut hive.map.Map<Str, Int> counts = hive.map.new()
	hive.map.set(counts, "bees", 3)
	shelf := Shelf(counts)
	echo withOneMore(shelf)
	echo shelf.counts
	mut copied := shelf.counts
	hive.map.delete(copied, "bees")
	echo copied
	echo shelf.counts
	mut Shelf own = shelf
	stock(own, "wasps")
	echo own.counts
	echo shelf.counts
	echo counts

	echo "-- a fresh right-hand side is already independent --"
	Str[dyn] fresh = ["a"] + ["b"]
	echo fresh
}
