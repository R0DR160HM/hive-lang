<div class="h-column" style="display:flex;flex-direction:column;gap:8px;"><div class="h-row" style="display:flex;flex-direction:row;flex-wrap:wrap;align-content:flex-start;gap:6px;"><span class="h-text">one</span><span class="h-text">two</span></div><div class="h-grid" style="display:grid;grid-template-columns:auto minmax(0,1fr) minmax(0,2fr);gap:4px;align-items:center;justify-items:end;"><span class="h-text">label</span><input type="text" class="h-input" style="grid-column:span 2;" value="wide &amp; &lt;field&gt;"></div><div class="h-grid" style="display:grid;grid-template-columns:minmax(0,1fr);"><span class="h-text">one column</span></div><div class="h-stack" style="aspect-ratio:16/9;min-width:100px;max-width:400px;min-height:20px;max-height:300px;"><img class="h-image" style="object-fit:cover;" src="pic.png" alt="a picture"><span class="h-text" style="justify-self:end;align-self:start;">badge</span></div></div>
