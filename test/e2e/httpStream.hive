// A streamed response with nothing behind it, as a test builds one: its fields
// are what it was given, and reading it says it is closed. A stream read from a
// server is `examples/24-streaming-answer`.
import hive.net

proc main(): void {
    stream := hive.net.HttpStream(200, [["Content-Type", "application/x-ndjson"]])
    echo stream.status
    echo row(stream.headers, "Content-Type")
    if hive.net.httpReceiveLine(stream) is Result.Error(hive.net.HttpStreamError.Closed(message)) {
        echo "closed: {message}"
    }
    echo hive.net.httpReceive(stream, 10)
    hive.net.httpClose(stream)
}
