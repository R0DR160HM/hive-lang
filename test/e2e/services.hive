// `spawn`, with and without a name, `at` and `kill`.
type Op {
    Add { n: Int }
    Total { n: Int }
    Who
    Named { me: Str }
}

proc counter(total: mut Int, op: Op): Op {
    if op is Op.Add(n) {
        total += n
    }
    return Op.Total(total)
}

proc self(seen: mut Int, op: Op, me: Address<Op>): Op {
    seen += 1
    return Op.Named("{me}")
}

proc totalOf(box: Address<Op>, op: Op): Str {
    answer := box(op)
    if answer is Result.Ok(reply) && reply is Op.Total(n) {
        return "{n}"
    }
    if answer is Result.Error(problem) {
        return "no answer: " + reasonOf(problem)
    }
    return "?"
}

// Every way a request can fail, each its own variant.
func reasonOf(problem: hive.syslink.SyslinkError): Str {
    switch problem {
        syslink.SyslinkError.Taken(_) { return "Taken" }
        syslink.SyslinkError.Down(_) { return "Down" }
        syslink.SyslinkError.NoProc(_) { return "NoProc" }
        syslink.SyslinkError.Timeout(_) { return "Timeout" }
        syslink.SyslinkError.Unreachable(_) { return "Unreachable" }
        syslink.SyslinkError.Decode(_) { return "Decode" }
        syslink.SyslinkError.NoPeer(_) { return "NoPeer" }
        syslink.SyslinkError.NoListener(_) { return "NoListener" }
        syslink.SyslinkError.NoKey(_) { return "NoKey" }
    }
}

proc main(): void {
    if spawn(counter, 10) is Result.Ok(box) {
        echo totalOf(box, Op.Add(5))
        kill(box)
    }

    started := spawn(counter, 0, #Counter)
    if started is Result.Error(problem) {
        echo "could not start: " + reasonOf(problem)
    }
    Address<Op> named = at(#Counter)
    echo totalOf(named, Op.Add(2))
    echo totalOf(at(#Counter), Op.Add(3))

    if spawn(counter, 100, #Counter) is Result.Error(problem) {
        echo "second #Counter: " + reasonOf(problem)
        echo problem
    }

    kill(at(#Counter))
    if named(Op.Add(1)) is Result.Error(_) {
        echo "killed, and nothing answers"
    }
    if spawn(counter, 100, #Counter) is Result.Ok(_) {
        echo totalOf(at(#Counter), Op.Add(1))
    }

    if spawn(self, 0, #Self) is Result.Ok(box) {
        if box(Op.Who()) is Result.Ok(reply) && reply is Op.Named(me) {
            echo me
        }
    }
}
