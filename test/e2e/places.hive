// Where a program is, a process with nothing behind it, and what is not a
// picture. `hive run` runs a program in its entrypoint's folder, which is this
// one. A program started and stopped is examples/19-programs-alongside; a
// picture decoded from an asset is examples/18-pictures.
import hive.file
import hive.image
import hive.term

proc main(): void {
    echo hive.file.isDir(".")
    echo hive.file.isDir("lib")
    echo hive.file.isDir("places.hive")
    echo hive.file.isDir("nothing here")

    if hive.file.workingDirectory() is Result.Ok(here) {
        echo here is "{_above}/test/e2e"
    }
    if hive.file.executable() is Result.Ok(me) {
        // Under `hive run`, the copy the compiler built and ran.
        echo hive.file.exists(me) && hive.file.isDir(me) == false
    }
    if hive.file.home() is Result.Ok(home) {
        echo home != ""
    }
    if hive.file.asset("anything.png") is Result.Error(hive.file.FileError.NotFound(path, message)) {
        echo "{path}: {message}"
    }

    nobody := hive.term.Process(0)
    echo hive.term.processWait(nobody)
    if hive.term.processReceiveLine(nobody) is Result.Error(hive.term.ProcessError.Closed(message)) {
        echo "closed: {message}"
    }
    hive.term.processKill(nobody)

    echo hive.image.decode("not a picture")
    echo hive.image.scale(hive.image.Picture(0, 0, []), 2, 2).width
}
