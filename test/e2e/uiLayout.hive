// The layout, text, look, input and event additions to hive.ui, rendered once,
// against the exact bytes they came out as.
import hive.ui

type Msg {
    Hit {}
    Chose { what: Str }
    Opened { open: Bool }
    Pointed { x: Float, y: Float }
    Scrolled { x: Int, y: Int }
    Dropped { what: Str }
    Filed { name: Str, contents: Str }
    Sized { wide: Int, tall: Int }
}

func layout(): ui.View {
    return ui.column([ui.gap(8)], [
        ui.row([ui.wrap(true), ui.gap(6)], [ui.text([], "one"), ui.text([], "two")]),
        ui.grid([ui.columns([0, 1, 2]), ui.gap(4), ui.align(ui.Align.Center()), ui.justify(ui.Justify.End())], [
            ui.text([], "label"),
            ui.input([ui.span(2)], "wide & <field>")
        ]),
        ui.grid([], [ui.text([], "one column")]),
        ui.stack([ui.aspect(16, 9), ui.minWidth(100), ui.maxWidth(400), ui.minHeight(20), ui.maxHeight(300)], [
            ui.image([ui.fit(ui.Fit.Cover())], "pic.png", "a picture"),
            ui.text([ui.place(ui.Align.End(), ui.Align.Start())], "badge")
        ])
    ])
}

func words(): ui.View {
    return ui.column([], [
        ui.text([ui.justify(ui.Justify.Between()), ui.weight(650), ui.italic(true), ui.mono(true), ui.lines(2)], "set & <styled>"),
        ui.text([ui.wrap(false)], "kept on one line"),
        ui.paragraph([ui.justify(ui.Justify.Center())], [
            ui.text([], "plain "),
            ui.text([ui.weight(700)], "bold "),
            ui.link([], "/there", "a link"),
            ui.icon([], ui.Icon.Heart()),
            ui.text([ui.heading(2)], " no heading here")
        ])
    ])
}

func look(): ui.View {
    return ui.row([ui.opacity(0.5), ui.shadow(8), ui.ease(200), ui.radius(6), ui.border(2), ui.borderTone(ui.Tone.Muted()),
        ui.gradient(ui.Tone.Good(), ui.Tone.HEX("#123456"), 1.5707963267948966)], [ui.text([], "dressed")])
}

func asking(): ui.View {
    return ui.column([], [
        ui.radio([ui.onChoose(Msg.Chose(_)), ui.wrap(true)], ["one & two", "three"], "three"),
        ui.progress([], 0.25),
        ui.progress([], 7.0),
        ui.input([ui.kind(ui.InputKind.Range()), ui.limits(0.0, 1.0, 0.05)], "0.5"),
        ui.input([ui.kind(ui.InputKind.Time())], "09:30"),
        ui.input([ui.kind(ui.InputKind.DateTime())], "2026-11-16T09:30"),
        ui.input([ui.kind(ui.InputKind.Email())], ""),
        ui.input([ui.kind(ui.InputKind.Tel())], ""),
        ui.input([ui.kind(ui.InputKind.Url())], ""),
        ui.input([ui.kind(ui.InputKind.Color())], "#ff8800"),
        ui.input([ui.kind(ui.InputKind.File()), ui.onFile(Msg.Filed(_, _))], ""),
        ui.choices([ui.onChoose(Msg.Chose(_))], ["red", "green & blue"], ["green & blue"]),
        ui.tabs([ui.onChoose(Msg.Chose(_))], ["First", "Second"], "Second"),
        ui.tree([], [
            ui.branch([ui.on(Msg.Hit()), ui.onToggle(Msg.Opened(_)), ui.selected(true)], "src", true, [
                ui.branch([ui.on(Msg.Hit())], "main.hive", false, [])
            ]),
            ui.branch([ui.onToggle(Msg.Opened(_))], "closed", false, [ui.text([], "hidden")])
        ])
    ])
}

func heard(): ui.View {
    return ui.column([ui.onEnter(Msg.Hit()), ui.onLeave(Msg.Hit()), ui.onFocus(Msg.Hit()), ui.onBlur(Msg.Hit()),
        ui.onWheel(Msg.Pointed(_, _)), ui.onPress(Msg.Pointed(_, _)), ui.onPoint(Msg.Pointed(_, _)),
        ui.onRelease(Msg.Pointed(_, _)), ui.onScroll(Msg.Scrolled(_, _)), ui.scrollTo(0, 120, 1),
        ui.onDrop(Msg.Dropped(_)), ui.onFile(Msg.Filed(_, _)), ui.onSize(Msg.Sized(_, _))], [
        ui.text([ui.carry("card & 1")], "drag me")
    ])
}

proc main(): void {
    echo ui.html(layout())
    echo ui.html(words())
    echo ui.html(look())
    echo ui.html(asking())
    echo ui.html(heard())
    echo ui.html(ui.row([], [ui.icon([], ui.Icon.Search()), ui.icon([], ui.Icon.Bird())]))
}
