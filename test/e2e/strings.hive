// A Str, read by character: indexing, slicing, searching and rewriting, with
// every bound proved at compile time.

// Reversing is the plainest use of an index: walk backwards, and the guard the
// loop's own condition gives is the one the bounds pass reads.
func reversed(s: Str): Str {
	mut Str[dyn] out = []
	for i := len(s) - 1; i >= 0; i-- {
		if s bounds i {
			append(out, s[i])
		}
	}
	return join(out, "")
}

// A slice takes both bounds inclusive, exactly as a vector's does.
func initials(name: Str): Str {
	mut Str[dyn] out = []
	for each word in split(name, " ") {
		if word bounds 0 {
			append(out, upperFirst(word[0]))
		}
	}
	return join(out, ".")
}

func upperFirst(c: Str): Str {
	mut i := 0
	lower := "abcdefghijklmnopqrstuvwxyz"
	upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
	for each l in split(lower, "") {
		if l == c {
			if upper bounds i {
				return upper[i]
			}
		}
		i = i + 1
	}
	return c
}

// An `indexOf` on a Str hands back a position the string really has, so the
// slice either side of it needs no guard of its own.
func splitOnce(s: Str, sep: Str): Str {
	if indexOf(s, sep) is Result.Ok(at) {
		// `at` is proved, but `at - 1` is a computed expression and nothing is
		// proved about it — so it is bound and guarded, which is what the bounds
		// pass asks for and the whole of what it asks.
		last := at - 1
		if s bounds last {
			return "before='{s[:last]}' after='{s[at:]}'"
		}
		return "before='' after='{s[at:]}'"
	}
	return "no {sep} in {s}"
}

// Both hole kinds, in one template each and then mixed.
func route(path: Str): Str {
	if path is "/users/{id is (\d+)}/posts/{postId is (\d+)}" {
		return "user {id}, post {postId}"
	}
	if path is "/users/{id is (\d+)}" {
		return "user {id}"
	}
	if path is "/files/{rest}" {
		return "file {rest}"
	}
	if path is "/health" {
		return "health"
	}
	return "no route"
}

func mail(line: Str): Str {
	if line is "{user is ([\w.]+)}@{host is ([\w.]+)}" {
		return "{user} at {host}"
	}
	return "not an address"
}

proc main(): void {
	// --- Counted by character, not by byte ---
	s := "café au lait"
	echo len(s)
	echo bytes(s)
	if s bounds 3 {
		echo s[3]
	}
	if s bounds 5 {
		echo s[0:3]
		echo s[:3]
		echo s[5:]
	}

	echo reversed("café")
	echo initials("ada lovelace king")
	echo splitOnce("key=value", "=")
	echo splitOnce("novalue", "=")

	// --- Rewriting ---
	echo replaceFirst("a-b-c", "-", "+")
	echo replaceAll("a-b-c", "-", "+")
	echo replaceAll("café", "é", "e")
	// Nothing to find leaves the string alone.
	echo replaceAll("abc", "z", "!")

	// --- Patterns ---
	echo route("/users/42/posts/7")
	echo route("/users/42")
	echo route("/users/nan")
	echo route("/files/a/b/c.txt")
	echo route("/health")
	echo mail("ada.lovelace@example.co.uk")
	echo mail("not-an-address")

	// A hole that says what it takes gives the text back when it does not fit,
	// so the next branch of the chain still gets its turn.
	if "2026-08-29" is "{year is (\d{4})}-{month is (\d{2})}-{day is (\d{2})}" {
		echo "{day}/{month}/{year}"
	}
	if "26-8-9" is "{year is (\d{4})}-{month is (\d{2})}-{day is (\d{2})}" {
		echo "matched, and should not have"
	} else {
		echo "26-8-9 is not a date"
	}
}
