// Values, operators and the edges of arithmetic.
proc main(): void {
	echo 2 + 3
	echo 2.5 + 0.5
	echo "a" + "b"
	echo [1, 2] + [3]
	echo 7 / 2
	echo 7 / 0
	echo 7 % 3
	echo -7 % 3
	echo 2 ** 10
	echo 2 ** -1
	echo 2.0 ** 0.5
	echo -2 ** 2
	echo 1 == 1
	echo [1, 2] == [1, 2]
	echo [1, 2] == [1, 3]
	echo "café"
	echo len("café")
	echo bytes("café")
	echo #Nil
	echo "0" + #Nil
	echo true && false
	echo true || false
	// The other prefix operator. Tighter than `&&` and every comparison, so
	// the first of these is `(!found) && ready` and the second needs its
	// parentheses.
	found := false
	ready := true
	echo !found
	echo !!found
	echo !found && ready
	echo !(1 == 2)
	echo !(2 > 3)
}
