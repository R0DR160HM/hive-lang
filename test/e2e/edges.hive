// Behaviour a program can see and the compiler once got wrong, one section each.
type Level {
	Low
	Mid {
		note: Str
	}
	High {
		score: Int
	}
}

type Event {
	at: Int
	Opened {
		by: Str
	}
	Closed
}

type Person {
	name: Str
	age: Int
}

type Ping {
	Hello
}

query everything(): Table {
	SELECT * FROM people ORDER BY name
}

func add(a: Int, b: Int): Int {
	return a + b
}

func side(label: Str): Str {
	echo label
	return label
}

func pair(a: Str, b: Str): Str {
	return a + b
}

proc answer(seen: mut Int, ping: Ping): Ping {
	return ping
}

proc main(): void {
	// A union sorts by the order its variants were declared in.
	echo sort([Level.High(2), Level.Low(), Level.Mid("m"), Level.High(1)])

	// A field declared outside the variants is read straight off the value.
	for each e in [Event.Opened("ada", 3), Event.Closed(7)] {
		echo e.at
	}

	// A partial application keeps what it was given, not the variable.
	mut n := 1
	addN := add(n, _)
	n = 100
	echo addN(1)

	// An Int stops at the edge it would pass, rather than wrapping round.
	MAX := 9223372036854775807
	MIN := -9223372036854775807 - 1
	mut counter := MAX
	counter += 10
	counter++
	echo "{counter} {MIN - 1} {MAX * 2} {MIN * 2} {-MIN} {MIN / -1} {2 ** 100} {(-2) ** 63}"
	echo 9223372036854775807 + 1

	// Named arguments run in the order they were written — to a builtin and to
	// the library as well.
	echo pair(b: side("b"), a: side("a"))
	echo join(sep: side("-"), vector: [side("x"), "y"])
	echo hive.math.clamp(high: 1.0, value: 3.0, low: 0.0)
	mut Str[dyn] grown = []
	append(value: side("appended"), vector: grown)
	echo grown

	// JSON: a key written twice keeps its last value, and text after the
	// document is refused.
	echo Person.decode(`\{"name": "ada", "age": 1, "age": 2}`, hive.json.codec())
	if Person.decode(`\{"name": "ada", "age": 1} trailing`, hive.json.codec()) is Result.Error(why) {
		echo "{why.expected}: {why.found}"
	}

	// A CSV saved with a byte-order mark reads its first cell clean.
	if hive.file.csv("lib/excel.csv", ",") is Result.Ok(rows) {
		for each row in rows {
			if row bounds 0 {
				echo "{len(row[0])} {row[0]}"
			}
		}
	}
	if hive.file.csv("lib/excel.csv", ";|") is Result.Error(why) {
		echo why.message
	}

	// A query declared as a Table answers with a header row, then every row.
	opened := hive.sql.pool(hive.sql.DatabaseDriver.SQLite(), ":memory:", 1, 1)
	if opened is Result.Ok(db) {
		_ := hive.sql.raw(db, "CREATE TABLE people (name TEXT, age INTEGER)")
		_ := hive.sql.raw(db, "INSERT INTO people VALUES ('grace', 45), ('ada', 36)")
		echo hive.sql.run(db, everything())
		hive.sql.close(db)
	}

	// A database that cannot be reached is a connection failure.
	refused := hive.sql.connect(hive.sql.DatabaseDriver.PostgreSQL(), "host=127.0.0.1 port=1 sslmode=disable connect_timeout=2")
	if refused is Result.Error(sql.SqlError.Connection(_)) {
		echo "Connection"
	}

	// A name nobody registered, and a service that is gone, answer at once.
	Address<Ping> nobody = at(#Nobody)
	if nobody(Ping.Hello()) is Result.Error(syslink.SyslinkError.NoProc(_)) {
		echo "NoProc"
	}
	if spawn(answer, 0) is Result.Ok(box) {
		kill(box)
		if box(Ping.Hello()) is Result.Error(syslink.SyslinkError.Down(_)) {
			echo "Down"
		}
	}
}
