// Library modules by their own names, which yield to the program's own as builtins do.
import ./lib/text as conv

func time(): Str {
    return "ours"
}

type Clock {
    hour: Int
}

func hourOf(math: Clock): Int {
    return math.hour
}

func isInt(v: json.JsonValue): Bool {
    return v is json.JsonValue.Int(_)
}

proc main(): void {
    task.sleep(1)
    echo math.max(1.0, 2.0) == 2.0

    mut map.Map<Str, Int> counts = map.new()
    map.set(counts, "bees", 3)
    if map.get(counts, "bees") is Result.Ok(n) {
        echo n
    }
    echo len(map(["a", "b"], isEmpty))

    echo isInt(json.JsonValue.Int(1))
    echo encode(json.JsonValue.Int(7), json.codec())

    echo time()
    echo hive.time.year() > 2000

    echo conv.repeat("=", 3)
    echo hive.conv.its(42)

    echo hourOf(Clock(9))

    term := "a local"
    echo term
    hive.term.print("the library")
}

func isEmpty(s: Str): Bool {
    return s == ""
}
