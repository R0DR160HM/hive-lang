// Vectors, the builtins that walk them, and maps.
import hive.map

func double(n: Int): Int { return n * 2 }
func isEven(n: Int): Bool { return n % 2 == 0 }
func asPort(s: Str): Result<Int, Bool> {
	if hive.conv.sti(s) is Result.Ok(n) && n > 0 && n < 65536 {
		return Result.Ok(n)
	}
	return Result.Error(false)
}
func longerFirst(a: Str, b: Str): Bool { return len(a) > len(b) }

proc main(): void {
	Int[dyn] nums = [1, 2, 3, 4]
	echo len(map(nums, double))
	echo map(nums, double)
	echo filter(nums, isEven)
	Str[dyn] raw = ["8080", "nope", "443"]
	echo filterMap(raw, asPort)

	Str[3] words = ["pear", "apple", "fig"]
	echo join(sort(words), "|")
	echo join(sort(words, longerFirst), "|")
	echo join(words, "|")

	mut Str[dyn] queue = ["b", "c"]
	append(queue, "d")
	prepend(queue, "a")
	echo queue
	if 1 < len(queue) {
		taken := drop(queue, 0, 1)
		echo taken
	}
	echo queue

	mut Str[dyn] names = ["pear", "apple"]
	sort(names)
	echo names

	echo split("a,b,c", ",")
	echo indexOf(["a", "b"], "b")
	echo indexOf("hello", "ll")
	echo indexOf("hello", "z")

	Table settings = [["host", "localhost"], ["port", "8080"]]
	echo row(settings, "port")
	echo column([["a", "b"], ["1", "2"]], "b")

	mut hive.map.Map<Str, Int> counts = hive.map.new()
	for each word in ["bee", "comb", "bee"] {
		if hive.map.get(counts, word) is Result.Ok(seen) {
			hive.map.set(counts, word, seen + 1)
		} else {
			hive.map.set(counts, word, 1)
		}
	}
	echo counts
	echo len(counts)
	echo hive.map.keys(counts)
	echo hive.map.has(counts, "bee")
	hive.map.delete(counts, "bee")
	echo hive.map.keys(counts)
}
