// Every call blocks its caller. What a call means is decided where it is
// written, and this shows all four spellings.
import hive.task

func slowShout(text: Str): Str {
	hive.task.sleep(60)
	return text + "!!!"
}

func slowCount(text: Str): Int {
	hive.task.sleep(60)
	return len(text)
}

proc noise(label: Str): void {
	hive.task.sleep(10)
}

// A `mut` parameter takes the caller's own storage when the call is waited for
// there, and a copy of it when the call runs on a thread of its own.
proc grow(vec: mut Str[dyn], tag: Str): Int {
	hive.task.sleep(10)
	append(vec, tag)
	return len(vec)
}

func countOf(vec: Str[]): Int {
	hive.task.sleep(30)
	return len(vec)
}

proc main(): void {
	// Waited for: an ordinary call.
	echo slowShout("here")

	// Named: two threads at once, each waited for where its own name is read.
	shout := async slowShout("there")
	count := async slowCount("bb")
	echo "{shout} / {count}"
	// Reading again is free and answers the same value.
	echo shout

	// The await-all: one barrier, resolving in order to a statically-sized
	// vector.
	Str[3] all = await [slowShout("a"), slowShout("b"), slowShout("c")]
	echo all
	echo len(all)

	// Over void calls the barrier has no value either.
	await [noise("x"), noise("y")]
	echo "both done"

	// A bounded wait answers with a Result rather than crashing.
	if slowShout("worth waiting for") with timeout 5 is Result.Error(err) {
		echo "gave up after {err.waited}ms"
	}
	if slowShout("quick enough") with timeout 5000 is Result.Ok(said) {
		echo said
	}

	// Fire-and-forget keeps nothing.
	async noise("forgotten")
	echo "carried on"

	// A thread of its own is handed a copy of every argument, whichever spelling
	// started it — so none of these three reaches `held`.
	mut Str[dyn] held = ["one"]
	grow(held, "waited for")
	echo len(held)
	async grow(held, "fired off")
	grown := async grow(held, "named")
	barrier := await [grow(held, "barrier")]
	hive.task.sleep(120)
	echo "{grown} and {barrier} on their own copies, {len(held)} here"

	// And the copy is taken here rather than on the thread, so what the caller
	// does next cannot change what the thread was given.
	seen := async countOf(held)
	append(held, "after")
	echo "{seen} of {len(held)}"
}
