type Op {
    Add { n: Int }
    Total { n: Int }
}

proc counter(total: mut Int, op: Op): Op {
    if op is Op.Add(n) {
        total += n
    }
    return Op.Total(total)
}

func names(m: hive.map.Map<Str, Int>): Str[dyn] {
    return hive.map.keys(m)
}

proc main(): void {
    mut scores := hive.map.new()
    hive.map.set(scores, "ada", 3)
    hive.map.set(scores, "bob", 5)
    echo names(scores)
    echo hive.map.get(scores, "bob")

    mut seen := hive.map.new()
    if len(names(scores)) > 0 {
        hive.map.set(seen, 7, true)
    }
    echo hive.map.has(seen, 7)

    if spawn(counter, 0, #Counter) is Result.Error(why) {
        panic why
    }
    box := at(#Counter)
    if box(Op.Add(2)) is Result.Ok(Op.Total(n)) {
        echo n
    }
    if box(Op.Add(5)) is Result.Ok(Op.Total(n)) {
        echo n
    }
}
