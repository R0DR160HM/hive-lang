// Shadowing the builtins
// ======================
// A declaration of your own named after a builtin is what a bare call means
// (13), with its own arity and its own result. Every pass has to decide that
// the same way, so this runs the rule through each place one decides it: a
// typed position, a call standing on its own, and the long name that reaches
// the builtin whatever was declared.
//
// `shadowing.test.hive` is the same rule through `hive test`, which walks a
// `test` body rather than a `proc` one.

// Ours, at a different arity and a different result from the builtin's.
func len(label: Str, extra: Int): Str {
	return "{label}{extra}"
}

// `append` is the one builtin whose statement lowering writes a new header back
// into its first argument, so a declaration reaching it emitted Go that
// assigned to whatever was passed.
proc append(label: Str, extra: Str): void {
	echo label + extra
}

func join(a: Str, b: Str): Str {
	return a + "-" + b
}

proc main(): void {
	// A typed position, which is where the builtin's result used to win.
	Str s = len("x", 2)
	echo s

	// A call standing on its own.
	append("a", "b")

	// And one whose answer is held in a name.
	joined := join("c", "d")
	echo joined

	// The long name is the builtin, declaration or no declaration.
	Str[dyn] v = ["p", "q"]
	echo hive.len(v)
	echo hive.join(v, "+")
	mut Str[dyn] growing = []
	hive.append(growing, "r")
	echo hive.len(growing)

	// A local binding shadows the declaration in turn.
	len := "a name, not a callable"
	echo len

	// And the long name still stands as a statement beside one that does.
	append := "a name either"
	hive.append(growing, "s")
	echo hive.len(growing)
	echo append
}
