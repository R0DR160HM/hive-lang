// Patterns inside patterns, each the chain of matches it abbreviates.
type Route {
    Page { segments: Str[dyn] }
    Missing
}

type Pair {
    Of { label: Str, count: Result<Int, Str> }
}

func resolve(path: Str): Result<Route, Str> {
    if path == "" {
        return Result.Error("empty")
    }
    if path == "/gone" {
        return Result.Ok(Route.Missing())
    }
    return Result.Ok(Route.Page(split(path, ",")))
}

func describe(path: Str): Str {
    if resolve(path) is Result.Ok(Route.Page(["foo/{padding}/bar", ...rest])) {
        return "foo-bar around {padding}, then {len(rest)} more"
    } else if resolve(path) is Result.Ok(Route.Page([only])) {
        return "a page of one: {only}"
    } else if resolve(path) is Result.Ok(Route.Missing) {
        return "missing"
    } else if resolve(path) is Result.Error(why) {
        return "no route: {why}"
    }
    return "a page of several"
}

func kind(path: Str): Str {
    r := resolve(path)
    if r is Result.Ok(Route.Page([])) {
        return "an empty page"
    } else if r is Result.Ok(Route.Page([_, ...more])) {
        return "a page of {len(more) + 1}"
    } else if r is Result.Ok(Route.Missing) {
        return "a missing page"
    } else if r is Result.Error(_) {
        return "no page at all"
    }
}

proc main(): void {
    echo kind("a,b,c")
    echo kind("/gone")
    echo kind("")
    echo describe("foo/abc/bar,x,y")
    echo describe("home")
    echo describe("/gone")
    echo describe("")
    echo describe("a,b")

    p := Pair.Of("bees", Result.Ok(3))
    if p is Pair.Of("bees", Result.Ok(3)) {
        echo "exactly three bees"
    }
    if p is Pair.Of(label, Result.Ok(n)) && n > 2 {
        echo "{label}: more than two"
    }
    echo p is Pair.Of(_, Result.Error(_))

    Route[dyn] routes = [Route.Missing(), Route.Page(["x"])]
    if routes is [Route.Missing, Route.Page([first, ...more])] {
        echo "missing, then {first} and {len(more)} more"
    }
    echo "{routes is [_, Route.Page(["x"])]}"
    assert routes is [Route.Missing, _]
}
