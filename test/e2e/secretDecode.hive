// A document is read into a type holding secrets: each one arrives as what it
// holds and is kept the way `bypass` keeps one, whatever it holds. A value of
// the wrong kind is refused without saying what it was.

type Login {
	user: Str
	password: Secret<Str>
}

type Card {
	last4: Str
	pin: Secret<Int>
	backup: Secret<Str[dyn]>
	owner: Secret<Plain>
}

proc main(): void {
	got := Login.decode("\{\"user\": \"ana\", \"password\": \"s3nh4\"}", hive.json.codec())
	if got is Result.Ok(login) {
		echo login.user
		echo reveal(login.password)
		echo login.password == bypass("s3nh4")
	}

	card := Card.decode("\{\"last4\": \"1234\", \"pin\": 4321, \"backup\": [\"a1\", \"b2\"], \"owner\": \{\"user\": \"bia\", \"password\": \"x\"}}", hive.json.codec())
	if card is Result.Ok(c) {
		echo c.last4
		echo reveal(c.pin) + 1
		echo join(reveal(c.backup), ",")
		echo reveal(c.owner).password
	}

	// The wrong kind says which kind, never what it held.
	if Login.decode("\{\"user\": \"ana\", \"password\": 12345}", hive.json.codec()) is Result.Error(e) {
		echo e
	}
	if Card.decode("\{\"last4\": \"1\", \"pin\": \"9876\", \"backup\": [], \"owner\": \{\"user\": \"x\", \"password\": \"y\"}}", hive.json.codec()) is Result.Error(e) {
		echo e
	}

	// Reading the claims of a token works the same way.
	if hive.crypto.randomSecret(32) is Result.Ok(key) {
		token := Login.decode(encode(Plain("ana", "pw"), hive.crypto.jwtCodec(key)), hive.crypto.jwtCodec(key))
		if token is Result.Ok(l) {
			echo reveal(l.password)
		}
	}
}

type Plain {
	user: Str
	password: Str
}
