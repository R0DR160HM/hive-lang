// A `Result` built on the spot says one half of its type, and the rest comes from
// what it meets: the other side of an `==`, or the first later use of the name it
// was bound to.
func half(n: Int): Result<Int, Str> {
    if n % 2 == 0 {
        return Result.Ok(n / 2)
    }
    return Result.Error("odd")
}

func greeting(r: Result<Str, Str>): Str {
    if r is Result.Ok(text) {
        return "ok: " + text
    } else if r is Result.Error(why) {
        return "error: " + why
    }
    return ""
}

func refused(): Result<Int, Str> {
    r := Result.Error("refused")
    return r
}

proc main(): void {
    // Either side, either variant, either operator.
    echo half(4) == Result.Ok(2)
    echo Result.Ok(2) == half(4)
    echo half(4) != Result.Ok(2)
    echo Result.Ok(3) != half(4)
    echo half(3) == Result.Error("odd")
    echo Result.Error("odd") == half(3)
    echo half(3) != Result.Error("even")
    echo Result.Ok(1) == Result.Error("odd")
    assert half(4) == Result.Ok(2)
    assert Result.Ok(2) == half(4)
    assert Result.Error("odd") != half(4)

    // Bound with `:=`, the first later use says the rest.
    x := Result.Ok("fine")
    echo greeting(x)
    missing := Result.Error("nothing here")
    echo greeting(missing)
    a := Result.Ok(2)
    echo half(4) == a
    echo refused()
    mut r := Result.Ok(1)
    r = Result.Error("changed")
    echo r
}
