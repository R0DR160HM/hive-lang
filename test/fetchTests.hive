// Tests for `src/fetch`.
//
// Most of these are about reading a path and keeping a lock, and touch nothing.
// The last few make a real repository on this disk and fetch it, which needs
// `git` but no network — a clone from a path is a clone.
import ../src/fetch
import ../src/text
import hive.file
import hive.term

// --- Reading a path ----------------------------------------------------------

test "a remote path is one that names a scheme" {
	assert fetch.isRemote("https://github.com/owner/repo/src/text")
	assert fetch.isRemote("http://host/o/r/x")
	assert fetch.isRemote("./lib/text") == false
	assert fetch.isRemote("hive.map") == false
	assert fetch.isRemote("./lib/util.go") == false
}

test "the repository is the host, the owner and the repository" {
	if fetch.repoOf("https://github.com/owner/repo/src/text") is Result.Ok(repo) {
		assert repo.url == "https://github.com/owner/repo"
		assert repo.revision == ""
		assert repo.inner == "src/text"
	}
}

test "a revision goes where the repository ends" {
	if fetch.repoOf("https://github.com/owner/repo@a1b2c3/src/text") is Result.Ok(repo) {
		assert repo.url == "https://github.com/owner/repo"
		assert repo.revision == "a1b2c3"
		assert repo.inner == "src/text"
	}
	if fetch.repoOf("https://github.com/owner/repo@v1.2.0/src/text") is Result.Ok(repo) {
		assert repo.revision == "v1.2.0"
	}
	if fetch.repoOf("https://github.com/owner/repo@main/x") is Result.Ok(repo) {
		assert repo.revision == "main"
	}
}

test "the path inside may be several segments, or hold a space" {
	if fetch.repoOf("https://host/o/r/a/b/c") is Result.Ok(repo) {
		assert repo.inner == "a/b/c"
	}
	if fetch.repoOf("https://host/o/r/lib code/text") is Result.Ok(repo) {
		assert repo.inner == "lib code/text"
	}
}

test "a Go file keeps its extension, because that is what says it is Go" {
	if fetch.repoOf("https://host/o/r/go/util.go") is Result.Ok(repo) {
		assert repo.inner == "go/util.go"
	}
}

test "a path with nothing inside the repository is refused, and says what the shape is" {
	got := fetch.repoOf("https://github.com/owner/repo")
	assert got is Result.Error(_)
	if got is Result.Error(why) {
		assert text.contains(why, "a host, an owner and a repository")
	}
}

// --- The cache ---------------------------------------------------------------

test "a clone is filed under what it is and which commit" {
	repo := fetch.Repo("https://github.com/owner/repo", "", "src/text")
	where := fetch.cacheOf(repo, "abc123")
	assert text.endsWith(where, "/pkg/github.com_owner_repo@abc123")
	// Two commits of one repository do not collide, and two repositories do not
	// either.
	other := fetch.cacheOf(repo, "def456")
	assert where != other
	assert fetch.cacheOf(fetch.Repo("https://github.com/owner/other", "", "x"), "abc123") != where
}

// --- The lock ----------------------------------------------------------------

test "the lock lives beside the entrypoint" {
	assert fetch.lockPathOf("main.hive") == "main.hive-lock"
	assert fetch.lockPathOf("a/b/app.hive") == "a/b/app.hive-lock"
}

test "a lock nobody wrote is an empty one, not a failure" {
	lock := fetch.readLock("_nothing/here.hive")
	assert len(lock.urls) == 0
	assert lock.added == false
}

test "a pin is written, read back, and not written twice" {
	mut fetch.Lock lock = fetch.readLock("_lockTest.hive")
	fetch.pin(lock, "https://host/o/r", "abc")
	assert lock.added
	assert fetch.pinned(lock, "https://host/o/r") == "abc"
	// A repository already pinned keeps the commit it was pinned to.
	fetch.pin(lock, "https://host/o/r", "def")
	assert fetch.pinned(lock, "https://host/o/r") == "abc"
	assert fetch.pinned(lock, "https://host/o/other") == ""

	fetch.writeLock(lock)
	reread := fetch.readLock("_lockTest.hive")
	assert fetch.pinned(reread, "https://host/o/r") == "abc"
	// Reading a lock is not a change to it, so nothing is rewritten.
	assert reread.added == false
}

test "a lock keeps its comment, so somebody opening it knows what it is for" {
	mut fetch.Lock lock = fetch.readLock("_lockComment.hive")
	fetch.pin(lock, "https://host/o/r", "abc")
	fetch.writeLock(lock)
	if hive.file.read("_lockComment.hive-lock") is Result.Ok(written) {
		assert text.startsWith(written, "# Written by the Hive compiler")
		assert text.contains(written, "https://host/o/r abc")
	}
}

// --- Fetching for real -------------------------------------------------------
//
// A repository made here and fetched from here. Everything below runs `git`,
// and none of it touches a network: a clone from a path is a clone.

// Make a git repository at `where` holding one Hive module, and answer with the
// path git will clone it from.
//
// Absolute, because git reads a relative one as the name of a configured remote
// rather than as a path. A real import never meets this — a remote import is a
// URL — but a test that makes its own repository does.
proc aRepository(where: Str, contents: Str): Str {
	removeTree(where)
	if hive.file.makeDir(where) is Result.Error(_) {
		panic "could not make {where}"
	}
	if hive.file.write(where + "/text.hive", contents) is Result.Error(_) {
		panic "could not write into {where}"
	}
	run("git", ["init", "--quiet"], where)
	run("git", ["config", "user.email", "test@hive"], where)
	run("git", ["config", "user.name", "Hive test"], where)
	run("git", ["add", "."], where)
	run("git", ["commit", "--quiet", "-m", "one module"], where)
	return here() + "/" + where
}

// Where this test is running, which is the generated project rather than the
// folder the source is in.
proc here(): Str {
	return text.trim(run("pwd", [], ""))
}

// `hive.file.delete` takes a file or a directory that is already empty, which is
// the whole of what it needs to be given a walk.
proc removeTree(path: Str): void {
	if hive.file.exists(path) == false {
		return
	}
	if hive.file.list(path) is Result.Ok(names) {
		for each name in names {
			removeTree(path + "/" + name)
		}
	}
	if hive.file.delete(path) is Result.Error(_) {
		return
	}
}

proc run(command: Str, arguments: Str[], directory: Str): Str {
	said := hive.term.exec(command, arguments, directory)
	if said is Result.Ok(output) {
		return output
	}
	if said is Result.Error(why) {
		panic "`{command}` failed: {why.message} {why.output}"
	}
	return ""
}

test "a repository is resolved, cloned once, and read back" {
	where := aRepository("_repoOne", "func shout(w: Str): Str \{ return w + \"!\" }")
	repo := fetch.Repo(where, "", "text")
	mut fetch.Lock lock = fetch.readLock("_fetchOne.hive")

	got := fetch.fetch(repo, lock)
	// Compared rather than matched, so a failure shows what went wrong instead
	// of only that something did.
	assert whyOf(got) == ""
	if got is Result.Ok(here) {
		// The clone is on this disk, holding the module.
		assert hive.file.exists(here.directory + "/text.hive")
		// And the commit it resolved to was pinned, so the next build gets the
		// same code.
		assert len(here.commit) == 40
		assert fetch.pinned(lock, where) == here.commit
		assert lock.added

		// Nothing touches the network — or the disk — when it is already there.
		again := fetch.fetch(repo, lock)
		if again is Result.Ok(second) {
			assert second.directory == here.directory
			assert second.commit == here.commit
		}
	}
}

test "a revision written on the import is what decides" {
	where := aRepository("_repoTwo", "func here(): Int \{ return 1 }")
	head := text.trim(firstWord(run("git", ["rev-parse", "HEAD"], where)))
	mut fetch.Lock lock = fetch.readLock("_fetchTwo.hive")

	// Named by its commit.
	got := fetch.fetch(fetch.Repo(where, head, "text"), lock)
	assert whyOf(got) == ""
	if got is Result.Ok(here) {
		assert here.commit == head
		assert hive.file.exists(here.directory + "/text.hive")
	}
	// An import that named its own revision pins nothing: it said which already.
	assert lock.added == false
}

test "a revision the repository does not have is named as that, and nothing else" {
	where := aRepository("_repoThree", "func here(): Int \{ return 1 }")
	mut fetch.Lock lock = fetch.readLock("_fetchThree.hive")

	got := fetch.fetch(fetch.Repo(where, "no-such-branch", "text"), lock)
	assert whyOf(got) == "`{where}` has no `no-such-branch`: it is not a branch, a tag or a commit that repository holds"
}

test "a repository that cannot be reached says so" {
	mut fetch.Lock lock = fetch.readLock("_fetchFour.hive")
	nowhere := here() + "/_nothing/is/here"
	got := fetch.fetch(fetch.Repo(nowhere, "", "text"), lock)
	assert text.startsWith(whyOf(got), "could not reach `{nowhere}`")
}

// Why a fetch failed, or `""` when it did not.
func whyOf(got: Result<fetch.Fetched, Str>): Str {
	if got is Result.Error(why) {
		return why
	}
	return ""
}

func firstWord(output: Str): Str {
	for each line in split(output, "\n") {
		if text.trim(line) != "" {
			return text.trim(line)
		}
	}
	return ""
}
