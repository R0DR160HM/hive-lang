import hive.ui

type Msg {
	Same
	Longer
	Shorter
	Cell
	Row
	Mark
}

type Model {
	words: Int
	rows: Int
	gap: Int
	x: Int
}

proc update(model: Model, msg: Msg, from: hive.syslink.Envelope): Model {
	mut Model next = model
	if msg is Msg.Longer() {
		next.words = model.words * 3
	} else if msg is Msg.Shorter() {
		next.words = 1
	} else if msg is Msg.Cell() {
		next.gap = model.gap + 7
	} else if msg is Msg.Row() {
		next.rows = model.rows + 1
	} else if msg is Msg.Mark() {
		next.x = model.x + 10
	}
	return next
}

func words(n: Int): Str {
	mut Str out = ""
	for i := 0; i < n; i++ {
		out = out + "word "
	}
	return out
}

func board(model: Model): Str[dyn][dyn] {
	mut Str[dyn][dyn] rows = []
	append(rows, ["car", "gap"])
	for i := 0; i < model.rows; i++ {
		append(rows, ["{i}", "+{model.gap + i}"])
	}
	return rows
}

func view(model: Model): ui.View {
	return ui.column([ui.gap(4)], [
		ui.row([ui.gap(4)], [
			ui.button([ui.on(Msg.Same())], "same"),
			ui.button([ui.on(Msg.Longer())], "longer"),
			ui.button([ui.on(Msg.Shorter())], "shorter"),
			ui.button([ui.on(Msg.Cell())], "cell"),
			ui.button([ui.on(Msg.Row())], "row"),
			ui.button([ui.on(Msg.Mark())], "mark")
		]),
		ui.text([], words(model.words)),
		ui.table([], board(model)),
		ui.canvas([ui.width(100), ui.height(100), ui.region(0.0, 0.0, 100.0, 100.0)], [
			ui.dot([], hive.conv.itf(model.x), 50.0, 5.0),
			ui.words([], 10.0, 10.0, 8.0, "at {model.x}")
		])
	])
}

proc main(): void {
	ui.window("window test", view, update, Model(20, 3, 0, 10))
}
