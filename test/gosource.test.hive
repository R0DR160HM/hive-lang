// Tests for `src/gosource`.
import ../src/gosource

test "a comment on a line of its own goes, and the line with it" {
    assert gosource.carried("package hive\n\n// Table is rows.\ntype Table = [][]string\n") == "package hive\n\ntype Table = [][]string\n"
}

test "a comment after code goes, and the blanks before it" {
    assert gosource.carried("x := 1 // one\ny := 2\n") == "x := 1\ny := 2\n"
}

test "a directive is not a comment" {
    assert gosource.carried("//go:build linux\n\npackage hive\n") == "//go:build linux\n\npackage hive\n"
    assert gosource.carried("//export hiveStart\nfunc hiveStart() \{}\n") == "//export hiveStart\nfunc hiveStart() \{}\n"
}

test "what a string holds is text, slashes and all" {
    assert gosource.carried("u := \"https://hive-lang.run\" // home\n") == "u := \"https://hive-lang.run\"\n"
    assert gosource.carried("r := '/' // a slash\n") == "r := '/'\n"
    assert gosource.carried("q := \"a \\\" // b\"\n") == "q := \"a \\\" // b\"\n"
}

test "a raw string is carried whole, over as many lines as it runs" {
    source := "const js = `\n// the page's own\nvar a = 1;\n`\n// gone\nvar b = 2\n"
    assert gosource.carried(source) == "const js = `\n// the page's own\nvar a = 1;\n`\nvar b = 2\n"
}

test "a comment between two halves of a raw string goes, and the halves still join" {
    assert gosource.carried("const js = `a\n` +\n\t// about b\n\t`b`\n") == "const js = `a\n` +\n\t`b`\n"
}

test "a block comment is left alone, and what it holds is not read" {
    assert gosource.carried("/* a // b */ x := 1\n") == "/* a // b */ x := 1\n"
}

test "a file opens with its package, not with the gap its heading left" {
    assert gosource.carried("// Heading.\n\n//go:build windows\n\npackage hive\n") == "//go:build windows\n\npackage hive\n"
}

test "line endings are the ones a build writes" {
    assert gosource.carried("a := 1 // one\r\nb := 2\r\n") == "a := 1\nb := 2\n"
}
