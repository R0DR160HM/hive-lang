#!/usr/bin/env bash
# Every test the compiler has.
#
#   ./test/run           run them with the compiler itself (needs ./bootstrap)
#
# There are two kinds. The unit suites are Hive files declaring `test` blocks:
# they call the compiler's own passes and assert about what came back. The
# end-to-end suite compiles whole programs and runs them, which is the one part
# a Hive test cannot do for itself.
set -uo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
root="$here/.."

runner="$root/hive"

if [ ! -x "$root/src/hivec" ] && [ ! -x "$root/src/hivec.exe" ]; then
	echo "test/run: the compiler has not been built yet. Run ./bootstrap" >&2
	exit 1
fi

echo "Running the suites with the compiler itself."
echo

suites=(text naming paths lexer parser loader fetch goffi mono check ranges emit container project hivec)
failed=0

for suite in "${suites[@]}"; do
	printf '%-12s ' "$suite"
	out="$("$runner" test "$here/$suite.test.hive" 2>&1)"
	if echo "$out" | grep -qE '^  [0-9]+ tests?: [0-9]+ passed$'; then
		echo "$out" | grep -oE '[0-9]+ tests?: .*' | head -1
	else
		echo "FAILED"
		echo "$out" | grep -E '^  FAIL|^ +' | head -20 | sed 's/^/    /'
		failed=$((failed + 1))
	fi
done

echo
echo "End to end:"
if ! "$here/e2e/run"; then
	failed=$((failed + 1))
fi

echo
if [ "$failed" -eq 0 ]; then
	echo "Everything passed."
else
	echo "$failed suite(s) failed."
	exit 1
fi
